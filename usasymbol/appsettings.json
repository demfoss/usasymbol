{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=usasymbol.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bunny": {
    "StorageZoneName": "usasymbol",
    "StorageRegion": "",
    "CdnBaseUrl": "https://usasymbol.b-cdn.net",
    "UseCdnInProduction": true,
    "LocalImagesBasePath": "/images"
  },
  "CDN": {
    "BaseUrl": "https://usasymbol.b-cdn.net",
    "Enabled": false
  },
  "ContentPath": "Content/states",
  "Images": {
    "FlagsPath": "/images/states/flags",
    "FlagsSmall": "/images/states/flags/small",
    "FlagsMedium": "/images/states/flags/medium",
    "FlagsLarge": "/images/states/flags/large"
  },
  "AiPipeline": {
    "EnabledOutsideDevelopment": false,
    "PromptDirectory": "Content/ai-prompts",
    "OutputDirectory": "Content/generated",
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-5-mini"
    },
    "Claude": {
      "ApiKey": "",
      "Model": "claude-sonnet-4-6"
    }
  }
}
