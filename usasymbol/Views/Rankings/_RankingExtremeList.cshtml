@using Usasymbol.Helpers
@model RankingExtremeListModel
@{
    var side = Model.Side;
    var presentation = Model.Presentation;
    var additive = Model.Table.Metric?.Additive == true;
    // Counts read naturally in lower case ("Most cattle on feed"); named things keep their capitals.
    var title = additive
        ? (side.Highest ? "Most " : "Fewest ") + presentation.UnitLabel.ToLowerInvariant()
        : side.Label + " " + presentation.UnitLabel;
}

<section id="@side.Id" class="ranking-extreme-list @presentation.Tone(Model.Table, side.Highest)" data-extreme-side="@(side.Highest ? "highest" : "lowest")" data-mobile-rows="@Model.MobileRows">
    <div class="ranking-extreme-list__header">
        <h3>@title</h3>
    </div>
    @* Ties are plain rows too (rank "T-44"): the same layout on both sides, however many states share a value. *@
    <div class="ranking-extreme-list__rows">
        @{ var rowIndex = 0; }
        @foreach (var point in side.Rows)
        {
            @await Html.PartialAsync("~/Views/Rankings/_RankingExtremeRow.cshtml",
                new RankingExtremeRowModel(presentation, point, Model.Table, rowIndex++, Model.Colors))
        }
    </div>
</section>
