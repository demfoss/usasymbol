@using System.Globalization
@using System.Text.RegularExpressions
@using Usasymbol.Helpers
@using USASymbol.Models.ViewModels
@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var content = Model.Content;
    var quickAnswerSectionId = (ViewData["QuickAnswerSectionId"] as string ?? "quick-answer").Trim();
    var rankingTableSectionId = (ViewData["RankingTableSectionId"] as string ?? "ranking-table").Trim();
    var sectionsSectionId = (ViewData["SectionsSectionId"] as string ?? "sections").Trim();
    var faqSectionId = (ViewData["FaqSectionId"] as string ?? "faq").Trim();
    var methodologySectionId = (ViewData["MethodologySectionId"] as string ?? "methodology").Trim();

    var hasFaq = Model.HasFaq;
    var hasSections = Model.HasSections;
    var hasMethodology = !string.IsNullOrWhiteSpace(content?.Page?.Methodology) || Model.HasSources;
}

<div class="page-flow-shell lg:grid lg:grid-cols-[232px_minmax(0,860px)] lg:justify-center lg:gap-8 xl:grid-cols-[244px_minmax(0,884px)] xl:gap-10 2xl:grid-cols-[256px_minmax(0,912px)] 2xl:gap-12 relative">
    <aside class="hidden lg:block relative h-full">
        <div class="sticky top-24 pb-10">
            @await Html.PartialAsync("_TocSidebar", Model)
        </div>
    </aside>

    <div class="min-w-0">
        @if (Model.HasQuickAnswer)
        {
            <section id="@quickAnswerSectionId" class="scroll-mt-24">
                @await Html.PartialAsync("Pages/_QuickAnswer", Model, ViewData)
            </section>
        }

        @if (content?.Map != null)
        {
            <section class="page-map-stage @(Model.HasQuickAnswer ? "page-map-stage--after-qa" : "")">
                @await Html.RenderMapBlockAsync(content.Map, content?.Table, content?.Slug)
            </section>
        }

        <div class="relative content-flow site-content page-flow-content">
            @if (content?.Heatmap != null)
            {
                <section class="content-divider">
                    @await Component.InvokeAsync("HeatmapBlock", content.Heatmap)
                </section>
            }

            <section id="@rankingTableSectionId" class="scroll-mt-24 content-divider">
                <div class="flex items-baseline justify-between gap-4">
                    @{
                        var slugRaw = (content?.Slug ?? "").Trim();
                        var slugWords = Regex.Replace(slugRaw, @"[-_]+", " ");
                        var slugTitle = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(slugWords.ToLowerInvariant());
                        var pageHeading = !string.IsNullOrWhiteSpace(content?.Page?.H1) ? content.Page.H1.Trim() : slugTitle;
                        var tableSectionHeading = !string.IsNullOrWhiteSpace(content?.Table?.Title)
                            ? content.Table.Title
                            : $"{pageHeading} Table";
                        var tableVM = Model.ToTableSection();
                    }

                    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-slate-900">
                        @tableSectionHeading
                    </h2>

                    <span id="resultsCounter" class="hidden md:inline shrink-0 text-sm text-slate-500">@tableVM.TotalRowsCount entries</span>
                </div>

                <div class="mt-5 overflow-hidden border border-slate-200/80 bg-white/40">
                    @await Html.PartialAsync("Components/Tables/_Controls", tableVM)
                    @await Html.PartialAsync("Components/Tables/_Cards", tableVM)
                    @await Html.PartialAsync("Components/Tables/_Table", tableVM)
                </div>

                @if (Model.HasRows)
                {
                    @await Html.PartialAsync("_PrintableWidget", Model)
                }
            </section>

            @await Html.PartialAsync("~/Views/Rankings/_RankingExtremesBlock.cshtml", Model)

            @if (hasSections)
            {
                <section id="@sectionsSectionId" class="scroll-mt-24 content-divider">
                    @await Html.PartialAsync("Pages/_Sections", Model)
                </section>
            }

            @if (hasFaq)
            {
                <section id="@faqSectionId" class="scroll-mt-24 content-divider">
                    @await Html.PartialAsync("_Faq", Model, ViewData)
                </section>
            }

            @if (hasMethodology)
            {
                <section id="@methodologySectionId" class="scroll-mt-24 content-divider">
                    @await Html.PartialAsync("Pages/_MethodologySources", Model, ViewData)
                </section>
            }

            @if (content?.QuizPromo != null)
            {
                var qp = content.QuizPromo;
                var quizUrl = !string.IsNullOrWhiteSpace(qp.Slug) ? $"/quizzes/{qp.Slug}" : "/quizzes";
                var quizIcon = !string.IsNullOrWhiteSpace(qp.Icon) ? qp.Icon : "fa-solid fa-graduation-cap";
                var quizBtn  = !string.IsNullOrWhiteSpace(qp.ButtonText) ? qp.ButtonText : "Take the quiz";
                var quizTitle = !string.IsNullOrWhiteSpace(qp.Title) ? qp.Title : "Test Your Knowledge";
                var quizDesc  = !string.IsNullOrWhiteSpace(qp.Description) ? qp.Description : "Put what you've read to the test.";
                <div class="content-divider">
                    <a href="@quizUrl"
                       class="group flex items-center justify-between gap-6 rounded-2xl border border-blue-200 bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-5 shadow-sm transition hover:border-blue-300 hover:shadow-md no-underline">
                        <div class="flex items-center gap-4 min-w-0">
                            <span class="flex-shrink-0 flex h-11 w-11 items-center justify-center rounded-xl bg-blue-600 text-white text-lg shadow-sm">
                                <i class="@quizIcon"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700">Quiz</div>
                                <div class="mt-0.5 font-bold text-slate-900 text-base leading-snug">@quizTitle</div>
                                <p class="mt-1 text-sm text-slate-600 leading-relaxed line-clamp-2">@quizDesc</p>
                            </div>
                        </div>
                        <span class="flex-shrink-0 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition group-hover:bg-blue-700">
                            @quizBtn <i class="fa-solid fa-arrow-right text-xs"></i>
                        </span>
                    </a>
                </div>
            }

            @if (content?.Compare != null)
            {
                <div class="content-divider">
                    @await Html.PartialAsync("~/Views/Rankings/_RankingComparePicker.cshtml", content.Compare)
                </div>
            }

            <div class="content-divider">
                @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
            </div>
        </div>
    </div>
</div>
