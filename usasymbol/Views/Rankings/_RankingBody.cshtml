@using System.Globalization
@using System.Text.RegularExpressions
@using Usasymbol.Helpers
@using USASymbol.Models.ViewModels
@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var content = Model.Content;
    var quickAnswerSectionId = (ViewData["QuickAnswerSectionId"] as string ?? "quick-answer").Trim();
    var rankingTableSectionId = (ViewData["RankingTableSectionId"] as string ?? "ranking-table").Trim();
    var sectionsSectionId = (ViewData["SectionsSectionId"] as string ?? "sections").Trim();
    var faqSectionId = (ViewData["FaqSectionId"] as string ?? "faq").Trim();
    var methodologySectionId = (ViewData["MethodologySectionId"] as string ?? "methodology").Trim();

    var hasFaq = Model.HasFaq;
    var hasSections = Model.HasSections;
    var hasMethodology = !string.IsNullOrWhiteSpace(content?.Page?.Methodology) || Model.HasSources;
    var showExploreMore = ViewData["ShowExploreMore"] as bool? ?? false;
    var shellGridClass = showExploreMore
        ? "page-flow-shell lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:justify-center lg:gap-8 xl:grid-cols-[200px_minmax(0,1fr)_300px] xl:gap-[2px] 2xl:grid-cols-[240px_minmax(0,900px)_300px] 2xl:gap-4 relative"
        : "page-flow-shell lg:grid lg:grid-cols-[300px_minmax(0,860px)] lg:justify-center lg:gap-8 xl:grid-cols-[300px_minmax(0,884px)] xl:gap-10 2xl:grid-cols-[300px_minmax(0,912px)] 2xl:gap-12 relative";
    var tocSidebarClass = showExploreMore
        ? "hidden xl:block relative h-full"
        : "hidden lg:block relative h-full";
    var slugRaw = (content?.Slug ?? "").Trim();
    var slugWords = Regex.Replace(slugRaw, @"[-_]+", " ");
    var slugTitle = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(slugWords.ToLowerInvariant());
    var pageHeading = !string.IsNullOrWhiteSpace(content?.Page?.H1) ? content.Page.H1.Trim() : slugTitle;
    var tableSectionHeading = !string.IsNullOrWhiteSpace(content?.Table?.Title)
        ? content.Table.Title
        : $"{pageHeading} Table";
    var tableVM = Model.ToTableSection();
    var numericInsights = RankingNumericInsightsViewModel.Create(content?.Table);
    var relatedRankings = ViewData["RelatedRankings"] as LatestContentRailViewModel;
    var hasRelatedRankings = relatedRankings?.Items.Any() == true;
}

<div class="@shellGridClass">
    <aside class="@tocSidebarClass" aria-label="Table of contents">
        <div class="pb-10 h-full">
            @await Html.PartialAsync("_TocSidebar", Model)
        </div>
    </aside>

    <div class="min-w-0 article-content">
        @if (Model.HasQuickAnswer)
        {
            @await Html.PartialAsync("Pages/_QuickAnswerBigNumber", Model, ViewData)
        }

        @if (content?.Map != null)
        {
            <div class="page-map-stage @(Model.HasQuickAnswer ? "page-map-stage--after-qa" : "")">
                @await Html.RenderMapBlockAsync(content.Map, content?.Table, content?.Slug)
                @await Html.PartialAsync("~/Views/Rankings/_RankingEmbedControl.cshtml", Model)
            </div>
        }

        @if (content?.Map == null && Model.HasRows)
        {
            @await Html.PartialAsync("~/Views/Rankings/_RankingEmbedControl.cshtml", Model)
        }

        @* Superlatives block intentionally hidden; component kept: _RankingSuperlatives.cshtml
        @if (numericInsights != null)
        {
            <div class="ranking-insights-before-table">
                @await Html.PartialAsync("~/Views/Rankings/_RankingSuperlatives.cshtml", Model)
            </div>
        }
        *@

        <div id="@rankingTableSectionId" class="ranking-primary-table scroll-mt-24">
            <div class="ranking-primary-table__heading">
                <h2>@tableSectionHeading</h2>

                <div class="ranking-primary-table__meta">
                    <span id="resultsCounter">@tableVM.TotalRowsCount entries</span>
                    @if (Model.HasRows)
                    {
                        var citeSource = Model.VisibleSources.FirstOrDefault()?.Name;
                        var citePage = $"https://usasymbol.com{(string.IsNullOrWhiteSpace(content?.Url) ? $"/rankings/{content?.Category}/{content?.Slug}" : content!.Url)}";
                        var citeText = $"USA Symbol. \u201c{content?.Page?.H1}.\u201d {citePage}" + (string.IsNullOrWhiteSpace(citeSource) ? "" : $" Data: {citeSource}.");
                        <div class="ranking-table-actions">
                            <a href="/download/rankings/@content?.Category/@(content?.Slug).csv" download
                               class="rk-btn-quiet inline-flex h-9 items-center gap-1.5 px-3 font-sans text-xs font-semibold no-underline normal-case">
                                <i class="fa-solid fa-file-csv text-xs" aria-hidden="true"></i><span>Download CSV</span>
                            </a>
                            @await Html.PartialAsync("_PrintableWidget", Model)
                            <button type="button" data-copy-text="@citeText"
                                    class="rk-btn-quiet inline-flex h-9 items-center gap-1.5 px-3 font-sans text-xs font-semibold">
                                <i class="fa-solid fa-quote-left text-xs" aria-hidden="true"></i><span>Cite</span>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="ranking-data-shell">
                @* Rankings are table-only: no Cards view and no view toggle *@
                @await Html.PartialAsync("Components/Tables/_Controls", tableVM, new ViewDataDictionary(ViewData) { ["HideViewToggle"] = true })
                @await Html.PartialAsync("Components/Tables/_Table", tableVM)
            </div>

            @{
                var footUnit = content?.Table?.Metric?.UnitPlural;
                var footNote = content?.Table?.Note;
                // "T-46" is explained once under the table. Sources live only in "About this data".
                string? tieNote = null;
                var tieRanking = RankingPresentation.Create(content?.Table);
                if (tieRanking != null)
                {
                    var firstTie = tieRanking.Ordered
                        .Select(p => tieRanking.For(p.Row))
                        .Where(pl => pl != null && pl.TieCount > 1)
                        .OrderBy(pl => pl!.Rank)
                        .FirstOrDefault();
                    if (firstTie != null) { tieNote = $"T-{firstTie.Rank} means tied for {firstTie.Rank}{(firstTie.Rank % 100 is >= 11 and <= 13 ? "th" : (firstTie.Rank % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" })} place."; }
                }
            }
            @if (!string.IsNullOrWhiteSpace(footUnit) || !string.IsNullOrWhiteSpace(footNote) || tieNote != null)
            {
                <p class="ranking-table-footnote">
                    @if (!string.IsNullOrWhiteSpace(footUnit)) { <span>Unit: <strong>@footUnit</strong>.</span> }
                    @if (!string.IsNullOrWhiteSpace(footNote)) { <span>@footNote</span> }
                    @if (tieNote != null) { <span>@tieNote</span> }
                </p>
            }

            @await Html.PartialAsync("~/Views/Rankings/_StateTeasers.cshtml", Model)

        </div>

        @* Distribution block intentionally hidden (it repeats the takeaways/extremes); component kept: _RankingDistribution.cshtml
        @if (numericInsights != null)
        {
            <div class="ranking-insights-after-table">
                @await Html.PartialAsync("~/Views/Rankings/_RankingDistribution.cshtml", Model)
            </div>
        }
        *@

        <div class="relative content-flow site-content page-flow-content">
            @if (content?.Heatmap != null)
            {
                <div class="content-divider">
                    @await Component.InvokeAsync("HeatmapBlock", content.Heatmap)
                </div>
            }

            @await Html.PartialAsync("~/Views/Rankings/_RankingExtremesBlock.cshtml", Model)

            @if (hasSections)
            {
                <div id="@sectionsSectionId" class="scroll-mt-24 content-divider">
                    @await Html.PartialAsync("Pages/_Sections", Model)
                </div>
            }

            @* Reaction widget sits after the readable content, before FAQ / methodology *@
            @await Html.PartialAsync("~/Views/Rankings/_RankingReactions.cshtml", Model)

            @if (hasFaq)
            {
                <div id="@faqSectionId" class="scroll-mt-24 content-divider">
                    @await Html.PartialAsync("_Faq", Model, ViewData)
                </div>
            }

            @if (ViewData["HideInlineQuiz"] as bool? != true)
            {
                @await Component.InvokeAsync("InlineQuiz", new { mode = "rankings" })
            }

            @if (hasMethodology)
            {
                <div class="content-divider">
                    @await Html.PartialAsync("~/Views/Rankings/_RankingAbout.cshtml", Model)
                </div>
            }

            @* Related rankings sit after the methodology so they do not interrupt the data flow *@
            @if (hasRelatedRankings)
            {
                <div class="content-divider lg:hidden">
                    @await Html.PartialAsync("_RelatedRankingsInline", relatedRankings)
                </div>
            }

            @if (content?.QuizPromo != null)
            {
                var qp = content.QuizPromo;
                var quizUrl = !string.IsNullOrWhiteSpace(qp.Slug) ? $"/quizzes/{qp.Slug}" : "/quizzes";
                var quizIcon = !string.IsNullOrWhiteSpace(qp.Icon) ? qp.Icon : "fa-solid fa-graduation-cap";
                var quizBtn  = !string.IsNullOrWhiteSpace(qp.ButtonText) ? qp.ButtonText : "Take the quiz";
                var quizTitle = !string.IsNullOrWhiteSpace(qp.Title) ? qp.Title : "Test Your Knowledge";
                var quizDesc  = !string.IsNullOrWhiteSpace(qp.Description) ? qp.Description : "Put what you've read to the test.";
                <div class="content-divider">
                    <a href="@quizUrl"
                       class="rk-promo group flex items-center justify-between gap-6 px-6 py-5 no-underline">
                        <div class="flex items-center gap-4 min-w-0">
                            <span class="rk-promo__icon flex-shrink-0 flex h-11 w-11 items-center justify-center text-white text-lg">
                                <i class="@quizIcon"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="rk-promo__kicker text-xs font-semibold uppercase tracking-[0.16em]">Quiz</div>
                                <div class="mt-0.5 font-bold text-slate-900 text-base leading-snug">@quizTitle</div>
                                <p class="mt-1 text-sm text-slate-600 leading-relaxed line-clamp-2">@quizDesc</p>
                            </div>
                        </div>
                        <span class="rk-promo__btn flex-shrink-0 inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white">
                            @quizBtn <i class="fa-solid fa-arrow-right text-xs"></i>
                        </span>
                    </a>
                </div>
            }

            @if (content?.Compare != null)
            {
                <div class="content-divider">
                    @await Html.PartialAsync("~/Views/Rankings/_RankingStateMatchCta.cshtml", content.Compare)
                </div>
                <div class="content-divider">
                    @await Html.PartialAsync("~/Views/Rankings/_RankingComparePicker.cshtml", content.Compare)
                </div>
            }

            @if (showExploreMore && !hasRelatedRankings)
            {
                <div class="mt-12 lg:hidden">
                    @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                </div>
            }
        </div>
    </div>

    @if (showExploreMore)
    {
        <aside class="article-sidebar hidden lg:block" aria-label="Explore more">
            <div class="sidebar-content">
                @if (hasRelatedRankings)
                {
                    @await Html.PartialAsync("_RelatedRankingsSidebar", relatedRankings)
                }
                else
                {
                    @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                }
            </div>
        </aside>
    }
</div>
