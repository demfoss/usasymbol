@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Usasymbol.Helpers
@using USASymbol.Models.ViewModels
@model USASymbol.Models.ViewModels.PageDetailViewModel
@inject IImageUrlService Images

@{
    var content = Model.Content;
    var categoryTitle = string.IsNullOrWhiteSpace(Model.CategoryTitle) ? "Rankings" : Model.CategoryTitle;

    ViewData["Title"] = content?.Seo?.Title;
    ViewData["Description"] = content?.Seo?.Description;
    ViewData["OgType"] = "article";
    ViewData["BodyClass"] = "symbols-surface";

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalPath = !string.IsNullOrWhiteSpace(content?.Url) ? content.Url : Context.Request.Path.Value ?? "/rankings";
    var canonicalUrl = canonicalPath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? canonicalPath
        : $"{baseUrl}{canonicalPath}";
    var currentUrl = canonicalUrl;
    ViewData["Canonical"] = canonicalUrl;

    var heroAlt = content?.HeroImageAlt ?? content?.Map?.ImageAlt ?? content?.Page?.H1 ?? "USA state rankings";
    var heroImage = content?.HeroImage;
    var heroCaption = content?.HeroImageCaption;

    if (string.IsNullOrWhiteSpace(heroImage) && !string.IsNullOrWhiteSpace(content?.Map?.Image))
    {
        heroImage = content!.Map!.Image;
        heroCaption ??= content.Map.Caption;
    }

    if (string.IsNullOrWhiteSpace(heroImage))
    {
        heroImage = content?.VisualAssets?.FirstOrDefault(v =>
            !string.IsNullOrWhiteSpace(v?.Src) &&
            !string.Equals(v.Layout, "full-width", StringComparison.OrdinalIgnoreCase))?.Src;
    }

    if (string.IsNullOrWhiteSpace(heroImage) && content?.Table?.Rows?.Any() == true)
    {
        var firstRow = content.Table.Rows.First();
        heroImage = new[]
        {
            firstRow.GetString("hero_image"),
            firstRow.GetString("symbol_image"),
            firstRow.GetString("image")
        }.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
    }

    var heroImageResolved = string.IsNullOrWhiteSpace(heroImage) ? "/images/og-default.webp" : heroImage!;
    var heroImageUrl = Images.Full(heroImageResolved);
    ViewData["OgImage"] = heroImageUrl;

    var hasFaq = Model.HasFaq;
    var hasSections = Model.HasSections;
    var hasMethodology = !string.IsNullOrWhiteSpace(content?.Page?.Methodology) || Model.HasSources;
    var heroModel = new PageHeroViewModel
    {
        PageModel = Model,
        HeroLabel = "Guide",
        FallbackIconClass = "fa-solid fa-chart-column",
        Title = content?.Page?.H1 ?? "Ranking",
        Description = content?.Seo?.Description,
        ImageUrl = heroImageResolved,
        ImageAlt = heroAlt,
        FigureTitle = content?.Page?.H1,
        FigureSubtitle = $"Ranking - {categoryTitle}",
        FigureCaption = heroCaption,
        ImageLinkUrl = heroImageResolved,
        EyebrowItems = new List<string>
        {
            "Rankings",
            categoryTitle,
            $"Updated {(content?.DateModified?.ToString("MMMM d, yyyy") ?? DateTime.UtcNow.ToString("MMMM d, yyyy"))}"
        }
    };
}

<div id="top"></div>

<div id="progressBar"
     class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 z-50 transition-all duration-150"
     style="width:0%"></div>

<nav class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
            <li class="text-slate-300">/</li>
            <li><a href="/rankings" class="hover:text-slate-900 transition">Rankings</a></li>
            <li class="text-slate-300">/</li>
            <li class="text-slate-900 font-semibold truncate max-w-[75vw]">@categoryTitle</li>
        </ol>
    </div>
</nav>

<main class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="w-full">
        @await Html.PartialAsync("_PageHero", heroModel)

        @await Html.PartialAsync("~/Views/Rankings/_RankingBody.cshtml", Model)

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</main>

@await Html.PartialAsync("_TocMobileFab", Model)

@await Html.PartialAsync("_StructuredData", Model)

<script src="~/js/rankings/rankingTable.js" asp-append-version="true"></script>

<script>
    window.addEventListener('scroll', () => {
        const windowHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (windowHeight > 0) ? (window.scrollY / windowHeight) * 100 : 0;
        const progressBar = document.getElementById('progressBar');
        if (progressBar) progressBar.style.width = Math.min(scrolled, 100) + '%';
    });

    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('tocBackToTop');
        btn?.addEventListener('click', function () {
            const top = document.getElementById('top');
            if (top) top.scrollIntoView({ behavior: 'smooth', block: 'start' });
            else window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    });
</script>
