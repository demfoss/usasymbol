@model USASymbol.Models.ViewModels.PageHubViewModel
@inject IImageUrlService Images

@{
    var isGroupPage = Model.IsGroupPage;
    var groupCategory = isGroupPage ? Model.Categories[0] : null;

    ViewData["Title"]       = isGroupPage
        ? (ViewData["Title"] as string ?? $"{groupCategory!.Title} Rankings")
        : "U.S. State Rankings — Compare All 50 States";
    ViewData["Description"] = isGroupPage
        ? (ViewData["Description"] as string ?? $"Compare U.S. states by {groupCategory!.Title.ToLower()} with interactive ranking tables.")
        : "Compare and rank all 50 U.S. states by geography, demographics, economy, government, and more. Interactive tables with search and sorting.";

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData["Canonical"] = isGroupPage ? $"/rankings/{groupCategory!.Id}" : "/rankings";

    const int PreviewCount = 9;
}

<div id="top"></div>

<!-- Sticky breadcrumb bar -->
<div class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-3">
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
                <li class="text-slate-300">/</li>
                @if (isGroupPage)
                {
                    <li><a href="/rankings" class="hover:text-slate-900 transition">Rankings</a></li>
                    <li class="text-slate-300">/</li>
                    <li class="text-slate-900 font-semibold truncate max-w-[75vw]">@groupCategory!.Title</li>
                }
                else
                {
                    <li class="text-slate-900 font-semibold">Rankings</li>
                }
            </ol>
        </nav>
    </div>
</div>

<div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-8 lg:py-12">

    <!-- HERO -->
    <section class="mb-8 lg:mb-10">
        <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-slate-50 to-transparent"></div>
            <div class="relative p-6 sm:p-8 lg:p-10">

                <div class="flex flex-wrap items-center gap-2 mb-5">
                    <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-800">
                        <span class="inline-block h-1.5 w-1.5 rounded-full bg-slate-900"></span>
                        Rankings
                    </span>
                    @if (isGroupPage && groupCategory != null)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700">
                            <i class="@groupCategory.Icon text-[10px]"></i>
                            @groupCategory.Title
                        </span>
                    }
                    <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700">
                        <i class="fa-solid fa-chart-bar text-[10px]" aria-hidden="true"></i>
                        @Model.Categories.Sum(c => c.Items.Count) rankings
                    </span>
                </div>

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-slate-900 max-w-3xl">
                    @if (isGroupPage && groupCategory != null)
                    {
                        @($"{groupCategory.Title} Rankings")
                    }
                    else
                    {
                        <text>U.S. State Rankings</text>
                    }
                </h1>

                <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
                    @if (isGroupPage && groupCategory != null && !string.IsNullOrEmpty(groupCategory.Description))
                    {
                        @groupCategory.Description
                    }
                    else if (isGroupPage)
                    {
                        <text>Compare all 50 states with sortable, searchable tables in this category.</text>
                    }
                    else
                    {
                        <text>Compare all 50 states across geography, demographics, economy, and more — with interactive sortable tables.</text>
                    }
                </p>

                <!-- Search -->
                <div class="mt-6 max-w-md">
                    <div class="relative">
                        <input id="hubSearch"
                               type="text"
                               placeholder="Search rankings…"
                               autocomplete="off"
                               class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 pr-10 text-sm text-slate-900 placeholder-slate-400
                                      shadow-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200 transition" />
                        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (Model.HasCategories)
    {
        <!-- CATEGORY TABS (only on hub, not group page) -->
        @if (!isGroupPage && Model.Categories.Count > 1)
        {
            <div class="sticky top-[105px] z-20 -mx-4 lg:-mx-6 px-4 lg:px-6 mb-8
                        bg-white/90 backdrop-blur border-b border-slate-100 supports-[backdrop-filter]:bg-white/80">
                <div class="flex items-center gap-1 overflow-x-auto scrollbar-hide py-3 max-w-screen-xl mx-auto">
                    @foreach (var category in Model.Categories)
                    {
                        <a href="#@category.Id"
                           class="category-tab flex-shrink-0 inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white
                                  px-3.5 py-1.5 text-xs font-semibold text-slate-600
                                  hover:border-slate-900 hover:text-slate-900 hover:bg-slate-50 transition-all
                                  data-[active=true]:border-slate-900 data-[active=true]:bg-slate-900 data-[active=true]:text-white"
                           data-target="@category.Id">
                            <i class="@category.Icon text-[10px]" aria-hidden="true"></i>
                            @category.Title
                            <span class="ml-0.5 opacity-60">@category.Items.Count</span>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- CATEGORY SECTIONS -->
        <div class="space-y-12" id="categoryList">
            @foreach (var category in Model.Categories)
            {
                var overflowCount = Math.Max(0, category.Items.Count - PreviewCount);

                <section id="@category.Id" class="category-section scroll-mt-32">

                    @if (!isGroupPage)
                    {
                        <!-- Category header -->
                        <div class="flex items-center justify-between gap-4 mb-6">
                            <div class="flex items-center gap-3">
                                <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-slate-900 text-white text-sm shrink-0">
                                    <i class="@category.Icon text-xs" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-900 leading-snug">@category.Title</h2>
                                    @if (!string.IsNullOrEmpty(category.Description))
                                    {
                                        <p class="text-sm text-slate-500">@category.Description</p>
                                    }
                                </div>
                            </div>
                            @if (overflowCount > 0)
                            {
                                <a href="/rankings/@category.Id"
                                   class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition shrink-0">
                                    View all @category.Items.Count <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            }
                        </div>
                    }

                    <!-- Cards grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @for (int i = 0; i < category.Items.Count; i++)
                        {
                            var item = category.Items[i];
                            var isOverflow = i >= PreviewCount;
                            <a href="@item.Url"
                               class="ranking-card group flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm
                                      hover:border-slate-300 hover:shadow-md transition-all duration-200@(isOverflow ? " overflow-card hidden" : "")"
                               data-title="@item.Title.ToLower()"
                               data-description="@(item.Description?.ToLower() ?? "")">

                                <!-- Thumbnail -->
                                <div class="relative h-40 bg-slate-100 overflow-hidden shrink-0">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@Images.Card(item.Image)"
                                             srcset="@(Images.Card(item.Image, 320)) 320w,
                                                     @(Images.Card(item.Image, 480)) 480w,
                                                     @(Images.Card(item.Image, 640)) 640w"
                                             sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
                                             alt="@(item.ImageAlt ?? item.Title)"
                                             loading="lazy"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                             onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden')" />
                                        <div class="hidden w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                                            <i class="@category.Icon text-3xl text-slate-400" aria-hidden="true"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                                            <i class="@category.Icon text-3xl text-slate-400" aria-hidden="true"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Content -->
                                <div class="flex flex-col flex-1 p-4">
                                    <h3 class="text-sm font-bold text-slate-900 group-hover:text-slate-700 transition leading-snug mb-1.5">
                                        @item.Title
                                    </h3>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 flex-1">
                                            @item.Description
                                        </p>
                                    }
                                    <div class="mt-3 flex items-center justify-between">
                                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">
                                            <i class="fa-solid fa-chart-bar text-[9px]"></i>
                                            Ranking
                                        </span>
                                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-slate-100
                                                     group-hover:bg-slate-900 transition-colors">
                                            <i class="fa-solid fa-arrow-right text-slate-400 text-[10px] group-hover:text-white transition-colors"></i>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <!-- Show more button -->
                    @if (overflowCount > 0)
                    {
                        <div class="mt-5 text-center show-more-wrapper">
                            <button type="button"
                                    class="show-more-btn inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5
                                           text-sm font-semibold text-slate-700 shadow-sm hover:border-slate-900 hover:text-slate-900 hover:bg-slate-50 transition-all"
                                    data-section="@category.Id"
                                    data-overflow="@overflowCount">
                                <i class="fa-solid fa-chevron-down text-xs"></i>
                                Show @overflowCount more rankings
                            </button>
                        </div>
                    }
                </section>
            }
        </div>

        <!-- No results state -->
        <div id="noResults" class="hidden text-center py-20">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100">
                <i class="fa-solid fa-magnifying-glass text-2xl text-slate-400"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">No rankings found</h2>
            <p class="text-sm text-slate-500">Try a different search term</p>
        </div>
    }
    else
    {
        <div class="text-center py-20">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100">
                <i class="fa-solid fa-chart-bar text-2xl text-slate-400"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">Rankings Coming Soon</h2>
            <p class="text-sm text-slate-500">We're building interactive state rankings for you.</p>
        </div>
    }

</div>

<!-- SCHEMA.ORG -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebPage",
  "name": "@(isGroupPage ? $"{groupCategory?.Title} Rankings" : "U.S. State Rankings")",
  "description": "@ViewData["Description"]",
  "url": "@($"{baseUrl}{ViewData["Canonical"]}")",
  "license": "@($"{baseUrl}/terms")",
  "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "@baseUrl" },
  "publisher": {
    "@@type": "Organization",
    "name": "USA Symbol",
    "url": "@baseUrl"
  }
}
</script>

<script>
    (() => {
        // ── Search ──────────────────────────────────────────────
        const input    = document.getElementById('hubSearch');
        const cards    = document.querySelectorAll('.ranking-card');
        const sections = document.querySelectorAll('.category-section');
        const noResults = document.getElementById('noResults');

        if (input) {
            input.addEventListener('input', () => {
                const q = input.value.trim().toLowerCase();
                let visible = 0;

                if (!q) {
                    // restore: show only non-overflow cards, hide overflow ones
                    cards.forEach(card => {
                        const isOverflow = card.classList.contains('overflow-card');
                        card.classList.toggle('hidden', isOverflow);
                    });
                    sections.forEach(s => s.classList.remove('hidden'));
                    document.querySelectorAll('.show-more-wrapper').forEach(w => w.classList.remove('hidden'));
                    noResults?.classList.add('hidden');
                    return;
                }

                // During search: show ALL cards that match (ignore overflow)
                document.querySelectorAll('.show-more-wrapper').forEach(w => w.classList.add('hidden'));

                cards.forEach(card => {
                    const match = (card.dataset.title || '').includes(q) ||
                                  (card.dataset.description || '').includes(q);
                    card.classList.toggle('hidden', !match);
                    if (match) visible++;
                });

                sections.forEach(section => {
                    const hasVisible = section.querySelectorAll('.ranking-card:not(.hidden)').length > 0;
                    section.classList.toggle('hidden', !hasVisible);
                });

                noResults?.classList.toggle('hidden', visible > 0);
            });
        }

        // ── Show More ────────────────────────────────────────────
        document.querySelectorAll('.show-more-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const sectionId = btn.dataset.section;
                const section   = document.getElementById(sectionId);
                if (!section) return;

                section.querySelectorAll('.overflow-card').forEach(card => card.classList.remove('hidden'));
                btn.closest('.show-more-wrapper').classList.add('hidden');
            });
        });

        // ── Category tab active state (IntersectionObserver) ─────
        const tabs = document.querySelectorAll('.category-tab');
        if (tabs.length === 0) return;

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    tabs.forEach(tab => {
                        const isActive = tab.dataset.target === id;
                        tab.dataset.active = isActive ? 'true' : 'false';
                    });
                }
            });
        }, { rootMargin: '-30% 0px -60% 0px' });

        sections.forEach(s => observer.observe(s));

        // Smooth scroll on tab click
        tabs.forEach(tab => {
            tab.addEventListener('click', e => {
                e.preventDefault();
                const target = document.getElementById(tab.dataset.target);
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    })();
</script>
