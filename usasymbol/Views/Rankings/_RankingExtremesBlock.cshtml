@using Usasymbol.Helpers
@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var content = Model.Content;
    var mode = content?.ExtremesMode?.Trim().ToLowerInvariant();
    if (mode is not ("both" or "toponly" or "bottomonly")) { return; }
    var ranking = RankingPresentation.Create(content?.Table);
    if (ranking == null || ranking.Ordered.Any(p => !KeyTakeawaysBuilder.IsState(p.StateSlug))) { return; }
    if (ranking.Ordered.Select(p => p.StateSlug).Distinct(StringComparer.OrdinalIgnoreCase).Count() != ranking.Ordered.Count) { return; }

    // Few rows: the two lists would just repeat the table, so show every state in one chart instead.
    // 20-34 rows: 5 + 5; 35 and more: 10 + 10 (5 + "Show 10" on phones).
    var total = ranking.Ordered.Count;
    var showAll = total < 20;
    var sideLimit = total >= 35 ? 10 : 5;
    var presentation = new RankingExtremesPresentation(content!, ranking,
        mode is "both" or "toponly", mode is "both" or "bottomonly", sideLimit);
    var sides = new[] { presentation.Top, presentation.Bottom }.Where(side => side != null).ToList();
    var paired = sides.Count == 2;
    var additive = content!.Table?.Metric?.Additive == true;
    var heading = showAll
        ? $"How the {total} States Compare"
        : string.IsNullOrWhiteSpace(content.ExtremesTitle)
            ? $"{(paired ? (additive ? "Most and Fewest" : "Highest and Lowest") : sides[0]!.Label)} {presentation.UnitLabel} by State"
            : content.ExtremesTitle;
    var points = ranking.Ordered;
    var maxPoint = points.MaxBy(p => p.Value)!;
    var minPoint = points.MinBy(p => p.Value)!;
    string? gap = !presentation.Diverging && minPoint.Value > 0 && maxPoint.Value / minPoint.Value >= 2
        ? $"{maxPoint.State} ({maxPoint.DisplayValue}) is {(maxPoint.Value / minPoint.Value).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}\u00D7 {minPoint.State} ({minPoint.DisplayValue})."
        : null;
    // Map bucket colours per state (postal code), reused for the bars.
    IReadOnlyDictionary<string, string>? barColors = null;
    if (content.Map != null && content.Table?.Rows?.Count > 0)
    {
        var choropleth = string.IsNullOrWhiteSpace(content.Map.MetricKey)
            ? ChoroplethBuilder.BuildFlat(content.Table.Rows)
            : ChoroplethBuilder.Build(content.Map, content.Table.Rows,
                content.Table.Columns.FirstOrDefault(column => column.Key == content.Map.MetricKey));
        barColors = choropleth.Entries
            .Where(e => !string.IsNullOrEmpty(e.PostalCode) && !string.IsNullOrEmpty(e.FillColor))
            .GroupBy(e => e.PostalCode, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().FillColor, StringComparer.OrdinalIgnoreCase);
    }
    var tableAnchor = (ViewData["RankingTableSectionId"] as string ?? "ranking-table").Trim();
}

<div class="content-divider ranking-extremes" data-extremes>
    <div class="ranking-extremes__heading">
        <h2>@heading</h2>
        @if (presentation.Diverging)
        {
            <p class="ranking-extremes__scale-note">
                @if (presentation.National != null)
                {
                    <text>Bars show distance from the U.S. figure, @presentation.MeanDisplay. @presentation.National.Caption.</text>
                }
                else
                {
                    <text>Bars show deviation from the mean across @ranking.Ordered.Count states: @presentation.MeanDisplay @presentation.UnitLabel.ToLowerInvariant(). Each state has equal weight.</text>
                }
            </p>
        }
        else if (gap != null)
        {
            <p class="ranking-extremes__gap">@gap</p>
        }
    </div>

    @if (showAll)
    {
        <section class="ranking-extreme-list ranking-extreme-list--all">
            <div class="ranking-extreme-list__header"><h3>@presentation.UnitLabel by state</h3></div>
            <div class="ranking-extreme-list__rows">
                @{ var allIndex = 0; }
                @foreach (var point in points.OrderByDescending(p => p.Value).ThenBy(p => p.State, StringComparer.OrdinalIgnoreCase))
                {
                    @await Html.PartialAsync("~/Views/Rankings/_RankingExtremeRow.cshtml",
                        new RankingExtremeRowModel(presentation, point, content.Table!, allIndex++, barColors))
                }
            </div>
        </section>
    }
    else
    {
        @if (paired)
        {
            <div class="ranking-extremes__tabs" role="tablist" aria-label="Show">
                <button type="button" role="tab" aria-selected="true" data-extremes-tab="highest">@(additive ? "Most" : "Highest")</button>
                <button type="button" role="tab" aria-selected="false" data-extremes-tab="lowest">@(additive ? "Fewest" : "Lowest")</button>
            </div>
        }
        <div class="ranking-extremes__charts @(paired ? "ranking-extremes__charts--paired" : "")">
            @foreach (var side in sides)
            {
                @await Html.PartialAsync("~/Views/Rankings/_RankingExtremeList.cshtml",
                    new RankingExtremeListModel(presentation, side!, content.Table!, 5, barColors))
            }
        </div>
        @if (sideLimit > 5)
        {
            <button type="button" class="ranking-extremes__more" data-extremes-more>Show @sideLimit</button>
        }
    }
    <p class="ranking-extremes__all"><a href="#@tableAnchor">See full table <span aria-hidden="true">&rarr;</span></a></p>
</div>
@if (!showAll)
{
    <script src="~/js/rankings/ranking-extremes.js" asp-append-version="true" defer></script>
}
