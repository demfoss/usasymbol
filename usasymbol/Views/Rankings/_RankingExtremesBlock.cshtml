@using System.Globalization
@using USASymbol.Models.Content
@using USASymbol.Models.ViewModels
@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var table = Model.Content?.Table;
    if (table == null || table.Rows.Count < 3) { return; }

    // Mode from YAML extremes_mode field. If omitted or invalid, do not render the block.
    var rawMode = (Model.Content?.ExtremesMode ?? "none").Trim().ToLowerInvariant();
    if (string.IsNullOrWhiteSpace(rawMode) || rawMode == "none") { return; }
    if (rawMode is not ("both" or "toponly" or "bottomonly")) { return; }
    var showTop    = rawMode is "both" or "toponly";
    var showBottom = rawMode is "both" or "bottomonly";

    // System keys never used as the metric column
    var systemKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        { "rank", "order", "state", "state_slug", "postal_code",
          "symbol_slug", "custom_url", "symbol_image" };

    // Metric column: prefer DefaultColumn, otherwise first non-system non-image column
    var metricKey = table.DefaultColumn
        ?? table.Columns
               .Where(c => !systemKeys.Contains(c.Key) && c.Type != "image" && c.Type != "url")
               .Select(c => c.Key)
               .FirstOrDefault();

    if (metricKey == null) { return; }

    var metricCol    = table.Columns.FirstOrDefault(c => c.Key == metricKey);
    var metricLabel  = metricCol?.Label ?? metricKey;
    var extremesTitle = Model.Content?.ExtremesTitle;

    // Parse a row's metric value as double (for bar-width math)
    double? ParseVal(TableRow row)
    {
        if (!row.Has(metricKey)) return null;
        var raw = row.Data[metricKey]?.ToString() ?? "";
        raw = raw.Replace(",", "").Replace("$", "").Replace("%", "").Trim();
        return double.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var d) ? d : (double?)null;
    }

    // Pre-compute values; skip rows where metric is unparseable
    var rowsWithVals = table.Rows
        .Select(r => (Row: r, Val: ParseVal(r)))
        .Where(x => x.Val.HasValue)
        .ToList();

    if (rowsWithVals.Count < 3) { return; }

    // Rows are already sorted best-rank-first in the YAML
    var topRows    = rowsWithVals.Take(10).ToList();
    var bottomRows = showBottom && rowsWithVals.Count > 10
        ? rowsWithVals.TakeLast(10).ToList()
        : new List<(TableRow Row, double? Val)>();

    if (!showTop && bottomRows.Count == 0) { return; }

    // Highlight cards: first and last row
    var topCard    = topRows.FirstOrDefault();
    var bottomCard = bottomRows.LastOrDefault();

    // Bar width helpers — rank 1 always gets the widest bar within its group
    var topMax = topRows.Max(x => x.Val!.Value);
    var topMin = topRows.Min(x => x.Val!.Value);

    double TopBarPct(double val)
    {
        // If top row = highest value: direct ratio
        if (topRows[0].Val!.Value >= topRows[^1].Val!.Value)
            return topMax > 0 ? Math.Round(val / topMax * 100, 1) : 0;
        // Top row = lowest value (e.g. year founded): invert
        return (topMax > topMin)
            ? Math.Round((topMax - val) / (topMax - topMin) * 100, 1)
            : 100.0;
    }

    double BotBarPct(double val)
    {
        if (bottomRows.Count == 0) return 0;
        var botMax = bottomRows.Max(x => x.Val!.Value);
        var botMin = bottomRows.Min(x => x.Val!.Value);
        // In the "lowest" chart, smaller values should look smaller visually.
        // Example: 0% should render as an empty bar, not a full one.
        return (botMax > botMin)
            ? Math.Round((val - botMin) / (botMax - botMin) * 100, 1)
            : 100.0;
    }

    string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

    // Helpers to pull common row fields
    string RowState(TableRow r) => r.GetString("state");
    string RowSlug(TableRow r)  => r.GetString("state_slug");
    string RowVal(TableRow r)   => r.Has(metricKey) ? r.Data[metricKey]?.ToString() ?? "" : "";
}

<div class="content-divider ranking-extremes">
    <div class="ranking-extremes__heading">
        @if (!string.IsNullOrWhiteSpace(extremesTitle))
        {
            <h2>@extremesTitle</h2>
        }
        else if (showTop && showBottom)
        {
            <h2>Highest and Lowest @metricLabel by State</h2>
        }
        else if (showTop)
        {
            <h2>Top 10 States by @metricLabel</h2>
        }
        else
        {
            <h2>Bottom 10 States by @metricLabel</h2>
        }
    </div>

    @* ── Highlight cards ── *@
    <div class="ranking-extremes__cards @(showTop && showBottom ? "ranking-extremes__cards--paired" : "")">

        @if (showTop && topCard.Row != null)
        {
            var slug = RowSlug(topCard.Row);
            <article class="ranking-extreme-card">
                <p class="ranking-extreme-card__label">Highest</p>
                <p class="ranking-extreme-card__value">@RowVal(topCard.Row)</p>
                <a class="ranking-extreme-card__state" href="/states/@slug">
                    <img src="/images/flags/@slug/flag.webp" alt="@RowState(topCard.Row) flag"
                         width="32" height="21"
                         onerror="this.style.display='none'" loading="lazy" />
                    <span>@RowState(topCard.Row)</span>
                </a>
            </article>
        }

        @if (showBottom && bottomCard.Row != null)
        {
            var slug = RowSlug(bottomCard.Row);
            <article class="ranking-extreme-card">
                <p class="ranking-extreme-card__label">Lowest</p>
                <p class="ranking-extreme-card__value">@RowVal(bottomCard.Row)</p>
                <a class="ranking-extreme-card__state" href="/states/@slug">
                    <img src="/images/flags/@slug/flag.webp" alt="@RowState(bottomCard.Row) flag"
                         width="32" height="21"
                         onerror="this.style.display='none'" loading="lazy" />
                    <span>@RowState(bottomCard.Row)</span>
                </a>
            </article>
        }

    </div>

    @* ── Bar charts ── *@
    <div class="ranking-extremes__charts @(showTop && showBottom ? "ranking-extremes__charts--paired" : "")">

        @* Top chart *@
        @if (showTop && topRows.Any())
        {
            <div class="ranking-extreme-list">
                <div class="ranking-extreme-list__header">
                    <h3>
                        @(showBottom ? "Top 10 Highest" : "Top 10") — @metricLabel
                    </h3>
                </div>
                <div class="ranking-extreme-list__rows">
                    @foreach (var (row, val) in topRows)
                    {
                        var barW = F(TopBarPct(val!.Value));
                        var slug = RowSlug(row);
                        <div class="ranking-extreme-row">
                            <img src="/images/flags/@slug/flag.webp" alt="@RowState(row) flag"
                                 width="28" height="18"
                                 onerror="this.style.visibility='hidden'" loading="lazy" />
                            <a href="/states/@slug" class="ranking-extreme-row__state">@RowState(row)</a>
                            <div class="ranking-extreme-row__track" aria-hidden="true">
                                <span style="width:@barW%"></span>
                            </div>
                            <span class="ranking-extreme-row__value">@RowVal(row)</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Bottom chart *@
        @if (showBottom && bottomRows.Any())
        {
            <div class="ranking-extreme-list">
                <div class="ranking-extreme-list__header">
                    <h3>
                        Top 10 Lowest — @metricLabel
                    </h3>
                </div>
                <div class="ranking-extreme-list__rows">
                    @foreach (var (row, val) in Enumerable.Reverse(bottomRows))
                    {
                        var barW = F(BotBarPct(val!.Value));
                        var slug = RowSlug(row);
                        <div class="ranking-extreme-row">
                            <img src="/images/flags/@slug/flag.webp" alt="@RowState(row) flag"
                                 width="28" height="18"
                                 onerror="this.style.visibility='hidden'" loading="lazy" />
                            <a href="/states/@slug" class="ranking-extreme-row__state">@RowState(row)</a>
                            <div class="ranking-extreme-row__track" aria-hidden="true">
                                <span style="width:@barW%"></span>
                            </div>
                            <span class="ranking-extreme-row__value">@RowVal(row)</span>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>
