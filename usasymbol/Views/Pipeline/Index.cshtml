@model USASymbol.Models.ViewModels.ContentPipelineViewModel

@{
    ViewData["Title"] = "Content Pipeline";
}

@section Styles {
    <style>
        .pipeline-page .site-main {
            padding: 2rem 0 4rem;
        }

        .pipeline-shell {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.25rem;
            display: grid;
            gap: 1.5rem;
        }

        .pipeline-hero {
            padding: 2rem;
            border-radius: 2rem;
            color: #fff8ef;
            background:
                radial-gradient(circle at top right, rgba(255, 255, 255, 0.16), transparent 30%),
                linear-gradient(135deg, rgba(17, 43, 83, 0.98), rgba(26, 94, 138, 0.95));
            box-shadow: var(--site-shadow);
        }

        .pipeline-hero h1 {
            margin: 0 0 0.8rem;
            font-family: 'Libre Baskerville', Georgia, serif;
            font-size: clamp(2.2rem, 4vw, 3.8rem);
            line-height: 1.05;
            letter-spacing: -0.04em;
        }

        .pipeline-hero p {
            margin: 0;
            max-width: 58rem;
            line-height: 1.7;
            color: rgba(255, 248, 239, 0.86);
        }

        .pipeline-grid {
            display: grid;
            gap: 1rem;
        }

        @@media (min-width: 1040px) {
            .pipeline-grid {
                grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
                align-items: start;
            }
        }

        .pipeline-card {
            border: 1px solid rgba(17, 32, 61, 0.08);
            border-radius: 1.5rem;
            background: #fffdfa;
            box-shadow: var(--site-shadow-soft);
            overflow: hidden;
        }

        .pipeline-card-head {
            padding: 1.3rem 1.35rem 0;
        }

        .pipeline-card-head h2 {
            margin: 0;
            color: var(--site-brand-strong);
            font-size: 1.15rem;
        }

        .pipeline-card-head p {
            margin: 0.45rem 0 0;
            color: var(--site-ink-soft);
            line-height: 1.65;
        }

        .pipeline-card-body {
            padding: 1.35rem;
        }

        .pipeline-form,
        .pipeline-meta,
        .pipeline-output {
            display: grid;
            gap: 1rem;
        }

        .pipeline-row {
            display: grid;
            gap: 1rem;
        }

        @@media (min-width: 760px) {
            .pipeline-row {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        .pipeline-field label {
            display: block;
            margin-bottom: 0.45rem;
            font-weight: 700;
            color: var(--site-brand-strong);
        }

        .pipeline-field-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.45rem;
        }

        .pipeline-field-heading label {
            margin-bottom: 0;
        }

        .pipeline-inline-button {
            border: 1px solid rgba(17, 32, 61, 0.18);
            border-radius: 0.75rem;
            padding: 0.45rem 0.75rem;
            background: #fff;
            color: var(--site-brand-strong);
            font-weight: 700;
        }

        .pipeline-field input,
        .pipeline-field select,
        .pipeline-field textarea {
            width: 100%;
            border: 1px solid rgba(17, 32, 61, 0.14);
            border-radius: 1rem;
            padding: 0.95rem 1rem;
            background: #fff;
            color: var(--site-ink);
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
        }

        .pipeline-field textarea {
            min-height: 10rem;
            resize: vertical;
            line-height: 1.62;
        }

        .pipeline-checkbox {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.9rem 1rem;
            border-radius: 1rem;
            background: rgba(17, 32, 61, 0.04);
        }

        .pipeline-checkbox input {
            width: 1.1rem;
            height: 1.1rem;
        }

        .pipeline-button {
            border: 0;
            border-radius: 1rem;
            min-height: 3.35rem;
            padding: 0.95rem 1.25rem;
            color: #fffaf2;
            font-weight: 800;
            letter-spacing: -0.01em;
            background: linear-gradient(135deg, #17356a 0%, #1f4b99 100%);
            box-shadow: 0 16px 28px rgba(23, 53, 106, 0.18);
        }

        .pipeline-button[disabled] {
            opacity: 0.7;
            cursor: wait;
        }

        .pipeline-error,
        .pipeline-success,
        .pipeline-meta-item,
        .pipeline-output-block,
        .pipeline-progress-shell {
            padding: 0.95rem 1rem;
            border-radius: 1rem;
        }

        .pipeline-error {
            background: rgba(179, 40, 40, 0.1);
            color: #7d1d1d;
            line-height: 1.65;
        }

        .pipeline-success {
            background: rgba(28, 112, 74, 0.1);
            color: #175c3c;
            line-height: 1.65;
        }

        .pipeline-meta-item,
        .pipeline-progress-shell {
            background: rgba(17, 32, 61, 0.04);
        }

        .pipeline-meta-item strong,
        .pipeline-output-block strong,
        .pipeline-progress-shell strong {
            display: block;
            margin-bottom: 0.35rem;
            color: var(--site-brand-strong);
        }

        .pipeline-progress-status {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .pipeline-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.3rem 0.7rem;
            font-size: 0.86rem;
            font-weight: 700;
            background: rgba(17, 32, 61, 0.08);
            color: var(--site-brand-strong);
        }

        .pipeline-progress-log {
            margin: 0;
            padding-left: 1.15rem;
            line-height: 1.7;
            max-height: 20rem;
            overflow: auto;
        }

        .pipeline-timeline {
            display: grid;
            gap: 0.75rem;
        }

        .pipeline-stage {
            display: grid;
            grid-template-columns: 1.1rem minmax(0, 1fr);
            gap: 0.9rem;
            align-items: start;
            padding: 0.85rem 0.9rem;
            border-radius: 1rem;
            border: 1px solid rgba(17, 32, 61, 0.08);
            background: #fff;
        }

        .pipeline-stage-dot {
            width: 0.95rem;
            height: 0.95rem;
            border-radius: 999px;
            margin-top: 0.25rem;
            background: rgba(17, 32, 61, 0.16);
            box-shadow: inset 0 0 0 1px rgba(17, 32, 61, 0.12);
        }

        .pipeline-stage strong {
            display: block;
            margin-bottom: 0.15rem;
            color: var(--site-brand-strong);
        }

        .pipeline-stage small {
            display: block;
            color: var(--site-ink-soft);
            line-height: 1.55;
        }

        .pipeline-stage.is-pending {
            opacity: 0.72;
        }

        .pipeline-stage.is-running {
            border-color: rgba(180, 113, 12, 0.28);
            background: rgba(255, 245, 214, 0.75);
        }

        .pipeline-stage.is-running .pipeline-stage-dot {
            background: #d08a1f;
            box-shadow: 0 0 0 6px rgba(208, 138, 31, 0.12);
        }

        .pipeline-stage.is-completed {
            border-color: rgba(28, 112, 74, 0.22);
            background: rgba(231, 247, 238, 0.9);
        }

        .pipeline-stage.is-completed .pipeline-stage-dot {
            background: #20734b;
            box-shadow: 0 0 0 6px rgba(32, 115, 75, 0.12);
        }

        .pipeline-stage.is-failed {
            border-color: rgba(179, 40, 40, 0.22);
            background: rgba(255, 237, 237, 0.92);
        }

        .pipeline-stage.is-failed .pipeline-stage-dot {
            background: #b32828;
            box-shadow: 0 0 0 6px rgba(179, 40, 40, 0.12);
        }

        .pipeline-stage.is-skipped {
            border-color: rgba(89, 89, 89, 0.14);
            background: rgba(247, 247, 247, 0.95);
        }

        .pipeline-stage.is-skipped .pipeline-stage-dot {
            background: #7d7d7d;
        }

        .pipeline-output pre {
            margin: 0;
            padding: 1rem;
            border-radius: 1rem;
            background: #fbfaf6;
            border: 1px solid rgba(17, 32, 61, 0.08);
            white-space: pre-wrap;
            word-break: break-word;
            line-height: 1.6;
            min-height: 6rem;
        }

        .pipeline-list {
            margin: 0;
            padding-left: 1.15rem;
            line-height: 1.65;
        }

        [hidden] {
            display: none !important;
        }
    </style>
}

<div class="pipeline-shell">
    <section class="pipeline-hero">
        <h1>Content Pipeline</h1>
        <p>Новый flow сведен к 2 основным prompt passes: generator и finisher. После этого pipeline показывает checks и сохраняет YAML только если блокирующих ошибок нет.</p>
    </section>

    <div class="pipeline-grid">
        <section class="pipeline-card">
            <div class="pipeline-card-head">
                <h2>Minimal Manual Input</h2>
                <p>UI собирает только ядро задачи, а справа можно в реальном времени видеть, что происходит в pipeline.</p>
            </div>
            <div class="pipeline-card-body">
                <div id="pipeline-form-error" class="pipeline-error" hidden></div>
                <div id="pipeline-form-success" class="pipeline-success" hidden></div>

                <form method="post" class="pipeline-form" id="pipeline-form" action="/pipeline/start">
                    @Html.AntiForgeryToken()

                    <div class="pipeline-row">
                        <div class="pipeline-field">
                            <label asp-for="Category"></label>
                            <select asp-for="Category">
                                @foreach (var option in Model.CategoryOptions)
                                {
                                    <option value="@option.Key">@option.Label</option>
                                }
                            </select>
                        </div>

                        <div class="pipeline-field">
                            <label asp-for="TopicOrState"></label>
                            <input asp-for="TopicOrState" />
                        </div>
                    </div>

                    <div class="pipeline-field">
                        <label asp-for="PrimaryKeyword"></label>
                        <input asp-for="PrimaryKeyword" />
                    </div>

                    <div class="pipeline-field">
                        <div class="pipeline-field-heading">
                            <label asp-for="YamlSkeleton"></label>
                            <button type="button" class="pipeline-inline-button" id="pipeline-reload-template">Reload template</button>
                        </div>
                        <textarea asp-for="YamlSkeleton"></textarea>
                    </div>

                    <div class="pipeline-field">
                        <label asp-for="SourceNotesText"></label>
                        <textarea asp-for="SourceNotesText"></textarea>
                    </div>

                    <div class="pipeline-field">
                        <label asp-for="OptionalExtraInstruction"></label>
                        <textarea asp-for="OptionalExtraInstruction"></textarea>
                    </div>

                    <label class="pipeline-checkbox">
                        <input asp-for="ImagesEnabled" />
                        <span>Queue image pipeline after text is ready</span>
                    </label>

                    <button type="submit" class="pipeline-button" id="pipeline-submit">Run Live Pipeline</button>
                </form>
            </div>
        </section>

        <section class="pipeline-card">
            <div class="pipeline-card-head">
                <h2>Live Status</h2>
                <p>Страница показывает текущий этап без перезагрузки: где мы сейчас, что уже завершилось и где именно pipeline мог споткнуться.</p>
            </div>
            <div class="pipeline-card-body">
                <div class="pipeline-progress-shell">
                    <div class="pipeline-progress-status">
                        <div>
                            <strong>Status</strong>
                            <span class="pipeline-badge" id="pipeline-live-status">Idle</span>
                        </div>
                        <div>
                            <strong>Current Step</strong>
                            <div id="pipeline-live-step">Waiting for input.</div>
                        </div>
                    </div>
                </div>

                <div class="pipeline-progress-shell">
                    <strong>Stage Timeline</strong>
                    <div class="pipeline-timeline" id="pipeline-stage-timeline">
                        <div class="pipeline-stage is-pending" data-stage="input">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Input</strong>
                                <small>Validate UI payload and start the job.</small>
                            </div>
                        </div>
                        <div class="pipeline-stage is-pending" data-stage="payload">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Payload</strong>
                                <small>Load config, examples, warnings, and internal links.</small>
                            </div>
                        </div>
                        <div class="pipeline-stage is-pending" data-stage="generator">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Generator</strong>
                                <small>Ask Claude for the first SEO-aware YAML draft.</small>
                            </div>
                        </div>
                        <div class="pipeline-stage is-pending" data-stage="finisher">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Finisher</strong>
                                <small>Clean tone, tighten wording, and improve weak fragments.</small>
                            </div>
                        </div>
                        <div class="pipeline-stage is-pending" data-stage="checks">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Checks</strong>
                                <small>Validate YAML, keyword coverage, bans, FAQ, and links.</small>
                            </div>
                        </div>
                        <div class="pipeline-stage is-pending" data-stage="save">
                            <span class="pipeline-stage-dot"></span>
                            <div>
                                <strong>Save</strong>
                                <small>Write final YAML to the target content path.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pipeline-progress-shell">
                    <strong>Progress Log</strong>
                    <ol class="pipeline-progress-log" id="pipeline-progress-log">
                        <li>Nothing is running yet.</li>
                    </ol>
                </div>

                <div class="pipeline-meta">
                    <div class="pipeline-meta-item">
                        <strong>Prompt Files</strong>
                        `Content/content-pipeline/prompts/generator-prompt.txt`, `finisher-prompt.txt`
                    </div>
                    <div class="pipeline-meta-item">
                        <strong>Checks</strong>
                        YAML validity, keyword coverage, anti-template bans, FAQ usefulness, internal links, title/description presence, similarity warning
                    </div>
                    <div class="pipeline-meta-item">
                        <strong>Category Templates</strong>
                        `Content/content-pipeline/examples/surnames.yaml`, `state-seals.yaml`, `ranking.yaml`
                    </div>
                    <div class="pipeline-meta-item">
                        <strong>Similarity Warning</strong>
                        Pattern memory is currently disabled until we add real entries instead of sample placeholders.
                    </div>
                </div>
            </div>
        </section>
    </div>

    <section class="pipeline-card" id="pipeline-result-shell" hidden>
        <div class="pipeline-card-head">
            <h2>Pipeline Result</h2>
            <p>После завершения здесь показываются итоговый статус, save path, готовый YAML и найденные issues.</p>
        </div>
        <div class="pipeline-card-body">
            <div class="pipeline-output">
                <div class="pipeline-output-block">
                    <strong>Run Summary</strong>
                    <pre id="pipeline-result-summary">No run yet.</pre>
                </div>

                <div class="pipeline-output-block">
                    <strong>Final YAML</strong>
                    <pre id="pipeline-result-yaml">No final YAML yet.</pre>
                </div>

                <div class="pipeline-output-block" id="pipeline-issues-shell" hidden>
                    <strong>Check Issues</strong>
                    <ul class="pipeline-list" id="pipeline-issues-list"></ul>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('pipeline-form');
            const categorySelect = document.getElementById('Category');
            const yamlSkeletonField = document.getElementById('YamlSkeleton');
            const reloadTemplateButton = document.getElementById('pipeline-reload-template');
            const submitButton = document.getElementById('pipeline-submit');
            const errorBox = document.getElementById('pipeline-form-error');
            const successBox = document.getElementById('pipeline-form-success');
            const liveStatus = document.getElementById('pipeline-live-status');
            const liveStep = document.getElementById('pipeline-live-step');
            const progressLog = document.getElementById('pipeline-progress-log');
            const stageTimeline = document.getElementById('pipeline-stage-timeline');
            const resultShell = document.getElementById('pipeline-result-shell');
            const resultSummary = document.getElementById('pipeline-result-summary');
            const resultYaml = document.getElementById('pipeline-result-yaml');
            const issuesShell = document.getElementById('pipeline-issues-shell');
            const issuesList = document.getElementById('pipeline-issues-list');

            let pollTimer = null;
            let lastAutoTemplateCategory = '';
            let lastAutoTemplateValue = '';
            const stageOrder = ['input', 'payload', 'generator', 'finisher', 'checks', 'save'];
            const stageLabels = {
                queued: 'input',
                starting: 'input',
                input: 'input',
                payload: 'payload',
                generator: 'generator',
                finisher: 'finisher',
                checks: 'checks',
                similarity: 'checks',
                save: 'save',
                'save-skipped': 'save',
                completed: 'save',
                failed: 'save'
            };

            function setError(message) {
                errorBox.hidden = !message;
                errorBox.textContent = message || '';
            }

            function setSuccess(message) {
                successBox.hidden = !message;
                successBox.textContent = message || '';
            }

            function setRunning(isRunning) {
                submitButton.disabled = isRunning;
                submitButton.textContent = isRunning ? 'Running Pipeline...' : 'Run Live Pipeline';
            }

            async function loadCategoryTemplate(category, forceReplace = false) {
                if (!category) {
                    return;
                }

                try {
                    const response = await fetch(`/pipeline/template/${encodeURIComponent(category)}`, {
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        return;
                    }

                    const payload = await response.json();
                    const template = payload.yamlSkeleton || '';
                    if (!template) {
                        return;
                    }

                    const currentValue = (yamlSkeletonField.value || '').trim();
                    const canReplace =
                        forceReplace ||
                        !currentValue ||
                        currentValue === lastAutoTemplateValue;

                    if (canReplace) {
                        yamlSkeletonField.value = template;
                        lastAutoTemplateCategory = category;
                        lastAutoTemplateValue = template.trim();
                    }
                } catch {
                    // Template loading should not block the page.
                }
            }

            function resetProgressUi() {
                liveStatus.textContent = 'Starting';
                liveStep.textContent = 'Preparing live run.';
                progressLog.innerHTML = '<li>Pipeline job created.</li>';
                applyTimelineState([], 'starting', '');
                resultShell.hidden = true;
                issuesShell.hidden = true;
                issuesList.innerHTML = '';
                resultSummary.textContent = 'Run in progress.';
                resultYaml.textContent = 'Waiting for final YAML.';
            }

            function setStageClass(stageElement, className) {
                stageElement.classList.remove('is-pending', 'is-running', 'is-completed', 'is-failed', 'is-skipped');
                stageElement.classList.add(className);
            }

            function applyTimelineState(entries, status, currentStep) {
                const completed = new Set();
                let activeStage = stageLabels[currentStep] || '';

                for (const entry of entries) {
                    const mapped = stageLabels[entry.step];
                    if (!mapped) {
                        continue;
                    }

                    if (entry.step === 'save-skipped') {
                        completed.add('checks');
                        activeStage = 'save';
                        continue;
                    }

                    if (entry.step === 'completed') {
                        completed.add('save');
                        continue;
                    }

                    if (entry.step !== 'failed') {
                        const currentIndex = stageOrder.indexOf(mapped);
                        for (let i = 0; i < currentIndex; i += 1) {
                            completed.add(stageOrder[i]);
                        }
                    }
                }

                const stageNodes = stageTimeline.querySelectorAll('[data-stage]');
                stageNodes.forEach((node) => {
                    const stage = node.getAttribute('data-stage');

                    if (completed.has(stage)) {
                        setStageClass(node, 'is-completed');
                        return;
                    }

                    if (stage === activeStage && status === 'failed') {
                        setStageClass(node, 'is-failed');
                        return;
                    }

                    if (stage === activeStage && status !== 'completed') {
                        if (currentStep === 'save-skipped' && stage === 'save') {
                            setStageClass(node, 'is-skipped');
                            return;
                        }

                        setStageClass(node, 'is-running');
                        return;
                    }

                    setStageClass(node, 'is-pending');
                });

                if (status === 'completed') {
                    const saveStage = stageTimeline.querySelector('[data-stage="save"]');
                    if (saveStage) {
                        setStageClass(saveStage, 'is-completed');
                    }
                }
            }

            function formatTimestamp(value) {
                if (!value) {
                    return '';
                }

                const date = new Date(value);
                return date.toLocaleTimeString();
            }

            function updateProgress(state) {
                liveStatus.textContent = state.status || 'Unknown';
                liveStep.textContent = state.currentMessage || state.currentStep || 'Working...';

                const entries = state.progressEntries || [];
                applyTimelineState(entries, state.status || '', state.currentStep || '');
                progressLog.innerHTML = entries.length
                    ? entries.map(entry => `<li><strong>${formatTimestamp(entry.timestampUtc)}</strong> ${entry.step}: ${entry.message}</li>`).join('')
                    : '<li>No progress entries yet.</li>';

                if (state.status === 'completed' || state.status === 'failed') {
                    resultShell.hidden = false;
                }

                if (state.status === 'completed' && state.result) {
                    const result = state.result;
                    setSuccess(result.savedToDisk
                        ? `Pipeline completed and saved ${result.savePath}.`
                        : 'Pipeline completed, but final YAML was not saved.');

                    resultSummary.textContent =
`Mode: ${result.executionMode}
Saved to disk: ${result.savedToDisk}
Save path: ${result.savePath}
Checks success: ${result.checks?.isSuccess}
Checks summary: ${result.checks?.summary}
Similarity warning: ${result.similarity?.isWarning}
Images pipeline queued: ${result.imagesPipelineQueued}`;

                    resultYaml.textContent = result.finalYaml || 'No final YAML returned.';
                    const issues = result.checks?.issues || [];
                    issuesShell.hidden = issues.length === 0;
                    issuesList.innerHTML = issues.map(issue =>
                        `<li><strong>${issue.severity}</strong> ${issue.code}: ${issue.message} (${issue.targetFragment})</li>`).join('');
                }

                if (state.status === 'failed') {
                    setError(state.errorMessage || 'Pipeline failed.');
                    resultSummary.textContent = state.errorMessage || 'Pipeline failed.';
                }
            }

            function stopPolling() {
                if (pollTimer) {
                    clearTimeout(pollTimer);
                    pollTimer = null;
                }
                setRunning(false);
            }

            async function pollJob(jobId) {
                try {
                    const response = await fetch(`/pipeline/status/${jobId}`, {
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Failed to load pipeline status.');
                    }

                    const state = await response.json();
                    updateProgress(state);

                    if (state.status === 'completed' || state.status === 'failed') {
                        stopPolling();
                        return;
                    }

                    pollTimer = setTimeout(() => pollJob(jobId), 1500);
                } catch (error) {
                    stopPolling();
                    setError(error.message || 'Failed to poll pipeline status.');
                }
            }

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                stopPolling();
                setError('');
                setSuccess('');
                setRunning(true);
                resetProgressUi();

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    const payload = await response.json();
                    if (!response.ok) {
                        throw new Error(payload.error || 'Pipeline start failed.');
                    }

                    pollJob(payload.jobId);
                } catch (error) {
                    stopPolling();
                    setError(error.message || 'Pipeline start failed.');
                }
            });

            categorySelect.addEventListener('change', async () => {
                await loadCategoryTemplate(categorySelect.value);
            });

            reloadTemplateButton.addEventListener('click', async () => {
                await loadCategoryTemplate(categorySelect.value, true);
            });

            if (!(yamlSkeletonField.value || '').trim()) {
                loadCategoryTemplate(categorySelect.value, true);
            } else {
                lastAutoTemplateValue = (yamlSkeletonField.value || '').trim();
                lastAutoTemplateCategory = categorySelect.value || '';
            }
        })();
    </script>
}
