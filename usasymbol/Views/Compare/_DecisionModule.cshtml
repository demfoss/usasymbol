@model USASymbol.Models.ViewModels.StatePairComparisonViewModel
@using USASymbol.Services
@inject IImageUrlService Images
@inject IStateMatchService StateMatch

@{
    var accentA = ViewData["AccentA"] as string ?? "#1D5A8F";
    var accentB = ViewData["AccentB"] as string ?? "#B45309";
    var score = ComparisonScoreCalculator.Calculate(Model);

    (State winner, State loser, string winVal, string loseVal) WinnerOf(MetricComparisonResult r)
    {
        bool aWins = r.WinnerSlug == Model.StateA.Slug;
        return (
            aWins ? Model.StateA : Model.StateB,
            aWins ? Model.StateB : Model.StateA,
            (aWins ? r.DisplayValueA : r.DisplayValueB) ?? "-",
            (aWins ? r.DisplayValueB : r.DisplayValueA) ?? "-"
        );
    }

    string ChipFor(string category) => category switch
    {
        "Affordability" or "Taxes" => "Saving Money",
        "Housing" => "Housing",
        "Jobs" or "Remote Work" => "Jobs",
        "Climate" => "Weather",
        "Families" => "Family &amp; Health",
        "Politics" or "Laws" => "Politics &amp; Laws",
        _ => category
    };

    string ChipIcon(string chip) => chip switch
    {
        "Saving Money" => "fa-solid fa-piggy-bank",
        "Housing" => "fa-solid fa-house",
        "Jobs" => "fa-solid fa-briefcase",
        "Weather" => "fa-solid fa-cloud-sun",
        "Family &amp; Health" => "fa-solid fa-people-roof",
        "Politics &amp; Laws" => "fa-solid fa-scale-balanced",
        _ => "fa-solid fa-star"
    };

    var cards = new List<(string Category, string Icon, string Label, string Title, string Body, string Link)>();

    void AddCard(string slug, string category, string icon, string label, Func<State, State, string, string, string> title, Func<State, State, string, string, string> body)
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == slug);
        if (r?.WinnerSlug == null) return;
        var (w, l, wv, lv) = WinnerOf(r);
        cards.Add((category, icon, label, title(w, l, wv, lv), body(w, l, wv, lv), $"/compare/{Model.PairSlug}/{slug}"));
    }

    AddCard("cost-of-living", "Affordability", "fa-solid fa-piggy-bank", "Saving Money",
        (w, l, wv, lv) => $"{w.Name} is cheaper overall",
        (w, l, wv, lv) => $"Cost-of-living index: {wv} in {w.Name} vs {lv} in {l.Name}. On a national baseline of 100, the lower score usually means cheaper day-to-day expenses.");
    AddCard("gas-price", "Affordability", "fa-solid fa-gas-pump", "Gas Price",
        (w, l, wv, lv) => $"{w.Name} is cheaper at the pump",
        (w, l, wv, lv) => $"Average regular gas price: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("electricity-rates", "Affordability", "fa-solid fa-bolt", "Electricity",
        (w, l, wv, lv) => $"{w.Name} has cheaper electricity",
        (w, l, wv, lv) => $"Average residential electricity rate: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("income-tax", "Taxes", "fa-solid fa-file-invoice-dollar", "Lower Taxes",
        (w, l, wv, lv) => $"{w.Name} keeps more of your paycheck",
        (w, l, wv, lv) => $"Top state income tax rate: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("home-value-to-income", "Housing", "fa-solid fa-house", "Buying a Home",
        (w, l, wv, lv) => $"{w.Name} is more attainable for buyers",
        (w, l, wv, lv) => $"Home-value-to-income ratio: {wv} in {w.Name} vs {lv} in {l.Name}. Lower means the median home is easier to afford on a median income.");
    AddCard("rent-to-income", "Housing", "fa-solid fa-key", "Renting",
        (w, l, wv, lv) => $"{w.Name} is easier for renters",
        (w, l, wv, lv) => $"Rent-to-income ratio: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("property-tax", "Housing", "fa-solid fa-house-circle-check", "Property Tax",
        (w, l, wv, lv) => $"{w.Name} has lower property taxes",
        (w, l, wv, lv) => $"Effective property tax rate: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("minimum-wage", "Jobs", "fa-solid fa-wallet", "Minimum Wage",
        (w, l, wv, lv) => $"{w.Name} has the higher minimum wage",
        (w, l, wv, lv) => $"State minimum wage: {wv} in {w.Name} vs {lv} in {l.Name}. Matters most for hourly and entry-level work.");
    AddCard("unemployment-rate", "Jobs", "fa-solid fa-briefcase", "Job Opportunities",
        (w, l, wv, lv) => $"{w.Name} looks better for job seekers",
        (w, l, wv, lv) => $"Unemployment rate: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("livability-score", "Remote Work", "fa-solid fa-laptop-house", "Remote Workers",
        (w, l, wv, lv) => $"{w.Name} looks better for remote workers",
        (w, l, wv, lv) => $"Livability score: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("commute-time", "Jobs", "fa-solid fa-road", "Shorter Commute",
        (w, l, wv, lv) => $"{w.Name} has the shorter commute",
        (w, l, wv, lv) => $"Average commute: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("average-temperature", "Climate", "fa-solid fa-temperature-half", "Warmer Climate",
        (w, l, wv, lv) => $"{w.Name} is warmer overall",
        (w, l, wv, lv) => $"Average annual temperature: {wv} in {w.Name} vs {lv} in {l.Name}.");
    AddCard("sunny-days", "Climate", "fa-solid fa-cloud-sun", "More Sunshine",
        (w, l, wv, lv) => $"{w.Name} gets more sun",
        (w, l, wv, lv) => $"Sunny days per year: {wv} in {w.Name} vs {lv} in {l.Name}.");

    {
        var familySignals = new[] {
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "violent-crime"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "life-expectancy"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "uninsured-rate"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "college-educated")
        }.Where(x => x?.WinnerSlug != null).Cast<MetricComparisonResult>().ToList();

        if (familySignals.Count >= 2)
        {
            var famA = familySignals.Count(x => x.WinnerSlug == Model.StateA.Slug);
            var famB = familySignals.Count(x => x.WinnerSlug == Model.StateB.Slug);
            if (famA != famB)
            {
                var w = famA > famB ? Model.StateA : Model.StateB;
                var l = w == Model.StateA ? Model.StateB : Model.StateA;
                var winningLabels = familySignals.Where(x => x.WinnerSlug == w.Slug).Select(x => x.Metric.Name.ToLowerInvariant()).Take(3).ToList();
                cards.Add(("Families", "fa-solid fa-people-roof", "Families",
                    $"{w.Name} looks better for families",
                    $"{w.Name} wins more family-oriented signals in this matchup, including {string.Join(", ", winningLabels)}, compared with {l.Name}.",
                    $"/compare/{Model.PairSlug}/violent-crime"));
            }
        }
    }

    var chipGroups = cards
        .GroupBy(c => ChipFor(c.Category))
        .Select(g => new { Chip = g.Key, Icon = ChipIcon(g.Key), Cards = g.ToList() })
        .OrderByDescending(g => g.Cards.Count)
        .ToList();

    string SlugOf(string s) => new string(s.ToLowerInvariant().Where(ch => char.IsLetterOrDigit(ch) || ch == ' ').ToArray()).Trim().Replace(' ', '-');

    var leaderState = score.Winner;
    var overallVerdictTitle = leaderState != null
        ? $"{leaderState.Name} leads on {(leaderState == score.StateA ? score.WinsA : score.WinsB)} of {score.Total} scored metrics"
        : "It's close between these two";
    var overallVerdictBody = leaderState != null
        ? $"{score.StateA.Name} leads on {score.WinsA} and {score.StateB.Name} on {score.WinsB}. Only metrics with a clear better-or-worse direction are scored; politics, laws, size and population are shown but never counted. Pick a priority above to see who leads where it matters to you."
        : $"{score.StateA.Name} and {score.StateB.Name} split the {score.Total} scored metrics evenly. Pick a priority above to see who pulls ahead where it matters to you.";

    // Bracket schedules for just these two states (same 2025 data as the Take-Home Pay tool).
    string taxJson = "{}";
    try
    {
        var all = System.Text.Json.Nodes.JsonNode.Parse(StateMatch.GetIncomeTaxScheduleJson())!;
        var states = new System.Text.Json.Nodes.JsonObject();
        foreach (var st in new[] { Model.StateA, Model.StateB })
        {
            var node = all["states"]?[st.Abbreviation];
            if (node != null) states[st.Abbreviation] = node.DeepClone();
        }
        taxJson = new System.Text.Json.Nodes.JsonObject
        {
            ["taxYear"] = all["taxYear"]?.DeepClone(),
            ["states"] = states
        }.ToJsonString();
    }
    catch { /* calculator hides itself without schedules */ }
}

<section class="cmp2-block cmp2-decision" id="decision">
    <div class="cmp2-shell">
        <h2 class="cmp2-title">Pick a priority</h2>

        <div class="dm-chips" id="dm-chips">
            <button type="button" class="dm-chip is-active" data-target="dm-verdict-all">
                <i class="fa-solid fa-star" aria-hidden="true"></i><span>Overall</span>
            </button>
            @foreach (var g in chipGroups)
            {
                <button type="button" class="dm-chip" data-target="dm-verdict-@SlugOf(g.Chip)">
                    <i class="@g.Icon" aria-hidden="true"></i><span>@Html.Raw(g.Chip)</span>
                </button>
            }
        </div>

        <div class="dm-verdict-wrap">
            <div class="dm-verdict" id="dm-verdict-all">
                <p class="dm-verdict-label">Overall</p>
                <h3 class="dm-verdict-title"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> @overallVerdictTitle</h3>
                <p class="dm-verdict-body">@overallVerdictBody</p>
            </div>
            @foreach (var g in chipGroups)
            {
                var headline = g.Cards[0];
                <div class="dm-verdict is-hidden" id="dm-verdict-@SlugOf(g.Chip)">
                    <p class="dm-verdict-label">If you care about @Html.Raw(g.Chip)</p>
                    <h3 class="dm-verdict-title"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i> @headline.Title</h3>
                    <p class="dm-verdict-body">@headline.Body <a href="@headline.Link">See full data &rarr;</a></p>
                    @if (g.Cards.Count > 1)
                    {
                        <ul class="dm-verdict-more">
                            @foreach (var extra in g.Cards.Skip(1).Take(3))
                            {
                                <li><a href="@extra.Link"><i class="@extra.Icon" aria-hidden="true"></i> @extra.Title</a></li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>

        @if (Model.StatsA?.RegionalPriceParity != null && Model.StatsB?.RegionalPriceParity != null && taxJson.Contains("\"states\""))
        {
            var rppA = Model.StatsA.RegionalPriceParity.Value;
            var rppB = Model.StatsB.RegionalPriceParity.Value;
            string F2(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            string Inv(double? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

            <div class="dm-calc" id="dm-calc"
                 data-rpp-a="@F2(rppA)" data-rpp-b="@F2(rppB)"
                 data-abbr-a="@Model.StateA.Abbreviation" data-abbr-b="@Model.StateB.Abbreviation"
                 data-name-a="@Model.StateA.Name" data-name-b="@Model.StateB.Name"
                 data-rent-a="@Inv(Model.StatsA?.MedianGrossRent)" data-rent-b="@Inv(Model.StatsB?.MedianGrossRent)"
                 data-mortgage-a="@Inv(Model.StatsA?.MedianOwnerCostsWithMortgage)" data-mortgage-b="@Inv(Model.StatsB?.MedianOwnerCostsWithMortgage)"
                 data-no-mortgage-a="@Inv(Model.StatsA?.MedianOwnerCostsWithoutMortgage)" data-no-mortgage-b="@Inv(Model.StatsB?.MedianOwnerCostsWithoutMortgage)">
                <script type="application/json" id="dm-tax-data">@Html.Raw(taxJson)</script>

                <h3 class="cmp2-title dm-calc-title">What's your salary really worth?</h3>

                <div class="dm-calc-inputs">
                    <label class="dm-field">
                        <span>Annual gross salary</span>
                        <div class="dm-field-money">
                            <span>$</span>
                            <input type="number" id="dm-salary" inputmode="numeric" value="100000" min="10000" max="1000000" step="5000">
                        </div>
                        <input type="range" id="dm-salary-slider" min="10000" max="500000" step="5000" value="100000">
                    </label>
                    <div class="dm-field-row">
                        <label class="dm-field">
                            <span>Filing status</span>
                            <select id="dm-status">
                                <option value="single">Single</option>
                                <option value="married">Married, filing jointly</option>
                            </select>
                        </label>
                        <label class="dm-field">
                            <span>Housing</span>
                            <select id="dm-housing">
                                <option value="rent">Renting (median rent)</option>
                                <option value="mortgage">Owning, with mortgage</option>
                                <option value="noMortgage">Owning, no mortgage</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="dm-calc-grid">
                    <article class="dm-calc-card" style="--dm-accent:@accentA">
                        <h4>@Model.StateA.Name</h4>
                        <dl>
                            <div><dt>State income tax</dt><dd id="dm-tax-a">—</dd></div>
                            <div><dt>After state tax</dt><dd id="dm-takehome-a">—</dd></div>
                            <div><dt>Housing / month</dt><dd id="dm-housing-a">—</dd></div>
                            <div><dt>Housing as share of pay</dt><dd id="dm-share-a">—</dd></div>
                            <div class="dm-calc-highlight"><dt>Buying power</dt><dd id="dm-real-a">—</dd></div>
                        </dl>
                    </article>
                    <article class="dm-calc-card" style="--dm-accent:@accentB">
                        <h4>@Model.StateB.Name</h4>
                        <dl>
                            <div><dt>State income tax</dt><dd id="dm-tax-b">—</dd></div>
                            <div><dt>After state tax</dt><dd id="dm-takehome-b">—</dd></div>
                            <div><dt>Housing / month</dt><dd id="dm-housing-b">—</dd></div>
                            <div><dt>Housing as share of pay</dt><dd id="dm-share-b">—</dd></div>
                            <div class="dm-calc-highlight"><dt>Buying power</dt><dd id="dm-real-b">—</dd></div>
                        </dl>
                    </article>
                </div>

                <p class="dm-calc-insight" id="dm-calc-insight"></p>
                <p class="dm-calc-fine">
                    Estimate for 2025. State income tax uses each state's brackets and standard deduction (<a href="/tools/take-home-pay-by-state">same data as our take-home pay tool</a>).
                    Buying power is pay after state tax divided by the BEA Regional Price Parity, so it is in national-average dollars. That index already includes housing, so rent is shown for reference and is not subtracted a second time.
                    Federal tax is the same in both states and left out. Local taxes, credits and payroll levies such as CA SDI are not modeled.
                    State averages hide big gaps between cities, so treat this as a starting point. <a href="#" id="dm-share" role="button">Copy link to this result</a>.
                </p>
            </div>
        }
    </div>
</section>

<script>
(function () {
    var chips = Array.from(document.querySelectorAll('.dm-chip'));
    var verdicts = Array.from(document.querySelectorAll('.dm-verdict'));
    chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.classList.remove('is-active'); });
            verdicts.forEach(function (v) { v.classList.add('is-hidden'); });
            chip.classList.add('is-active');
            var target = document.getElementById(chip.getAttribute('data-target'));
            if (target) target.classList.remove('is-hidden');
        });
    });
})();

(function () {
    var root = document.getElementById('dm-calc');
    if (!root) return;
    var salary = document.getElementById('dm-salary');
    var slider = document.getElementById('dm-salary-slider');
    var housing = document.getElementById('dm-housing');
    var status = document.getElementById('dm-status');
    var taxes = JSON.parse(document.getElementById('dm-tax-data').textContent);
    var rppA = parseFloat(root.dataset.rppA), rppB = parseFloat(root.dataset.rppB);
    var abbrA = root.dataset.abbrA, abbrB = root.dataset.abbrB;
    var nameA = root.dataset.nameA, nameB = root.dataset.nameB;

    // Same bracket math as the Take-Home Pay tool (state-match-core.js).
    function bracketTax(taxable, brackets) {
        var tax = 0;
        for (var i = 0; i < brackets.length; i++) {
            var floor = brackets[i][0];
            var ceiling = i + 1 < brackets.length ? brackets[i + 1][0] : Infinity;
            if (taxable <= floor) break;
            tax += (Math.min(taxable, ceiling) - floor) * brackets[i][1] / 100;
        }
        return tax;
    }
    function phased(amount, po, gross) {
        if (!amount) return 0;
        if (!po) return amount;
        return Math.max(0, amount - Math.max(0, gross - po.start) * po.rate / 100);
    }
    function stateTax(abbr, gross, st) {
        var entry = taxes.states[abbr];
        if (!entry || entry.none) return 0;
        var sc = entry[st];
        var ded = phased(sc.deduction, sc.deductionPhaseout, gross);
        var exm = phased(sc.exemption, sc.exemptionPhaseout, gross);
        return bracketTax(Math.max(0, gross - ded - exm), sc.brackets);
    }

    function num(v) { var n = parseFloat(v); return Number.isFinite(n) ? n : 0; }
    function usd(n) { return '$' + Math.round(n).toLocaleString('en-US'); }
    function pct(n) { return (Math.round(n * 10) / 10) + '%'; }
    function housingFor(side, mode) {
        if (mode === 'mortgage') return num(root.dataset['mortgage' + side]);
        if (mode === 'noMortgage') return num(root.dataset['noMortgage' + side]);
        return num(root.dataset['rent' + side]);
    }
    function set(id, text) { document.getElementById(id).textContent = text; }

    function update() {
        var gross = Math.max(0, num(salary.value));
        var mode = housing.value, st = status.value;
        var out = {};
        [['A', abbrA, rppA], ['B', abbrB, rppB]].forEach(function (x) {
            var side = x[0], tax = stateTax(x[1], gross, st);
            var takeHome = gross - tax;
            var rentYear = housingFor(side, mode) * 12;
            var real = takeHome / (x[2] / 100);
            var l = side.toLowerCase();
            set('dm-tax-' + l, usd(tax) + ' (' + pct(gross ? tax / gross * 100 : 0) + ')');
            set('dm-takehome-' + l, usd(takeHome));
            set('dm-housing-' + l, usd(rentYear / 12));
            set('dm-share-' + l, takeHome ? pct(rentYear / takeHome * 100) : '—');
            set('dm-real-' + l, usd(real));
            out[side] = real;
        });
        var aLead = out.A >= out.B;
        var gap = Math.abs(out.A - out.B);
        set('dm-calc-insight', (aLead ? nameA : nameB) + ' stretches this salary about ' + usd(gap) + ' further per year after state tax and local prices.');
    }

    function fromUrl() {
        var q = new URLSearchParams(location.search);
        var sal = parseInt(q.get('salary'), 10);
        if (sal >= 10000 && sal <= 1000000) { salary.value = sal; slider.value = Math.min(sal, 500000); }
        if (q.get('status') === 'married') status.value = 'married';
        var h = q.get('housing');
        if (h === 'own') housing.value = 'mortgage'; else if (h === 'own-free') housing.value = 'noMortgage';
    }
    function shareUrl() {
        var q = new URLSearchParams();
        q.set('salary', Math.round(num(salary.value)));
        q.set('status', status.value);
        q.set('housing', housing.value === 'rent' ? 'rent' : (housing.value === 'mortgage' ? 'own' : 'own-free'));
        return location.origin + location.pathname + '?' + q.toString() + '#decision';
    }

    salary.addEventListener('input', function () {
        var v = Math.max(10000, Math.min(1000000, parseInt(this.value, 10) || 100000));
        slider.value = Math.min(v, 500000);
        update();
    });
    slider.addEventListener('input', function () { salary.value = this.value; update(); });
    housing.addEventListener('change', update);
    status.addEventListener('change', update);
    document.getElementById('dm-share').addEventListener('click', function (e) {
        e.preventDefault();
        var url = shareUrl(), self = this;
        (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(function () {
            self.textContent = 'Link copied';
        }, function () { window.prompt('Copy this link', url); });
    });
    fromUrl();
    update();
})();
</script>
