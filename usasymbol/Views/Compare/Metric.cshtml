            case "median-income":
                ctxTitle = "Income in Context";
                ctxNote  = "A paycheck only matters relative to what things cost — and how much stays after taxes.";
                ctxRows.Add(("Purchasing Power of $100", CxMoney2(Model.StatsA?.PurchasingPower100), CxMoney2(Model.StatsB?.PurchasingPower100), $"/compare/{pair}/purchasing-power"));
                ctxRows.Add(("Cost of Living Index",  CxNum(Model.StatsA?.CostOfLivingIndex),           CxNum(Model.StatsB?.CostOfLivingIndex),           $"/compare/{pair}/cost-of-living"));
                ctxRows.Add(("State Income Tax",      CxMetric("income-tax", Model.StateA, Model.StatsA), CxMetric("income-tax", Model.StateB, Model.StatsB), $"/compare/{pair}/income-tax"));
                ctxRows.Add(("Poverty Rate",          CxPct(Model.StatsA?.PovertyRatePct),              CxPct(Model.StatsB?.PovertyRatePct),              $"/compare/{pair}/poverty-rate"));
                ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),         CxPct(Model.StatsB?.UnemploymentRatePct),         $"/compare/{pair}/unemployment-rate"));
                ctxRows.Add(("Median Home Value",     CxMon(Model.StatsA?.MedianHomeValue),             CxMon(Model.StatsB?.MedianHomeValue),             $"/compare/{pair}/home-value"));
                break;

            case "regional-price-parity":
                ctxTitle = "Price Parity in Context";
                ctxNote  = "Regional price parity is the government's official measure of how expensive a state is relative to the US average.";
                ctxRows.Add(("Purchasing Power of $100", CxMoney2(Model.StatsA?.PurchasingPower100),             CxMoney2(Model.StatsB?.PurchasingPower100),             $"/compare/{pair}/purchasing-power"));
                ctxRows.Add(("Cost of Living Index",  CxNum(Model.StatsA?.CostOfLivingIndex),                         CxNum(Model.StatsB?.CostOfLivingIndex),                         $"/compare/{pair}/cost-of-living"));
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome),                   CxMon(Model.StatsB?.MedianHouseholdIncome),                     $"/compare/{pair}/median-income"));
                ctxRows.Add(("Median Home Value",     CxMon(Model.StatsA?.MedianHomeValue),                           CxMon(Model.StatsB?.MedianHomeValue),                           $"/compare/{pair}/home-value"));
                ctxRows.Add(("Gas Price",             CxMetric("gas-price", Model.StateA, Model.StatsA),              CxMetric("gas-price", Model.StateB, Model.StatsB),              $"/compare/{pair}/gas-price"));
                ctxRows.Add(("Electricity Rate",      CxMetric("electricity-rates", Model.StateA, Model.StatsA),      CxMetric("electricity-rates", Model.StateB, Model.StatsB),      $"/compare/{pair}/electricity-rates"));
                break;

            case "poverty-rate":
                ctxTitle = "Poverty in Context";
                ctxNote  = "Poverty reflects wages, jobs, local costs, and access to public programs — rarely just one factor.";
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome), $"/compare/{pair}/median-income"));
                ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),     CxPct(Model.StatsB?.UnemploymentRatePct),     $"/compare/{pair}/unemployment-rate"));
                ctxRows.Add(("Cost of Living Index",  CxNum(Model.StatsA?.CostOfLivingIndex),       CxNum(Model.StatsB?.CostOfLivingIndex),       $"/compare/{pair}/cost-of-living"));
                ctxRows.Add(("Uninsured Rate",        CxPct(Model.StatsA?.UninsuredRatePct),        CxPct(Model.StatsB?.UninsuredRatePct),        null));
                ctxRows.Add(("Life Expectancy",       CxYrs(Model.StatsA?.LifeExpectancyYears),     CxYrs(Model.StatsB?.LifeExpectancyYears),     $"/compare/{pair}/life-expectancy"));
                break;

            case "employment-population-ratio":
                ctxTitle = "Employment Picture";
                ctxNote  = "The employment-to-population ratio captures more of the working-age story than the headline unemployment rate.";
                ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),         CxPct(Model.StatsB?.UnemploymentRatePct),         $"/compare/{pair}/unemployment-rate"));
                ctxRows.Add(("Job Growth",            CxPct(Model.StatsA?.JobGrowthPct),               CxPct(Model.StatsB?.JobGrowthPct),               $"/compare/{pair}/job-growth"));
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome),    CxMon(Model.StatsB?.MedianHouseholdIncome),     $"/compare/{pair}/median-income"));
                ctxRows.Add(("Poverty Rate",          CxPct(Model.StatsA?.PovertyRatePct),             CxPct(Model.StatsB?.PovertyRatePct),             $"/compare/{pair}/poverty-rate"));
                break;

            case "unemployment-rate":
                ctxTitle = "Jobs Picture";
                ctxNote  = "Unemployment is one signal — the employment ratio and job growth round out the full picture.";
