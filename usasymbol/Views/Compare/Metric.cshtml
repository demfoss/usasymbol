            <i class="@Model.Metric.Icon text-yellow-300 mr-2"></i>
            @Model.Metric.Name Comparison
        </span>
        <div class="mb-4">
            <span class="inline-flex items-center rounded-full border border-blue-300/40 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-100">
                @Model.Metric.GroupName
            </span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold mb-4">@titleA vs @titleB: @Model.Metric.Name</h1>
        @if (!string.IsNullOrWhiteSpace(directAnswer))
        {
            <p class="text-xl text-blue-100 max-w-3xl mx-auto font-medium">@directAnswer</p>
        }
    </div>
</section>

<section class="bg-white py-12 @(isCostPage ? "border-t" : "")">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid md:grid-cols-2 gap-4 lg:gap-6">
            @{
                var states = new[]
                {
                    (Model.StateA, Model.Result.DisplayValueA, Model.Result.WinnerSlug == Model.StateA.Slug),
                    (Model.StateB, Model.Result.DisplayValueB, Model.Result.WinnerSlug == Model.StateB.Slug),
                };
            }
            @foreach (var (state, displayVal, isWinner) in states)
            {
                <div class="rounded-[1.5rem] border @(isWinner ? "border-green-300 shadow-[0_20px_45px_-28px_rgba(34,197,94,0.5)]" : "border-gray-200") bg-white overflow-hidden">
                    <div class="@(isWinner ? "bg-green-50" : "bg-gray-50") px-5 py-4 flex items-center gap-4 border-b @(isWinner ? "border-green-200" : "border-gray-200")">
                        <img src="@Images.Card(state.FlagImageUrl)" alt="@state.Name flag"
                             class="w-16 h-11 object-cover rounded shadow-sm"
                             onerror="this.style.display='none'" />
                        <div class="flex-1">
                            <div class="text-xl font-bold text-gray-900">@state.Name</div>
                            <div class="text-sm text-gray-500"><a href="/states/@state.Slug/abbreviation" class="hover:underline">@state.Abbreviation</a> &bull; @(state.Region ?? "")</div>
                        </div>
                        @if (isWinner)
                        {
                            <span class="flex items-center gap-1 bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full border border-green-300 shrink-0">
                                <i class="fa-solid fa-trophy text-yellow-500"></i> Winner
                            </span>
                        }
                    </div>
                    <div class="px-5 py-5 text-center">
                        <div class="text-4xl lg:text-5xl font-extrabold @(isWinner ? "text-green-700" : "text-gray-800") mb-1">
                            @(DashIfNull(displayVal))
                        </div>
                        <div class="text-sm text-gray-500">@Model.Metric.Description</div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Result.NumericA.HasValue && Model.Result.NumericB.HasValue && Model.Metric.Type != USASymbol.Models.MetricType.Text)
        {
            var maxVal = Math.Max(Model.Result.NumericA.Value, Model.Result.NumericB.Value);
            var pctA = maxVal > 0 ? (int)Math.Round(Model.Result.NumericA.Value / maxVal * 100) : 0;
            var pctB = maxVal > 0 ? (int)Math.Round(Model.Result.NumericB.Value / maxVal * 100) : 0;
            var winA = Model.Result.WinnerSlug == Model.StateA.Slug;
            var winB = Model.Result.WinnerSlug == Model.StateB.Slug;
            <div class="mt-6 bg-gray-50 border border-gray-200 rounded-[1.5rem] p-5 lg:p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-5">Visual Comparison</h2>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm font-medium text-gray-700 mb-1.5">
                            <span>@Model.StateA.Name</span>
                            <span>@DashIfNull(Model.Result.DisplayValueA)</span>
                        </div>
                        <div class="h-7 bg-gray-200 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @(winA ? "bg-green-500" : "bg-blue-500")" style="width: @pctA%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm font-medium text-gray-700 mb-1.5">
                            <span>@Model.StateB.Name</span>
                            <span>@DashIfNull(Model.Result.DisplayValueB)</span>
                        </div>
                        <div class="h-7 bg-gray-200 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700 @(winB ? "bg-green-500" : "bg-blue-500")" style="width: @pctB%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.DifferenceText != null)
        {
            var winner = Model.Result.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
            <div class="mt-5 bg-blue-50 border border-blue-200 rounded-[1.25rem] px-5 py-4 text-center">
                <p class="text-blue-800 font-medium">
                    Difference: <strong>@Model.Result.DifferenceText</strong>
                    &mdash; @winner.Name leads.
                </p>
            </div>
        }
    </div>
</section>

