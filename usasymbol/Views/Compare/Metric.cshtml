                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome),   $"/compare/{pair}/median-income"));
                ctxRows.Add(("Property Tax Rate",     CxPct(Model.StatsA?.PropertyTaxRatePct, 2),   CxPct(Model.StatsB?.PropertyTaxRatePct, 2),   $"/compare/{pair}/property-tax"));
                ctxRows.Add(("Homeownership Rate",    CxPct(Model.StatsA?.HomeownershipRatePct),    CxPct(Model.StatsB?.HomeownershipRatePct),    null));
                ctxRows.Add(("Home Value / Income",   CxX(Model.StatsA?.HomeValueToIncomeRatio()),  CxX(Model.StatsB?.HomeValueToIncomeRatio()),  $"/compare/{pair}/home-value-to-income"));
