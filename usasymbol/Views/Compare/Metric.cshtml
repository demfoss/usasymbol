                    ctxTitle = "Climate Breakdown";
                    ctxNote  = "Cold winters affect heating bills, outdoor activity, and overall livability.";
                    ctxRows.Add(("Summer Temperature",   CxTemp(Model.StatsA?.SummerTemperatureF),  CxTemp(Model.StatsB?.SummerTemperatureF),  null));
                    ctxRows.Add(("Average Temperature",  CxTemp(Model.StatsA?.AverageTemperatureF), CxTemp(Model.StatsB?.AverageTemperatureF), $"/compare/{pair}/average-temperature"));
                    ctxRows.Add(("Sunny Days / Year",    CxDays(Model.StatsA?.SunnyDaysPerYear),    CxDays(Model.StatsB?.SunnyDaysPerYear),    $"/compare/{pair}/sunny-days"));
                    ctxRows.Add(("Annual Precipitation", CxIn(Model.StatsA?.AnnualPrecipitationIn), CxIn(Model.StatsB?.AnnualPrecipitationIn), null));
                    break;

                case "sunny-days":
                    ctxTitle = "Sunshine & Weather";
                    ctxNote  = "Sunny days rank among the most-cited lifestyle factors for relocation decisions.";
                    ctxRows.Add(("Average Temperature",  CxTemp(Model.StatsA?.AverageTemperatureF), CxTemp(Model.StatsB?.AverageTemperatureF), $"/compare/{pair}/average-temperature"));
                    ctxRows.Add(("Summer Temperature",   CxTemp(Model.StatsA?.SummerTemperatureF),  CxTemp(Model.StatsB?.SummerTemperatureF),  null));
                    ctxRows.Add(("Winter Temperature",   CxTemp(Model.StatsA?.WinterTemperatureF),  CxTemp(Model.StatsB?.WinterTemperatureF),  null));
                    ctxRows.Add(("Annual Precipitation", CxIn(Model.StatsA?.AnnualPrecipitationIn), CxIn(Model.StatsB?.AnnualPrecipitationIn), null));
                    break;

                case "annual-precipitation":
                    ctxTitle = "Precipitation & Climate";
                    ctxNote  = "Rain and snow affect agriculture, flood risk, water supply, and outdoor lifestyle.";
                    ctxRows.Add(("Sunny Days / Year",    CxDays(Model.StatsA?.SunnyDaysPerYear),    CxDays(Model.StatsB?.SunnyDaysPerYear),    $"/compare/{pair}/sunny-days"));
                    ctxRows.Add(("Average Temperature",  CxTemp(Model.StatsA?.AverageTemperatureF), CxTemp(Model.StatsB?.AverageTemperatureF), $"/compare/{pair}/average-temperature"));
                    ctxRows.Add(("Summer Temperature",   CxTemp(Model.StatsA?.SummerTemperatureF),  CxTemp(Model.StatsB?.SummerTemperatureF),  null));
                    ctxRows.Add(("Winter Temperature",   CxTemp(Model.StatsA?.WinterTemperatureF),  CxTemp(Model.StatsB?.WinterTemperatureF),  null));
                    break;

                case "land-area":
                    ctxTitle = "Size in Context";
                    ctxNote  = "Land area shapes population density, natural resources, climate variety, and travel distances.";
                    ctxRows.Add(("Population",          CxD(Model.StateA.Population?.ToString("N0")), CxD(Model.StateB.Population?.ToString("N0")), $"/compare/{pair}/population"));
                    ctxRows.Add(("Population Density",  CxDens(cxDensA),                              CxDens(cxDensB),                              $"/compare/{pair}/density"));
                    ctxRows.Add(("Statehood Order",     CxOrder(Model.StatsA?.StatehoodOrder),         CxOrder(Model.StatsB?.StatehoodOrder),         $"/compare/{pair}/statehood"));
                    ctxRows.Add(("Average Temperature", CxTemp(Model.StatsA?.AverageTemperatureF),     CxTemp(Model.StatsB?.AverageTemperatureF),     $"/compare/{pair}/average-temperature"));
                    break;

                case "statehood":
                    ctxTitle = "Historical Context";
                    ctxNote  = "The statehood order mirrors westward expansion and regional settlement history.";
                    ctxRows.Add(("Capital",      CxD(Model.StateA.Capital),                        CxD(Model.StateB.Capital),                        $"/compare/{pair}/capital"));
                    ctxRows.Add(("Population",   CxD(Model.StateA.Population?.ToString("N0")),     CxD(Model.StateB.Population?.ToString("N0")),     $"/compare/{pair}/population"));
                    ctxRows.Add(("Land Area",    CxSqMi(Model.StatsA?.LandAreaSqMi),               CxSqMi(Model.StatsB?.LandAreaSqMi),               $"/compare/{pair}/land-area"));
                    ctxRows.Add(("State Color",  CxD(Model.StatsA?.PoliticalLean),                 CxD(Model.StatsB?.PoliticalLean),                 $"/compare/{pair}/political-lean"));
                    break;

                case "gun-laws-status":
                    ctxTitle = "Laws in Context";
                    ctxNote  = "Gun policy alongside the broader regulatory environment.";
                    ctxRows.Add(("Marijuana Status",     CxD(Model.StatsA?.MarijuanaLegalizationStatus), CxD(Model.StatsB?.MarijuanaLegalizationStatus), $"/compare/{pair}/marijuana-legalization"));
                    ctxRows.Add(("Alcohol System",       CxD(Model.StatsA?.AlcoholLawsStatus),           CxD(Model.StatsB?.AlcoholLawsStatus),           $"/compare/{pair}/alcohol-laws"));
                    ctxRows.Add(("State Color",          CxD(Model.StatsA?.PoliticalLean),               CxD(Model.StatsB?.PoliticalLean),               $"/compare/{pair}/political-lean"));
                    ctxRows.Add(("Violent Crime / 100k", CxNum(Model.StatsA?.ViolentCrimeRatePer100k),   CxNum(Model.StatsB?.ViolentCrimeRatePer100k),   $"/compare/{pair}/violent-crime"));
                    break;

                case "marijuana-legalization":
                    ctxTitle = "Laws in Context";
                    ctxNote  = "Cannabis policy alongside the state's broader regulatory stance.";
                    ctxRows.Add(("Gun Laws",     CxD(Model.StatsA?.GunLawsStatus),           CxD(Model.StatsB?.GunLawsStatus),           $"/compare/{pair}/gun-laws-status"));
                    ctxRows.Add(("Alcohol System", CxD(Model.StatsA?.AlcoholLawsStatus),     CxD(Model.StatsB?.AlcoholLawsStatus),       $"/compare/{pair}/alcohol-laws"));
                    ctxRows.Add(("State Color",  CxD(Model.StatsA?.PoliticalLean),           CxD(Model.StatsB?.PoliticalLean),           $"/compare/{pair}/political-lean"));
                    break;

                case "alcohol-laws":
                    ctxTitle = "Laws in Context";
                    ctxNote  = "Alcohol system classification alongside the state's broader regulatory stance.";
                    ctxRows.Add(("Gun Laws",       CxD(Model.StatsA?.GunLawsStatus),             CxD(Model.StatsB?.GunLawsStatus),             $"/compare/{pair}/gun-laws-status"));
                    ctxRows.Add(("Marijuana Status", CxD(Model.StatsA?.MarijuanaLegalizationStatus), CxD(Model.StatsB?.MarijuanaLegalizationStatus), $"/compare/{pair}/marijuana-legalization"));
                    ctxRows.Add(("State Color",    CxD(Model.StatsA?.PoliticalLean),               CxD(Model.StatsB?.PoliticalLean),               $"/compare/{pair}/political-lean"));
                    break;

                case "uninsured-rate":
                    ctxTitle = "Health Access Context";
                    ctxNote  = "Insurance coverage is the gateway to healthcare — closely tied to income, employment, and state policy.";
                    ctxRows.Add(("Poverty Rate",    CxPct(Model.StatsA?.PovertyRatePct),           CxPct(Model.StatsB?.PovertyRatePct),           $"/compare/{pair}/poverty-rate"));
                    ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome), $"/compare/{pair}/median-income"));
                    ctxRows.Add(("Life Expectancy", CxYrs(Model.StatsA?.LifeExpectancyYears),      CxYrs(Model.StatsB?.LifeExpectancyYears),      $"/compare/{pair}/life-expectancy"));
                    ctxRows.Add(("Unemployment Rate", CxPct(Model.StatsA?.UnemploymentRatePct),    CxPct(Model.StatsB?.UnemploymentRatePct),      $"/compare/{pair}/unemployment-rate"));
                    break;

                case "obesity-rate":
                    ctxTitle = "Health Factors";
                    ctxNote  = "Obesity rates reflect income, food access, climate, activity levels, and healthcare availability.";
                    ctxRows.Add(("Life Expectancy",   CxYrs(Model.StatsA?.LifeExpectancyYears), CxYrs(Model.StatsB?.LifeExpectancyYears), $"/compare/{pair}/life-expectancy"));
                    ctxRows.Add(("Poverty Rate",      CxPct(Model.StatsA?.PovertyRatePct),      CxPct(Model.StatsB?.PovertyRatePct),      $"/compare/{pair}/poverty-rate"));
                    ctxRows.Add(("Uninsured Rate",    CxPct(Model.StatsA?.UninsuredRatePct),    CxPct(Model.StatsB?.UninsuredRatePct),    null));
                    ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome), $"/compare/{pair}/median-income"));
                    break;

                case "property-crime-rate":
                    ctxTitle = "Crime Context";
                    ctxNote  = "Property and violent crime are distinct trends with shared root causes.";
                    ctxRows.Add(("Violent Crime / 100k",  CxNum(Model.StatsA?.ViolentCrimeRatePer100k), CxNum(Model.StatsB?.ViolentCrimeRatePer100k), $"/compare/{pair}/violent-crime"));
                    ctxRows.Add(("Poverty Rate",          CxPct(Model.StatsA?.PovertyRatePct),          CxPct(Model.StatsB?.PovertyRatePct),          $"/compare/{pair}/poverty-rate"));
                    ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome),   $"/compare/{pair}/median-income"));
                    ctxRows.Add(("Population Density",    CxDens(cxDensA),                              CxDens(cxDensB),                              $"/compare/{pair}/density"));
                    ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),     CxPct(Model.StatsB?.UnemploymentRatePct),     $"/compare/{pair}/unemployment-rate"));
                    break;
            }
        }
    }

    @if (ctxRows.Any())
    {
        <section class="cmp2-block">
            <div class="cmp2-shell">
                <div class="cmp2-head">
                    <p class="cmp2-eyebrow">Related context</p>
                    <h2 class="cmp2-title" style="margin-bottom:4px;">@ctxTitle</h2>
                    @if (!string.IsNullOrWhiteSpace(ctxNote))
                    {
                        <p class="cmp2-sub" style="margin-bottom:0;">@ctxNote</p>
                    }
                </div>
                <div class="cmp2-ctx-table" style="margin-top:20px;">
                    <div class="cmp2-ctx-head"><span>Metric</span><span>@titleA</span><span>@titleB</span></div>
                    @foreach (var (ctxLabel, ctxValA, ctxValB, ctxHref) in ctxRows)
                    {
                        @if (!string.IsNullOrWhiteSpace(ctxHref))
                        {
                            <a href="@ctxHref" class="cmp2-ctx-row">
                                <span class="m">@ctxLabel <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:9px;color:var(--cmp-ink-3);" aria-hidden="true"></i></span>
                                <span class="v">@ctxValA</span>
                                <span class="v">@ctxValB</span>
                            </a>
                        }
                        else
                        {
                            <div class="cmp2-ctx-row">
                                <span class="m">@ctxLabel</span>
                                <span class="v">@ctxValA</span>
                                <span class="v">@ctxValB</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
    }

    @{
        // ── Context, Key Facts, FAQ ───────────────────────────────────────────────
        var hasNumbers  = Model.Result.NumericA.HasValue && Model.Result.NumericB.HasValue;
        var mName       = Model.Metric.Name;
        var mLow        = mName.ToLower();

        var contextParagraph = "";
        if (hasNumbers && Model.Result.WinnerSlug != null)
        {
            bool aWins   = Model.Result.WinnerSlug == Model.StateA.Slug;
            var  winner  = aWins ? Model.StateA : Model.StateB;
            var  loser   = aWins ? Model.StateB : Model.StateA;
            var  winVal  = (aWins ? Model.Result.DisplayValueA : Model.Result.DisplayValueB) ?? "—";
            var  loseVal = (aWins ? Model.Result.DisplayValueB : Model.Result.DisplayValueA) ?? "—";
            var  winNum  = aWins ? Model.Result.NumericA!.Value : Model.Result.NumericB!.Value;
            var  loseNum = aWins ? Model.Result.NumericB!.Value : Model.Result.NumericA!.Value;

            contextParagraph = $"{winner.Name}'s {mLow} is {winVal}, compared with {loseVal} in {loser.Name}";
            if (loseNum > 0)
            {
                var ratio = winNum / loseNum;
                if (ratio >= 2.0)
                    contextParagraph += $" — roughly {ratio:F1}× the {loser.Name} figure";
                else if (ratio >= 1.1)
                    contextParagraph += $", a gap of {Math.Abs(Math.Round((winNum - loseNum) / loseNum * 100, 1)):F1}%";
            }
            contextParagraph += ". " + Model.Metric.Description;
        }
        else if (Model.Result.DisplayValueA != null && Model.Result.DisplayValueB != null
                 && Model.Metric.Type != USASymbol.Models.MetricType.Text)
        {
            contextParagraph = $"{Model.StateA.Name}: {Model.Result.DisplayValueA}. {Model.StateB.Name}: {Model.Result.DisplayValueB}.";
        }

        var keyFacts = new List<(string Label, string Value, bool IsWin)>();
        if (Model.Result.DisplayValueA != null)
            keyFacts.Add((Model.StateA.Name, Model.Result.DisplayValueA, Model.Result.WinnerSlug == Model.StateA.Slug));
        if (Model.Result.DisplayValueB != null)
            keyFacts.Add((Model.StateB.Name, Model.Result.DisplayValueB, Model.Result.WinnerSlug == Model.StateB.Slug));
        if (!string.IsNullOrWhiteSpace(Model.Result.DifferenceText))
            keyFacts.Add(("Difference", Model.Result.DifferenceText, false));

        var metFaq = new List<(string Q, string A)>();
        if (Model.Result.DisplayValueA != null)
            metFaq.Add(($"What is {titleA}'s {mLow}?",
                $"{titleA}'s {mLow} is {Model.Result.DisplayValueA}."));
        if (Model.Result.DisplayValueB != null)
            metFaq.Add(($"What is {titleB}'s {mLow}?",
                $"{titleB}'s {mLow} is {Model.Result.DisplayValueB}."));
        if (Model.Result.WinnerSlug != null && !string.IsNullOrWhiteSpace(directAnswer))
        {
            var compareWord = Model.Metric.HigherIsBetter ? "higher" : "lower";
            metFaq.Add(($"Which state has a {compareWord} {mLow} — {titleA} or {titleB}?", directAnswer));
        }
        if (!string.IsNullOrWhiteSpace(Model.Result.DifferenceText) && hasNumbers)
        {
            bool aW2    = Model.Result.WinnerSlug == Model.StateA.Slug;
            var  w2num  = aW2 ? Model.Result.NumericA!.Value : Model.Result.NumericB!.Value;
            var  l2num  = aW2 ? Model.Result.NumericB!.Value : Model.Result.NumericA!.Value;
            if (l2num > 0 && w2num / l2num >= 1.15)
            {
                var moreOrLess = Model.Metric.HigherIsBetter ? "more" : "less";
                var w2name     = aW2 ? titleA : titleB;
                var l2name     = aW2 ? titleB : titleA;
                metFaq.Add(($"How much {moreOrLess} {mLow} does {w2name} have compared to {l2name}?",
                    Model.Result.DifferenceText + "."));
            }
        }

        string metFaqJson = "";
        if (metFaq.Any())
        {
            var schObj = new Dictionary<string, object>
            {
                ["@context"]   = "https://schema.org",
                ["@type"]      = "FAQPage",
                ["mainEntity"] = metFaq.Select(f => new Dictionary<string, object>
                {
                    ["@type"] = "Question",
                    ["name"]  = f.Q,
                    ["acceptedAnswer"] = new Dictionary<string, object>
                    {
                        ["@type"] = "Answer",
                        ["text"]  = f.A
                    }
                }).ToArray()
            };
            metFaqJson = System.Text.Json.JsonSerializer.Serialize(schObj);
        }
    }

    @if (!string.IsNullOrWhiteSpace(contextParagraph) || keyFacts.Any())
    {
        <section class="cmp2-block">
            <div class="cmp2-shell">
                @if (!string.IsNullOrWhiteSpace(contextParagraph))
                {
                    <div class="cmp2-head">
                        <p class="cmp2-eyebrow">What this means</p>
                        <h2 class="cmp2-title" style="margin-bottom:10px;">@titleA vs @titleB: @mName in context</h2>
                        <p class="cmp2-sub" style="margin-bottom:0;max-width:70ch;">@contextParagraph</p>
                    </div>
                }
                @if (keyFacts.Any())
                {
                    <div class="cmp2-fact-grid" style="margin-top:0;">
                        @foreach (var (label, value, isWin) in keyFacts)
                        {
                            <div class="cmp2-fact-chip @(isWin ? "is-winner" : "")">
                                <div class="label">@label @if (isWin) { <i class="fa-solid fa-crown" aria-hidden="true"></i> }</div>
                                <div class="value">@value</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @if (metFaq.Any())
    {
        if (!string.IsNullOrWhiteSpace(metFaqJson))
        {
            <script type="application/ld+json">@Html.Raw(metFaqJson)</script>
        }

        <section class="cmp2-block">
            <div class="cmp2-shell">
                <div class="cmp2-head">
                    <p class="cmp2-eyebrow">People also ask</p>
                    <h2 class="cmp2-title" style="margin-bottom:0;">@titleA vs @titleB @mName — common questions</h2>
                </div>
                <div class="cmp2-faq-list" style="margin-top:20px;">
                    @foreach (var (q, a) in metFaq)
                    {
                        <div class="cmp2-faq-item">
                            <h3 class="cmp2-faq-q"><span class="cmp2-faq-q-mark">Q</span>@q</h3>
                            <p class="cmp2-faq-a">@a</p>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="cmp2-block">
        <div class="cmp2-shell">
            <div class="cmp2-head" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;">
                <div>
                    <h2 class="cmp2-title" style="margin-bottom:4px;">More comparisons: @titleA vs @titleB</h2>
                    <p class="cmp2-sub" style="margin-bottom:0;">Grouped tabs keep the deep-dive links tighter and easier to scan.</p>
                </div>
                <a href="/compare/@Model.PairSlug" class="cmp2-tab" style="text-decoration:none;">
                    <i class="fa-solid fa-table-columns" aria-hidden="true"></i> Full comparison
                </a>
            </div>

            @{
                bool hasCurrentGroup = groupedOtherMetrics.Any(g => string.Equals(g.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase));
            }
            <div class="cmp2-tabbar-wrap">
                <div class="cmp2-tabbar">
                    @foreach (var grp in groupedOtherMetrics)
                    {
                        var cmpTabId = $"cmp-tab-{grp.Key.GroupSlug}";
                        var cmpActive = hasCurrentGroup
                            ? string.Equals(grp.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase)
                            : grp == groupedOtherMetrics.First();
                        <button type="button" class="cmp2-mm-tab cmp2-tab @(cmpActive ? "is-active" : "")" data-target="@cmpTabId">
                            @grp.Key.GroupName
                        </button>
                    }
                </div>
            </div>

            <div>
                @foreach (var grp in groupedOtherMetrics)
                {
                    var cmpPanelId = $"cmp-tab-{grp.Key.GroupSlug}";
                    var cmpActive = hasCurrentGroup
                        ? string.Equals(grp.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase)
                        : grp == groupedOtherMetrics.First();
                    <div id="@cmpPanelId" class="cmp2-mm-panel cmp2-panel @(cmpActive ? "" : "is-hidden")">
                        <div class="cmp2-related-grid">
                            @foreach (var metric in grp)
                            {
                                <a href="/compare/@Model.PairSlug/@metric.Slug" class="cmp2-related-card">
                                    <i class="@metric.Icon" aria-hidden="true"></i>
                                    <span>@metric.Name</span>
                                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="cmp2-block">
        <div class="cmp2-shell">
            <h2 class="cmp2-title" style="font-size:18px;">Explore each state</h2>
            <div class="cmp2-related-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,auto));">
                <a href="/states/@Model.StateA.Slug" class="cmp2-related-card">
                    <img src="@Images.Thumb(Model.StateA.FlagImageUrl)" onerror="this.style.display='none'" alt="" />
                    <span>@Model.StateA.Name symbols</span>
                </a>
                <a href="/states/@Model.StateB.Slug" class="cmp2-related-card">
                    <img src="@Images.Thumb(Model.StateB.FlagImageUrl)" onerror="this.style.display='none'" alt="" />
                    <span>@Model.StateB.Name symbols</span>
                </a>
                <a href="/compare-states" class="cmp2-related-card">
                    <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
                    <span>Compare other states</span>
                </a>
            </div>
        </div>
    </section>

    <script>
    (function () {
        const tabs   = Array.from(document.querySelectorAll('.cmp2-mm-tab'));
        const panels = Array.from(document.querySelectorAll('.cmp2-mm-panel'));
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const target = tab.getAttribute('data-target');
                tabs.forEach(b => b.classList.remove('is-active'));
                tab.classList.add('is-active');
                panels.forEach(p => p.id === target ? p.classList.remove('is-hidden') : p.classList.add('is-hidden'));
            });
        });
    })();
    </script>

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Model.StateA.Name} vs {Model.StateB.Name} | {Model.Metric.Name} Comparison")),
      "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(directAnswer ?? $"Compare {Model.Metric.Name.ToLower()} between {Model.StateA.Name} and {Model.StateB.Name}.")),
      "url": "https://usasymbol.com/compare/@Model.PairSlug/@Model.Metric.Slug",
      "dateModified": "2026-07-23",
      "citation": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Metric.SourceUrl)),
      "license": "https://usasymbol.com/terms",
      "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "https://usasymbol.com" },
      "about": [
        { "@@type": "AdministrativeArea", "name": "@Model.StateA.Name", "identifier": "@Model.StateA.Abbreviation" },
        { "@@type": "AdministrativeArea", "name": "@Model.StateB.Name", "identifier": "@Model.StateB.Abbreviation" }
      ],
      "breadcrumb": {
        "@@type": "BreadcrumbList",
        "itemListElement": [
          { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://usasymbol.com" },
          { "@@type": "ListItem", "position": 2, "name": "Compare States", "item": "https://usasymbol.com/compare-states" },
          { "@@type": "ListItem", "position": 3, "name": "@Model.StateA.Name vs @Model.StateB.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug" },
          { "@@type": "ListItem", "position": 4, "name": "@Model.Metric.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug/@Model.Metric.Slug" }
        ]
      }
    }
    </script>

    <section class="cmp2-block">
        <div class="cmp2-shell">
            <div class="cmp2-method-card">
                <div class="cmp2-method-head">
                    <i class="fa-solid fa-database" aria-hidden="true"></i>
                    <div>
                        <h2 class="cmp2-title" style="margin-bottom:2px;font-size:18px;">Data source and freshness</h2>
                    </div>
                </div>
                <div class="cmp2-method-grid">
                    <div class="cmp2-method-item">
                        <div class="cmp2-method-item-label">Primary source</div>
                        <div class="cmp2-method-item-value">
                            <a href="@Model.Metric.SourceUrl" style="color:var(--cmp-gold);font-weight:600;"
                               rel="nofollow noopener" target="@(Model.Metric.SourceUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "_blank" : null)">
                                @Model.Metric.SourceName
                            </a>
                        </div>
                    </div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Data period</div><div class="cmp2-method-item-value">@Model.Metric.DataYear</div></div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Dataset reviewed</div><div class="cmp2-method-item-value">@Model.Metric.UpdatedAt</div></div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Method note</div><div class="cmp2-method-item-value">@metricSource.Note</div></div>
                </div>
            </div>
        </div>
    </section>

    <div class="cmp2-shell mt-10 lg:hidden">
        @await Html.PartialAsync("_CompareMetricSidebar", Model)
    </div>

    </div>

    <aside class="article-sidebar hidden lg:block" aria-label="Explore more">
        <div class="sidebar-content">
            @await Html.PartialAsync("_CompareMetricSidebar", Model)
        </div>
    </aside>
    </div>
</div>
