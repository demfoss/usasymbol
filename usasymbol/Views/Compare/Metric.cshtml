                    <a href="/compare/@Model.PairSlug/rent-to-income" class="rounded-xl border border-gray-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition">
                        <div class="text-xs uppercase tracking-wide text-gray-500 mb-1">Rent to Income</div>
                        <div class="text-sm text-gray-700">@Model.StateA.Name: @Percent(Model.StatsA?.RentToIncomeRatioPct())</div>
                        <div class="text-sm text-gray-700">@Model.StateB.Name: @Percent(Model.StatsB?.RentToIncomeRatioPct())</div>
                    </a>
                    <a href="/compare/@Model.PairSlug/owner-costs-to-income" class="rounded-xl border border-gray-200 bg-white p-4 hover:border-blue-300 hover:shadow-sm transition">
                        <div class="text-xs uppercase tracking-wide text-gray-500 mb-1">Owner Costs to Income</div>
                        <div class="text-sm text-gray-700">@Model.StateA.Name: @Percent(Model.StatsA?.OwnerCostsToIncomePct)</div>
                        <div class="text-sm text-gray-700">@Model.StateB.Name: @Percent(Model.StatsB?.OwnerCostsToIncomePct)</div>
                    </a>
                </div>
            </div>
            } @* end isCostPage ratios *@

            @{
                var relatedLinks = isCostPage ? new[] {
                        ("/compare/" + Model.PairSlug + "/home-value",          "Housing"),
                        ("/compare/" + Model.PairSlug + "/income-tax",          "Taxes"),
                        ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                        ("/compare/" + Model.PairSlug + "/owner-costs-to-income","Owner Costs")
                    } : isLifePage ? new[] {
                        ("/compare/" + Model.PairSlug + "/violent-crime",       "Violent Crime"),
                        ("/compare/" + Model.PairSlug + "/poverty-rate",        "Poverty Rate"),
                        ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                        ("/compare/" + Model.PairSlug + "/cost-of-living",      "Cost of Living")
                    } : new[] {
                        ("/compare/" + Model.PairSlug + "/life-expectancy",     "Life Expectancy"),
                        ("/compare/" + Model.PairSlug + "/poverty-rate",        "Poverty Rate"),
                        ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                        ("/compare/" + Model.PairSlug + "/density",             "Population Density")
                    };
            }
            <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Related Pages</h2>
                <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4">
                    @foreach (var (href, label) in relatedLinks)
                    {
                        <a href="@href" class="rounded-xl border border-gray-200 p-4 hover:border-blue-300 hover:shadow-sm transition text-sm font-medium text-gray-800">@label</a>
                    }
                </div>
            </div>

        </div>
    </section>
}

@{
    // ── Context Snapshot (non-intent pages) ──────────────────────────────────
    var ctxRows = new List<(string Label, string ValA, string ValB, string? Href)>();
    var ctxTitle = "";
    var ctxNote = "";

    if (!isIntentPage)
    {
        string CxD(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
        string CxMon(int? v) => v.HasValue ? $"${v.Value:N0}" : "—";
        string CxMoMo(int? v) => v.HasValue ? $"${v.Value:N0}/mo" : "—";
        string CxPct(double? v, int d = 1) => v.HasValue ? $"{v.Value.ToString($"F{d}")}%" : "—";
        string CxNum(double? v, int d = 1) => v.HasValue ? v.Value.ToString($"F{d}") : "—";
        string CxMoney2(double? v) => v.HasValue ? $"${v.Value:F2}" : "—";
        string CxTemp(double? v) => v.HasValue ? $"{v.Value:F1}°F" : "—";
        string CxSqMi(double? v) => v.HasValue ? $"{v.Value:N0} sq mi" : "—";
        string CxDens(double? v) => v.HasValue ? $"{v.Value:N1} / sq mi" : "—";
        string CxYrs(double? v) => v.HasValue ? $"{v.Value:F1} yrs" : "—";
        string CxIn(double? v) => v.HasValue ? $"{v.Value:F1} in" : "—";
        string CxDays(int? v) => v.HasValue ? $"{v.Value} days" : "—";
        string CxMin(double? v) => v.HasValue ? $"{v.Value:F1} min" : "—";
        string CxOrder(int? v) => v.HasValue ? $"#{v.Value}" : "—";
        string CxX(double? v, int d = 2) => v.HasValue ? $"{v.Value.ToString($"F{d}")}×" : "—";
        string CxMetric(string slug, State st, StateStats? ss) =>
            CxD(ComparisonMetricsConfig.GetBySlug(slug)?.GetDisplayValue(st, ss));

        var cxDensA = Model.StatsA?.PopulationDensity(Model.StateA.Population);
        var cxDensB = Model.StatsB?.PopulationDensity(Model.StateB.Population);
        var cxIafA  = Model.StatsA?.IncomeAfterMedianRentMonthly();
        var cxIafB  = Model.StatsB?.IncomeAfterMedianRentMonthly();

        string pair = Model.PairSlug;

        switch (Model.Metric.Slug)
        {
            case "capital":
                ctxTitle = "States at a Glance";
                ctxNote  = "Key facts about each state alongside the capital comparison.";
                ctxRows.Add(("Population",          CxD(Model.StateA.Population?.ToString("N0")), CxD(Model.StateB.Population?.ToString("N0")), $"/compare/{pair}/population"));
                ctxRows.Add(("State Color",          CxD(Model.StatsA?.PoliticalLean),             CxD(Model.StatsB?.PoliticalLean),             $"/compare/{pair}/political-lean"));
                ctxRows.Add(("Governor Party",       CxD(Model.StatsA?.GovernorParty),             CxD(Model.StatsB?.GovernorParty),             null));
                ctxRows.Add(("Median Income",        CxMon(Model.StatsA?.MedianHouseholdIncome),   CxMon(Model.StatsB?.MedianHouseholdIncome),   $"/compare/{pair}/median-income"));
                ctxRows.Add(("Cost of Living Index", CxNum(Model.StatsA?.CostOfLivingIndex),       CxNum(Model.StatsB?.CostOfLivingIndex),       $"/compare/{pair}/cost-of-living"));
                break;

            case "political-lean":
                ctxTitle = "Full Political Picture";
                ctxNote  = "Presidential color is just one layer — here's the complete breakdown.";
                ctxRows.Add(("Governor Party",           CxD(Model.StatsA?.GovernorParty),                          CxD(Model.StatsB?.GovernorParty),                          null));
                ctxRows.Add(("State House",              CxD(Model.StatsA?.StateHouseControl),                      CxD(Model.StatsB?.StateHouseControl),                      null));
                ctxRows.Add(("State Senate",             CxD(Model.StatsA?.StateSenateControl),                     CxD(Model.StatsB?.StateSenateControl),                     null));
                ctxRows.Add(("Trifecta",                 CxD(Model.StatsA?.Trifecta),                               CxD(Model.StatsB?.Trifecta),                               null));
                ctxRows.Add(("2024 Presidential Margin", CxPct(Model.StatsA?.PresidentialVotingMarginPct),           CxPct(Model.StatsB?.PresidentialVotingMarginPct),           null));
                break;

            case "population":
                ctxTitle = "Population in Context";
                ctxNote  = "Raw headcount only tells part of the story — density and education round it out.";
                ctxRows.Add(("Population Density", CxDens(cxDensA),                            CxDens(cxDensB),                            $"/compare/{pair}/density"));
                ctxRows.Add(("Land Area",          CxSqMi(Model.StatsA?.LandAreaSqMi),         CxSqMi(Model.StatsB?.LandAreaSqMi),         $"/compare/{pair}/land-area"));
                ctxRows.Add(("Bachelor's Degree",  CxPct(Model.StatsA?.CollegeEducatedPct),    CxPct(Model.StatsB?.CollegeEducatedPct),    $"/compare/{pair}/college-educated"));
                ctxRows.Add(("Median Income",      CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome), $"/compare/{pair}/median-income"));
                break;

            case "density":
                ctxTitle = "Density in Context";
                ctxNote  = "Population density shapes commutes, housing costs, and the feel of daily life.";
                ctxRows.Add(("Population",         CxD(Model.StateA.Population?.ToString("N0")), CxD(Model.StateB.Population?.ToString("N0")), $"/compare/{pair}/population"));
                ctxRows.Add(("Land Area",          CxSqMi(Model.StatsA?.LandAreaSqMi),          CxSqMi(Model.StatsB?.LandAreaSqMi),          $"/compare/{pair}/land-area"));
                ctxRows.Add(("Median Home Value",  CxMon(Model.StatsA?.MedianHomeValue),         CxMon(Model.StatsB?.MedianHomeValue),         $"/compare/{pair}/home-value"));
                ctxRows.Add(("Violent Crime / 100k", CxNum(Model.StatsA?.ViolentCrimeRatePer100k), CxNum(Model.StatsB?.ViolentCrimeRatePer100k), $"/compare/{pair}/violent-crime"));
                ctxRows.Add(("Cost of Living Index", CxNum(Model.StatsA?.CostOfLivingIndex),      CxNum(Model.StatsB?.CostOfLivingIndex),      $"/compare/{pair}/cost-of-living"));
                break;

            case "college-educated":
                ctxTitle = "Education & Economic Outcomes";
                ctxNote  = "College attainment correlates strongly with income, employment, and economic mobility.";
                ctxRows.Add(("Advanced Degree",       CxPct(Model.StatsA?.AdvancedDegreePct),         CxPct(Model.StatsB?.AdvancedDegreePct),         $"/compare/{pair}/advanced-degree"));
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome),   CxMon(Model.StatsB?.MedianHouseholdIncome),     $"/compare/{pair}/median-income"));
                ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),       CxPct(Model.StatsB?.UnemploymentRatePct),       $"/compare/{pair}/unemployment-rate"));
                ctxRows.Add(("Poverty Rate",          CxPct(Model.StatsA?.PovertyRatePct),            CxPct(Model.StatsB?.PovertyRatePct),            $"/compare/{pair}/poverty-rate"));
                break;

            case "advanced-degree":
                ctxTitle = "Advanced Education & Economic Outcomes";
                ctxNote  = "Graduate and professional degree holders typically earn more and face lower unemployment.";
                ctxRows.Add(("Bachelor's Degree",     CxPct(Model.StatsA?.CollegeEducatedPct),        CxPct(Model.StatsB?.CollegeEducatedPct),        $"/compare/{pair}/college-educated"));
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome),   CxMon(Model.StatsB?.MedianHouseholdIncome),     $"/compare/{pair}/median-income"));
                ctxRows.Add(("Unemployment Rate",     CxPct(Model.StatsA?.UnemploymentRatePct),       CxPct(Model.StatsB?.UnemploymentRatePct),       $"/compare/{pair}/unemployment-rate"));
                ctxRows.Add(("Poverty Rate",          CxPct(Model.StatsA?.PovertyRatePct),            CxPct(Model.StatsB?.PovertyRatePct),            $"/compare/{pair}/poverty-rate"));
