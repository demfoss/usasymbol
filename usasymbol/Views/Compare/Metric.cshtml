@if (ctxRows.Any())
{
    <section class="bg-gray-50 py-12 border-t">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700 mb-1">Related Context</p>
            <h2 class="text-2xl font-bold text-gray-900 mb-1">@ctxTitle</h2>
            @if (!string.IsNullOrWhiteSpace(ctxNote))
            {
                <p class="text-sm text-gray-500 mt-1 mb-6">@ctxNote</p>
            }
            <div class="rounded-2xl border border-gray-200 overflow-hidden bg-white shadow-sm">
                <div class="grid grid-cols-3 bg-slate-800 text-white text-xs font-semibold uppercase tracking-[0.12em] px-5 py-3">
                    <div>Metric</div>
                    <div class="text-center">@titleA</div>
                    <div class="text-center">@titleB</div>
                </div>
                <div class="divide-y divide-gray-100">
                    @foreach (var (ctxLabel, ctxValA, ctxValB, ctxHref) in ctxRows)
                    {
                        @if (!string.IsNullOrWhiteSpace(ctxHref))
                        {
                            <a href="@ctxHref" class="grid grid-cols-3 px-5 py-3.5 hover:bg-blue-50 transition group">
                                <div class="text-sm text-gray-700 group-hover:text-blue-700 flex items-center gap-1.5">
                                    @ctxLabel
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[9px] text-gray-400 group-hover:text-blue-500 opacity-0 group-hover:opacity-100 transition"></i>
                                </div>
                                <div class="text-sm font-semibold text-gray-900 text-center">@ctxValA</div>
                                <div class="text-sm font-semibold text-gray-900 text-center">@ctxValB</div>
                            </a>
                        }
                        else
                        {
                            <div class="grid grid-cols-3 px-5 py-3.5">
                                <div class="text-sm text-gray-600">@ctxLabel</div>
                                <div class="text-sm font-semibold text-gray-900 text-center">@ctxValA</div>
                                <div class="text-sm font-semibold text-gray-900 text-center">@ctxValB</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
}

@{
    // ── Context, Key Facts, FAQ ───────────────────────────────────────────────
    var hasNumbers  = Model.Result.NumericA.HasValue && Model.Result.NumericB.HasValue;
    var mName       = Model.Metric.Name;
    var mLow        = mName.ToLower();

    // Context paragraph
    var contextParagraph = "";
    if (hasNumbers && Model.Result.WinnerSlug != null)
    {
        bool aWins   = Model.Result.WinnerSlug == Model.StateA.Slug;
        var  winner  = aWins ? Model.StateA : Model.StateB;
        var  loser   = aWins ? Model.StateB : Model.StateA;
        var  winVal  = (aWins ? Model.Result.DisplayValueA : Model.Result.DisplayValueB) ?? "—";
        var  loseVal = (aWins ? Model.Result.DisplayValueB : Model.Result.DisplayValueA) ?? "—";
        var  winNum  = aWins ? Model.Result.NumericA!.Value : Model.Result.NumericB!.Value;
        var  loseNum = aWins ? Model.Result.NumericB!.Value : Model.Result.NumericA!.Value;

        contextParagraph = $"{winner.Name} has a {mLow} of {winVal}, compared with {loseVal} in {loser.Name}";
        if (loseNum > 0)
        {
            var ratio = winNum / loseNum;
            if (ratio >= 2.0)
                contextParagraph += $" — roughly {ratio:F1}× the {loser.Name} figure";
            else if (ratio >= 1.1)
                contextParagraph += $", a gap of {Math.Round((winNum - loseNum) / loseNum * 100, 1):F1}%";
        }
        contextParagraph += ". " + Model.Metric.Description;
    }
    else if (Model.Result.DisplayValueA != null && Model.Result.DisplayValueB != null
             && Model.Metric.Type != USASymbol.Models.MetricType.Text)
    {
        contextParagraph = $"{Model.StateA.Name}: {Model.Result.DisplayValueA}. {Model.StateB.Name}: {Model.Result.DisplayValueB}.";
    }

    // Key facts chips
    var keyFacts = new List<(string Label, string Value, bool IsWin)>();
    if (Model.Result.DisplayValueA != null)
        keyFacts.Add((Model.StateA.Name, Model.Result.DisplayValueA, Model.Result.WinnerSlug == Model.StateA.Slug));
    if (Model.Result.DisplayValueB != null)
        keyFacts.Add((Model.StateB.Name, Model.Result.DisplayValueB, Model.Result.WinnerSlug == Model.StateB.Slug));
    if (!string.IsNullOrWhiteSpace(Model.Result.DifferenceText))
        keyFacts.Add(("Difference", Model.Result.DifferenceText, false));

    // FAQ items (3-4 questions)
    var metFaq = new List<(string Q, string A)>();
    if (Model.Result.DisplayValueA != null)
        metFaq.Add(($"What is {titleA}'s {mLow}?",
            $"{titleA}'s {mLow} is {Model.Result.DisplayValueA}."));
    if (Model.Result.DisplayValueB != null)
        metFaq.Add(($"What is {titleB}'s {mLow}?",
            $"{titleB}'s {mLow} is {Model.Result.DisplayValueB}."));
    if (Model.Result.WinnerSlug != null && !string.IsNullOrWhiteSpace(directAnswer))
    {
        var compareWord = Model.Metric.HigherIsBetter ? "higher" : "lower";
        metFaq.Add(($"Which state has a {compareWord} {mLow} — {titleA} or {titleB}?", directAnswer));
    }
    if (!string.IsNullOrWhiteSpace(Model.Result.DifferenceText) && hasNumbers)
    {
        bool aW2    = Model.Result.WinnerSlug == Model.StateA.Slug;
        var  w2num  = aW2 ? Model.Result.NumericA!.Value : Model.Result.NumericB!.Value;
        var  l2num  = aW2 ? Model.Result.NumericB!.Value : Model.Result.NumericA!.Value;
        if (l2num > 0 && w2num / l2num >= 1.15)
        {
            var moreOrLess = Model.Metric.HigherIsBetter ? "more" : "less";
            var w2name     = aW2 ? titleA : titleB;
            var l2name     = aW2 ? titleB : titleA;
            metFaq.Add(($"How much {moreOrLess} {mLow} does {w2name} have compared to {l2name}?",
                Model.Result.DifferenceText + "."));
        }
    }

    // FAQ JSON-LD
    string metFaqJson = "";
    if (metFaq.Any())
    {
        var schObj = new Dictionary<string, object>
        {
            ["@context"]   = "https://schema.org",
            ["@type"]      = "FAQPage",
            ["mainEntity"] = metFaq.Select(f => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"]  = f.Q,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"]  = f.A
                }
            }).ToArray()
        };
        metFaqJson = System.Text.Json.JsonSerializer.Serialize(schObj);
    }
}

@if (!string.IsNullOrWhiteSpace(contextParagraph) || keyFacts.Any())
{
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#fff_100%)] py-10 border-t">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            @if (!string.IsNullOrWhiteSpace(contextParagraph))
            {
                <div class="mb-7">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700 mb-2">What This Means</p>
                    <h2 class="text-xl font-bold text-slate-900 mb-3">@titleA vs @titleB: @mName in context</h2>
                    <p class="text-base leading-7 text-slate-600">@contextParagraph</p>
                </div>
            }
            @if (keyFacts.Any())
            {
                <div class="grid sm:grid-cols-3 gap-4">
                    @foreach (var (label, value, isWin) in keyFacts)
                    {
                        <div class="rounded-2xl border @(isWin ? "border-emerald-200 bg-emerald-50" : "border-slate-200 bg-white") p-5 shadow-sm">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@label</span>
                                @if (isWin) { <i class="fa-solid fa-crown text-emerald-500 text-[10px]"></i> }
                            </div>
                            <div class="text-xl font-extrabold @(isWin ? "text-emerald-700" : "text-slate-800") leading-tight">@value</div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@if (metFaq.Any())
{
    if (!string.IsNullOrWhiteSpace(metFaqJson))
    {
        <script type="application/ld+json">@Html.Raw(metFaqJson)</script>
    }

    <section class="bg-white py-10 border-t">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700 mb-2">People Also Ask</p>
            <h2 class="text-xl font-bold text-slate-900 mb-5">@titleA vs @titleB @mName — Common Questions</h2>
            <div class="divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                @foreach (var (q, a) in metFaq)
                {
                    <div class="px-5 py-4">
                        <h3 class="text-sm font-semibold text-slate-900 mb-1.5 flex items-start gap-2.5">
                            <span class="mt-0.5 w-5 h-5 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 text-[10px] font-bold">Q</span>
                            @q
                        </h3>
                        <div class="ml-7">
                            <p class="text-sm leading-6 text-slate-600">@a</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="bg-gray-50 py-12 border-t">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-6 flex-wrap">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-1">More Comparisons: @titleA vs @titleB</h2>
                <p class="text-sm text-gray-500">Grouped tabs keep the deep-dive links tighter and easier to scan.</p>
            </div>
            <a href="/compare/@Model.PairSlug" class="hidden sm:inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:border-blue-300 hover:bg-blue-50 transition">
                <i class="fa-solid fa-table-columns text-xs"></i>
                Full Comparison
            </a>
        </div>

        <div class="flex flex-wrap gap-2 mb-6">
            @{
                bool hasCurrentGroup = groupedOtherMetrics.Any(g => string.Equals(g.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase));
            }
            @foreach (var grp in groupedOtherMetrics)
            {
                var cmpTabId = $"cmp-tab-{grp.Key.GroupSlug}";
                var cmpActive = hasCurrentGroup
                    ? string.Equals(grp.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase)
                    : grp == groupedOtherMetrics.First();
                <button type="button"
                        class="cmp-tab inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold transition @(cmpActive ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-700 border-slate-300 hover:border-blue-300 hover:text-blue-700")"
                        data-target="@cmpTabId">
                    @grp.Key.GroupName
                </button>
            }
        </div>

        <div>
            @foreach (var grp in groupedOtherMetrics)
            {
                var cmpPanelId = $"cmp-tab-{grp.Key.GroupSlug}";
                var cmpActive = hasCurrentGroup
                    ? string.Equals(grp.Key.GroupSlug, Model.Metric.GroupSlug, StringComparison.OrdinalIgnoreCase)
                    : grp == groupedOtherMetrics.First();
                <div id="@cmpPanelId" class="cmp-panel @(cmpActive ? "" : "hidden")">
                    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
                        @foreach (var metric in grp)
                        {
                            <a href="/compare/@Model.PairSlug/@metric.Slug" class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl p-4 hover:shadow-md hover:border-blue-300 transition group">
                                <span class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                                    <i class="@metric.Icon text-blue-600 text-sm"></i>
                                </span>
                                <span class="flex-1 font-medium text-gray-900 text-sm group-hover:text-blue-700">@metric.Name</span>
                                <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-blue-500 text-xs shrink-0"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <a href="/compare/@Model.PairSlug" class="mt-4 flex items-center gap-3 bg-blue-700 text-white border border-blue-700 rounded-xl p-4 hover:bg-blue-800 transition group sm:hidden">
            <span class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-table-columns text-white text-sm"></i>
            </span>
            <span class="font-medium text-sm">Full Comparison</span>
            <i class="fa-solid fa-chevron-right text-blue-300 text-xs ml-auto"></i>
        </a>
    </div>
</section>

<section class="bg-white py-10 border-t">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Explore Each State</h2>
        <div class="flex gap-4 flex-wrap">
            <a href="/states/@Model.StateA.Slug" class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:border-blue-300 hover:text-blue-700 transition">
                <img src="@Images.Thumb(Model.StateA.FlagImageUrl)" class="w-6 h-4 object-cover rounded" onerror="this.style.display='none'" alt="@Model.StateA.Name flag" />
                @Model.StateA.Name Symbols
            </a>
            <a href="/states/@Model.StateB.Slug" class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:border-blue-300 hover:text-blue-700 transition">
                <img src="@Images.Thumb(Model.StateB.FlagImageUrl)" class="w-6 h-4 object-cover rounded" onerror="this.style.display='none'" alt="@Model.StateB.Name flag" />
                @Model.StateB.Name Symbols
            </a>
            <a href="/compare-states" class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:border-blue-300 hover:text-blue-700 transition">
                <i class="fa-solid fa-scale-balanced text-blue-500"></i>
                Compare Other States
            </a>
        </div>
    </div>
</section>

<script>
(function () {
    const tabs   = Array.from(document.querySelectorAll('.cmp-tab'));
    const panels = Array.from(document.querySelectorAll('.cmp-panel'));
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-target');
            tabs.forEach(b => {
                b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
                b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
            });
            tab.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
            tab.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
            panels.forEach(p => p.id === target ? p.classList.remove('hidden') : p.classList.add('hidden'));
        });
    });
})();
</script>

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebPage",
  "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Model.StateA.Name} vs {Model.StateB.Name} | {Model.Metric.Name} Comparison")),
  "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(directAnswer ?? $"Compare {Model.Metric.Name.ToLower()} between {Model.StateA.Name} and {Model.StateB.Name}.")),
  "url": "https://usasymbol.com/compare/@Model.PairSlug/@Model.Metric.Slug",
  "license": "https://usasymbol.com/terms",
  "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "https://usasymbol.com" },
  "about": [
    { "@@type": "AdministrativeArea", "name": "@Model.StateA.Name", "identifier": "@Model.StateA.Abbreviation" },
    { "@@type": "AdministrativeArea", "name": "@Model.StateB.Name", "identifier": "@Model.StateB.Abbreviation" }
  ],
  "breadcrumb": {
    "@@type": "BreadcrumbList",
    "itemListElement": [
      { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://usasymbol.com" },
      { "@@type": "ListItem", "position": 2, "name": "Compare States", "item": "https://usasymbol.com/compare-states" },
      { "@@type": "ListItem", "position": 3, "name": "@Model.StateA.Name vs @Model.StateB.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug" },
      { "@@type": "ListItem", "position": 4, "name": "@Model.Metric.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug/@Model.Metric.Slug" }
    ]
  }
}
</script>

<section class="bg-gray-50 py-8 border-t text-sm text-gray-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p><strong class="text-gray-700">Sources:</strong> Core demographic data comes from the 2020 U.S. Census, with land area from U.S. Census Bureau TIGER files. Income, housing, affordability, and tax fields are maintained in our comparison dataset; purchasing-power figures use BEA Regional Price Parities. Minimum wage data comes from the U.S. Department of Labor, gas prices from AAA, and electricity rates from the U.S. Energy Information Administration. Political control and election fields use 2024 presidential results together with National Conference of State Legislatures data. Gun-law labels use the Giffords scorecard, alcohol system data comes from NABCA, and marijuana status uses NCSL's state cannabis laws tracker.</p>
    </div>
</section>
