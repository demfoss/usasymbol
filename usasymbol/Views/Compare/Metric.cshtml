                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome), CxMon(Model.StatsB?.MedianHouseholdIncome),   $"/compare/{pair}/median-income"));
                ctxRows.Add(("Median Home Value",     CxMon(Model.StatsA?.MedianHomeValue),          CxMon(Model.StatsB?.MedianHomeValue),          $"/compare/{pair}/home-value"));
                ctxRows.Add(("Cost of Living Index",  CxNum(Model.StatsA?.CostOfLivingIndex),        CxNum(Model.StatsB?.CostOfLivingIndex),        $"/compare/{pair}/cost-of-living"));
                break;

            case "rent-to-income":
                ctxTitle = "Rent Burden in Context";
                ctxNote  = "This ratio shows how much of a median paycheck goes straight to the landlord — the higher, the less breathing room renters have.";
                ctxRows.Add(("Median Gross Rent",     CxMoMo(Model.StatsA?.MedianGrossRent),         CxMoMo(Model.StatsB?.MedianGrossRent),         $"/compare/{pair}/median-rent"));
                ctxRows.Add(("Median Household Income", CxMon(Model.StatsA?.MedianHouseholdIncome),  CxMon(Model.StatsB?.MedianHouseholdIncome),    $"/compare/{pair}/median-income"));
                ctxRows.Add(("Income After Rent (mo.)", CxMoMo(cxIafA.HasValue ? (int?)Math.Round(cxIafA.Value) : null), CxMoMo(cxIafB.HasValue ? (int?)Math.Round(cxIafB.Value) : null), null));
                ctxRows.Add(("Median Home Value",     CxMon(Model.StatsA?.MedianHomeValue),           CxMon(Model.StatsB?.MedianHomeValue),           $"/compare/{pair}/home-value"));
                ctxRows.Add(("Cost of Living Index",  CxNum(Model.StatsA?.CostOfLivingIndex),         CxNum(Model.StatsB?.CostOfLivingIndex),         $"/compare/{pair}/cost-of-living"));
