@using USASymbol.Services
@model USASymbol.Models.ViewModels.MetricComparisonViewModel
@inject IImageUrlService Images
@inject usasymbol.Services.Interface.IColorService ColorSvc

@{
    var titleA = Model.StateA.Name;
    var titleB = Model.StateB.Name;
    var isCostPage   = Model.Metric.Slug == "cost-of-living";
    var isPurchasingPowerPage = Model.Metric.Slug == "purchasing-power";
    var isLifePage   = Model.Metric.Slug == "life-expectancy";
    var isSafetyPage = Model.Metric.Slug == "violent-crime";
    var isIntentPage = isCostPage || isPurchasingPowerPage || isLifePage || isSafetyPage;
    var metricSource = ComparisonMetricSourceCatalog.Get(Model.Metric);
    var groupedOtherMetrics = Model.OtherMetrics
        .GroupBy(m => new { m.GroupSlug, m.GroupName, m.GroupOrder })
        .OrderBy(g => g.Key.GroupOrder)
        .ToList();
    var intentCards = new List<(string Icon, string Eyebrow, string Title, string Body, string Tone, string? Link)>();

    string DashIfNull(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Money(int? value) => value.HasValue ? $"${value.Value:N0}" : "-";
    string MoneyPerMonth(int? value) => value.HasValue ? $"${value.Value:N0}/mo" : "-";
    string Percent(double? value, int decimals = 1) => value.HasValue ? $"{value.Value.ToString($"F{decimals}")}%" : "-";
    string Number(double? value, int decimals = 1) => value.HasValue ? value.Value.ToString($"F{decimals}") : "-";
    var directAnswer = Model.Result.SummaryText;

    // ── flag-derived accent colors (same resolver as Overview.cshtml) ──
    var colorContentA = await ColorSvc.GetColorContentAsync(Model.StateA.Slug, "flag");
    var colorContentB = await ColorSvc.GetColorContentAsync(Model.StateB.Slug, "flag");
    var accent = CompareAccentColor.Resolve(
        colorContentA?.ColorData.Select(c => c.Hex).ToList(),
        colorContentB?.ColorData.Select(c => c.Hex).ToList());

    if (isPurchasingPowerPage)
    {
        if (Model.StatsA?.PurchasingPower100 != null && Model.StatsB?.PurchasingPower100 != null)
        {
            var stronger = Model.StatsA.PurchasingPower100 > Model.StatsB.PurchasingPower100 ? Model.StateA : Model.StateB;
            var weaker = stronger == Model.StateA ? Model.StateB : Model.StateA;
            var strongerStats = stronger == Model.StateA ? Model.StatsA : Model.StatsB;
            var weakerStats = stronger == Model.StateA ? Model.StatsB : Model.StatsA;
            var diff = Math.Abs(Model.StatsA.PurchasingPower100.Value - Model.StatsB.PurchasingPower100.Value);
            directAnswer = $"$100 goes further in {stronger.Name}: about ${strongerStats!.PurchasingPower100:F2} in local buying power versus ${weakerStats!.PurchasingPower100:F2} in {weaker.Name}, a ${diff:F2} gap.";

            intentCards.Add((
                "fa-solid fa-money-bill-wave",
                "Real Dollar Value",
                $"{stronger.Name} stretches $100 further",
                $"A national-average $100 buys about ${strongerStats.PurchasingPower100:F2} of local goods and services in {stronger.Name}, compared with ${weakerStats!.PurchasingPower100:F2} in {weaker.Name}.",
                "from-lime-100 via-emerald-50 to-white",
                null));
        }

        if (Model.StatsA?.RegionalPriceParity != null && Model.StatsB?.RegionalPriceParity != null)
        {
            var lower = Model.StatsA.RegionalPriceParity < Model.StatsB.RegionalPriceParity ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-scale-balanced",
                "BEA Price Index",
                $"{lower.Name} has the lower official price level",
                $"BEA Regional Price Parity is lower in {lower.Name} ({Math.Min(Model.StatsA.RegionalPriceParity.Value, Model.StatsB.RegionalPriceParity.Value):F1}) than in {higher.Name} ({Math.Max(Model.StatsA.RegionalPriceParity.Value, Model.StatsB.RegionalPriceParity.Value):F1}), which is why the same cash buys more there.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/regional-price-parity"));
        }

        if (Model.StatsA?.MedianHouseholdIncome != null && Model.StatsB?.MedianHouseholdIncome != null)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income Check",
                $"{higher.Name} has the higher median income",
                $"Purchasing power does not replace income. {higher.Name} has a median household income of ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0}, versus ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-emerald-100 via-green-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Living Costs",
                $"{cheaper.Name} also looks cheaper on the cost index",
                $"{cheaper.Name}'s cost-of-living index is {Math.Min(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1}, compared with {Math.Max(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} in the other state.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }
    }

    if (isCostPage)
    {
        var parts = new List<string>();

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            var pricier = cheaper == Model.StateA ? Model.StateB : Model.StateA;
            var diff = Math.Abs(Model.StatsA.CostOfLivingIndex.Value - Model.StatsB.CostOfLivingIndex.Value);
            parts.Add($"{cheaper.Name} is cheaper overall by {diff:F1} cost-of-living points");
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            parts.Add($"{Model.StateA.Name} has no state income tax");
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            parts.Add($"{Model.StateB.Name} has no state income tax");
        }

        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            parts.Add($"{lower.Name} has lower median home values");
        }

        if (parts.Any())
        {
            directAnswer = string.Join(", but ", new[] { parts.First() }.Concat(parts.Skip(1).Take(2)));
            directAnswer += ".";
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var lower = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            var diff = Math.Abs(Model.StatsA.CostOfLivingIndex.Value - Model.StatsB.CostOfLivingIndex.Value);
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Overall",
                $"{lower.Name} feels cheaper overall",
                $"{lower.Name} has the lower cost-of-living index, beating {higher.Name} by {diff:F1} points on the overall affordability baseline.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }

        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            var ratio = Math.Round((double)Math.Max(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value) / Math.Min(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value), 1);
            intentCards.Add((
                "fa-solid fa-house",
                "Housing",
                $"pay about {ratio:F1}x more for a home",
                $"{lower.Name} has the lower median home value, while buying in {higher.Name} costs materially more at the median.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/home-value"));
        }

        if (Model.StatsA?.RentToIncomeRatioPct().HasValue == true && Model.StatsB?.RentToIncomeRatioPct().HasValue == true)
        {
            var lower = Model.StatsA.RentToIncomeRatioPct() < Model.StatsB.RentToIncomeRatioPct() ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-key",
                "Rent Pressure",
                $"{lower.Name} puts less pressure on a median paycheck",
                $"Median rent takes a smaller share of household income in {lower.Name} than in {higher.Name}, which makes monthly budgeting easier.",
                "from-emerald-100 via-lime-50 to-white",
                "/compare/" + Model.PairSlug + "/rent-to-income"));
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{Model.StateA.Name} has no state income tax",
                $"{Model.StateA.Name} gives residents a cleaner paycheck-level tax advantage, while {Model.StateB.Name} still taxes income at the state level.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{Model.StateB.Name} has no state income tax",
                $"{Model.StateB.Name} gives residents a cleaner paycheck-level tax advantage, while {Model.StateA.Name} still taxes income at the state level.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }
        else if (Model.StatsA?.IncomeTaxRatePct != null && Model.StatsB?.IncomeTaxRatePct != null)
        {
            var lower = Model.StatsA.IncomeTaxRatePct < Model.StatsB.IncomeTaxRatePct ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{lower.Name} keeps more income after state tax",
                $"{lower.Name} has the lower top state income tax rate, which softens the total cost picture even when prices are close.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }

        if (Model.StatsA?.AverageTemperatureF != null && Model.StatsB?.AverageTemperatureF != null)
        {
            var warmer = Model.StatsA.AverageTemperatureF > Model.StatsB.AverageTemperatureF ? Model.StateA : Model.StateB;
            var cooler = warmer == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-temperature-half",
                "Climate",
                $"{warmer.Name} stays warmer overall",
                $"{warmer.Name} averages a warmer annual temperature than {cooler.Name}, which can materially change the day-to-day feel of living there.",
                "from-orange-100 via-amber-50 to-white",
                "/compare/" + Model.PairSlug + "/average-temperature"));
        }

        if (Model.StatsA?.SunnyDaysPerYear != null && Model.StatsB?.SunnyDaysPerYear != null)
        {
            var sunnier = Model.StatsA.SunnyDaysPerYear > Model.StatsB.SunnyDaysPerYear ? Model.StateA : Model.StateB;
            var cloudier = sunnier == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-cloud-sun",
                "Sunshine",
                $"{sunnier.Name} gets more bright days",
                $"{sunnier.Name} averages more sunny days per year than {cloudier.Name}, which often matters just as much as the raw cost numbers.",
                "from-yellow-100 via-amber-50 to-white",
                "/compare/" + Model.PairSlug + "/sunny-days"));
        }
    }

    var standoutPoints = new List<string>();
    if (isCostPage)
    {
        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has lower median home values.");
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            standoutPoints.Add($"{Model.StateA.Name} has no state income tax.");
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            standoutPoints.Add($"{Model.StateB.Name} has no state income tax.");
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var lower = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower overall cost index.");
        }

        if (Model.StatsA?.MedianHouseholdIncome != null && Model.StatsB?.MedianHouseholdIncome != null)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }

        if (Model.StatsA?.HomeValueToIncomeRatio().HasValue == true && Model.StatsB?.HomeValueToIncomeRatio().HasValue == true)
        {
            var lower = Model.StatsA.HomeValueToIncomeRatio() < Model.StatsB.HomeValueToIncomeRatio() ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} looks more attainable on home value to income ratio.");
        }

        if (Model.StatsA?.RentToIncomeRatioPct().HasValue == true && Model.StatsB?.RentToIncomeRatioPct().HasValue == true)
        {
            var lower = Model.StatsA.RentToIncomeRatioPct() < Model.StatsB.RentToIncomeRatioPct() ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} puts less rent pressure on a median household income.");
        }
    }

    if (isLifePage)
    {
        if (Model.StatsA?.LifeExpectancyYears.HasValue == true && Model.StatsB?.LifeExpectancyYears.HasValue == true)
        {
            var longer = Model.StatsA.LifeExpectancyYears > Model.StatsB.LifeExpectancyYears ? Model.StateA : Model.StateB;
            var shorter = longer == Model.StateA ? Model.StateB : Model.StateA;
            var longerStats  = longer == Model.StateA ? Model.StatsA : Model.StatsB;
            var shorterStats = longer == Model.StateA ? Model.StatsB : Model.StatsA;
            var gap = Math.Abs(Model.StatsA.LifeExpectancyYears.Value - Model.StatsB.LifeExpectancyYears.Value);
            intentCards.Add((
                "fa-solid fa-heart-pulse",
                "Life Expectancy",
                $"{longer.Name} residents live {gap:F1} years longer on average",
                $"{longer.Name} has a life expectancy of {longerStats!.LifeExpectancyYears:F1} yrs vs {shorterStats!.LifeExpectancyYears:F1} yrs in {shorter.Name}, a meaningful gap for relocation planning.",
                "from-rose-100 via-pink-50 to-white",
                null));
        }

        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-hand-holding-dollar",
                "Poverty",
                $"{lower.Name} has a lower poverty rate",
                $"Poverty and health outcomes are closely linked. {lower.Name}'s lower poverty rate ({Math.Min(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%) versus {higher.Name} ({Math.Max(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%) is part of the longevity story.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/poverty-rate"));
        }

        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income",
                $"{higher.Name} has higher household income",
                $"Higher median income correlates with better healthcare access. {higher.Name} leads at ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} vs ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-emerald-100 via-green-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        if (Model.StatsA?.CostOfLivingIndex.HasValue == true && Model.StatsB?.CostOfLivingIndex.HasValue == true)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Affordability",
                $"{cheaper.Name} has a lower cost of living",
                $"Lower living costs mean more disposable income for healthcare. {cheaper.Name}'s cost-of-living index is {Math.Min(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} vs {Math.Max(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} in the other state.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }

        if (Model.StatsA?.LifeExpectancyYears.HasValue == true && Model.StatsB?.LifeExpectancyYears.HasValue == true)
        {
            var longer = Model.StatsA.LifeExpectancyYears > Model.StatsB.LifeExpectancyYears ? Model.StateA : Model.StateB;
            var shorter = longer == Model.StateA ? Model.StateB : Model.StateA;
            standoutPoints.Add($"{longer.Name} has the higher life expectancy at {Math.Max(Model.StatsA.LifeExpectancyYears.Value, Model.StatsB.LifeExpectancyYears.Value):F1} years.");
        }
        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower poverty rate.");
        }
        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }
    }

    if (isSafetyPage)
    {
        if (Model.StatsA?.ViolentCrimeRatePer100k.HasValue == true && Model.StatsB?.ViolentCrimeRatePer100k.HasValue == true)
        {
            var safer   = Model.StatsA.ViolentCrimeRatePer100k < Model.StatsB.ViolentCrimeRatePer100k ? Model.StateA : Model.StateB;
            var riskier = safer == Model.StateA ? Model.StateB : Model.StateA;
            var saferStats   = safer == Model.StateA ? Model.StatsA : Model.StatsB;
            var riskierStats = safer == Model.StateA ? Model.StatsB : Model.StatsA;
            var pctDiff = saferStats!.ViolentCrimeRatePer100k > 0
                ? Math.Round(Math.Abs(saferStats.ViolentCrimeRatePer100k.Value - riskierStats!.ViolentCrimeRatePer100k!.Value) / saferStats.ViolentCrimeRatePer100k.Value * 100, 0)
                : (double?)null;
            intentCards.Add((
                "fa-solid fa-shield-halved",
                "Violent Crime",
                pctDiff.HasValue ? $"{safer.Name} has {pctDiff:F0}% less violent crime" : $"{safer.Name} has a lower violent crime rate",
                $"{safer.Name} records {saferStats.ViolentCrimeRatePer100k:F1} violent incidents per 100k residents versus {riskierStats!.ViolentCrimeRatePer100k:F1} in {riskier.Name} (FBI UCR 2022).",
                "from-green-100 via-emerald-50 to-white",
                null));
        }

        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-hand-holding-dollar",
                "Poverty",
                $"{lower.Name} has a lower poverty rate",
                $"Economic stress and crime are closely tied. {lower.Name}'s poverty rate is {Math.Min(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%, compared with {Math.Max(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}% in {higher.Name}.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/poverty-rate"));
        }

        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income",
                $"{higher.Name} has higher household income",
                $"States with stronger median incomes tend to have lower crime rates. {higher.Name} leads at ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} vs ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        var densityA = Model.StatsA?.PopulationDensity(Model.StateA.Population);
        var densityB = Model.StatsB?.PopulationDensity(Model.StateB.Population);
        if (densityA.HasValue && densityB.HasValue)
        {
            var denser  = densityA > densityB ? Model.StateA : Model.StateB;
            var sparser = denser == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-city",
                "Population Density",
                $"{denser.Name} is more densely populated",
                $"Urban density often correlates with higher crime rates. {denser.Name} is more densely populated at {Math.Max(densityA.Value, densityB.Value):N1} per sq mi vs {Math.Min(densityA.Value, densityB.Value):N1} in {sparser.Name}.",
                "from-violet-100 via-fuchsia-50 to-white",
                "/compare/" + Model.PairSlug + "/density"));
        }

        if (Model.StatsA?.ViolentCrimeRatePer100k.HasValue == true && Model.StatsB?.ViolentCrimeRatePer100k.HasValue == true)
        {
            var safer = Model.StatsA.ViolentCrimeRatePer100k < Model.StatsB.ViolentCrimeRatePer100k ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{safer.Name} has the lower violent crime rate at {Math.Min(Model.StatsA.ViolentCrimeRatePer100k.Value, Model.StatsB.ViolentCrimeRatePer100k.Value):F1} per 100k.");
        }
        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower poverty rate.");
        }
        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }
    }

    ViewData["Title"] = ViewData["Title"] ?? $"{titleA} vs {titleB}: {Model.Metric.Name}";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/compare-redesign.css" asp-append-version="true">
}

<nav class="cmp2-crumbs">
    <div class="cmp2-shell" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <a href="/">Home</a><span>/</span>
        <a href="/compare-states">Compare States</a><span>/</span>
        <a href="/compare/@Model.PairSlug">@titleA vs @titleB</a><span>/</span>
        <span class="cmp2-crumb-current">@Model.Metric.Name</span>
    </div>
</nav>

<div class="cmp2-page">

    @* ── Hero: direct answer ─────────────────────────────────────────── *@
    <section class="cmp2-metric-hero">
        <div class="cmp2-shell">
            <span class="cmp2-metric-hero-badge"><i class="@Model.Metric.Icon" aria-hidden="true"></i> @Model.Metric.GroupName</span>
            <h1>@titleA vs @titleB: @Model.Metric.Name</h1>
            @if (!string.IsNullOrWhiteSpace(directAnswer))
            {
                <p class="cmp2-metric-hero-answer">@directAnswer</p>
            }
        </div>
    </section>

    <div class="cmp2-page-shell max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start lg:gap-10">
    <div class="min-w-0">

    <section class="cmp2-block">
        <div class="cmp2-shell">

            @{
                var states = new[]
                {
                    (Model.StateA, Model.Result.DisplayValueA, Model.Result.WinnerSlug == Model.StateA.Slug, accent.HexA),
                    (Model.StateB, Model.Result.DisplayValueB, Model.Result.WinnerSlug == Model.StateB.Slug, accent.HexB),
                };
            }
            <div class="cmp2-metric-cards">
                @foreach (var (state, displayVal, isWinner, stateAccent) in states)
                {
                    <div class="cmp2-metric-card @(isWinner ? "is-winner" : "")" style="@(isWinner ? $"border-top-color:{stateAccent}" : "")">
                        <div class="cmp2-metric-card-head">
                            <img src="@Images.Card(state.FlagImageUrl)" alt="@state.Name flag" onerror="this.style.display='none'" />
                            <div>
                                <div class="name">@state.Name</div>
                                <div class="sub"><a href="/states/@state.Slug/abbreviation">@state.Abbreviation</a> &middot; @(state.Region ?? "")</div>
                            </div>
                            @if (isWinner)
                            {
                                <span class="cmp2-metric-winner-tag"><i class="fa-solid fa-crown" aria-hidden="true"></i> Winner</span>
                            }
                        </div>
                        <div class="cmp2-metric-card-value">
                            <div class="num">@(DashIfNull(displayVal))</div>
                            <div class="desc">@Model.Metric.Description</div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Result.NumericA.HasValue && Model.Result.NumericB.HasValue && Model.Metric.Type != USASymbol.Models.MetricType.Text)
            {
                var maxVal = Math.Max(Model.Result.NumericA.Value, Model.Result.NumericB.Value);
                var pctA = maxVal > 0 ? (int)Math.Round(Model.Result.NumericA.Value / maxVal * 100) : 0;
                var pctB = maxVal > 0 ? (int)Math.Round(Model.Result.NumericB.Value / maxVal * 100) : 0;
                var winA = Model.Result.WinnerSlug == Model.StateA.Slug;
                var winB = Model.Result.WinnerSlug == Model.StateB.Slug;
                <div class="cmp2-vbar-block">
                    <p class="cmp2-eyebrow" style="margin-bottom:14px;">Visual comparison</p>
                    <div class="cmp2-vbar-row">
                        <div class="cmp2-vbar-label"><span>@Model.StateA.Name</span><b>@DashIfNull(Model.Result.DisplayValueA)</b></div>
                        <div class="cmp2-vbar-track"><div class="cmp2-vbar-fill" style="width:@(pctA)%;background:@(winA ? accent.HexA : "var(--cmp-line-strong)")"></div></div>
                    </div>
                    <div class="cmp2-vbar-row">
                        <div class="cmp2-vbar-label"><span>@Model.StateB.Name</span><b>@DashIfNull(Model.Result.DisplayValueB)</b></div>
                        <div class="cmp2-vbar-track"><div class="cmp2-vbar-fill" style="width:@(pctB)%;background:@(winB ? accent.HexB : "var(--cmp-line-strong)")"></div></div>
                    </div>
                </div>
            }

            @if (Model.Result.DifferenceText != null)
            {
                var winner = Model.Result.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
                <div class="cmp2-note is-plain" style="text-align:center;">
                    <p style="margin:0;font-size:14px;color:var(--cmp-ink-2);">
                        Difference: <strong style="color:var(--cmp-ink);">@Model.Result.DifferenceText</strong> &mdash; @winner.Name leads.
                    </p>
                </div>
            }
        </div>
    </section>

    @if (Model.AllStateRanks.Count >= 3)
    {
        @await Html.PartialAsync("_CompactRankContext", Model)
    }

    @if (isIntentPage)
    {
        var intentHeading  = isCostPage   ? "Overview"
                           : isLifePage   ? "Health Context"
                                          : "Safety Context";
        var intentSubline  = isCostPage   ? "A fast-reading view of the tradeoffs behind the raw cost numbers."
                           : isLifePage   ? "Key factors that shape the life-expectancy gap between these two states."
                                          : "Economic and demographic factors behind the violent crime rate difference.";
        <section class="cmp2-block">
            <div class="cmp2-shell">
                @if (intentCards.Any())
                {
                    <div class="cmp2-head">
                        <p class="cmp2-eyebrow">@intentHeading</p>
                        <h2 class="cmp2-title" style="margin-bottom:4px;">@Model.Metric.Name in context</h2>
                        <p class="cmp2-sub" style="margin-bottom:0;">@intentSubline</p>
                    </div>
                    <div class="cmp2-intent-grid">
                        @foreach (var card in intentCards.Take(4))
                        {
                            <article class="cmp2-intent-card">
                                <i class="@card.Icon cmp2-intent-icon" aria-hidden="true"></i>
                                <div class="cmp2-intent-eyebrow">@card.Eyebrow</div>
                                <h3 class="cmp2-intent-title">@card.Title</h3>
                                <p class="cmp2-intent-body">@card.Body</p>
                                @if (!string.IsNullOrWhiteSpace(card.Link))
                                {
                                    <a href="@card.Link" class="cmp2-intent-link">See full data &rarr;</a>
                                }
                            </article>
                        }
                    </div>
                }

                @if (isCostPage)
                {
                    <h2 class="cmp2-title">Cost stack</h2>
                    <div class="cmp2-stack-grid">
                        <div class="cmp2-stack-card">
                            <div class="cmp2-stack-head"><img src="@Images.Thumb(Model.StateA.FlagImageUrl)" onerror="this.style.display='none'" alt="" />@Model.StateA.Name</div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Overall affordability</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Cost of living index</dt><dd>@Number(Model.StatsA?.CostOfLivingIndex)</dd></div>
                                    <div><dt>Regional price parity</dt><dd>@Number(Model.StatsA?.RegionalPriceParity)</dd></div>
                                    <div><dt>Regular gas price</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("gas-price")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                    <div><dt>Electricity price</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("electricity-rates")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Housing</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Median gross rent</dt><dd>@MoneyPerMonth(Model.StatsA?.MedianGrossRent)</dd></div>
                                    <div><dt>Median home value</dt><dd>@Money(Model.StatsA?.MedianHomeValue)</dd></div>
                                    <div><dt>Owner costs w/ mortgage</dt><dd>@MoneyPerMonth(Model.StatsA?.MedianOwnerCostsWithMortgage)</dd></div>
                                    <div><dt>Owner costs w/o mortgage</dt><dd>@MoneyPerMonth(Model.StatsA?.MedianOwnerCostsWithoutMortgage)</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Taxes</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>State income tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("income-tax")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                    <div><dt>State sales tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("sales-tax")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                    <div><dt>Property tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("property-tax")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Income</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Median household income</dt><dd>@Money(Model.StatsA?.MedianHouseholdIncome)</dd></div>
                                    <div><dt>Income after median rent</dt><dd>@Money(Model.StatsA?.IncomeAfterMedianRentMonthly() is double aIncomeAfterRent ? (int?)Math.Round(aIncomeAfterRent) : null)</dd></div>
                                    <div><dt>Minimum wage</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("minimum-wage")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Laws</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Gun laws</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("gun-laws-status")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                    <div><dt>Alcohol system</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("alcohol-laws")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                    <div><dt>Marijuana status</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("marijuana-legalization")?.GetDisplayValue(Model.StateA, Model.StatsA))</dd></div>
                                </dl>
                            </div>
                        </div>

                        <div class="cmp2-stack-card">
                            <div class="cmp2-stack-head"><img src="@Images.Thumb(Model.StateB.FlagImageUrl)" onerror="this.style.display='none'" alt="" />@Model.StateB.Name</div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Overall affordability</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Cost of living index</dt><dd>@Number(Model.StatsB?.CostOfLivingIndex)</dd></div>
                                    <div><dt>Regional price parity</dt><dd>@Number(Model.StatsB?.RegionalPriceParity)</dd></div>
                                    <div><dt>Regular gas price</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("gas-price")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                    <div><dt>Electricity price</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("electricity-rates")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Housing</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Median gross rent</dt><dd>@MoneyPerMonth(Model.StatsB?.MedianGrossRent)</dd></div>
                                    <div><dt>Median home value</dt><dd>@Money(Model.StatsB?.MedianHomeValue)</dd></div>
                                    <div><dt>Owner costs w/ mortgage</dt><dd>@MoneyPerMonth(Model.StatsB?.MedianOwnerCostsWithMortgage)</dd></div>
                                    <div><dt>Owner costs w/o mortgage</dt><dd>@MoneyPerMonth(Model.StatsB?.MedianOwnerCostsWithoutMortgage)</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Taxes</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>State income tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("income-tax")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                    <div><dt>State sales tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("sales-tax")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                    <div><dt>Property tax</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("property-tax")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Income</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Median household income</dt><dd>@Money(Model.StatsB?.MedianHouseholdIncome)</dd></div>
                                    <div><dt>Income after median rent</dt><dd>@Money(Model.StatsB?.IncomeAfterMedianRentMonthly() is double bIncomeAfterRent ? (int?)Math.Round(bIncomeAfterRent) : null)</dd></div>
                                    <div><dt>Minimum wage</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("minimum-wage")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                </dl>
                            </div>
                            <div class="cmp2-stack-section">
                                <div class="cmp2-stack-section-label">Laws</div>
                                <dl class="cmp2-stack-mini">
                                    <div><dt>Gun laws</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("gun-laws-status")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                    <div><dt>Alcohol system</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("alcohol-laws")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                    <div><dt>Marijuana status</dt><dd>@DashIfNull(ComparisonMetricsConfig.GetBySlug("marijuana-legalization")?.GetDisplayValue(Model.StateB, Model.StatsB))</dd></div>
                                </dl>
                            </div>
                        </div>
                    </div>
                } @* end isCostPage *@

                @if (isLifePage)
                {
                    <h2 class="cmp2-title">Health snapshot</h2>
                    <div class="cmp2-stack-grid">
                        @foreach (var (state, stats) in new[] { (Model.StateA, Model.StatsA), (Model.StateB, Model.StatsB) })
                        {
                            <div class="cmp2-stack-card">
                                <div class="cmp2-stack-head"><img src="@Images.Thumb(state.FlagImageUrl)" onerror="this.style.display='none'" alt="" />@state.Name</div>
                                <div class="cmp2-stack-section">
                                    <div class="cmp2-stack-section-label">Health</div>
                                    <dl class="cmp2-stack-mini"><div><dt>Life expectancy</dt><dd>@Number(stats?.LifeExpectancyYears) yrs</dd></div></dl>
                                </div>
                                <div class="cmp2-stack-section">
                                    <div class="cmp2-stack-section-label">Economy</div>
                                    <dl class="cmp2-stack-mini">
                                        <div><dt>Median household income</dt><dd>@Money(stats?.MedianHouseholdIncome)</dd></div>
                                        <div><dt>Poverty rate</dt><dd>@Percent(stats?.PovertyRatePct)</dd></div>
                                        <div><dt>Cost of living index</dt><dd>@Number(stats?.CostOfLivingIndex)</dd></div>
                                    </dl>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (isSafetyPage)
                {
                    <h2 class="cmp2-title">Safety snapshot</h2>
                    <div class="cmp2-stack-grid">
                        @foreach (var (state, stats) in new[] { (Model.StateA, Model.StatsA), (Model.StateB, Model.StatsB) })
                        {
                            var densityVal = stats?.PopulationDensity(state.Population);
                            <div class="cmp2-stack-card">
                                <div class="cmp2-stack-head"><img src="@Images.Thumb(state.FlagImageUrl)" onerror="this.style.display='none'" alt="" />@state.Name</div>
                                <div class="cmp2-stack-section">
                                    <div class="cmp2-stack-section-label">Safety</div>
                                    <dl class="cmp2-stack-mini"><div><dt>Violent crime rate / 100k</dt><dd>@Number(stats?.ViolentCrimeRatePer100k)</dd></div></dl>
                                </div>
                                <div class="cmp2-stack-section">
                                    <div class="cmp2-stack-section-label">Contributing factors</div>
                                    <dl class="cmp2-stack-mini">
                                        <div><dt>Poverty rate</dt><dd>@Percent(stats?.PovertyRatePct)</dd></div>
                                        <div><dt>Median household income</dt><dd>@Money(stats?.MedianHouseholdIncome)</dd></div>
                                        <div><dt>Population density</dt><dd>@(densityVal.HasValue ? $"{densityVal.Value:N1} / sq mi" : "-")</dd></div>
                                        <div><dt>Unemployment rate</dt><dd>@Percent(stats?.UnemploymentRatePct)</dd></div>
                                    </dl>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (standoutPoints.Any())
                {
                    <div class="cmp2-note">
                        <h2>What stands out</h2>
                        <ul>
                            @foreach (var point in standoutPoints.Take(4))
                            {
                                <li>@point</li>
                            }
                        </ul>
                    </div>
                }

                @if (isCostPage)
                {
                    <h2 class="cmp2-title">Affordability ratios</h2>
                    <div class="cmp2-fact-grid" style="margin-top:0;margin-bottom:24px;">
                        <a href="/compare/@Model.PairSlug/home-value-to-income" class="cmp2-link-card">
                            <div class="label">Home value to income</div>
                            <div class="line">@Model.StateA.Name: @Number(Model.StatsA?.HomeValueToIncomeRatio(), 2)x</div>
                            <div class="line">@Model.StateB.Name: @Number(Model.StatsB?.HomeValueToIncomeRatio(), 2)x</div>
                        </a>
                        <a href="/compare/@Model.PairSlug/rent-to-income" class="cmp2-link-card">
                            <div class="label">Rent to income</div>
                            <div class="line">@Model.StateA.Name: @Percent(Model.StatsA?.RentToIncomeRatioPct())</div>
                            <div class="line">@Model.StateB.Name: @Percent(Model.StatsB?.RentToIncomeRatioPct())</div>
                        </a>
                        <a href="/compare/@Model.PairSlug/owner-costs-to-income" class="cmp2-link-card">
                            <div class="label">Owner costs to income</div>
                            <div class="line">@Model.StateA.Name: @Percent(Model.StatsA?.OwnerCostsToIncomePct)</div>
                            <div class="line">@Model.StateB.Name: @Percent(Model.StatsB?.OwnerCostsToIncomePct)</div>
                        </a>
                    </div>
                } @* end isCostPage ratios *@

                @{
                    var relatedLinks = isCostPage ? new[] {
                            ("/compare/" + Model.PairSlug + "/home-value",          "Housing"),
                            ("/compare/" + Model.PairSlug + "/income-tax",          "Taxes"),
                            ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                            ("/compare/" + Model.PairSlug + "/owner-costs-to-income","Owner Costs")
                        } : isLifePage ? new[] {
                            ("/compare/" + Model.PairSlug + "/violent-crime",       "Violent Crime"),
                            ("/compare/" + Model.PairSlug + "/poverty-rate",        "Poverty Rate"),
                            ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                            ("/compare/" + Model.PairSlug + "/cost-of-living",      "Cost of Living")
                        } : new[] {
                            ("/compare/" + Model.PairSlug + "/life-expectancy",     "Life Expectancy"),
                            ("/compare/" + Model.PairSlug + "/poverty-rate",        "Poverty Rate"),
                            ("/compare/" + Model.PairSlug + "/median-income",       "Income"),
                            ("/compare/" + Model.PairSlug + "/density",             "Population Density")
                        };
                }
                <h2 class="cmp2-title">Related pages</h2>
                <div class="cmp2-related-grid">
                    @foreach (var (href, label) in relatedLinks)
                    {
                        <a href="@href" class="cmp2-related-card" style="justify-content:center;">@label</a>
                    }
                </div>

            </div>
        </section>
    }

    @{
        // ── Context Snapshot (non-intent pages) ──────────────────────────────────
        var ctxRows = new List<(string Label, string ValA, string ValB, string? Href)>();
        var ctxTitle = "";
        var ctxNote = "";

        if (!isIntentPage)
        {
            string CxD(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
            string CxMon(int? v) => v.HasValue ? $"${v.Value:N0}" : "—";
            string CxMoMo(int? v) => v.HasValue ? $"${v.Value:N0}/mo" : "—";
            string CxPct(double? v, int d = 1) => v.HasValue ? $"{v.Value.ToString($"F{d}")}%" : "—";
            string CxNum(double? v, int d = 1) => v.HasValue ? v.Value.ToString($"F{d}") : "—";
            string CxMoney2(double? v) => v.HasValue ? $"${v.Value:F2}" : "—";
            string CxTemp(double? v) => v.HasValue ? $"{v.Value:F1}°F" : "—";
            string CxSqMi(double? v) => v.HasValue ? $"{v.Value:N0} sq mi" : "—";
            string CxDens(double? v) => v.HasValue ? $"{v.Value:N1} / sq mi" : "—";
            string CxYrs(double? v) => v.HasValue ? $"{v.Value:F1} yrs" : "—";
            string CxIn(double? v) => v.HasValue ? $"{v.Value:F1} in" : "—";
            string CxDays(int? v) => v.HasValue ? $"{v.Value} days" : "—";
            string CxMin(double? v) => v.HasValue ? $"{v.Value:F1} min" : "—";
            string CxOrder(int? v) => v.HasValue ? $"#{v.Value}" : "—";
            string CxX(double? v, int d = 2) => v.HasValue ? $"{v.Value.ToString($"F{d}")}×" : "—";
            string CxMetric(string slug, State st, StateStats? ss) =>
                CxD(ComparisonMetricsConfig.GetBySlug(slug)?.GetDisplayValue(st, ss));

            var cxDensA = Model.StatsA?.PopulationDensity(Model.StateA.Population);
            var cxDensB = Model.StatsB?.PopulationDensity(Model.StateB.Population);
            var cxIafA  = Model.StatsA?.IncomeAfterMedianRentMonthly();
            var cxIafB  = Model.StatsB?.IncomeAfterMedianRentMonthly();

            string pair = Model.PairSlug;

            switch (Model.Metric.Slug)
            {
                case "capital":
                    ctxTitle = "States at a Glance";
                    ctxNote  = "Key facts about each state alongside the capital comparison.";
                    ctxRows.Add(("Population",          CxD(Model.StateA.Population?.ToString("N0")), CxD(Model.StateB.Population?.ToString("N0")), $"/compare/{pair}/population"));
                    ctxRows.Add(("State Color",          CxD(Model.StatsA?.PoliticalLean),             CxD(Model.StatsB?.PoliticalLean),             $"/compare/{pair}/political-lean"));
                    ctxRows.Add(("Governor Party",       CxD(Model.StatsA?.GovernorParty),             CxD(Model.StatsB?.GovernorParty),             null));
                    ctxRows.Add(("Median Income",        CxMon(Model.StatsA?.MedianHouseholdIncome),   CxMon(Model.StatsB?.MedianHouseholdIncome),   $"/compare/{pair}/median-income"));
                    ctxRows.Add(("Cost of Living Index", CxNum(Model.StatsA?.CostOfLivingIndex),       CxNum(Model.StatsB?.CostOfLivingIndex),       $"/compare/{pair}/cost-of-living"));
                    break;

                case "political-lean":
                    ctxTitle = "Full Political Picture";
                    ctxNote  = "Presidential color is just one layer — here's the complete breakdown.";
                    ctxRows.Add(("Governor Party",           CxD(Model.StatsA?.GovernorParty),                          CxD(Model.StatsB?.GovernorParty),                          null));
                    ctxRows.Add(("State House",              CxD(Model.StatsA?.StateHouseControl),                      CxD(Model.StatsB?.StateHouseControl),                      null));
