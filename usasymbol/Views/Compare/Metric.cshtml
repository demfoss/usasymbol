@using USASymbol.Services
@model USASymbol.Models.ViewModels.MetricComparisonViewModel
@inject IImageUrlService Images

@{
    var titleA = Model.StateA.Name;
    var titleB = Model.StateB.Name;
    var isCostPage   = Model.Metric.Slug == "cost-of-living";
    var isPurchasingPowerPage = Model.Metric.Slug == "purchasing-power";
    var isLifePage   = Model.Metric.Slug == "life-expectancy";
    var isSafetyPage = Model.Metric.Slug == "violent-crime";
    var isIntentPage = isCostPage || isPurchasingPowerPage || isLifePage || isSafetyPage;
    var groupedOtherMetrics = Model.OtherMetrics
        .GroupBy(m => new { m.GroupSlug, m.GroupName, m.GroupOrder })
        .OrderBy(g => g.Key.GroupOrder)
        .ToList();
    var intentCards = new List<(string Icon, string Eyebrow, string Title, string Body, string Tone, string? Link)>();

    string DashIfNull(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Money(int? value) => value.HasValue ? $"${value.Value:N0}" : "-";
    string MoneyPerMonth(int? value) => value.HasValue ? $"${value.Value:N0}/mo" : "-";
    string Percent(double? value, int decimals = 1) => value.HasValue ? $"{value.Value.ToString($"F{decimals}")}%" : "-";
    string Number(double? value, int decimals = 1) => value.HasValue ? value.Value.ToString($"F{decimals}") : "-";
    var directAnswer = Model.Result.SummaryText;
    if (isPurchasingPowerPage)
    {
        if (Model.StatsA?.PurchasingPower100 != null && Model.StatsB?.PurchasingPower100 != null)
        {
            var stronger = Model.StatsA.PurchasingPower100 > Model.StatsB.PurchasingPower100 ? Model.StateA : Model.StateB;
            var weaker = stronger == Model.StateA ? Model.StateB : Model.StateA;
            var strongerStats = stronger == Model.StateA ? Model.StatsA : Model.StatsB;
            var weakerStats = stronger == Model.StateA ? Model.StatsB : Model.StatsA;
            var diff = Math.Abs(Model.StatsA.PurchasingPower100.Value - Model.StatsB.PurchasingPower100.Value);
            directAnswer = $"$100 goes further in {stronger.Name}: about ${strongerStats!.PurchasingPower100:F2} in local buying power versus ${weakerStats!.PurchasingPower100:F2} in {weaker.Name}, a ${diff:F2} gap.";

            intentCards.Add((
                "fa-solid fa-money-bill-wave",
                "Real Dollar Value",
                $"{stronger.Name} stretches $100 further",
                $"A national-average $100 buys about ${strongerStats.PurchasingPower100:F2} of local goods and services in {stronger.Name}, compared with ${weakerStats!.PurchasingPower100:F2} in {weaker.Name}.",
                "from-lime-100 via-emerald-50 to-white",
                null));
        }

        if (Model.StatsA?.RegionalPriceParity != null && Model.StatsB?.RegionalPriceParity != null)
        {
            var lower = Model.StatsA.RegionalPriceParity < Model.StatsB.RegionalPriceParity ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-scale-balanced",
                "BEA Price Index",
                $"{lower.Name} has the lower official price level",
                $"BEA Regional Price Parity is lower in {lower.Name} ({Math.Min(Model.StatsA.RegionalPriceParity.Value, Model.StatsB.RegionalPriceParity.Value):F1}) than in {higher.Name} ({Math.Max(Model.StatsA.RegionalPriceParity.Value, Model.StatsB.RegionalPriceParity.Value):F1}), which is why the same cash buys more there.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/regional-price-parity"));
        }

        if (Model.StatsA?.MedianHouseholdIncome != null && Model.StatsB?.MedianHouseholdIncome != null)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income Check",
                $"{higher.Name} has the higher median income",
                $"Purchasing power does not replace income. {higher.Name} has a median household income of ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0}, versus ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-emerald-100 via-green-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Living Costs",
                $"{cheaper.Name} also looks cheaper on the cost index",
                $"{cheaper.Name}'s cost-of-living index is {Math.Min(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1}, compared with {Math.Max(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} in the other state.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }
    }

    if (isCostPage)
    {
        var parts = new List<string>();

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            var pricier = cheaper == Model.StateA ? Model.StateB : Model.StateA;
            var diff = Math.Abs(Model.StatsA.CostOfLivingIndex.Value - Model.StatsB.CostOfLivingIndex.Value);
            parts.Add($"{cheaper.Name} is cheaper overall by {diff:F1} cost-of-living points");
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            parts.Add($"{Model.StateA.Name} has no state income tax");
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            parts.Add($"{Model.StateB.Name} has no state income tax");
        }

        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            parts.Add($"{lower.Name} has lower median home values");
        }

        if (parts.Any())
        {
            directAnswer = string.Join(", but ", new[] { parts.First() }.Concat(parts.Skip(1).Take(2)));
            directAnswer += ".";
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var lower = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            var diff = Math.Abs(Model.StatsA.CostOfLivingIndex.Value - Model.StatsB.CostOfLivingIndex.Value);
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Overall",
                $"{lower.Name} feels cheaper overall",
                $"{lower.Name} has the lower cost-of-living index, beating {higher.Name} by {diff:F1} points on the overall affordability baseline.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }

        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            var ratio = Math.Round((double)Math.Max(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value) / Math.Min(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value), 1);
            intentCards.Add((
                "fa-solid fa-house",
                "Housing",
                $"pay about {ratio:F1}x more for a home",
                $"{lower.Name} has the lower median home value, while buying in {higher.Name} costs materially more at the median.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/home-value"));
        }

        if (Model.StatsA?.RentToIncomeRatioPct().HasValue == true && Model.StatsB?.RentToIncomeRatioPct().HasValue == true)
        {
            var lower = Model.StatsA.RentToIncomeRatioPct() < Model.StatsB.RentToIncomeRatioPct() ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-key",
                "Rent Pressure",
                $"{lower.Name} puts less pressure on a median paycheck",
                $"Median rent takes a smaller share of household income in {lower.Name} than in {higher.Name}, which makes monthly budgeting easier.",
                "from-emerald-100 via-lime-50 to-white",
                "/compare/" + Model.PairSlug + "/rent-to-income"));
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{Model.StateA.Name} has no state income tax",
                $"{Model.StateA.Name} gives residents a cleaner paycheck-level tax advantage, while {Model.StateB.Name} still taxes income at the state level.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{Model.StateB.Name} has no state income tax",
                $"{Model.StateB.Name} gives residents a cleaner paycheck-level tax advantage, while {Model.StateA.Name} still taxes income at the state level.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }
        else if (Model.StatsA?.IncomeTaxRatePct != null && Model.StatsB?.IncomeTaxRatePct != null)
        {
            var lower = Model.StatsA.IncomeTaxRatePct < Model.StatsB.IncomeTaxRatePct ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-file-invoice-dollar",
                "Taxes",
                $"{lower.Name} keeps more income after state tax",
                $"{lower.Name} has the lower top state income tax rate, which softens the total cost picture even when prices are close.",
                "from-rose-100 via-pink-50 to-white",
                "/compare/" + Model.PairSlug + "/income-tax"));
        }

        if (Model.StatsA?.AverageTemperatureF != null && Model.StatsB?.AverageTemperatureF != null)
        {
            var warmer = Model.StatsA.AverageTemperatureF > Model.StatsB.AverageTemperatureF ? Model.StateA : Model.StateB;
            var cooler = warmer == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-temperature-half",
                "Climate",
                $"{warmer.Name} stays warmer overall",
                $"{warmer.Name} averages a warmer annual temperature than {cooler.Name}, which can materially change the day-to-day feel of living there.",
                "from-orange-100 via-amber-50 to-white",
                "/compare/" + Model.PairSlug + "/average-temperature"));
        }

        if (Model.StatsA?.SunnyDaysPerYear != null && Model.StatsB?.SunnyDaysPerYear != null)
        {
            var sunnier = Model.StatsA.SunnyDaysPerYear > Model.StatsB.SunnyDaysPerYear ? Model.StateA : Model.StateB;
            var cloudier = sunnier == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-cloud-sun",
                "Sunshine",
                $"{sunnier.Name} gets more bright days",
                $"{sunnier.Name} averages more sunny days per year than {cloudier.Name}, which often matters just as much as the raw cost numbers.",
                "from-yellow-100 via-amber-50 to-white",
                "/compare/" + Model.PairSlug + "/sunny-days"));
        }
    }

    var standoutPoints = new List<string>();
    if (isCostPage)
    {
        if (Model.StatsA?.MedianHomeValue != null && Model.StatsB?.MedianHomeValue != null)
        {
            var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has lower median home values.");
        }

        if (Model.StatsA?.IncomeTaxRatePct == 0 && Model.StatsB?.IncomeTaxRatePct != 0)
        {
            standoutPoints.Add($"{Model.StateA.Name} has no state income tax.");
        }
        else if (Model.StatsB?.IncomeTaxRatePct == 0 && Model.StatsA?.IncomeTaxRatePct != 0)
        {
            standoutPoints.Add($"{Model.StateB.Name} has no state income tax.");
        }

        if (Model.StatsA?.CostOfLivingIndex != null && Model.StatsB?.CostOfLivingIndex != null)
        {
            var lower = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower overall cost index.");
        }

        if (Model.StatsA?.MedianHouseholdIncome != null && Model.StatsB?.MedianHouseholdIncome != null)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }

        if (Model.StatsA?.HomeValueToIncomeRatio().HasValue == true && Model.StatsB?.HomeValueToIncomeRatio().HasValue == true)
        {
            var lower = Model.StatsA.HomeValueToIncomeRatio() < Model.StatsB.HomeValueToIncomeRatio() ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} looks more attainable on home value to income ratio.");
        }

        if (Model.StatsA?.RentToIncomeRatioPct().HasValue == true && Model.StatsB?.RentToIncomeRatioPct().HasValue == true)
        {
            var lower = Model.StatsA.RentToIncomeRatioPct() < Model.StatsB.RentToIncomeRatioPct() ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} puts less rent pressure on a median household income.");
        }
    }

    if (isLifePage)
    {
        if (Model.StatsA?.LifeExpectancyYears.HasValue == true && Model.StatsB?.LifeExpectancyYears.HasValue == true)
        {
            var longer = Model.StatsA.LifeExpectancyYears > Model.StatsB.LifeExpectancyYears ? Model.StateA : Model.StateB;
            var shorter = longer == Model.StateA ? Model.StateB : Model.StateA;
            var longerStats  = longer == Model.StateA ? Model.StatsA : Model.StatsB;
            var shorterStats = longer == Model.StateA ? Model.StatsB : Model.StatsA;
            var gap = Math.Abs(Model.StatsA.LifeExpectancyYears.Value - Model.StatsB.LifeExpectancyYears.Value);
            intentCards.Add((
                "fa-solid fa-heart-pulse",
                "Life Expectancy",
                $"{longer.Name} residents live {gap:F1} years longer on average",
                $"{longer.Name} has a life expectancy of {longerStats!.LifeExpectancyYears:F1} yrs vs {shorterStats!.LifeExpectancyYears:F1} yrs in {shorter.Name}, a meaningful gap for relocation planning.",
                "from-rose-100 via-pink-50 to-white",
                null));
        }

        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-hand-holding-dollar",
                "Poverty",
                $"{lower.Name} has a lower poverty rate",
                $"Poverty and health outcomes are closely linked. {lower.Name}'s lower poverty rate ({Math.Min(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%) versus {higher.Name} ({Math.Max(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%) is part of the longevity story.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/poverty-rate"));
        }

        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income",
                $"{higher.Name} has higher household income",
                $"Higher median income correlates with better healthcare access. {higher.Name} leads at ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} vs ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-emerald-100 via-green-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        if (Model.StatsA?.CostOfLivingIndex.HasValue == true && Model.StatsB?.CostOfLivingIndex.HasValue == true)
        {
            var cheaper = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
            intentCards.Add((
                "fa-solid fa-cart-shopping",
                "Affordability",
                $"{cheaper.Name} has a lower cost of living",
                $"Lower living costs mean more disposable income for healthcare. {cheaper.Name}'s cost-of-living index is {Math.Min(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} vs {Math.Max(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1} in the other state.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/cost-of-living"));
        }

        if (Model.StatsA?.LifeExpectancyYears.HasValue == true && Model.StatsB?.LifeExpectancyYears.HasValue == true)
        {
            var longer = Model.StatsA.LifeExpectancyYears > Model.StatsB.LifeExpectancyYears ? Model.StateA : Model.StateB;
            var shorter = longer == Model.StateA ? Model.StateB : Model.StateA;
            standoutPoints.Add($"{longer.Name} has the higher life expectancy at {Math.Max(Model.StatsA.LifeExpectancyYears.Value, Model.StatsB.LifeExpectancyYears.Value):F1} years.");
        }
        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower poverty rate.");
        }
        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }
    }

    if (isSafetyPage)
    {
        if (Model.StatsA?.ViolentCrimeRatePer100k.HasValue == true && Model.StatsB?.ViolentCrimeRatePer100k.HasValue == true)
        {
            var safer   = Model.StatsA.ViolentCrimeRatePer100k < Model.StatsB.ViolentCrimeRatePer100k ? Model.StateA : Model.StateB;
            var riskier = safer == Model.StateA ? Model.StateB : Model.StateA;
            var saferStats   = safer == Model.StateA ? Model.StatsA : Model.StatsB;
            var riskierStats = safer == Model.StateA ? Model.StatsB : Model.StatsA;
            var pctDiff = saferStats!.ViolentCrimeRatePer100k > 0
                ? Math.Round(Math.Abs(saferStats.ViolentCrimeRatePer100k.Value - riskierStats!.ViolentCrimeRatePer100k!.Value) / saferStats.ViolentCrimeRatePer100k.Value * 100, 0)
                : (double?)null;
            intentCards.Add((
                "fa-solid fa-shield-halved",
                "Violent Crime",
                pctDiff.HasValue ? $"{safer.Name} has {pctDiff:F0}% less violent crime" : $"{safer.Name} has a lower violent crime rate",
                $"{safer.Name} records {saferStats.ViolentCrimeRatePer100k:F1} violent incidents per 100k residents versus {riskierStats!.ViolentCrimeRatePer100k:F1} in {riskier.Name} (FBI UCR 2022).",
                "from-green-100 via-emerald-50 to-white",
                null));
        }

        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-hand-holding-dollar",
                "Poverty",
                $"{lower.Name} has a lower poverty rate",
                $"Economic stress and crime are closely tied. {lower.Name}'s poverty rate is {Math.Min(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}%, compared with {Math.Max(Model.StatsA.PovertyRatePct.Value, Model.StatsB.PovertyRatePct.Value):F1}% in {higher.Name}.",
                "from-amber-100 via-orange-50 to-white",
                "/compare/" + Model.PairSlug + "/poverty-rate"));
        }

        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-sack-dollar",
                "Income",
                $"{higher.Name} has higher household income",
                $"States with stronger median incomes tend to have lower crime rates. {higher.Name} leads at ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} vs ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
                "from-sky-100 via-cyan-50 to-white",
                "/compare/" + Model.PairSlug + "/median-income"));
        }

        var densityA = Model.StatsA?.PopulationDensity(Model.StateA.Population);
        var densityB = Model.StatsB?.PopulationDensity(Model.StateB.Population);
        if (densityA.HasValue && densityB.HasValue)
        {
            var denser  = densityA > densityB ? Model.StateA : Model.StateB;
            var sparser = denser == Model.StateA ? Model.StateB : Model.StateA;
            intentCards.Add((
                "fa-solid fa-city",
                "Population Density",
                $"{denser.Name} is more densely populated",
                $"Urban density often correlates with higher crime rates. {denser.Name} is more densely populated at {Math.Max(densityA.Value, densityB.Value):N1} per sq mi vs {Math.Min(densityA.Value, densityB.Value):N1} in {sparser.Name}.",
                "from-violet-100 via-fuchsia-50 to-white",
                "/compare/" + Model.PairSlug + "/density"));
        }

        if (Model.StatsA?.ViolentCrimeRatePer100k.HasValue == true && Model.StatsB?.ViolentCrimeRatePer100k.HasValue == true)
        {
            var safer = Model.StatsA.ViolentCrimeRatePer100k < Model.StatsB.ViolentCrimeRatePer100k ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{safer.Name} has the lower violent crime rate at {Math.Min(Model.StatsA.ViolentCrimeRatePer100k.Value, Model.StatsB.ViolentCrimeRatePer100k.Value):F1} per 100k.");
        }
        if (Model.StatsA?.PovertyRatePct.HasValue == true && Model.StatsB?.PovertyRatePct.HasValue == true)
        {
            var lower = Model.StatsA.PovertyRatePct < Model.StatsB.PovertyRatePct ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{lower.Name} has the lower poverty rate.");
        }
        if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
        {
            var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
            standoutPoints.Add($"{higher.Name} has the higher median household income.");
        }
    }

    ViewData["Title"] = ViewData["Title"] ?? $"{titleA} vs {titleB}: {Model.Metric.Name}";
}

<nav class="bg-gray-50 py-3 border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 flex-wrap gap-y-1">
            <li><a href="/" class="text-blue-700 hover:underline">Home</a></li>
            <li class="text-gray-400">/</li>
            <li><a href="/compare-states" class="text-blue-700 hover:underline">Compare States</a></li>
            <li class="text-gray-400">/</li>
            <li><a href="/compare/@Model.PairSlug" class="text-blue-700 hover:underline">@titleA vs @titleB</a></li>
            <li class="text-gray-400">/</li>
            <li class="font-semibold">@Model.Metric.Name</li>
