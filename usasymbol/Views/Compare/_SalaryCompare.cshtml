@model USASymbol.Models.ViewModels.StatePairComparisonViewModel
@using System.Globalization

@{
    if (Model.StatsA?.RegionalPriceParity is null || Model.StatsB?.RegionalPriceParity is null) { return; }

    var rppA   = Model.StatsA.RegionalPriceParity.Value;
    var rppB   = Model.StatsB.RegionalPriceParity.Value;
    var pp100A = Model.StatsA.PurchasingPower100 ?? Math.Round(100.0 * 100.0 / rppA, 2);
    var pp100B = Model.StatsB.PurchasingPower100 ?? Math.Round(100.0 * 100.0 / rppB, 2);
    var colA   = Model.StatsA.CostOfLivingIndex ?? rppA;
    var colB   = Model.StatsB.CostOfLivingIndex ?? rppB;
    var taxA   = Model.StatsA.IncomeTaxRatePct ?? 0.0;
    var taxB   = Model.StatsB.IncomeTaxRatePct ?? 0.0;
    var nameA  = Model.StateA.Name;
    var nameB  = Model.StateB.Name;

    string F2(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
    string F1(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
}

<section class="bg-gradient-to-br from-slate-50 to-white py-10 md:py-12 border-t border-slate-200" id="salary-calc">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="mb-6">
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-indigo-500 mb-1">Take-Home Calculator</p>
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900">What's Your Salary Really Worth?</h2>
            <p class="text-sm text-slate-500 mt-1.5">Enter your gross income to see real purchasing power and the cost-of-living equivalent in both states.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 shadow-sm bg-white p-6 md:p-8"
             id="sc-card"
             data-rpp-a="@F2(rppA)"
             data-rpp-b="@F2(rppB)"
             data-pp100-a="@F2(pp100A)"
             data-pp100-b="@F2(pp100B)"
             data-col-a="@F2(colA)"
             data-col-b="@F2(colB)"
             data-tax-a="@F2(taxA)"
             data-tax-b="@F2(taxB)"
             data-name-a="@nameA"
             data-name-b="@nameB">

            @* ── Salary input ── *@
            <div class="mb-8">
                <label for="sc-input" class="block text-sm font-semibold text-slate-700 mb-3">Annual Gross Salary</label>
                <div class="flex items-center gap-3">
                    <div class="relative w-56">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 font-semibold select-none">$</span>
                        <input type="number" id="sc-input" inputmode="numeric"
                               class="w-full pl-7 pr-3 py-3 rounded-xl border border-slate-300 text-lg font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400"
                               value="100000" min="10000" max="1000000" step="5000">
                    </div>
                    <span class="text-sm text-slate-400 hidden sm:block">or drag the slider</span>
                </div>
                <input type="range" id="sc-slider"
                       class="w-full mt-4 accent-indigo-600"
                       value="100000" min="10000" max="500000" step="5000">
                <div class="flex justify-between text-xs text-slate-400 mt-1 select-none">
                    <span>$10k</span><span>$250k</span><span>$500k</span>
                </div>
            </div>

            @* ── State cards ── *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">

                @* State A *@
                <div class="rounded-xl bg-blue-50 border border-blue-200 p-5">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-3 h-3 rounded-full bg-blue-600 shrink-0"></div>
                        <span class="font-bold text-blue-800">@nameA</span>
                    </div>
                    <dl class="space-y-2.5">
                        <div class="flex justify-between items-baseline gap-2">
                            <dt class="text-sm text-slate-500 shrink-0">Gross salary</dt>
                            <dd class="font-bold text-slate-900 tabular-nums" id="sc-gross-a">—</dd>
                        </div>
                        <div class="flex justify-between items-baseline gap-2">
                            <dt class="text-sm text-slate-500 shrink-0">
                                State income tax
                                @if (taxA == 0)
                                {
                                    <span class="text-xs text-emerald-600">(none)</span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">(top rate @F1(taxA)%)</span>
                                }
                            </dt>
                            <dd class="font-semibold text-rose-600 tabular-nums" id="sc-tax-a">—</dd>
                        </div>
                        <div class="border-t border-blue-200 pt-2.5 flex justify-between items-baseline gap-2">
                            <dt class="text-sm font-semibold text-slate-700">After state tax</dt>
                            <dd class="text-lg font-bold text-blue-700 tabular-nums" id="sc-takehome-a">—</dd>
                        </div>
                        <div class="flex justify-between items-baseline gap-2 pt-0.5">
                            <dt class="text-sm text-slate-500">Real buying power <span class="text-xs text-slate-400">(BEA RPP)</span></dt>
                            <dd class="font-semibold text-emerald-700 tabular-nums" id="sc-rpp-a">—</dd>
                        </div>
                    </dl>
                </div>

                @* State B *@
                <div class="rounded-xl bg-amber-50 border border-amber-200 p-5">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-3 h-3 rounded-full bg-amber-500 shrink-0"></div>
                        <span class="font-bold text-amber-800">@nameB</span>
                    </div>
                    <dl class="space-y-2.5">
                        <div class="flex justify-between items-baseline gap-2">
                            <dt class="text-sm text-slate-500 shrink-0">Gross salary</dt>
                            <dd class="font-bold text-slate-900 tabular-nums" id="sc-gross-b">—</dd>
                        </div>
                        <div class="flex justify-between items-baseline gap-2">
                            <dt class="text-sm text-slate-500 shrink-0">
                                State income tax
                                @if (taxB == 0)
                                {
                                    <span class="text-xs text-emerald-600">(none)</span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">(top rate @F1(taxB)%)</span>
                                }
                            </dt>
                            <dd class="font-semibold text-rose-600 tabular-nums" id="sc-tax-b">—</dd>
                        </div>
                        <div class="border-t border-amber-200 pt-2.5 flex justify-between items-baseline gap-2">
                            <dt class="text-sm font-semibold text-slate-700">After state tax</dt>
                            <dd class="text-lg font-bold text-amber-700 tabular-nums" id="sc-takehome-b">—</dd>
                        </div>
                        <div class="flex justify-between items-baseline gap-2 pt-0.5">
                            <dt class="text-sm text-slate-500">Real buying power <span class="text-xs text-slate-400">(BEA RPP)</span></dt>
                            <dd class="font-semibold text-emerald-700 tabular-nums" id="sc-rpp-b">—</dd>
                        </div>
                    </dl>
                </div>
            </div>

            @* ── COL equivalent insight ── *@
            <div class="rounded-xl bg-gradient-to-br from-emerald-50 via-teal-50 to-white border border-emerald-200 p-5">
                <div class="flex items-start gap-3">
                    <span class="w-9 h-9 rounded-xl bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-600 shrink-0 mt-0.5">
                        <i class="fa-solid fa-scale-balanced text-sm"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-emerald-800 mb-1">Cost-of-Living Equivalent</p>
                        <p class="text-sm text-slate-600 leading-relaxed" id="sc-col-insight">—</p>
                    </div>
                </div>
            </div>

            <p class="text-xs text-slate-400 mt-4 leading-relaxed">
                * "After state tax" uses the top marginal rate — actual effective rate is lower for most incomes.
                Real buying power uses BEA Regional Price Parity (@F1(rppA) for @nameA, @F1(rppB) for @nameB).
                COL equivalent uses the MERIC/C2ER composite index.
            </p>
        </div>
    </div>
</section>

<script>
(function () {
    var card = document.getElementById('sc-card');
    if (!card) return;

    var pp100A = parseFloat(card.dataset.pp100A);
    var pp100B = parseFloat(card.dataset.pp100B);
    var colA   = parseFloat(card.dataset.colA);
    var colB   = parseFloat(card.dataset.colB);
    var taxA   = parseFloat(card.dataset.taxA);
    var taxB   = parseFloat(card.dataset.taxB);
    var nameA  = card.dataset.nameA;
    var nameB  = card.dataset.nameB;

    var input  = document.getElementById('sc-input');
    var slider = document.getElementById('sc-slider');

    function usd(n) {
        return '$' + Math.round(n).toLocaleString('en-US');
    }

    function update(gross) {
        // State income tax at top marginal rate (worst-case / upper bound)
        var taxAmtA   = gross * (taxA / 100);
        var taxAmtB   = gross * (taxB / 100);
        var takeHomeA = gross - taxAmtA;
        var takeHomeB = gross - taxAmtB;

        // Real purchasing power: what this salary buys in local terms vs national average
        var realA = gross * (pp100A / 100);
        var realB = gross * (pp100B / 100);

        // COL equivalent: salary needed in B to match gross lifestyle in A
        var colEquivBforA = gross * (colB / colA);

        // Display
        document.getElementById('sc-gross-a').textContent    = usd(gross);
        document.getElementById('sc-gross-b').textContent    = usd(gross);
        document.getElementById('sc-tax-a').textContent      = taxA === 0 ? '$0' : '−' + usd(taxAmtA);
        document.getElementById('sc-tax-b').textContent      = taxB === 0 ? '$0' : '−' + usd(taxAmtB);
        document.getElementById('sc-takehome-a').textContent = usd(takeHomeA);
        document.getElementById('sc-takehome-b').textContent = usd(takeHomeB);
        document.getElementById('sc-rpp-a').textContent      = usd(realA);
        document.getElementById('sc-rpp-b').textContent      = usd(realB);

        // COL insight
        var diff = Math.abs(colEquivBforA - gross);
        var insight;
        if (colEquivBforA < gross - 500) {
            insight = 'To match your ' + usd(gross) + ' lifestyle from ' + nameA +
                ', you’d only need ' + usd(colEquivBforA) + ' in ' + nameB +
                ' — saving about ' + usd(diff) + ' per year in cost of living.';
        } else if (colEquivBforA > gross + 500) {
            insight = 'To match your ' + usd(gross) + ' lifestyle from ' + nameA +
                ', you’d need ' + usd(colEquivBforA) + ' in ' + nameB +
                ' — about ' + usd(diff) + ' more per year.';
        } else {
            insight = nameA + ' and ' + nameB + ' have nearly identical cost-of-living levels, so your ' +
                usd(gross) + ' goes about the same distance in both states.';
        }
        document.getElementById('sc-col-insight').textContent = insight;
    }

    input.addEventListener('input', function () {
        var val = Math.max(10000, Math.min(1000000, parseInt(this.value, 10) || 100000));
        slider.value = Math.min(val, 500000);
        update(val);
    });

    slider.addEventListener('input', function () {
        var val = parseInt(this.value, 10);
        input.value = val;
        update(val);
    });

    update(100000);
}());
</script>
