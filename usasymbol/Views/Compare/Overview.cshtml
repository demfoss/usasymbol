}

@{
    // Tab definitions
    // General tab: curated cross-category snapshot
    var generalSlugs = new[] {
        "capital", "political-lean", "population", "median-income",
        "cost-of-living", "home-value", "property-tax", "income-tax",
        "minimum-wage", "gas-price", "electricity-rates", "livability-score",
        "average-temperature", "sunny-days", "land-area", "density", "statehood"
    };
    var generalResults = generalSlugs
        .Select(s => Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == s))
        .Where(r => r != null)
        .Cast<MetricComparisonResult>()
        .ToList();

    // Group icon map
    var groupIconMap = new Dictionary<string, string> {
        ["demographics"]    = "fa-solid fa-people-group",
        ["economy"]         = "fa-solid fa-dollar-sign",
        ["income"]          = "fa-solid fa-dollar-sign",
        ["jobs"]            = "fa-solid fa-briefcase",
        ["quality-of-life"] = "fa-solid fa-heart-pulse",
        ["housing"]         = "fa-solid fa-house",
        ["taxes"]           = "fa-solid fa-file-invoice-dollar",
        ["politics"]        = "fa-solid fa-landmark-dome",
        ["laws"]            = "fa-solid fa-scale-balanced",
        ["geography"]       = "fa-solid fa-map",
        ["climate"]         = "fa-solid fa-cloud-sun",
        ["safety"]          = "fa-solid fa-shield-halved",
        ["health"]          = "fa-solid fa-stethoscope",
        ["labor"]           = "fa-solid fa-briefcase",
    };

    // Build tab list: tuples (Id, Label, Icon, Results, LeaderSlug)
    var cmpTabs = new List<(string Id, string Label, string Icon, List<MetricComparisonResult> Results, string? LeaderSlug)>();
    if (generalResults.Any())
    {
        var gA = generalResults.Count(r => r.WinnerSlug == Model.StateA.Slug);
        var gB = generalResults.Count(r => r.WinnerSlug == Model.StateB.Slug);
        cmpTabs.Add(("tab-general", "General", "fa-solid fa-table-list", generalResults,
            gA > gB ? Model.StateA.Slug : gB > gA ? Model.StateB.Slug : null));
    }

    var tabOrder = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
    {
        ["tab-general"] = 0,
        ["tab-demographics"] = 1,
        ["tab-income"] = 2,
        ["tab-jobs"] = 3,
        ["tab-quality-of-life"] = 4,
        ["tab-climate"] = 5,
        ["tab-housing"] = 6,
        ["tab-taxes"] = 7,
        ["tab-politics"] = 8,
        ["tab-laws"] = 9,
        ["tab-geography"] = 10,
        ["tab-health"] = 11,
        ["tab-safety"] = 12,
    };

    foreach (var grp in metricGroups)
    {
        var rows = grp.ToList();
        var grpA = rows.Count(r => r.WinnerSlug == Model.StateA.Slug);
        var grpB = rows.Count(r => r.WinnerSlug == Model.StateB.Slug);
        var ico  = groupIconMap.TryGetValue(grp.Key.GroupSlug, out var gi) ? gi : "fa-solid fa-chart-bar";
        cmpTabs.Add((
            $"tab-{grp.Key.GroupSlug}",
            grp.Key.GroupName,
            ico,
            rows,
            grpA > grpB ? Model.StateA.Slug : grpB > grpA ? Model.StateB.Slug : null
        ));
    }

    cmpTabs = cmpTabs
        .OrderBy(t => tabOrder.TryGetValue(t.Id, out var order) ? order : 999)
        .ThenBy(t => t.Label)
        .ToList();

}

<section class="bg-white py-10 md:py-12 border-t" id="comparison-table">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="mb-6">
            <h2 class="text-2xl font-bold text-slate-900">Full Comparison</h2>
            <p class="text-sm text-slate-500 mt-1">Pick a category to focus on. General shows the most important facts at a glance.</p>
        </div>

        @* Tab bar (horizontal scroll on mobile) *@
        <div class="relative mb-6">
            <button type="button"
                    id="cmp-tab-scroll-left"
                    aria-label="Scroll categories left"
                    class="hidden lg:flex absolute left-0 top-1/2 -translate-y-1/2 z-10 h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-600 shadow-sm transition hover:border-blue-300 hover:text-blue-700 disabled:pointer-events-none disabled:opacity-40">
                <i class="fa-solid fa-chevron-left text-xs"></i>
            </button>
            <div id="cmp-tab-bar"
                 class="flex gap-2 overflow-x-auto pb-1 lg:px-12"
                 style="-ms-overflow-style:none;scrollbar-width:none">
                @for (int ti = 0; ti < cmpTabs.Count; ti++)
                {
                    var tab    = cmpTabs[ti];
                    var isFirst = ti == 0;
                    var leader  = tab.LeaderSlug != null
                        ? (tab.LeaderSlug == Model.StateA.Slug ? Model.StateA : Model.StateB)
                        : null;
                    <button type="button"
                            data-tab="@tab.Id"
                            class="cmp-tab-btn flex-none inline-flex items-center gap-2 rounded-2xl border px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition-all
                                   @(isFirst ? "bg-slate-900 text-white border-slate-900 shadow-sm" : "bg-white text-slate-600 border-slate-200 hover:border-blue-300 hover:text-blue-700")">
                        <i class="@tab.Icon text-xs @(isFirst ? "text-blue-300" : "text-slate-400")"></i>
                        @tab.Label
                        @if (leader != null)
                        {
                            <img src="@Images.Thumb(leader.FlagImageUrl)" alt="@leader.Name flag" class="w-5 h-3.5 object-cover rounded shrink-0 @(isFirst ? "" : "opacity-70")" onerror="this.style.display='none'" />
                        }
                    </button>
                }
            </div>
            <button type="button"
                    id="cmp-tab-scroll-right"
                    aria-label="Scroll categories right"
                    class="hidden lg:flex absolute right-0 top-1/2 -translate-y-1/2 z-10 h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-600 shadow-sm transition hover:border-blue-300 hover:text-blue-700 disabled:pointer-events-none disabled:opacity-40">
                <i class="fa-solid fa-chevron-right text-xs"></i>
            </button>
            @* Mobile right-fade gradient hint *@
            <div class="pointer-events-none absolute right-0 top-0 bottom-1 w-10 bg-gradient-to-l from-white to-transparent sm:hidden"></div>
        </div>

        @* Tab panels *@
        @for (int ti = 0; ti < cmpTabs.Count; ti++)
        {
            var tab    = cmpTabs[ti];
            var isFirst = ti == 0;
            <div id="@tab.Id" class="cmp-tab-panel @(isFirst ? "" : "hidden")">
                <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200">
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 w-2/5">Metric</th>
                                <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                                    <span class="inline-flex items-center gap-1.5">
                                        <img src="@Images.Thumb(Model.StateA.FlagImageUrl)" alt="@Model.StateA.Name flag" class="w-6 h-4 object-cover rounded shrink-0" onerror="this.style.display='none'" />
                                        @Model.StateA.Abbreviation
                                    </span>
                                </th>
                                <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                                    <span class="inline-flex items-center gap-1.5">
                                        <img src="@Images.Thumb(Model.StateB.FlagImageUrl)" alt="@Model.StateB.Name flag" class="w-6 h-4 object-cover rounded shrink-0" onerror="this.style.display='none'" />
                                        @Model.StateB.Abbreviation
                                    </span>
                                </th>
                                <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500 hidden sm:table-cell w-24">Deep dive</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var result in tab.Results)
                            {
                                var winA = result.WinnerSlug == Model.StateA.Slug;
                                var winB = result.WinnerSlug == Model.StateB.Slug;
                                double? rBarA = null, rBarB = null;
                                if (result.NumericA.HasValue && result.NumericB.HasValue)
                                {
                                    var mx = Math.Max(result.NumericA.Value, result.NumericB.Value);
                                    if (mx > 0)
                                    {
                                        rBarA = Math.Round(result.NumericA.Value / mx * 100, 1);
                                        rBarB = Math.Round(result.NumericB.Value / mx * 100, 1);
                                    }
                                }
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    <td class="px-4 py-3.5">
                                        <div class="flex items-center gap-2.5">
                                            <span class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center shrink-0">
                                                <i class="@result.Metric.Icon text-blue-600 text-[11px]"></i>
                                            </span>
                                            <div>
                                                <div class="font-medium text-slate-800 leading-tight">@result.Metric.Name</div>
                                                <div class="text-xs text-slate-400 hidden sm:block">@result.Metric.Description</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3.5 text-center">
                                        <span class="@(winA ? "font-bold text-emerald-700" : "text-slate-600")">@(result.DisplayValueA ?? "-")</span>
                                        @if (winA) { <i class="fa-solid fa-trophy text-yellow-400 ml-1 text-[10px]"></i> }
                                        @if (rBarA.HasValue)
                                        {
                                            <div class="mt-1.5 h-1.5 rounded-full bg-slate-100 overflow-hidden mx-auto max-w-16">
                                                <div class="h-full rounded-full @(winA ? "bg-emerald-400" : "bg-slate-300")"
                                                     style="width:@rBarA.Value.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3.5 text-center">
                                        <span class="@(winB ? "font-bold text-emerald-700" : "text-slate-600")">@(result.DisplayValueB ?? "-")</span>
                                        @if (winB) { <i class="fa-solid fa-trophy text-yellow-400 ml-1 text-[10px]"></i> }
                                        @if (rBarB.HasValue)
                                        {
                                            <div class="mt-1.5 h-1.5 rounded-full bg-slate-100 overflow-hidden mx-auto max-w-16">
                                                <div class="h-full rounded-full @(winB ? "bg-emerald-400" : "bg-slate-300")"
                                                     style="width:@rBarB.Value.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3.5 text-center hidden sm:table-cell">
                                        <a href="/compare/@Model.PairSlug/@result.Metric.Slug"
                                           class="text-blue-500 hover:text-blue-700 text-xs font-medium hover:underline">
                                            Details ->
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Mobile: show Details links as chips below table *@
                <div class="mt-3 flex flex-wrap gap-2 sm:hidden">
                    @foreach (var result in tab.Results.Where(r => r.Metric.Type == USASymbol.Models.MetricType.Numeric))
                    {
                        <a href="/compare/@Model.PairSlug/@result.Metric.Slug"
                           class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 hover:border-blue-300 hover:text-blue-700 transition">
                            <i class="@result.Metric.Icon text-slate-400 text-[10px]"></i>
                            @result.Metric.Name ->
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<script>
    (function () {
        var btns   = Array.from(document.querySelectorAll('.cmp-tab-btn'));
        var panels = Array.from(document.querySelectorAll('.cmp-tab-panel'));
        var tabBar = document.getElementById('cmp-tab-bar');
        var scrollLeftBtn = document.getElementById('cmp-tab-scroll-left');
        var scrollRightBtn = document.getElementById('cmp-tab-scroll-right');

        function updateScrollButtons() {
            if (!tabBar || !scrollLeftBtn || !scrollRightBtn) return;

            var maxScroll = tabBar.scrollWidth - tabBar.clientWidth;
            scrollLeftBtn.disabled = tabBar.scrollLeft <= 4;
            scrollRightBtn.disabled = maxScroll <= 0 || tabBar.scrollLeft >= maxScroll - 4;
        }

        function scrollTabs(direction) {
            if (!tabBar) return;
            tabBar.scrollBy({ left: direction * 240, behavior: 'smooth' });
        }

        btns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = btn.getAttribute('data-tab');

                // Deactivate all
                btns.forEach(function (b) {
                    b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-sm');
                    b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
                    b.querySelector('i')?.classList.replace('text-blue-300', 'text-slate-400');
                });
                panels.forEach(function (p) { p.classList.add('hidden'); });

                // Activate clicked
                btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-sm');
                btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
                btn.querySelector('i')?.classList.replace('text-slate-400', 'text-blue-300');
                var panel = document.getElementById(target);
                if (panel) panel.classList.remove('hidden');

                // Keep selected tab visible
                btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            });
        });

        scrollLeftBtn?.addEventListener('click', function () { scrollTabs(-1); });
        scrollRightBtn?.addEventListener('click', function () { scrollTabs(1); });
        tabBar?.addEventListener('scroll', updateScrollButtons, { passive: true });
        window.addEventListener('resize', updateScrollButtons);
        updateScrollButtons();
    })();
</script>

@{
    // "Best for..." cards - each only generated when the required metric(s) exist
    var bestForCards = new List<(string Category, string Icon, string Label, string Title, string Body, string Tone, string? Link)>();

    // Helper: pick winner/loser for a metric result
    (State winner, State loser, string winVal, string loseVal) WinnerOf(MetricComparisonResult r) {
        bool aWins = r.WinnerSlug == Model.StateA.Slug;
        return (
            aWins ? Model.StateA : Model.StateB,
            aWins ? Model.StateB : Model.StateA,
            (aWins ? r.DisplayValueA : r.DisplayValueB) ?? "-",
            (aWins ? r.DisplayValueB : r.DisplayValueA) ?? "-"
        );
    }

    // 1. Best value / saving money - needs cost-of-living with a winner
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "cost-of-living");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Affordability",
                "fa-solid fa-piggy-bank", "Saving Money",
                $"{w.Name} is cheaper overall",
                $"Overall cost-of-living index: {wv} vs {lv} in {l.Name}. On a national baseline of 100, the lower score usually means cheaper day-to-day expenses.",
                "from-amber-100 via-orange-50 to-white",
                $"/compare/{Model.PairSlug}/cost-of-living"
            ));
        }
    }

    // 2. Better for drivers / daily commuting - cheaper gas
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "gas-price");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Affordability",
                "fa-solid fa-gas-pump", "Gas Price",
                $"{w.Name} is cheaper at the pump",
                $"Average regular gas price: {wv} in {w.Name} vs {lv} in {l.Name}. Lower pump prices can cut everyday driving costs.",
                "from-yellow-100 via-amber-50 to-white",
                $"/compare/{Model.PairSlug}/gas-price"
            ));
        }
    }

    // 3. Higher minimum wage for entry-level work
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "minimum-wage");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Jobs",
                "fa-solid fa-wallet", "Minimum Wage",
                $"{w.Name} has the higher minimum wage",
                $"State minimum wage: {wv} in {w.Name} vs {lv} in {l.Name}. That matters most for hourly, entry-level, and part-time workers.",
                "from-green-100 via-emerald-50 to-white",
                $"/compare/{Model.PairSlug}/minimum-wage"
            ));
        }
    }

    // 4. Lower residential electricity bills
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "electricity-rates");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Affordability",
                "fa-solid fa-bolt", "Electricity Rates",
                $"{w.Name} has cheaper electricity",
                $"Average residential electricity rate: {wv} in {w.Name} vs {lv} in {l.Name}. Lower cents-per-kWh pricing can help keep utility bills down.",
                "from-amber-100 via-yellow-50 to-white",
                $"/compare/{Model.PairSlug}/electricity-rates"
            ));
        }
    }

    // 5. Better for homebuyers - needs home-value-to-income ratio
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "home-value-to-income");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Housing",
                "fa-solid fa-house", "Buying a Home",
                $"{w.Name} is more attainable for buyers",
                $"Home-value-to-income ratio: {wv} in {w.Name} vs {lv} in {l.Name}. A lower ratio means the median home is easier to afford on a median income.",
                "from-sky-100 via-cyan-50 to-white",
                $"/compare/{Model.PairSlug}/home-value-to-income"
            ));
        }
    }

    // 6. Better for renters - needs rent-to-income
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "rent-to-income");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Housing",
                "fa-solid fa-key", "Renting",
                $"{w.Name} is easier for renters",
                $"Rent-to-income ratio: {wv} in {w.Name} vs {lv} in {l.Name}. A lower percentage means rent takes a smaller bite out of a typical household budget.",
                "from-violet-100 via-purple-50 to-white",
                $"/compare/{Model.PairSlug}/rent-to-income"
            ));
        }
    }

    // 7. Lower property tax burden for homeowners
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "property-tax");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Housing",
                "fa-solid fa-house-circle-check", "Property Tax",
                $"{w.Name} has lower property taxes",
                $"Effective property tax rate: {wv} in {w.Name} vs {lv} in {l.Name}. A lower rate usually means a smaller yearly tax bill relative to home value.",
                "from-emerald-100 via-teal-50 to-white",
                $"/compare/{Model.PairSlug}/property-tax"
            ));
        }
    }

    // 8. Core battleground politics
    if (Model.StatsA?.SwingStateStatus == "Battleground" && Model.StatsB?.SwingStateStatus != "Battleground")
    {
        bestForCards.Add((
            "Politics",
            "fa-solid fa-map-location-dot", "Battleground Politics",
            $"{Model.StateA.Name} is a swing state",
            $"{Model.StateA.Name} was one of the core 2024 battleground states, while {Model.StateB.Name} was not. That usually means tighter races and more campaign attention.",
            "from-indigo-100 via-blue-50 to-white",
            $"/compare/{Model.PairSlug}/swing-state"
        ));
    }
    else if (Model.StatsB?.SwingStateStatus == "Battleground" && Model.StatsA?.SwingStateStatus != "Battleground")
    {
        bestForCards.Add((
            "Politics",
            "fa-solid fa-map-location-dot", "Battleground Politics",
            $"{Model.StateB.Name} is a swing state",
            $"{Model.StateB.Name} was one of the core 2024 battleground states, while {Model.StateA.Name} was not. That usually means tighter races and more campaign attention.",
            "from-indigo-100 via-blue-50 to-white",
            $"/compare/{Model.PairSlug}/swing-state"
        ));
    }

    // 8. Presidential lean / bluer statewide vote
    if (Model.StatsA?.PresidentialVotingMarginPct.HasValue == true && Model.StatsB?.PresidentialVotingMarginPct.HasValue == true
        && Model.StatsA.PresidentialVotingMarginPct.Value != Model.StatsB.PresidentialVotingMarginPct.Value)
    {
        var bluer = Model.StatsA.PresidentialVotingMarginPct > Model.StatsB.PresidentialVotingMarginPct ? Model.StateA : Model.StateB;
        var redder = bluer == Model.StateA ? Model.StateB : Model.StateA;
        var bluerStats = bluer == Model.StateA ? Model.StatsA : Model.StatsB;
        var redderStats = bluer == Model.StateA ? Model.StatsB : Model.StatsA;
        bestForCards.Add((
            "Politics",
            "fa-solid fa-check-to-slot", "State Color",
            $"{bluer.Name} votes bluer",
            $"2024 presidential margin: {FormatPoliticalMargin(bluerStats!.PresidentialVotingMarginPct)} in {bluer.Name} vs {FormatPoliticalMargin(redderStats!.PresidentialVotingMarginPct)} in {redder.Name}.",
            "from-blue-100 via-slate-50 to-white",
            $"/compare/{Model.PairSlug}/presidential-voting-margin"
        ));
    }

    // 9. Faster one-party lawmaking when only one state has a trifecta
    if (!string.IsNullOrWhiteSpace(Model.StatsA?.Trifecta) && !string.IsNullOrWhiteSpace(Model.StatsB?.Trifecta))
    {
        if (Model.StatsA!.Trifecta != "No Trifecta" && Model.StatsB!.Trifecta == "No Trifecta")
        {
            bestForCards.Add((
                "Politics",
                "fa-solid fa-sitemap", "Government Control",
                $"{Model.StateA.Name} has a trifecta",
                $"{Model.StateA.Name} currently has {Model.StatsA.Trifecta.ToLowerInvariant()}, while {Model.StateB.Name} does not. That usually means state laws can move faster in {Model.StateA.Name}.",
                "from-red-100 via-orange-50 to-white",
                $"/compare/{Model.PairSlug}/trifecta"
            ));
        }
        else if (Model.StatsB!.Trifecta != "No Trifecta" && Model.StatsA!.Trifecta == "No Trifecta")
        {
            bestForCards.Add((
                "Politics",
                "fa-solid fa-sitemap", "Government Control",
                $"{Model.StateB.Name} has a trifecta",
                $"{Model.StateB.Name} currently has {Model.StatsB.Trifecta.ToLowerInvariant()}, while {Model.StateA.Name} does not. That usually means state laws can move faster in {Model.StateB.Name}.",
                "from-red-100 via-orange-50 to-white",
                $"/compare/{Model.PairSlug}/trifecta"
            ));
        }
    }

    // 10. Simpler gun-law contrast when states land on opposite sides
    if (!string.IsNullOrWhiteSpace(Model.StatsA?.GunLawsStatus) && !string.IsNullOrWhiteSpace(Model.StatsB?.GunLawsStatus)
        && Model.StatsA!.GunLawsStatus != Model.StatsB!.GunLawsStatus)
    {
        var restrictive = Model.StatsA.GunLawsStatus == "Restrictive" ? Model.StateA : Model.StateB;
        var permissive = restrictive == Model.StateA ? Model.StateB : Model.StateA;
        bestForCards.Add((
            "Laws",
            "fa-solid fa-gun", "Gun Laws",
            $"{restrictive.Name} has stricter gun laws",
            $"{restrictive.Name} falls into the restrictive category, while {permissive.Name} falls into the permissive category on this simplified statewide comparison.",
            "from-slate-200 via-slate-50 to-white",
            $"/compare/{Model.PairSlug}/gun-laws-status"
        ));
    }

    // 11. Alcohol control vs license-state model
    if (!string.IsNullOrWhiteSpace(Model.StatsA?.AlcoholLawsStatus) && !string.IsNullOrWhiteSpace(Model.StatsB?.AlcoholLawsStatus)
        && Model.StatsA!.AlcoholLawsStatus != Model.StatsB!.AlcoholLawsStatus)
    {
        var controlState = Model.StatsA.AlcoholLawsStatus == "Control State" ? Model.StateA : Model.StateB;
        var licenseState = controlState == Model.StateA ? Model.StateB : Model.StateA;
        bestForCards.Add((
            "Laws",
            "fa-solid fa-wine-bottle", "Alcohol Laws",
            $"{controlState.Name} uses a control-state system",
            $"{controlState.Name} uses a control-state system for liquor sales, while {licenseState.Name} uses a license-state system.",
            "from-rose-100 via-orange-50 to-white",
            $"/compare/{Model.PairSlug}/alcohol-laws"
        ));
    }

    // 12. Broader marijuana legalization
    if (!string.IsNullOrWhiteSpace(Model.StatsA?.MarijuanaLegalizationStatus) && !string.IsNullOrWhiteSpace(Model.StatsB?.MarijuanaLegalizationStatus))
    {
        int Rank(string? value) => value switch
        {
            "Legal" => 2,
            "Medical" => 1,
            "Illegal" => 0,
            _ => -1
        };

        var rankA = Rank(Model.StatsA!.MarijuanaLegalizationStatus);
        var rankB = Rank(Model.StatsB!.MarijuanaLegalizationStatus);
        if (rankA >= 0 && rankB >= 0 && rankA != rankB)
        {
            var broader = rankA > rankB ? Model.StateA : Model.StateB;
            var narrower = broader == Model.StateA ? Model.StateB : Model.StateA;
            var broaderStatus = broader == Model.StateA ? Model.StatsA.MarijuanaLegalizationStatus : Model.StatsB.MarijuanaLegalizationStatus;
            var narrowerStatus = broader == Model.StateA ? Model.StatsB.MarijuanaLegalizationStatus : Model.StatsA.MarijuanaLegalizationStatus;
            bestForCards.Add((
                "Laws",
                "fa-solid fa-cannabis", "Marijuana Legalization",
                $"{broader.Name} has broader marijuana access",
                $"{broader.Name} currently rates as {broaderStatus}, while {narrower.Name} rates as {narrowerStatus} under statewide marijuana law.",
                "from-green-100 via-lime-50 to-white",
                $"/compare/{Model.PairSlug}/marijuana-legalization"
            ));
        }
    }

    // 13. Keep more of your paycheck - needs income-tax with a winner
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "income-tax");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            var noTax = (r.WinnerSlug == Model.StateA.Slug ? r.NumericA : r.NumericB) == 0;
            bestForCards.Add((
                "Taxes",
                "fa-solid fa-file-invoice-dollar", "Lower Taxes",
                noTax ? $"{w.Name} has no state income tax" : $"{w.Name} has lower income taxes",
                noTax
                    ? $"{w.Name} charges no state income tax. {l.Name} levies up to {lv} at the top marginal rate."
                    : $"Top state income tax rate: {wv} in {w.Name} vs {lv} in {l.Name}.",
                "from-rose-100 via-pink-50 to-white",
                $"/compare/{Model.PairSlug}/income-tax"
            ));
        }
    }

    // 14. More space / lower density - needs density with a winner
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "density");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue && r.NumericA.Value != r.NumericB.Value)
        {
            // Lower density = winner (more space)
            bool aLower  = r.NumericA.Value < r.NumericB.Value;
            var  sparser = aLower ? Model.StateA : Model.StateB;
            var  denser  = aLower ? Model.StateB : Model.StateA;
            var  sparseV = aLower ? r.DisplayValueA : r.DisplayValueB;
            var  denseV  = aLower ? r.DisplayValueB : r.DisplayValueA;
            bestForCards.Add((
                "Lifestyle",
                "fa-solid fa-tree-city", "More Space",
                $"{sparser.Name} feels less crowded",
                $"Population density: {sparseV ?? "-"} in {sparser.Name} vs {denseV ?? "-"} in {denser.Name}. Lower density usually means more space and less day-to-day congestion.",
                "from-teal-100 via-emerald-50 to-white",
                $"/compare/{Model.PairSlug}/density"
            ));
        }
    }

    // 15. Shorter commute - needs commute-time with a winner
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "commute-time");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Lifestyle",
                "fa-solid fa-road", "Shorter Commute",
                $"{w.Name} has the shorter commute",
                $"Average commute: {wv} in {w.Name} vs {lv} in {l.Name}.",
                "from-indigo-100 via-blue-50 to-white",
                $"/compare/{Model.PairSlug}/commute-time"
            ));
        }
    }

    {
        var unemployment = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "unemployment-rate");
        var jobGrowth = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "job-growth");
        if (unemployment?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(unemployment);
            var growthWinner = jobGrowth?.WinnerSlug == w.Slug;
            var growthLead = growthWinner
                ? $" {w.Name} also leads on job growth."
                : string.Empty;
            bestForCards.Add((
                "Jobs",
                "fa-solid fa-briefcase", "Job Opportunities",
                $"{w.Name} looks better for job seekers",
                $"Unemployment rate: {wv} in {w.Name} vs {lv} in {l.Name}.{growthLead}",
                "from-green-100 via-lime-50 to-white",
                $"/compare/{Model.PairSlug}/unemployment-rate"
            ));
        }
    }

    {
        var livability = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "livability-score");
        var commute = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "commute-time");
        if (livability?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(livability);
            var commuteTail = commute?.WinnerSlug == w.Slug
                ? $" {w.Name} also has the shorter average commute."
                : string.Empty;
            bestForCards.Add((
                "Remote Work",
                "fa-solid fa-laptop-house", "Remote Workers",
                $"{w.Name} looks better for remote workers",
                $"Livability score: {wv} in {w.Name} vs {lv} in {l.Name}.{commuteTail}",
                "from-cyan-100 via-sky-50 to-white",
                $"/compare/{Model.PairSlug}/livability-score"
            ));
        }
    }

    {
        var familySignals = new[]
        {
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "violent-crime"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "life-expectancy"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "uninsured-rate"),
            Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "college-educated")
        }
        .Where(x => x?.WinnerSlug != null)
        .Cast<MetricComparisonResult>()
        .ToList();

        if (familySignals.Count >= 2)
        {
            var familyWinsA = familySignals.Count(x => x.WinnerSlug == Model.StateA.Slug);
            var familyWinsB = familySignals.Count(x => x.WinnerSlug == Model.StateB.Slug);
            if (familyWinsA != familyWinsB)
            {
                var winner = familyWinsA > familyWinsB ? Model.StateA : Model.StateB;
                var loser = winner == Model.StateA ? Model.StateB : Model.StateA;
                var winningLabels = familySignals
                    .Where(x => x.WinnerSlug == winner.Slug)
                    .Select(x => x.Metric.Name.ToLowerInvariant())
                    .Take(3)
                    .ToList();

                bestForCards.Add((
                    "Families",
                    "fa-solid fa-people-roof", "Families",
                    $"{winner.Name} looks better for families",
                    $"{winner.Name} wins more family-oriented signals in this matchup, including {string.Join(", ", winningLabels)} compared with {loser.Name}.",
                    "from-fuchsia-100 via-pink-50 to-white",
                    $"/compare/{Model.PairSlug}/violent-crime"
                ));
            }
        }
    }

    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "average-temperature");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Climate",
                "fa-solid fa-temperature-half", "Warmer Climate",
                $"{w.Name} is warmer overall",
                $"Average annual temperature: {wv} in {w.Name} vs {lv} in {l.Name}.",
                "from-orange-100 via-amber-50 to-white",
                $"/compare/{Model.PairSlug}/average-temperature"
            ));
        }
    }

    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "sunny-days");
        if (r?.WinnerSlug != null)
        {
            var (w, l, wv, lv) = WinnerOf(r);
            bestForCards.Add((
                "Climate",
                "fa-solid fa-cloud-sun", "More Sunshine",
                $"{w.Name} gets more sun",
                $"Sunny days per year: {wv} in {w.Name} vs {lv} in {l.Name}.",
                "from-yellow-100 via-amber-50 to-white",
                $"/compare/{Model.PairSlug}/sunny-days"
            ));
        }
    }
}

@if (bestForCards.Any())
{
    var intentChips = new[] { "All" }.Concat(bestForCards.Select(card => card.Category).Distinct()).ToList();
    <section class="bg-[radial-gradient(circle_at_top_right,rgba(96,165,250,0.12),transparent_40%),linear-gradient(180deg,#f8fbff_0%,#fff_100%)] py-12 border-t">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700 mb-2">Intent-Oriented</p>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Which state fits your priorities better?</h2>
                <p class="text-sm text-slate-500 mt-1.5">Use these cards as decision shortcuts for common goals like saving money, buying a home, finding better weather, or optimizing for work and family life.</p>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
                @foreach (var chip in intentChips)
                {
                    var isAll = chip == "All";
                    <button type="button"
                            class="intent-chip inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition @(isAll ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-700 border-slate-300 hover:border-blue-300 hover:text-blue-700")"
                            data-intent-filter="@chip">
                        @chip
                    </button>
                }
            </div>

            <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var card in bestForCards)
                {
                    <article class="intent-card rounded-[1.6rem] border border-white/80 bg-gradient-to-br @card.Tone p-5 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition"
                             data-intent-category="@card.Category">
                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-10 h-10 rounded-xl bg-white/80 border border-white shadow-sm flex items-center justify-center shrink-0">
                                <i class="@card.Icon text-slate-700 text-sm"></i>
                            </span>
                            <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">@card.Label</span>
                        </div>
                        <h3 class="text-lg font-extrabold text-slate-900 leading-tight mb-2">@card.Title</h3>
                        <p class="text-sm leading-6 text-slate-600 mb-3">@card.Body</p>
                        @if (!string.IsNullOrWhiteSpace(card.Link))
                        {
                            <a href="@card.Link" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900">
                                See full data <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </a>
                        }
                    </article>
                }
            </div>
        </div>
    </section>

    <script>
        (function () {
            var chips = Array.from(document.querySelectorAll('.intent-chip'));
            var cards = Array.from(document.querySelectorAll('.intent-card'));

            if (!chips.length || !cards.length) return;

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    var filter = chip.getAttribute('data-intent-filter');

                    chips.forEach(function (btn) {
                        btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
                        btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
                    });

                    chip.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
                    chip.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');

                    cards.forEach(function (card) {
                        var category = card.getAttribute('data-intent-category');
                        var show = filter === 'All' || category === filter;
                        card.classList.toggle('hidden', !show);
                    });
                });
            });
        })();
    </script>
}

<section class="bg-gray-50 py-12 border-t">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Detailed Metric Pages</h2>
                <p class="text-sm text-gray-600">Grouped tabs keep the deep-dive links tighter and easier to scan.</p>
            </div>
        </div>

        <div class="flex flex-wrap gap-3 mb-6">
            @foreach (var group in Model.AllMetrics.GroupBy(m => new { m.GroupSlug, m.GroupName, m.GroupOrder }).OrderBy(g => g.Key.GroupOrder))
            {
                var tabId = $"tab-{group.Key.GroupSlug}";
                var isFirst = group.Key.GroupOrder == Model.AllMetrics.Min(m => m.GroupOrder);
                <button type="button"
                        class="metric-tab inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition @(isFirst ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-700 border-slate-300 hover:border-blue-300 hover:text-blue-700")"
                        data-target="@tabId">
                    @group.Key.GroupName
                </button>
            }
        </div>

        <div class="space-y-6">
            @foreach (var group in Model.AllMetrics.GroupBy(m => new { m.GroupSlug, m.GroupName, m.GroupOrder }).OrderBy(g => g.Key.GroupOrder))
            {
                var tabId = $"tab-{group.Key.GroupSlug}";
                var isFirst = group.Key.GroupOrder == Model.AllMetrics.Min(m => m.GroupOrder);
                <div id="@tabId" class="metric-panel @(isFirst ? "" : "hidden")">
                    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
                        @foreach (var metric in group)
                        {
                            var result = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == metric.Slug);
                            <a href="/compare/@Model.PairSlug/@metric.Slug" class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl p-4 hover:shadow-md hover:border-blue-300 transition group">
                                <span class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                                    <i class="@metric.Icon text-blue-600"></i>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <div class="font-semibold text-gray-900 text-sm group-hover:text-blue-700">@metric.Name</div>
                                    @if (result?.SummaryText != null)
                                    {
                                        <div class="text-xs text-gray-500 line-clamp-2">@result.SummaryText</div>
                                    }
                                </div>
                                <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-blue-500 text-xs shrink-0"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@{
    // FAQ generation
    var faqItems = new List<(string Question, string Answer)>();

    // Q1 - Cost of living
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "cost-of-living");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var cheaper = r.NumericA < r.NumericB ? Model.StateA : Model.StateB;
            var pricier  = cheaper == Model.StateA ? Model.StateB : Model.StateA;
            var diff     = Math.Abs(r.NumericA.Value - r.NumericB.Value);
            var loVal    = Math.Min(r.NumericA.Value, r.NumericB.Value);
            var hiVal    = Math.Max(r.NumericA.Value, r.NumericB.Value);
            faqItems.Add((
                $"Is {titleA} cheaper to live in than {titleB}?",
                $"{cheaper.Name} has the lower cost of living. On the national index (100 = average), {cheaper.Name} scores {loVal:F1} versus {hiVal:F1} for {pricier.Name} - a gap of {diff:F1} points."
            ));
        }
    }

    // Q2 - Land area
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "land-area");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var larger  = r.NumericA > r.NumericB ? Model.StateA : Model.StateB;
            var smaller = larger == Model.StateA ? Model.StateB : Model.StateA;
            var lrgVal  = Math.Max(r.NumericA.Value, r.NumericB.Value);
            var smlVal  = Math.Min(r.NumericA.Value, r.NumericB.Value);
            var ratio   = Math.Round(lrgVal / smlVal, 1);
            faqItems.Add((
                $"Which state is bigger - {titleA} or {titleB}?",
                $"{larger.Name} is larger, covering {lrgVal:N0} sq mi compared with {smlVal:N0} sq mi for {smaller.Name} - roughly {ratio:F1}x the size."
            ));
        }
    }

    // Q3 - Population
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "population");
        if (r?.WinnerSlug != null)
        {
            var isAWin  = r.WinnerSlug == Model.StateA.Slug;
            var more    = isAWin ? Model.StateA : Model.StateB;
            var less    = isAWin ? Model.StateB : Model.StateA;
            var moreVal = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var lessVal = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add((
                $"Does {titleA} or {titleB} have more people?",
                $"{more.Name} has the larger population at {moreVal ?? "-"}, compared with {lessVal ?? "-"} in {less.Name}."
            ));
        }
    }

    // Q4 - Income
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "median-income");
        if (r?.WinnerSlug != null)
        {
            var isAWin   = r.WinnerSlug == Model.StateA.Slug;
            var higher   = isAWin ? Model.StateA : Model.StateB;
            var lower    = isAWin ? Model.StateB : Model.StateA;
            var hiVal    = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var loVal    = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add((
                $"Which state has higher household income - {titleA} or {titleB}?",
                $"{higher.Name} has the higher median household income at {hiVal ?? "-"}, versus {loVal ?? "-"} in {lower.Name}."
            ));
        }
    }

    // Q5 - Income tax
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "income-tax");
        if (r?.WinnerSlug != null)
        {
            var isAWin  = r.WinnerSlug == Model.StateA.Slug;
            var lower   = isAWin ? Model.StateA : Model.StateB;
            var higher  = isAWin ? Model.StateB : Model.StateA;
            var loVal   = isAWin ? r.NumericA : r.NumericB;
            var hiDisp  = isAWin ? r.DisplayValueB : r.DisplayValueA;
            var loDisp  = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var answer  = loVal == 0
                ? $"{lower.Name} has no state income tax, while {higher.Name} charges up to {hiDisp ?? "-"}."
                : $"{lower.Name} has the lower state income tax top rate at {loDisp ?? "-"}, compared with {hiDisp ?? "-"} in {higher.Name}.";
            faqItems.Add((
                $"Which state has lower income taxes - {titleA} or {titleB}?",
                answer
            ));
        }
    }

    // Q6 - Home value
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "home-value");
        if (r?.WinnerSlug != null)
        {
            var isAWin  = r.WinnerSlug == Model.StateA.Slug;
            var cheaper = isAWin ? Model.StateA : Model.StateB;
            var pricier = isAWin ? Model.StateB : Model.StateA;
            var chVal   = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var prVal   = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add((
                $"Is housing cheaper in {titleA} or {titleB}?",
                $"Homes are cheaper in {cheaper.Name}, where the median home value is {chVal ?? "-"}, versus {prVal ?? "-"} in {pricier.Name}."
            ));
        }
    }

    // Q7 - Population density
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "density");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var denser  = r.NumericA > r.NumericB ? Model.StateA : Model.StateB;
            var sparser = denser == Model.StateA ? Model.StateB : Model.StateA;
            var denVal  = r.NumericA > r.NumericB ? r.DisplayValueA : r.DisplayValueB;
            var spaVal  = r.NumericA > r.NumericB ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add((
                $"Which state is more densely populated - {titleA} or {titleB}?",
                $"{denser.Name} is more densely populated at {denVal ?? "-"} people per sq mi. {sparser.Name} is more spread out at {spaVal ?? "-"} people per sq mi."
            ));
        }
    }

    // FAQ schema JSON
    var faqSchemaObj = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"]    = "FAQPage",
        ["mainEntity"] = faqItems.Select(f => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"]  = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, object>
            {
                ["@type"] = "Answer",
                ["text"]  = f.Answer
            }
        }).ToArray()
    };
    var faqSchemaJson = System.Text.Json.JsonSerializer.Serialize(faqSchemaObj,
        new System.Text.Json.JsonSerializerOptions { WriteIndented = false });
}

@if (faqItems.Any())
{
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#ffffff_100%)] py-12 border-t" itemscope itemtype="https://schema.org/FAQPage">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700 mb-2">People Also Ask</p>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">@titleA vs @titleB - Common Questions</h2>
            </div>

            <div class="space-y-0 divide-y divide-slate-100 rounded-[1.6rem] border border-slate-200 bg-white shadow-sm overflow-hidden">
                @foreach (var (q, a) in faqItems)
                {
                    <div class="px-6 py-5" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                        <h3 class="text-base font-semibold text-slate-900 mb-2 flex items-start gap-3" itemprop="name">
                            <span class="mt-0.5 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 text-xs font-bold">Q</span>
                            @q
                        </h3>
                        <div class="ml-9" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                            <p class="text-sm leading-7 text-slate-600" itemprop="text">@a</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.RelatedPairs.Any())
{
    <section class="bg-gray-50 py-10 border-t">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-xl font-bold text-gray-900 mb-5">Related Comparisons</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var (pa, pb) in Model.RelatedPairs)
                {
                    <a href="/compare/@(pa.Slug)-vs-@(pb.Slug)"
                       class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl p-4 hover:shadow-md hover:border-blue-300 transition group">
                        @if (pa.FlagImageUrl != null)
                        {
                            <img src="@Images.Card(pa.FlagImageUrl)" onerror="this.style.display='none'"
                                 class="w-11 h-8 object-cover rounded-md shadow-sm shrink-0" alt="@pa.Name flag" />
                        }
                        <span class="font-semibold text-gray-700 group-hover:text-blue-700 flex-1 text-sm">@pa.Name vs @pb.Name</span>
                        @if (pb.FlagImageUrl != null)
                        {
                            <img src="@Images.Card(pb.FlagImageUrl)" onerror="this.style.display='none'"
                                 class="w-11 h-8 object-cover rounded-md shadow-sm shrink-0" alt="@pb.Name flag" />
                        }
                        <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-blue-500 text-sm shrink-0"></i>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (faqItems.Any())
{
    <script type="application/ld+json">@Html.Raw(faqSchemaJson)</script>
}

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebPage",
  "name": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Model.StateA.Name} vs {Model.StateB.Name} - State Comparison"))",
  "description": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize($"Compare {Model.StateA.Name} and {Model.StateB.Name} by demographics, housing, taxes, politics, cost of living, geography, and more."))",
  "url": "https://usasymbol.com/compare/@Model.PairSlug",
  "license": "https://usasymbol.com/terms",
  "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "https://usasymbol.com" },
  "about": [
    { "@@type": "AdministrativeArea", "name": "@Model.StateA.Name", "identifier": "@Model.StateA.Abbreviation" },
    { "@@type": "AdministrativeArea", "name": "@Model.StateB.Name", "identifier": "@Model.StateB.Abbreviation" }
  ],
  "breadcrumb": {
    "@@type": "BreadcrumbList",
    "itemListElement": [
      { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://usasymbol.com" },
      { "@@type": "ListItem", "position": 2, "name": "Compare States", "item": "https://usasymbol.com/compare-states" },
      { "@@type": "ListItem", "position": 3, "name": "@Model.StateA.Name vs @Model.StateB.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug" }
    ]
  }
}
</script>

<section class="bg-gray-50 py-10 border-t text-sm text-gray-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-[1.6rem] border border-slate-200 bg-white p-6 md:p-7 shadow-sm">
            <div class="flex items-start gap-4">
                <span class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-circle-info"></i>
                </span>
                <div>
                    <h2 class="text-xl font-bold text-slate-900 mb-3">Methodology</h2>
                    <p class="leading-7">
                        All figures are sourced from U.S. government datasets and updated annually. Page last updated: <strong>April 2026</strong>.
                    </p>
                    <p class="leading-7 mt-3">
                        Core demographic data comes from the 2020 U.S. Census, with land area from U.S. Census Bureau TIGER files and statehood dates from the National Archives. Income, housing, affordability, and tax fields are maintained in our comparison dataset, with minimum wage data from the U.S. Department of Labor, gas prices from AAA, and electricity rates from the U.S. Energy Information Administration. Political control and election fields use 2024 presidential results together with National Conference of State Legislatures data. Gun-law labels use the Giffords scorecard, alcohol system data comes from NABCA, and marijuana status uses NCSL's state cannabis laws tracker. See our <a href="/editorial-policy" class="font-semibold text-blue-700 hover:text-blue-900 hover:underline">editorial policy</a> for how we review and update these pages.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const metricTabs = Array.from(document.querySelectorAll('.metric-tab'));
    const metricPanels = Array.from(document.querySelectorAll('.metric-panel'));

    metricTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-target');

            metricTabs.forEach(btn => {
                btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
                btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
            });

            tab.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
            tab.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');

            metricPanels.forEach(panel => {
                if (panel.id === target) {
                    panel.classList.remove('hidden');
                } else {
                    panel.classList.add('hidden');
                }
            });
        });
    });
</script>
