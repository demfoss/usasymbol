@model USASymbol.Models.ViewModels.StatePairComparisonViewModel
@inject IImageUrlService Images

@{
    var titleA = Model.StateA.Name;
    var titleB = Model.StateB.Name;
    var metricGroups = Model.MetricResults
        .GroupBy(r => new { r.Metric.GroupSlug, r.Metric.GroupName, r.Metric.GroupOrder })
        .OrderBy(g => g.Key.GroupOrder)
        .ToList();

    double? PercentDiff(double? from, double? to) =>
        !from.HasValue || !to.HasValue || from == 0
            ? null
            : Math.Round(Math.Abs((to.Value - from.Value) / from.Value) * 100, 1);

    double? Ratio(double? larger, double? smaller) =>
        !larger.HasValue || !smaller.HasValue || smaller == 0
            ? null
            : Math.Round(larger.Value / smaller.Value, 1);

    string FormatRatioLabel(double ratio) =>
        ratio >= 10 ? Math.Round(ratio).ToString("N0") : ratio.ToString("0.0");

    string FormatPoliticalMargin(double? value) =>
        !value.HasValue ? "-"
            : value.Value > 0 ? $"Dem +{value.Value:F2}"
            : value.Value < 0 ? $"Rep +{Math.Abs(value.Value):F2}"
            : "Even";

    var spotlightCards = new List<(string Icon, string Eyebrow, string Title, string Body, string Tone, string Glow, string? Link)>();

    if (Model.StatsA?.CostOfLivingIndex.HasValue == true && Model.StatsB?.CostOfLivingIndex.HasValue == true)
    {
        var lower = Model.StatsA.CostOfLivingIndex < Model.StatsB.CostOfLivingIndex ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        var diff = Math.Abs(Model.StatsA.CostOfLivingIndex.Value - Model.StatsB.CostOfLivingIndex.Value);
        spotlightCards.Add((
            "fa-solid fa-cart-shopping",
            "Overall Affordability",
            $"{lower.Name} is {diff:F1} points cheaper overall",
            $"{lower.Name} has the lower cost-of-living index. {lower.Name} is at {Math.Min(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1}, while {higher.Name} is at {Math.Max(Model.StatsA.CostOfLivingIndex.Value, Model.StatsB.CostOfLivingIndex.Value):F1}.",
            "from-amber-100 via-orange-50 to-white",
            "text-amber-700 bg-amber-100 border-amber-200",
            "/compare/" + Model.PairSlug + "/cost-of-living"));
    }

    if (Model.StatsA?.MedianHouseholdIncome.HasValue == true && Model.StatsB?.MedianHouseholdIncome.HasValue == true)
    {
        var higher = Model.StatsA.MedianHouseholdIncome > Model.StatsB.MedianHouseholdIncome ? Model.StateA : Model.StateB;
        var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
        var pct = PercentDiff(
            Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value),
            Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value));
        spotlightCards.Add((
            "fa-solid fa-sack-dollar",
            "Income",
            pct.HasValue ? $"{higher.Name} income is {pct.Value:F1}% higher" : $"{higher.Name} has higher income",
            $"{higher.Name} has the higher median household income at ${Math.Max(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0}, compared with ${Math.Min(Model.StatsA.MedianHouseholdIncome.Value, Model.StatsB.MedianHouseholdIncome.Value):N0} in {lower.Name}.",
            "from-emerald-100 via-green-50 to-white",
            "text-emerald-700 bg-emerald-100 border-emerald-200",
            "/compare/" + Model.PairSlug + "/median-income"));
    }

    if (Model.StatsA?.MinimumWageHourly.HasValue == true && Model.StatsB?.MinimumWageHourly.HasValue == true)
    {
        var higher = Model.StatsA.MinimumWageHourly > Model.StatsB.MinimumWageHourly ? Model.StateA : Model.StateB;
        var lower = higher == Model.StateA ? Model.StateB : Model.StateA;
        var diff = Math.Abs(Model.StatsA.MinimumWageHourly.Value - Model.StatsB.MinimumWageHourly.Value);
        spotlightCards.Add((
            "fa-solid fa-wallet",
            "Jobs",
            diff >= 1 ? $"{higher.Name} minimum wage is ${diff:F2} higher" : $"{higher.Name} has the higher minimum wage",
            $"{higher.Name} has the higher statewide minimum wage at ${Math.Max(Model.StatsA.MinimumWageHourly.Value, Model.StatsB.MinimumWageHourly.Value):F2}/hr, compared with ${Math.Min(Model.StatsA.MinimumWageHourly.Value, Model.StatsB.MinimumWageHourly.Value):F2}/hr in {lower.Name}.",
            "from-emerald-100 via-lime-50 to-white",
            "text-emerald-700 bg-emerald-100 border-emerald-200",
            "/compare/" + Model.PairSlug + "/minimum-wage"));
    }

    if (Model.StatsA?.MedianHomeValue.HasValue == true && Model.StatsB?.MedianHomeValue.HasValue == true)
    {
        var lower = Model.StatsA.MedianHomeValue < Model.StatsB.MedianHomeValue ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        var ratio = Ratio(
            Math.Max(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value),
            Math.Min(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value));
        spotlightCards.Add((
            "fa-solid fa-house",
            "Housing",
            ratio.HasValue ? $"{higher.Name} homes cost about {FormatRatioLabel(ratio.Value)}x more" : $"{lower.Name} has cheaper homes",
            $"{lower.Name} has the lower median home value at ${Math.Min(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value):N0}, versus ${Math.Max(Model.StatsA.MedianHomeValue.Value, Model.StatsB.MedianHomeValue.Value):N0} in {higher.Name}.",
            "from-sky-100 via-cyan-50 to-white",
            "text-sky-700 bg-sky-100 border-sky-200",
            "/compare/" + Model.PairSlug + "/home-value"));
    }

    if (Model.StatsA?.IncomeTaxRatePct.HasValue == true && Model.StatsB?.IncomeTaxRatePct.HasValue == true)
    {
        var lower = Model.StatsA.IncomeTaxRatePct < Model.StatsB.IncomeTaxRatePct ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        spotlightCards.Add((
            "fa-solid fa-file-invoice-dollar",
            "Taxes",
            $"{lower.Name} has lower state income tax",
            $"{lower.Name} has the lower state income tax rate. Its top rate is {Math.Min(Model.StatsA.IncomeTaxRatePct.Value, Model.StatsB.IncomeTaxRatePct.Value):F2}%, compared with {Math.Max(Model.StatsA.IncomeTaxRatePct.Value, Model.StatsB.IncomeTaxRatePct.Value):F2}% in {higher.Name}.",
            "from-rose-100 via-pink-50 to-white",
            "text-rose-700 bg-rose-100 border-rose-200",
            "/compare/" + Model.PairSlug + "/income-tax"));
    }

    if (Model.StatsA?.GasPriceRegular.HasValue == true && Model.StatsB?.GasPriceRegular.HasValue == true)
    {
        var lower = Model.StatsA.GasPriceRegular < Model.StatsB.GasPriceRegular ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        var diff = Math.Abs(Model.StatsA.GasPriceRegular.Value - Model.StatsB.GasPriceRegular.Value);
        spotlightCards.Add((
            "fa-solid fa-gas-pump",
            "Cost of Driving",
            diff >= 0.1 ? $"{lower.Name} gas is about ${diff:F2} cheaper" : $"{lower.Name} has slightly cheaper gas",
            $"{lower.Name} has the lower regular gas price at ${Math.Min(Model.StatsA.GasPriceRegular.Value, Model.StatsB.GasPriceRegular.Value):F3}/gal, versus ${Math.Max(Model.StatsA.GasPriceRegular.Value, Model.StatsB.GasPriceRegular.Value):F3}/gal in {higher.Name}.",
            "from-amber-100 via-yellow-50 to-white",
            "text-amber-700 bg-amber-100 border-amber-200",
            "/compare/" + Model.PairSlug + "/gas-price"));
    }

    if (Model.StatsA?.HomeValueToIncomeRatio().HasValue == true && Model.StatsB?.HomeValueToIncomeRatio().HasValue == true)
    {
        var lower = Model.StatsA.HomeValueToIncomeRatio() < Model.StatsB.HomeValueToIncomeRatio() ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        spotlightCards.Add((
            "fa-solid fa-chart-line",
            "Affordability",
            $"{lower.Name} has the lower home-price burden",
            $"{lower.Name} has the lower home-value-to-income ratio at {Math.Min(Model.StatsA.HomeValueToIncomeRatio()!.Value, Model.StatsB.HomeValueToIncomeRatio()!.Value):F2}x, while {higher.Name} is at {Math.Max(Model.StatsA.HomeValueToIncomeRatio()!.Value, Model.StatsB.HomeValueToIncomeRatio()!.Value):F2}x.",
            "from-violet-100 via-fuchsia-50 to-white",
            "text-violet-700 bg-violet-100 border-violet-200",
            "/compare/" + Model.PairSlug + "/home-value-to-income"));
    }

    if (Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "density") is { NumericA: not null, NumericB: not null } densityResult)
    {
        var lower = densityResult.NumericA < densityResult.NumericB ? Model.StateA : Model.StateB;
        var higher = lower == Model.StateA ? Model.StateB : Model.StateA;
        var pct = PercentDiff(Math.Min(densityResult.NumericA.Value, densityResult.NumericB.Value), Math.Max(densityResult.NumericA.Value, densityResult.NumericB.Value));
        spotlightCards.Add((
            "fa-solid fa-tree-city",
            "Lifestyle",
            pct.HasValue ? $"{lower.Name} is {pct.Value:F1}% less densely populated" : $"{lower.Name} feels less crowded",
            $"{lower.Name} is less densely populated at {Math.Min(densityResult.NumericA.Value, densityResult.NumericB.Value):N1} people per sq mi, compared with {Math.Max(densityResult.NumericA.Value, densityResult.NumericB.Value):N1} in {higher.Name}.",
            "from-teal-100 via-cyan-50 to-white",
            "text-teal-700 bg-teal-100 border-teal-200",
            "/compare/" + Model.PairSlug + "/density"));
    }

    if (Model.StatsA?.LifeExpectancyYears.HasValue == true && Model.StatsB?.LifeExpectancyYears.HasValue == true)
    {
        var longer = Model.StatsA.LifeExpectancyYears > Model.StatsB.LifeExpectancyYears ? Model.StateA : Model.StateB;
        var shorter = longer == Model.StateA ? Model.StateB : Model.StateA;
        var longerStats = longer == Model.StateA ? Model.StatsA : Model.StatsB;
        var shorterStats = longer == Model.StateA ? Model.StatsB : Model.StatsA;
        var lifeExpDiff = Math.Abs(Model.StatsA.LifeExpectancyYears.Value - Model.StatsB.LifeExpectancyYears.Value);
        spotlightCards.Add((
            "fa-solid fa-heart-pulse",
            "Health",
            $"{longer.Name} residents live {lifeExpDiff:F1} years longer on average",
            $"{longer.Name} has a life expectancy of {longerStats!.LifeExpectancyYears:F1} years, compared with {shorterStats!.LifeExpectancyYears:F1} years in {shorter.Name} (CDC 2021).",
            "from-rose-100 via-pink-50 to-white",
            "text-rose-700 bg-rose-100 border-rose-200",
            "/compare/" + Model.PairSlug + "/life-expectancy"));
    }

    if (Model.StatsA?.ViolentCrimeRatePer100k.HasValue == true && Model.StatsB?.ViolentCrimeRatePer100k.HasValue == true)
    {
        var safer = Model.StatsA.ViolentCrimeRatePer100k < Model.StatsB.ViolentCrimeRatePer100k ? Model.StateA : Model.StateB;
        var riskier = safer == Model.StateA ? Model.StateB : Model.StateA;
        var saferStats = safer == Model.StateA ? Model.StatsA : Model.StatsB;
        var riskierStats = safer == Model.StateA ? Model.StatsB : Model.StatsA;
        var crimePct = PercentDiff(saferStats!.ViolentCrimeRatePer100k, riskierStats!.ViolentCrimeRatePer100k);
        spotlightCards.Add((
            "fa-solid fa-shield-halved",
            "Safety",
            crimePct.HasValue ? $"{safer.Name} has {crimePct.Value:F0}% less violent crime" : $"{safer.Name} has a lower violent crime rate",
            $"{safer.Name} records {saferStats.ViolentCrimeRatePer100k:F1} violent crimes per 100k residents, versus {riskierStats.ViolentCrimeRatePer100k:F1} in {riskier.Name} (FBI UCR 2022).",
            "from-green-100 via-emerald-50 to-white",
            "text-green-700 bg-green-100 border-green-200",
            "/compare/" + Model.PairSlug + "/violent-crime"));
    }

    if (Model.StatsA?.AverageTemperatureF.HasValue == true && Model.StatsB?.AverageTemperatureF.HasValue == true)
    {
        var warmer = Model.StatsA.AverageTemperatureF > Model.StatsB.AverageTemperatureF ? Model.StateA : Model.StateB;
        var cooler = warmer == Model.StateA ? Model.StateB : Model.StateA;
        var diff = Math.Abs(Model.StatsA.AverageTemperatureF.Value - Model.StatsB.AverageTemperatureF.Value);
        spotlightCards.Add((
            "fa-solid fa-temperature-half",
            "Climate",
            diff >= 1 ? $"{warmer.Name} is {diff:F1}\u00B0F warmer overall" : $"{warmer.Name} has the warmer climate",
            $"{warmer.Name} has the higher average annual temperature at {Math.Max(Model.StatsA.AverageTemperatureF.Value, Model.StatsB.AverageTemperatureF.Value):F1}\u00B0F, compared with {Math.Min(Model.StatsA.AverageTemperatureF.Value, Model.StatsB.AverageTemperatureF.Value):F1}\u00B0F in {cooler.Name}.",
            "from-orange-100 via-amber-50 to-white",
            "text-orange-700 bg-orange-100 border-orange-200",
            "/compare/" + Model.PairSlug + "/average-temperature"));
    }

    if (Model.StatsA?.SunnyDaysPerYear.HasValue == true && Model.StatsB?.SunnyDaysPerYear.HasValue == true)
    {
        var sunnier = Model.StatsA.SunnyDaysPerYear > Model.StatsB.SunnyDaysPerYear ? Model.StateA : Model.StateB;
        var cloudier = sunnier == Model.StateA ? Model.StateB : Model.StateA;
        var diff = Math.Abs(Model.StatsA.SunnyDaysPerYear.Value - Model.StatsB.SunnyDaysPerYear.Value);
        spotlightCards.Add((
            "fa-solid fa-cloud-sun",
            "Climate",
            diff >= 10 ? $"{sunnier.Name} gets about {diff:N0} more sunny days" : $"{sunnier.Name} gets more sunshine",
            $"{sunnier.Name} averages {Math.Max(Model.StatsA.SunnyDaysPerYear.Value, Model.StatsB.SunnyDaysPerYear.Value):N0} sunny days a year, versus {Math.Min(Model.StatsA.SunnyDaysPerYear.Value, Model.StatsB.SunnyDaysPerYear.Value):N0} in {cloudier.Name}.",
            "from-yellow-100 via-amber-50 to-white",
            "text-yellow-700 bg-yellow-100 border-yellow-200",
            "/compare/" + Model.PairSlug + "/sunny-days"));
    }

    var costOfLivingResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "cost-of-living");
    var livabilityResult   = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "livability-score");
    var incomeResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "median-income");
    var incomeTaxResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "income-tax");
    var sunshineResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "sunny-days");
    var climateResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "average-temperature");
    var popResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "population");
    var areaResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "land-area");

    // Hero winner driven by livability score (higher = better quality of life)
    var winnerSlug = livabilityResult?.WinnerSlug ?? costOfLivingResult?.WinnerSlug;
    var winnerState = winnerSlug == Model.StateA.Slug ? Model.StateA : winnerSlug == Model.StateB.Slug ? Model.StateB : null;
    var diffLabel = livabilityResult?.DifferenceText;

    string? scaleStatement = null;
    if (areaResult?.NumericA.HasValue == true && areaResult?.NumericB.HasValue == true && areaResult.NumericA.Value != areaResult.NumericB.Value)
    {
        var larger = areaResult.NumericA > areaResult.NumericB ? Model.StateA : Model.StateB;
        var smaller = larger == Model.StateA ? Model.StateB : Model.StateA;
        var ratio = Ratio(Math.Max(areaResult.NumericA.Value, areaResult.NumericB.Value), Math.Min(areaResult.NumericA.Value, areaResult.NumericB.Value));
        if (ratio.HasValue && ratio.Value >= 1.5)
        {
            scaleStatement = $"{smaller.Name} is about {FormatRatioLabel(ratio.Value)} times smaller than {larger.Name}.";
        }
    }

    var quickTakeItems = new List<string>();
    if (!string.IsNullOrWhiteSpace(scaleStatement)) quickTakeItems.Add(scaleStatement);
    if (popResult?.SummaryText != null) quickTakeItems.Add(popResult.SummaryText);
    foreach (var card in spotlightCards)
    {
        if (quickTakeItems.Count >= 4) break;
        quickTakeItems.Add(card.Body);
    }

    var heroSummaryParts = new List<string>();
    if (costOfLivingResult?.WinnerSlug != null)
    {
        var cheaper = costOfLivingResult.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
        heroSummaryParts.Add($"{cheaper.Name} is cheaper overall");
    }

    if (incomeResult?.WinnerSlug != null)
    {
        var higherIncome = incomeResult.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
        heroSummaryParts.Add($"{higherIncome.Name} has higher incomes");
    }

    if (incomeTaxResult?.WinnerSlug != null)
    {
        var lowerTax = incomeTaxResult.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
        var lowerTaxValue = incomeTaxResult.WinnerSlug == Model.StateA.Slug ? incomeTaxResult.DisplayValueA : incomeTaxResult.DisplayValueB;
        heroSummaryParts.Add(lowerTaxValue == "0.00%" ? $"{lowerTax.Name} has no state income tax" : $"{lowerTax.Name} has lower state income tax");
    }

    if (sunshineResult?.WinnerSlug != null)
    {
        var sunnier = sunshineResult.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
        heroSummaryParts.Add($"{sunnier.Name} gets more sunshine");
    }
    else if (climateResult?.WinnerSlug != null)
    {
        var warmer = climateResult.WinnerSlug == Model.StateA.Slug ? Model.StateA : Model.StateB;
        heroSummaryParts.Add($"{warmer.Name} has the warmer climate");
    }

    string? heroSummary = heroSummaryParts.Count switch
    {
        0 => costOfLivingResult?.SummaryText,
        1 => heroSummaryParts[0] + ".",
        2 => heroSummaryParts[0] + ", while " + heroSummaryParts[1] + ".",
        _ => heroSummaryParts[0] + ", while " + string.Join(", ", heroSummaryParts.Skip(1).Take(heroSummaryParts.Count - 2)) + ", and " + heroSummaryParts.Last() + "."
    };

    ViewData["Title"] = ViewData["Title"] ?? $"{titleA} vs {titleB}";
}

<nav class="bg-gray-50 py-3 border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li><a href="/" class="text-blue-700 hover:underline">Home</a></li>
            <li class="text-gray-400">/</li>
            <li><a href="/compare-states" class="text-blue-700 hover:underline">Compare States</a></li>
            <li class="text-gray-400">/</li>
            <li class="font-semibold">@titleA vs @titleB</li>
        </ol>
    </div>
</nav>

<section class="bg-[linear-gradient(135deg,#0f172a_0%,#1e3a8a_52%,#60a5fa_100%)] text-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
            <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-semibold uppercase tracking-wide rounded-full bg-blue-800/70 border border-blue-500/40">
                <i class="fa-solid fa-scale-balanced text-yellow-300 mr-2"></i>
                State Comparison
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold mb-3">@titleA vs @titleB</h1>
            @if (heroSummary != null)
            {
                <p class="text-lg text-blue-100 max-w-3xl mx-auto">@heroSummary</p>
            }
        </div>

        <div class="grid gap-4 md:gap-6 items-stretch lg:grid-cols-3">
            @{
                var livA = livabilityResult?.NumericA;
                var livB = livabilityResult?.NumericB;
            }
            <article class="rounded-[1.8rem] border @(winnerSlug == Model.StateA.Slug ? "border-emerald-300 bg-white text-slate-900 shadow-[0_26px_60px_-30px_rgba(16,185,129,0.6)]" : "border-white/15 bg-white/10 text-white") backdrop-blur-sm p-6 md:p-7">
                <div class="flex items-start gap-4">
                    <img src="@Images.Card(Model.StateA.FlagImageUrl)" alt="@Model.StateA.Name flag" class="w-16 h-11 md:w-20 md:h-14 object-cover rounded-lg shadow-md shrink-0" onerror="this.style.display='none'" />
                    <div class="min-w-0">
                        <div class="text-2xl md:text-3xl font-extrabold leading-tight">@Model.StateA.Name</div>
                        <div class="text-sm md:text-base @(winnerSlug == Model.StateA.Slug ? "text-slate-500" : "text-blue-100")">@Model.StateA.Abbreviation &bull; @(Model.StateA.Region ?? "United States")</div>
                        @if (winnerSlug == Model.StateA.Slug)
                        {
                            <div class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em]">
                                <i class="fa-solid fa-crown text-[10px]"></i> Better quality of life
                            </div>
                        }
                    </div>
                </div>
                @if (livA.HasValue)
                {
                    <div class="mt-5">
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] @(winnerSlug == Model.StateA.Slug ? "text-slate-500" : "text-blue-200") mb-1">Quality of Life Score</div>
                        <div class="text-4xl md:text-5xl font-extrabold tracking-tight">@livabilityResult!.DisplayValueA</div>
                    </div>
                }
            </article>

            <div class="hidden lg:flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-white text-slate-950 flex items-center justify-center shadow-xl">
                    <span class="text-sm font-extrabold tracking-[0.18em]">VS</span>
                </div>
            </div>

            <article class="rounded-[1.8rem] border @(winnerSlug == Model.StateB.Slug ? "border-emerald-300 bg-white text-slate-900 shadow-[0_26px_60px_-30px_rgba(16,185,129,0.6)]" : "border-white/15 bg-white/10 text-white") backdrop-blur-sm p-6 md:p-7">
                <div class="flex items-start gap-4">
                    <img src="@Images.Card(Model.StateB.FlagImageUrl)" alt="@Model.StateB.Name flag" class="w-16 h-11 md:w-20 md:h-14 object-cover rounded-lg shadow-md shrink-0" onerror="this.style.display='none'" />
                    <div class="min-w-0">
                        <div class="text-2xl md:text-3xl font-extrabold leading-tight">@Model.StateB.Name</div>
                        <div class="text-sm md:text-base @(winnerSlug == Model.StateB.Slug ? "text-slate-500" : "text-blue-100")">@Model.StateB.Abbreviation &bull; @(Model.StateB.Region ?? "United States")</div>
                        @if (winnerSlug == Model.StateB.Slug)
                        {
                            <div class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em]">
                                <i class="fa-solid fa-crown text-[10px]"></i> Better quality of life
                            </div>
                        }
                    </div>
                </div>
                @if (livB.HasValue)
                {
                    <div class="mt-5">
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] @(winnerSlug == Model.StateB.Slug ? "text-slate-500" : "text-blue-200") mb-1">Quality of Life Score</div>
                        <div class="text-4xl md:text-5xl font-extrabold tracking-tight">@livabilityResult!.DisplayValueB</div>
                    </div>
                }
            </article>
        </div>
    </div>
</section>

@{
    // Overall verdict scoring
    // Only numeric metrics with an actual winner count; geography-only pairs will have 0 wins
    var numericSlugs = new HashSet<string> {
        "population","density","college-educated","median-income","minimum-wage","poverty-rate",
        "employment-population-ratio","regional-price-parity","livability-score","cost-of-living",
        "gas-price","electricity-rates","average-temperature","summer-temperature","winter-temperature","sunny-days","annual-precipitation",
        "commute-time","home-value","median-rent","owner-costs-with-mortgage",
        "owner-costs-without-mortgage","homeownership-rate","home-value-to-income",
        "rent-to-income","owner-costs-to-income","income-tax","sales-tax","property-tax","land-area","highest-point",
        "life-expectancy","violent-crime"
    };
    var scorableResults = Model.MetricResults
        .Where(r => numericSlugs.Contains(r.Metric.Slug) && r.WinnerSlug != null)
        .ToList();

    var winsA = scorableResults.Count(r => r.WinnerSlug == Model.StateA.Slug);
    var winsB = scorableResults.Count(r => r.WinnerSlug == Model.StateB.Slug);
    var totalScored = winsA + winsB;

    State? verdictWinner = totalScored == 0 ? null
        : winsA > winsB ? Model.StateA
        : winsB > winsA ? Model.StateB
        : null; // tie

    // Per-group wins - only groups with at least 1 result
    var groupWins = scorableResults
        .GroupBy(r => new { r.Metric.GroupSlug, r.Metric.GroupName })
        .Select(g => new {
            Group     = g.Key.GroupName,
            WinsA     = g.Count(r => r.WinnerSlug == Model.StateA.Slug),
            WinsB     = g.Count(r => r.WinnerSlug == Model.StateB.Slug),
            Total     = g.Count()
        })
        .Where(g => g.WinsA != g.WinsB)   // skip tied groups
        .OrderByDescending(g => g.Total)
        .ToList();
}

@if (totalScored > 0)
{
    var isAhead  = verdictWinner != null;
    var leader   = verdictWinner ?? Model.StateA; // tie fallback for display only
    var trailer  = leader == Model.StateA ? Model.StateB : Model.StateA;
    var leaderW  = leader == Model.StateA ? winsA : winsB;
    var trailerW = leader == Model.StateA ? winsB : winsA;

    <section class="bg-[linear-gradient(180deg,#f0fdf4_0%,#ffffff_100%)] border-b border-emerald-100 py-8 md:py-10">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="rounded-[2rem] border @(isAhead ? "border-emerald-200" : "border-slate-200") bg-white shadow-sm overflow-hidden">

                <div class="grid lg:grid-cols-3">

                    @* State A score *@
                    <div class="p-6 md:p-8 flex items-center gap-4 @(winsA >= winsB ? "bg-emerald-50/60" : "")">
                        <img src="@Images.Card(Model.StateA.FlagImageUrl)" alt="@Model.StateA.Name flag"
                             class="w-14 h-10 md:w-16 md:h-11 object-cover rounded-lg shadow-sm shrink-0" onerror="this.style.display='none'" />
                        <div class="flex-1 min-w-0">
                            <div class="text-base font-semibold text-slate-500 truncate">@Model.StateA.Name</div>
                            <div class="text-4xl md:text-5xl font-extrabold @(winsA > winsB ? "text-emerald-600" : "text-slate-700") leading-none mt-0.5">
                                @winsA
                                <span class="text-base font-medium text-slate-400 ml-1">/ @totalScored</span>
                            </div>
                            <div class="text-xs text-slate-500 mt-1">metrics won</div>
                        </div>
                        @if (winsA > winsB)
                        {
                            <span class="inline-flex flex-col items-center gap-1 shrink-0">
                                <span class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-md">
                                    <i class="fa-solid fa-crown text-base"></i>
                                </span>
                                <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Wins</span>
                            </span>
                        }
                    </div>

                    @* Centre divider *@
                    <div class="hidden lg:flex flex-col items-center justify-center px-4 py-6 gap-2 border-x border-slate-100">
                        <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Score</div>
                        <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center shadow-lg">
                            <span class="text-sm font-extrabold">VS</span>
                        </div>
                        @if (verdictWinner == null)
                        {
                            <div class="text-xs font-semibold text-amber-600 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">Tie</div>
                        }
                    </div>

                    @* State B score *@
                    <div class="p-6 md:p-8 flex items-center gap-4 @(winsB >= winsA ? "bg-emerald-50/60" : "")">
                        <img src="@Images.Card(Model.StateB.FlagImageUrl)" alt="@Model.StateB.Name flag"
                             class="w-14 h-10 md:w-16 md:h-11 object-cover rounded-lg shadow-sm shrink-0" onerror="this.style.display='none'" />
                        <div class="flex-1 min-w-0">
                            <div class="text-base font-semibold text-slate-500 truncate">@Model.StateB.Name</div>
                            <div class="text-4xl md:text-5xl font-extrabold @(winsB > winsA ? "text-emerald-600" : "text-slate-700") leading-none mt-0.5">
                                @winsB
                                <span class="text-base font-medium text-slate-400 ml-1">/ @totalScored</span>
                            </div>
                            <div class="text-xs text-slate-500 mt-1">metrics won</div>
                        </div>
                        @if (winsB > winsA)
                        {
                            <span class="inline-flex flex-col items-center gap-1 shrink-0">
                                <span class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-md">
                                    <i class="fa-solid fa-crown text-base"></i>
                                </span>
                                <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Wins</span>
                            </span>
                        }
                    </div>
                </div>

                @if (groupWins.Any())
                {
                    <div class="border-t border-slate-100 px-6 md:px-8 py-4 flex flex-wrap gap-3">
                        @foreach (var g in groupWins.Take(4))
                        {
                            var gWinState = g.WinsA > g.WinsB ? Model.StateA : Model.StateB;
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700">
                                <img src="@Images.Thumb(gWinState.FlagImageUrl)" alt="@gWinState.Name flag" class="w-5 h-3.5 object-cover rounded shrink-0" onerror="this.style.display='none'" />
                                <span class="font-semibold">@gWinState.Abbreviation</span> wins @g.Group
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="bg-white py-8 md:py-10 border-b">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-2">
            <article class="rounded-[1.8rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff_0%,#f8fbff_100%)] p-6 md:p-7 shadow-sm">
                <div class="flex items-center gap-3 mb-5">
                    <span class="w-11 h-11 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center">
                        <i class="fa-solid fa-chart-simple"></i>
                    </span>
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Quality of Life</h2>
                        <p class="text-sm text-slate-600">Composite score — income, affordability, education, health, and safety.</p>
                    </div>
                </div>

                @{
                    var visA = livabilityResult?.NumericA;
                    var visB = livabilityResult?.NumericB;
                    // Higher livability = better, bars are proportional
                    double barWidthA = 50, barWidthB = 50;
                    if (visA.HasValue && visB.HasValue && (visA.Value + visB.Value) > 0)
                    {
                        barWidthA = Math.Round(visA.Value / (visA.Value + visB.Value) * 100, 1);
                        barWidthB = Math.Round(100 - barWidthA, 1);
                    }
                    var isABetter = winnerSlug == Model.StateA.Slug;
                    var isBBetter = winnerSlug == Model.StateB.Slug;
                }

                <div class="space-y-5">
                    @* State A bar *@
                    <div>
                        <div class="flex items-end justify-between mb-2">
                            <div class="flex items-center gap-2">
                                <img src="@Images.Card(Model.StateA.FlagImageUrl)" alt="@Model.StateA.Name flag"
                                     class="w-8 h-5 object-cover rounded shrink-0" onerror="this.style.display='none'" />
                                <span class="text-sm font-semibold text-slate-700">@Model.StateA.Name</span>
                                @if (isABetter)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 text-xs font-bold">
                                        <i class="fa-solid fa-crown text-[10px]"></i> winner
                                    </span>
                                }
                            </div>
                            <span class="text-2xl font-extrabold @(isABetter ? "text-emerald-600" : "text-slate-600")">
                                @(livabilityResult?.DisplayValueA ?? "-")
                            </span>
                        </div>
                        <div class="h-4 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full transition-all @(isABetter ? "bg-emerald-500" : "bg-slate-400")"
                                 style="width: @barWidthA.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>

                    @* Divider *@
                    <div class="flex items-center gap-3">
                        <div class="flex-1 border-t border-dashed border-slate-200"></div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-[0.18em]">vs</span>
                        <div class="flex-1 border-t border-dashed border-slate-200"></div>
                    </div>

                    @* State B bar *@
                    <div>
                        <div class="flex items-end justify-between mb-2">
                            <div class="flex items-center gap-2">
                                <img src="@Images.Card(Model.StateB.FlagImageUrl)" alt="@Model.StateB.Name flag"
                                     class="w-8 h-5 object-cover rounded shrink-0" onerror="this.style.display='none'" />
                                <span class="text-sm font-semibold text-slate-700">@Model.StateB.Name</span>
                                @if (isBBetter)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 text-xs font-bold">
                                        <i class="fa-solid fa-crown text-[10px]"></i> winner
                                    </span>
                                }
                            </div>
                            <span class="text-2xl font-extrabold @(isBBetter ? "text-emerald-600" : "text-slate-600")">
                                @(livabilityResult?.DisplayValueB ?? "-")
                            </span>
                        </div>
                        <div class="h-4 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full transition-all @(isBBetter ? "bg-emerald-500" : "bg-slate-400")"
                                 style="width: @barWidthB.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                </div>

                @if (winnerState != null && diffLabel != null)
                {
                    <div class="mt-5 flex items-center gap-2 rounded-2xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-slate-700">
                        <i class="fa-solid fa-circle-check text-emerald-500 shrink-0"></i>
                        <span><strong>@winnerState.Name</strong> scores higher on quality of life — <strong>@diffLabel</strong> difference.</span>
                    </div>
                }
            </article>

            <article class="rounded-[1.8rem] border border-amber-200 bg-[linear-gradient(180deg,#fffdf6_0%,#fff7e6_100%)] p-6 md:p-7">
                <div class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700 mb-3">Quick Take</div>
                <h2 class="text-2xl font-bold text-slate-900 mb-3">@titleA vs @titleB</h2>
                <p class="text-sm leading-6 text-slate-700 mb-4">This quick read mixes affordability, housing, income, politics, density, and climate so the biggest tradeoffs show up fast.</p>
                @if (quickTakeItems.Any())
                {
                    <ul class="space-y-2">
                        @foreach (var take in quickTakeItems)
                        {
                            <li class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-white/70 px-4 py-3 text-sm font-medium text-slate-700">
                                <i class="fa-solid fa-circle-check text-amber-500 mt-0.5 shrink-0"></i>
                                <span>@take</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </div>
</section>

@if (spotlightCards.Any())
{
    <section class="bg-[radial-gradient(circle_at_top_left,_rgba(251,191,36,0.16),_transparent_35%),linear-gradient(180deg,#fffdf7_0%,#fff7e6_100%)] py-12 border-t border-amber-100">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8 max-w-3xl">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-700 mb-2">Overview</p>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Key differences overview</h2>
                <p class="text-sm text-slate-600 mt-1.5">These cards keep the comparison factual first, so the biggest tradeoffs in affordability, housing, taxes, politics, climate, and day-to-day living are easy to scan.</p>
            </div>
            <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
                @foreach (var card in spotlightCards.Take(6))
                {
                    <article class="rounded-[1.6rem] border border-white/70 bg-gradient-to-br @card.Tone p-6 shadow-[0_18px_40px_-24px_rgba(15,23,42,0.35)] hover:-translate-y-1 hover:shadow-[0_22px_50px_-24px_rgba(15,23,42,0.4)] transition">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="w-12 h-12 rounded-2xl border flex items-center justify-center text-lg @card.Glow">
                                <i class="@card.Icon"></i>
                            </span>
                            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-700">@card.Eyebrow</span>
                        </div>
                        <h3 class="text-2xl font-extrabold tracking-tight text-gray-900 leading-tight mb-3">@card.Title</h3>
                        <p class="text-sm leading-6 text-gray-700 mb-4">@card.Body</p>
                        @if (!string.IsNullOrWhiteSpace(card.Link))
                        {
                            <a href="@card.Link" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-black">
                                View detailed comparison
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        }
                    </article>
                }
            </div>
        </div>
