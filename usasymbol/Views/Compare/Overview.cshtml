@model USASymbol.Models.ViewModels.StatePairComparisonViewModel
@using USASymbol.Services
@inject IImageUrlService Images
@inject usasymbol.Services.Interface.IColorService ColorSvc
@inject usasymbol.Services.Interface.IStateService StateSvc

@{
    var titleA = Model.StateA.Name;
    var titleB = Model.StateB.Name;
    var metricGroups = Model.MetricResults
        .GroupBy(r => new { r.Metric.GroupSlug, r.Metric.GroupName, r.Metric.GroupOrder })
        .OrderBy(g => g.Key.GroupOrder)
        .ToList();

    // ── flag-derived accent colors (Content/states/{state}/color.yaml, falls back to neutral pair) ──
    var colorContentA = await ColorSvc.GetColorContentAsync(Model.StateA.Slug, "flag");
    var colorContentB = await ColorSvc.GetColorContentAsync(Model.StateB.Slug, "flag");
    var accent = CompareAccentColor.Resolve(
        colorContentA?.ColorData.Select(c => c.Hex).ToList(),
        colorContentB?.ColorData.Select(c => c.Hex).ToList());
    ViewData["AccentA"] = accent.HexA;
    ViewData["AccentB"] = accent.HexB;

    // ── overall score (single source of truth, also drives the decision module's "Overall" verdict) ──
    var overviewScore = ComparisonScoreCalculator.Calculate(Model);
    var totalScored = overviewScore.WinsA + overviewScore.WinsB;
    var aSharePct = totalScored > 0 ? Math.Round((double)overviewScore.WinsA / totalScored * 100, 1) : 50;

    // ── one-line hero verdict ──
    var costOfLivingResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "cost-of-living");
    var purchasingPowerResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "purchasing-power");
    var incomeResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "median-income");
    var incomeTaxResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "income-tax");
    var sunshineResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "sunny-days");
    var climateResult = Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == "average-temperature");

    // One clause per state: "Texas is cheaper and has no state income tax; California has higher incomes and more sunshine."
    var heroClauses = new Dictionary<string, List<string>> { [Model.StateA.Slug] = new(), [Model.StateB.Slug] = new() };
    void Lead(MetricComparisonResult? r, string phrase)
    {
        if (r?.WinnerSlug != null && heroClauses.TryGetValue(r.WinnerSlug, out var list)) list.Add(phrase);
    }
    Lead(costOfLivingResult, "is cheaper overall");
    Lead(incomeResult, "has higher incomes");
    if (incomeTaxResult?.WinnerSlug != null)
    {
        var taxNumeric = incomeTaxResult.WinnerSlug == Model.StateA.Slug ? incomeTaxResult.NumericA : incomeTaxResult.NumericB;
        Lead(incomeTaxResult, taxNumeric == 0 ? "has no state income tax" : "has lower state income tax");
    }
    if (sunshineResult?.WinnerSlug != null) Lead(sunshineResult, "gets more sunshine");

    string JoinPhrases(List<string> l) => l.Count <= 2 ? string.Join(" and ", l) : string.Join(", ", l.Take(l.Count - 1)) + ", and " + l.Last();
    var heroClauseText = new List<string>();
    foreach (var st in new[] { Model.StateA, Model.StateB })
    {
        var l = heroClauses[st.Slug];
        if (l.Count > 0) heroClauseText.Add($"{st.Name} {JoinPhrases(l)}");
    }
    string? heroSummary = heroClauseText.Count > 0
        ? string.Join("; ", heroClauseText) + "."
        : costOfLivingResult?.SummaryText;

    // ── where each state leads: one table, real numbers, plain metric names ──
    var leadSlugs = new[]
    {
        "cost-of-living", "median-income", "median-rent", "home-value", "property-tax", "income-tax",
        "violent-crime", "life-expectancy", "uninsured-rate", "college-educated", "job-growth", "sunny-days"
    };
    var leadRows = leadSlugs
        .Select(slug => Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == slug))
        .Where(r => r?.WinnerSlug != null && r.DisplayValueA != null && r.DisplayValueB != null)
        .Cast<MetricComparisonResult>()
        .ToList();

    // ── unified metric comparison tabs (General + one per metric group) ──
    var generalSlugs = new[] {
        "capital", "political-lean", "population", "median-income",
        "cost-of-living", "home-value", "property-tax", "income-tax",
        "minimum-wage", "gas-price", "electricity-rates", "livability-score",
        "average-temperature", "sunny-days", "land-area", "density", "statehood"
    };
    var generalResults = generalSlugs
        .Select(s => Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == s))
        .Where(r => r != null).Cast<MetricComparisonResult>().ToList();

    var groupIconMap = new Dictionary<string, string> {
        ["demographics"] = "fa-solid fa-people-group", ["economy"] = "fa-solid fa-dollar-sign",
        ["income"] = "fa-solid fa-dollar-sign", ["jobs"] = "fa-solid fa-briefcase",
        ["quality-of-life"] = "fa-solid fa-heart-pulse", ["housing"] = "fa-solid fa-house",
        ["taxes"] = "fa-solid fa-file-invoice-dollar", ["politics"] = "fa-solid fa-landmark-dome",
        ["laws"] = "fa-solid fa-scale-balanced", ["geography"] = "fa-solid fa-map",
        ["climate"] = "fa-solid fa-cloud-sun", ["safety"] = "fa-solid fa-shield-halved",
        ["health"] = "fa-solid fa-stethoscope", ["labor"] = "fa-solid fa-briefcase",
    };

    var cmpTabs = new List<MetricComparisonTab>();
    if (generalResults.Any())
    {
        var gA = generalResults.Count(r => ComparisonScoreCalculator.IsScorable(r.Metric.Slug) && r.WinnerSlug == Model.StateA.Slug);
        var gB = generalResults.Count(r => ComparisonScoreCalculator.IsScorable(r.Metric.Slug) && r.WinnerSlug == Model.StateB.Slug);
        cmpTabs.Add(new MetricComparisonTab
        {
            Id = "tab-general", Label = "General", Icon = "fa-solid fa-table-list", Results = generalResults,
            LeaderSlug = gA > gB ? Model.StateA.Slug : gB > gA ? Model.StateB.Slug : null
        });
    }

    var tabOrder = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
    {
        ["tab-general"] = 0, ["tab-demographics"] = 1, ["tab-income"] = 2, ["tab-jobs"] = 3,
        ["tab-quality-of-life"] = 4, ["tab-climate"] = 5, ["tab-housing"] = 6, ["tab-taxes"] = 7,
        ["tab-politics"] = 8, ["tab-laws"] = 9, ["tab-geography"] = 10, ["tab-health"] = 11, ["tab-safety"] = 12,
    };

    foreach (var grp in metricGroups)
    {
        var rows = grp.ToList();
        var grpA = rows.Count(r => ComparisonScoreCalculator.IsScorable(r.Metric.Slug) && r.WinnerSlug == Model.StateA.Slug);
        var grpB = rows.Count(r => ComparisonScoreCalculator.IsScorable(r.Metric.Slug) && r.WinnerSlug == Model.StateB.Slug);
        var ico = groupIconMap.TryGetValue(grp.Key.GroupSlug, out var gi) ? gi : "fa-solid fa-chart-bar";
        cmpTabs.Add(new MetricComparisonTab
        {
            Id = $"tab-{grp.Key.GroupSlug}", Label = grp.Key.GroupName, Icon = ico, Results = rows,
            LeaderSlug = grpA > grpB ? Model.StateA.Slug : grpB > grpA ? Model.StateB.Slug : null,
            CategorySlug = grp.Key.GroupSlug
        });
    }

    cmpTabs = cmpTabs.OrderBy(t => tabOrder.TryGetValue(t.Id, out var order) ? order : 999).ThenBy(t => t.Label).ToList();

    var metricListModel = new MetricComparisonListViewModel
    {
        StateA = Model.StateA, StateB = Model.StateB, PairSlug = Model.PairSlug,
        AccentA = accent.HexA, AccentB = accent.HexB, Tabs = cmpTabs
    };

    // ── hero state pickers ──
    var allStates = (await StateSvc.GetAllStatesAsync()).OrderBy(x => x.Name).ToList();

    // ── 5 biggest differences: largest relative gaps among comparable numeric metrics ──
    var diffSlugs = new[]
    {
        "income-tax", "property-tax", "sales-tax", "median-rent", "home-value", "median-income",
        "cost-of-living", "gas-price", "electricity-rates", "violent-crime", "minimum-wage",
        "land-area", "population", "density"
    };
    var bigDiffs = diffSlugs
        .Select(slug => Model.MetricResults.FirstOrDefault(r => r.Metric.Slug == slug))
        .Where(r => r != null && r.NumericA.HasValue && r.NumericB.HasValue
                    && r.DisplayValueA != null && r.DisplayValueB != null
                    && r.NumericA.Value >= 0 && r.NumericB.Value >= 0
                    && (r.NumericA.Value > 0 || r.NumericB.Value > 0))
        .Select(r =>
        {
            var hi = Math.Max(r!.NumericA!.Value, r.NumericB!.Value);
            var lo = Math.Min(r.NumericA.Value, r.NumericB.Value);
            var ratio = lo == 0 ? double.PositiveInfinity : hi / lo;
            return (Result: r, Ratio: ratio, AIsHigher: r.NumericA.Value >= r.NumericB.Value);
        })
        .OrderByDescending(x => x.Ratio)
        .Take(5)
        .ToList();

    // ── FAQ ──
    var faqItems = new List<(string Question, string Answer)>();
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "cost-of-living");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var cheaper = r.NumericA < r.NumericB ? Model.StateA : Model.StateB;
            var pricier = cheaper == Model.StateA ? Model.StateB : Model.StateA;
            var diff = Math.Abs(r.NumericA.Value - r.NumericB.Value);
            var loVal = Math.Min(r.NumericA.Value, r.NumericB.Value);
            var hiVal = Math.Max(r.NumericA.Value, r.NumericB.Value);
            faqItems.Add(($"Is {titleA} cheaper to live in than {titleB}?",
                $"{cheaper.Name} has the lower cost of living. On the national index (100 = average), {cheaper.Name} scores {loVal:F1} versus {hiVal:F1} for {pricier.Name}, a gap of {diff:F1} points."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "purchasing-power");
        if (r?.WinnerSlug != null)
        {
            var isAWin = r.WinnerSlug == Model.StateA.Slug;
            var stronger = isAWin ? Model.StateA : Model.StateB;
            var weaker = isAWin ? Model.StateB : Model.StateA;
            var strongVal = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var weakVal = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add(($"Where does $100 go further, {titleA} or {titleB}?",
                $"$100 goes further in {stronger.Name}. After BEA regional price adjustments, $100 is worth about {strongVal ?? "-"} in {stronger.Name}, compared with {weakVal ?? "-"} in {weaker.Name}."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "land-area");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var larger = r.NumericA > r.NumericB ? Model.StateA : Model.StateB;
            var smaller = larger == Model.StateA ? Model.StateB : Model.StateA;
            var lrgVal = Math.Max(r.NumericA.Value, r.NumericB.Value);
            var smlVal = Math.Min(r.NumericA.Value, r.NumericB.Value);
            var ratio = Math.Round(lrgVal / smlVal, 1);
            faqItems.Add(($"Which state is bigger, {titleA} or {titleB}?",
                $"{larger.Name} is larger, covering {lrgVal:N0} sq mi compared with {smlVal:N0} sq mi for {smaller.Name}, roughly {ratio:F1}x the size."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "population");
        if (r?.WinnerSlug != null)
        {
            var isAWin = r.WinnerSlug == Model.StateA.Slug;
            var more = isAWin ? Model.StateA : Model.StateB;
            var less = isAWin ? Model.StateB : Model.StateA;
            var moreVal = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var lessVal = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add(($"Does {titleA} or {titleB} have more people?",
                $"{more.Name} has the larger population at {moreVal ?? "-"}, compared with {lessVal ?? "-"} in {less.Name}."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "median-income");
        if (r?.WinnerSlug != null)
        {
            var isAWin = r.WinnerSlug == Model.StateA.Slug;
            var higher = isAWin ? Model.StateA : Model.StateB;
            var lower = isAWin ? Model.StateB : Model.StateA;
            var hiVal = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var loVal = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add(($"Which state has higher household income, {titleA} or {titleB}?",
                $"{higher.Name} has the higher median household income at {hiVal ?? "-"}, versus {loVal ?? "-"} in {lower.Name}."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "income-tax");
        if (r?.WinnerSlug != null)
        {
            var isAWin = r.WinnerSlug == Model.StateA.Slug;
            var lower = isAWin ? Model.StateA : Model.StateB;
            var higher = isAWin ? Model.StateB : Model.StateA;
            var loVal = isAWin ? r.NumericA : r.NumericB;
            var hiDisp = isAWin ? r.DisplayValueB : r.DisplayValueA;
            var loDisp = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var answer = loVal == 0
                ? $"{lower.Name} has no state income tax, while {higher.Name} charges up to {hiDisp ?? "-"}."
                : $"{lower.Name} has the lower state income tax top rate at {loDisp ?? "-"}, compared with {hiDisp ?? "-"} in {higher.Name}.";
            faqItems.Add(($"Which state has lower income taxes, {titleA} or {titleB}?", answer));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "home-value");
        if (r?.WinnerSlug != null)
        {
            var isAWin = r.WinnerSlug == Model.StateA.Slug;
            var cheaper = isAWin ? Model.StateA : Model.StateB;
            var pricier = isAWin ? Model.StateB : Model.StateA;
            var chVal = isAWin ? r.DisplayValueA : r.DisplayValueB;
            var prVal = isAWin ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add(($"Is housing cheaper in {titleA} or {titleB}?",
                $"Homes are cheaper in {cheaper.Name}, where the median home value is {chVal ?? "-"}, versus {prVal ?? "-"} in {pricier.Name}."));
        }
    }
    {
        var r = Model.MetricResults.FirstOrDefault(x => x.Metric.Slug == "density");
        if (r?.NumericA.HasValue == true && r.NumericB.HasValue)
        {
            var denser = r.NumericA > r.NumericB ? Model.StateA : Model.StateB;
            var sparser = denser == Model.StateA ? Model.StateB : Model.StateA;
            var denVal = r.NumericA > r.NumericB ? r.DisplayValueA : r.DisplayValueB;
            var spaVal = r.NumericA > r.NumericB ? r.DisplayValueB : r.DisplayValueA;
            faqItems.Add(($"Which state is more densely populated, {titleA} or {titleB}?",
                $"{denser.Name} is more densely populated at {denVal ?? "-"} people per sq mi. {sparser.Name} is more spread out at {spaVal ?? "-"} people per sq mi."));
        }
    }

    var faqSchemaObj = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faqItems.Select(f => new Dictionary<string, object>
        {
            ["@type"] = "Question", ["name"] = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = f.Answer }
        }).ToArray()
    };
    var faqSchemaJson = System.Text.Json.JsonSerializer.Serialize(faqSchemaObj,
        new System.Text.Json.JsonSerializerOptions { WriteIndented = false });

    var overviewSources = new List<PageSource>
    {
        new() { Name = "U.S. Census Bureau — 2020 Census", Url = "https://www.census.gov/programs-surveys/decennial-census/decade/2020/2020-census-main.html" },
        new() { Name = "U.S. Census Bureau — American Community Survey", Url = "https://www.census.gov/programs-surveys/acs/data.html" },
        new() { Name = "U.S. Census Bureau — TIGER/Line Files", Url = "https://www.census.gov/geographies/mapping-files/time-series/geo/tiger-line-file.html" },
        new() { Name = "National Archives", Url = "https://www.archives.gov/" },
        new() { Name = "BEA — Regional Price Parities", Url = "https://www.bea.gov/data/prices-inflation/regional-price-parities-state-and-metro-area" },
        new() { Name = "BLS — State Labor Market Data", Url = "https://www.bls.gov/lau/" },
        new() { Name = "NOAA — U.S. Climate Normals", Url = "https://www.ncei.noaa.gov/products/land-based-station/us-climate-normals" },
        new() { Name = "FBI — Crime Data Explorer", Url = "https://cde.ucr.cjis.gov/" },
        new() { Name = "FEMA — National Risk Index", Url = "https://hazards.fema.gov/nri/" },
        new() { Name = "U.S. Department of Labor — State Minimum Wage Laws", Url = "https://www.dol.gov/agencies/whd/minimum-wage/state" },
        new() { Name = "AAA — Gas Prices", Url = "https://gasprices.aaa.com/" },
        new() { Name = "U.S. Energy Information Administration — Electricity", Url = "https://www.eia.gov/electricity/" },
        new() { Name = "NCSL — State Partisan Composition", Url = "https://www.ncsl.org/about-state-legislatures/state-partisan-composition" },
        new() { Name = "Giffords Law Center — Annual Gun Law Scorecard", Url = "https://giffords.org/lawcenter/resources/scorecard/" },
        new() { Name = "NABCA", Url = "https://www.nabca.org/" },
        new() { Name = "NCSL — State Medical Cannabis Laws", Url = "https://www.ncsl.org/health/state-medical-cannabis-laws" },
    };

    ViewData["Title"] = ViewData["Title"] ?? $"{titleA} vs {titleB}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/compare-redesign.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/compare-overview.css" asp-append-version="true">
}

<nav class="cmp2-crumbs">
    <div class="cmp2-shell" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <a href="/">Home</a><span>/</span>
        <a href="/compare-states">Compare States</a><span>/</span>
        <span class="cmp2-crumb-current">@titleA vs @titleB</span>
    </div>
</nav>

<div class="cmp2-page">

    @* ── 1. Scoreboard hero ─────────────────────────────────────────── *@
    <section class="cmp2-hero">
        <div class="cmp2-shell cmp2-hero-shell">
            <h1 class="cmp2-hero-title" id="cmp2-h1">@titleA vs @titleB</h1>
            @if (heroSummary != null)
            {
                <p class="cmp2-hero-verdict">@heroSummary</p>
            }

            <div class="cmp2-picker" id="cmp2-picker">
                <label class="cmp2-picker-field">
                    <span>First state</span>
                    <select id="cmp2-sel-a" aria-label="Change first state">
                        @foreach (var st in allStates)
                        {
                            <option value="@st.Slug" selected="@(st.Slug == Model.StateA.Slug)">@st.Name</option>
                        }
                    </select>
                </label>
                <button type="button" id="cmp2-swap" class="cmp2-picker-swap" aria-label="Swap display order" title="Swap display order"><i class="fa-solid fa-right-left" aria-hidden="true"></i></button>
                <label class="cmp2-picker-field">
                    <span>Second state</span>
                    <select id="cmp2-sel-b" aria-label="Change second state">
                        @foreach (var st in allStates)
                        {
                            <option value="@st.Slug" selected="@(st.Slug == Model.StateB.Slug)">@st.Name</option>
                        }
                    </select>
                </label>
            </div>

            <div class="cmp2-hero-split" id="cmp2-hero-split">
                <div class="cmp2-hero-side" data-side="a" style="--side-accent:@accent.HexA">
                    <img class="cmp2-hero-flag" src="@Images.Card(Model.StateA.FlagImageUrl)" alt="@Model.StateA.Name flag" onerror="this.style.display='none'" />
                    <div class="cmp2-hero-name">@Model.StateA.Name</div>
                    <div class="cmp2-hero-abbr">@Model.StateA.Abbreviation &middot; @(Model.StateA.Region ?? "United States")</div>
                    <div class="cmp2-hero-score">@overviewScore.WinsA<span class="cmp2-hero-score-of"> / @overviewScore.Total</span></div>
                    <div class="cmp2-hero-label">metrics led</div>
                    @if (overviewScore.Winner == Model.StateA)
                    {
                        <div class="cmp2-hero-winner-badge"><i class="fa-solid fa-check" aria-hidden="true"></i> Leads on @overviewScore.WinsA metrics</div>
                    }
                </div>
                <div class="cmp2-hero-mid"><div class="cmp2-hero-vs cmp-circle">VS</div></div>
                <div class="cmp2-hero-side" data-side="b" style="--side-accent:@accent.HexB">
                    <img class="cmp2-hero-flag" src="@Images.Card(Model.StateB.FlagImageUrl)" alt="@Model.StateB.Name flag" onerror="this.style.display='none'" />
                    <div class="cmp2-hero-name">@Model.StateB.Name</div>
                    <div class="cmp2-hero-abbr">@Model.StateB.Abbreviation &middot; @(Model.StateB.Region ?? "United States")</div>
                    <div class="cmp2-hero-score">@overviewScore.WinsB<span class="cmp2-hero-score-of"> / @overviewScore.Total</span></div>
                    <div class="cmp2-hero-label">metrics led</div>
                    @if (overviewScore.Winner == Model.StateB)
                    {
                        <div class="cmp2-hero-winner-badge"><i class="fa-solid fa-check" aria-hidden="true"></i> Leads on @overviewScore.WinsB metrics</div>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (bigDiffs.Count > 0)
    {
        <section class="cmp2-block cmp2-bigdiff" id="biggest-differences">
            <div class="cmp2-shell">
                <h2 class="cmp2-title">@bigDiffs.Count biggest differences</h2>
                <div class="cmp2-bigdiff-list">
                    @foreach (var d in bigDiffs)
                    {
                        var note = double.IsPositiveInfinity(d.Ratio)
                            ? (d.Result.NumericA == 0 ? $"{Model.StateA.Abbreviation} has none" : $"{Model.StateB.Abbreviation} has none")
                            : $"{(d.AIsHigher ? Model.StateA.Abbreviation : Model.StateB.Abbreviation)} is {d.Ratio.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}\u00d7 higher";
                        <a class="cmp2-bigdiff-row" href="/compare/@Model.PairSlug/@d.Result.Metric.Slug">
                            <span class="cmp2-bigdiff-name">@d.Result.Metric.Name</span>
                            <span class="cmp2-bigdiff-vals"><b style="--v:@accent.HexA">@d.Result.DisplayValueA</b><i>vs</i><b style="--v:@accent.HexB">@d.Result.DisplayValueB</b></span>
                            <span class="cmp2-bigdiff-note">@note</span>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <script>
    (function () {
        var selA = document.getElementById('cmp2-sel-a'), selB = document.getElementById('cmp2-sel-b');
        function go() {
            if (selA.value === selB.value) { return; }
            window.location.href = '/compare/' + [selA.value, selB.value].sort().join('-vs-');
        }
        selA.addEventListener('change', go);
        selB.addEventListener('change', go);

        // Swap only changes the order the two panels and the title are shown in; the URL stays canonical.
        var split = document.getElementById('cmp2-hero-split'), h1 = document.getElementById('cmp2-h1');
        var nameA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(titleA)), nameB = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(titleB));
        document.getElementById('cmp2-swap').addEventListener('click', function () {
            var swapped = split.classList.toggle('is-swapped');
            h1.textContent = swapped ? nameB + ' vs ' + nameA : nameA + ' vs ' + nameB;
        });
    })();
    </script>


    <article class="cmp2-page-shell max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8">
    <div class="min-w-0 article-content">

    @* ── 2. Decision module (priorities + consolidated calculator) ────── *@
    @await Html.PartialAsync("_DecisionModule", Model)

    @* ── 3. Unified metric comparison ──────────────────────────────────── *@
    @await Html.PartialAsync("_MetricComparisonList", metricListModel)

    @* ── 4. Where each state leads ──────────────────────────────────────── *@
    @if (leadRows.Any())
    {
        <section class="cmp2-block">
            <div class="cmp2-shell">
                <div class="cmp2-head">
                    <h2 class="cmp2-title">Where each state leads</h2>
                    <p class="cmp2-sub">The leader in each row is marked with a check and bold text.</p>
                </div>
                <div class="cmp2-leads">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Metric</th>
                                <th scope="col" style="--lead-accent:@accent.HexA"><img src="@Images.Card(Model.StateA.FlagImageUrl)" alt="" onerror="this.style.display='none'" />@Model.StateA.Name</th>
                                <th scope="col" style="--lead-accent:@accent.HexB"><img src="@Images.Card(Model.StateB.FlagImageUrl)" alt="" onerror="this.style.display='none'" />@Model.StateB.Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in leadRows)
                            {
                                var aLeads = r.WinnerSlug == Model.StateA.Slug;
                                <tr>
                                    <th scope="row"><a href="/compare/@Model.PairSlug/@r.Metric.Slug">@r.Metric.Name</a></th>
                                    <td class="@(aLeads ? "is-lead" : "")" style="--lead-accent:@accent.HexA">@if (aLeads) {<i class="fa-solid fa-check" aria-label="Leads"></i>}@r.DisplayValueA</td>
                                    <td class="@(!aLeads ? "is-lead" : "")" style="--lead-accent:@accent.HexB">@if (!aLeads) {<i class="fa-solid fa-check" aria-label="Leads"></i>}@r.DisplayValueB</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    @* ── 5. FAQ ──────────────────────────────────────────────────────────── *@
    @if (faqItems.Any())
    {
        <section class="cmp2-block">
            <div class="cmp2-shell">
                <div class="cmp2-head">
                    <h2 class="cmp2-title">@titleA vs @titleB FAQ</h2>
                </div>
                <div class="cmp2-faq-list">
                    @{ var faqIdx = 0; }
                    @foreach (var (q, a) in faqItems)
                    {
                        <details class="cmp2-faq-item cmp2-faq-details" open="@(faqIdx == 0)">
                            <summary class="cmp2-faq-q"><span class="cmp2-faq-q-mark">Q</span>@q</summary>
                            <p class="cmp2-faq-a">@a</p>
                        </details>
                        faqIdx++;
                    }
                </div>
            </div>
        </section>
    }

    @if (faqItems.Any())
    {
        <script type="application/ld+json">@Html.Raw(faqSchemaJson)</script>
    }

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{Model.StateA.Name} vs {Model.StateB.Name} | State Comparison")),
      "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"Compare {Model.StateA.Name} and {Model.StateB.Name} by demographics, housing, taxes, politics, cost of living, geography, and more.")),
      "url": "https://usasymbol.com/compare/@Model.PairSlug",
      "license": "https://usasymbol.com/terms",
      "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "https://usasymbol.com" },
      "about": [
        { "@@type": "AdministrativeArea", "name": "@Model.StateA.Name", "identifier": "@Model.StateA.Abbreviation" },
        { "@@type": "AdministrativeArea", "name": "@Model.StateB.Name", "identifier": "@Model.StateB.Abbreviation" }
      ],
      "breadcrumb": {
        "@@type": "BreadcrumbList",
        "itemListElement": [
          { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://usasymbol.com" },
          { "@@type": "ListItem", "position": 2, "name": "Compare States", "item": "https://usasymbol.com/compare-states" },
          { "@@type": "ListItem", "position": 3, "name": "@Model.StateA.Name vs @Model.StateB.Name", "item": "https://usasymbol.com/compare/@Model.PairSlug" }
        ]
      }
    }
    </script>

    @* ── 7. Methodology, sources, cite/embed ───────────────────────────── *@
    <section class="cmp2-block">
        <div class="cmp2-shell">
            <details class="cmp2-method-card cmp2-method-details">
                <summary class="cmp2-method-summary">Sources &amp; methodology <span>Dataset reviewed July 23, 2026</span></summary>
                <p class="cmp2-sub">Figures combine government datasets, named research sources, and clearly labeled derived scores.</p>
                <div class="cmp2-method-grid">
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Demographics &amp; geography</div><div class="cmp2-method-item-value">2020 Census, American Community Survey, TIGER/Line Files, National Archives</div></div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Income, housing &amp; cost of living</div><div class="cmp2-method-item-value">American Community Survey, BLS, BEA Regional Price Parities, and named market studies</div></div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Wages &amp; energy</div><div class="cmp2-method-item-value">U.S. Department of Labor, AAA, U.S. EIA</div></div>
                    <div class="cmp2-method-item"><div class="cmp2-method-item-label">Politics &amp; law</div><div class="cmp2-method-item-value">NCSL, Giffords Law Center, NABCA</div></div>
                </div>
                <p class="cmp2-sub">Data periods differ by metric. Open any individual comparison metric to see its primary source, data period, review date, and calculation note. Daily-changing fields such as gas prices are stored snapshots unless the page explicitly says a live feed is used.</p>
                <div style="border-top:1px solid var(--cmp-line);padding-top:16px;">
                    <h3 class="cmp2-title" style="font-size:18px;margin-bottom:10px;">Sources</h3>
                    <div class="cmp2-source-list">
                        @await Html.PartialAsync("_SourceLinksList", overviewSources)
                    </div>
                </div>
                <p class="cmp2-sub" style="margin-top:14px;">See our <a href="/editorial-policy" style="border-bottom:1px solid var(--cmp-gold);">editorial policy</a> for how we review and update these pages.</p>

                @{
                    var citeUrl = $"https://usasymbol.com/compare/{Model.PairSlug}";
                    var embedHtml = $"<a href=\"{citeUrl}\">{titleA} vs {titleB}: {overviewScore.WinsA}\u2013{overviewScore.WinsB} on {overviewScore.Total} scored metrics</a> (source: USA Symbol)";
                }
                <details class="cmp2-cite">
                    <summary>Cite or embed this comparison</summary>
                    <p class="cmp2-sub" style="margin:10px 0 6px;">Link: <a href="@citeUrl">@citeUrl</a></p>
                    <label class="cmp2-cite-label" for="cmp2-embed">HTML snippet</label>
                    <textarea id="cmp2-embed" class="cmp2-cite-box" rows="3" readonly onclick="this.select()">@embedHtml</textarea>
                </details>
            </details>
        </div>
    </section>

    @* ── Related comparisons + moving guides (relevance-ordered) ──────── *@
    <section class="cmp2-block">
        <div class="cmp2-shell">
            @if (Model.RelatedPairs.Any())
            {
                <div class="cmp2-head"><h2 class="cmp2-title">Related comparisons</h2></div>
                <div class="cmp2-related">
                    @foreach (var (pa, pb) in Model.RelatedPairs)
                    {
                        <a href="/compare/@(pa.Slug)-vs-@(pb.Slug)">
                            <span class="cmp2-related-flags">
                                <img src="@Images.Card(pa.FlagImageUrl)" alt="" onerror="this.style.display='none'" />
                                <img src="@Images.Card(pb.FlagImageUrl)" alt="" onerror="this.style.display='none'" />
                            </span>
                            <span>@pa.Name vs @pb.Name</span>
                        </a>
                    }
                </div>
            }
            <div class="cmp2-living-links cmp2-living-links--foot">
                <span>Moving between them?</span>
                <a href="/states/@Model.StateA.Slug/living">Living in @Model.StateA.Name</a>
                <a href="/states/@Model.StateB.Slug/living">Living in @Model.StateB.Name</a>
                <a href="/states/living">All 50 states</a>
                <a href="/state-match">Find Your State</a>
            </div>
        </div>
    </section>

    </div>
    </article>
</div>
