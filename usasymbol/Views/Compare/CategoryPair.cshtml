@model USASymbol.Models.ViewModels.CompareCategoryPairViewModel
@using System.Text.Json
@inject IImageUrlService Images

@{
    var pair = Model.Pair;
    var titleA = pair.StateA.Name;
    var titleB = pair.StateB.Name;
    ViewData["Title"] = ViewData["Title"] ?? $"{titleA} vs {titleB} | {Model.CategoryName} Comparison";
}

<!-- Sticky breadcrumb bar -->
<div class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-3">
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/compare-states" class="hover:text-slate-900 transition">Compare States</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/compare/@Model.CategorySlug" class="hover:text-slate-900 transition">@Model.CategoryName</a></li>
                <li class="text-slate-300">/</li>
                <li class="text-slate-900 font-semibold">@titleA vs @titleB</li>
            </ol>
        </nav>
    </div>
</div>

<div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-8 lg:py-12 article-content">

    <!-- HERO -->
    <section class="mb-8 lg:mb-10">
        <div class="border border-slate-200 bg-white shadow-sm p-6 sm:p-8 lg:p-10">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 mb-3">@Model.CategoryName Comparison</p>
            <div class="flex items-center gap-4 flex-wrap">
                <div class="flex items-center gap-3">
                    <img src="@Images.Card(pair.StateA.FlagImageUrl)" alt="@titleA flag" class="w-14 h-10 object-cover shadow-sm shrink-0" onerror="this.style.display='none'" />
                    <span class="text-2xl sm:text-3xl font-semibold text-slate-900">@titleA</span>
                </div>
                <span class="text-sm font-extrabold uppercase tracking-[0.18em] text-slate-400">vs</span>
                <div class="flex items-center gap-3">
                    <img src="@Images.Card(pair.StateB.FlagImageUrl)" alt="@titleB flag" class="w-14 h-10 object-cover shadow-sm shrink-0" onerror="this.style.display='none'" />
                    <span class="text-2xl sm:text-3xl font-semibold text-slate-900">@titleB</span>
                </div>
            </div>
            <p class="mt-4 text-base text-slate-600 leading-relaxed max-w-2xl">
                How @titleA and @titleB compare on @Model.CategoryName.ToLower(): @string.Join(", ", Model.CategoryResults.Take(3).Select(r => r.Metric.Name.ToLowerInvariant())), and more.
            </p>
            <div class="mt-5 flex flex-wrap gap-3 text-sm">
                <a href="/compare/@pair.PairSlug" class="inline-flex items-center gap-1.5 text-slate-700 hover:text-slate-900 font-semibold hover:underline">
                    <i class="fa-solid fa-table-list text-xs"></i> See the full comparison across all categories
                </a>
                <a href="/compare/@Model.CategorySlug" class="inline-flex items-center gap-1.5 text-slate-700 hover:text-slate-900 font-semibold hover:underline">
                    <i class="fa-solid fa-layer-group text-xs"></i> Browse @Model.CategoryName.ToLower() for all 50 states
                </a>
            </div>
        </div>
    </section>

    @if (Model.Spotlights.Any())
    {
        <!-- KEY DIFFERENCES -->
        <section class="mb-8 lg:mb-10">
            <div class="mb-5 max-w-3xl">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500 mb-2">Overview</p>
                <h2 class="text-xl md:text-2xl font-semibold text-slate-900">Key differences</h2>
            </div>
            <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var card in Model.Spotlights)
                {
                    <article class="border border-slate-200 bg-white p-5">
                        <div class="flex items-center gap-2.5 mb-3">
                            <span class="flex h-8 w-8 items-center justify-center bg-slate-100 text-slate-600 shrink-0">
                                <i class="@card.Icon text-xs"></i>
                            </span>
                            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">@card.Eyebrow</span>
                        </div>
                        <p class="text-sm leading-6 text-slate-700 mb-3">@card.Body</p>
                        <a href="@card.Link" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 hover:text-slate-600">
                            View detailed comparison
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </article>
                }
            </div>
        </section>
    }

    <!-- FULL TABLE -->
    <section class="mb-4">
        <div class="mb-5">
            <h2 class="text-xl md:text-2xl font-semibold text-slate-900">Full @Model.CategoryName Breakdown</h2>
        </div>
        <div class="overflow-x-auto border border-slate-200 shadow-sm">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 w-2/5">Metric</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                            <span class="inline-flex items-center gap-1.5">
                                <img src="@Images.Thumb(pair.StateA.FlagImageUrl)" alt="@titleA flag" class="w-6 h-4 object-cover shrink-0" onerror="this.style.display='none'" />
                                @pair.StateA.Abbreviation
                            </span>
                        </th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                            <span class="inline-flex items-center gap-1.5">
                                <img src="@Images.Thumb(pair.StateB.FlagImageUrl)" alt="@titleB flag" class="w-6 h-4 object-cover shrink-0" onerror="this.style.display='none'" />
                                @pair.StateB.Abbreviation
                            </span>
                        </th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500 hidden sm:table-cell w-24">Deep dive</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var result in Model.CategoryResults)
                    {
                        var winA = result.WinnerSlug == pair.StateA.Slug;
                        var winB = result.WinnerSlug == pair.StateB.Slug;
                        double? barA = null, barB = null;
                        if (result.NumericA.HasValue && result.NumericB.HasValue)
                        {
                            var mx = Math.Max(Math.Abs(result.NumericA.Value), Math.Abs(result.NumericB.Value));
                            if (mx > 0) { barA = Math.Round(Math.Abs(result.NumericA.Value) / mx * 100, 1); barB = Math.Round(Math.Abs(result.NumericB.Value) / mx * 100, 1); }
                        }
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="px-4 py-3.5">
                                <div class="flex items-center gap-2.5">
                                    <span class="w-7 h-7 bg-blue-50 flex items-center justify-center shrink-0">
                                        <i class="@result.Metric.Icon text-blue-600 text-[11px]"></i>
                                    </span>
                                    <div>
                                        <div class="font-medium text-slate-800 leading-tight">@result.Metric.Name</div>
                                        <div class="text-xs text-slate-400 hidden sm:block">@result.Metric.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3.5 text-center">
                                <span class="@(winA ? "font-bold text-emerald-700" : "text-slate-600")">@(result.DisplayValueA ?? "-")</span>
                                @if (winA) { <i class="fa-solid fa-trophy text-yellow-400 ml-1 text-[10px]"></i> }
                                @if (barA.HasValue)
                                {
                                    <div class="mt-1.5 h-1.5 bg-slate-100 overflow-hidden mx-auto max-w-16">
                                        <div class="h-full @(winA ? "bg-emerald-400" : "bg-slate-300")" style="width:@barA.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3.5 text-center">
                                <span class="@(winB ? "font-bold text-emerald-700" : "text-slate-600")">@(result.DisplayValueB ?? "-")</span>
                                @if (winB) { <i class="fa-solid fa-trophy text-yellow-400 ml-1 text-[10px]"></i> }
                                @if (barB.HasValue)
                                {
                                    <div class="mt-1.5 h-1.5 bg-slate-100 overflow-hidden mx-auto max-w-16">
                                        <div class="h-full @(winB ? "bg-emerald-400" : "bg-slate-300")" style="width:@barB.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3.5 text-center hidden sm:table-cell">
                                <a href="/compare/@pair.PairSlug/@result.Metric.Slug" class="text-blue-600 hover:text-blue-800 text-xs font-medium hover:underline">Details -></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebPage",
  "name": @Html.Raw(JsonSerializer.Serialize($"{titleA} vs {titleB} | {Model.CategoryName} Comparison")),
  "description": @Html.Raw(JsonSerializer.Serialize(ViewData["Description"] as string ?? "")),
  "url": "https://usasymbol.com/compare/@Model.CategorySlug/@pair.PairSlug",
  "about": [
    { "@@type": "AdministrativeArea", "name": "@titleA", "identifier": "@pair.StateA.Abbreviation" },
    { "@@type": "AdministrativeArea", "name": "@titleB", "identifier": "@pair.StateB.Abbreviation" }
  ],
  "breadcrumb": {
    "@@type": "BreadcrumbList",
    "itemListElement": [
      { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://usasymbol.com" },
      { "@@type": "ListItem", "position": 2, "name": "Compare States", "item": "https://usasymbol.com/compare-states" },
      { "@@type": "ListItem", "position": 3, "name": "@Model.CategoryName", "item": "https://usasymbol.com/compare/@Model.CategorySlug" },
      { "@@type": "ListItem", "position": 4, "name": "@titleA vs @titleB", "item": "https://usasymbol.com/compare/@Model.CategorySlug/@pair.PairSlug" }
    ]
  }
}
</script>
