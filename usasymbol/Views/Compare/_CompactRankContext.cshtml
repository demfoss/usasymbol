@using System.Globalization
@using USASymbol.Models.ViewModels
@model USASymbol.Models.ViewModels.MetricComparisonViewModel

@{
    var ranks = Model.AllStateRanks;
    if (ranks == null || ranks.Count < 3) { return; }

    var slugA = Model.StateA.Slug;
    var slugB = Model.StateB.Slug;
    var rowA  = ranks.FirstOrDefault(r => r.StateSlug == slugA);
    var rowB  = ranks.FirstOrDefault(r => r.StateSlug == slugB);
    if (rowA == null || rowB == null) { return; }

    var accentA = ViewData["AccentA"] as string ?? "#1D5A8F";
    var accentB = ViewData["AccentB"] as string ?? "#B45309";
    var higherBetter = Model.HigherIsBetter;
    var n = ranks.Count;

    // Strip position comes from the RANK, not the value: #1 sits at the left edge, last place at the right edge.
    double RankPct(int rank) => n > 1 ? Math.Round((rank - 1) / (double)(n - 1) * 100, 1) : 0;
    var pctA = Math.Clamp(RankPct(rowA.Rank), 3.0, 97.0);
    var pctB = Math.Clamp(RankPct(rowB.Rank), 3.0, 97.0);

    // One scale for the whole table: bar length is the value as a share of the national maximum.
    var globalMax = ranks.Max(r => r.Value);
    double BarPct(double val) => globalMax > 0 ? Math.Round(Math.Max(0, val) / globalMax * 100, 1) : 0;

    var focusRows = ranks.Take(10).ToList();
    var separateRows = new List<StateRankRow>();
    if (focusRows.All(r => r.StateSlug != slugA)) separateRows.Add(rowA);
    if (focusRows.All(r => r.StateSlug != slugB)) separateRows.Add(rowB);

    string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
    string Accent(string slug) => slug == slugA ? accentA : slug == slugB ? accentB : "";
    var metricLabel = Model.Metric.Name;
}

<section class="cmp2-block" id="national-rank">
    <div class="cmp2-shell">
        <div class="cmp2-head">
            <h2 class="cmp2-title">Where they rank nationally</h2>
            <p class="cmp2-sub">@Model.StateA.Name is #@rowA.Rank and @Model.StateB.Name is #@rowB.Rank of @n states for @metricLabel.ToLowerInvariant(). #1 is @(higherBetter ? "the highest value" : "the lowest, which is best").</p>
        </div>

        <div class="cmp2-rankstrip">
            <div class="cmp2-rankstrip-track"></div>
            <div class="cmp2-rankstrip-pin" style="left:@F(pctA)%;--pin:@accentA"><span>@Model.StateA.Abbreviation #@rowA.Rank</span></div>
            <div class="cmp2-rankstrip-pin is-low" style="left:@F(pctB)%;--pin:@accentB"><span>@Model.StateB.Abbreviation #@rowB.Rank</span></div>
            <div class="cmp2-rankstrip-axis"><span>#1 best</span><span>#@n</span></div>
        </div>

        <div class="cmp2-ranktable">
            <div class="cmp2-ranktable-head">
                <h3>@(higherBetter ? "Top 10" : "10 best") states for @metricLabel.ToLowerInvariant()</h3>
                @if (!higherBetter)
                {
                    <span class="cmp2-ranktable-note">Lower is better</span>
                }
            </div>
            @foreach (var row in focusRows.Concat(separateRows))
            {
                var a = Accent(row.StateSlug);
                var isSel = a != "";
                if (separateRows.Contains(row) && row == separateRows.First())
                {
                    <div class="cmp2-ranktable-gap">Your states</div>
                }
                <div class="cmp2-rankrow @(isSel ? "is-selected" : "")">
                    <span class="cmp2-rankrow-n">#@row.Rank</span>
                    @if (!string.IsNullOrEmpty(row.FlagImageUrl))
                    {
                        <img src="@row.FlagImageUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                    }
                    <span class="cmp2-rankrow-name">@row.StateName</span>
                    <span class="cmp2-rankrow-bar"><i style="width:@F(BarPct(row.Value))%;background:@(isSel ? a : "var(--cmp-line-strong)")"></i></span>
                    <span class="cmp2-rankrow-val">@row.FormattedValue</span>
                </div>
            }
        </div>
    </div>
</section>
