@model USASymbol.Models.ViewModels.CompareHubViewModel
@using System.Text.Json
@inject IImageUrlService Images

@{
    ViewData["Title"] = ViewData["Title"] ?? "Compare U.S. States";

    var pickerStates = Model.States
        .Select(s => new
        {
            slug = s.Slug,
            name = s.Name,
            abbr = s.Abbreviation,
            flag = s.FlagImageUrl != null ? Images.Card(s.FlagImageUrl) : null
        })
        .ToList();

    var neighbors = USASymbol.Services.ComparisonService.StateNeighborsByAbbreviation;
    var metrics = USASymbol.Services.ComparisonMetricsConfig.All;
    var metricGroups = USASymbol.Services.ComparisonMetricsConfig.GroupOrder;

    string? FlagFor(string slug)
    {
        var st = Model.States.FirstOrDefault(s => s.Slug == slug);
        return st?.FlagImageUrl != null ? Images.Card(st.FlagImageUrl) : null;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/compare-hub.css" asp-append-version="true">
}

<div class="ch-crumbs">
    <div class="ch-wrap">
        <nav aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-hidden="true">/</li>
                <li aria-current="page">Compare States</li>
            </ol>
        </nav>
    </div>
</div>

<main class="ch-wrap ch-main">

    <!-- HERO + BUILDER (one block) -->
    <section class="ch-builder" aria-labelledby="ch-title">
        <h1 id="ch-title">Compare U.S. States</h1>
        <p class="ch-intro">See how any two states differ on cost of living, taxes, housing, laws, climate, and more.</p>

        <form id="ch-form" class="ch-form" autocomplete="off">
            <div class="ch-field" id="ch-field-a">
                <label class="ch-label" for="ch-input-a">First state</label>
                <div class="ch-combo">
                    <img class="ch-flag" id="ch-flag-a" alt="" hidden />
                    <input id="ch-input-a" class="ch-input" type="text" role="combobox" aria-expanded="false" aria-controls="ch-list-a" aria-autocomplete="list" placeholder="Type a state, e.g. Texas" />
                    <button type="button" class="ch-clear" aria-label="Clear first state">&times;</button>
                </div>
                <ul id="ch-list-a" class="ch-list" role="listbox" hidden></ul>
            </div>

            <button type="button" id="ch-swap" class="ch-swap" aria-label="Swap states" title="Swap states">
                <i class="fa-solid fa-right-left"></i>
            </button>

            <div class="ch-field" id="ch-field-b">
                <label class="ch-label" for="ch-input-b">Second state</label>
                <div class="ch-combo">
                    <img class="ch-flag" id="ch-flag-b" alt="" hidden />
                    <input id="ch-input-b" class="ch-input" type="text" role="combobox" aria-expanded="false" aria-controls="ch-list-b" aria-autocomplete="list" placeholder="Type a state, e.g. Florida" />
                    <button type="button" class="ch-clear" aria-label="Clear second state">&times;</button>
                </div>
                <ul id="ch-list-b" class="ch-list" role="listbox" hidden></ul>
            </div>

            <button type="submit" id="ch-go" class="ch-go" disabled>
                <i class="fa-solid fa-scale-balanced"></i> Compare
            </button>
        </form>

        <p id="ch-hint" class="ch-hint" role="status" aria-live="polite"></p>

        <div id="ch-neighbors" class="ch-neighbors" aria-live="polite">
            <span>Compare <strong id="ch-neighbors-name"></strong> with a neighbor:</span>
            <span id="ch-neighbors-chips" style="display:contents"></span>
        </div>

        <p class="ch-source">
            Data: U.S. Census Bureau (2020 Census and ACS), BLS, BEA, NOAA, and other named sources &middot; Dataset reviewed July 23, 2026.
        </p>
    </section>

    @if (Model.GlanceRows.Count > 0)
    {
        var pairHref = $"/compare/{Model.GlanceSlugA}-vs-{Model.GlanceSlugB}";
        var flagA = FlagFor(Model.GlanceSlugA);
        var flagB = FlagFor(Model.GlanceSlugB);
        <!-- EXAMPLE RESULT -->
        <section class="ch-section" aria-labelledby="ch-glance-title">
            <h2 class="ch-h2" id="ch-glance-title">@Model.GlanceNameA vs @Model.GlanceNameB at a glance</h2>
            <div class="ch-glance">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Metric</th>
                            <th scope="col">@if (flagA != null) {<img class="ch-flag" src="@flagA" alt="" loading="lazy" />}@Model.GlanceNameA</th>
                            <th scope="col">@if (flagB != null) {<img class="ch-flag" src="@flagB" alt="" loading="lazy" />}@Model.GlanceNameB</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.GlanceRows)
                        {
                            <tr>
                                <th scope="row">@row.Label</th>
                                <td>@row.ValueA</td>
                                <td>@row.ValueB</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="ch-glance-foot">
                    <a class="ch-link" href="@pairHref">See the full @Model.GlanceNameA vs @Model.GlanceNameB comparison <i class="fa-solid fa-arrow-right" style="font-size:.7em"></i></a>
                </div>
            </div>
        </section>
    }

    <!-- POPULAR COMPARISONS -->
    <section class="ch-section" aria-labelledby="ch-pop-title">
        <h2 class="ch-h2" id="ch-pop-title">Popular Comparisons</h2>

        <p class="ch-pairs-title">Most compared</p>
        <div class="ch-pairs">
            @foreach (var pair in Model.FeaturedPairs)
            {
                <a class="ch-pair" href="/compare/@(USASymbol.Services.ComparisonService.CanonicalPairSlug(pair.Slug1, pair.Slug2))">
                    <span class="ch-pair-flags">
                        @if (FlagFor(pair.Slug1) is { } fa) { <img src="@fa" alt="" loading="lazy" /> }
                        @if (FlagFor(pair.Slug2) is { } fb) { <img src="@fb" alt="" loading="lazy" /> }
                    </span>
                    <span class="ch-pair-text"><span>@pair.Name1</span><span class="ch-pair-b"><b>vs</b> @pair.Name2</span></span>
                </a>
            }
        </div>

        @if (Model.NeighborPairs.Count > 0)
        {
            <p class="ch-pairs-title">Neighbors and moving routes</p>
            <div class="ch-pairs">
                @foreach (var pair in Model.NeighborPairs)
                {
                    <a class="ch-pair" href="/compare/@(USASymbol.Services.ComparisonService.CanonicalPairSlug(pair.Slug1, pair.Slug2))">
                        <span class="ch-pair-flags">
                            @if (FlagFor(pair.Slug1) is { } fa) { <img src="@fa" alt="" loading="lazy" /> }
                            @if (FlagFor(pair.Slug2) is { } fb) { <img src="@fb" alt="" loading="lazy" /> }
                        </span>
                        <span class="ch-pair-text"><span>@pair.Name1</span><span class="ch-pair-b"><b>vs</b> @pair.Name2</span></span>
                    </a>
                }
            </div>
        }
    </section>

    <!-- COMPARE BY CATEGORY -->
    <section class="ch-section" aria-labelledby="ch-cat-title">
        <h2 class="ch-h2" id="ch-cat-title">Compare By Category</h2>
        <p class="ch-sub">Pick a category to see all 50 states ranked on each of its metrics.</p>
        <div class="ch-cats">
            @foreach (var group in metricGroups)
            {
                <a href="/compare/@group.Slug" class="ch-cat">
                    <div class="ch-cat-head">
                        <span class="ch-cat-ico"><i class="@USASymbol.Services.ComparisonCategoryCopy.GetIcon(group.Slug)"></i></span>
                        <span class="ch-cat-name">@group.Name</span>
                    </div>
                    <p>@USASymbol.Services.ComparisonCategoryCopy.Get(group.Slug, group.Name)</p>
                    <span class="ch-cat-cta">See rankings <i class="fa-solid fa-arrow-right"></i></span>
                </a>
            }
        </div>
    </section>
</main>

<script>
(function () {
    var states = @Html.Raw(JsonSerializer.Serialize(pickerStates));
    var neighbors = @Html.Raw(JsonSerializer.Serialize(neighbors));
    var bySlug = {}, byAbbr = {};
    states.forEach(function (s) { bySlug[s.slug] = s; byAbbr[s.abbr] = s; });

    var form = document.getElementById('ch-form');
    var go = document.getElementById('ch-go');
    var hint = document.getElementById('ch-hint');
    var nbBox = document.getElementById('ch-neighbors');
    var nbName = document.getElementById('ch-neighbors-name');
    var nbChips = document.getElementById('ch-neighbors-chips');
    var sel = { a: null, b: null };

    function pairUrl(x, y) { return '/compare/' + [x, y].sort().join('-vs-'); }

    function refresh() {
        var same = sel.a && sel.b && sel.a === sel.b;
        go.disabled = !(sel.a && sel.b) || same;
        hint.textContent = same ? 'Pick two different states.' : '';
        renderNeighbors();
    }

    function renderNeighbors() {
        nbChips.innerHTML = '';
        var s = sel.a ? bySlug[sel.a] : null;
        var list = s ? (neighbors[s.abbr] || []) : [];
        if (!s || !list.length || sel.b) { nbBox.classList.remove('is-on'); return; }
        nbName.textContent = s.name;
        list.forEach(function (ab) {
            var n = byAbbr[ab]; if (!n) return;
            var a = document.createElement('a');
            a.className = 'ch-chip';
            a.href = pairUrl(s.slug, n.slug);
            if (n.flag) { var im = document.createElement('img'); im.src = n.flag; im.alt = ''; a.appendChild(im); }
            a.appendChild(document.createTextNode(n.name));
            nbChips.appendChild(a);
        });
        nbBox.classList.add('is-on');
    }

    function setup(slot) {
        var field = document.getElementById('ch-field-' + slot);
        var input = document.getElementById('ch-input-' + slot);
        var list = document.getElementById('ch-list-' + slot);
        var flag = document.getElementById('ch-flag-' + slot);
        var clear = field.querySelector('.ch-clear');
        var active = -1, shown = [];

        function paint() {
            var s = sel[slot] ? bySlug[sel[slot]] : null;
            input.value = s ? s.name : input.value;
            field.classList.toggle('has-value', !!s || input.value.length > 0);
            if (s && s.flag) { flag.src = s.flag; flag.alt = s.name + ' flag'; flag.hidden = false; } else { flag.hidden = true; }
        }
        function close() { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; }
        function choose(s) { sel[slot] = s.slug; paint(); close(); refresh(); }
        function render(q) {
            q = q.trim().toLowerCase();
            shown = states.filter(function (s) {
                return !q || s.name.toLowerCase().indexOf(q) !== -1 || s.abbr.toLowerCase() === q;
            }).sort(function (x, y) {
                var xs = q && x.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
                var ys = q && y.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
                return xs - ys || x.name.localeCompare(y.name);
            });
            list.innerHTML = '';
            if (!shown.length) { list.innerHTML = '<li class="ch-empty">No state matches.</li>'; }
            shown.forEach(function (s, i) {
                var li = document.createElement('li');
                li.className = 'ch-opt'; li.setAttribute('role', 'option'); li.id = 'ch-opt-' + slot + '-' + i;
                li.innerHTML = (s.flag ? '<img class="ch-flag" alt="" loading="lazy" src="' + s.flag + '">' : '<span class="ch-flag"></span>')
                    + '<span class="ch-abbr">' + s.abbr + '</span><span>' + s.name + '</span>';
                li.addEventListener('mousedown', function (e) { e.preventDefault(); choose(s); });
                list.appendChild(li);
            });
            active = shown.length && q ? 0 : -1;
            mark();
            list.hidden = false; input.setAttribute('aria-expanded', 'true');
        }
        function mark() {
            Array.prototype.forEach.call(list.querySelectorAll('.ch-opt'), function (el, i) {
                el.setAttribute('aria-selected', i === active ? 'true' : 'false');
                if (i === active) { el.scrollIntoView({ block: 'nearest' }); input.setAttribute('aria-activedescendant', el.id); }
            });
        }

        input.addEventListener('focus', function () { input.select(); render(sel[slot] ? '' : input.value); });
        input.addEventListener('input', function () {
            sel[slot] = null; flag.hidden = true; field.classList.toggle('has-value', input.value.length > 0);
            render(input.value); refresh();
        });
        input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') { e.preventDefault(); if (list.hidden) render(input.value); active = Math.min(shown.length - 1, active + 1); mark(); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(0, active - 1); mark(); }
            else if (e.key === 'Enter') {
                if (!list.hidden && shown[active >= 0 ? active : 0] && !sel[slot]) { e.preventDefault(); choose(shown[active >= 0 ? active : 0]); }
            }
            else if (e.key === 'Escape') { close(); }
        });
        input.addEventListener('blur', function () {
            close();
            if (!sel[slot]) { var exact = states.filter(function (s) { return s.name.toLowerCase() === input.value.trim().toLowerCase(); })[0]; if (exact) choose(exact); }
        });
        clear.addEventListener('click', function () {
            sel[slot] = null; input.value = ''; paint(); field.classList.remove('has-value'); refresh(); input.focus();
        });
        field._paint = paint;
    }

    setup('a'); setup('b');

    document.getElementById('ch-swap').addEventListener('click', function () {
        var t = sel.a; sel.a = sel.b; sel.b = t;
        ['a', 'b'].forEach(function (slot) {
            var input = document.getElementById('ch-input-' + slot);
            input.value = sel[slot] ? bySlug[sel[slot]].name : '';
            document.getElementById('ch-field-' + slot)._paint();
        });
        refresh();
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (go.disabled) return;
        window.location.href = pairUrl(sel.a, sel.b);
    });
})();
</script>
