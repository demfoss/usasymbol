@using System.Text.Json
@model USASymbol.Models.ViewModels.StateAbbreviationGuideViewModel

@{
    var state = Model.State;
    var baseUrl = "https://usasymbol.com";
    var pageUrl = $"{baseUrl}/states/{state.Slug}/abbreviation";
    var title = ViewData["Title"]?.ToString() ?? $"{state.Abbreviation} — {state.Name} State Abbreviation";
    var h1 = ViewData["H1"]?.ToString() ?? $"What Is the Abbreviation for {state.Name}?";
    var description = ViewData["Description"]?.ToString() ?? $"{state.Name}'s abbreviation is {state.Abbreviation}.";
    var code = state.Abbreviation;
    var hasTraditional = !string.Equals(Model.TraditionalAbbreviation, state.Name, StringComparison.OrdinalIgnoreCase);
    var gpoForm = USASymbol.Helpers.StateAbbreviationFacts.GpoForm(code);
    var hasGpo = hasTraditional && !string.IsNullOrWhiteSpace(gpoForm)
        && !string.Equals(gpoForm, Model.TraditionalAbbreviation, StringComparison.Ordinal);
    var wrongForms = USASymbol.Helpers.StateAbbreviationFacts.WrongForms(code);
    var whyNote = USASymbol.Helpers.StateAbbreviationFacts.WhyNote(code);
    var indefiniteArticle = "aeiou".Contains(char.ToLowerInvariant(state.Name[0])) ? "an" : "a";
    var zip = !string.IsNullOrWhiteSpace(Model.CapitalZip)
        ? Model.CapitalZip
        : USASymbol.Helpers.StateAbbreviationFacts.Zip(code) ?? "00000";
    var addressBlock = $"John Smith\n123 Main St\n{state.Capital}, {code} {zip}";

    var faqList = new List<(string Question, string Answer)>();
    if (hasTraditional)
    {
        faqList.Add((
            $"What is the old abbreviation for {state.Name}?",
            $"{Model.TraditionalAbbreviation} is the traditional form, still common in AP style and older print sources. The USPS introduced two-letter codes in 1963, and {code} is the one to use on envelopes, forms, and databases."));
    }
    else
    {
        faqList.Add((
            $"Is {state.Name} ever abbreviated?",
            $"AP style spells {state.Name} out in running text. The only abbreviation is the postal code {code}, used in addresses and forms."));
    }
    if (hasGpo)
    {
        faqList.Add((
            $"Is it {Model.TraditionalAbbreviation} or {gpoForm}?",
            $"Both are traditional forms: AP style uses {Model.TraditionalAbbreviation} and GPO style uses {gpoForm} For addresses, use {code}, not either one."));
    }
    var neighborText = Model.BorderingStates.Any()
        ? $" It borders {string.Join(", ", Model.BorderingStates.Select(s => s.Name))}."
        : string.Empty;
    faqList.Add((
        $"What state is {code}?",
        $"{code} is {state.Name}. The capital is {state.Capital}, and the state is in the {state.Region ?? "United States"} region.{neighborText}"));
    faqList.Add((
        $"Does {code} take a period?",
        $"No. Write {code} as two capital letters with no periods. Forms such as {string.Join(", ", wrongForms.Take(3))} are not valid in a postal address."));
    var faq = faqList.Select(f => new { f.Question, f.Answer }).ToArray();

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
    var faqSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(item => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = item.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = item.Answer
            }
        }).ToArray()
    };
    var breadcrumbSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Guides", ["item"] = $"{baseUrl}/guides" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "State Abbreviations", ["item"] = $"{baseUrl}/guides/state-abbreviations" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = state.Name, ["item"] = pageUrl }
        }
    };
}

@section Styles {
<style>
/* ── Shell ──────────────────────────────────────────── */
.sab-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
}

/* ── Hero ───────────────────────────────────────────── */
.sab-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    grid-template-rows: auto auto;
    border: 1px solid #dbe3ef;
    overflow: hidden;
}

.sab-hero-main {
    padding: 1.75rem 2rem 1.5rem;
    background: #fff;
    border-left: 3px solid #C09B4F;
}

.sab-kicker {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-bottom: 1rem;
    padding: .35rem .85rem;
    border-radius: 9999px;
    background: #1B2A4A;
    color: #fff;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.sab-hero-main h1 {
    margin: 0 0 .6rem;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -.03em;
    color: #0f172a;
}

.sab-hero-desc {
    margin: 0 0 1.1rem;
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
}

.sab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: .55rem;
}

.sab-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
    font-size: .86rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color .12s, background .12s;
}

.sab-action-btn--primary {
    background: #1B2A4A;
    color: #fff;
    border-color: #1B2A4A;
}

.sab-action-btn:hover          { border-color: #64748b; background: #f8fafc; }
.sab-action-btn--primary:hover { background: #2C3E6B; border-color: #2C3E6B; }

.sab-copy-note {
    font-size: .82rem;
    color: #64748b;
    min-height: 1.1rem;
}

/* AK display panel */
.sab-codebox {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #1B2A4A;
    border-left: 1px solid rgba(255,255,255,.06);
    padding: 2rem 1.25rem;
    cursor: pointer;
    border: none;
    color: #fff;
    transition: background .15s;
}

.sab-codebox:hover { background: #2C3E6B; }

.sab-code-letters {
    font-size: 5.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: .06em;
    color: #fff;
}

.sab-code-name {
    margin-top: .45rem;
    font-size: .75rem;
    color: rgba(255,255,255,.45);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
}

.sab-code-hint {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .7rem;
    border: 1px solid rgba(255,255,255,.15);
    color: rgba(255,255,255,.55);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .04em;
}

/* Stats bar */
.sab-statbar {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: #f8fafc;
    border-top: 1px solid #dbe3ef;
}

.sab-statbar-cell {
    padding: .8rem 1.25rem;
    border-right: 1px solid #dbe3ef;
}

.sab-statbar-cell:last-child { border-right: none; }

.sab-stat-label {
    display: block;
    margin-bottom: .2rem;
    color: #94a3b8;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.sab-stat-value {
    color: #0f172a;
    font-size: .96rem;
    font-weight: 700;
}

/* ── Page layout ─────────────────────────────────────── */
.sab-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.25rem;
    margin-top: 1.25rem;
}

/* ── Content sections ────────────────────────────────── */
.sab-section {
    border: 1px solid #dbe3ef;
    background: #fff;
    margin-bottom: .75rem;
    padding: 1.35rem 1.6rem 1.5rem;
    overflow: hidden;
}

.sab-section h2 {
    margin: 0 0 .6rem;
    color: #0f172a;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.3;
}

.sab-section p {
    margin: .7rem 0 0;
    color: #475569;
    line-height: 1.73;
    font-size: .97rem;
}

.sab-section h2 + p { margin-top: 0; }

/* Verify grid — gap technique: no inner borders, gap acts as divider */
.sab-verify {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: 1rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sab-verify-cell {
    padding: .75rem 1rem;
    background: #f8fafc;
}

.sab-verify-label {
    display: block;
    margin-bottom: .2rem;
    color: #94a3b8;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.sab-verify-value {
    color: #0f172a;
    font-size: .96rem;
    font-weight: 700;
}

/* Address block — left accent, no outer border */
.sab-address-block {
    margin: .85rem 0 .6rem;
    padding: .9rem 1rem .9rem 1.1rem;
    border-left: 3px solid #dbe3ef;
    background: #f8fafc;
    color: #0f172a;
    font-size: .9rem;
    font-weight: 700;
    white-space: pre-line;
    font-family: ui-monospace, 'Courier New', monospace;
    line-height: 1.8;
}

/* Link lists — no outer border, items separated by border-bottom */
.sab-list {
    display: grid;
    margin-top: .85rem;
    border-top: 1px solid #dbe3ef;
}

.sab-list a {
    display: block;
    padding: .78rem 1rem;
    border-bottom: 1px solid #dbe3ef;
    text-decoration: none;
    background: #fff;
    transition: background .1s;
}

.sab-list a:last-child { border-bottom: none; }
.sab-list a:hover      { background: #f8fafc; }

.sab-list strong {
    display: block;
    color: #0f172a;
    font-size: .94rem;
}

.sab-list span {
    display: block;
    margin-top: .12rem;
    color: #64748b;
    font-size: .86rem;
    line-height: 1.5;
}

/* Related questions grid — gap technique */
.sab-related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: .85rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sab-related-card {
    display: block;
    padding: .88rem 1rem;
    background: #fff;
    text-decoration: none;
    transition: background .1s;
}

.sab-related-card:hover { background: #f8fafc; }

.sab-related-card strong {
    display: block;
    color: #0f172a;
    font-size: .9rem;
    font-weight: 700;
    line-height: 1.4;
}

.sab-related-card span {
    display: block;
    margin-top: .2rem;
    color: #64748b;
    font-size: .84rem;
}

/* FAQ — no outer container border, items separated by border-top */
.sab-faq {
    margin: .75rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sab-faq details {
    border-bottom: 1px solid #dbe3ef;
    background: #fff;
}

.sab-faq details:last-child { border-bottom: none; }

.sab-faq summary {
    padding: .88rem 1.6rem;
    cursor: pointer;
    color: #0f172a;
    font-weight: 700;
    font-size: .92rem;
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    line-height: 1.4;
}

.sab-faq summary::-webkit-details-marker { display: none; }

.sab-faq summary::before {
    content: '▸';
    flex-shrink: 0;
    margin-top: .1em;
    color: #C09B4F;
    font-size: .8em;
}

.sab-faq details[open] summary::before { content: '▾'; }

.sab-faq details[open] summary {
    border-bottom: 1px solid #dbe3ef;
}

.sab-faq .faq-answer {
    padding: .8rem 1.6rem .88rem 2.75rem;
    margin: 0;
    color: #475569;
    line-height: 1.7;
    font-size: .93rem;
}

/* ── Sidebar ─────────────────────────────────────────── */
.sab-sidebar-sticky {
    position: sticky;
    top: 5.5rem;
}

.sab-sidebar-block {
    border: 1px solid #dbe3ef;
    background: #fff;
    margin-bottom: 1rem;
}

.sab-sidebar-head {
    padding: .55rem 1rem;
    border-bottom: 1px solid #dbe3ef;
    font-size: .57rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: #94a3b8;
    background: #f8fafc;
}

.sab-sidebar-list { display: grid; }

.sab-sidebar-list a {
    display: block;
    padding: .6rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    text-decoration: none;
    transition: background .1s;
}

.sab-sidebar-list a:last-child { border-bottom: none; }
.sab-sidebar-list a:hover      { background: #f8fafc; }

.sab-sidebar-list strong {
    display: block;
    color: #0f172a;
    font-size: .88rem;
    font-weight: 700;
}

.sab-sidebar-list span {
    display: block;
    margin-top: .08rem;
    color: #94a3b8;
    font-size: .79rem;
}

.sab-explore {
    padding: .85rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
}

.sab-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .4rem .75rem;
    border: 1px solid #dbe3ef;
    background: #f8fafc;
    color: #0f172a;
    font-weight: 700;
    font-size: .8rem;
    text-decoration: none;
    cursor: pointer;
    transition: border-color .1s, background .1s;
}

.sab-explore-btn--dark {
    background: #1B2A4A;
    color: #fff;
    border-color: #1B2A4A;
}

.sab-explore-btn:hover       { border-color: #94a3b8; }
.sab-explore-btn--dark:hover { background: #2C3E6B; border-color: #2C3E6B; }

/* Use-case checklist — gap technique */
.sab-usecases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: 1rem -1.6rem 0;
    border-top: 1px solid #dbe3ef;
}

.sab-usecase {
    padding: .65rem 1rem;
    background: #fff;
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .87rem;
    font-weight: 600;
    color: #0f172a;
}

.sab-usecase-check { color: #16a34a; flex-shrink: 0; }

/* AP Style compare — gap technique */
.sab-apstyle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: 1rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sab-apstyle-col {
    padding: .85rem 1.6rem 1.1rem;
    background: #fff;
}

.sab-apstyle-head {
    display: block;
    font-size: .57rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    margin-bottom: .45rem;
}

.sab-apstyle-head--postal { color: #16a34a; }
.sab-apstyle-head--style  { color: #7c3aed; }

.sab-apstyle-code {
    font-size: 1.4rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    display: block;
    margin-bottom: .3rem;
    letter-spacing: .02em;
}

.sab-apstyle-desc {
    font-size: .84rem;
    color: #64748b;
    line-height: 1.5;
}

/* Confusion warning callout */
.sab-callout {
    display: flex;
    gap: .65rem;
    align-items: flex-start;
    margin-top: 1rem;
    padding: .85rem 1rem;
    border: 1px solid #fde68a;
    background: #fffbeb;
}

.sab-callout-icon {
    color: #d97706;
    flex-shrink: 0;
    margin-top: .15rem;
    font-size: .95rem;
}

.sab-callout-text {
    font-size: .9rem;
    color: #78350f;
    line-height: 1.62;
    margin: 0;
}

/* ── Responsive ──────────────────────────────────────── */
@@media (max-width: 980px) {
    .sab-hero    { grid-template-columns: 1fr; }
    .sab-layout  { grid-template-columns: 1fr; }
    .sab-statbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .sab-statbar-cell:nth-child(2) { border-right: none; }
    .sab-statbar-cell:nth-child(3) { border-top: 1px solid #dbe3ef; }

    .sab-codebox {
        min-height: 140px;
        border-left: none;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .sab-related-grid { grid-template-columns: 1fr; }
    .sab-usecases     { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sab-apstyle      { grid-template-columns: 1fr; }

    .sab-sidebar-sticky { position: static; }
}

@@media (max-width: 640px) {
    .sab-hero-main { padding: 1.2rem 1.2rem 1.2rem; }
    .sab-verify    { grid-template-columns: 1fr; }
    .sab-usecases  { grid-template-columns: 1fr; }
}
/* ── Added: forms table, chips, breadcrumb, author ───── */
.sab-crumb-inner { max-width: 1180px; margin: 0 auto; padding: .75rem 1rem; }
.sab-author { margin-top: .75rem; }
.sab-note { margin-top: .5rem !important; font-size: .85rem !important; color: #64748b !important; }
.sab-forms-wrap { overflow-x: auto; margin: .35rem -1.6rem -1.5rem; border-top: 1px solid #dbe3ef; }
.sab-forms { width: 100%; border-collapse: collapse; }
.sab-forms th { padding: .7rem 1.6rem; background: #f1f5f9; color: #334155; font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; text-align: left; border-bottom: 1px solid #cbd5e1; }
.sab-forms td { padding: .8rem 1.6rem; border-bottom: 1px solid #f1f5f9; color: #334155; font-size: .93rem; vertical-align: middle; }
.sab-forms tr:last-child td { border-bottom: none; }
.sab-forms td:first-child { white-space: nowrap; }
.sab-form-ok { display: inline-block; padding: .2rem .6rem; background: #1B2A4A; color: #fff; font-weight: 800; letter-spacing: .04em; }
.sab-form-bad { display: inline-block; margin: .1rem .35rem .1rem 0; padding: .2rem .5rem; border: 1px solid #fecaca; background: #fef2f2; color: #b91c1c; font-weight: 700; text-decoration: line-through; }
.sab-chip-label { margin: .9rem 0 .4rem !important; color: #64748b !important; font-size: .75rem !important; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.sab-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
.sab-chip { display: inline-flex; align-items: center; gap: .45rem; padding: .25rem .7rem .25rem .3rem; border: 1px solid #dbe3ef; background: #f8fafc; color: #0f172a; font-size: .88rem; font-weight: 600; text-decoration: none; }
.sab-chip b { padding: .15rem .45rem; background: #1B2A4A; color: #fff; font-size: .8rem; letter-spacing: .05em; }
.sab-chip:hover { border-color: #94a3b8; background: #fff; }
.sab-links-row { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.1rem !important; font-size: .9rem !important; }
.sab-links-row a { color: #1B2A4A; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
@@media (max-width: 640px) {
    .sab-forms th, .sab-forms td { padding-left: 1.1rem; padding-right: 1.1rem; }
    .sab-forms-wrap { margin-left: -1.1rem; margin-right: -1.1rem; }
}
</style>
}

<div class="sab-crumb-inner">
    <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
            <li class="text-slate-300">/</li>
            <li><a href="/guides" class="hover:text-slate-900 transition">Guides</a></li>
            <li class="text-slate-300">/</li>
            <li><a href="/guides/state-abbreviations" class="hover:text-slate-900 transition">State Abbreviations</a></li>
            <li class="text-slate-300">/</li>
            <li class="text-slate-900 font-semibold">@state.Name</li>
        </ol>
    </nav>
</div>

<div class="sab-shell">

    <section class="sab-hero">

        <div class="sab-hero-main">
            <div class="sab-kicker">
                <i class="fa-solid fa-location-dot"></i>
                State Abbreviation Guide
            </div>
            <h1>@h1</h1>
            <p class="sab-hero-desc">
                The standard 2-letter abbreviation for <strong>@state.Name</strong> is <strong>@state.Abbreviation</strong>.
            </p>
            <div class="sab-actions">
                <button type="button" class="sab-action-btn sab-action-btn--primary"
                        data-copy-value="@state.Abbreviation" data-copy-label="@state.Abbreviation">
                    <i class="fa-regular fa-copy"></i>
                    Copy @state.Abbreviation
                </button>
                <button type="button" class="sab-action-btn"
                        data-copy-value="@addressBlock" data-copy-label="address format">
                    <i class="fa-regular fa-copy"></i>
                    Copy Address Format
                </button>
                @if (hasTraditional)
                {
                    <button type="button" class="sab-action-btn"
                            data-copy-value="@Model.TraditionalAbbreviation" data-copy-label="traditional form">
                        <i class="fa-regular fa-copy"></i>
                        Copy @Model.TraditionalAbbreviation
                    </button>
                }
            </div>
            <div class="sab-copy-note" id="sabCopyFeedback" aria-live="polite"></div>
        </div>

        <button type="button" class="sab-codebox"
                data-copy-value="@state.Abbreviation" data-copy-label="@state.Abbreviation"
                aria-label="Copy @state.Abbreviation">
            <span class="sab-code-letters">@state.Abbreviation</span>
            <span class="sab-code-name">@state.Name</span>
        </button>

        <div class="sab-statbar">
            <div class="sab-statbar-cell">
                <span class="sab-stat-label">State Abbreviation</span>
                <div class="sab-stat-value">@state.Abbreviation</div>
            </div>
            <div class="sab-statbar-cell">
                <span class="sab-stat-label">Traditional Form</span>
                <div class="sab-stat-value">@(hasTraditional ? Model.TraditionalAbbreviation : "Spelled out")</div>
            </div>
            <div class="sab-statbar-cell">
                <span class="sab-stat-label">Capital</span>
                <div class="sab-stat-value">@state.Capital</div>
            </div>
            <div class="sab-statbar-cell">
                <span class="sab-stat-label">Region</span>
                <div class="sab-stat-value">@(state.Region ?? "United States")</div>
            </div>
        </div>

    </section>

    <article class="sab-layout">
        <div class="article-content">

            <section class="sab-section">
                <h2>@state.Name Abbreviation Forms</h2>
                <div class="sab-forms-wrap">
                    <table class="sab-forms">
                        <thead>
                            <tr><th scope="col">Form</th><th scope="col">Where to use it</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="sab-form-ok">@state.Abbreviation</span></td>
                                <td>Mailing addresses, forms, spreadsheets, databases</td>
                            </tr>
                            @if (hasTraditional)
                            {
                                <tr>
                                    <td><span class="sab-form-ok">@Model.TraditionalAbbreviation</span></td>
                                    <td>AP style and news writing, when a city comes first</td>
                                </tr>
                                @if (hasGpo)
                                {
                                    <tr>
                                        <td><span class="sab-form-ok">@gpoForm</span></td>
                                        <td>GPO style, used in some government and legal writing</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td><span class="sab-form-ok">@state.Name</span></td>
                                    <td>AP style spells @state.Name out in running text</td>
                                </tr>
                            }
                            <tr>
                                <td>
                                    @foreach (var wrong in wrongForms)
                                    {
                                        <span class="sab-form-bad">@wrong</span>
                                    }
                                </td>
                                <td>Not valid for a postal address. A postal code has two capital letters and no periods.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="sab-section">
                <h2>How to Write @indefiniteArticle @state.Name Address</h2>
                <p>Write the city, a comma, the two-letter code, then the five-digit ZIP Code. No period after the code.</p>
                <div class="sab-address-block">@addressBlock</div>
                <p class="sab-note">The ZIP Code is an example from @state.Capital.</p>
            </section>

            @if (!string.IsNullOrWhiteSpace(whyNote) || (Model.StateSpecificParagraphs?.Any() ?? false))
            {
                <section class="sab-section">
                    <h2>Why @state.Name Is @state.Abbreviation</h2>
                    @if (!string.IsNullOrWhiteSpace(whyNote))
                    {
                        <p>@whyNote</p>
                    }
                    @foreach (var paragraph in Model.StateSpecificParagraphs ?? Enumerable.Empty<string>())
                    {
                        <p>@paragraph.RenderAutoLinks()</p>
                    }
                </section>
            }

            @if (Model.ConfusableStates.Any() || Model.BorderingStates.Any())
            {
                <section class="sab-section">
                    <h2>@state.Abbreviation Compared With Similar Codes</h2>
                    @if (Model.ConfusableStates.Any())
                    {
                        <p class="sab-chip-label">Often mixed up with</p>
                        <div class="sab-chips">
                            @foreach (var other in Model.ConfusableStates)
                            {
                                <a href="/states/@other.Slug/abbreviation" class="sab-chip"><b>@other.Abbreviation</b>@other.Name</a>
                            }
                        </div>
                    }
                    @if (Model.BorderingStates.Any())
                    {
                        <p class="sab-chip-label">Bordering states</p>
                        <div class="sab-chips">
                            @foreach (var other in Model.BorderingStates)
                            {
                                <a href="/states/@other.Slug/abbreviation" class="sab-chip"><b>@other.Abbreviation</b>@other.Name</a>
                            }
                        </div>
                    }
                    <p class="sab-links-row">
                        <a href="/guides/state-abbreviations">All state abbreviations</a>
                        <a href="/quizzes/state-abbreviations-quiz">State abbreviations quiz</a>
                        <a href="/states/@state.Slug">@state.Name symbols and facts</a>
                    </p>
                </section>
            }

            <section class="sab-section">
                <h2>FAQ</h2>
                <div class="sab-faq">
                    @foreach (var item in faq)
                    {
                        <details>
                            <summary>@item.Question</summary>
                            <p class="faq-answer">@item.Answer</p>
                        </details>
                    }
                </div>
            </section>

        </div>

        <aside class="article-sidebar hidden lg:block" aria-label="Explore more">
            <div class="sidebar-content">
                @await Html.PartialAsync("_GuidesAndRankingsSidebar")
            </div>
        </aside>
    </article>

    <div class="sab-author">
        @await Html.PartialAsync("_AuthorBox", new USASymbol.Models.ViewModels.AuthorBox { DateModified = new DateTime(2026, 11, 7) })
    </div>

</div>

<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumbSchema, jsonOptions))</script>
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(faqSchema, jsonOptions))</script>

<script>
(function () {
    function setCopyFeedback(message) {
        var el = document.getElementById('sabCopyFeedback');
        if (!el) return;
        el.textContent = message;
        window.clearTimeout(setCopyFeedback._t);
        setCopyFeedback._t = window.setTimeout(function () { el.textContent = ''; }, 1800);
    }

    function copyText(value, label) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(value).then(function () {
            setCopyFeedback('Copied ' + label + ' ✓');
        });
    }

    document.querySelectorAll('[data-copy-value]').forEach(function (el) {
        el.addEventListener('click', function () {
            copyText(el.getAttribute('data-copy-value') || '', el.getAttribute('data-copy-label') || 'value');
        });
    });
}());
</script>
