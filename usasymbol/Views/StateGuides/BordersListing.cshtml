@model USASymbol.Models.ViewModels.StateBordersListViewModel

@inject IImageUrlService Images

@{
    ViewData["Title"] = "Which U.S. States Border Each Other? – Complete Guide";
    ViewData["Description"] = $"Discover which U.S. states share borders. Explore all 50 states with interactive maps, neighbor lists, and landlocked info. {Model.InternationalBorderStates} states border Canada or Mexico.";

    var selectedFilter = Context.Request.Query["filter"].ToString();

     var filtered = Model.Items.AsEnumerable();
    if (!string.IsNullOrEmpty(selectedFilter))
    {
        filtered = selectedFilter switch
        {
            "ocean" => filtered.Where(x => x.HasOcean),
            "landlocked" => filtered.Where(x => x.IsLandlocked),
            "great-lakes" => filtered.Where(x => x.HasGreatLakes),
            "international" => filtered.Where(x => x.HasInternational),
            "most-borders" => filtered.Where(x => x.BorderCount >= 6),
            _ => filtered
        };
    }
    var list = filtered.ToList();
}

<!-- HERO SECTION -->
<section class="bg-blue-900 text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-semibold uppercase tracking-wide rounded-full bg-blue-800/70 border border-blue-500/40">
            <i class="fa-solid fa-map-location-dot mr-2"></i>
            State Borders Directory
        </span>

        <h1 class="text-4xl md:text-5xl font-extrabold mb-3">
            United States State Borders
        </h1>

        <p class="text-lg md:text-xl text-blue-100 mb-4">
            Explore the geographical boundaries of all 50 US states.
        </p>

        <div class="flex flex-wrap justify-center gap-4 md:gap-6 mt-6">
            <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-xl border border-white/20">
                <div class="text-3xl font-bold">@Model.TotalStates</div>
                <div class="text-sm text-blue-200">Total States</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-xl border border-white/20">
                <div class="text-3xl font-bold">@Model.CoastalStates</div>
                <div class="text-sm text-blue-200">Ocean Borders</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-xl border border-white/20">
                <div class="text-3xl font-bold">@Model.LandlockedStates</div>
                <div class="text-sm text-blue-200">Landlocked</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-xl border border-white/20">
                <div class="text-3xl font-bold">@Model.GreatLakesStates</div>
                <div class="text-sm text-blue-200">Great Lakes</div>
            </div>
        </div>
    </div>
</section>

<!-- SEARCH BAR -->
<section class="bg-white py-4 border-b sticky top-16 z-50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="relative w-full">
            <input id="borderSearch"
                   type="text"
                   placeholder="Search states by name..."
                   class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm md:text-base" />
            <i class="fa-solid fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>

        <p id="searchCount" class="text-sm text-gray-500 mt-2 hidden">
            Showing <span id="searchCountNumber"></span> results
        </p>
    </div>
</section>

<!-- FILTER SECTION -->
<section class="bg-white/95 backdrop-blur border-b sticky top-[120px] z-40 py-3">
    <div class="max-w-7xl mx-auto px-4">
        <!-- Mobile Layout -->
        <div class="md:hidden space-y-3">
            <div class="text-gray-600 text-sm">
                <span class="font-semibold">@list.Count</span> state@(list.Count == 1 ? "" : "s")
            </div>
            <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                <a href="/guides/state-borders"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(string.IsNullOrEmpty(selectedFilter) ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    All States
                </a>
                <a href="/guides/state-borders?filter=ocean"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(selectedFilter == "ocean" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🌊 Ocean
                </a>
                <a href="/guides/state-borders?filter=landlocked"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(selectedFilter == "landlocked" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🏔️ Landlocked
                </a>
                <a href="/guides/state-borders?filter=great-lakes"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(selectedFilter == "great-lakes" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🏞️ Great Lakes
                </a>
                <a href="/guides/state-borders?filter=international"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(selectedFilter == "international" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🌐 International
                </a>
                <a href="/guides/state-borders?filter=most-borders"
                   class="px-4 py-2 rounded-full text-sm font-medium transition whitespace-nowrap
                          @(selectedFilter == "most-borders" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🔗 6+ Borders
                </a>
            </div>
        </div>

        <!-- Desktop Layout -->
        <div class="hidden md:flex items-center justify-between gap-4">
            <div class="flex gap-2">
                <a href="/guides/state-borders"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(string.IsNullOrEmpty(selectedFilter) ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    All States
                </a>
                <a href="/guides/state-borders?filter=ocean"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(selectedFilter == "ocean" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🌊 Ocean
                </a>
                <a href="/guides/state-borders?filter=landlocked"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(selectedFilter == "landlocked" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🏔️ Landlocked
                </a>
                <a href="/guides/state-borders?filter=great-lakes"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(selectedFilter == "great-lakes" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🏞️ Great Lakes
                </a>
                <a href="/guides/state-borders?filter=international"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(selectedFilter == "international" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🌐 International
                </a>
                <a href="/guides/state-borders?filter=most-borders"
                   class="px-4 py-2 rounded-full text-sm font-medium transition
                          @(selectedFilter == "most-borders" ? "bg-blue-600 text-white shadow-sm" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    🔗 6+ Borders
                </a>
            </div>
            <div class="text-gray-600 text-sm">
                Showing <span class="font-semibold">@list.Count</span> state@(list.Count == 1 ? "" : "s")
            </div>
        </div>
    </div>
</section>

<!-- BORDERS GRID -->
<section class="py-10 md:py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
        @if (list.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @foreach (var item in list)
                {
                    var detailUrl = $"/states/{item.State.Slug}/borders";

                    <a href="@detailUrl"
                       data-border-card
                       data-name="@item.State.Name.ToLower()"
                       class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 hover:border-blue-200
                                      transition-all duration-300 overflow-hidden group flex flex-col h-full">

                        <!-- Image -->
                        <div class="aspect-video bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.MapImage))
                            {
                                <img src="@Images.Card(item.MapImage)"
                                     srcset="@(Images.Card(item.MapImage, 320)) 320w,
                                             @(Images.Card(item.MapImage, 480)) 480w,
                                             @(Images.Card(item.MapImage, 640)) 640w"
                                     sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
                                     alt="@item.State.Name border map"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="fa-solid fa-map text-4xl text-white/50"></i>
                                </div>
                            }

                            <!-- Border Count Badge -->
                            <div class="absolute top-2 left-2 bg-gray-900/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-white font-bold text-sm shadow-lg">
                                @item.BorderCount <span class="font-normal text-xs">@(item.BorderCount == 1 ? "border" : "borders")</span>
                            </div>

                            <!-- Type Badges -->
                            <div class="absolute top-2 right-2 flex flex-col gap-1">
                                @if (item.HasOcean)
                                {
                                    <span class="bg-blue-500/90 backdrop-blur-sm text-white px-2 py-1 rounded-full text-xs font-semibold shadow">
                                        🌊 Ocean
                                    </span>
                                }
                                @if (item.HasGreatLakes)
                                {
                                    <span class="bg-cyan-500/90 backdrop-blur-sm text-white px-2 py-1 rounded-full text-xs font-semibold shadow">
                                        🏞️ Lakes
                                    </span>
                                }
                                @if (item.HasInternational)
                                {
                                    <span class="bg-green-500/90 backdrop-blur-sm text-white px-2 py-1 rounded-full text-xs font-semibold shadow">
                                        🌐 Int'l
                                    </span>
                                }
                                @if (item.IsLandlocked)
                                {
                                    <span class="bg-amber-500/90 backdrop-blur-sm text-white px-2 py-1 rounded-full text-xs font-semibold shadow">
                                        🏔️ Landlocked
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-4 flex flex-col flex-1">
                            <div class="flex items-start justify-between gap-2 mb-2">
                                <h3 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition">
                                    @item.State.Name
                                </h3>
                                <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-700 font-semibold whitespace-nowrap">
                                    @item.State.Abbreviation
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.NeighborsList))
                            {
                                <div class="bg-gray-50 border-l-2 border-blue-500 rounded p-2.5 mb-3">
                                    <div class="text-[11px] text-gray-500 mb-0.5 font-medium uppercase tracking-wide">Neighbors</div>
                                    <div class="text-sm text-gray-700 leading-relaxed">@item.NeighborsList</div>
                                </div>
                            }
                            else if (item.BorderCount == 0)
                            {
                                <div class="bg-gray-50 rounded-lg p-2.5 mb-3">
                                    <div class="text-sm text-gray-500 italic flex items-center gap-1">
                                        <i class="fa-solid fa-info-circle text-xs"></i>
                                        No land borders with other states
                                    </div>
                                </div>
                            }

                            <!-- Border Features Tags -->
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                @if (item.HasOcean)
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 font-medium">Ocean</span>
                                }
                                @if (item.HasGreatLakes)
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full bg-cyan-50 text-cyan-700 font-medium">Lakes</span>
                                }
                                @if (item.HasInternational)
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full bg-green-50 text-green-700 font-medium">International</span>
                                }
                                @if (item.IsLandlocked)
                                {
                                    <span class="text-xs px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 font-medium">Landlocked</span>
                                }
                            </div>

                            <!-- View Details Link -->
                            <div class="mt-auto pt-3 border-t border-gray-100 flex items-center justify-between text-sm">
                                <span class="text-blue-600 font-semibold group-hover:underline">
                                    View border details
                                </span>
                                <span class="text-blue-600 transform group-hover:translate-x-1 transition-transform">
                                    →
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gray-100 flex items-center justify-center">
                    <i class="fa-solid fa-map-location-dot text-3xl text-gray-400"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-700 mb-2">No states found</h3>
                <p class="text-gray-500">Try adjusting your search or filter criteria</p>
            </div>
        }
    </div>
</section>

<!-- INFO SECTION -->
<section class="py-14 bg-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-6">
            <!-- About -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-2xl p-6 border border-blue-100">
                <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-4 shadow-lg">
                    <i class="fa-solid fa-info-circle text-xl"></i>
                </div>
                <h3 class="text-xl font-bold mb-2 text-gray-900">About State Borders</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    State borders define the official boundaries between US states, established through
                    historical treaties, surveys, and Congressional acts.
                </p>
            </div>

            <!-- Records -->
            <div class="bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-2xl p-6 border border-amber-100">
                <div class="w-12 h-12 rounded-xl bg-amber-600 text-white flex items-center justify-center mb-4 shadow-lg">
                    <i class="fa-solid fa-trophy text-xl"></i>
                </div>
                <h3 class="text-xl font-bold mb-2 text-gray-900">Border Records</h3>
                <ul class="text-sm text-gray-600 space-y-2">
                    <li class="flex items-start gap-2">
                        <span class="text-amber-600">🏆</span>
                        <span><strong>Most Borders:</strong> Missouri & Tennessee (8 each)</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-amber-600">📍</span>
                        <span><strong>Four Corners:</strong> AZ, CO, NM, UT meet at one point</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-amber-600">🏝️</span>
                        <span><strong>Island States:</strong> Alaska & Hawaii (no land borders)</span>
                    </li>
                </ul>
            </div>

            <!-- Statistics -->
            <div class="bg-gradient-to-br from-green-50 to-green-100/50 rounded-2xl p-6 border border-green-100">
                <div class="w-12 h-12 rounded-xl bg-green-600 text-white flex items-center justify-center mb-4 shadow-lg">
                    <i class="fa-solid fa-chart-simple text-xl"></i>
                </div>
                <h3 class="text-xl font-bold mb-2 text-gray-900">Quick Stats</h3>
                <div class="text-sm text-gray-600 space-y-2.5">
                    <div class="flex justify-between items-center">
                        <span>International Borders</span>
                        <strong class="text-green-700 text-base">@Model.InternationalBorderStates</strong>
                    </div>
                    <div class="flex justify-between items-center">
                        <span>Great Lakes States</span>
                        <strong class="text-green-700 text-base">@Model.GreatLakesStates</strong>
                    </div>
                    <div class="flex justify-between items-center">
                        <span>Landlocked States</span>
                        <strong class="text-green-700 text-base">@Model.LandlockedStates</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="text-center mt-10">
            <a href="/states"
               class="inline-flex items-center gap-2 bg-blue-600 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-blue-700 transition shadow-lg hover:shadow-xl">
                <span>Browse All States</span>
                <i class="fa-solid fa-arrow-right text-sm"></i>
            </a>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.getElementById("borderSearch");
        const cards = document.querySelectorAll("[data-border-card]");
        const searchCount = document.getElementById("searchCount");
        const searchCountNumber = document.getElementById("searchCountNumber");

        searchInput.addEventListener("input", function () {
            const q = this.value.trim().toLowerCase();
            let visible = 0;

            cards.forEach(card => {
                const name = card.getAttribute("data-name");
                const matches = name.includes(q);

                if (matches) {
                    card.style.display = "flex";
                    visible++;
                } else {
                    card.style.display = "none";
                }
            });

            if (q.length > 0) {
                searchCount.classList.remove("hidden");
                searchCountNumber.textContent = visible;
            } else {
                searchCount.classList.add("hidden");
            }
        });
    });
</script>

@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "CollectionPage",
          "name": "US State Borders Directory",
          "description": "Complete guide to borders of all @Model.TotalStates US states",
          "url": "https://usasymbol.com/guides/state-borders",
          "breadcrumb": {
            "@@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://usasymbol.com"
              },
              {
                "@@type": "ListItem",
                "position": 2,
                "name": "State Borders"
              }
            ]
          },
          "about": {
            "@@type": "Dataset",
            "name": "US State Borders Information",
            "description": "Directory of @Model.TotalStates US states with border information",
            "spatialCoverage": {
              "@@type": "Place",
              "name": "United States"
            }
          }
        }
    </script>
}
