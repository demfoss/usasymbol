@using System.IO
@using System.Text.Json
@model List<USASymbol.Models.State>
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = ViewData["Title"] ?? "US State Abbreviations List — All 50 States";
    ViewData["Description"] = ViewData["Description"] ?? "Complete list of U.S. state abbreviations in alphabetical order, with postal codes, capitals, regions, and common abbreviation mistakes.";
    ViewData["Canonical"] = ViewData["Canonical"] ?? "/guides/state-abbreviations";

    const string baseUrl = "https://usasymbol.com";

    var states = Model
        .OrderBy(s => s.Name)
        .ToList();

    var mapStates = states
        .Where(s => !string.IsNullOrWhiteSpace(s.Abbreviation) && !string.IsNullOrWhiteSpace(s.Slug))
        .Select(s => new
        {
            Key = s.Abbreviation.ToLowerInvariant(),
            s.Name,
            s.Abbreviation,
            s.Slug
        })
        .ToList();
    var svgMapPath = System.IO.Path.Combine(Env.WebRootPath, "maps", "us-states.svg");
    var svgMapMarkup = System.IO.File.Exists(svgMapPath)
        ? System.IO.File.ReadAllText(svgMapPath)
        : string.Empty;

    var confusingPairs = new[]
    {
        new
        {
            Heading = "AL vs AK vs AR vs AZ",
            Copy = "Alabama is AL, Alaska is AK, Arkansas is AR, and Arizona is AZ. All begin with A, so they are worth double-checking on forms and school lists."
        },
        new
        {
            Heading = "ME, MD, MA, MI, MN, MS, MO, MT",
            Copy = "The M-states cause more mix-ups than any other group: Maine (ME), Maryland (MD), Massachusetts (MA), Michigan (MI), Minnesota (MN), Mississippi (MS), Missouri (MO), and Montana (MT)."
        },
        new
        {
            Heading = "PA, RI, SC, SD, TN, TX",
            Copy = "Pennsylvania (PA), Rhode Island (RI), South Carolina (SC), South Dakota (SD), Tennessee (TN), and Texas (TX) are all worth a second look — their postal codes are not obvious at first glance."
        }
    };

    var faq = new[]
    {
        new
        {
            Question = "What is the difference between state abbreviations and postal abbreviations?",
            Answer = "In everyday use, most people mean the USPS two-letter postal codes such as CA, TX, and NY. Older traditional abbreviations were longer and often used periods, such as Calif., Tex., and N.Y."
        },
        new
        {
            Question = "When did the two-letter state abbreviations become standard?",
            Answer = "The USPS standardized the modern two-letter state abbreviations in 1963, alongside the introduction of ZIP Codes."
        },
        new
        {
            Question = "Are state postal abbreviations always written in capital letters?",
            Answer = "Yes. Standard postal abbreviations are written as two uppercase letters with no periods, such as AL, CA, and NY."
        },
        new
        {
            Question = "Can I use old-style abbreviations like Calif. or Penn.?",
            Answer = "You can use them in historical or editorial contexts, but for addresses, forms, and most modern writing, the USPS two-letter code is the safer choice."
        },
        new
        {
            Question = "Which state abbreviations are mixed up most often?",
            Answer = "The biggest trouble spots are usually the M-states, along with short codes such as AL, AK, AR, AZ, MD, ME, and PA."
        },
        new
        {
            Question = "Can I use state abbreviations without periods?",
            Answer = "Yes. The standard postal forms use two uppercase letters with no periods: FL, GA, OH, and so on."
        }
    };

    var faqSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(item => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = item.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = item.Answer
            }
        }).ToArray()
    };

    var breadcrumbSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Guides", ["item"] = $"{baseUrl}/guides" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "State Abbreviations", ["item"] = $"{baseUrl}/guides/state-abbreviations" }
        }
    };

    var pageSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = "US State Abbreviations List",
        ["description"] = ViewData["Description"]?.ToString(),
        ["author"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "USA Symbol Editorial Team" },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "USA Symbol",
            ["url"] = baseUrl
        },
        ["mainEntityOfPage"] = $"{baseUrl}/guides/state-abbreviations"
    };

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
}

@section Styles {
<style>
/* ── Shell ──────────────────────────────────────────── */
.sal-shell { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }

/* ── Hero ───────────────────────────────────────────── */
.sal-hero {
    border: 1px solid #dbe3ef;
    border-left: 3px solid #C09B4F;
    background: #fff;
    padding: 1.75rem 2rem 1.5rem;
}

.sal-kicker {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-bottom: 1rem;
    padding: .35rem .85rem;
    border-radius: 9999px;
    background: #1B2A4A;
    color: #fff;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.sal-hero h1 {
    margin: 0 0 .6rem;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -.03em;
    color: #0f172a;
}

.sal-hero-desc {
    margin: 0 0 1.1rem;
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
}

/* Stats bar */
.sal-statbar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: #f8fafc;
    border: 1px solid #dbe3ef;
    margin-top: 1.25rem;
}

.sal-statbar-cell {
    padding: .8rem 1.25rem;
    border-right: 1px solid #dbe3ef;
}

.sal-statbar-cell:last-child { border-right: none; }

.sal-stat-label {
    display: block;
    margin-bottom: .2rem;
    color: #94a3b8;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.sal-stat-value {
    color: #0f172a;
    font-size: .96rem;
    font-weight: 700;
}

/* ── Sections ────────────────────────────────────────── */
.sal-section {
    border: 1px solid #dbe3ef;
    background: #fff;
    margin-top: .75rem;
    padding: 1.35rem 1.6rem 1.5rem;
    overflow: hidden;
}

.sal-section h2 {
    margin: 0 0 .6rem;
    color: #0f172a;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.3;
}

.sal-section p {
    margin: .7rem 0 0;
    color: #475569;
    line-height: 1.73;
    font-size: .97rem;
}

.sal-section h2 + p { margin-top: 0; }

/* ── Map ─────────────────────────────────────────────── */
.sal-map-shell {
    overflow: hidden;
    border: 1px solid #dbe3ef;
    background: #f8fafc;
    margin-top: .85rem;
}

.sal-map-frame {
    margin: 1rem;
    padding: 1rem;
    background: #fff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 24px 48px -32px rgba(15,23,42,.18);
}

.sal-us-map svg { display: block; width: 100%; height: auto; }

.sal-us-map .state > a > path,
.sal-us-map .state > path { cursor: pointer; transition: fill .18s ease, filter .18s ease; }
.sal-us-map .state > a:hover > path,
.sal-us-map .state > a:focus > path,
.sal-us-map .state > a.is-active > path { fill: #bfd0ea; filter: drop-shadow(0 6px 10px rgba(15,23,42,.12)); }
.sal-us-map .state-labels a { text-decoration: none; }
.sal-us-map .state-labels a text { pointer-events: none; }
.sal-us-map .state-labels a:hover text,
.sal-us-map .state-labels a:focus text,
.sal-us-map .state-labels a.is-active text { fill: #1B2A4A; }

.sal-map-tip { margin-top: .65rem; color: #64748b; font-size: .86rem; }

/* ── Table ───────────────────────────────────────────── */
.sal-search {
    width: 100%;
    margin: .35rem 0 .85rem;
    padding: .75rem 1rem;
    border: 1px solid #dbe3ef;
    font-size: .96rem;
    color: #0f172a;
    background: #f8fafc;
    outline: none;
}

.sal-search:focus { border-color: #94a3b8; }

.sal-table-wrap {
    overflow-x: auto;
    border: 1px solid #dbe3ef;
    margin-top: .5rem;
}

.sal-table { width: 100%; border-collapse: collapse; min-width: 540px; }

.sal-table th {
    padding: .75rem 1rem;
    text-align: left;
    background: #f8fafc;
    color: #94a3b8;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    border-bottom: 1px solid #dbe3ef;
}

.sal-table td {
    padding: .85rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
    vertical-align: top;
}

.sal-table tr:last-child td { border-bottom: none; }
.sal-table tbody tr:hover { background: #f8fafc; }

.sal-state-link { color: #0f172a; font-weight: 700; text-decoration: none; }
.sal-state-link:hover { color: #1B2A4A; }

.sal-abbr-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    padding: .3rem .5rem;
    background: #1B2A4A;
    color: #fff;
    font-weight: 900;
    font-size: .88rem;
    letter-spacing: .06em;
}

.sal-region { color: #64748b; font-size: .9rem; }

/* ── Confused grid — gap technique ───────────────────── */
.sal-conf-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: .85rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sal-conf-cell {
    padding: .85rem 1.1rem 1rem;
    background: #fff;
}

.sal-conf-cell h3 {
    margin: 0 0 .4rem;
    color: #0f172a;
    font-size: .88rem;
    font-weight: 800;
    letter-spacing: -.01em;
}

.sal-conf-cell p {
    margin: 0;
    color: #475569;
    font-size: .88rem;
    line-height: 1.65;
}

/* ── Quiz CTA ────────────────────────────────────────── */
.sal-quiz {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: 1.5rem;
    align-items: center;
    border: 1px solid #1B2A4A;
    background: #1B2A4A;
    padding: 1.5rem 1.6rem;
    margin-top: .75rem;
}

.sal-quiz h2 { color: #f8fafc; margin: 0 0 .45rem; font-size: 1.1rem; }

.sal-quiz p { color: #94a3b8; font-size: .9rem; line-height: 1.65; margin: 0; }

.sal-quiz-btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .75rem 1.3rem;
    background: #C09B4F;
    color: #0f172a;
    font-weight: 800;
    font-size: .9rem;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
}

.sal-quiz-btn:hover { background: #d4aa5a; }

/* ── FAQ ─────────────────────────────────────────────── */
.sal-faq {
    margin: .75rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sal-faq details {
    border-bottom: 1px solid #dbe3ef;
    background: #fff;
}

.sal-faq details:last-child { border-bottom: none; }

.sal-faq summary {
    padding: .88rem 1.6rem;
    cursor: pointer;
    color: #0f172a;
    font-weight: 700;
    font-size: .92rem;
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    line-height: 1.4;
}

.sal-faq summary::-webkit-details-marker { display: none; }

.sal-faq summary::before {
    content: '▸';
    flex-shrink: 0;
    margin-top: .1em;
    color: #C09B4F;
    font-size: .8em;
}

.sal-faq details[open] summary::before { content: '▾'; }
.sal-faq details[open] summary { border-bottom: 1px solid #dbe3ef; }

.sal-faq .faq-answer {
    padding: .8rem 1.6rem .88rem 2.75rem;
    margin: 0;
    color: #475569;
    line-height: 1.7;
    font-size: .93rem;
}

/* ── Related — gap technique ─────────────────────────── */
.sal-related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: #dbe3ef;
    margin: .85rem -1.6rem -1.5rem;
    border-top: 1px solid #dbe3ef;
}

.sal-related a {
    display: block;
    padding: .88rem 1.1rem;
    background: #fff;
    text-decoration: none;
    transition: background .1s;
}

.sal-related a:hover { background: #f8fafc; }

.sal-related strong {
    display: block;
    color: #0f172a;
    font-size: .92rem;
    font-weight: 700;
    margin-bottom: .22rem;
}

.sal-related span { color: #64748b; font-size: .86rem; line-height: 1.55; }

/* ── Responsive ──────────────────────────────────────── */
@@media (max-width: 860px) {
    .sal-conf-grid, .sal-related { grid-template-columns: 1fr; }
    .sal-statbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sal-statbar-cell:nth-child(2) { border-right: none; }
    .sal-statbar-cell:nth-child(3) { border-top: 1px solid #dbe3ef; border-right: none; }
    .sal-quiz { grid-template-columns: 1fr; }
    .sal-hero { padding: 1.2rem 1.25rem; }
    .sal-section { padding: 1rem 1.1rem 1.1rem; }
    .sal-map-shell { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .sal-map-frame { min-width: 600px; }
    .sal-conf-grid, .sal-faq, .sal-related { margin-left: -1.1rem; margin-right: -1.1rem; }
}

@@media print {
    .sticky, nav, .sal-quiz, footer, header { display: none !important; }
    .sal-table-wrap { overflow: visible; border: none; }
    .sal-table { min-width: 0; font-size: 10pt; }
    .sal-abbr-badge { background: #000; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .sal-shell { padding: 0; }
    body::before { content: "usasymbol.com — US State Abbreviations"; display: block; text-align: center; font-size: 14pt; font-weight: bold; margin-bottom: 1rem; }
}
</style>
}

<div class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-3">
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/guides" class="hover:text-slate-900 transition">Guides</a></li>
                <li class="text-slate-300">/</li>
                <li class="text-slate-900 font-semibold">State Abbreviations</li>
            </ol>
        </nav>
    </div>
</div>

<main class="sal-shell">

    <section class="sal-hero">
        <div class="sal-kicker">
            <i class="fa-solid fa-table-cells-large"></i>
            All 50 States
        </div>
        <h1>US State Abbreviations List</h1>
        <p class="sal-hero-desc">
            All 50 U.S. state abbreviations in alphabetical order — two-letter USPS postal codes, capitals, and regions. Search below or open any state for the full guide.
        </p>

        <div class="sal-statbar">
            <div class="sal-statbar-cell">
                <span class="sal-stat-label">States covered</span>
                <div class="sal-stat-value">All 50</div>
            </div>
            <div class="sal-statbar-cell">
                <span class="sal-stat-label">Format</span>
                <div class="sal-stat-value">2-letter USPS</div>
            </div>
            <div class="sal-statbar-cell">
                <span class="sal-stat-label">Standard since</span>
                <div class="sal-stat-value">1963 (ZIP era)</div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(svgMapMarkup))
    {
        <section class="sal-section">
            <h2>US Map With State Abbreviations</h2>
            <p>Click any state to open its abbreviation guide.</p>
            <p class="sal-map-tip">On mobile, swipe the map to scroll.</p>

            <div class="sal-map-shell">
                <div id="salUsMap"
                     class="sal-us-map sal-map-frame"
                     data-map='@Html.Raw(JsonSerializer.Serialize(mapStates, jsonOptions))'>
                    @Html.Raw(svgMapMarkup)
                </div>
            </div>
        </section>
    }

    <section class="sal-section" id="state-abbreviation-table">
        <h2>All 50 State Abbreviations</h2>
        <p>Alphabetical. Each state name links to its full abbreviation guide.</p>

        <input id="salSearch"
               class="sal-search"
               type="text"
               placeholder="Search Alabama, AL, Montgomery, South…"
               autocomplete="off" />

        <div class="sal-table-wrap">
            <table class="sal-table">
                <thead>
                    <tr>
                        <th>State</th>
                        <th>Abbreviation</th>
                        <th>Capital</th>
                        <th>Region</th>
                    </tr>
                </thead>
                <tbody id="salTableBody">
                    @foreach (var state in states)
                    {
                        <tr data-search="@($"{state.Name} {state.Abbreviation} {state.Capital} {state.Region}").ToLowerInvariant()">
                            <td>
                                <a href="/states/@state.Slug/abbreviation" class="sal-state-link">@state.Name</a>
                            </td>
                            <td>
                                <span class="sal-abbr-badge">@state.Abbreviation</span>
                            </td>
                            <td>@state.Capital</td>
                            <td class="sal-region">@(string.IsNullOrWhiteSpace(state.Region) ? "United States" : state.Region)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="sal-section">
        <h2>Commonly Confused State Abbreviations</h2>
        <p>A few groups trip people up again and again — especially the A-states and M-states.</p>
        <div class="sal-conf-grid">
            @foreach (var pair in confusingPairs)
            {
                <div class="sal-conf-cell">
                    <h3>@pair.Heading</h3>
                    <p>@pair.Copy</p>
                </div>
            }
        </div>
    </section>

    <div class="sal-quiz">
        <div>
            <h2>Think You Know All 50 Abbreviations?</h2>
            <p>Free quiz — match states to codes and codes to states. M-states and I-states trip up most people.</p>
        </div>
        <a href="/quizzes/state-abbreviations-quiz" class="sal-quiz-btn">
            Take the Quiz
            <i class="fa-solid fa-arrow-right" style="font-size:.82rem;"></i>
        </a>
    </div>

    <section class="sal-section">
        <h2>FAQ</h2>
        <div class="sal-faq">
            @foreach (var item in faq)
            {
                <details>
                    <summary>@item.Question</summary>
                    <p class="faq-answer">@item.Answer</p>
                </details>
            }
        </div>
    </section>

    <section class="sal-section">
        <h2>Related Guides</h2>
        <div class="sal-related">
            <a href="/guides/state-borders">
                <strong>State Borders Guide</strong>
                <span>Which states border each other, plus coastal and landlocked states.</span>
            </a>
            <a href="/guides/surnames">
                <strong>Last Names by State</strong>
                <span>Common surnames and how they vary from state to state.</span>
            </a>
            <a href="/states">
                <strong>Browse All 50 States</strong>
                <span>Flags, symbols, mottos, and quick facts for every state.</span>
            </a>
        </div>
    </section>

    <div style="margin-top:1.5rem; max-width:860px;">
        @await Html.PartialAsync("_AuthorBox", new USASymbol.Models.ViewModels.AuthorBox { DateModified = new DateTime(2026, 5, 28) })
    </div>

</main>

<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(pageSchema, jsonOptions))</script>
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumbSchema, jsonOptions))</script>
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(faqSchema, jsonOptions))</script>

<script>
    (() => {
        const mapRoot = document.getElementById('salUsMap');
        if (!mapRoot) return;

        const svg = mapRoot.querySelector('svg');
        const states = JSON.parse(mapRoot.dataset.map || '[]');
        if (!svg || states.length === 0) return;

        const svgNs = 'http://www.w3.org/2000/svg';
        const xlinkNs = 'http://www.w3.org/1999/xlink';
        const byKey = new Map(states.map(state => [state.Key, state]));
        const stateGroup = svg.querySelector('g.state');
        const labelGroup = svg.querySelector('g.state-labels');
        if (!stateGroup) return;

        for (const path of Array.from(stateGroup.querySelectorAll('path'))) {
            const key = Array.from(path.classList)[0];
            const state = byKey.get(key);
            if (!state || path.parentElement?.tagName.toLowerCase() === 'a') continue;
            const pathLink = document.createElementNS(svgNs, 'a');
            pathLink.setAttributeNS(xlinkNs, 'href', `/states/${state.Slug}/abbreviation`);
            pathLink.setAttribute('href', `/states/${state.Slug}/abbreviation`);
            pathLink.setAttribute('aria-label', `${state.Name} abbreviation`);
            pathLink.dataset.stateKey = key;
            path.parentNode.insertBefore(pathLink, path);
            pathLink.appendChild(path);
        }

        if (labelGroup) {
            for (const text of Array.from(labelGroup.querySelectorAll('text'))) {
                const key = (text.textContent || '').trim().toLowerCase();
                const state = byKey.get(key);
                if (!state || text.parentElement?.tagName.toLowerCase() === 'a') continue;
                const textLink = document.createElementNS(svgNs, 'a');
                textLink.setAttributeNS(xlinkNs, 'href', `/states/${state.Slug}/abbreviation`);
                textLink.setAttribute('href', `/states/${state.Slug}/abbreviation`);
                textLink.setAttribute('aria-label', `${state.Name} abbreviation`);
                textLink.dataset.stateKey = key;
                text.parentNode.insertBefore(textLink, text);
                textLink.appendChild(text);
            }
        }

        const syncHover = (key, active) => {
            svg.querySelectorAll(`[data-state-key="${key}"]`).forEach(el => {
                el.classList.toggle('is-active', active);
            });
        };

        svg.querySelectorAll('[data-state-key]').forEach(el => {
            el.addEventListener('mouseenter', () => syncHover(el.dataset.stateKey, true));
            el.addEventListener('mouseleave', () => syncHover(el.dataset.stateKey, false));
            el.addEventListener('focus',      () => syncHover(el.dataset.stateKey, true));
            el.addEventListener('blur',       () => syncHover(el.dataset.stateKey, false));
        });
    })();

    (() => {
        const input = document.getElementById('salSearch');
        const rows  = Array.from(document.querySelectorAll('#salTableBody tr'));
        if (!input || rows.length === 0) return;
        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            for (const row of rows) {
                const haystack = row.getAttribute('data-search') || '';
                row.style.display = !q || haystack.includes(q) ? '' : 'none';
            }
        });
    })();
</script>
