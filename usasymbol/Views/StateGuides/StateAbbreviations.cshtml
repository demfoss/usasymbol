@using System.IO
@using System.Text.Json
@model List<USASymbol.Models.State>
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = ViewData["Title"] ?? "US State Abbreviations List — All 50 States";
    ViewData["Description"] = ViewData["Description"] ?? "Complete list of U.S. state abbreviations in alphabetical order, with postal codes, capitals, regions, and common abbreviation mistakes.";
    ViewData["Canonical"] = ViewData["Canonical"] ?? "/guides/state-abbreviations";

    const string baseUrl = "https://usasymbol.com";

    var states = Model
        .OrderBy(s => s.Name)
        .ToList();

    var topAbbreviationStates = (ViewData["TopAbbreviationStates"] as List<USASymbol.Models.State>) ?? new List<USASymbol.Models.State>();
    var editorialTopOrder = new[] { "california", "texas", "florida", "new-york", "pennsylvania", "massachusetts" };
    var editorialTopStates = editorialTopOrder
        .Select(slug => topAbbreviationStates.FirstOrDefault(s => string.Equals(s.Slug, slug, StringComparison.OrdinalIgnoreCase))
            ?? states.FirstOrDefault(s => string.Equals(s.Slug, slug, StringComparison.OrdinalIgnoreCase)))
        .Where(s => s is not null)
        .Cast<USASymbol.Models.State>()
        .ToList();
    string BuildTopCardTitle(USASymbol.Models.State state)
    {
        return state.Name switch
        {
            "California" => "California abbreviation",
            "Texas" => "Texas abbreviation",
            "Florida" => "Florida abbreviation",
            "New York" => "New York abbreviation",
            "Pennsylvania" => "Pennsylvania abbreviation",
            "Massachusetts" => "Massachusetts abbreviation",
            _ => $"{state.Name} abbreviation"
        };
    }
    string BuildTopCardCopy(USASymbol.Models.State state)
    {
        return state.Name switch
        {
            "California" => "California uses CA. People often check it when comparing the modern postal code with the older print form Calif.",
            "Texas" => "Texas is abbreviated TX, a short code that is easy to recognize but still common in address and classroom lookups.",
            "Florida" => "Florida uses FL. This page is a quick stop if you need the postal code for forms, labels, or mailing details.",
            "New York" => "New York uses NY. It is one of the best-known state abbreviations, but people still check it against older styles like N.Y.",
            "Pennsylvania" => "Pennsylvania uses PA. It is a frequent lookup because older forms such as Pa. and Penn. still show up in print.",
            "Massachusetts" => "Massachusetts uses MA. People often double-check it because the full state name is long and easy to shorten the wrong way.",
            _ => $"{state.Name} uses the postal abbreviation {state.Abbreviation}. Open the full guide for the quick answer, mailing use, and older forms you may still come across."
        };
    }
    var mapStates = states
        .Where(s => !string.IsNullOrWhiteSpace(s.Abbreviation) && !string.IsNullOrWhiteSpace(s.Slug))
        .Select(s => new
        {
            Key = s.Abbreviation.ToLowerInvariant(),
            s.Name,
            s.Abbreviation,
            s.Slug
        })
        .ToList();
    var svgMapPath = System.IO.Path.Combine(Env.WebRootPath, "maps", "us-states.svg");
    var svgMapMarkup = System.IO.File.Exists(svgMapPath)
        ? System.IO.File.ReadAllText(svgMapPath)
        : string.Empty;

    var confusingPairs = new[]
    {
        new
        {
            Heading = "AL vs AK vs AR vs AZ",
            Copy = "Alabama is AL, Alaska is AK, Arkansas is AR, and Arizona is AZ. These are easy to confuse because they all begin with A, so they are worth double-checking on forms and school lists."
        },
        new
        {
            Heading = "ME, MD, MA, MI, MN, MS, MO, MT",
            Copy = "The M-states cause more mix-ups than any other group: Maine (ME), Maryland (MD), Massachusetts (MA), Michigan (MI), Minnesota (MN), Mississippi (MS), Missouri (MO), and Montana (MT)."
        },
        new
        {
            Heading = "PA, RI, SC, SD, TN, TX",
            Copy = "Pennsylvania, Rhode Island, South Carolina, South Dakota, Tennessee, and Texas are all worth a second look because their postal abbreviations are not always obvious at first glance."
        }
    };

    var faq = new[]
    {
        new
        {
            Question = "What is the difference between state abbreviations and postal abbreviations?",
            Answer = "In everyday use, most people mean the USPS two-letter postal codes such as CA, TX, and NY. Older traditional abbreviations were longer and often used periods, such as Calif., Tex., and N.Y."
        },
        new
        {
            Question = "When did the two-letter state abbreviations become standard?",
            Answer = "The USPS standardized the modern two-letter state abbreviations in 1963, alongside the introduction of ZIP Codes."
        },
        new
        {
            Question = "Are state postal abbreviations always written in capital letters?",
            Answer = "Yes. Standard postal abbreviations are written as two uppercase letters with no periods, such as AL, CA, and NY."
        },
        new
        {
            Question = "Can I use old-style abbreviations like Calif. or Penn.?",
            Answer = "You can use them in historical or editorial contexts, but for addresses, forms, and most modern writing, the USPS two-letter code is the safer choice."
        },
        new
        {
            Question = "Which state abbreviations are mixed up most often?",
            Answer = "The biggest trouble spots are usually the M-states, along with short codes such as AL, AK, AR, AZ, MD, ME, and PA."
        },
        new
        {
            Question = "Can I use state abbreviations without periods?",
            Answer = "Yes. The standard postal forms use two uppercase letters with no periods: FL, GA, OH, and so on."
        }
    };

    var faqSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(item => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = item.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = item.Answer
            }
        }).ToArray()
    };

    var breadcrumbSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Guides", ["item"] = $"{baseUrl}/guides" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "State Abbreviations", ["item"] = $"{baseUrl}/guides/state-abbreviations" }
        }
    };

    var pageSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = "US State Abbreviations List",
        ["description"] = ViewData["Description"]?.ToString(),
        ["author"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "USA Symbol Editorial Team" },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "USA Symbol",
            ["url"] = baseUrl
        },
        ["mainEntityOfPage"] = $"{baseUrl}/guides/state-abbreviations"
    };

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
}

@section Styles {
<style>
.abbr-shell { max-width: 1200px; margin: 0 auto; padding: 0 1rem 4rem; }
.abbr-hero { margin-top: 1.5rem; padding: 2rem; border: 1px solid #e2e8f0; border-radius: 1.5rem; background: linear-gradient(135deg, #f8fafc 0%, #ffffff 45%, #eef2ff 100%); }
.abbr-kicker { display: inline-flex; align-items: center; gap: .55rem; margin-bottom: .9rem; padding: .45rem .8rem; border-radius: 999px; background: #111827; color: #fff; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.abbr-hero h1 { margin: 0 0 .8rem; color: #0f172a; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.02; font-weight: 900; letter-spacing: -.03em; }
.abbr-hero p { max-width: 54rem; margin: 0; color: #475569; font-size: 1.02rem; line-height: 1.75; }
.abbr-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; margin-top: 1.25rem; }
.abbr-stat { padding: 1rem 1.05rem; border: 1px solid #e2e8f0; border-radius: 1rem; background: rgba(255,255,255,.82); }
.abbr-stat strong { display: block; margin-bottom: .28rem; color: #0f172a; font-size: 1.2rem; line-height: 1.1; }
.abbr-stat span { color: #64748b; font-size: .9rem; line-height: 1.5; }
.abbr-section { margin-top: 2rem; padding: 1.4rem; border: 1px solid #e2e8f0; border-radius: 1.25rem; background: #fff; }
.abbr-section h2 { margin: 0 0 .7rem; color: #0f172a; font-size: 1.55rem; font-weight: 800; letter-spacing: -.02em; }
.abbr-section p { color: #475569; line-height: 1.75; margin: 0 0 .8rem; }
.abbr-map-shell { overflow: hidden; border: 1px solid #dbe4f0; border-radius: 1.35rem; background: radial-gradient(circle at top left, rgba(59,130,246,.14), transparent 34%), linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%); }
.abbr-map-frame { margin: 1rem; padding: 1rem; border-radius: 1rem; background: rgba(255,255,255,.82); box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 24px 48px -32px rgba(15,23,42,.28); }
.abbr-us-map svg { display:block; width:100%; height:auto; }
.abbr-us-map .state > a > path,
.abbr-us-map .state > path { cursor:pointer; transition: fill .18s ease, filter .18s ease; }
.abbr-us-map .state > a:hover > path,
.abbr-us-map .state > a:focus > path,
.abbr-us-map .state > a.is-active > path { fill:#bfd0ea; filter: drop-shadow(0 6px 10px rgba(15,23,42,.12)); }
.abbr-us-map .state-labels a { text-decoration:none; }
.abbr-us-map .state-labels a text { pointer-events:none; }
.abbr-us-map .state-labels a:hover text,
.abbr-us-map .state-labels a:focus text,
.abbr-us-map .state-labels a.is-active text { fill:#1d4ed8; }
.abbr-search { width: 100%; margin: .35rem 0 1rem; padding: .9rem 1rem; border: 1px solid #cbd5e1; border-radius: .9rem; font-size: .96rem; color: #0f172a; background: #f8fafc; }
.abbr-help { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1rem; }
.abbr-help span { display: inline-flex; align-items: center; gap: .35rem; padding: .45rem .75rem; border-radius: 999px; background: #f8fafc; color: #475569; font-size: .8rem; border: 1px solid #e2e8f0; }
.abbr-table-wrap { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 1rem; }
.abbr-table { width: 100%; border-collapse: collapse; min-width: 760px; }
.abbr-table th { padding: .9rem 1rem; text-align: left; background: #f8fafc; color: #334155; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; }
.abbr-table td { padding: .95rem 1rem; border-bottom: 1px solid #e2e8f0; color: #1e293b; vertical-align: top; }
.abbr-table tr:last-child td { border-bottom: none; }
.abbr-table tbody tr:hover { background: #fcfcfd; }
.abbr-state-link { color: #0f172a; font-weight: 700; text-decoration: none; }
.abbr-state-link:hover { color: #1d4ed8; }
.abbr-code { display: inline-flex; align-items: center; justify-content: center; min-width: 2.8rem; padding: .35rem .55rem; border-radius: .75rem; background: #111827; color: #fff; font-weight: 900; letter-spacing: .08em; }
.abbr-region { color: #64748b; font-size: .92rem; }
.abbr-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.abbr-card { padding: 1rem; border: 1px solid #e2e8f0; border-radius: 1rem; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); }
.abbr-card h3 { margin: 0 0 .55rem; color: #0f172a; font-size: 1rem; font-weight: 800; }
.abbr-card p { margin: 0; color: #475569; font-size: .94rem; line-height: 1.7; }
.abbr-faq { display: grid; gap: .85rem; }
.abbr-faq details { border: 1px solid #e2e8f0; border-radius: 1rem; padding: .9rem 1rem; background: #fff; }
.abbr-faq summary { cursor: pointer; color: #0f172a; font-weight: 700; }
.abbr-faq p { margin: .7rem 0 0; }
.abbr-related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.abbr-related a { display: block; padding: 1rem; border: 1px solid #e2e8f0; border-radius: 1rem; text-decoration: none; background: #fff; color: inherit; }
.abbr-related a:hover { border-color: #94a3b8; }
.abbr-related strong { display: block; margin-bottom: .35rem; color: #0f172a; font-size: 1rem; }
.abbr-related span { color: #64748b; font-size: .92rem; line-height: 1.6; }
.abbr-top-grid { display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:1rem; }
.abbr-top-card { display:block; padding:1rem; border:1px solid #e2e8f0; border-radius:1rem; text-decoration:none; background:linear-gradient(180deg,#fff 0%,#f8fafc 100%); }
.abbr-top-card:hover { border-color:#94a3b8; }
.abbr-top-card strong { display:block; color:#0f172a; font-size:1rem; }
.abbr-top-card .abbr-top-code { display:inline-flex; align-items:center; justify-content:center; min-width:2.5rem; margin:.6rem 0 .55rem; padding:.35rem .55rem; border-radius:.7rem; background:#111827; color:#fff; font-size:.88rem; font-weight:900; letter-spacing:.08em; }
.abbr-top-card p { margin:0; color:#64748b; font-size:.92rem; line-height:1.65; }
.abbr-mini-note { margin-top:1rem; padding:1rem 1.05rem; border:1px dashed #cbd5e1; border-radius:1rem; background:#f8fafc; }
.abbr-mini-note strong { color:#0f172a; }
.abbr-mini-note p { margin:0; color:#475569; font-size:.94rem; line-height:1.7; }
@@media (max-width: 900px) {
    .abbr-stats, .abbr-grid, .abbr-related, .abbr-top-grid { grid-template-columns: 1fr; }
    .abbr-hero { padding: 1.35rem; }
    .abbr-section { padding: 1rem; }
    .abbr-map-frame { margin: .75rem; padding: .75rem; }
}
@@media print {
    .sticky, nav, .abbr-kicker, .abbr-help, #abbrSearch,
    .abbr-section:not(#state-abbreviation-table),
    .abbr-bottom-row, footer, header { display: none !important; }
    #state-abbreviation-table { display: block !important; border: none; padding: 0; }
    .abbr-table-wrap { overflow: visible; border: none; }
    .abbr-table { min-width: 0; font-size: 10pt; }
    .abbr-code { background: #000; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .abbr-shell { padding: 0; }
    body::before { content: "usasymbol.com — US State Abbreviations List"; display: block; text-align: center; font-size: 14pt; font-weight: bold; margin-bottom: 1rem; }
}
</style>
}

<div class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-3">
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/guides" class="hover:text-slate-900 transition">Guides</a></li>
                <li class="text-slate-300">/</li>
                <li class="text-slate-900 font-semibold">State Abbreviations</li>
            </ol>
        </nav>
    </div>
</div>

<main class="abbr-shell">
    <section class="abbr-hero">
        <div class="abbr-kicker">
            <i class="fa-solid fa-table-cells-large"></i>
            All 50 States
        </div>
        <h1>US State Abbreviations List</h1>
        <p>
            This page gives you a clean, alphabetical list of all 50 U.S. state abbreviations using the standard two-letter postal codes. You can search by state, abbreviation, capital, or region, then open any state page if you want more details and official symbols.
        </p>
        <p style="margin-top:.9rem;">
            If you only need the quick answer, the table below is the fastest place to look. If you are trying to remember older print forms such as <em>Calif.</em> or <em>Pa.</em>, the notes farther down explain the difference.
        </p>

        <div class="abbr-stats">
            <div class="abbr-stat">
                <strong>50 postal abbreviations</strong>
                <span>Every U.S. state has one standard two-letter postal code.</span>
            </div>
            <div class="abbr-stat">
                <strong>Alphabetical by state</strong>
                <span>Quick to scan whether you are studying, checking an address, or building a reference list.</span>
            </div>
            <div class="abbr-stat">
                <strong>USPS standard since 1963</strong>
                <span>The modern abbreviations were standardized alongside the ZIP Code system.</span>
            </div>
        </div>

        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; margin-top:1.25rem;">
            <button onclick="window.print()"
                    style="display:inline-flex; align-items:center; gap:.5rem; padding:.65rem 1.1rem; border-radius:.85rem; background:#0f172a; color:#fff; font-weight:700; font-size:.88rem; border:none; cursor:pointer;"
                    title="Print or save as PDF">
                <i class="fa-regular fa-file-pdf" style="font-size:.85rem;"></i>
                Print / Save as PDF
            </button>
            <button id="abbrShareBtn"
                    style="display:inline-flex; align-items:center; gap:.5rem; padding:.65rem 1.1rem; border-radius:.85rem; background:#fff; color:#0f172a; font-weight:700; font-size:.88rem; border:1px solid #e2e8f0; cursor:pointer;">
                <i class="fa-solid fa-share-nodes" style="font-size:.85rem;"></i>
                Share
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(svgMapMarkup))
    {
        <section class="abbr-section">
        <h2>US Map With State Abbreviations</h2>
        <p>
            Click any state or label on the map to open its abbreviation page.
        </p>

            <div class="abbr-map-shell">
                <div id="abbrUsMap"
                     class="abbr-us-map abbr-map-frame"
                     data-map='@Html.Raw(JsonSerializer.Serialize(mapStates, jsonOptions))'>
                    @Html.Raw(svgMapMarkup)
                </div>
            </div>
        </section>
    }

    <section class="abbr-section" id="state-abbreviation-table">
        <h2>List of State Abbreviations and Capitals</h2>
        <p>
            The table below includes every state abbreviation used in U.S. mailing addresses, along with each state's capital and region. It is designed to be easy to scan whether you need a quick answer, a classroom reference, or a printable list.
        </p>

        <input id="abbrSearch"
               class="abbr-search"
               type="text"
               placeholder="Search Alabama, AL, Montgomery, South, Maine, ME..."
               autocomplete="off" />

        <div class="abbr-help">
            <span><i class="fa-solid fa-magnifying-glass"></i> Search by state, code, capital, or region</span>
            <span><i class="fa-solid fa-arrow-up-a-z"></i> Sorted alphabetically</span>
            <span><i class="fa-solid fa-link"></i> Each state opens a fuller abbreviation guide</span>
        </div>

        <div class="abbr-table-wrap">
            <table class="abbr-table">
                <thead>
                    <tr>
                        <th>State</th>
                        <th>Abbreviation</th>
                        <th>Capital</th>
                        <th>Region</th>
                    </tr>
                </thead>
                <tbody id="abbrTableBody">
                    @foreach (var state in states)
                    {
                        <tr data-search="@($"{state.Name} {state.Abbreviation} {state.Capital} {state.Region}").ToLowerInvariant()">
                            <td>
                                <a href="/states/@state.Slug/abbreviation" class="abbr-state-link">@state.Name</a>
                            </td>
                            <td><a href="/states/@state.Slug/abbreviation" class="abbr-code" style="text-decoration:none">@state.Abbreviation</a></td>
                            <td>@state.Capital</td>
                            <td class="abbr-region">@(string.IsNullOrWhiteSpace(state.Region) ? "United States" : state.Region)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="abbr-section">
        <h2>Popular State Abbreviation Pages</h2>
        <p>
            These are the abbreviation pages readers tend to open most often. The mix includes a few of the biggest states, plus a couple that people frequently double-check because of older print forms or easy mix-ups.
        </p>
        @if (editorialTopStates.Any())
        {
            <div class="abbr-top-grid">
                @foreach (var state in editorialTopStates)
                {
                    <a href="/states/@state.Slug/abbreviation" class="abbr-top-card">
                        <strong>@BuildTopCardTitle(state)</strong>
                        <span class="abbr-top-code">@state.Abbreviation</span>
                        <p>@BuildTopCardCopy(state)</p>
                    </a>
                }
            </div>
        }
        <div class="abbr-mini-note">
            <p><strong>Usually mixed up:</strong> AL, AK, AR, and AZ are easy to blur together at a glance, while the M-states cause the most repeat lookups in schoolwork, forms, and mailing lists.</p>
        </div>
    </section>

    <section class="abbr-section">
        <h2>Commonly Confused State Abbreviations</h2>
        <p>
            A few abbreviations trip people up again and again, especially the M-states and short codes like <strong>AL</strong>, <strong>ME</strong>, <strong>PA</strong>, and <strong>MD</strong>.
        </p>

        <div class="abbr-grid">
            @foreach (var pair in confusingPairs)
            {
                <article class="abbr-card">
                    <h3>@pair.Heading</h3>
                    <p>@pair.Copy</p>
                </article>
            }
        </div>
    </section>

    <section class="abbr-section" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); border-color: #1e293b;">
        <div style="display:grid; grid-template-columns: minmax(0,1fr) auto; gap: 1.5rem; align-items: center;">
            <div>
                <div style="display:inline-flex; align-items:center; gap:.45rem; margin-bottom:.75rem; padding:.38rem .7rem; border-radius:999px; background:rgba(250,204,21,.15); border:1px solid rgba(250,204,21,.25); color:#fde68a; font-size:.72rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase;">
                    Free Quiz
                </div>
                <h2 style="color:#f8fafc; margin-bottom:.55rem;">Think You Know All 50 Abbreviations?</h2>
                <p style="color:#94a3b8; max-width:38rem;">
                    The M-states and I-states trip up a lot of people. This free quiz works both ways: sometimes you match the state to the code, and sometimes you match the code to the state, with instant feedback after each answer.
                </p>
                <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-top:.85rem;">
                    <span style="padding:.35rem .7rem; border-radius:999px; background:rgba(255,255,255,.08); color:#cbd5e1; font-size:.8rem; border:1px solid rgba(255,255,255,.1);">50 questions</span>
                    <span style="padding:.35rem .7rem; border-radius:999px; background:rgba(255,255,255,.08); color:#cbd5e1; font-size:.8rem; border:1px solid rgba(255,255,255,.1);">Classic · Practice · Timed</span>
                    <span style="padding:.35rem .7rem; border-radius:999px; background:rgba(255,255,255,.08); color:#cbd5e1; font-size:.8rem; border:1px solid rgba(255,255,255,.1);">No signup needed</span>
                </div>
            </div>
            <div style="flex-shrink:0;">
                <a href="/quizzes/state-abbreviations-quiz"
                   style="display:inline-flex; align-items:center; gap:.5rem; padding:.85rem 1.4rem; border-radius:1rem; background:#fbbf24; color:#0f172a; font-weight:800; font-size:.97rem; text-decoration:none; white-space:nowrap; box-shadow:0 12px 28px rgba(251,191,36,.35);">
                    Take the Quiz
                    <i class="fa-solid fa-arrow-right" style="font-size:.85rem;"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="abbr-section">
        <h2>Postal Abbreviations vs. Traditional Abbreviations</h2>
        <p>
            Modern state abbreviations for mail are always two uppercase letters with no punctuation: <strong>CA</strong>, <strong>FL</strong>, <strong>OH</strong>, <strong>TX</strong>. Older editorial styles often used longer forms with periods, such as <em>Calif.</em>, <em>Fla.</em>, <em>Pa.</em>, or <em>Tenn.</em>.
        </p>
        <p>
            In most current writing, forms, and addresses, the USPS version is the one to use. Older forms still show up in historical material and older style guides, but the two-letter postal abbreviation is the modern standard.
        </p>
    </section>

    <section class="abbr-section">
        <h2>FAQ</h2>
        <div class="abbr-faq">
            @foreach (var item in faq)
            {
                <details>
                    <summary>@item.Question</summary>
                    <p>@item.Answer</p>
                </details>
            }
        </div>
    </section>

    <section class="abbr-section">
        <h2>Related State Guides</h2>
        <div class="abbr-related">
            <a href="/guides/state-borders">
                <strong>State Borders Guide</strong>
                <span>See which states border each other, plus which ones are coastal or landlocked.</span>
            </a>
            <a href="/guides/surnames">
                <strong>Last Names by State Guide</strong>
                <span>Explore common surnames and how they change from one state to another.</span>
            </a>
            <a href="/states">
                <strong>Browse All 50 States</strong>
                <span>Open the full state pages for symbols, flags, mottos, and other quick facts.</span>
            </a>
        </div>
    </section>

