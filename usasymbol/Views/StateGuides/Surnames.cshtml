    /* ── Tooltip (desktop hover) ─────────────────────── */
    .sn-tip { position: relative; }
    .sn-tip::after {
        content: attr(data-tip);
        position: absolute; bottom: calc(100% + 8px); left: 50%;
        transform: translateX(-50%);
        background: #1e293b; color: #f1f5f9;
        padding: 6px 11px; border-radius: 7px;
        font-size: 12px; font-weight: 500; white-space: nowrap;
        opacity: 0; pointer-events: none; transition: opacity .16s;
        z-index: 20; box-shadow: 0 4px 14px rgba(0,0,0,.2);
    }
    .sn-tip::before {
        content: '';
        position: absolute; bottom: calc(100% + 2px); left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent; border-top-color: #1e293b;
        opacity: 0; transition: opacity .16s; z-index: 21;
    }
    .sn-tip:hover::after, .sn-tip:hover::before { opacity: 1; }

    /* ── Details chevron ─────────────────────────────── */
    details .chev { transition: transform .2s; }
    details[open] .chev { transform: rotate(180deg); }

    .podium-grid {
        display: grid;
        gap: 12px;
    }
    .podium-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #fff;
    }
    .podium-card--first {
        border-width: 2px;
        border-color: #0f172a;
        background:
            radial-gradient(circle at top, rgba(250, 204, 21, 0.16), transparent 42%),
            linear-gradient(180deg, #0f172a 0%, #111827 100%);
    }
    .podium-step {
        display: none;
        background: #e2e8f0;
        border: 1px solid #cbd5e1;
        border-top: 0;
    }
    .origin-filter {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #fff;
        padding: 6px 10px;
        font-size: 13px;
        color: #475569;
    }
    .origin-filter.is-active {
        border-color: #0f172a;
        background: #0f172a;
        color: #fff;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.16);
    }
    .origin-filter.is-muted {
        opacity: .55;
    }
    .origin-header p,
    .origin-header + p {
        display: none;
    }
    .example-chip {
        display: inline-flex;
        align-items: center;
        border: 1px solid #e2e8f0;
