<div id="top"></div>

<main class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">

    <!-- Hero — full width before the two-column grid -->
    @await Html.PartialAsync("_PageHero", heroModel)

    <article class="w-full">
    <div class="lg:grid lg:grid-cols-[232px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[244px_minmax(0,1fr)_288px] xl:gap-10 2xl:grid-cols-[216px_minmax(0,760px)_280px] 2xl:justify-center 2xl:gap-12 relative pb-12">

        <aside class="hidden lg:block relative h-full">
            <div class="sticky top-24 pb-10">
                @await Html.PartialAsync("_TocSidebar", (object)Model)
            </div>
        </aside>

        <div class="min-w-0">

            <!-- TOP 3 PODIUM ─────────────────────────────── -->
            @if (top1 != null)
            {
                <section id="top-3" class="scroll-mt-24 mb-8">
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-4">Top 3 — @state.Name</p>
                    <div class="p-0">
                        <div class="podium-grid">
                        @{
                            var podium = new[] { top1, top2, top3 }.OfType<USASymbol.Models.Content.SurnameEntry>().ToList();
                            var order  = new[] { 1, 0, 2 }; // #2 left, #1 center, #3 right
                        }
                        @foreach (var idx in order)
                        {
                            if (idx >= podium.Count) continue;
                            var s = podium[idx];
                            var isFirst = s.Rank == 1;
                            var smOrder = isFirst ? "order-1 sm:order-2" : (s.Rank == 2 ? "order-2 sm:order-1" : "order-3 sm:order-3");
                            var stepClass = s.Rank == 1 ? "podium-step--rank-1" : (s.Rank == 2 ? "podium-step--rank-2" : "podium-step--rank-3");
                            var tip = $"1 in every {s.Ratio:N0} {state.Name} residents carries this surname";

                            <div class="podium-stack @smOrder @(isFirst ? "podium-stack--rank-1" : "")">
                                <div class="sn-tip podium-card flex flex-col @(isFirst ? "podium-card--first" : "")"
                                     data-tip="@tip">
                                @if (isFirst)
                                {
                                    <div class="h-[4px] bg-gradient-to-r from-amber-500 via-yellow-300 to-amber-500"></div>
                                }
                                        <div class="p-5 flex flex-col gap-3 flex-1">
                                    <div class="flex items-start justify-between gap-3">
                                        <span class="inline-flex h-8 w-8 items-center justify-center text-xs font-black tabular-nums
                                                     @(isFirst ? "bg-white/10 text-white/75" : "bg-slate-100 text-slate-500")">
                                            #@s.Rank
                                        </span>
                                        <span class="text-[10px] font-bold uppercase tracking-widest px-2.5 py-1
                                                     @(isFirst ? "bg-white/10 text-white/70" : $"badge-{s.Origin}")">
                                            @s.Origin
                                        </span>
                                    </div>
                                    <div>
                                        <div class="@(isFirst ? "text-[2.8rem] text-white sm:text-[3.15rem]" : "text-[2.15rem] text-slate-900 sm:text-[2.35rem]") font-black tracking-tight leading-none">
                                            @s.Name
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(s.Type))
                                        {
                                            <div class="text-[11px] font-semibold uppercase tracking-wider mt-2 @(isFirst ? "text-white/45" : "text-slate-400")">@s.Type</div>
                                        }
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-[1.55rem] font-bold tabular-nums @(isFirst ? "text-white" : "text-slate-800")">
                                            @s.Count.ToString("N0", CultureInfo.InvariantCulture)
                                        </span>
                                        <span class="text-sm @(isFirst ? "text-white/45" : "text-slate-400")">people</span>
                                    </div>
                                    <!-- Viral stat — always visible -->
                                    <div class="sm:hidden flex items-center gap-2 rounded-2xl @(isFirst ? "border border-white/10 bg-white/5 px-3 py-3" : "border border-slate-200 bg-slate-50 px-3 py-3")">
                                        <i class="fa-solid fa-person text-[10px] @(isFirst ? "text-amber-300" : "text-slate-300")"></i>
                                        <span class="text-[12px] font-semibold @(isFirst ? "text-amber-100" : "text-slate-600")">
                                            1 in every @s.Ratio.ToString("N0") @state.Name residents
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(s.Meaning))
                                    {
                                        <p class="text-[12px] leading-relaxed @(isFirst ? "text-white/60" : "text-slate-500")">@s.Meaning</p>
                                    }
                                </div>
                                </div>
                                <div class="podium-step @stepClass"></div>
                            </div>
                        }
                        </div>
                    </div>
                </section>
            }

            <!-- ORIGIN BREAKDOWN (horizontal strip) ──────── -->
            @{
                var originGroups = content.Surnames
                    .GroupBy(s => s.Origin, StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(g => g.Count())
                    .ToList();
                var totalNames = (double)content.Surnames.Count;
            }
            @if (originGroups.Any())
            {
                <section class="mb-10 border-t border-b border-slate-200/80 py-5">
                    <div class="origin-header mb-4 flex flex-wrap items-center justify-between gap-3">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Name origins â€” top @content.Surnames.Count surnames</p>
                        <button type="button"
                                id="originFilterReset"
                                class="hidden text-[12px] font-semibold text-slate-500 underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-500">
                            Show all origins
                        </button>
                        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Name origins - top @content.Surnames.Count surnames</span>
                    </div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-4">Name origins — top @content.Surnames.Count surnames</p>
                    <!-- Stacked bar -->
                    <div class="flex h-3 w-full overflow-hidden rounded-full mb-4 bg-slate-100">
                        @foreach (var g in originGroups)
                        {
                            var w = (g.Count() / totalNames * 100).ToString("F1", CultureInfo.InvariantCulture);
                            <button type="button"
                                    class="origin-filter-toggle h-full cursor-pointer"
                                    data-origin="@g.Key"
                                    style="width:@w%; background:@OriginColor(g.Key)"
                                    title="Filter surnames by @g.Key origin"></button>
                        }
                    </div>
                    <!-- Legend -->
                    <div class="flex flex-wrap gap-x-5 gap-y-2">
                        @foreach (var g in originGroups)
                        {
                            <button type="button"
                                    class="origin-filter origin-filter-toggle"
                                    data-origin="@g.Key"
                                    title="Filter surnames by @g.Key origin">
                                <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:@OriginColor(g.Key)"></span>
                                <span class="font-semibold">@(char.ToUpper(g.Key[0]) + g.Key[1..])</span>
                                <span class="text-slate-400">@g.Count()</span>
                            </button>
                        }
                    </div>
                </section>
            }

            <!-- HERITAGE INSIGHT ─────────────────────────── -->
            @if (!string.IsNullOrWhiteSpace(content.HeritageBody))
            {
                <section id="heritage" class="scroll-mt-24 mb-10">
                    <div class="border-l-2 border-slate-800 pl-5">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-1">Heritage</p>
                        <h2 class="text-[1.15rem] font-bold text-slate-900 mb-2">@(content.HeritageTitle ?? "About These Names")</h2>
                        <p class="text-[15px] text-slate-600 leading-relaxed">@content.HeritageBody.RenderAutoLinks()</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(content.FunFact))
                    {
                        <div class="mt-4 flex items-start gap-3 bg-amber-50 border border-amber-100 px-4 py-3">
                            <i class="fa-solid fa-star text-amber-400 text-[11px] mt-0.5 shrink-0"></i>
                            <p class="text-[13px] text-slate-700 leading-relaxed">
                                <span class="font-semibold">Did you know?</span> @content.FunFact
                            </p>
                        </div>
                    }
                </section>
            }

            <!-- FULL TABLE 1–20 ──────────────────────────── -->
            <section id="all-surnames" class="scroll-mt-24 mb-12">
                <div class="flex items-baseline justify-between gap-4 mb-5">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">Top @content.Surnames.Count Most Common Last Names in @state.Name</h2>
                        <p id="originFilterStatus" class="mt-1 text-[13px] text-slate-500">Showing all @content.Surnames.Count surnames</p>
                    </div>
                    <span class="text-[12px] text-slate-400 hidden sm:block">Tap a name to expand meaning</span>
                </div>

                <div id="surnameTable" class="border border-slate-200 divide-y divide-slate-200 bg-white">
                    @foreach (var s in allNames)
                    {
                        var pct    = (s.Count / maxCount * 100).ToString("F1", CultureInfo.InvariantCulture);
                        var tip    = $"Every {s.Ratio:N0}th resident of {state.Name} carries this name";
                        var isTop3 = s.Rank <= 3;
                        var rowBg  = isTop3 ? "bg-slate-50" : "bg-white";

                        if (!string.IsNullOrWhiteSpace(s.Meaning))
                        {
                        <details class="group border-l-4 origin-@s.Origin @rowBg" data-origin-row="@s.Origin">
                            <summary class="flex items-center gap-3 sm:gap-4 px-4 py-3.5 hover:bg-slate-50 transition cursor-pointer list-none select-none">
                                <span class="w-7 shrink-0 text-center text-[13px] font-bold tabular-nums @(isTop3 ? "text-slate-900" : "text-slate-400")">#@s.Rank</span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-[16px] font-black text-slate-900">@s.Name</span>
                                        <span class="tag-@s.Origin inline-block text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 leading-5">
                                            @s.Origin
                                        </span>
                                    </div>
                                    <div class="mt-1.5 h-[3px] w-full max-w-[240px] bg-slate-100">
                                        <div class="h-full dot-@s.Origin" style="width:@pct%"></div>
                                    </div>
                                </div>
                                <div class="shrink-0 text-right mr-1">
                                    <div class="text-[14px] font-bold tabular-nums text-slate-700">@s.Count.ToString("N0", CultureInfo.InvariantCulture)</div>
                                    <div class="text-[11px] text-slate-400">1 in @s.Ratio.ToString("N0")</div>
                                </div>
                                <i class="fa-solid fa-chevron-down chev text-slate-300 text-[10px] shrink-0"></i>
                            </summary>
                            <div class="px-4 pb-4 pt-2 ml-10 text-[13px] text-slate-500 leading-relaxed border-t border-slate-100">
                                @s.Meaning
                            </div>
                        </details>
                        }
                        else
                        {
                        <div class="flex items-center gap-3 sm:gap-4 px-4 py-3.5 border-l-4 origin-@s.Origin @rowBg" data-origin-row="@s.Origin">
                            <span class="w-7 shrink-0 text-center text-[13px] font-bold tabular-nums @(isTop3 ? "text-slate-900" : "text-slate-400")">#@s.Rank</span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-[16px] font-black text-slate-900">@s.Name</span>
                                    <span class="tag-@s.Origin inline-block text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 leading-5">
                                        @s.Origin
                                    </span>
                                </div>
                                <div class="mt-1.5 h-[3px] w-full max-w-[240px] bg-slate-100">
                                    <div class="h-full dot-@s.Origin" style="width:@pct%"></div>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="text-[14px] font-bold tabular-nums text-slate-700">@s.Count.ToString("N0", CultureInfo.InvariantCulture)</div>
                                <div class="text-[11px] text-slate-400">1 in @s.Ratio.ToString("N0")</div>
                            </div>
                        </div>
                        }
                    }
            </section>

            <!-- UNIQUELY THIS STATE ──────────────────────── -->
            @if (content.UniqueSurnames.Any())
            {
                <section id="unique" class="scroll-mt-24 mb-12">
                    <div class="mb-5">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-1">Local Insight</p>
                        <h2 class="text-xl font-bold text-slate-900">Uniquely @state.Name</h2>
                        <p class="text-[14px] text-slate-500 mt-1 max-w-xl">
                            These family names rank far higher in @state.Name than nationally — a direct fingerprint of the state's specific immigration waves.
                        </p>
                    </div>

                    <div class="border border-slate-200 divide-y divide-slate-200 bg-white">
                        @foreach (var u in content.UniqueSurnames)
                        {
                            var rankLift = Math.Max(0, u.NationalRank - u.StateRank);
                            <div class="px-5 py-5 border-l-4 origin-@u.Origin">
                                <div class="flex items-center gap-3 flex-wrap mb-2">
                                    <span class="text-[1.3rem] font-black text-slate-900">@u.Name</span>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 badge-@u.Origin">
                                        <span class="w-1.5 h-1.5 rounded-full dot-@u.Origin inline-block"></span>
                                        @u.Origin
                                    </span>
                                </div>
                                <p class="text-[13px] text-slate-700 leading-relaxed">
                                    Ranked <span class="font-semibold text-slate-900">#@u.StateRank in @state.Name</span>
                                    @if (u.NationalRank > 0)
                                    {
                                        <span> versus <span class="font-semibold text-slate-900">#@u.NationalRank nationally</span>.</span>
                                        @if (rankLift > 0)
                                        {
                                            <span> That is @rankLift spot@(rankLift == 1 ? "" : "s") higher here.</span>
                                        }
                                    }
                                    else
                                    {
                                        <span> and not reliably ranked nationally in this dataset.</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(u.Why))
                                {
                                    <p class="mt-2 text-[13px] text-slate-600 leading-relaxed">@u.Why</p>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- ETYMOLOGY BREAKDOWN ─────────────────────── -->
            @if (content.EtymologyGroups.Any())
            {
                <section id="etymology" class="scroll-mt-24 mb-12">
                    <div class="mb-5">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 mb-1">Etymology</p>
                        <h2 class="text-xl font-bold text-slate-900">@state.Name Last Name Meanings: Occupational, Patronymic & Habitational</h2>
                    </div>
                    <div class="border border-slate-200 divide-y divide-slate-200 bg-white">
                        @foreach (var eg in content.EtymologyGroups)
                        {
                            <div class="px-5 py-5">
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="inline-flex h-8 w-8 shrink-0 items-center justify-center bg-slate-100 text-slate-600">
                                        <i class="@eg.Icon text-sm"></i>
                                    </div>
                                    <h3 class="text-[15px] font-bold text-slate-900">@eg.Type</h3>
                                </div>
                                <p class="text-[13px] text-slate-600 leading-relaxed mb-3">@eg.Description.RenderMarkdown()</p>
                                @if (eg.Examples.Any())
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var ex in eg.Examples)
                                        {
                                            <span class="example-chip">
                                                @ex
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- FAQ — matches site _Faq.cshtml style ────── -->
            @if (content.Faq.Any())
            {
                <section id="faq" class="scroll-mt-24 mb-12">
                    <div class="border border-slate-200 bg-white">
                        <div class="px-5 py-4 sm:px-6">
                            <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Quick Answers</h2>
                        </div>
                        <div class="divide-y divide-slate-200/80">
                            @foreach (var faq in content.Faq)
                            {
                                <details class="group">
                                    <summary class="list-none cursor-pointer px-5 py-4 sm:px-6 flex items-start justify-between gap-4 hover:bg-white/50 transition">
                                        <span class="text-[15px] font-semibold text-slate-900 leading-7">@faq.Question</span>
                                        <span class="shrink-0 mt-0.5 flex h-8 w-8 items-center justify-center bg-slate-100 text-slate-600 group-hover:text-slate-800 transition">
                                            <i class="fas fa-chevron-down text-xs chev"></i>
                                        </span>
                                    </summary>
                                    <div class="px-5 pb-5 sm:px-6 -mt-1">
                                        <div class="text-[14px] leading-6 text-slate-600">@faq.Answer</div>
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                </section>
            }

            <!-- SOURCES — matches site _Sources.cshtml style -->
            @if (content.Sources.Any())
            {
                <section id="sources" class="scroll-mt-24">
                    <div class="border-b border-slate-200/80 pb-4 mb-5">
                        <h2 class="text-[1.8rem] font-semibold leading-none text-slate-900">Sources</h2>
                    </div>
                    <ul class="space-y-2.5">
                        @foreach (var src in content.Sources)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(src.Url))
                                {
                                    <a href="@src.Url" target="_blank" rel="nofollow noopener noreferrer"
                                       class="inline-flex items-center gap-2 text-[1rem] leading-7 text-slate-600 underline decoration-slate-300 underline-offset-4 transition hover:text-slate-900 hover:decoration-slate-500">
                                        @src.Name
                                        <i class="fa-solid fa-arrow-up-right-from-square text-[11px] opacity-70"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-[1rem] leading-7 text-slate-600">@src.Name</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(src.Description))
                                {
                                    <span class="text-[14px] text-slate-400"> — @src.Description</span>
                                }
                            </li>
                        }
                    </ul>
                    <div class="mt-6 border-t border-slate-200/70 pt-4">
                        <div class="text-[12px] text-slate-400">Information is cross-referenced with official state archives.</div>
                    </div>
                </section>
            }

            <div class="mt-10 space-y-8 xl:hidden">
                @await Html.PartialAsync("_QuickFacts", (IReadOnlyList<QuickFactItem>)quickFacts)
                @await Html.PartialAsync("_RelatedStatesSidebar", (IStateScopedViewModel)Model)
                @await Html.PartialAsync("_GuidesAndRankingsSidebar")
            </div>

        </div><!-- /main col -->

        <aside class="mt-12 hidden xl:block xl:col-span-1 xl:mt-0 relative self-start">
            <section class="relative min-h-[calc(100vh-5rem)] pb-16">
                <div class="sticky top-32 pr-2">

                <!-- Quick facts via existing partial -->
                @await Html.PartialAsync("_QuickFacts", (IReadOnlyList<QuickFactItem>)quickFacts)

                </div>
            </section>

            <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                <div class="sticky top-32 pr-2">
                    @await Html.PartialAsync("_RelatedStatesSidebar", (IStateScopedViewModel)Model)
                </div>
            </section>

            <section class="relative mt-10 min-h-[calc(100vh+8rem)] pb-20">
                <div class="sticky top-32 pr-2">
                    @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                </div>
