<script>
    // Scroll progress bar
    window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const bar = document.getElementById('progressBar');
        if (bar) bar.style.width = (h > 0 ? Math.min(window.scrollY / h * 100, 100) : 0) + '%';
    });

    // Touch toast — shows tooltip text on tap (mobile has no hover)
    (function () {
        if (!window.matchMedia('(hover: none)').matches) return;
        const toast = document.createElement('div');
        Object.assign(toast.style, {
            position: 'fixed', bottom: '24px', left: '50%',
            transform: 'translateX(-50%) translateY(12px)',
            background: '#1e293b', color: '#f1f5f9',
            padding: '9px 15px', borderRadius: '8px',
            fontSize: '13px', fontWeight: '500',
            maxWidth: '88vw', textAlign: 'center',
            opacity: '0', transition: 'opacity .2s, transform .2s',
            pointerEvents: 'none', zIndex: '999',
            boxShadow: '0 4px 20px rgba(0,0,0,.25)'
        });
        document.body.appendChild(toast);
        let timer;
        document.querySelectorAll('[data-tip]').forEach(el => {
            el.addEventListener('click', () => {
                if (el.tagName === 'DETAILS' || el.tagName === 'SUMMARY') return;
                toast.textContent = el.dataset.tip;
                toast.style.opacity = '1';
                toast.style.transform = 'translateX(-50%) translateY(0)';
                clearTimeout(timer);
                timer = setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(-50%) translateY(12px)';
                }, 2800);
            });
        });
    })();

    (function () {
        const toggles = Array.from(document.querySelectorAll('.origin-filter-toggle'));
        const rows = Array.from(document.querySelectorAll('[data-origin-row]'));
        const status = document.getElementById('originFilterStatus');
        const reset = document.getElementById('originFilterReset');
        if (!toggles.length || !rows.length || !status || !reset) return;

        const total = rows.length;
        let activeOrigin = '';

        function formatOrigin(origin) {
            return origin ? origin.charAt(0).toUpperCase() + origin.slice(1) : '';
        }

        function render() {
            let visible = 0;

            rows.forEach(row => {
                const match = !activeOrigin || row.dataset.originRow === activeOrigin;
                row.style.display = match ? '' : 'none';
                if (match) visible += 1;
            });

            toggles.forEach(toggle => {
                const isActive = toggle.dataset.origin === activeOrigin;
                toggle.classList.toggle('is-active', isActive);
                toggle.classList.toggle('is-muted', Boolean(activeOrigin) && !isActive);
                toggle.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });

            if (activeOrigin) {
                status.textContent = `Showing ${visible} of ${total} surnames with ${formatOrigin(activeOrigin)} origin`;
                reset.classList.remove('hidden');
            } else {
                status.textContent = `Showing all ${total} surnames`;
                reset.classList.add('hidden');
            }
        }

        toggles.forEach(toggle => {
            toggle.addEventListener('click', () => {
                const nextOrigin = toggle.dataset.origin || '';
                activeOrigin = activeOrigin === nextOrigin ? '' : nextOrigin;
                render();
            });
        });

        reset.addEventListener('click', () => {
            activeOrigin = '';
            render();
        });

        render();
    })();
</script>
