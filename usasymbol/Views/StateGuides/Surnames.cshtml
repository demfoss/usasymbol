<!-- Scroll progress -->
<div id="progressBar" class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-slate-800 via-slate-600 to-slate-800 z-50 transition-all duration-150" style="width:0%"></div>

<!-- Breadcrumb -->
<nav class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
