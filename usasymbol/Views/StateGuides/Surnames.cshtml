@model USASymbol.Models.ViewModels.SurnamesViewModel
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using USASymbol.Models.ViewModels

@inject IImageUrlService Images

@{
    var state   = Model.State;
    var content = Model.Content;
    var top1    = Model.Top1;
    var top2    = Model.Top2;
    var top3    = Model.Top3;
    var allNames = content.Surnames.OrderBy(s => s.Rank).ToList();
    var maxCount = (double)(top1?.Count ?? 1);

    ViewData["Title"]       = content.SeoTitle;
    ViewData["Description"] = content.SeoDescription;
    ViewData["OgType"]      = "article";
    ViewData["Canonical"]   = $"/states/{state.Slug}/surnames";

    var originColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["english"]      = "#3b82f6",
        ["german"]       = "#22c55e",
        ["spanish"]      = "#f59e0b",
        ["irish"]        = "#f97316",
        ["other"]        = "#64748b",
        ["scottish"]     = "#6366f1",
        ["welsh"]        = "#0f766e",
        ["portuguese"]   = "#059669",
        ["japanese"]     = "#b91c1c",
        ["korean"]       = "#7c3aed",
        ["hawaiian"]     = "#0891b2",
        ["basque"]       = "#be123c",
        ["chinese"]      = "#dc2626",
        ["danish"]       = "#0284c7",
        ["dutch"]        = "#ea580c",
        ["latin"]        = "#a16207",
        ["navajo"]       = "#92400e",
        ["swedish"]      = "#2563eb",
        ["vietnamese"]   = "#ca8a04",
        ["french"]       = "#a855f7",
        ["polish"]       = "#ef4444",
        ["italian"]      = "#f43f5e",
        ["scandinavian"] = "#14b8a6",
    };

    string OriginColor(string o) => originColors.TryGetValue(o, out var c) ? c : "#94a3b8";

    var topOrigin = content.Surnames
        .GroupBy(s => s.Origin, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .FirstOrDefault()?.Key ?? "—";

    var quickFacts = new List<QuickFactItem>
    {
        new() { Label = "#1 Surname",         Value = top1?.Name ?? "—" },
        new() { Label = "People named #1",    Value = top1?.Count.ToString("N0", CultureInfo.InvariantCulture) ?? "—" },
        new() { Label = "1 in every",         Value = top1 != null ? $"{top1.Ratio:N0} residents" : "—" },
        new() { Label = "Top origin",         Value = char.ToUpper(topOrigin[0]) + topOrigin[1..] },
        new() { Label = "State population",   Value = content.Population.ToString("N0", CultureInfo.InvariantCulture) },
        new() { Label = "Census year",        Value = content.DataYear.ToString() },
    };

    var heroModel = new PageHeroViewModel
    {
        PageModel = null!,
        Title = content.H1 ?? $"Most Common Last Names in {state.Name}",
        Description = content.Intro,
        HeroLabel = "Genealogy & Demographics",
        EyebrowItems = new List<string> { state.Name, $"{content.DataYear} Census", "Top 20 Surnames" },
        FallbackIconClass = "fa-solid fa-users",
        ImageUrl = state.FlagImageUrl,
        ImageAlt = $"{state.Name} state flag",
        FigureTitle = state.Name,
        FigureSubtitle = $"Top 20 Most Common Surnames · {content.DataYear} Census",
    };

    if (string.IsNullOrWhiteSpace(topOrigin) || topOrigin.Contains("â"))
    {
        topOrigin = "-";
    }

    foreach (var fact in quickFacts)
    {
        if (!string.IsNullOrWhiteSpace(fact.Value) && (fact.Value.Contains("â") || fact.Value.Contains("Â")))
        {
            fact.Value = "-";
        }
    }

    heroModel.FigureSubtitle = $"Top 20 Most Common Surnames - {content.DataYear} Census";

    const string baseUrl = "https://usasymbol.com";
    var pageUrl = $"{baseUrl}{Context.Request.Path}";
    var pageImage = Images.Full(state.FlagImageUrl);
    var dateModified = (ViewData["AuthorBox"] as AuthorBox)?.DateModified ?? DateTime.UtcNow;
    var jsonOptions = new JsonSerializerOptions
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    var articleLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["@id"] = $"{pageUrl}#article",
        ["headline"] = content.H1 ?? $"Most Common Last Names in {state.Name}",
        ["description"] = System.Net.WebUtility.HtmlDecode(ViewData["Description"]?.ToString() ?? ""),
        ["datePublished"] = dateModified.AddDays(-10).ToString("yyyy-MM-ddTHH:mm:sszzz"),
        ["dateModified"] = dateModified.ToString("yyyy-MM-ddTHH:mm:sszzz"),
        ["image"] = pageImage,
        ["author"] = new Dictionary<string, object>
        {
            ["@type"] = "Person",
            ["@id"] = $"{baseUrl}/about/artsiom-dusau#person",
            ["name"] = "Artsiom Dusau",
            ["url"] = $"{baseUrl}/about/artsiom-dusau"
        },
        ["reviewedBy"] = new Dictionary<string, object>
        {
            ["@type"] = "Person",
            ["@id"] = $"{baseUrl}/about/artsiom-dusau#person",
            ["name"] = "Artsiom Dusau",
            ["jobTitle"] = "Founder & Editor",
            ["url"] = $"{baseUrl}/about/artsiom-dusau"
        },
        ["publisher"] = new Dictionary<string, object>
        {
            ["@type"] = "Organization",
            ["name"] = "USA Symbol",
            ["url"] = baseUrl
        },
        ["mainEntityOfPage"] = new Dictionary<string, object>
        {
            ["@type"] = "WebPage",
            ["@id"] = pageUrl
        }
    };

    var breadcrumbLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new List<Dictionary<string, object>>
        {
            new() { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
            new() { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Last Names by State", ["item"] = $"{baseUrl}/guides/surnames" },
            new() { ["@type"] = "ListItem", ["position"] = 3, ["name"] = state.Name, ["item"] = pageUrl }
        }
    };

    Dictionary<string, object>? faqLd = null;
    if (content.Faq.Any())
    {
        faqLd = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = content.Faq.Select(f => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = f.Question,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = f.Answer
                }
            }).ToList()
        };
    }
}

