@using System.Text.Json
@using USASymbol.Models

@{
    Layout = "_Layout";
    ViewData["BodyClass"] = "tools-surface";

    var initialZips = (List<ZipCodeResult>)(ViewBag.InitialZips ?? new List<ZipCodeResult>());
    var states = (List<StateSummary>)(ViewBag.States ?? new List<StateSummary>());

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var initialZipsJson = JsonSerializer.Serialize(initialZips, jsonOptions);
    var statesJson = JsonSerializer.Serialize(states, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
}

<div class="tl-page">
    <section class="tl-hero">
        <div class="tl-shell">
            <nav class="tl-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <a href="/tools">Tools</a>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Random ZIP Code Generator</span>
            </nav>
            <p class="tl-eyebrow"><span></span> Free tool</p>
            <h1>Random ZIP Code <em>Generator</em></h1>
            <p class="tl-lede">
                Pick a count and generate real U.S. ZIP codes instantly, with city, state, and
                flag for each result. Filter by state, copy any code, or download the full list
                as a .txt file.
            </p>
        </div>
    </section>

    <section class="tl-shell">
        <div class="zg-panel" id="zip-generator" data-generate-url="/tools/random-zip-code-generator/generate">
            <div class="zg-controls">
                <div class="zg-field">
                    <label for="zg-count">Count</label>
                    <input type="number" id="zg-count" min="1" max="100" step="1" value="20" />
                </div>
                <div class="zg-field">
                    <label for="zg-state">State</label>
                    <select id="zg-state">
                        <option value="">All states</option>
                        @foreach (var state in states)
                        {
                            <option value="@state.Code">@state.Name</option>
                        }
                    </select>
                </div>
                <div class="zg-actions">
                    <button type="button" class="zg-btn zg-btn-primary" id="zg-generate">
                        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Get New ZIP Codes
                    </button>
                    <button type="button" class="zg-btn zg-btn-secondary" id="zg-download">
                        <i class="fa-solid fa-download" aria-hidden="true"></i> Download .txt
                    </button>
                </div>
            </div>
            <p class="zg-status" id="zg-status" role="status" aria-live="polite"></p>
            <div class="zg-grid" id="zg-grid"></div>
        </div>
    </section>
</div>

<script>
    window.zipGeneratorData = {
        initialResults: @Html.Raw(initialZipsJson),
        states: @Html.Raw(statesJson)
    };
</script>

@section Scripts {
    <script defer src="~/js/random-zip-generator.js" asp-append-version="true"></script>
}

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "WebApplication",
    "name": "Random ZIP Code Generator",
    "url": "https://usasymbol.com/tools/random-zip-code-generator",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "description": "Free tool to generate random real U.S. ZIP codes with city and state, filter by state, copy results, or download them as a .txt file."
}
</script>
