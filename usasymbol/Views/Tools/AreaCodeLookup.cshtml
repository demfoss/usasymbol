@{
    Layout = "_Layout";
    ViewData["BodyClass"] = "tools-surface";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tools.css" asp-append-version="true" />
}

<div class="tl-page">
    <section class="tl-hero">
        <div class="tl-shell">
            <nav class="tl-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <a href="/tools">Tools</a>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">Area Code Lookup</span>
            </nav>
            <p class="tl-eyebrow"><span></span> Free tool</p>
            <h1>Area Code <em>Lookup</em></h1>
            <p class="tl-lede">
                Enter a 3-digit U.S. telephone area code to find its state and primary cities.
            </p>
        </div>
    </section>

    <section class="tl-shell">
        <div class="zg-panel" id="area-code-lookup" data-lookup-url="/tools/area-code-lookup/lookup">
            <form class="tl-lookup-form" id="ac-form">
                <div class="zg-field">
                    <label for="ac-code">Area code</label>
                    <input type="text" id="ac-code" inputmode="numeric" pattern="[0-9]*" maxlength="3" placeholder="e.g. 212" autocomplete="off" />
                </div>
                <div class="zg-actions">
                    <button type="submit" class="zg-btn zg-btn-primary">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Look Up
                    </button>
                </div>
            </form>
            <p class="zg-status" id="ac-status" role="status" aria-live="polite"></p>
            <div id="ac-result"></div>
        </div>
    </section>
</div>

@section Scripts {
    <script defer src="~/js/area-code-lookup.js" asp-append-version="true"></script>
}
