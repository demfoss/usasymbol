@model USASymbol.Models.ViewModels.ColorDetailViewModel
@using System.Globalization
@using USASymbol.Extensions
@using USASymbol.Models.ViewModels
@inject IImageUrlService Images

@{
    var stateName = Model.State.Name;
    var stateSlug = Model.State.Slug;
    var colorTitle = SymbolDetailViewModel.FirstNonEmpty(Model.ColorContent?.Title, Model.Symbol?.Name, $"{stateName} State Colors") ?? $"{stateName} State Colors";
    var overviewHeading = $"State Colors of {stateName}";
    var adoptedYear = Model.ColorContent?.AdoptedYear ?? 0;
    var colors = Model.Colors;
    var descRaw = Model.ColorContent?.SeoDescription ?? "";

    ViewData["Title"] = Model.ColorContent?.SeoTitle ?? $"{colorTitle} - {stateName} State Color";
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {colorTitle}, the official state color of {stateName}."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    ViewData["OgImage"] = Images.Full(Model.Symbol.ImageUrl ?? Model.State.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol.ToSymbolUrl(Model.State.Slug);

    // Dynamic gradient for hero background
    var colorHexCodes = Model.ColorContent?.ColorData?.Select(c => c.Hex).ToList() ?? new List<string>();
    var gradientStyle = "";

    if (colorHexCodes.Count == 2)
    {
        gradientStyle = $"background: linear-gradient(135deg, {colorHexCodes[0]} 50%, {colorHexCodes[1]} 50%);";
    }
    else if (colorHexCodes.Count > 2)
    {
        var stops = string.Join(", ", colorHexCodes.Select((hex, i) =>
            $"{hex} {i * 100.0 / colorHexCodes.Count}%, {hex} {(i + 1) * 100.0 / colorHexCodes.Count}%"));
        gradientStyle = $"background: linear-gradient(135deg, {stops});";
    }
    else if (colorHexCodes.Count == 1)
    {
        gradientStyle = $"background: {colorHexCodes[0]};";
    }

    var quickFacts = (Model.ColorContent?.QuickFacts ?? new List<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();
    var introText = Model.ColorContent?.IntroText ?? string.Empty;
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw) ? descRaw : introText;
    heroDescriptionSource = System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1");
    var heroDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, "<.*?>", " ")).Trim();
    var hasPlacementStoryBlocks =
        !string.IsNullOrWhiteSpace(Model.ColorContent?.ExpertQuoteAfterSectionId) ||
        !string.IsNullOrWhiteSpace(Model.ColorContent?.TimelineAfterSectionId) ||
        !string.IsNullOrWhiteSpace(Model.ColorContent?.BigStatAfterSectionId);
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        BackgroundClass = "bg-[linear-gradient(180deg,#1b2230_0%,#1f2735_100%)]",
        TopRuleClass = "bg-gradient-to-r from-slate-300/0 via-slate-200/80 to-slate-300/0",
        PrimaryGlowClass = "bg-white/10",
        SecondaryGlowClass = "bg-slate-200/10",
        AccentDotClass = "bg-white",
        MediaBackgroundClass = "bg-slate-100/10",
        FallbackIconClass = "fa-solid fa-palette",
        Title = colorTitle,
        Description = heroDescription,
        LegalReference = Model.Legislation,
        ImageUrl = Model.Symbol.ImageUrl,
        ImageAlt = colorTitle,
        FigureTitle = $"Official color palette of {stateName}",
        FigureSubtitle = "State color reference",
        ImageLinkUrl = Model.Symbol.ImageUrl,
        PaletteHexes = colorHexCodes,
        EyebrowItems = new List<string>
        {
            stateName,
            "State Colors",
            adoptedYear > 0 ? $"Adopted {adoptedYear}" : Model.ColorContent?.OfficialSince ?? string.Empty
        }
    };
}

<nav class="border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">

        <div class="lg:grid lg:grid-cols-[232px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[244px_minmax(0,1fr)_300px] xl:gap-10 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">

            @await Html.PartialAsync("_SymbolHero", heroModel)

            <!-- LEFT SIDEBAR -->
            <aside class="hidden lg:block relative h-full">
                <div class="sticky top-24 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <!-- MAIN CONTENT -->
            <div class="min-w-0">
                @if (!string.IsNullOrWhiteSpace(introText))
                {
                    @await Html.PartialAsync("_Overview", null, new ViewDataDictionary(ViewData) {
                        { "Heading", overviewHeading },
                        { "Body", introText.RenderAutoLinks() }
                    })
                }

                @if (quickFacts.Any())
                {
                    <div class="xl:hidden">
                        @await Html.PartialAsync("_QuickFacts", quickFacts)
                    </div>
                }

                <!-- COLOR SPECIFICATION CARDS -->
                @if (Model.ColorContent?.ColorData != null && Model.ColorContent.ColorData.Any())
                {
                    <section id="color-specifications" class="mb-10">
                        <h2 class="text-2xl font-bold text-slate-900 mb-2">
                            <i class="fa-solid fa-droplet @colors.Text mr-2"></i>
                            Color Specifications
                        </h2>
                        <p class="text-slate-500 text-sm mb-6">Click any value to copy to clipboard</p>

                        <div class="space-y-6">
                            @foreach (var color in Model.ColorContent.ColorData)
                            {
                                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden hover:shadow-md transition-all duration-200">
                                    <div class="h-28 relative" style="background-color: @color.Hex;">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                                        <div class="absolute bottom-3 left-4">
                                            <h3 class="text-2xl font-bold text-white drop-shadow-lg">@color.Name</h3>
                                        </div>
                                    </div>

                                    <div class="p-5">
                                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                                            <button class="copy-color-value text-left group" data-value="@color.Hex">
                                                <div class="p-3 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">HEX</div>
                                                        <i class="fa-solid fa-copy text-slate-400 group-hover:text-slate-600 transition-colors text-xs"></i>
                                                    </div>
                                                    <div class="text-base font-mono font-bold text-slate-900">@color.Hex</div>
                                                </div>
                                            </button>

                                            <button class="copy-color-value text-left group" data-value="@color.Rgb">
                                                <div class="p-3 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">RGB</div>
                                                        <i class="fa-solid fa-copy text-slate-400 group-hover:text-slate-600 transition-colors text-xs"></i>
                                                    </div>
                                                    <div class="text-xs font-mono font-semibold text-slate-900">@color.Rgb</div>
                                                </div>
                                            </button>

                                            <button class="copy-color-value text-left group" data-value="@color.Cmyk">
                                                <div class="p-3 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">CMYK</div>
                                                        <i class="fa-solid fa-copy text-slate-400 group-hover:text-slate-600 transition-colors text-xs"></i>
                                                    </div>
                                                    <div class="text-xs font-mono font-semibold text-slate-900">@color.Cmyk</div>
                                                </div>
                                            </button>

                                            <button class="copy-color-value text-left group" data-value="@color.Pantone">
                                                <div class="p-3 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Pantone</div>
                                                        <i class="fa-solid fa-copy text-slate-400 group-hover:text-slate-600 transition-colors text-xs"></i>
                                                    </div>
                                                    <div class="text-xs font-mono font-semibold text-slate-900">@color.Pantone</div>
                                                </div>
                                            </button>
                                        </div>

                                        @if (!string.IsNullOrEmpty(color.Symbolism))
                                        {
                                            <div class="pt-3 border-t border-slate-200">
                                                <p class="text-sm text-slate-700 leading-relaxed">
                                                    <i class="fa-solid fa-info-circle text-slate-400 mr-1"></i>
                                                    @color.Symbolism.RenderAutoLinks()
                                                </p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ColorContent?.KnownFor))
                {
                    <section id="color-meaning" class="mb-10">
                        <div class="border-l-4 border-amber-500 bg-amber-50/60 px-5 py-5 sm:px-6">
                            <h2 class="text-xl font-bold text-slate-900">What @stateName Colors Represent</h2>
                            <p class="mt-2 leading-relaxed text-slate-700">
                                @Model.ColorContent.KnownFor.RenderAutoLinks()
                            </p>
                        </div>
                    </section>
                }

                <!-- BIG STAT -->
                @if (!hasPlacementStoryBlocks && Model.ColorContent?.BigStat != null && !string.IsNullOrWhiteSpace(Model.ColorContent.BigStat.Number))
                {
                    @await Html.PartialAsync("Components/Story/_BigStat", Model.ColorContent.BigStat)
                }

                <!-- CONTENT SECTIONS -->
                <div class="journey-content relative site-content">
                    @await Html.PartialAsync("_Sections", Model)
                </div>

                <!-- EXPERT QUOTE -->
                @if (!hasPlacementStoryBlocks && Model.ColorContent?.Timeline?.Any() == true)
                {
                    @await Html.PartialAsync("Components/Story/_Timeline", Model.ColorContent.Timeline)
                }

                @if (!hasPlacementStoryBlocks && Model.ColorContent?.ExpertQuote != null && !string.IsNullOrWhiteSpace(Model.ColorContent.ExpertQuote.Text))
                {
                    @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.ColorContent.ExpertQuote)
                }

                <div class="content-divider">
                    @await Html.PartialAsync("_Faq", Model)
                </div>

                <section id="sources" class="content-divider">
                    @await Html.PartialAsync("_Sources", Model)
                </section>

                <div class="mt-10 space-y-8 xl:hidden" data-nosnippet>
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                    @*@await Html.PartialAsync("_GuidesAndRankingsSidebar")*@
                </div>

                <div class="content-divider">
                    @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <aside class="journey-sidebar mt-12 hidden xl:block xl:col-span-1 xl:mt-0 relative self-start" aria-label="Article sidebar">
                @if (quickFacts.Any())
                {
                    <section class="relative min-h-[calc(100vh-5rem)] pb-16">
                        <div class="sticky top-32 pr-2">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    </section>
                }

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh+8rem)] pb-20">
                    <div class="sticky top-32 pr-2">
                        @*@await Html.PartialAsync("_GuidesAndRankingsSidebar")*@
                    </div>
                </section>
            </aside>

        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")

<script>
    // ===== COPY TO CLIPBOARD =====
    document.querySelectorAll('.copy-color-value').forEach(button => {
        button.addEventListener('click', async function () {
            const value = this.dataset.value;
            try {
                await navigator.clipboard.writeText(value);
                showToast('Copied!', value);
                const icon = this.querySelector('i');
                icon.classList.replace('fa-copy', 'fa-check');
                icon.classList.add('text-green-600');
                setTimeout(() => {
                    icon.classList.replace('fa-check', 'fa-copy');
                    icon.classList.remove('text-green-600');
                }, 2000);
            } catch (err) {
                console.error('Failed to copy:', err);
            }
        });
    });

    function showToast(title, message) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-4 right-4 bg-slate-900 text-white px-6 py-4 rounded-lg shadow-lg z-50 animate-slide-up';
        toast.innerHTML = `<div class="flex items-center gap-3"><i class="fa-solid fa-circle-check text-green-400 text-xl"></i><div><p class="font-bold">${title}</p><p class="text-sm text-slate-300">${message}</p></div></div>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

</script>

<style>
    @@keyframes slide-up {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .animate-slide-up { animation: slide-up 0.3s ease-out; }
</style>
