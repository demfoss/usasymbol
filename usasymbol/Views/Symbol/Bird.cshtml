@model USASymbol.Models.ViewModels.BirdDetailViewModel
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using USASymbol.Models.Content
@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@inject IImageUrlService Images
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@functions {
    private static string NormalizeBirdAudioKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var builder = new System.Text.StringBuilder(value.Length);
        var previousWasSeparator = false;

        foreach (var ch in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(ch))
            {
                builder.Append(ch);
                previousWasSeparator = false;
            }
            else if (!previousWasSeparator)
            {
                builder.Append('-');
                previousWasSeparator = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private static Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary BuildSectionsViewData(
        Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary baseViewData,
        IEnumerable<IContentSection> sections,
        bool suppressFullWidthImage)
    {
        return new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(baseViewData)
        {
            ["SectionsOverride"] = sections.ToList(),
            ["SuppressStoryBlocks"] = true,
            ["SuppressFactsBlocks"] = true,
            ["SuppressFullWidthImage"] = suppressFullWidthImage
        };
    }

    private static bool ContainsSectionId(IEnumerable<IContentSection> sections, string? sectionId)
    {
        return !string.IsNullOrWhiteSpace(sectionId) &&
               sections.Any(section => string.Equals(section?.Id, sectionId, StringComparison.OrdinalIgnoreCase));
    }

}

@{
    ViewData["BodyClass"] = "bird-detail-page";

    var birdName = Model.BirdContent?.Title ?? Model.Symbol.Name;
    var scientificName = Model.BirdContent?.ScientificName ?? Model.Symbol.ScientificName ?? "";
    var stateName = Model.State.Name;
    var adoptedYear = Model.BirdContent?.AdoptedYear ?? Model.Symbol.AdoptedYear ?? 0;
    var colors = Model.Colors;

    var designationRaw = (Model.Symbol.Designation ?? "").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "State Bird"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());

    var h1 = $"{stateName} {designation}: {birdName}";

    ViewData["Title"] = Model.BirdContent?.SeoTitle ?? h1;

    var descRaw = Model.BirdContent?.SeoDescription ?? "";
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s {designation.ToLowerInvariant()} {birdName}, including adoption, history, and meaning."
        : System.Net.WebUtility.HtmlDecode(descRaw);

    ViewData["OgImage"] = Images.Full(Model.Symbol.ImageUrl ?? Model.State.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol.ToSymbolUrl(Model.State.Slug);

    var quickFacts = (Model.QuickFacts ?? Array.Empty<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();

    string? birdAudioSrc = null;
    var birdSoundsRoot = string.IsNullOrWhiteSpace(WebHostEnvironment.WebRootPath)
        ? string.Empty
        : System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "sounds", "birds");

    if (!string.IsNullOrWhiteSpace(birdSoundsRoot) && System.IO.Directory.Exists(birdSoundsRoot))
    {
        var slugKey = NormalizeBirdAudioKey(Model.Symbol.Slug);
        var nameKey = NormalizeBirdAudioKey(birdName);

        var audioMatch = System.IO.Directory
            .EnumerateFiles(birdSoundsRoot, "*.mp3")
            .Select(path => new
            {
                FileName = System.IO.Path.GetFileName(path),
                Key = NormalizeBirdAudioKey(System.IO.Path.GetFileNameWithoutExtension(path))
            })
            .FirstOrDefault(file =>
                file.Key == slugKey ||
                file.Key == nameKey ||
                string.Equals(file.FileName, $"{Model.Symbol.Slug}.mp3", StringComparison.OrdinalIgnoreCase));

        if (audioMatch != null)
        {
            birdAudioSrc = $"/sounds/birds/{audioMatch.FileName}";
        }
    }

    var sections = (Model.Sections ?? new List<IContentSection>())
        .Where(section => section?.Facts?.Any() != true)
        .ToList();
    var firstSection = sections.Take(1).ToList();
    var secondSection = sections.Skip(1).Take(1).ToList();
    var thirdSection = sections.Skip(2).Take(1).ToList();
    var remainingSections = sections.Skip(3).ToList();

    var firstSectionsViewData = BuildSectionsViewData(ViewData, firstSection, true);
    var secondSectionsViewData = BuildSectionsViewData(ViewData, secondSection, true);
    var thirdSectionsViewData = BuildSectionsViewData(ViewData, thirdSection, true);
    var finalSectionsViewData = BuildSectionsViewData(ViewData, remainingSections, false);
    var quoteAfterSectionId = Model.BirdContent?.ExpertQuoteAfterSectionId ?? string.Empty;
    var timelineAfterSectionId = Model.BirdContent?.TimelineAfterSectionId ?? string.Empty;
    var statAfterSectionId = Model.BirdContent?.BigStatAfterSectionId ?? string.Empty;
    var quoteAfterFirstSection = ContainsSectionId(firstSection, quoteAfterSectionId);
    var quoteAfterSecondSection = ContainsSectionId(secondSection, quoteAfterSectionId);
    var quoteAfterThirdSection = ContainsSectionId(thirdSection, quoteAfterSectionId);
    var quoteAfterRemainingSections = ContainsSectionId(remainingSections, quoteAfterSectionId);
    var timelineAfterFirstSection = ContainsSectionId(firstSection, timelineAfterSectionId);
    var timelineAfterSecondSection = ContainsSectionId(secondSection, timelineAfterSectionId);
    var timelineAfterThirdSection = ContainsSectionId(thirdSection, timelineAfterSectionId);
    var timelineAfterRemainingSections = ContainsSectionId(remainingSections, timelineAfterSectionId);
    var statAfterFirstSection = ContainsSectionId(firstSection, statAfterSectionId);
    var statAfterSecondSection = ContainsSectionId(secondSection, statAfterSectionId);
    var statAfterThirdSection = ContainsSectionId(thirdSection, statAfterSectionId);
    var statAfterRemainingSections = ContainsSectionId(remainingSections, statAfterSectionId);
    var hasPlacementStoryBlocks =
        !string.IsNullOrWhiteSpace(quoteAfterSectionId) ||
        !string.IsNullOrWhiteSpace(timelineAfterSectionId) ||
        !string.IsNullOrWhiteSpace(statAfterSectionId);

    var hasQuote = Model.BirdContent?.ExpertQuote != null && !string.IsNullOrWhiteSpace(Model.BirdContent.ExpertQuote.Text);
    var hasTimeline = Model.BirdContent?.Timeline?.Any() == true;
    var hasBigStat = Model.BirdContent?.BigStat != null && !string.IsNullOrWhiteSpace(Model.BirdContent.BigStat.Number);
    var hasQuiz = Model.QuizQuestions?.Any() == true;
    var hasAudio = !string.IsNullOrWhiteSpace(birdAudioSrc);
    var hasMeaning = !string.IsNullOrWhiteSpace(Model.Meaning);
    var introText = Model.BirdContent?.IntroText ?? string.Empty;
    var overviewText = !string.IsNullOrWhiteSpace(introText)
        ? introText
        : adoptedYear > 0 && !string.IsNullOrWhiteSpace(scientificName)
            ? $"In <strong>{adoptedYear}</strong>, {stateName} designated the {birdName} (<span class=\"italic\">{scientificName}</span>) as its official state bird."
            : $"The {birdName} is recognized as the official {designation.ToLowerInvariant()} of {stateName}.";
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw) ? descRaw : introText;
    heroDescriptionSource = System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1");
    var heroDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, "<.*?>", " ")).Trim();
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        BackgroundClass = "bg-[linear-gradient(180deg,#1b2230_0%,#1f2735_100%)]",
        TopRuleClass = "bg-gradient-to-r from-sky-300/0 via-sky-300/70 to-amber-200/0",
        PrimaryGlowClass = "bg-amber-300/10",
        SecondaryGlowClass = "bg-sky-200/10",
        AccentDotClass = "bg-amber-300",
        MediaBackgroundClass = "bg-slate-100/10",
        FallbackIconClass = "fa-solid fa-dove",
        Title = h1,
        Subtitle = scientificName,
        Description = heroDescription,
        LegalReference = Model.Legislation,
        ImageUrl = Model.Symbol.ImageUrl,
        ImageAlt = $"{birdName} - {stateName} {designation}",
        FigureTitle = birdName,
        FigureSubtitle = $"Official {designation} of {stateName}",
        ImageLinkUrl = Model.Symbol.ImageUrl,
        EyebrowItems = new List<string> { stateName, designation, adoptedYear > 0 ? $"Adopted {adoptedYear}" : string.Empty }
    };
}

<style>
    .bird-editorial {
        color: #161B26;
    }

    .bird-editorial .content-flow h2 {
        font-family: 'Libre Baskerville', Georgia, serif;
        color: #161B26;
        font-size: 41px;
        font-weight: 700;
        line-height: 50px;
        letter-spacing: -0.02em;
    }

    .bird-editorial .content-flow h3 {
        font-family: 'Libre Baskerville', Georgia, serif;
        color: #161B26;
        font-size: 23px;
        font-weight: 700;
        line-height: 50px;
        letter-spacing: 0;
    }

    .bird-editorial .site-content,
    .bird-editorial .site-content p,
    .bird-editorial .site-content li,
    .bird-editorial .site-content dd,
    .bird-editorial .site-content blockquote,
    .bird-editorial .site-content .prose,
    .bird-editorial .content-flow > section > div,
    .bird-editorial .content-flow > div {
        font-size: 19px;
        font-style: normal;
        font-weight: 400;
        line-height: 34px;
        letter-spacing: 0.19px;
    }

    .bird-editorial #overview h2,
    .bird-editorial #symbolic-meaning h2,
    .bird-editorial #shared-states h2,
    .bird-editorial #bird-quiz h2,
    .bird-editorial #bird-songs h2,
    .bird-editorial #faq h2,
    .bird-editorial #sources h2 {
        font-size: 41px;
        line-height: 50px;
        letter-spacing: -0.02em;
        text-transform: none;
    }

    .bird-editorial #overview .site-content,
    .bird-editorial #symbolic-meaning .site-content,
    .bird-editorial #overview .site-content p,
    .bird-editorial #symbolic-meaning .site-content p {
        font-size: 19px;
        line-height: 34px;
        letter-spacing: 0.19px;
    }

    @@media (max-width: 767px) {
        .bird-editorial .content-flow h2,
        .bird-editorial #overview h2,
        .bird-editorial #symbolic-meaning h2,
        .bird-editorial #shared-states h2,
        .bird-editorial #bird-quiz h2,
        .bird-editorial #bird-songs h2,
        .bird-editorial #faq h2,
        .bird-editorial #sources h2 {
            font-size: 26px;
            line-height: 37px;
            letter-spacing: -0.405px;
        }

        .bird-editorial .content-flow h3 {
            font-size: 19px;
            line-height: 24px;
            letter-spacing: 0.38px;
        }

        .bird-editorial .site-content,
        .bird-editorial .site-content p,
        .bird-editorial .site-content li,
        .bird-editorial .site-content dd,
        .bird-editorial .site-content blockquote,
        .bird-editorial .site-content .prose,
        .bird-editorial .content-flow > section > div,
        .bird-editorial .content-flow > div,
        .bird-editorial #overview .site-content,
        .bird-editorial #symbolic-meaning .site-content,
        .bird-editorial #overview .site-content p,
        .bird-editorial #symbolic-meaning .site-content p {
            font-size: 18px;
            line-height: 29px;
            letter-spacing: 0.18px;
        }
    }
</style>

<nav class="sticky top-16 z-30 bg-white/90 shadow-[0_14px_34px_-30px_rgba(15,23,42,0.24)] backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<main class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="bird-editorial w-full">
        <div class="lg:grid lg:grid-cols-[232px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[228px_minmax(0,760px)_320px] xl:gap-12 2xl:grid-cols-[240px_minmax(0,780px)_340px] 2xl:gap-14 relative">

            @await Html.PartialAsync("_SymbolHero", heroModel)

            <aside class="hidden xl:block relative self-start xl:sticky xl:top-32">
                <div class="max-h-[calc(100vh-9rem)] overflow-y-auto pr-2 pb-10 [scrollbar-width:thin]">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                <div class="content-flow site-content">
                    <section id="overview" class="mt-10">
                        <div class="relative overflow-hidden bg-[linear-gradient(90deg,rgba(255,255,255,0.24),rgba(255,249,240,0.04))] px-5 py-6 sm:px-6 lg:px-8 lg:py-7">
                            <div class="absolute left-0 top-7 bottom-7 w-[3px] bg-[linear-gradient(180deg,#d8b36a_0%,#c46243_100%)]"></div>
                            <div class="flex items-start gap-4 lg:gap-5">
                                <div class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-full bg-white/75 text-slate-600">
                                    <i class="fa-solid fa-feather-pointed text-sm"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Overview</div>
                                    <div class="site-content prose prose-slate prose-lg mt-3 max-w-none text-slate-700">
                                        @overviewText.RenderAutoLinks()
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    @if (quickFacts.Any())
                    {
                        <div class="xl:hidden">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    }

                    @if (hasMeaning)
                    {
                        <section id="symbolic-meaning" class="content-divider">
                            <div class="rounded-[1.6rem] border border-slate-200/80 bg-white/40 p-6 sm:p-7">
                                <div class="flex items-start gap-4 lg:gap-5">
                                    <div class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-full bg-white/70 text-slate-600">
                                        <i class="fa-solid fa-book-open text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Symbolic Meaning</div>
                                        <div class="mt-3 max-w-3xl text-slate-700">
                                            @Model.Meaning.RenderAutoLinks()
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @if (firstSection.Any())
                    {
                        @await Html.PartialAsync("_Sections", Model, firstSectionsViewData)
                    }

                    @if (hasQuote && ((hasPlacementStoryBlocks && quoteAfterFirstSection) || (!hasPlacementStoryBlocks)))
                    {
                        @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.BirdContent!.ExpertQuote!)
                    }

                    @if (hasTimeline && hasPlacementStoryBlocks && timelineAfterFirstSection)
                    {
                        @await Html.PartialAsync("Components/Story/_Timeline", Model.BirdContent!.Timeline)
                    }

                    @if (hasBigStat && hasPlacementStoryBlocks && statAfterFirstSection)
                    {
                        @await Html.PartialAsync("Components/Story/_BigStat", Model.BirdContent!.BigStat!)
                    }

                    @if (!secondSection.Any())
                    {
                        if (hasAudio)
                        {
                            <section id="bird-songs" class="content-divider">
                                <div class="overflow-hidden border border-slate-200/80 bg-white/65">
                                    <div class="border-b border-slate-200/80 px-5 py-4 sm:px-6">
                                        <div class="flex items-center gap-4">
                                            <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-slate-100 text-slate-700">
                                                <i class="fa-solid fa-headphones text-xs"></i>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <h2 class="!text-[1.65rem] !leading-[1.15] text-slate-900">@birdName Songs and Calls</h2>
                                                <div class="mt-1 text-sm leading-6 text-slate-500">A quick field-listening break while the article is still fresh.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-5 sm:p-6">
                                        <div class="plyr__audio-container">
                                            <audio id="birdPlayer" class="plyr w-full" controls preload="none">
                                                <source src="@birdAudioSrc" type="audio/mp3" />
                                            </audio>
                                        </div>

                                        <p class="mt-3 text-[13px] leading-6 text-slate-500">
                                            Audio licensed under
                                            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                                               target="_blank"
                                               rel="nofollow noopener noreferrer"
                                               class="underline hover:text-slate-700">
                                                CC BY-NC-SA 4.0
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </section>
                        }
                        else if (quickFacts.Any())
                        {
                        }
                    }

                    @if (secondSection.Any())
                    {
                        @await Html.PartialAsync("_Sections", Model, secondSectionsViewData)

                        @if (hasQuote && hasPlacementStoryBlocks && quoteAfterSecondSection)
                        {
                            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.BirdContent!.ExpertQuote!)
                        }

                        @if (hasTimeline && hasPlacementStoryBlocks && timelineAfterSecondSection)
                        {
                            @await Html.PartialAsync("Components/Story/_Timeline", Model.BirdContent!.Timeline)
                        }

                        @if (hasBigStat && hasPlacementStoryBlocks && statAfterSecondSection)
                        {
                            @await Html.PartialAsync("Components/Story/_BigStat", Model.BirdContent!.BigStat!)
                        }

                        if (hasAudio)
                        {
                            <section id="bird-songs" class="content-divider">
                                <div class="overflow-hidden border border-slate-200/80 bg-white/65">
                                    <div class="border-b border-slate-200/80 px-5 py-4 sm:px-6">
                                        <div class="flex items-center gap-4">
                                            <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-slate-100 text-slate-700">
                                                <i class="fa-solid fa-headphones text-xs"></i>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <h2 class="!text-[1.65rem] !leading-[1.15] text-slate-900">@birdName Songs and Calls</h2>
                                                <div class="mt-1 text-sm leading-6 text-slate-500">A quick field-listening break before the next section.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-5 sm:p-6">
                                        <div class="plyr__audio-container">
                                            <audio id="birdPlayer" class="plyr w-full" controls preload="none">
                                                <source src="@birdAudioSrc" type="audio/mp3" />
                                            </audio>
                                        </div>

                                        <p class="mt-3 text-[13px] leading-6 text-slate-500">
                                            Audio licensed under
                                            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                                               target="_blank"
                                               rel="nofollow noopener noreferrer"
                                               class="underline hover:text-slate-700">
                                                CC BY-NC-SA 4.0
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </section>
                        }
                        else if (quickFacts.Any())
                        {
                        }
                    }

                    @if (thirdSection.Any())
                    {
                        @await Html.PartialAsync("_Sections", Model, thirdSectionsViewData)

                        @if (hasQuote && hasPlacementStoryBlocks && quoteAfterThirdSection)
                        {
                            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.BirdContent!.ExpertQuote!)
                        }

                        @if (hasTimeline && hasPlacementStoryBlocks && timelineAfterThirdSection)
                        {
                            @await Html.PartialAsync("Components/Story/_Timeline", Model.BirdContent!.Timeline)
                        }

                        @if (hasBigStat && hasPlacementStoryBlocks && statAfterThirdSection)
                        {
                            @await Html.PartialAsync("Components/Story/_BigStat", Model.BirdContent!.BigStat!)
                        }
                    }

                    @if (hasQuiz)
                    {
                        <section id="bird-quiz" class="content-divider">
                            <div class="overflow-hidden border border-slate-200/80 bg-white/70 text-slate-900">
                                <div class="border-b border-slate-200/80 px-5 py-4 sm:px-6">
                                    <div class="flex items-center gap-4">
                                        <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-slate-100 text-slate-700">
                                            <i class="fas fa-graduation-cap text-xs"></i>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <h2 class="!text-[1.65rem] !leading-[1.15] text-slate-900">Test your knowledge</h2>
                                            <div class="mt-1 text-sm leading-6 text-slate-500">A short quiz while the key details are still top of mind.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-5 sm:p-6 text-slate-900">
                                    @await Html.PartialAsync("_QuizPartial", Model.QuizQuestions)
                                </div>

                                <div class="border-t border-slate-200/80 px-5 py-4 sm:px-6">
                                    <a href="/quizzes" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:text-slate-700 transition">
                                        <span>Explore more quizzes</span>
                                        <i class="fas fa-arrow-right shrink-0 text-xs"></i>
                                    </a>
                                </div>
                            </div>
                        </section>
                    }

                    @await Html.PartialAsync("_Sections", Model, finalSectionsViewData)

                    @if (hasQuote && hasPlacementStoryBlocks && quoteAfterRemainingSections)
                    {
                        @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.BirdContent!.ExpertQuote!)
                    }

                    @if (hasTimeline && ((hasPlacementStoryBlocks && timelineAfterRemainingSections) || !hasPlacementStoryBlocks))
                    {
                        @await Html.PartialAsync("Components/Story/_Timeline", Model.BirdContent!.Timeline)
                    }

                    @if (hasBigStat && ((hasPlacementStoryBlocks && statAfterRemainingSections) || !hasPlacementStoryBlocks))
                    {
                        @await Html.PartialAsync("Components/Story/_BigStat", Model.BirdContent!.BigStat!)
                    }

                    @if (Model.HasSharedStates)
                    {
                        <section id="shared-states" class="content-divider">
                            <div class="overflow-hidden border border-slate-200/80 bg-white/60">
                                <div class="px-5 py-4 bg-transparent">
                                    <h2 class="!text-[1.65rem] !leading-[1.15] text-slate-900">Also the state bird of</h2>
                                    <p class="text-sm text-slate-600">Other states that share this official bird.</p>
                                </div>

                                <div class="p-5">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var state in Model.BirdContent!.SharedStates)
                                        {
                                            <a href="/states/@state.ToLower().Replace(" ", "-")/bird/@Model.Symbol.Slug"
                                               class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/80 px-3 py-1.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 transition">
                                                @state
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    <section id="birds-quiz-promo" class="content-divider">
                        <div class="overflow-hidden rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/80 to-slate-50/60">
                            <div class="border-b border-emerald-200/60 px-5 py-4 sm:px-6">
                                <div class="flex items-center gap-4">
                                    <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                                        <i class="fa-solid fa-feather text-xs"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h2 class="content-h2 !text-[1.4rem] !leading-snug text-slate-900">Can You Match All 50 State Birds?</h2>
                                        <div class="mt-1 text-sm leading-6 text-slate-500">Seven states share the Cardinal. Five share the Mockingbird. Can you spot the odd one out?</div>
                                    </div>
                                </div>
                            </div>
                            <div class="px-5 py-5 sm:px-6">
                                <p class="content-p text-slate-700">The State Birds Quiz mixes standard image questions with 'odd one out' rounds — showing a shared bird like the Cardinal or Meadowlark and asking which state in the group doesn't actually have it. Plus a few questions about the stories behind the most unusual choices.</p>
                                <a href="/quizzes/state-birds-quiz" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition-colors">
                                    <span>Take the State Birds Quiz</span>
                                    <i class="fas fa-arrow-right text-xs"></i>
                                </a>
                            </div>
                        </div>
                    </section>

                    <section id="faq" class="content-divider">
                        @await Html.PartialAsync("_Faq", Model)
                    </section>

                    <section id="sources" class="content-divider">
                        @await Html.PartialAsync("_Sources", Model)
                    </section>

                    <div class="mt-10 space-y-8 xl:hidden">
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                        @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                    </div>

                    <div class="content-divider">
                        @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                    </div>
                </div>
            </div>

            <aside class="mt-12 hidden xl:block xl:col-span-1 xl:mt-0 relative self-start">
                @if (quickFacts.Any())
                {
                    <section class="relative min-h-[calc(100vh-5rem)] pb-16">
                        <div class="sticky top-32 pr-2">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    </section>
                }

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh+8rem)] pb-20">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                    </div>
                </section>
            </aside>
        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</main>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")
