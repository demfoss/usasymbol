@model USASymbol.Models.ViewModels.FlagDetailViewModel
@using System.Globalization
@using USASymbol.Extensions
@using USASymbol.Models.ViewModels
@inject IImageUrlService Images

@{
    ViewData["BodyClass"] = "flag-detail-page";

    var stateName = Model.State?.Name ?? "";
    var adoptedYear = Model.FlagContent?.AdoptedYear ?? Model.Symbol?.AdoptedYear ?? 0;
    var standardizedYear = Model.FlagContent?.StandardizedYear ?? 0;

    var designationRaw = (Model.Symbol?.Designation ?? "State Flag").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "State Flag"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());
    var overviewHeading = $"{designation} of {stateName}";
    var baseTitle = string.IsNullOrWhiteSpace(stateName) ? designation : $"{stateName} {designation}";

    var flagName = SymbolDetailViewModel.FirstNonEmpty(Model.FlagContent?.Name, Model.Symbol?.Name);
    var pageHeading = !string.IsNullOrWhiteSpace(flagName)
        ? string.Equals(flagName.Trim(), baseTitle, StringComparison.OrdinalIgnoreCase)
            ? baseTitle
            : $"{baseTitle}: {flagName}"
        : baseTitle;

    var descRaw = Model.FlagContent?.SeoDescription ?? "";
    ViewData["Title"] = Model.FlagContent?.SeoTitle ?? pageHeading;
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s {designation.ToLowerInvariant()}, including design, symbolism, and key facts."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    ViewData["OgImage"] = Images.Full(Model.Symbol?.ImageUrl ?? Model.State?.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol?.ToSymbolUrl(Model.State?.Slug ?? string.Empty);

    var quickFacts = (Model.QuickFacts ?? Array.Empty<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();

    var hasMeaning = !string.IsNullOrWhiteSpace(Model.Meaning);
    var introText = Model.FlagContent?.IntroText ?? string.Empty;
    var overviewText = !string.IsNullOrWhiteSpace(introText)
        ? introText
        : adoptedYear > 0
            ? $"The official state flag of {stateName} was adopted in <strong>{adoptedYear}</strong>."
            : $"{stateName} recognizes {pageHeading} as its official state flag.";
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw)
        ? descRaw
        : !string.IsNullOrWhiteSpace(introText)
            ? introText
            : $"Learn about the official state flag of {stateName}.";
    var heroDescription = System.Net.WebUtility.HtmlDecode(
        System.Text.RegularExpressions.Regex.Replace(
            System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1"),
            "<.*?>",
            " "))
        .Trim();
}


<nav class="bg-white/90 shadow-[0_14px_34px_-30px_rgba(15,23,42,0.24)] backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">
        <div class="lg:grid lg:grid-cols-[232px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[228px_minmax(0,760px)_320px] xl:gap-12 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">

            <header class="lg:col-span-2 xl:col-span-3 mb-10">
                <div class="relative overflow-hidden rounded-none shadow-none bg-[linear-gradient(180deg,#2a171a_0%,#3a1f23_100%)] text-white">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-rose-200/0 via-rose-200/70 to-slate-200/0"></div>
                    <div class="absolute right-8 top-14 hidden h-48 w-48 rounded-full bg-rose-200/10 blur-3xl lg:block"></div>
                    <div class="absolute left-1/3 top-0 hidden h-40 w-40 rounded-full bg-white/10 blur-3xl lg:block"></div>

                    <div class="relative px-5 pb-7 pt-6 sm:px-6 lg:px-8 lg:pb-9 lg:pt-8 xl:px-10">
                        <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(300px,420px)] xl:grid-cols-[minmax(0,1fr)_460px] lg:items-start xl:gap-10">

                            <div class="min-w-0 order-1 pt-2 lg:pt-6">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-300">
                                    <span class="inline-flex items-center gap-2 text-white">
                                        <span class="block h-1.5 w-1.5 rounded-full bg-rose-300"></span>
                                        Official state symbol
                                    </span>
                                    <span>@stateName</span>
                                    <span>@designation</span>
                                    @if (adoptedYear > 0)
                                    {
                                        <span>Adopted @adoptedYear</span>
                                    }
                                    @if (standardizedYear > 0)
                                    {
                                        <span>Standardized @standardizedYear</span>
                                    }
                                </div>

                                <div class="mt-6 max-w-4xl">
                                    <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white leading-[0.98] sm:text-5xl lg:text-[4.15rem]">
                                        @pageHeading
                                    </h1>

                                    @if (!string.IsNullOrWhiteSpace(heroDescription))
                                    {
                                        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-100 sm:text-xl">
                                            @heroDescription
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(Model.Legislation))
                                    {
                    <div class="mt-7 hidden items-start gap-2 text-sm text-slate-300 lg:flex">
                                            <i class="fa-solid fa-scale-balanced mt-0.5 shrink-0 text-slate-400"></i>
                                            <span><strong class="text-white">Legal Reference:</strong> @Model.Legislation</span>
                                        </div>
                                    }

                                    <div class="mt-7 hidden border-t border-white/12 pt-5 lg:block">
                                        @await Html.PartialAsync("_ShareButtons", Model)
                                    </div>
                                </div>
                            </div>

                            <div class="order-2 lg:pt-5">
                                <figure>
                                    <div class="relative aspect-[16/9] overflow-hidden rounded-none shadow-none bg-slate-100/10">
                                        @if (!string.IsNullOrEmpty(Model.Symbol?.ImageUrl))
                                        {
                                            <img src="@Images.Hero(Model.Symbol!.ImageUrl)"
                                                 srcset="@Images.HeroSrcSet(Model.Symbol!.ImageUrl, 480, 768, 1200)"
                                                 sizes="(max-width: 1023px) 100vw, 460px"
                                                 alt="@pageHeading"
                                                 class="absolute inset-0 h-full w-full object-cover"
                                                 loading="eager"
                                                 fetchpriority="high" />
                                        }
                                        else
                                        {
                                            <div class="absolute inset-0 flex items-center justify-center">
                                                <i class="fa-solid fa-flag text-7xl text-slate-300"></i>
                                            </div>
                                        }
                                    </div>

                                    <figcaption class="mt-3 flex flex-wrap items-start justify-between gap-3 border-t border-white/15 pt-3">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-white">@pageHeading</p>
                                            <p class="text-xs uppercase tracking-[0.14em] text-slate-300">Official @designation of @stateName</p>
                                        </div>

                                        @if (!string.IsNullOrEmpty(Model.Symbol?.ImageUrl))
                                        {
                                            <a href="@Images.Full(Model.Symbol!.ImageUrl)"
                                               target="_blank"
                                               rel="nofollow noopener noreferrer"
                                               class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300 hover:text-white transition">
                                                <i class="fas fa-up-right-from-square shrink-0 text-[10px]"></i>
                                                View original
                                            </a>
                                        }
                                    </figcaption>
                                </figure>

                                @if (!string.IsNullOrWhiteSpace(Model.Legislation))
                                {
                                    <div class="mt-5 flex items-start gap-2 text-sm text-slate-300 lg:hidden">
                                        <i class="fa-solid fa-scale-balanced mt-0.5 shrink-0 text-slate-400"></i>
                                        <span><strong class="text-white">Legal Reference:</strong> @Model.Legislation</span>
                                    </div>
                                }

                                <div class="mt-5 border-t border-white/12 pt-4 lg:hidden">
                                    @await Html.PartialAsync("_ShareButtons", Model)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <aside class="hidden xl:block relative self-start xl:sticky xl:top-32">
                <div class="pr-2 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                <div class="content-flow site-content">
                    @await Html.PartialAsync("_Overview", null, new ViewDataDictionary(ViewData) {
                        { "Heading", overviewHeading },
                        { "Body", overviewText.RenderAutoLinks() }
                    })

                    @if (quickFacts.Any())
                    {
                        <div class="xl:hidden">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    }

                    @if (hasMeaning)
                    {
                        <section id="symbolic-meaning" class="content-divider">
                            <div class="rounded-[1.6rem] border border-slate-200/80 bg-white/40 p-6 sm:p-7">
                                <div class="flex items-start gap-4 lg:gap-5">
                                    <div class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-full bg-white/70 text-slate-600">
                                        <i class="fa-solid fa-book-open text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Symbolic Meaning</div>
                                        <div class="mt-3 max-w-3xl text-slate-700">
                                            @Model.Meaning.RenderAutoLinks()
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @await Html.PartialAsync("_FlagSections", Model)

                    <div class="content-divider">
                        @await Html.PartialAsync("_Faq", Model)
                    </div>

                    <section id="sources" class="content-divider">
                        @await Html.PartialAsync("_Sources", Model)
                    </section>

                    <div class="mt-10 space-y-8 xl:hidden" data-nosnippet>
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                        @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                    </div>

                    <div class="content-divider">
                        @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                    </div>
                </div>
            </div>

            <aside class="mt-12 hidden xl:block xl:col-span-1 xl:mt-0 relative self-start">
                @if (quickFacts.Any())
                {
                    <section class="relative min-h-[calc(100vh-5rem)] pb-16">
                        <div class="sticky top-32 pr-2">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    </section>
                }

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh-5rem)] pb-16">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                    </div>
                </section>

                <section class="relative mt-10 min-h-[calc(100vh+8rem)] pb-20">
                    <div class="sticky top-32 pr-2">
                        @await Html.PartialAsync("_GuidesAndRankingsSidebar")
                    </div>
                </section>
            </aside>
        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")

<script>
    document.querySelectorAll('.js-flag-color-copy').forEach(button => {
        button.addEventListener('click', async function () {
            const value = this.dataset.copyValue;
            const icon = this.querySelector('i');

            if (!value) {
                return;
            }

            try {
                await navigator.clipboard.writeText(value);
                this.classList.add('ring-2', 'ring-emerald-500');

                if (icon) {
                    icon.classList.remove('fa-copy');
                    icon.classList.add('fa-check');
                }

                setTimeout(() => {
                    this.classList.remove('ring-2', 'ring-emerald-500');

                    if (icon) {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-copy');
                    }
                }, 1400);
            } catch (error) {
                console.error('Failed to copy flag color value', error);
            }
        });
    });
</script>
