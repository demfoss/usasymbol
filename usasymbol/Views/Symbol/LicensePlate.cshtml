@model USASymbol.Models.ViewModels.LicensePlateDetailViewModel
@using System.Globalization
@using USASymbol.Extensions
@using USASymbol.Models.ViewModels
@inject IImageUrlService Images

@{
    var sloganName = SymbolDetailViewModel.FirstNonEmpty(Model.LicensePlateContent?.Title, Model.Symbol?.Name) ?? "State License Plate Slogan";
    var stateName = Model.State.Name;
    var adoptedYear = Model.LicensePlateContent?.AdoptedYear ?? Model.Symbol.AdoptedYear ?? 0;
    var colors = Model.Colors;

    var designationRaw = (Model.Symbol.Designation ?? "").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "License Plate Slogan"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());

    var titleIsAlreadyPageTitle =
        sloganName.Contains(stateName, StringComparison.OrdinalIgnoreCase) &&
        sloganName.Contains("License Plate Slogan", StringComparison.OrdinalIgnoreCase);
    var h1 = $"{stateName} {designation}";
    var displayName = titleIsAlreadyPageTitle ? Model.Symbol.Name : sloganName;

    ViewData["Title"] = Model.LicensePlateContent?.SeoTitle ?? h1;
    var descRaw = Model.LicensePlateContent?.SeoDescription ?? "";
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s {designation.ToLowerInvariant()} {sloganName}, including its history, meaning, and significance."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    var heroImage = Model.LicensePlateContent?.HeroImage;
    if (string.IsNullOrWhiteSpace(heroImage))
    {
        heroImage = Model.Symbol.ImageUrl;
    }
    if (string.IsNullOrWhiteSpace(heroImage))
    {
        heroImage = Model.LicensePlateContent?.VisualAssets?
            .FirstOrDefault(v => v.Layout == "full-width-tall" || v.Layout == "full-width")?.Src
            ?? Model.LicensePlateContent?.VisualAssets?.FirstOrDefault()?.Src;
    }

    ViewData["OgImage"] = Images.Full(heroImage ?? Model.State.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol.ToSymbolUrl(Model.State.Slug);

    var quickFacts = (Model.LicensePlateContent?.QuickFacts ?? new List<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();
    var introText = Model.LicensePlateContent?.IntroText ?? string.Empty;
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw)
        ? descRaw
        : !string.IsNullOrWhiteSpace(introText)
            ? introText
            : $"Learn about {stateName}'s {designation.ToLowerInvariant()} {sloganName}.";
    heroDescriptionSource = System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1");
    var heroDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, "<.*?>", " ")).Trim();
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        BackgroundClass = "bg-[linear-gradient(180deg,#1b2230_0%,#1f2735_100%)]",
        TopRuleClass = "bg-gradient-to-r from-sky-300/0 via-sky-300/70 to-amber-200/0",
        PrimaryGlowClass = "bg-amber-300/10",
        SecondaryGlowClass = "bg-sky-200/10",
        AccentDotClass = "bg-amber-300",
        MediaBackgroundClass = "bg-slate-100/10",
        FallbackIconClass = "fa-solid fa-id-card",
        Title = h1,
        Description = heroDescription,
        LegalReference = Model.Legislation,
        ImageUrl = heroImage,
        ImageAlt = !string.IsNullOrWhiteSpace(Model.LicensePlateContent?.HeroImageAlt)
            ? Model.LicensePlateContent.HeroImageAlt
            : displayName,
        HeroLabel = designation,
        FigureTitle = displayName,
        FigureSubtitle = $"{designation} of {stateName}",
        ImageLinkUrl = heroImage,
        EyebrowItems = new List<string> { stateName, designation, adoptedYear > 0 ? $"In use since {adoptedYear}" : string.Empty }
    };
}

<nav class="border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 xl:grid-cols-[200px_minmax(0,1fr)_300px] xl:gap-[2px] 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">
            @await Html.PartialAsync("_SymbolHero", heroModel)

            <aside class="hidden xl:block relative h-full">
                <div class="sticky top-24 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                @{
                    IHtmlContent plateOverviewBody = !string.IsNullOrEmpty(introText)
                        ? introText.RenderAutoLinks()
                        : new HtmlString($"<p>{Html.Encode(sloganName)} is the official {Html.Encode(designation.ToLowerInvariant())} of {Html.Encode(stateName)}.</p>");
                }
                @await Html.PartialAsync("_Overview", null, new ViewDataDictionary(ViewData) {
                    { "Heading", $"{designation} of {stateName}" },
                    { "Body", plateOverviewBody }
                })

                @if (quickFacts.Any())
                {
                    <div class="lg:hidden">
                        @await Html.PartialAsync("_QuickFacts", quickFacts)
                    </div>
                }

                <div class="article-content relative site-content">
                    @await Html.PartialAsync("_LicensePlateSections", Model)
                </div>

                <section id="plate-quiz-promo" class="content-divider">
                    <div class="overflow-hidden rounded-2xl border border-amber-200/80 bg-gradient-to-br from-amber-50/80 to-slate-50/60">
                        <div class="border-b border-amber-200/60 px-5 py-4 sm:px-6">
                            <div class="flex items-center gap-4">
                                <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-amber-100 text-amber-700">
                                    <i class="fa-solid fa-id-card text-xs"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h2 class="content-h2 !text-[1.4rem] !leading-snug text-slate-900">Can You Match All 50 License Plate Slogans?</h2>
                                    <div class="mt-1 text-sm leading-6 text-slate-500">From 'Vacationland' to 'Live Free or Die' — see how many you know.</div>
                                </div>
                            </div>
                        </div>
                        <div class="px-5 py-5 sm:px-6">
                            <p class="content-p text-slate-700">Each round shows a license plate and asks which state issued it. Some slogans are instantly recognizable. Others — 'Legendary,' 'Pacific Wonderland,' 'Constitution State' — will make you think. Questions and answer positions shuffle every time.</p>
                            <a href="/quizzes/state-license-plate-slogans-quiz" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors">
                                <span>Take the License Plate Slogans Quiz</span>
                                <i class="fas fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <div class="content-divider">
                    @await Html.PartialAsync("_Faq", Model)
                </div>

                <section id="sources" class="content-divider">
                    @await Html.PartialAsync("_Sources", Model)
                </section>

                <div class="mt-10 space-y-8 lg:hidden" data-nosnippet>
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                    @*@await Html.PartialAsync("_GuidesAndRankingsSidebar")*@
                </div>

                <div class="content-divider">
                    @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                </div>
            </div>

            <aside class="article-sidebar hidden lg:block" aria-label="Article sidebar">
                <div class="sidebar-content space-y-10">
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                </div>
            </aside>
        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")
