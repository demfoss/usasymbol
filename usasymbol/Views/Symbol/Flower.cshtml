@model USASymbol.Models.ViewModels.FlowerDetailViewModel
@using System.Globalization
@using USASymbol.Extensions
@using USASymbol.Models.ViewModels
@inject IImageUrlService Images

@{
    ViewData["BodyClass"] = "flower-detail-page";

    var flowerName = SymbolDetailViewModel.FirstNonEmpty(Model.FlowerContent?.Name, Model.Symbol?.Name) ?? "State Flower";
    var scientificName = Model.FlowerContent?.ScientificName ?? Model.Symbol?.ScientificName ?? "";
    var stateName = Model.State?.Name ?? "";
    var adoptedYear = Model.FlowerContent?.AdoptedYear ?? Model.Symbol?.AdoptedYear ?? 0;

    var designationRaw = (Model.Symbol?.Designation ?? "State Flower").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "State Flower"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());
    var overviewHeading = $"{designation} of {stateName}";

    var pageHeading = $"{stateName} {designation}: {flowerName}";

    var descRaw = Model.FlowerContent?.SeoDescription ?? "";
    ViewData["Title"] = Model.FlowerContent?.SeoTitle ?? pageHeading;
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s {designation.ToLowerInvariant()} {flowerName}, including adoption, symbolism, and key facts."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    ViewData["OgImage"] = Images.Full(Model.Symbol?.ImageUrl ?? Model.State?.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol?.ToSymbolUrl(Model.State?.Slug ?? string.Empty);

    var quickFacts = (Model.QuickFacts ?? Array.Empty<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();

    var hasMeaning = !string.IsNullOrWhiteSpace(Model.Meaning);
    var introText = Model.FlowerContent?.IntroText ?? string.Empty;
    var overviewText = !string.IsNullOrWhiteSpace(introText)
        ? introText
        : adoptedYear > 0 && !string.IsNullOrWhiteSpace(scientificName)
            ? $"In <strong>{adoptedYear}</strong>, {stateName} designated the {flowerName} (<span class=\"italic\">{scientificName}</span>) as its official state flower."
            : $"The {flowerName} is recognized as the official {designation.ToLowerInvariant()} of {stateName}.";
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw)
        ? descRaw
        : !string.IsNullOrWhiteSpace(introText)
            ? introText
            : $"The {flowerName} is recognized as the official {designation.ToLowerInvariant()} of {stateName}.";
    var heroDescription = System.Net.WebUtility.HtmlDecode(
        System.Text.RegularExpressions.Regex.Replace(
            System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1"),
            "<.*?>",
            " "))
        .Trim();
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        BackgroundClass = "bg-[linear-gradient(180deg,#1d2320_0%,#243129_100%)]",
        TopRuleClass = "bg-gradient-to-r from-emerald-200/0 via-emerald-200/70 to-amber-200/0",
        PrimaryGlowClass = "bg-rose-200/10",
        SecondaryGlowClass = "bg-emerald-100/10",
        AccentDotClass = "bg-rose-300",
        MediaBackgroundClass = "bg-slate-100/10",
        FallbackIconClass = "fa-solid fa-seedling",
        Title = pageHeading,
        Subtitle = scientificName,
        Description = heroDescription,
        LegalReference = Model.Legislation,
        ImageUrl = Model.Symbol?.ImageUrl,
        ImageAlt = flowerName,
        FigureTitle = flowerName,
        FigureSubtitle = $"Official {designation} of {stateName}",
        ImageLinkUrl = Model.Symbol?.ImageUrl,
        EyebrowItems = new List<string> { stateName, designation, adoptedYear > 0 ? $"Adopted {adoptedYear}" : string.Empty }
    };

}


<nav class="bg-white/90 shadow-[0_14px_34px_-30px_rgba(15,23,42,0.24)] backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 xl:grid-cols-[200px_minmax(0,760px)_320px] xl:gap-[2px] 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">

            @await Html.PartialAsync("_SymbolHero", heroModel)

            <aside class="hidden xl:block relative self-start xl:sticky xl:top-32">
                <div class="pr-2 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                <div class="article-content content-flow site-content">
                    @await Html.PartialAsync("_Overview", null, new ViewDataDictionary(ViewData) {
                        { "Heading", overviewHeading },
                        { "Body", overviewText.RenderAutoLinks() }
                    })

                    @if (quickFacts.Any())
                    {
                        <div class="lg:hidden">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    }

                    @if (hasMeaning)
                    {
                        <section id="symbolic-meaning" class="content-divider">
                            <div class="rounded-[1.6rem] border border-slate-200/80 bg-white/40 p-6 sm:p-7">
                                <div class="flex items-start gap-4 lg:gap-5">
                                    <div class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-full bg-white/70 text-slate-600">
                                        <i class="fa-solid fa-book-open text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Symbolic Meaning</div>
                                        <div class="mt-3 max-w-3xl text-slate-700">
                                            @Model.Meaning.RenderAutoLinks()
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @await Html.PartialAsync("_FlowerSections", Model)

                    <div class="content-divider">
                        @await Html.PartialAsync("_Faq", Model)
                    </div>

                    <section id="sources" class="content-divider">
                        @await Html.PartialAsync("_Sources", Model)
                    </section>

                    <div class="mt-10 space-y-8 lg:hidden" data-nosnippet>
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                        @*@await Html.PartialAsync("_GuidesAndRankingsSidebar")*@
                    </div>

                    <div class="content-divider">
                        @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                    </div>
                </div>
            </div>

            <aside class="article-sidebar hidden lg:block" aria-label="Article sidebar">
                <div class="sidebar-content space-y-10">
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                </div>
            </aside>
        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")
