@model IEnumerable<USASymbol.Models.ViewModels.SymbolCategoryViewModel>

@inject IImageUrlService Images

@{
    ViewData["Title"] = "U.S. State Symbol Categories";
    ViewData["Description"] = "All U.S. state symbols in one place, from birds and flowers to flags, mottos, and other official emblems adopted by each state.";
}

<!-- HERO SECTION -->
<section class="bg-blue-900 text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <span class="inline-flex items-center px-3 py-1 mb-4 text-xs font-semibold uppercase tracking-wide rounded-full bg-blue-800/70 border border-blue-500/40">
            <i class="fa-solid fa-layer-group mr-2"></i>
            State Symbols Directory
        </span>

        <h1 class="text-4xl md:text-5xl font-extrabold mb-3">
            Browse State Symbol Categories
        </h1>

        <p class="text-lg md:text-xl text-blue-100 mb-4">
            Explore official birds, flowers, trees, flags, and other symbols chosen by each U.S. state.
        </p>
    </div>
</section>

<!-- CATEGORIES GRID -->
<section class="py-10 md:py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">

        @if (Model != null && Model.Any())
        {
            <div class="category-grid category-grid--listing">

                @foreach (var category in Model)
                {
                    var stateLabel = category.StateCount == 1 ? "1 state" : $"{category.StateCount} states";
                    <a href="@category.Url"
                       class="category-card category-card--listing">
                        <div class="category-card__media">
                            @if (!string.IsNullOrEmpty(category.ImageUrl))
                            {
                                <img src="@Images.Card(category.ImageUrl)"
                                     srcset="@(Images.Card(category.ImageUrl, 240)) 240w,
                                             @(Images.Card(category.ImageUrl, 360)) 360w,
                                             @(Images.Card(category.ImageUrl, 480)) 480w"
                                     sizes="(max-width: 639px) 44vw, (max-width: 1023px) 30vw, 18vw"
                                     alt="@category.Name"
                                     loading="lazy">
                            }
                            else
                            {
                                <div class="category-card__icon" aria-hidden="true">
                                    <i class="@category.Icon"></i>
                                </div>
                            }
                            <span class="category-card__pill">@stateLabel</span>
                        </div>
                        <div class="category-card__body">
                            <div class="category-card__eyebrow">State Symbol Directory</div>
                            <h3 class="category-card__title">@category.Name</h3>
                            <div class="category-card__footer">
                                <span class="category-card__count">@stateLabel</span>
                                <span class="category-card__link">Open <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <p class="text-gray-500 text-lg">No symbol categories available yet.</p>
            </div>
        }

    </div>
</section>
