@model USASymbol.Models.ViewModels.MottoDetailViewModel
@using System.Globalization
@using USASymbol.Models.ViewModels
@using USASymbol.Extensions

@inject IImageUrlService Images

@{
    var mottoText = SymbolDetailViewModel.FirstNonEmpty(Model.MottoContent?.Title, Model.Symbol?.Name) ?? "State Motto";
    var language = Model.MottoContent?.Language ?? "Latin";
    var translation = Model.MottoContent?.EnglishTranslation ?? "";
    var stateName = Model.State?.Name ?? "";
    var adoptedYear = Model.MottoContent?.AdoptedYear ?? Model.Symbol?.AdoptedYear ?? 0;
    var audioPath = $"/sounds/mottos/{Model.State?.Slug}.mp3";

    var designationRaw = (Model.Symbol?.Designation ?? "State Motto").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "State Motto"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());

    var pageHeading = $"{stateName} {designation}: {mottoText}";
    var heroHeading = $"{stateName} {designation}";
    var descRaw = Model.MottoContent?.SeoDescription ?? "";
    var hasIntroText = !string.IsNullOrWhiteSpace(Model.MottoContent?.IntroText);
    var quickAnswerQuestion = $"What is {stateName}'s state motto?";
    var quickAnswerTranslation = !string.IsNullOrWhiteSpace(translation)
        ? $" It means \"{translation}\" in English."
        : string.Empty;
    var quickAnswerAdoption = adoptedYear > 0
        ? $" {stateName} adopted it in {adoptedYear}."
        : string.Empty;
    var quickAnswerLocation = !string.IsNullOrWhiteSpace(Model.Legislation)
        ? $" It is recognized in {Model.Legislation}."
        : $" It appears in {stateName}'s official state symbolism.";
    var quickAnswerText = $"{stateName}'s state motto is \"{mottoText}\".{quickAnswerTranslation}{quickAnswerAdoption}{quickAnswerLocation}";
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw)
        ? descRaw
        : (!string.IsNullOrWhiteSpace(translation)
            ? $"Usually translated as \"{translation}\", the phrase appears on the official seal of {stateName}."
            : $"The official motto of {stateName} appears on the state seal and coat of arms.");
    heroDescriptionSource = System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1");
    var heroSummary = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, "<.*?>", " ")).Trim();

    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MottoContent?.SeoTitle)
        ? pageHeading
        : Model.MottoContent!.SeoTitle;
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s official {designation.ToLowerInvariant()} \"{mottoText}\", including translation, history, and symbolism."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    ViewData["OgImage"] = Images.Full(Model.Symbol?.ImageUrl ?? $"/images/seals/{Model.State?.Slug}-seal.webp");
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol?.ToSymbolUrl(Model.State?.Slug ?? string.Empty);

    var quickFacts = (Model.QuickFacts ?? Array.Empty<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();

    var meaningText = Model.Meaning ?? "";
    var hasMeaningSection = Model.MottoContent?.Sections?.Any(s =>
        string.Equals(s.Id, "meaning", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(s.Id, "translation-and-meaning", StringComparison.OrdinalIgnoreCase)) == true;
    var hasMeaning = !hasMeaningSection &&
        (!string.IsNullOrWhiteSpace(meaningText) || !string.IsNullOrWhiteSpace(translation));
    var hasStandaloneMeaning = !string.IsNullOrWhiteSpace(meaningText)
        && !string.Equals(meaningText.Trim(), translation.Trim(), StringComparison.OrdinalIgnoreCase);
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        Variant = SymbolHeroVariant.Quote,
        BackgroundClass = "bg-[linear-gradient(180deg,#1f2937_0%,#111827_100%)]",
        TopRuleClass = "bg-gradient-to-r from-amber-300/0 via-amber-200/70 to-amber-300/0",
        PrimaryGlowClass = "bg-amber-300/12",
        SecondaryGlowClass = "bg-white/8",
        AccentDotClass = "bg-amber-300",
        MediaBackgroundClass = "bg-[linear-gradient(180deg,rgba(15,23,42,0.96),rgba(30,41,59,0.96))]",
        FallbackIconClass = "fa-solid fa-landmark",
        Title = heroHeading,
        Description = heroSummary,
        LegalReference = Model.Legislation,
        HeroLabel = "Official state motto",
        EyebrowItems = new List<string> { stateName, language, adoptedYear > 0 ? $"Adopted {adoptedYear}" : string.Empty },
        FeaturedLabel = "Official wording",
        FeaturedText = mottoText,
        FeaturedNoteLabel = !string.IsNullOrWhiteSpace(translation) ? "Translation" : null,
        FeaturedNoteText = translation,
        FeaturedBadges = new List<string> { language },
        ActionButtonId = "playHeroAudioBtn",
        ActionButtonLabel = "Listen",
        ActionButtonIconClass = "fas fa-play text-xs",
        ActionAudioSrc = audioPath
    };
}

<nav class="bg-white/90 shadow-[0_14px_34px_-30px_rgba(15,23,42,0.24)] backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 xl:grid-cols-[200px_minmax(0,1fr)_300px] xl:gap-[2px] 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">

            @await Html.PartialAsync("_SymbolHero", heroModel)

            <aside class="hidden xl:block relative h-full">
                <div class="sticky top-24 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                <div class="article-content content-flow site-content">
                    @if (quickFacts.Any())
                    {
                        <div class="lg:hidden">
                            @await Html.PartialAsync("_QuickFacts", quickFacts)
                        </div>
                    }

                    @if (hasMeaning)
                    {
                        <section id="translation-and-meaning" class="content-divider">
                            <div class="rounded-[1.8rem] bg-[linear-gradient(180deg,rgba(255,251,235,0.9),rgba(255,255,255,0.98))] p-6 shadow-[0_24px_46px_-34px_rgba(15,23,42,0.24)] sm:p-7">
                                <div class="flex items-start gap-4">
                                    <div class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-full bg-white text-slate-600 shadow-[0_14px_28px_-22px_rgba(15,23,42,0.26)]">
                                        <i class="fa-solid fa-language text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Translation And Meaning</h2>

                                        @if (!string.IsNullOrWhiteSpace(translation))
                                        {
                                            <div class="mt-3 inline-flex max-w-full items-center rounded-full bg-white px-4 py-2 text-sm font-semibold italic text-slate-700 shadow-[0_14px_28px_-22px_rgba(15,23,42,0.22)]">
                                                <span class="truncate">@translation</span>
                                            </div>
                                        }

                                        @if (hasStandaloneMeaning)
                                        {
                                            <div class="mt-4 max-w-3xl text-sm leading-7 text-slate-700 sm:text-base">
                                                @Model.Meaning.RenderAutoLinks()
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @await Html.PartialAsync("_MottoSections", Model)

                    <section id="mottos-quiz-promo" class="content-divider" data-nosnippet>
                        <div class="overflow-hidden rounded-2xl border border-amber-200/80 bg-gradient-to-br from-amber-50/80 to-slate-50/60">
                            <div class="border-b border-amber-200/60 px-5 py-4 sm:px-6">
                                <div class="flex items-center gap-4">
                                    <div class="inline-flex h-10 w-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] items-center justify-center rounded-full bg-amber-100 text-amber-700">
                                        <i class="fa-solid fa-landmark text-xs"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h2 class="content-h2 !text-[1.4rem] !leading-snug text-slate-900">Can You Match All 50 State Mottos?</h2>
                                        <div class="mt-1 text-sm leading-6 text-slate-500">Latin, French, Spanish, Hawaiian — see how many you recognize.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="px-5 py-5 sm:px-6">
                                <p class="content-p text-slate-700">Some questions show the original motto — Latin, Italian, Chinook — and ask which state it belongs to. Others give you the English translation and ask you to work backward. Both directions are harder than they look.</p>
                                <a href="/quizzes/state-mottos-quiz" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors">
                                    <span>Take the State Mottos Quiz</span>
                                    <i class="fas fa-arrow-right text-xs"></i>
                                </a>
                            </div>
                        </div>
                    </section>

                    <div class="content-divider">
                        @await Html.PartialAsync("_Faq", Model)
                    </div>

                    <section id="sources" class="content-divider">
                        @await Html.PartialAsync("_Sources", Model)
                    </section>

                    <div class="mt-10 space-y-8 lg:hidden" data-nosnippet>
                        @await Html.PartialAsync("_RelatedSymbols", Model)
                        @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                        @*@await Html.PartialAsync("_GuidesAndRankingsSidebar")*@
                    </div>

                    <div class="content-divider">
                        @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                    </div>
                </div>
            </div>

            <aside class="article-sidebar hidden lg:block" aria-label="Article sidebar">
                <div class="sidebar-content space-y-10">
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                </div>
            </aside>
        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")
<script>
    (function () {
        const audioEl = document.getElementById('heroAudio');
        const buttons = ['playHeroAudioBtn', 'playHeroAudioBtnMobile']
            .map(id => document.getElementById(id))
            .filter(Boolean);
        if (!audioEl || !buttons.length) return;

        const setIcons = (isPlaying) => {
            buttons.forEach(button => {
                const icon = button.querySelector('i');
                if (!icon) return;
                icon.className = isPlaying ? 'fas fa-pause text-xs' : 'fas fa-play text-xs';
            });
        };

        const hide = () => {
            buttons.forEach(button => button.style.display = 'none');
        };

        audioEl.addEventListener('error', hide);

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                if (audioEl.paused) {
                    audioEl.play().then(() => {
                        setIcons(true);
                    }).catch(hide);
                } else {
                    audioEl.pause();
                    setIcons(false);
                }
            });
        });

        audioEl.addEventListener('ended', () => {
            setIcons(false);
        });
    })();
</script>
