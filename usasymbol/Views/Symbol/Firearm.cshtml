@model USASymbol.Models.ViewModels.FirearmDetailViewModel
@using System.Globalization
@using USASymbol.Extensions
@using USASymbol.Models.ViewModels
@inject IImageUrlService Images

@{
    var firearmName = SymbolDetailViewModel.FirstNonEmpty(Model.FirearmContent?.Title, Model.Symbol?.Name) ?? "State Firearm";
    var stateName = Model.State.Name;
    var adoptedYear = Model.FirearmContent?.AdoptedYear ?? Model.Symbol.AdoptedYear ?? 0;
    var colors = Model.Colors;

    var designationRaw = (Model.Symbol.Designation ?? "").Trim();
    var designation = string.IsNullOrWhiteSpace(designationRaw)
        ? "State Firearm"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(designationRaw.ToLowerInvariant());
    var overviewHeading = $"{designation} of {stateName}";

    var h1 = $"{stateName} {designation}: {firearmName}";

    // SEO fallbacks (avoid nulls)
    ViewData["Title"] = Model.FirearmContent?.SeoTitle ?? h1;

    var descRaw = Model.FirearmContent?.SeoDescription ?? "";
    ViewData["Description"] = string.IsNullOrWhiteSpace(descRaw)
        ? $"Learn about {stateName}'s {designation.ToLowerInvariant()} {firearmName}, including history, meaning, and key facts."
        : System.Net.WebUtility.HtmlDecode(descRaw);
    ViewData["OgImage"] = Images.Full(Model.Symbol.ImageUrl ?? Model.State.FlagImageUrl);
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = Model.Symbol.ToSymbolUrl(Model.State.Slug);

    var quickFacts = (Model.FirearmContent?.QuickFacts ?? new List<QuickFactItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x?.Value))
        .ToList();
    var introText = Model.FirearmContent?.IntroText ?? string.Empty;
    var heroDescriptionSource = !string.IsNullOrWhiteSpace(descRaw)
        ? descRaw
        : !string.IsNullOrWhiteSpace(introText)
            ? introText
            : $"The {firearmName} is recognized as the official {designation.ToLowerInvariant()} of {stateName}.";
    heroDescriptionSource = System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, @"\[(.*?)\]\((.*?)\)", "$1");
    var heroDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(heroDescriptionSource, "<.*?>", " ")).Trim();
    var heroModel = new SymbolHeroViewModel
    {
        PageModel = Model,
        BackgroundClass = "bg-[linear-gradient(180deg,#1b2230_0%,#1f2735_100%)]",
        TopRuleClass = "bg-gradient-to-r from-sky-300/0 via-sky-300/70 to-amber-200/0",
        PrimaryGlowClass = "bg-amber-300/10",
        SecondaryGlowClass = "bg-sky-200/10",
        AccentDotClass = "bg-amber-300",
        MediaBackgroundClass = "bg-slate-100/10",
        FallbackIconClass = "fa-solid fa-gun",
        Title = h1,
        Subtitle = Model.FirearmContent?.ActionType,
        Description = heroDescription,
        LegalReference = Model.Legislation,
        ImageUrl = Model.Symbol.ImageUrl,
        ImageAlt = firearmName,
        FigureTitle = firearmName,
        FigureSubtitle = $"Official {designation} of {stateName}",
        ImageLinkUrl = Model.Symbol.ImageUrl,
        EyebrowItems = new List<string> { stateName, designation, adoptedYear > 0 ? $"Adopted {adoptedYear}" : string.Empty }
    };
}

<nav class="border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-[1440px] mx-auto px-4 py-3 xl:px-8">
        @await Html.PartialAsync("_Breadcrumbs", Model)
    </div>
</nav>

<div id="top"></div>

<div class="max-w-[1440px] mx-auto px-4 lg:px-6 xl:px-8 py-6 lg:py-10">
    <article class="symbol-editorial w-full">

        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 xl:grid-cols-[200px_minmax(0,1fr)_300px] xl:gap-[2px] 2xl:grid-cols-[216px_minmax(0,760px)_320px] 2xl:justify-center 2xl:gap-12 relative">
            @await Html.PartialAsync("_SymbolHero", heroModel)

            <aside class="hidden xl:block relative h-full">
                <div class="sticky top-24 pb-10">
                    @await Html.PartialAsync("_TocSidebar", Model)
                </div>
            </aside>

            <div class="min-w-0">
                @{
                    IHtmlContent firearmOverviewBody = !string.IsNullOrEmpty(introText)
                        ? introText.RenderAutoLinks()
                        : new HtmlString($"<p>The {Html.Encode(firearmName)} is recognized as the official {Html.Encode(designation.ToLowerInvariant())} of {Html.Encode(stateName)}.</p>");
                }
                @await Html.PartialAsync("_Overview", null, new ViewDataDictionary(ViewData) {
                    { "Heading", overviewHeading },
                    { "Body", firearmOverviewBody }
                })

                @if (quickFacts.Any())
                {
                    <div class="lg:hidden">
                        @await Html.PartialAsync("_QuickFacts", quickFacts)
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Meaning))
                {
                    <div class="mb-8 rounded-xl bg-slate-50/50 border-l-4 @colors.Border p-6">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-widest mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-book-open text-slate-400"></i> Symbolic Meaning
                        </h3>
                        <p class="text-slate-800 text-lg leading-relaxed">
                            @Model.Meaning.RenderAutoLinks()
                        </p>
                    </div>
                }

                @* Important: keep content links clickable even with fancy overlays inside partials *@
                <div class="article-content relative firearm-content-flow site-content">
                    @await Html.PartialAsync("_FirearmSections", Model)
                </div>

                <div class="content-divider">
                    @await Html.PartialAsync("_Faq", Model)
                </div>

                <section id="sources" class="content-divider">
                    @await Html.PartialAsync("_Sources", Model)
                </section>

                <div class="content-divider">
                    @await Html.PartialAsync("_AuthorBox", Model.AuthorBox)
                </div>

                <div class="mt-12 lg:hidden">

                    @await Html.PartialAsync("_RelatedSymbols", Model)

                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)

                </div>
            </div>

            <aside class="article-sidebar hidden lg:block" aria-label="Article sidebar">
                <div class="sidebar-content space-y-10">
                    @await Html.PartialAsync("_RelatedSymbols", Model)
                    @await Html.PartialAsync("_RelatedStatesSidebar", Model)
                </div>
            </aside>

        </div>

        @if (ViewData["LatestContentRail"] is USASymbol.Models.ViewModels.LatestContentRailViewModel latestContentRail && latestContentRail.Items.Any())
        {
            <div class="mt-14">
                @await Html.PartialAsync("_LatestContentRail", latestContentRail)
            </div>
        }
    </article>
</div>

@await Html.PartialAsync("_TocMobileFab", Model)
@await Html.PartialAsync("_StructuredData", Model)
@await Html.PartialAsync("_Scripts")
