@using System.Text.Json
@using System.Text.Encodings.Web
@model usasymbol.Models.Quiz
@inject usasymbol.Services.QuizService QuizSvc

@{
    var pageTitle = Model.Seo?.Title ?? Model.Title;
    var pageDesc = Model.Seo?.Description ?? Model.Description;

    ViewData["Title"] = pageTitle;
    ViewData["Description"] = pageDesc;

    // Shared score link (?s=8&n=10&m=practice&g=1101110111): show a result card in the preview.
    int? sharedScore = null, sharedTotal = null;
    if (int.TryParse(Context.Request.Query["s"], out var qs) && int.TryParse(Context.Request.Query["n"], out var qn) && qn > 0 && qn <= 200 && qs >= 0 && qs <= qn)
    {
        sharedScore = qs; sharedTotal = qn;
        var shareQuery = $"s={qs}&n={qn}&m={Uri.EscapeDataString(Context.Request.Query["m"].ToString())}&g={Uri.EscapeDataString(Context.Request.Query["g"].ToString())}";
        ViewData["OgImage"] = $"/quizzes/{Model.Slug}/share.png?{shareQuery}";
        ViewData["Canonical"] = $"/quizzes/{Model.Slug}";
        ViewData["Title"] = $"I scored {qs}/{qn} on the {Model.Title}. Can you beat it?";
    }
    var dailySlug = QuizSvc.GetDailyQuizSlug();

    const string origin = "https://usasymbol.com";
    var url = $"{origin}{Context.Request.Path}";
    var imageRightsUrl = $"{origin}/terms#image-rights";
    var imageLicensePageUrl = $"{origin}/contact";

    var questionsCount = Model.Questions?.Count ?? 0;
    var isTypedAnswer = string.Equals(Model.AnswerMode, "typed", StringComparison.OrdinalIgnoreCase);
    var questionsPerRound = Model.QuestionsPerRound > 0
        ? Math.Min(Model.QuestionsPerRound, questionsCount)
        : Math.Min(10, questionsCount);
    var estimated = string.IsNullOrWhiteSpace(Model.EstimatedTime) ? "5–10 minutes" : Model.EstimatedTime;
    var mode = (Context.Request.Query["mode"].ToString() ?? "").ToLowerInvariant();
    if (mode != "classic" && mode != "timed") mode = "practice";

    var faq = Model.Faq ?? new List<usasymbol.Models.QuizFaq>();

    var graph = new List<object>();

    graph.Add(new Dictionary<string, object?>
    {
        ["@type"] = "Quiz",
        ["@id"] = $"{url}#quiz",
        ["name"] = pageTitle,
        ["description"] = pageDesc,
        ["numberOfQuestions"] = questionsCount,
        ["url"] = url,
        ["educationalUse"] = "Assessment",
        ["learningResourceType"] = "Interactive Quiz",
        ["audience"] = new Dictionary<string, object?>
        {
            ["@type"] = "EducationalAudience",
            ["educationalRole"] = "student"
        },
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = string.IsNullOrWhiteSpace(Model.Author) ? "USA Symbol Team" : Model.Author
        },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "USA Symbol",
            ["url"] = origin,
            ["logo"] = new Dictionary<string, object?>
            {
                ["@type"] = "ImageObject",
                ["url"] = $"{origin}/images/logo.png",
                ["contentUrl"] = $"{origin}/images/logo.png",
                ["creator"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "USA Symbol", ["url"] = origin },
                ["creditText"] = "USA Symbol",
                ["copyrightNotice"] = "Copyright USA Symbol unless otherwise noted.",
                ["license"] = imageRightsUrl,
                ["acquireLicensePage"] = imageLicensePageUrl
            }
        },
        ["datePublished"] = Model.DatePublished.ToString("yyyy-MM-dd"),
        ["dateModified"] = Model.DateModified.ToString("yyyy-MM-dd"),
        ["keywords"] = string.Join(", ", (Model.Tags ?? new List<string>()))
    });

    graph.Add(new Dictionary<string, object?>
    {
        ["@type"] = "BreadcrumbList",
        ["@id"] = $"{url}#breadcrumb",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?>{ ["@type"]="ListItem", ["position"]=1, ["name"]="Home", ["item"]= $"{origin}/" },
            new Dictionary<string, object?>{ ["@type"]="ListItem", ["position"]=2, ["name"]="Quizzes", ["item"]= $"{origin}/quizzes" },
            new Dictionary<string, object?>{ ["@type"]="ListItem", ["position"]=3, ["name"]= Model.Title, ["item"]= url }
        }
    });

    if (faq.Any())
    {
        var faqEntities = faq.Select(f => (object)new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = f.Answer
            }
        }).ToList();

        graph.Add(new Dictionary<string, object?>
        {
            ["@type"] = "FAQPage",
            ["@id"] = $"{url}#faq",
            ["mainEntity"] = faqEntities
        });
    }

    var jsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = graph
    };

    var jsonLdString = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        WriteIndented = false
    });

    var lead = !string.IsNullOrWhiteSpace(pageDesc)
        ? pageDesc
        : "Test how fast you can recognize every U.S. state flag with instant feedback and randomized questions.";
    var poolSize = questionsCount;
    var startImages = (Model.Questions ?? new List<usasymbol.Models.QuizQuestion>())
        .Where(q => !string.IsNullOrWhiteSpace(q.ImageUrl))
        .Select(q => q.ImageUrl)
        .Distinct()
        .OrderBy(_ => Random.Shared.Next())
        .Take(5)
        .ToList();
    var moreQuizzes = QuizSvc.GetAll()
        .Where(q => q.Slug != Model.Slug && !q.Slug.EndsWith("-state-symbols-quiz"))
        .OrderBy(_ => Random.Shared.Next())
        .Take(3)
        .Select(q => new { title = q.Title, url = "/quizzes/" + q.Slug, meta = (q.Questions?.Count ?? 0) + " questions \u00B7 " + q.Difficulty })
        .ToList();
    var mistakes = ViewData["CommonMistakes"] as List<usasymbol.Controllers.QuizMistake> ?? new List<usasymbol.Controllers.QuizMistake>();
    var round = questionsPerRound;
}

<script type="application/ld+json">@Html.Raw(jsonLdString)</script>

<style>
    @@keyframes usas-float-up {
        from

    {
        transform: translateY(0);
        opacity: 1;
    }

    to {
        transform: translateY(-22px);
        opacity: 0;
    }

    }

    .usas-float-up {
        animation: usas-float-up 800ms ease-out forwards;
    }

    @@keyframes quiz-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.02); }
    }

    @@keyframes quiz-rise-in {
        from {
            opacity: 0;
            transform: translateY(16px) scale(0.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .quiz-start-panel {
        background:
            radial-gradient(circle at 15% 18%, rgba(244, 114, 182, 0.14), transparent 18%),
            radial-gradient(circle at top, rgba(250, 204, 21, 0.14), transparent 34%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.12), transparent 30%),
            linear-gradient(180deg, rgba(248,250,252,0.98), rgba(255,255,255,0.98));
    }

    .quiz-mode-pill {
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    }

    .quiz-start-cta {
        animation: quiz-pulse 2.3s ease-in-out infinite;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
    }

    .quiz-answer-btn {
        transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease, border-color 160ms ease;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
    }

    .quiz-answer-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08);
    }

    .quiz-result-shell {
        background:
            radial-gradient(circle at 12% 16%, rgba(34, 197, 94, 0.12), transparent 20%),
            radial-gradient(circle at top, rgba(250, 204, 21, 0.12), transparent 26%),
            radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.1), transparent 24%),
            linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.98));
    }

    .quiz-glow-card {
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    .quiz-badge-card {
        position: relative;
        overflow: hidden;
    }

    .quiz-badge-card::before {
        content: "";
        position: absolute;
        inset: auto -20% 55% auto;
        width: 7rem;
        height: 7rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.35);
        pointer-events: none;
    }

    .quiz-badge-icon {
        width: 2.4rem;
        height: 2.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: rgba(255,255,255,0.8);
        border: 1px solid rgba(255,255,255,0.9);
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
        font-size: 1.05rem;
        flex: 0 0 auto;
    }

    .quiz-result-animate {
        animation: quiz-rise-in 520ms ease-out both;
    }

    .quiz-delay-1 { animation-delay: 60ms; }
    .quiz-delay-2 { animation-delay: 120ms; }
    .quiz-delay-3 { animation-delay: 180ms; }
    .quiz-delay-4 { animation-delay: 240ms; }

    .quiz-ornament {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        filter: blur(2px);
        opacity: 0.9;
    }

    .quiz-ornament-gold {
        background: radial-gradient(circle, rgba(250, 204, 21, 0.7), rgba(250, 204, 21, 0));
    }

    .quiz-ornament-blue {
        background: radial-gradient(circle, rgba(96, 165, 250, 0.6), rgba(96, 165, 250, 0));
    }

    .quiz-seo-article {
        display: grid;
        gap: 1.5rem;
    }

    .quiz-seo-section {
        padding: 2rem;
        border: 1px solid rgb(226 232 240 / 0.95);
        border-radius: 1.75rem;
        background:
            radial-gradient(circle at top right, rgba(191, 219, 254, 0.16), transparent 32%),
            linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.96));
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.05);
    }

    .quiz-seo-section h2 {
        margin: 0;
        font-size: clamp(1.7rem, 2.8vw, 2.35rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        font-weight: 800;
        color: rgb(15 23 42);
        text-wrap: balance;
    }

    .quiz-seo-section p {
        margin: 1rem 0 0;
        max-width: 42rem;
        font-size: 1.02rem;
        line-height: 1.85;
        color: rgb(51 65 85);
    }

    .quiz-seo-list {
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.8rem;
    }

    .quiz-seo-list li {
        position: relative;
        padding: 0.95rem 1.1rem 0.95rem 3.85rem;
        border-radius: 1.1rem;
        border: 1px solid rgb(226 232 240);
        background: rgba(255, 255, 255, 0.9);
        line-height: 1.65;
        color: rgb(30 41 59);
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.035);
    }

    .quiz-seo-list li::before {
        content: "";
        position: absolute;
        left: 1rem;
        top: 50%;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        transform: translateY(-50%);
        background: linear-gradient(135deg, rgb(37 99 235), rgb(30 64 175));
        box-shadow: 0 10px 18px rgba(37, 99, 235, 0.24);
    }

    .quiz-seo-list li::after {
        content: "";
        position: absolute;
        left: 1.78rem;
        top: 50%;
        width: 0.42rem;
        height: 0.8rem;
        border-right: 2px solid white;
        border-bottom: 2px solid white;
        transform: translateY(-63%) rotate(45deg);
    }

    .quiz-facts-card {
        border-radius: 1.75rem;
        border: 1px solid rgb(226 232 240 / 0.95);
        background:
            linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.96));
        box-shadow: 0 22px 50px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .quiz-facts-head {
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid rgb(241 245 249);
        background: linear-gradient(180deg, rgba(239,246,255,0.95), rgba(255,255,255,0));
    }

    .quiz-facts-grid {
        padding: 1.25rem 1.5rem 0;
    }

    .quiz-facts-grid > div {
        align-items: center;
        padding: 0.85rem 0;
    }

    .quiz-facts-grid > div + div {
        border-top: 1px solid rgb(241 245 249);
    }

    .quiz-facts-cta {
        padding: 1.5rem;
    }

    @@media (max-width: 767px) {
        .quiz-seo-section {
            padding: 1.35rem;
            border-radius: 1.25rem;
        }

        .quiz-seo-section h2 {
            font-size: 1.75rem;
        }

        .quiz-seo-list li {
            padding-left: 3.4rem;
        }
    }
</style>

@section Styles {
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/quiz-play.css" asp-append-version="true">
}

<nav class="pdh-breadcrumb-shell" aria-label="Breadcrumb">
    <div>
        <ol class="pdh-breadcrumbs">
            <li><a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a></li>
            <li aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></li>
            <li><a href="/quizzes">Quizzes</a></li>
            <li aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></li>
            <li aria-current="page"><span>@pageTitle</span></li>
        </ol>
    </div>
</nav>

<header class="qz-hero">
    <div class="qz-hero-inner">
        <h1 class="qz-title">@pageTitle</h1>
        <p class="qz-lead">@lead</p>
    </div>
</header>

<article class="page-shell-2col max-w-[1180px] mx-auto px-4 sm:px-7">
<div class="article-content min-w-0">
<!-- QUIZ APP -->
<section class="pt-6 md:pt-8 pb-10">
    <div>
        @if (sharedScore.HasValue)
        {
            <div class="qz-challenge">A friend scored <b>@sharedScore/@sharedTotal</b> on this quiz. Think you can beat it?</div>
        }
        <div class="qz-card" id="quizApp">
            <div id="quizStartScreen" class="qz-start">
                @if (startImages.Any())
                {
                    <div class="qz-strip" aria-hidden="true">
                        @foreach (var img in startImages)
                        {
                            <img src="@img" alt="" loading="lazy" decoding="async">
                        }
                    </div>
                }
                <fieldset class="qz-modes" aria-describedby="qzRound">
                    <legend class="qz-start-label">Choose how to play</legend>
                    <label class="qz-mode">
                        <input type="radio" name="quizMode" value="practice" @(mode == "practice" ? "checked" : "")>
                        <span class="qz-mode-body">
                            <span class="qz-mode-name">Practice</span>
                            <span class="qz-mode-desc">No timer. See the answer after each question.</span>
                        </span>
                    </label>
                    <label class="qz-mode">
                        <input type="radio" name="quizMode" value="classic" @(mode == "classic" ? "checked" : "")>
                        <span class="qz-mode-body">
                            <span class="qz-mode-name">Classic</span>
                            <span class="qz-mode-desc">20 seconds per question. Faster answers score more.</span>
                        </span>
                    </label>
                    <label class="qz-mode">
                        <input type="radio" name="quizMode" value="timed" @(mode == "timed" ? "checked" : "")>
                        <span class="qz-mode-body">
                            <span class="qz-mode-name">Timed</span>
                            <span class="qz-mode-desc">One minute on the clock. Answer as many as you can.</span>
                        </span>
                    </label>
                </fieldset>

                <p id="qzRound" class="qz-round"
                   data-round="@round" data-pool="@poolSize"></p>
                <p class="qz-meta">@Model.Difficulty · @estimated @(isTypedAnswer ? "· type every answer" : "")</p>

                <button id="startQuizBtn" type="button" class="qz-start-btn">Start Practice</button>
            </div>

            <div id="quizStage" class="qz-stage" hidden>
                <div class="qz-hud">
                    <div class="qz-seg" id="qzSeg" aria-hidden="true"></div>
                    <div class="qz-hud-row">
                        <span class="qz-count" id="qzCount" aria-live="polite">Question 1</span>
                        <span class="qz-score" id="qzScore">0 pts</span>
                        <button type="button" id="qzPause" class="qz-pause" hidden>Pause</button>
                    </div>
                    <div class="qz-timer" id="qzTimer" hidden>
                        <div class="qz-timer-track"><i id="qzTimerBar"></i></div>
                        <span class="qz-timer-text" id="qzTimerText">20s</span>
                    </div>
                </div>

                <div class="qz-body">
                    <div id="questionImage" class="qz-image" hidden></div>
                    <h2 id="questionText" class="qz-question"></h2>

                    <div id="answers" class="qz-answers"></div>

                    @if (isTypedAnswer)
                    {
                        <form id="typedAnswerForm" class="qz-typed" novalidate>
                            <label for="typedAnswerInput" class="sr-only">Type your answer</label>
                            <input id="typedAnswerInput" class="qz-input" type="text" inputmode="text" autocomplete="off"
                                   autocapitalize="words" spellcheck="false" placeholder="Type the state name" />
                            <button id="typedAnswerSubmit" type="submit" class="qz-btn qz-btn-primary">Submit</button>
                        </form>
                    }

                    <div id="qzNote" class="qz-note" role="status" aria-live="polite" hidden></div>
                </div>

                <div id="qzPaused" class="qz-paused" hidden>
                    <div>
                        <div class="qz-paused-title">Paused</div>
                        <p>The question is hidden while the clock is stopped.</p>
                        <button type="button" id="qzResume" class="qz-btn qz-btn-primary">Resume</button>
                    </div>
                </div>
            </div>

            <div id="quizResult" hidden></div>
        </div>
    </div>
</section>

<section class="max-w-6xl mx-auto px-4 pb-8">
    <div class="text-xs text-slate-500">
        Created by <span class="font-medium text-slate-700">@(string.IsNullOrWhiteSpace(Model.Author) ? "USA Symbol Team" : Model.Author)</span>
        · Updated <span class="font-medium text-slate-700">@Model.DateModified.ToString("MMMM d, yyyy")</span>
        · <span class="inline-flex items-center gap-2 ml-2 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100 px-2 py-0.5">
            Verified
        </span>
    </div>
</section>

<!-- STATIC CONTENT (indexable, no JS needed) -->
<section class="pb-12">
    <div class="qz-seo">
        @if (Model.Content?.Sections?.Any() == true)
        {
            foreach (var sec in Model.Content.Sections)
            {
                var codeItems = (sec.List ?? new List<string>())
                    .Select(li => System.Text.RegularExpressions.Regex.Match(li, @"^([A-Z]{2})\s+[\u2014\u2013-]\s+(.+)$"))
                    .ToList();
                var isCodeList = codeItems.Count > 0 && codeItems.All(m => m.Success);

                <section class="qz-seo-box">
                    @if (!string.IsNullOrWhiteSpace(sec.Title))
                    {
                        <h2 id="@sec.Id">@sec.Title</h2>
                    }

                    @if (sec.Paragraphs?.Any() == true)
                    {
                        foreach (var para in sec.Paragraphs)
                        {
                            <p>@para</p>
                        }
                    }

                    @if (isCodeList)
                    {
                        <ul class="qz-code-grid">
                            @foreach (var m in codeItems)
                            {
                                <li><b>@m.Groups[1].Value</b><span>@m.Groups[2].Value</span></li>
                            }
                        </ul>
                    }
                    else if (sec.List?.Any() == true)
                    {
                        <ul class="qz-list">
                            @foreach (var li in sec.List)
                            {
                                <li>@li</li>
                            }
                        </ul>
                    }

                    @if (sec.Links?.Any() == true)
                    {
                        <div class="mt-4 flex flex-wrap gap-3">
                            @foreach (var link in sec.Links)
                            {
                                <a href="@link.Href" class="qz-btn no-underline">
                                    @link.Text <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    }
                </section>
            }
        }

        @{ var relatedCollections = usasymbol.Services.QuizLinks.CollectionsForQuiz(Model.Slug); }
        @if (relatedCollections.Count > 0)
        {
            <section class="qz-seo-box">
                <h2>Keep reading</h2>
                <p>Collections that go deeper into the same topic.</p>
                <div class="mt-3 flex flex-wrap gap-3">
                    @foreach (var rc in relatedCollections)
                    {
                        <a href="@rc.Url" class="qz-btn no-underline">@rc.Title <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i></a>
                    }
                </div>
            </section>
        }

        @if (mistakes.Any())
        {
            <section class="qz-seo-box">
                <h2>Questions players miss most</h2>
                <p>Based on anonymous answers from people who played this quiz.</p>
                <ul class="qz-list">
                    @foreach (var m in mistakes)
                    {
                        <li class="qz-miss"><span>@m.Question</span><b>~@m.MissPercent% miss</b></li>
                    }
                </ul>
            </section>
        }

        @if (Model.Questions?.Any() == true)
        {
            <details class="qz-seo-box qz-details">
                <summary>Show all @Model.Questions.Count answers (spoilers)</summary>
                <table class="qz-answers-table">
                    <thead><tr><th>Question</th><th>Answer</th></tr></thead>
                    <tbody>
                        @foreach (var q in Model.Questions)
                        {
                            <tr>
                                <td>@q.Question</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(q.LinkUrl))
                                    {
                                        <a href="@q.LinkUrl" class="no-underline" style="color:inherit;border-bottom:1px solid #a8791a">@q.CorrectAnswer</a>
                                    }
                                    else
                                    {
                                        @q.CorrectAnswer
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }

        @if (faq.Any())
        {
            <section class="qz-seo-box" id="faq">
                <h2>Frequently asked questions</h2>
                <div class="mt-3 grid gap-2">
                    @foreach (var f in faq)
                    {
                        <details class="qz-details" style="padding:12px 14px;border:1px solid #e7edf2;border-radius:8px">
                            <summary>@f.Question</summary>
                            <div class="pt-2" style="color:#55697b;font:400 1.05rem/1.6 var(--font-sans)">@f.Answer.RenderAutoLinks()</div>
                        </details>
                    }
                </div>
            </section>
        }
    </div>
</section>
</div>

<aside class="article-sidebar hidden lg:block pt-4 md:pt-6 pb-12" aria-label="Quiz sidebar">
    <div class="sidebar-content space-y-8">
            <div class="quiz-facts-card">
                <div class="quiz-facts-head">
                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">Quick facts</div>
                    <div class="mt-2 text-lg font-bold text-slate-900">Before you start</div>
                    <p class="mt-2 text-sm leading-6 text-slate-600">A fast overview of the quiz format so the page feels easier to scan before jumping in.</p>
                </div>

                <dl class="quiz-facts-grid text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Total questions</dt>
                        <dd class="font-semibold text-slate-900">@questionsCount</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Typical time</dt>
                        <dd class="font-semibold text-slate-900">@estimated</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Difficulty</dt>
                        <dd class="font-semibold text-slate-900">@Model.Difficulty</dd>
                    </div>
                </dl>

                <div class="quiz-facts-cta">
                    <button class="w-full rounded-xl bg-slate-900 text-white px-5 py-3 font-semibold hover:bg-slate-800 transition"
                            onclick="document.getElementById('quizApp').scrollIntoView({behavior:'smooth'});">
                        Jump to quiz
                    </button>
                </div>
            </div>

            @await Html.PartialAsync("_GuidesAndRankingsSidebar")
    </div>
</aside>
</article>

<script>
    window.QUIZ = {
        slug: @Html.Raw(JsonSerializer.Serialize(Model.Slug)),
        title: @Html.Raw(JsonSerializer.Serialize(Model.Title)),
        typed: @Html.Raw(isTypedAnswer ? "true" : "false"),
        perRound: @questionsPerRound,
        questions: @Html.Raw(JsonSerializer.Serialize(Model.Questions).Replace("</", "<\\/")),
        more: @Html.Raw(JsonSerializer.Serialize(moreQuizzes)),
        stats: @Html.Raw(JsonSerializer.Serialize(ViewData["AnswerStats"] ?? new Dictionary<string, Dictionary<string, int>>())),
        daily: { slug: @Html.Raw(JsonSerializer.Serialize(dailySlug)), date: "@DateTime.UtcNow.ToString("yyyy-MM-dd")" }
    };
</script>
<script src="~/js/quiz-play.js" asp-append-version="true" defer></script>
