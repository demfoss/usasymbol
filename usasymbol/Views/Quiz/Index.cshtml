@using System.Text.Json
@using System.Text.Encodings.Web
@model List<usasymbol.Models.Quiz>

@inject IImageUrlService Images

@{
    ViewData["Title"] = "U.S. State Symbol Quizzes | USA Symbol";
    ViewData["Description"] = "Free quizzes on U.S. state symbols—flags, birds, flowers, seals, mottos, and more. Search by category, play quick rounds, and learn with explanations.";

    var allQuizzes = Model ?? new List<usasymbol.Models.Quiz>();

    var categories = allQuizzes
        .Select(q => (q.Category ?? "").Trim())
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();

    var difficulties = allQuizzes
        .Select(q => (q.Difficulty ?? "").Trim())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();

    int CountByCat(string cat) =>
        allQuizzes.Count(q => string.Equals((q.Category ?? "").Trim(), cat, StringComparison.OrdinalIgnoreCase));

    var featuredCats = categories
        .Select(c => new { Name = c, Count = CountByCat(c) })
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Name)
        .Take(6)
        .ToList();

    var faq = new[]
    {
        new { q = "Are these quizzes free?", a = "Yes. All quizzes on USA Symbol are free to play on desktop and mobile." },
        new { q = "Do quizzes include all 50 states?", a = "Many do. Each quiz card shows the number of questions so you know what you’re getting." },
        new { q = "Do you show answers and explanations?", a = "Yes—each quiz includes correct answers plus short explanations to help you learn faster." },
        new { q = "Can I filter by topic like flags or birds?", a = "Yes. Use the category filter to quickly find the topic you want." }
    };

    // --- JSON-LD (SAFE): use dictionaries to avoid @type/@context issues ---
    var breadcrumb = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object> { ["@type"]="ListItem", ["position"]=1, ["name"]="Home", ["item"]="https://usasymbol.com/" },
            new Dictionary<string, object> { ["@type"]="ListItem", ["position"]=2, ["name"]="Quizzes", ["item"]="https://usasymbol.com/quizzes" }
        }
    };

    var itemList = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "ItemList",
        ["name"] = "U.S. State Symbol Quizzes",
        ["itemListElement"] = allQuizzes.Select((q, idx) => (object)new Dictionary<string, object>
        {
            ["@type"] = "ListItem",
            ["position"] = idx + 1,
            ["url"] = $"https://usasymbol.com/quizzes/{q.Slug}",
            ["name"] = (q.Seo?.Title ?? q.Title)
        }).ToList()
    };

    var faqJson = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(f => (object)new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = f.q,
            ["acceptedAnswer"] = new Dictionary<string, object>
            {
                ["@type"] = "Answer",
                ["text"] = f.a
            }
        }).ToList()
    };

    var jsonLd = new object[] { breadcrumb, itemList, faqJson };

    var jsonLdString = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        WriteIndented = false
    });
}

<section class="bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-6xl mx-auto px-4 py-14">

        <!-- Hero -->
        <div class="text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">U.S. State Symbol Quizzes</h1>
            <p class="mt-4 text-lg text-gray-700 max-w-2xl mx-auto">
                Pick a category, play a quick round, and learn with instant explanations.
            </p>
            <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
                <a href="#all-quizzes"
                   class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-white font-semibold hover:bg-blue-700 transition">
                    Browse all quizzes
                </a>
                <a href="/symbols"
                   class="inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 font-semibold text-blue-700 border border-blue-200 hover:border-blue-400 hover:shadow-sm transition">
                    Explore state symbols
                </a>
            </div>
        </div>

        <!-- Featured categories -->
        @if (featuredCats.Any())
        {
            <div class="mt-12">
                <h2 class="text-2xl font-bold">Browse by category</h2>

                <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    @foreach (var c in featuredCats)
                    {
                        <button type="button"
                                class="catTile text-left rounded-2xl border border-gray-200 bg-white p-6 hover:shadow-lg hover:border-blue-600 transition"
                                data-category="@c.Name">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <div class="text-lg font-bold">@c.Name</div>
                                    <div class="mt-1 text-sm text-gray-600">@c.Count quizzes</div>
                                </div>
                                <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 border border-blue-100">
                                    Filter
                                </span>
                            </div>
                            <p class="mt-3 text-sm text-gray-700">
                                Practice @c.Name.ToLower() quizzes with explanations.
                            </p>
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Controls -->
        <div id="all-quizzes" class="mt-14">
            <h2 class="text-2xl font-bold">All quizzes</h2>

            <div class="mt-5 grid lg:grid-cols-12 gap-4">
                <div class="lg:col-span-5">
                    <label class="block text-sm font-semibold text-gray-700">Search</label>
                    <input id="quizSearch" type="text"
                           class="mt-2 w-full rounded-xl border-gray-200 focus:border-blue-500 focus:ring-blue-500"
                           placeholder="Search flags, birds, flowers, seals…" />
                </div>

                <div class="lg:col-span-4">
                    <label class="block text-sm font-semibold text-gray-700">Category</label>
                    <select id="quizCategory"
                            class="mt-2 w-full rounded-xl border-gray-200 focus:border-blue-500 focus:ring-blue-500">
                        <option value="">All categories</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div class="lg:col-span-3">
                    <label class="block text-sm font-semibold text-gray-700">Difficulty</label>
                    <select id="quizDifficulty"
                            class="mt-2 w-full rounded-xl border-gray-200 focus:border-blue-500 focus:ring-blue-500">
                        <option value="">All</option>
                        @foreach (var d in difficulties)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Grid -->
            <div class="mt-8 grid md:grid-cols-2 gap-6" id="quizGrid">
                @foreach (var quiz in allQuizzes)
                {
                    var previewImages = (quiz.Questions ?? new List<usasymbol.Models.QuizQuestion>())
                    .Select(q => (q.ImageUrl ?? "").Trim())
                    .Where(u => !string.IsNullOrWhiteSpace(u))
                    .Take(4)
                    .ToList();

                    <a href="/quizzes/@quiz.Slug"
                       class="quizCard group block border border-gray-200 bg-white rounded-2xl p-6 hover:shadow-xl hover:border-blue-600 transition"
                       data-title="@((quiz.Title ?? "").ToLowerInvariant())"
                       data-desc="@((quiz.Description ?? "").ToLowerInvariant())"
                       data-category="@((quiz.Category ?? "").Trim())"
                       data-difficulty="@((quiz.Difficulty ?? "").Trim())">

                        <div class="flex items-start justify-between gap-3">
                            <h3 class="font-bold text-xl group-hover:text-blue-700">@quiz.Title</h3>

                            <div class="flex flex-col items-end gap-2">
                                @if (!string.IsNullOrWhiteSpace(quiz.Category))
                                {
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 border border-blue-100">
                                        @quiz.Category
                                    </span>
                                }
                                <span class="bg-gray-100 px-3 py-1 rounded-lg text-sm text-gray-700 font-semibold">
                                    @quiz.Difficulty
                                </span>
                            </div>
                        </div>

                        <p class="text-gray-600 mt-2">@quiz.Description</p>

                        @if (previewImages.Any())
                        {
                            <div class="mt-4 flex gap-2">
                                @foreach (var img in previewImages)
                                {
                                    <div class="w-14 h-10 rounded-lg overflow-hidden border border-gray-200 bg-gray-50 shrink-0">
                                        <img src="@Images.Thumb(img)" alt="" loading="lazy" class="w-full h-full object-cover" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="flex justify-between mt-6 text-sm text-gray-500">
                            <span>@(quiz.Questions?.Count ?? 0) questions</span>
                            <span>@quiz.EstimatedTime</span>
                        </div>
                    </a>
                }
            </div>

            <p class="mt-6 text-sm text-gray-500" id="quizCount"></p>
        </div>

        <!-- FAQ -->
        <div class="mt-14">
            <h2 class="text-2xl font-bold">FAQ</h2>
            <div class="mt-5 grid md:grid-cols-2 gap-6">
                @foreach (var f in faq)
                {
                    <div class="rounded-2xl border border-gray-200 bg-white p-6">
                        <h3 class="font-bold text-lg">@f.q</h3>
                        <p class="mt-2 text-gray-700">@f.a</p>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

<script type="application/ld+json">
    @Html.Raw(jsonLdString)
</script>

<script>
    (function () {
        const cards = Array.from(document.querySelectorAll('.quizCard'));
        const search = document.getElementById('quizSearch');
        const category = document.getElementById('quizCategory');
        const difficulty = document.getElementById('quizDifficulty');
        const count = document.getElementById('quizCount');
        const catTiles = Array.from(document.querySelectorAll('.catTile'));

        function matches(card, q, cat, diff) {
            const title = card.dataset.title || "";
            const desc = card.dataset.desc || "";
            const c = (card.dataset.category || "");
            const d = (card.dataset.difficulty || "");

            const okQuery = !q || title.includes(q) || desc.includes(q);
            const okCat = !cat || c.toLowerCase() === cat.toLowerCase();
            const okDiff = !diff || d.toLowerCase() === diff.toLowerCase();

            return okQuery && okCat && okDiff;
        }

        function apply() {
            const q = (search.value || "").trim().toLowerCase();
            const cat = (category.value || "").trim();
            const diff = (difficulty.value || "").trim();

            let visible = 0;
            cards.forEach(card => {
                const show = matches(card, q, cat, diff);
                card.style.display = show ? "" : "none";
                if (show) visible++;
            });

            if (count) count.textContent = visible + " quizzes";
        }

        if (search) search.addEventListener('input', apply);
        if (category) category.addEventListener('change', apply);
        if (difficulty) difficulty.addEventListener('change', apply);

        catTiles.forEach(tile => {
            tile.addEventListener('click', () => {
                const val = tile.dataset.category || "";
                category.value = val;
                document.getElementById('all-quizzes')?.scrollIntoView({ behavior: 'smooth' });
                apply();
            });
        });

        apply();
    })();
</script>
