@model USASymbol.Models.ViewModels.StateMatchPageViewModel
@using System.Text.Json

@{
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    var placesJson = JsonSerializer.Serialize(Model.Places, jsonOptions);
    var metricsJson = JsonSerializer.Serialize(Model.MetricOptions, jsonOptions);
    var initialWeights = ViewData["InitialWeights"] as IReadOnlyDictionary<string, int>;
    var weightsJson = initialWeights != null ? JsonSerializer.Serialize(initialWeights, jsonOptions) : "null";
    // Server-rendered ranking for the starting weights (Balanced, or the preset page's own).
    // The script re-renders the same blocks as soon as it loads, so crawlers and slow phones
    // see the answer in the first HTML.
    var ssr = (ViewData["SsrRanked"] as IReadOnlyList<USASymbol.Models.ViewModels.StateMatchRankedPlace>)
        ?? Array.Empty<USASymbol.Models.ViewModels.StateMatchRankedPlace>();
    var ssrTop = ssr.Take(3).ToList();
    var ssrRest = ssr.Skip(3).ToList();
}
@* @section only works in the top-level view, not here — Index.cshtml and Preset.cshtml
   each declare their own @section Styles / @section Scripts around this partial. *@

<div class="smx-workspace">
    <aside class="smx-controls" id="sm-controls" aria-label="Your priorities">
        <button class="smx-controls-toggle" id="sm-mobile-toggle" type="button" aria-expanded="false" aria-controls="sm-controls-body">
            <span><i class="fa-solid fa-sliders" aria-hidden="true"></i> Adjust priorities</span>
            <span class="smx-controls-summary" id="sm-controls-summary">Balanced</span>
        </button>

        <div class="smx-sheet-backdrop" id="sm-sheet-backdrop"></div>
        <div class="smx-controls-body" id="sm-controls-body">
            <div class="smx-sheet-head">
                <span class="smx-sheet-title">Your priorities</span>
                <button type="button" class="smx-sheet-close" id="sm-sheet-close" aria-label="Close priorities">&times;</button>
            </div>
            <section class="smx-card">
                <label class="smx-card-title" for="sm-home">Where do you live now?</label>
                <select id="sm-home" class="smx-select" data-home-select>
                    <option value="">Skip — compare with US average</option>
                    @foreach (var place in Model.Places.Where(place => place.Metrics.Count > 0).OrderBy(place => place.Name))
                    {
                        <option value="@place.Abbreviation">@place.Name</option>
                    }
                </select>
                <p class="smx-hint" id="sm-home-hint">Optional. We’ll compare every state with yours instead of the US average.</p>
            </section>

            <section class="smx-card">
                <h2 class="smx-card-title">Start with a profile</h2>
                <div class="sm-presets smx-presets" aria-label="Quick priority presets">
                    <button type="button" class="sm-preset" data-preset="balanced"><strong>Balanced</strong><small>Everything counts</small></button>
                    <button type="button" class="sm-preset" data-preset="budget"><strong>Budget</strong><small>Low costs and taxes</small></button>
                    <button type="button" class="sm-preset" data-preset="career"><strong>Career</strong><small>Income and jobs first</small></button>
                    <button type="button" class="sm-preset" data-preset="family"><strong>Family</strong><small>Schools, safety, care</small></button>
                    <button type="button" class="sm-preset" data-preset="warm"><strong>Warmth</strong><small>Sun comes first</small></button>
                </div>
                <button type="button" class="smx-quiz-link" id="sm-quiz-launch">
                    <span>Not sure? Take the 9-question quiz</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>

                <div class="sm-quiz smx-quiz" id="sm-quiz" hidden>
                    <div class="sm-quiz-progress"><i id="sm-quiz-progress-bar"></i></div>
                    <p class="sm-quiz-step" id="sm-quiz-step">Question 1 of 9</p>
                    <h3 class="sm-quiz-prompt">Which matters more to you?</h3>
                    <div class="sm-quiz-options" id="sm-quiz-options"></div>
                    <div class="sm-quiz-actions">
                        <button type="button" class="sm-quiz-equal" id="sm-quiz-equal">They're about equal</button>
                        <button type="button" class="sm-quiz-cancel" id="sm-quiz-cancel">Cancel</button>
                    </div>
                </div>
            </section>

            <div id="sm-manual-controls" class="smx-manual">
                <section class="smx-card sm-filters" aria-label="Must-have filters">
                    <h2 class="smx-card-title">Must have</h2>
                    <p class="smx-hint">States that fail these are removed.</p>
                    <label class="sm-filter-toggle smx-check"><input type="checkbox" data-filter="noIncomeTax"> No state income tax</label>
                    <label class="sm-filter-toggle smx-check"><input type="checkbox" data-filter="popMillion"> Population over 1 million</label>
                    <label class="sm-filter-toggle smx-check"><input type="checkbox" data-filter="warmClimate"> Warm climate (60&deg;F+ average)</label>
                </section>

                <section class="smx-card smx-fine">
                    <button type="button" class="smx-fine-toggle" id="sm-fine-toggle" aria-expanded="false" aria-controls="sm-sliders">
                        <span>Fine-tune priorities</span>
                        <span class="smx-fine-state" id="sm-fine-label">Show</span>
                    </button>
                    <div class="smx-levels" id="sm-sliders" hidden></div>
                </section>

                <div class="smx-actions">
                    <button type="button" class="smx-btn smx-btn-ghost" id="sm-reset">Reset</button>
                    <button type="button" class="smx-btn smx-btn-solid" id="sm-share">Copy link to my results</button>
                </div>
            </div>
            <p class="sm-share-status smx-status" id="sm-share-status" role="status" aria-live="polite"></p>
            <button type="button" class="smx-btn smx-btn-solid smx-sheet-done" id="sm-sheet-done">Show results</button>
        </div>
    </aside>

    <div class="smx-results">
        <section class="smx-top-wrap" aria-labelledby="sm-top-title">
            <div class="smx-section-head">
                <h2 id="sm-top-title">Your top matches</h2>
                <span class="smx-compare-label" id="sm-compare-label">Balanced · compared with US average</span>
            </div>
            <div class="smx-top" id="sm-top">
                @foreach (var row in ssrTop)
                {
                    <article class="smx-top-card@(row.Rank == 1 ? " is-first" : "")">
                        <p class="smx-top-rank">@(row.Rank == 1 ? "Best match" : "#" + row.Rank)</p>
                        <div class="smx-top-main">
                            <div>
                                <h3>@row.Place.Name</h3>
                                <p class="smx-top-region">@(string.IsNullOrEmpty(row.Place.Region) ? "United States" : row.Place.Region)</p>
                            </div>
                            <span class="smx-top-score">@row.Score</span>
                        </div>
                        <p class="smx-top-summary">@row.Summary</p>
                        <a class="smx-btn smx-btn-ghost" href="/states/@row.Place.Slug/living">@row.Place.Name living guide</a>
                    </article>
                }
            </div>
            <div class="smx-dark" id="sm-dark-horse" hidden></div>
        </section>

        <section class="smx-board" aria-labelledby="sm-board-title">
            <h2 class="sr-only" id="sm-board-title">All states ranked for you</h2>
            <div class="smx-board-bar">
                <div class="smx-tabs" role="tablist" aria-label="Results view">
                    <button type="button" role="tab" class="smx-tab is-active" id="sm-tab-list" aria-selected="true" aria-controls="sm-view-list">Ranked list</button>
                    <button type="button" role="tab" class="smx-tab" id="sm-tab-map" aria-selected="false" aria-controls="sm-view-map">Map</button>
                </div>
                <div class="smx-board-tools">
                    <label class="sm-search smx-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span class="sr-only">Find a state</span>
                        <input id="sm-search" type="search" placeholder="Find a state" autocomplete="off" />
                    </label>
                </div>
            </div>

            <div id="sm-view-list" role="tabpanel" aria-labelledby="sm-tab-list">
                <div class="smx-empty" id="sm-empty" hidden></div>
                <ol class="smx-rows" id="sm-ranking-list">
                    @foreach (var row in ssrRest)
                    {
                        <li class="smx-row">
                            <a class="smx-row-main" href="/states/@row.Place.Slug/living">
                                <span class="smx-row-rank">@row.Rank.ToString("00")</span>
                                <span class="smx-row-name"><strong>@row.Place.Name</strong><small>@(string.IsNullOrEmpty(row.Place.Region) ? "United States" : row.Place.Region)</small></span>
                                <span class="smx-row-move"></span>
                                <span class="smx-row-bar"><i style="width:@(row.Score)%"></i></span>
                                <span class="smx-row-score">@row.Score</span>
                            </a>
                        </li>
                    }
                </ol>
                <button type="button" class="smx-show-all" id="sm-show-all">
                    Show all states
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
            </div>

            <div id="sm-view-map" role="tabpanel" aria-labelledby="sm-tab-map" hidden>
                <div class="sm-map-wrap smx-map-wrap" id="sm-map-wrap">
                    <div class="sm-tilegrid smx-tilegrid" id="sm-tilegrid" role="group" aria-label="Tile grid map of state match scores"></div>
                    <div class="sm-map-tooltip" id="sm-map-tooltip" role="tooltip"></div>
                </div>
                <div class="smx-legend">
                    <span class="smx-legend-scale"><span id="sm-legend-min">0</span><i aria-hidden="true"></i><span id="sm-legend-max">100</span></span>
                    <span class="smx-legend-key"><b class="is-top" aria-hidden="true"></b> Your top 5</span>
                    <span class="smx-legend-key"><b class="is-home" aria-hidden="true"></b> Your state</span>
                    <span class="smx-legend-note">Click a state to see why it scored that way</span>
                </div>
            </div>

            <p class="smx-summary" id="sm-result-summary">@Model.Places.Count places scored</p>
        </section>

        @* Shortlist is deliberately inline, not a sticky bar: sticky bars cover the page's ad slots. *@
        <section class="smx-shortlist" id="sm-shortlist" aria-label="Your shortlist" hidden></section>

        <p class="smx-nudge" id="sm-sensitivity" hidden></p>

        <section class="smx-next" aria-labelledby="sm-next-tools-title">
            <h2 class="sr-only" id="sm-next-tools-title">Keep planning your move</h2>
            <a class="smx-next-card" id="sm-couple-link" href="/tools/where-should-we-move">
                <strong>Moving with a partner?</strong>
                <span>Add their priorities and see which states suit you both.</span>
            </a>
            <a class="smx-next-card" href="/tools/take-home-pay-by-state">
                <strong>How much would you keep?</strong>
                <span>Take-home pay after taxes and rent, state by state.</span>
            </a>
        </section>

        <section class="smx-method" id="method">
            <h2>How scoring works</h2>
            <p>Each metric is placed on a 0–100 scale against every state with data. Your priorities decide how much each metric counts, and the weighted total becomes the match score. If a state is missing a value, that metric is skipped and the remaining weights are rebalanced.</p>
            <p class="smx-method-note">
                State Match is a planning aid, not a recommendation to move. Statewide averages can hide large local differences.
                <a href="/state-match/methodology">Full methodology and sources</a>
            </p>
        </section>

        <nav class="smx-morelinks" aria-label="More on USA Symbol">
            <span>More on USA Symbol:</span>
            <a href="/rankings">State rankings</a>
            <a href="/compare-states">Compare two states</a>
            <a href="/collections">Collections</a>
            <a href="/states/living">State living guides</a>
        </nav>
    </div>
</div>

<div class="sm-drawer-backdrop" id="sm-drawer-backdrop"></div>
<aside class="sm-drawer" id="sm-drawer" aria-hidden="true" aria-labelledby="sm-drawer-title">
    <div id="sm-drawer-content"></div>
</aside>

<noscript>
    <div class="sm-noscript smx-shell">
        <h2>JavaScript is required to adjust State Match</h2>
        <p>The ranking above is the balanced default. You can still <a href="/states">browse all states</a> or <a href="/compare-states">compare two states</a>.</p>
    </div>
</noscript>

<script>
    window.stateMatchData = {
        places: @Html.Raw(placesJson),
        metrics: @Html.Raw(metricsJson),
        initialWeights: @Html.Raw(weightsJson)
    };
</script>
