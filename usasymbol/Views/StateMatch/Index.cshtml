@model USASymbol.Models.ViewModels.StateMatchPageViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/state-match.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/state-match-v2.css" asp-append-version="true" />
}

<div class="smx">
    <header class="smx-head">
        <div class="smx-shell smx-head-inner">
            <div class="smx-head-text">
                <nav class="smx-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">State Match</span>
                </nav>
                <h1>Find the state that fits your life</h1>
                <p class="smx-lede">Pick what matters to you. Every state is scored on the same sourced data, and the list updates as you go.</p>
            </div>
            <a class="smx-head-link" href="#method">How scoring works</a>
        </div>
    </header>

    <article class="smx-shell">
        <div class="article-content min-w-0">
            @await Html.PartialAsync("_Tool", Model)
        </div>
    </article>
</div>

@section Scripts {
    <script defer src="~/js/state-match-core.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match-facts.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match.js" asp-append-version="true"></script>
}

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "WebApplication",
    "name": "State Match",
    "url": "https://usasymbol.com/state-match",
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "Any",
    "description": "Interactive tool for matching U.S. states to personal priorities using sourced state metrics."
}
</script>
