@model USASymbol.Models.ViewModels.StateMatchPageViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/state-match.css" asp-append-version="true" />
}

<div class="sm-page">
    <section class="sm-hero">
        <div class="sm-shell sm-hero-grid">
            <div>
                <nav class="sm-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    <span aria-current="page">State Match</span>
                </nav>
                <p class="sm-eyebrow"><span></span> Interactive relocation planner</p>
                <h1>Find the state that <em>fits your life.</em></h1>
                <p class="sm-lede">
                    Tell us what matters most. We score every state using the same sourced data
                    that powers USA Symbol comparisons, then show where each state stands.
                </p>
                <a class="sm-hero-guide-link" href="/states/living">
                    Browse all 50 state living guides
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="sm-hero-note">
                <span class="sm-note-number">01</span>
                <div>
                    <strong>Set your priorities</strong>
                    <p>Move a slider higher when that factor matters more. Zero removes it from your score.</p>
                </div>
                <span class="sm-note-number">02</span>
                <div>
                    <strong>Explore your matches</strong>
                    <p>Use the map or ranked list to inspect the raw numbers behind every result.</p>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_Tool", Model)
</div>

@section Scripts {
    <script defer src="~/js/state-match-core.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match-facts.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match.js" asp-append-version="true"></script>
}

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "WebApplication",
    "name": "State Match",
    "url": "https://usasymbol.com/state-match",
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "Any",
    "description": "Interactive tool for matching U.S. states to personal priorities using sourced state metrics."
}
</script>
