@model USASymbol.Models.ViewModels.StateMatchPresetPageViewModel

@{
    var top = Model.Top10.Take(3).ToList();
    string narrative;
    if (top.Count == 0)
    {
        narrative = "Raise at least one priority slider below to see how every state compares.";
    }
    else
    {
        var lead = top[0].StrongestMetricName != null
            ? $"{top[0].Place.Name} tops this ranking, driven by {top[0].StrongestMetricName!.ToLowerInvariant()}."
            : $"{top[0].Place.Name} tops this ranking.";
        narrative = top.Count > 1
            ? $"{lead} {string.Join(" and ", top.Skip(1).Select(r => r.Place.Name))} follow close behind."
            : lead;
    }

    ViewData["InitialWeights"] = Model.InitialWeights;
    ViewData["SsrRanked"] = Model.Top10;

}

@section Styles {
    <link rel="stylesheet" href="~/css/state-match.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/state-match-v2.css" asp-append-version="true" />
}

<div class="smx">
    <header class="smx-head">
        <div class="smx-shell smx-head-inner">
            <div class="smx-head-text">
                <nav class="smx-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/state-match">State Match</a> <span aria-hidden="true">/</span> <span aria-current="page">@Model.Heading</span>
                </nav>
                <h1>@Model.Heading</h1>
                <p class="smx-lede">@Model.Lede</p>
                <p class="smx-lede smx-narrative">@narrative</p>
            </div>
            <a class="smx-head-link" href="/state-match">Build your own ranking</a>
        </div>
    </header>

    <article class="smx-shell">
    <div class="article-content min-w-0">
    @await Html.PartialAsync("_Tool", Model.Tool)

    <section class="smx-links">
        <p class="smx-links-label">Looking for something else?</p>
        <div class="smx-chip-row">
            <a class="smx-chip" href="/state-match">Custom ranking</a>
            @foreach (var link in Model.OtherPresets)
            {
                <a class="smx-chip" href="/match/@link.Slug">@link.NavLabel</a>
            }
        </div>
    </section>
    </div>
    </article>
</div>

@section Scripts {
    <script defer src="~/js/state-match-core.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match-facts.js" asp-append-version="true"></script>
    <script defer src="~/js/state-match.js" asp-append-version="true"></script>
}

<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "WebApplication",
    "name": "@Model.Heading",
    "url": "https://usasymbol.com/match/@Model.Slug",
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "Any",
    "description": "@Model.Lede"
}
</script>
