@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@model NicknameDetailViewModel

@{
    var sections = Model.NicknameContent?.Sections;
    var quoteDone = false;
    var timelineDone = false;
    var statDone = false;
    var comparisonCardsDone = false;
    var quoteAfterSectionId = Model.NicknameContent?.ExpertQuoteAfterSectionId ?? string.Empty;
    var timelineAfterSectionId = Model.NicknameContent?.TimelineAfterSectionId ?? string.Empty;
    var statAfterSectionId = Model.NicknameContent?.BigStatAfterSectionId ?? string.Empty;
    var comparisonCardsAfterSectionId = Model.NicknameContent?.ComparisonCardsAfterSectionId ?? string.Empty;
    var visualAssets = Model.NicknameContent?.VisualAssets?.ToList() ?? new List<VisualAsset>();
    var unassignedAssets = visualAssets
        .Where(asset => asset != null &&
                        !string.IsNullOrWhiteSpace(asset.Src) &&
                        string.IsNullOrWhiteSpace(asset.Section))
        .ToList();
    var unassignedAssetIndex = 0;

    bool MatchesAnyId(string? id, params string[] candidates)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return false;
        }

        return candidates.Any(candidate => string.Equals(id, candidate, StringComparison.OrdinalIgnoreCase));
    }
}

@if (sections?.Any() == true)
{
    foreach (var item in sections)
    {
        <div id="section-@item.Id" class="scroll-mt-28 py-10 lg:py-12 border-t border-slate-200/70 first:border-t-0 first:pt-0">
            @await Html.PartialAsync("Components/Content/_SectionHeader", item)

            @{
                var sectionAssets = visualAssets
                    .Where(asset => asset != null &&
                                    !string.IsNullOrWhiteSpace(asset.Src) &&
                                    string.Equals(asset.Section, item.Id, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            @foreach (var asset in sectionAssets)
            {
                @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
            }

            @if (item.Paragraphs?.Any() == true)
            {
                <div class="prose prose-slate prose-base lg:prose-lg max-w-none text-slate-800">
                    @for (var i = 0; i < item.Paragraphs.Count; i++)
                    {
                        <p class="@(i == 0 ? "text-[1.12rem] font-medium leading-8 text-slate-900" : "")">
                            @item.Paragraphs[i].RenderAutoLinks()
                        </p>
                    }
                </div>
            }

            @if (item.Subsections?.Any() == true)
            {
                if (MatchesAnyId(item.Id, "other_nicknames", "other-nicknames"))
                {
                    <div class="mt-8 space-y-5 clear-both w-full">
                        @for (var i = 0; i < item.Subsections.Count; i++)
                        {
                            var sub = item.Subsections[i];
                            var cardTone = (i % 3) switch
                            {
                                0 => "bg-[linear-gradient(180deg,rgba(255,251,235,0.92),rgba(255,255,255,0.98))]",
                                1 => "bg-[linear-gradient(180deg,rgba(239,246,255,0.92),rgba(255,255,255,0.98))]",
                                _ => "bg-[linear-gradient(180deg,rgba(236,253,245,0.92),rgba(255,255,255,0.98))]"
                            };

                            var badgeTone = (i % 3) switch
                            {
                                0 => "bg-amber-100 text-amber-900",
                                1 => "bg-sky-100 text-sky-900",
                                _ => "bg-emerald-100 text-emerald-900"
                            };

                            <article class="group w-full overflow-hidden rounded-[1.95rem] border border-slate-200/70 @cardTone shadow-[0_24px_48px_-34px_rgba(15,23,42,0.24)] transition hover:-translate-y-0.5 hover:shadow-[0_30px_58px_-32px_rgba(15,23,42,0.3)]">
                                <div class="p-5 sm:p-6">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex items-center gap-3">
                                            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white/90 text-slate-700 shadow-[0_16px_28px_-24px_rgba(15,23,42,0.28)]">
                                                <i class="fa-solid fa-tag text-sm"></i>
                                            </span>
                                            <span class="inline-flex items-center rounded-full @badgeTone px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em]">
                                                Alternate nickname
                                            </span>
                                        </div>
                                        <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-white/70 px-2 text-xs font-semibold text-slate-500">
                                            @(i + 1)
                                        </span>
                                    </div>

                                    <h3 class="mt-5 text-[1.35rem] font-semibold leading-tight text-slate-900 sm:text-[1.55rem]">
                                        @sub.Subtitle
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(sub.Text))
                                    {
                                        <div class="mt-4 prose prose-slate prose-base max-w-none text-slate-700">
                                            <p>@sub.Text.RenderAutoLinks()</p>
                                        </div>
                                    }

                                    @if (sub.ListItems?.Any() == true)
                                    {
                                        <div class="mt-5 rounded-[1.35rem] bg-white/80 p-4 shadow-[0_16px_30px_-26px_rgba(15,23,42,0.24)]">
                                            <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500">Key points</div>
                                            <ul class="mt-3 space-y-2.5 text-sm leading-6 text-slate-700">
                                                @foreach (var listItem in sub.ListItems)
                                                {
                                                    <li class="flex items-start gap-3">
                                                        <span class="mt-2 inline-flex h-2 w-2 shrink-0 rounded-full bg-slate-400"></span>
                                                        <span class="min-w-0">@listItem.RenderListItem()</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>

                                @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                {
                                    <div class="border-t border-slate-200/70 bg-white/55 px-5 py-4 sm:px-6">
                                        <a href="@sub.Link.Url"
                                           target="@(sub.Link.Url.IsExternalUrl() ? "_blank" : null)"
                                           rel="@(sub.Link.Url.IsExternalUrl() ? "nofollow noopener noreferrer" : null)"
                                           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition group-hover:text-slate-700 hover:text-slate-700">
                                            <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                            <i class="fas fa-arrow-right shrink-0 text-xs"></i>
                                        </a>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-8 space-y-8">
                        @foreach (var sub in item.Subsections)
                        {
                            <article class="pt-8 border-t border-slate-100 first:border-t-0 first:pt-0">
                                <h3 class="text-lg lg:text-xl font-semibold text-slate-900 mb-3">@sub.Subtitle</h3>

                                @if (!string.IsNullOrWhiteSpace(sub.Text))
                                {
                                    <div class="prose prose-slate prose-base lg:prose-lg max-w-none text-slate-700">
                                        <p>@sub.Text.RenderAutoLinks()</p>
                                    </div>
                                }

                                @if (sub.ListItems?.Any() == true)
                                {
                        <ul class="mt-4 space-y-2 text-sm text-slate-700">
                                        @foreach (var listItem in sub.ListItems)
                                        {
                                            <li class="pl-5 relative before:content-['-'] before:absolute before:left-0 before:text-slate-400">
                                                @listItem.RenderListItem()
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                {
                                    <div class="mt-4">
                                        <a href="@sub.Link.Url"
                                           target="@(sub.Link.Url.IsExternalUrl() ? "_blank" : null)"
                                           rel="@(sub.Link.Url.IsExternalUrl() ? "nofollow noopener noreferrer" : null)"
                                           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:text-slate-700 transition">
                                            <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                            <i class="fas fa-arrow-right text-xs"></i>
                                        </a>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            }

            @if (item.Facts?.Any() == true)
            {
                @await Html.PartialAsync("Components/Widgets/_FactsCarousel", (IEnumerable<string>)item.Facts)
            }

            <div class="clear-both"></div>
        </div>

        @if (!statDone &&
            !string.IsNullOrWhiteSpace(statAfterSectionId) &&
            string.Equals(item.Id, statAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.NicknameContent?.BigStat != null)
        {
            @await Html.PartialAsync("Components/Story/_BigStat", Model.NicknameContent.BigStat)
            statDone = true;
        }

        @if (!timelineDone &&
            !string.IsNullOrWhiteSpace(timelineAfterSectionId) &&
            string.Equals(item.Id, timelineAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.NicknameContent?.Timeline?.Any() == true)
        {
            @await Html.PartialAsync("Components/Story/_Timeline", Model.NicknameContent.Timeline)
            timelineDone = true;
        }
        else if (!timelineDone && Model.NicknameContent?.Timeline?.Any() == true && MatchesAnyId(item.Id, "heart-of-dixie", "other-nicknames"))
        {
            @await Html.PartialAsync("Components/Story/_Timeline", Model.NicknameContent.Timeline)
            timelineDone = true;
        }

        @if (!quoteDone &&
            !string.IsNullOrWhiteSpace(quoteAfterSectionId) &&
            string.Equals(item.Id, quoteAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.NicknameContent?.ExpertQuote != null)
        {
            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.NicknameContent.ExpertQuote)
            quoteDone = true;
        }

        if (unassignedAssetIndex < unassignedAssets.Count)
        {
            var sequentialAsset = unassignedAssets[unassignedAssetIndex];
            @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", sequentialAsset)
            unassignedAssetIndex++;
        }

        @if (!comparisonCardsDone &&
            !string.IsNullOrWhiteSpace(comparisonCardsAfterSectionId) &&
            string.Equals(item.Id, comparisonCardsAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.NicknameContent?.ComparisonCards?.Cards?.Any() == true)
        {
            @await Html.PartialAsync("Components/Widgets/_ComparisonCards", Model.NicknameContent.ComparisonCards)
            comparisonCardsDone = true;
        }
    }

    if (!statDone && Model.NicknameContent?.BigStat != null)
    {
        @await Html.PartialAsync("Components/Story/_BigStat", Model.NicknameContent.BigStat)
    }

    if (!timelineDone && Model.NicknameContent?.Timeline?.Any() == true)
    {
        @await Html.PartialAsync("Components/Story/_Timeline", Model.NicknameContent.Timeline)
    }

    if (!quoteDone && Model.NicknameContent?.ExpertQuote != null)
    {
        @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.NicknameContent.ExpertQuote)
    }

    while (unassignedAssetIndex < unassignedAssets.Count)
    {
        var trailingAsset = unassignedAssets[unassignedAssetIndex];
        @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", trailingAsset)
        unassignedAssetIndex++;
    }

    if (!comparisonCardsDone && Model.NicknameContent?.ComparisonCards?.Cards?.Any() == true)
    {
        @await Html.PartialAsync("Components/Widgets/_ComparisonCards", Model.NicknameContent.ComparisonCards)
    }
}
else
{
    <div class="text-sm text-slate-500">
        No sections rendered yet for this nickname.
    </div>
}
