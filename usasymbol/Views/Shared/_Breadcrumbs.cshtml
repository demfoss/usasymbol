@model USASymbol.Models.ViewModels.ISymbolDetailViewModel
@using System.Globalization

@{
    var symbolTypeSlug = Model.SymbolTypePlural ?? "";
    var symbolTypeText = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
        symbolTypeSlug.Replace("-", " ").ToLowerInvariant()
    );

    var symbolTypeUrl = $"/symbols/{symbolTypeSlug}";
}

<ol class="sd-breadcrumbs">
    <li><a href="/">Home</a></li>
    <li class="sd-breadcrumb-divider" aria-hidden="true">/</li>
    <li><a href="/states/@Model.State.Slug">@Model.State.Name</a></li>
    <li class="sd-breadcrumb-divider" aria-hidden="true">/</li>
    <li><a href="/symbols">State symbols</a></li>
    @if (!string.IsNullOrWhiteSpace(symbolTypeSlug))
    {
        <li class="sd-breadcrumb-divider" aria-hidden="true">/</li>
        <li aria-current="page">
            <span>@symbolTypeText</span>
        </li>
    }
</ol>
