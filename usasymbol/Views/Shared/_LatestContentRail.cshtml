@model USASymbol.Models.ViewModels.LatestContentRailViewModel
@inject IImageUrlService Images

@{
    var rail = Model;
    var railId = $"latest-rail-{Guid.NewGuid():N}";
}

@if (rail.Items.Any())
{
    <section class="latest-rail">
        <div class="flex items-center justify-between gap-4">
            <h2 class="text-[2rem] font-bold leading-none tracking-tight text-slate-900 sm:text-[2.45rem]">
                @rail.Title
            </h2>

            <div class="hidden sm:flex items-center gap-2">
                <button type="button"
                        class="latest-rail-prev inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200/80 bg-white/80 text-slate-700 transition hover:bg-white"
                        data-target="@railId"
                        aria-label="Scroll left">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                </button>
                <button type="button"
                        class="latest-rail-next inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200/80 bg-white/80 text-slate-700 transition hover:bg-white"
                        data-target="@railId"
                        aria-label="Scroll right">
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </div>
        </div>

        <div id="@railId"
             class="mt-8 flex gap-5 overflow-x-auto scroll-smooth pb-4 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            @foreach (var item in rail.Items)
            {
                var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/og-default.webp" : item.ImageUrl;
                var cardSrc = Images.Card(imageUrl);
                var cardSrcSet = string.Join(", ", new[]
                {
                    $"{Images.Card(imageUrl, 320)} 320w",
                    $"{Images.Card(imageUrl, 480)} 480w",
                    $"{Images.Card(imageUrl, 640)} 640w"
                });
                var cardSizes = "(max-width: 639px) 292px, 328px";

                <article class="min-w-[292px] max-w-[292px] snap-start border border-slate-200/80 bg-white/85 p-3 sm:min-w-[328px] sm:max-w-[328px]">
                    <a href="@item.Url" class="block">
                        <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                            <img src="@cardSrc"
                                 srcset="@cardSrcSet"
                                 sizes="@cardSizes"
                                 alt="@item.Title"
                                 class="h-full w-full object-cover"
                                 loading="lazy" />
                        </div>

                        <div class="px-1 pt-4 pb-2">
                            <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
                                @item.SectionLabel
                            </div>

                            <h3 class="mt-3 text-[1.12rem] font-semibold leading-9 text-slate-900">
                                @item.Title
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="mt-3 line-clamp-4 text-[15px] leading-8 text-slate-600">
                                    @item.Description
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Eyebrow))
                            {
                                <div class="mt-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#A36A3C]">
                                    @item.Eyebrow
                                </div>
                            }
                        </div>
                    </a>
                </article>
            }
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const prev = document.querySelector('.latest-rail-prev[data-target="@railId"]');
            const next = document.querySelector('.latest-rail-next[data-target="@railId"]');
            const rail = document.getElementById('@railId');
            if (!rail) return;

            const offset = () => Math.min(rail.clientWidth * 0.9, 360);

            prev?.addEventListener('click', function () {
                rail.scrollBy({ left: -offset(), behavior: 'smooth' });
            });

            next?.addEventListener('click', function () {
                rail.scrollBy({ left: offset(), behavior: 'smooth' });
            });
        });
    </script>
}
