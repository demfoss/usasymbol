@using System
@using System.Collections.Generic
@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@model USASymbol.Models.ViewModels.ISymbolDetailViewModel
@inject IImageUrlService Images

@functions {
    // Tries to build a thumbnail path from link URL:
    // /states/{state}/{type}/{slug} -> /images/{folder}/{slug}.webp
    private string? GetConnectionThumb(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;

        var parts = url.Trim().Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 4) return null;

        var type = parts[2].ToLowerInvariant();
        var slug = parts[3].ToLowerInvariant();

        var folder = type switch
        {
            "bird" => "birds",
            "mammal" => "mammals",
            "beverage" => "beverages",
            "flower" => "flowers",
            "tree" => "trees",
            "motto" => "mottos",
            "nickname" => "nicknames",
            "flag" => "flags",
            "dinosaur" => "dinosaurs",
            "seal" => "seals",
            _ => null
        };

        if (folder == null) return null;

        return $"/images/{folder}/{slug}.webp";
    }
}

@{
    var colors  = Model.Colors;
    var story   = Model as IHasStoryBlocks;
    var placement = Model as IHasStoryBlockPlacement;
    var visuals = Model as IHasVisualAssets;
    var suppressStoryBlocks = ViewData["SuppressStoryBlocks"] as bool? == true;
    var suppressFactsBlocks = ViewData["SuppressFactsBlocks"] as bool? == true;
    var suppressFullWidthImage = ViewData["SuppressFullWidthImage"] as bool? == true;
    var sectionsOverride = ViewData["SectionsOverride"] as IEnumerable<IContentSection>;
    var renderedSections = sectionsOverride != null
        ? sectionsOverride.ToList()
        : (Model.Sections?.ToList() ?? new List<IContentSection>());

    // Build id → VisualAsset lookup for section-level image injection
    // Full-width banner rendered after all sections (only assets with no section binding)
    var fullWidthImg = visuals?.VisualAssets?.FirstOrDefault(v => (v.Layout == "full-width" || v.Layout == "full-width-tall") && string.IsNullOrEmpty(v.Section));
    var timelineAfterSectionId = placement?.TimelineAfterSectionId ?? string.Empty;
    var bigStatAfterSectionId = placement?.BigStatAfterSectionId ?? string.Empty;
    var expertQuoteAfterSectionId = placement?.ExpertQuoteAfterSectionId ?? string.Empty;
}

@if (renderedSections.Any())
{
    foreach (var item in renderedSections)
    {
        var sectionId = $"section-{item.Id}";

        @* Inline image: look up from visual_assets by section's Img id *@
        <section id="@sectionId" class="scroll-mt-24 py-10 lg:py-12 flow-root">

            <!-- Section header -->
            <header class="mb-5 lg:mb-6">
                <div class="flex items-center gap-3 mb-2">
                    <span class="text-[11px] font-semibold tracking-widest uppercase text-gray-500">
                        Section
                    </span>
                    <span class="h-px flex-1 bg-gray-200/70"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <div class="flex items-center gap-4">
                        <span class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                            <i class="@item.Icon text-sm"></i>
                        </span>
                        <h2 class="content-h2">
                            @item.Title
                        </h2>
                    </div>
                }
                else
                {
                    <h2 class="content-h2">
                        @item.Title
                    </h2>
                }
            </header>

            @* ─── Inline visual asset (float-right on desktop, full-width on mobile) ─ *@
            @{
                var sectionAssets = visuals?.VisualAssets?
                    .Where(v => !string.IsNullOrEmpty(v.Section) &&
                                string.Equals(v.Section, item.Id, StringComparison.OrdinalIgnoreCase))
                    .ToList() ?? new List<VisualAsset>();
            }
            @foreach (var asset in sectionAssets)
            {
                @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
            }

            <!-- Lead paragraphs -->
            @if (item.Paragraphs != null && item.Paragraphs.Any())
            {
                <div class="prose prose-lg max-w-prose prose-headings:scroll-mt-24 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-p:leading-relaxed text-gray-800">
                    @for (int i = 0; i < item.Paragraphs.Count; i++)
                    {
                        <p class="content-p @(i == 0 ? "text-gray-900" : "")">
                            @item.Paragraphs[i].RenderAutoLinks()
                        </p>
                    }
                </div>
            }

            <!-- Subsections -->
            @if (item.Subsections != null && item.Subsections.Any())
            {
                @* History timeline *@
                if (item.Id == "history")
                {
                    <div class="mt-8">
                        <div class="relative max-w-2xl">
                            <div class="absolute left-3 top-0 bottom-0 w-px bg-gray-200"></div>

                            @foreach (var sub in item.Subsections)
                            {
                                <div class="relative pl-10 pb-10 last:pb-0">
                                    <div class="absolute left-[10px] top-2 w-2.5 h-2.5 rounded-full bg-gray-900 ring-4 ring-white"></div>

                                    <h3 class="text-lg font-semibold text-gray-900 mb-3">
                                        @sub.Subtitle
                                    </h3>

                                    @if (!string.IsNullOrEmpty(sub.Text))
                                    {
                                        <div class="prose max-w-prose text-gray-800">
                                            <p>@sub.Text.RenderAutoLinks()</p>
                                        </div>
                                    }

                                    @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                    {
                                        <div class="mt-4">
                                            <a href="@sub.Link.Url"
                                               class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-gray-700 transition">
                                                <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                                <i class="fas fa-arrow-right text-xs"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @* Identification cards (stack layout) *@
                else if (item.Id == "identification")
                {
                    <div class="mt-8">
                        <div class="max-w-3xl space-y-5">
                            @foreach (var sub in item.Subsections)
                            {
                                <article class="border-b border-slate-100 last:border-0 py-5 last:pb-0">
                                    <div class="flex items-start gap-5">
                                        <div class="mt-1 inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-xl bg-gray-900 text-white">
                                            <i class="fa-solid fa-circle-check text-[14px]"></i>
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <h3 class="text-base font-semibold text-gray-900 leading-snug">
                                                @sub.Subtitle
                                            </h3>

                                            @if (!string.IsNullOrWhiteSpace(sub.Text))
                                            {
                                                <p class="content-p mt-1.5 text-gray-700">
                                                    @sub.Text.RenderAutoLinks()
                                                </p>
                                            }

                                            @if (sub.ListItems?.Any() == true)
                                            {
                                                <ul class="mt-4 space-y-2 text-base text-gray-700">
                                                    @foreach (var listItem in sub.ListItems)
                                                    {
                                                        <li class="pl-6 relative">
                                                            <span class="absolute left-0 top-2 h-2 w-2 rounded-full bg-gray-900"></span>
                                                            @listItem.RenderListItem()
                                                        </li>
                                                    }
                                                </ul>
                                            }

                                            @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                            {
                                                <div class="mt-4">
                                                    <a href="@sub.Link.Url"
                                                       class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-gray-700 transition">
                                                        <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                                        <i class="fas fa-arrow-right text-xs"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
                @* Symbol connections (cards with optional thumbs) *@
                else if (item.Id == "symbol-connections")
                {
                    <div class="mt-8 space-y-8">
                        @foreach (var sub in item.Subsections)
                        {
                            LinkData? relatedLink = sub.Link;
                            var thumb = GetConnectionThumb(relatedLink?.Url);

                            <article>
                                <h3 class="text-lg lg:text-xl font-semibold text-gray-900 mb-3">
                                    @sub.Subtitle
                                </h3>

                                @if (!string.IsNullOrEmpty(sub.Text))
                                {
                                    <div class="prose prose-lg max-w-prose text-gray-800">
                                        <p>@sub.Text.RenderAutoLinks()</p>
                                    </div>
                                }

                                @if (relatedLink != null && !string.IsNullOrWhiteSpace(relatedLink.Url))
                                {
                                    var label = string.IsNullOrWhiteSpace(relatedLink.Label) ? "Learn more" : relatedLink.Label;

                                    <a href="@relatedLink.Url"
                                       class="mt-5 group flex items-center justify-between gap-4 rounded-lg border border-slate-200 bg-white p-4 transition hover:border-slate-300 max-w-prose">
                                        <div class="flex items-center gap-4 min-w-0">
                                            @if (!string.IsNullOrEmpty(thumb))
                                            {
                                                <div class="shrink-0 w-14 h-14 rounded-md bg-gray-50 overflow-hidden border border-slate-100">
                                                    <img src="@Images.Thumb(thumb)"
                                                         alt="@label"
                                                         class="w-full h-full object-cover"
                                                         loading="lazy"
                                                         onerror="this.closest('div').remove();" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="shrink-0 w-14 h-14 rounded-md bg-gray-50 flex items-center justify-center border border-slate-100">
                                                    <i class="fas fa-link text-gray-400"></i>
                                                </div>
                                            }

                                            <div class="min-w-0">
                                                <div class="text-sm font-semibold text-gray-900 truncate">
                                                    @label
                                                </div>
                                                <div class="text-xs text-gray-600 truncate">
                                                    Related state symbol
                                                </div>
                                            </div>
                                        </div>

                                        <div class="shrink-0 inline-flex items-center gap-2 text-sm font-semibold text-gray-900 group-hover:text-gray-700 transition">
                                            <span>Open</span>
                                            <i class="fas fa-arrow-right shrink-0 text-xs"></i>
                                        </div>
                                    </a>
                                }
                            </article>
                        }
                    </div>
                }
                @* Default subsections layout *@
                else
                {
                    <div class="mt-8 space-y-8">
                        @foreach (var sub in item.Subsections)
                        {
                            <article>
                                <h3 class="text-lg lg:text-xl font-semibold text-gray-900 mb-3">
                                    @sub.Subtitle
                                </h3>

                                @if (!string.IsNullOrEmpty(sub.Text))
                                {
                                    <div class="prose prose-lg max-w-prose text-gray-800">
                                        <p>@sub.Text.RenderAutoLinks()</p>
                                    </div>
                                }

                                @if (sub.ListItems != null && sub.ListItems.Any())
                                {
                                    <ul class="mt-5 space-y-2 text-sm text-gray-800 max-w-prose">
                                        @foreach (var listItem in sub.ListItems)
                                        {
                                            <li class="pl-6 relative before:content-['—'] before:absolute before:left-0 before:text-gray-400">
                                                @listItem.RenderListItem()
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                {
                                    <div class="mt-4">
                                        <a href="@sub.Link.Url"
                                           class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-gray-700 transition">
                                            <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                            <i class="fas fa-arrow-right text-xs"></i>
                                        </a>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            }

            <!-- Facts (Did you know) -->
            @if (!suppressFactsBlocks && item.Facts != null && item.Facts.Any())
            {
                var factsId = $"facts-{item.Id}";

                var factsHtml = item.Facts
                .Select(f => (f ?? "").RenderListItem().Value ?? "")
                .ToList();

                <aside class="mt-12 border border-slate-200 rounded-lg p-5 lg:p-6 bg-slate-50">
                    <div class="flex items-center justify-between gap-4 mb-4">
                        <div>
                            <div class="text-[11px] font-semibold tracking-widest uppercase text-gray-500">Did you know?</div>
                            <div class="text-sm text-gray-700 mt-1">Quick facts related to this section.</div>
                        </div>
                        <div class="text-xs font-medium text-gray-500" id="factCounter-@factsId">
                            1 / @factsHtml.Count()
                        </div>
                    </div>

                    <div class="bg-white p-5 min-h-[96px] flex items-center border border-slate-100 rounded-md">
                        <div id="factText-@factsId" class="text-base text-gray-900 leading-relaxed">
                            @Html.Raw(factsHtml.First())
                        </div>
                    </div>

                    <div class="mt-4 flex justify-end">
                        <button id="nextFactBtn-@factsId"
                                type="button"
                                class="px-4 py-2 rounded-lg bg-gray-900 hover:bg-gray-800 text-white font-semibold text-sm inline-flex items-center gap-2 transition active:scale-[0.98]">
                            <span>Next</span>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                </aside>

                <script>
                    (function () {
                        const facts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(factsHtml));
                        let currentIndex = 0;

                        const factText = document.getElementById('factText-@factsId');
                        const factCounter = document.getElementById('factCounter-@factsId');
                        const nextBtn = document.getElementById('nextFactBtn-@factsId');

                        if (!facts || !facts.length || !factText || !factCounter || !nextBtn) return;

                        nextBtn.addEventListener('click', function () {
                            currentIndex = (currentIndex + 1) % facts.length;
                            factText.innerHTML = facts[currentIndex];
                            factCounter.textContent = `${currentIndex + 1} / ${facts.length}`;
                        });
                    })();
                </script>
            }

            <div class="clear-both"></div>

            @* ─── Section-bound visual assets ────────────────────────────────────── *@
        </section>

        @if (!suppressStoryBlocks &&
            (( !string.IsNullOrWhiteSpace(timelineAfterSectionId) && string.Equals(item.Id, timelineAfterSectionId, StringComparison.OrdinalIgnoreCase))
            || (string.IsNullOrWhiteSpace(timelineAfterSectionId) && item.Id == "official-designation")) &&
            story?.Timeline?.Any() == true)
        {
            <section class="my-10 lg:my-12">
                <div class="flex items-center gap-3 mb-6">
                    <h3 class="text-lg font-semibold text-slate-900">Key milestones</h3>
                    <span class="h-px flex-1 bg-slate-200/70"></span>
                </div>

                <div class="overflow-x-auto -mx-4 px-4 pb-4 lg:overflow-visible lg:mx-0 lg:px-0">
                    <div class="flex gap-3 min-w-max lg:min-w-0 lg:grid lg:gap-3 lg:grid-cols-1">
                        @foreach (var evt in story.Timeline!)
                        {
                            var yearText = (evt.Year ?? "").Trim();
                            var lastDigit = 0;

                            if (!string.IsNullOrEmpty(yearText))
                            {
                                var ch = yearText[yearText.Length - 1];
                                if (ch >= '0' && ch <= '9') lastDigit = ch - '0';
                            }

                            var icon = (lastDigit % 8) switch
                            {
                                0 => "fa-flag",
                                1 => "fa-scale-balanced",
                                2 => "fa-file-signature",
                                3 => "fa-users",
                                4 => "fa-landmark",
                                5 => "fa-bullhorn",
                                6 => "fa-award",
                                _ => "fa-star"
                            };

                            <article class="flex-shrink-0 w-72 sm:w-80 lg:w-auto rounded-2xl border border-slate-200 bg-white p-4 lg:p-5 shadow-sm">
                                <div class="flex items-start gap-4">
                                    <div class="shrink-0">
                                        <div class="w-10 h-10 shrink-0 min-h-[2.5rem] min-w-[2.5rem] rounded-xl bg-slate-900 text-white flex items-center justify-center">
                                            <i class="fas @icon text-sm"></i>
                                        </div>
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-700 tracking-wide">
                                            @evt.Year
                                        </span>

                                        <p class="mt-2 text-sm lg:text-base leading-6 lg:leading-7 text-slate-700">
                                            @evt.Description
                                        </p>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>

                <p class="text-xs text-slate-400 mt-3 lg:hidden">← Swipe for more</p>
            </section>
        }

        @if (!suppressStoryBlocks &&
            (( !string.IsNullOrWhiteSpace(bigStatAfterSectionId) && string.Equals(item.Id, bigStatAfterSectionId, StringComparison.OrdinalIgnoreCase))
            || (string.IsNullOrWhiteSpace(bigStatAfterSectionId) && item.Id == "in-the-state")) &&
            story?.BigStat != null)
        {
            <section class="my-12 lg:my-14">
                <div class="rounded-[1.8rem] bg-[radial-gradient(circle_at_top,rgba(186,230,253,0.18),transparent_45%),linear-gradient(180deg,rgba(248,250,252,0.76),rgba(255,255,255,0.98))] p-10 lg:p-12 text-center shadow-[0_24px_48px_-36px_rgba(15,23,42,0.28)]">
                    <div class="text-5xl lg:text-6xl font-semibold text-gray-900 mb-3">
                        @story.BigStat.Number
                    </div>
                    <div class="text-gray-700 text-base lg:text-lg max-w-md mx-auto">
                        @story.BigStat.Description
                    </div>
                </div>
            </section>
        }

        @* Expert quote *@
        @if (!suppressStoryBlocks &&
            (( !string.IsNullOrWhiteSpace(expertQuoteAfterSectionId) && string.Equals(item.Id, expertQuoteAfterSectionId, StringComparison.OrdinalIgnoreCase))
            || (string.IsNullOrWhiteSpace(expertQuoteAfterSectionId) && item.Id == "state-symbolism")) &&
            story?.ExpertQuote != null && !string.IsNullOrWhiteSpace(story.ExpertQuote.Text))
        {
            <section class="my-10 lg:my-12">
                <figure class="border-l-4 border-slate-300 pl-6 py-2">
                    <blockquote class="text-lg lg:text-xl text-gray-900 leading-relaxed mb-4">
                        "@story.ExpertQuote.Text"
                    </blockquote>
                    @if (!string.IsNullOrWhiteSpace(story.ExpertQuote.Source))
                    {
                        <figcaption class="text-sm text-gray-600 font-medium">
                            — @story.ExpertQuote.Source
                        </figcaption>
                    }
                </figure>
            </section>
        }
    }
}

@* ─── Full-width visual asset (after all sections, lazy load) ────────────── *@
@if (!suppressFullWidthImage && fullWidthImg != null && !string.IsNullOrEmpty(fullWidthImg.Src))
{
    <section class="py-8 lg:py-10">
        @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", fullWidthImg)
    </section>
}
