@using System.Linq
@model USASymbol.Models.ViewModels.SymbolHeroViewModel
@inject IImageUrlService Images

@{
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var hasPalette = Model.PaletteHexes.Any(hex => !string.IsNullOrWhiteSpace(hex));
    var isWide = Model.Variant == SymbolHeroVariant.WideMedia && (hasImage || hasPalette);
    var isQuote = Model.Variant == SymbolHeroVariant.Quote;
    var isTextOnly = Model.Variant == SymbolHeroVariant.TextOnly || (!hasImage && !hasPalette && !isQuote);
    var layoutClass = isWide
        ? "sdh--wide"
        : isQuote
            ? "sdh--quote"
            : isTextOnly
                ? "sdh--text"
                : "sdh--split";

    var heroImageSrc = hasImage ? Images.Hero(Model.ImageUrl) : string.Empty;
    var heroImageSrcSet = hasImage
        ? string.Join(", ", new[]
        {
            $"{Images.Hero(Model.ImageUrl, 480)} 480w",
            $"{Images.Hero(Model.ImageUrl, 768)} 768w",
            $"{Images.Hero(Model.ImageUrl, 1200)} 1200w"
        })
        : string.Empty;
    var heroImageSizes = isWide
        ? "(max-width: 1439px) 100vw, 1320px"
        : "(max-width: 899px) 100vw, (max-width: 1279px) 44vw, 560px";
    var mediaFitClass = Model.ImageClass.Contains("object-contain", StringComparison.OrdinalIgnoreCase)
        ? "sdh-media--contain"
        : "sdh-media--cover";

    var factSource = Model.HeroFacts.Any()
        ? Model.HeroFacts
        : Model.PageModel.QuickFacts?.ToList() ?? new List<QuickFactItem>();
    var heroFacts = factSource
        .Where(fact => fact != null &&
            !string.IsNullOrWhiteSpace(fact.Label) &&
            !string.IsNullOrWhiteSpace(fact.Value))
        .Take(Math.Max(0, Model.MaxHeroFacts))
        .ToList();

    if (!string.IsNullOrWhiteSpace(Model.LegalReference) &&
        heroFacts.Count < Model.MaxHeroFacts &&
        !heroFacts.Any(fact =>
            fact.Label.Contains("statute", StringComparison.OrdinalIgnoreCase) ||
            fact.Label.Contains("law", StringComparison.OrdinalIgnoreCase) ||
            fact.Label.Contains("legislation", StringComparison.OrdinalIgnoreCase)))
    {
        heroFacts.Add(new QuickFactItem
        {
            Label = "Statute",
            Value = Model.LegalReference
        });
    }

    var quoteText = !string.IsNullOrWhiteSpace(Model.FeaturedText)
        ? Model.FeaturedText
        : !string.IsNullOrWhiteSpace(Model.Subtitle)
            ? Model.Subtitle
            : Model.FigureTitle;
    var reviewer = "Artsiom Dusau";
}

<header id="symbol-detail-hero" class="sdh @layoutClass lg:col-span-2 xl:col-span-3" data-hero-variant="@Model.Variant.ToString().ToLowerInvariant()">
    @if (isWide)
    {
        <div class="sdh-card">
            @await Html.PartialAsync("_SymbolHeroMedia", Model, new ViewDataDictionary(ViewData)
            {
                ["HeroImageSrc"] = heroImageSrc,
                ["HeroImageSrcSet"] = heroImageSrcSet,
                ["HeroImageSizes"] = heroImageSizes,
                ["MediaFitClass"] = mediaFitClass
            })

            <div class="sdh-wide-plate">
                <div class="sdh-wide-grid">
                    <div class="sdh-copy">
                        @await Html.PartialAsync("_SymbolHeroCopy", Model)
                    </div>
                    @await Html.PartialAsync("_SymbolHeroFacts", heroFacts)
                </div>
                @await Html.PartialAsync("_SymbolHeroMeta", Model, new ViewDataDictionary(ViewData)
                {
                    ["Reviewer"] = reviewer
                })
            </div>
        </div>
    }
    else
    {
        <div class="sdh-grid">
            <div class="sdh-copy">
                @await Html.PartialAsync("_SymbolHeroCopy", Model)
                @await Html.PartialAsync("_SymbolHeroFacts", heroFacts)
                @await Html.PartialAsync("_SymbolHeroMeta", Model, new ViewDataDictionary(ViewData)
                {
                    ["Reviewer"] = reviewer
                })
            </div>

            @if (isQuote)
            {
                <blockquote class="sdh-quote">
                    @if (!string.IsNullOrWhiteSpace(Model.FeaturedLabel))
                    {
                        <div class="sdh-quote-label">@Model.FeaturedLabel</div>
                    }
                    <p class="sdh-quote-text">@quoteText</p>
                    @if (!string.IsNullOrWhiteSpace(Model.FeaturedNoteText))
                    {
                        <p class="sdh-quote-translation">“@Model.FeaturedNoteText”</p>
                    }
                    <footer class="sdh-quote-meta">
                        @foreach (var badge in Model.FeaturedBadges.Where(item => !string.IsNullOrWhiteSpace(item)))
                        {
                            <span>@badge</span>
                        }
                        @foreach (var item in Model.EyebrowItems.Skip(1).Where(item => !string.IsNullOrWhiteSpace(item)))
                        {
                            <span>@item</span>
                        }
                    </footer>
                </blockquote>
            }
            else if (!isTextOnly)
            {
                @await Html.PartialAsync("_SymbolHeroMedia", Model, new ViewDataDictionary(ViewData)
                {
                    ["HeroImageSrc"] = heroImageSrc,
                    ["HeroImageSrcSet"] = heroImageSrcSet,
                    ["HeroImageSizes"] = heroImageSizes,
                    ["MediaFitClass"] = mediaFitClass
                })
            }
        </div>
    }
</header>
