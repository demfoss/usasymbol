@using System.Linq
@model USASymbol.Models.ViewModels.PageHeroViewModel
@inject IImageUrlService Images

@{
    var heroImageSrc = Images.Hero(Model.ImageUrl);
    var heroImageSrcSet = string.Join(", ", new[]
    {
        $"{Images.Hero(Model.ImageUrl, 480)} 480w",
        $"{Images.Hero(Model.ImageUrl, 768)} 768w",
        $"{Images.Hero(Model.ImageUrl, 1200)} 1200w"
    });
    var heroImageSizes = "(max-width: 1023px) 100vw, (max-width: 1279px) 420px, 460px";
}

<header class="mb-10 lg:mb-12">
    <div class="relative overflow-hidden rounded-none shadow-none @Model.BackgroundClass text-white">
        <div class="absolute inset-x-0 top-0 h-px @Model.TopRuleClass"></div>
        <div class="absolute right-8 top-14 hidden h-48 w-48 rounded-full @Model.PrimaryGlowClass blur-3xl lg:block"></div>
        <div class="absolute left-1/3 top-0 hidden h-40 w-40 rounded-full @Model.SecondaryGlowClass blur-3xl lg:block"></div>

        <div class="relative px-5 pb-7 pt-6 sm:px-6 lg:px-8 lg:pb-9 lg:pt-8 xl:px-10">
            <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(300px,420px)] xl:grid-cols-[minmax(0,1fr)_460px] lg:items-start xl:gap-10">
                <div class="min-w-0 order-1 pt-2 lg:pt-6">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-300">
                        <span class="inline-flex items-center gap-2 text-white">
                            <span class="block h-1.5 w-1.5 rounded-full @Model.AccentDotClass"></span>
                            @Model.HeroLabel
                        </span>
                        @foreach (var item in Model.EyebrowItems.Where(item => !string.IsNullOrWhiteSpace(item)))
                        {
                            <span>@item</span>
                        }
                    </div>

                    <div class="mt-6 max-w-4xl">
                        <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white leading-[0.98] sm:text-5xl lg:text-[4.15rem]">
                            @Model.Title
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-100 sm:text-xl">
                                @Model.Description
                            </p>
                        }
                    </div>
                </div>

                <div class="order-2 lg:pt-5">
                    <figure>
                        <div class="relative aspect-[16/9] overflow-hidden rounded-none shadow-none @Model.MediaBackgroundClass">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <img src="@heroImageSrc"
                                     srcset="@heroImageSrcSet"
                                     sizes="@heroImageSizes"
                                     alt="@(string.IsNullOrWhiteSpace(Model.ImageAlt) ? Model.Title : Model.ImageAlt)"
                                     class="absolute inset-0 h-full w-full object-cover"
                                     loading="eager"
                                     fetchpriority="high" />
                            }
                            else
                            {
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <i class="@(string.IsNullOrWhiteSpace(Model.FallbackIconClass) ? "fa-solid fa-layer-group" : Model.FallbackIconClass) text-7xl text-slate-300"></i>
                                </div>
                            }
                        </div>

                        <figcaption class="mt-3 flex flex-wrap items-start justify-between gap-3 border-t border-white/15 pt-3 text-slate-300">
                            <div class="min-w-0">
                                @if (!string.IsNullOrWhiteSpace(Model.FigureTitle))
                                {
                                    <p class="text-sm font-semibold text-white">@Model.FigureTitle</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.FigureSubtitle))
                                {
                                    <p class="text-xs uppercase tracking-[0.14em]">@Model.FigureSubtitle</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.FigureCaption))
                                {
                                    <p class="mt-2 text-sm leading-6 text-slate-300">@Model.FigureCaption</p>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.ImageLinkUrl))
                            {
                                <a href="@Images.Full(Model.ImageLinkUrl)"
                                   target="_blank"
                                   rel="nofollow noopener noreferrer"
                                   class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300 transition hover:text-white">
                                    <i class="fas fa-up-right-from-square shrink-0 text-[10px]"></i>
                                    View original
                                </a>
                            }
                        </figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </div>
</header>
