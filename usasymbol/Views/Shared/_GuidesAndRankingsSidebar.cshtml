@{
    var cards = new[]
    {
        new { Eyebrow = "Data", Title = "State Rankings", Description = "Compare all 50 states by population, land area, statehood date, and more.", Cta = "View Rankings", Href = "/rankings", Icon = "fa-ranking-star", Tint = "bg-[#F5F7FD] text-[#4F67B8]", Line = "bg-[#9DB0E8]" },
        new { Eyebrow = "Curated", Title = "Collections", Description = "Themed lists - states sharing the same bird, oldest symbols, flags with bears, and more.", Cta = "Browse Collections", Href = "/collections", Icon = "fa-list", Tint = "bg-[#F2FAF5] text-[#1E8A5E]", Line = "bg-[#8FD0B2]" },
        new { Eyebrow = "Compare", Title = "Compare States", Description = "Side-by-side comparison of population, area, income, taxes, climate, and more.", Cta = "Compare Now", Href = "/compare-states", Icon = "fa-scale-balanced", Tint = "bg-[#F2F9FC] text-[#1E7EA8]", Line = "bg-[#8AC7DB]" },
        new { Eyebrow = "Genealogy", Title = "Last Names by State", Description = "Top 20 most common surnames per state - with origins, meanings, and heritage context. Is yours on the list?", Cta = "Explore Last Names", Href = "/guides/surnames", Icon = "fa-users", Tint = "bg-[#F7F5FB] text-[#5D5A86]", Line = "bg-[#C6BDD9]" }
    };
}

<section class="border-t border-slate-200/70 pt-4">
    <div class="flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.18em] text-slate-500">
        <i class="fa-solid fa-compass text-[10px] text-slate-400"></i>
        <span>Explore More</span>
    </div>

    <div class="mt-3.5 space-y-2.5">
        @foreach (var card in cards)
        {
            <a href="@card.Href"
               class="group block overflow-hidden rounded-3xl border border-slate-200/80 bg-white transition duration-200 hover:border-slate-300 hover:shadow-[0_10px_22px_rgba(15,23,42,0.045)]">
                <div class="h-px w-full @card.Line opacity-80"></div>

                <div class="flex items-start justify-between gap-3 px-4 pt-3.5">
                    <div>
                        <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">@card.Eyebrow</div>
                        <div class="mt-1 text-[0.98rem] font-semibold leading-5 text-slate-900">@card.Title</div>
                    </div>
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[1rem] @card.Tint">
                        <i class="fa-solid @card.Icon text-[0.95rem]"></i>
                    </div>
                </div>

                <div class="px-4 pb-3.5 pt-2.5">
                    <p class="text-[13px] leading-5 text-slate-600">@card.Description</p>
                    <div class="mt-2.5 inline-flex items-center gap-2 text-[12.5px] font-semibold text-slate-800 transition group-hover:text-slate-700">
                        <span>@card.Cta</span>
                        <i class="fa-solid fa-arrow-right text-[10px] transition group-hover:translate-x-0.5"></i>
                    </div>
                </div>
            </a>
        }
    </div>
</section>
