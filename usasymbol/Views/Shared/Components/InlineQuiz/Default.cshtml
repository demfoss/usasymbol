@using System.Text.Json
@using usasymbol.Services
@model USASymbol.Views.Shared.Components.InlineQuizViewModel
@inject IImageUrlService Images
@{
    var payload = new
    {
        slug = Model.Slug, stateName = Model.StateName, stateSlug = Model.StateSlug,
        perRound = Model.PerRound, title = Model.Title, fullQuizUrl = Model.FullQuizUrl,
        pool = Model.Pool.Select(q => new
        {
            q = q.Question, c = q.Choices, a = q.CorrectAnswer, e = q.Explanation,
            image = string.IsNullOrWhiteSpace(q.ImageUrl) ? "" : Images.Card(q.ImageUrl),
            answerImage = string.IsNullOrWhiteSpace(q.AnswerImageUrl) ? "" : Images.Thumb(q.AnswerImageUrl),
            linkUrl = q.LinkUrl, linkLabel = q.LinkLabel, family = q.FamilyKey,
            related = q.RelatedAnswers.Select(answer => new { answer = answer.Answer, state = answer.State, url = answer.Url })
        }),
        states = StateLinks.AbbrToName.Select(state => new
        {
            abbr = state.Key, name = state.Value, slug = StateLinks.Slug(state.Value),
            url = "/quizzes/" + StateSymbolQuizBuilder.SlugFor(state.Value)
        })
    };
}

<section id="@Model.Id" class="iq-widget not-prose" data-nosnippet aria-labelledby="@Model.Id-title">
    <div class="iq-card">
        <header class="iq-header">
            <svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#circle-question"></use></svg>
            <h2 id="@Model.Id-title" title="Quick quiz · @Model.Title"><span>Quick quiz</span><span aria-hidden="true"> · </span>@Model.Title</h2>
            <ol class="iq-progress" data-iq="progress" aria-label="Question progress">
                @for (var i = 0; i < Model.PerRound; i++)
                {
                    <li aria-label="Question @(i + 1)" class="iq-dot"></li>
                }
            </ol>
        </header>

        <div class="iq-body">
            <div data-iq="stage" hidden>
                <h3 class="iq-question" data-iq="question" tabindex="-1"></h3>
                <div class="iq-question-image" data-iq="image" hidden></div>
                <div class="iq-answers" data-iq="answers"></div>
                <div class="iq-feedback" data-iq="feedback" role="status" aria-live="polite" aria-atomic="true"></div>
                <div class="iq-next-row"><button type="button" class="iq-button iq-button--primary" data-iq="next" hidden>Next <svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#arrow-right"></use></svg></button></div>
            </div>

            <div class="iq-result" data-iq="result" hidden>
                <div class="iq-result__icon" aria-hidden="true"><span data-iq="result-icon"></span></div>
                <h3 class="iq-result__score" data-iq="result-heading" tabindex="-1"><span data-iq="final">0</span> / @Model.PerRound</h3>
                <p class="iq-result__verdict" data-iq="verdict"></p>
                <p class="iq-result__record" data-iq="record"></p>
                <p class="iq-result__community" data-iq="community" hidden></p>
                <details class="iq-review" data-iq="review">
                    <summary>Review all @Model.PerRound answers</summary>
                    <ol data-iq="review-list"></ol>
                </details>
                @if (!string.IsNullOrEmpty(Model.StateSlug))
                {
                    <details class="iq-collection" data-iq="collection">
                        <summary data-iq="collection-label">Your state collection</summary>
                        <div class="iq-collection__grid" data-iq="collection-grid"></div>
                    </details>
                }
                <div class="iq-result__actions">
                    <button type="button" class="iq-button iq-button--primary" data-iq="share"><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#share-nodes"></use></svg> Share score</button>
                    <button type="button" class="iq-button" data-iq="again"><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#rotate-right"></use></svg> @Model.PerRound new questions</button>
                </div>
                <p class="iq-share-status" data-iq="share-status" aria-live="polite"></p>
                <a class="iq-full-link" href="@Model.FullQuizUrl" data-iq="destination">@Model.FullQuizLabel <svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#arrow-right"></use></svg></a>
            </div>
            <noscript><p><a href="@Model.FullQuizUrl">Open the @Model.Title quiz.</a> JavaScript is needed to answer questions.</p></noscript>
        </div>
    </div>

    <section class="iq-keep-playing" data-iq="more" aria-labelledby="@Model.Id-more" hidden>
        <div class="iq-keep-playing__heading"><h3 id="@Model.Id-more">Keep playing</h3><a href="/quizzes" data-iq="destination">All quizzes <svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#arrow-right"></use></svg></a></div>
        @if (Model.Neighbors.Any())
        {
            <h4>Try a neighbor</h4>
            <ul class="iq-destinations">
                @foreach (var quiz in Model.Neighbors)
                {
                    var name = quiz.Title.Replace(" State Symbols Quiz", "");
                    <li><a href="/quizzes/@quiz.Slug" data-iq="destination"><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#map-location-dot"></use></svg><span><strong>@name symbols</strong><small>@(quiz.QuestionsPerRound > 0 ? Math.Min(quiz.QuestionsPerRound, quiz.Questions.Count) : Math.Min(10, quiz.Questions.Count)) questions</small></span><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#arrow-right"></use></svg></a></li>
                }
            </ul>
        }
        @if (Model.More.Any())
        {
            <h4>Explore a topic</h4>
            <ul class="iq-destinations">
                @foreach (var quiz in Model.More)
                {
                    <li><a href="/quizzes/@quiz.Slug" data-iq="destination"><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#compass"></use></svg><span><strong>@quiz.Title</strong><small>@(quiz.QuestionsPerRound > 0 ? Math.Min(quiz.QuestionsPerRound, quiz.Questions.Count) : Math.Min(10, quiz.Questions.Count)) questions</small></span><svg class="quiz-icon" aria-hidden="true"><use href="/icons/quiz.svg#arrow-right"></use></svg></a></li>
                }
            </ul>
        }
    </section>
    <script type="application/json" data-iq="data">@Html.Raw(JsonSerializer.Serialize(payload))</script>
</section>
<script src="~/js/inline-quiz.js" asp-append-version="true" defer></script>
