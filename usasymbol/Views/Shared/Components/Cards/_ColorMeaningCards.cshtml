@using USASymbol.Models.Content
@using USASymbol.Extensions
@model List<ColorMeaningCard>

<div class="mt-4 space-y-3">
    @foreach (var card in Model)
    {
        <article class="flex overflow-hidden border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="shrink-0 w-20 sm:w-28 relative min-h-[5.5rem] ring-1 ring-inset ring-black/10" style="background-color: @card.Hex;">
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                <div class="absolute bottom-2 left-2">
                    <span class="inline-block bg-black/60 text-white text-[10px] font-mono font-bold px-1.5 py-0.5 leading-none">@card.Hex</span>
                </div>
            </div>
            <div class="flex-1 min-w-0 px-4 py-4 flex flex-col justify-center">
                <h3 class="mb-1 text-[15px] font-bold text-slate-900 leading-snug">@card.Heading</h3>
                <p class="text-sm text-slate-600 leading-relaxed">@card.Meaning.RenderAutoLinks()</p>
            </div>
        </article>
    }
</div>
