@using Usasymbol.Views.Shared.Components.HeatmapBlock
@model HeatmapBlockViewModel

@{
    var mapId = "heatmap-" + Guid.NewGuid().ToString("N")[..8];
}

<div class="not-prose">
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-slate-900 mb-4">
        @Model.Title
    </h2>

    <div class="relative border border-slate-200 overflow-hidden bg-slate-950"
         style="height:420px; max-height:55vw;">
        <div id="@mapId" class="absolute inset-0 w-full h-full"></div>

        @if (!string.IsNullOrWhiteSpace(Model.Caption))
        {
            <div class="absolute bottom-0 left-0 right-0 px-4 py-2 bg-slate-950/75 text-slate-300 text-xs leading-relaxed pointer-events-none z-[1000]">
                @Model.Caption
            </div>
        }

        <div id="@mapId-spinner"
             class="absolute inset-0 flex items-center justify-center bg-slate-950 z-[2000] transition-opacity duration-500">
            <div class="flex flex-col items-center gap-3 text-slate-400">
                <svg class="animate-spin h-8 w-8" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
                </svg>
                <span class="text-sm">Loading sighting data…</span>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/vendor/leaflet/leaflet-heat.js"></script>
<script>
    (function () {
        var mapEl      = document.getElementById('@mapId');
        var spinner    = document.getElementById('@mapId-spinner');
        var dataUrl  = '@Model.DataUrl';
        var gradient = '@Model.Gradient';
        var radius   = @Model.Radius;
        var blur     = @Model.Blur;

        var map = L.map(mapEl, {
            center: [38.5, -97.5],
            zoom: 4,
            zoomControl: true,
            attributionControl: true,
            scrollWheelZoom: false
        });

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);

        // Seeded PRNG (mulberry32)
        function prng(seed) {
            return function () {
                seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
                var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
        }

        // Box-Muller Gaussian
        function gauss(rand, mu, sigma) {
            var u, v;
            do { u = rand(); } while (!u);
            do { v = rand(); } while (!v);
            return mu + sigma * Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
        }

        function buildPoints(clusters) {
            var rand = prng(0xdeadbeef);
            var pts = [];
            clusters.forEach(function (cl) {
                var lat = cl.c[0], lng = cl.c[1], r = cl.r, n = cl.n || 1;
                for (var i = 0; i < n; i++) {
                    pts.push([
                        gauss(rand, lat, r * 0.5),
                        gauss(rand, lng, r * 0.5)
                    ]);
                }
            });
            return pts;
        }

        fetch(dataUrl)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                // Support both flat [[lat,lng],...] and cluster [{c:[lat,lng],n,r},...] formats
                var pts;
                if (data.length && Array.isArray(data[0])) {
                    pts = data;
                } else {
                    pts = buildPoints(data);
                }
                L.heatLayer(pts, {
                    radius: radius,
                    blur:   blur,
                    maxZoom: 10,
                    minOpacity: 0.3,
                    gradientPreset: gradient
                }).addTo(map);

                spinner.style.opacity = '0';
                setTimeout(function () { spinner.style.display = 'none'; }, 500);
            })
            .catch(function (err) {
                console.error('Heatmap data failed to load:', err);
                spinner.innerHTML = '<span class="text-sm text-red-400">Map data unavailable.</span>';
            });
    })();
</script>
