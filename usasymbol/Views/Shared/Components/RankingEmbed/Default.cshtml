@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model USASymbol.Models.ViewModels.RankingEmbedViewModel

@{
    var rankingViewData = new ViewDataDictionary(ViewData)
    {
        ["QuickAnswerSectionId"] = $"{Model.IdPrefix}-quick-answer",
        ["RankingTableSectionId"] = $"{Model.IdPrefix}-table",
        ["SectionsSectionId"] = $"{Model.IdPrefix}-sections",
        ["FaqSectionId"] = $"{Model.IdPrefix}-faq",
        ["MethodologySectionId"] = $"{Model.IdPrefix}-methodology"
    };
}

<section id="@Model.IdPrefix" class="content-divider">
    <header class="mb-10 lg:mb-12">
        <div class="relative overflow-hidden rounded-none shadow-none @Model.HeroModel.BackgroundClass text-white">
            <div class="absolute inset-x-0 top-0 h-px @Model.HeroModel.TopRuleClass"></div>
            <div class="absolute right-8 top-14 hidden h-48 w-48 rounded-full @Model.HeroModel.PrimaryGlowClass blur-3xl lg:block"></div>
            <div class="absolute left-1/3 top-0 hidden h-40 w-40 rounded-full @Model.HeroModel.SecondaryGlowClass blur-3xl lg:block"></div>

            <div class="relative px-5 pb-7 pt-6 sm:px-6 lg:px-8 lg:pb-9 lg:pt-8 xl:px-10">
                <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(300px,420px)] xl:grid-cols-[minmax(0,1fr)_460px] lg:items-start xl:gap-10">
                    <div class="min-w-0 order-1 pt-2 lg:pt-6">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-300">
                            <span class="inline-flex items-center gap-2 text-white">
                                <span class="block h-1.5 w-1.5 rounded-full @Model.HeroModel.AccentDotClass"></span>
                                @Model.HeroModel.HeroLabel
                            </span>
                            @foreach (var item in Model.HeroModel.EyebrowItems.Where(item => !string.IsNullOrWhiteSpace(item)))
                            {
                                <span>@item</span>
                            }
                        </div>

                        <div class="mt-6 max-w-4xl">
                            <h2 class="max-w-4xl text-4xl font-bold tracking-tight text-white leading-[0.98] sm:text-5xl lg:text-[4.15rem]">
                                @Model.HeroModel.Title
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(Model.HeroModel.Description))
                            {
                                <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-100 sm:text-xl">
                                    @Model.HeroModel.Description
                                </p>
                            }
                        </div>
                    </div>

                    <div class="order-2 lg:pt-5">
                        <div class="[&_figure]:mb-0 [&_figcaption]:mt-3 [&_figcaption]:px-0 [&_figcaption]:text-slate-300 [&_figure_.js-visual-lightbox]:bg-slate-900/88">
                            @{
                                var heroVisualViewData = new ViewDataDictionary(ViewData)
                                {
                                    ["key"] = Model.HeroVisualAsset.Src,
                                    ["alt"] = Model.HeroVisualAsset.Alt,
                                    ["caption"] = Model.HeroVisualAsset.Caption,
                                    ["layout"] = Model.HeroVisualAsset.Layout
                                };
                            }
                            @await Html.PartialAsync("Components/VisualAsset/_VisualAssetFromKey", Model.PageModel, heroVisualViewData)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.HeroModel.FigureTitle) || !string.IsNullOrWhiteSpace(Model.HeroModel.FigureSubtitle))
                        {
                            <div class="mt-3 flex flex-wrap items-start justify-between gap-3 border-t border-white/15 pt-3 text-slate-300">
                                <div class="min-w-0">
                                    @if (!string.IsNullOrWhiteSpace(Model.HeroModel.FigureTitle))
                                    {
                                        <p class="text-sm font-semibold text-white">@Model.HeroModel.FigureTitle</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.HeroModel.FigureSubtitle))
                                    {
                                        <p class="text-xs uppercase tracking-[0.14em]">@Model.HeroModel.FigureSubtitle</p>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.HeroModel.ImageLinkUrl))
                                {
                                    <a href="@Model.HeroModel.ImageLinkUrl"
                                       target="_blank"
                                       rel="nofollow noopener noreferrer"
                                       class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300 transition hover:text-white">
                                        <i class="fas fa-up-right-from-square shrink-0 text-[10px]"></i>
                                        View original
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    @await Html.PartialAsync("~/Views/Rankings/_RankingBody.cshtml", Model.PageModel, rankingViewData)
</section>
