@model USASymbol.Models.ViewModels.TableSectionViewModel

@{
    var browseLabel = ViewData["TableBrowseLabel"] as string ?? "Browse";
    var heading = ViewData["TableHeading"] as string ?? "Filter and explore";
    var description = ViewData["TableDescription"] as string ?? "Search by state name, switch views, and compare columns.";
}

<section class="mb-10" aria-label="Table controls">
    <div class="rounded-[1.5rem] border border-slate-200 bg-white/90 p-4 md:p-6">
        <div class="flex min-w-0 flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div class="min-w-0">
                <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">@browseLabel</p>
                <h3 class="mt-2 text-lg md:text-xl font-semibold tracking-tight text-slate-900">@heading</h3>
                <p class="mt-1 text-sm text-slate-600">@description</p>
            </div>

            <div class="min-w-0 md:pt-2">
                <span class="inline-flex max-w-full items-center gap-2 rounded-full border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 sm:px-4">
                    <i class="fa-regular fa-eye text-slate-600" aria-hidden="true"></i>
                    <span id="resultsCounter" class="min-w-0 truncate">Showing all @Model.TotalRowsCount entries</span>
                </span>
            </div>
        </div>

        <div class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
            @if (Model.Searchable)
            {
                <div class="relative w-full lg:max-w-md">
                    <input id="tableSearch"
                           type="text"
                           placeholder="Search..."
                           class="w-full rounded-lg border border-slate-200 px-4 py-3 pr-12 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-100 transition"
                           autocomplete="off" />
                    <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </span>
                </div>
            }

            <div class="flex min-w-0 flex-wrap items-center gap-3">
                @if (Model.ShowMetricToggle)
                {
                    var defaultKey = Model.DefaultColumnKey;
                    var toggleColumns = Model.ToggleableColumnsList;

                    <div class="ranking-metric-toggle flex max-w-full overflow-x-auto rounded-lg border border-slate-200 p-1">
                        @foreach (var col in toggleColumns)
                        {
                            var isDefault = col.Key == defaultKey;
                            <button class="metricBtn inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-md px-4 py-2 text-sm font-semibold transition @(isDefault ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-50")"
                                    data-metric="@col.Key"
                                    type="button">
                                @col.Label
                            </button>
                        }
                    </div>
                }

                <div class="inline-flex rounded-lg border border-slate-200 p-1">
                    <button id="viewCards"
                            class="viewBtn inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-md px-3 sm:px-4 py-2 text-sm font-semibold transition text-slate-700 hover:text-slate-900 hover:bg-slate-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
                            data-view="cards"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span class="hidden sm:inline leading-none">Cards</span>
                    </button>

                    <button id="viewTable"
                            class="viewBtn inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-md px-3 sm:px-4 py-2 text-sm font-semibold transition text-slate-700 hover:text-slate-900 hover:bg-slate-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
                            data-view="table"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-table" aria-hidden="true"></i>
                        <span class="hidden sm:inline leading-none">Table</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
