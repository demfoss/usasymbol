@model USASymbol.Models.ViewModels.TableSectionViewModel
@using Usasymbol.Helpers

@{
    var firstTable = Model.Tables.FirstOrDefault();
    var sortColumns = firstTable != null && firstTable.Sortable
        ? firstTable.Columns.Where(c => c.Sortable && !string.IsNullOrWhiteSpace(c.Key) && c.Key != "state_slug").ToList()
        : new List<USASymbol.Models.Content.TableColumn>();
    var defaultSortKey = firstTable?.DefaultColumn ?? sortColumns.FirstOrDefault()?.Key;

    var quickFilter = TableFilterHelper.GetQuickFilterColumn(firstTable);
}

<div class="ranking-controls" aria-label="Table controls">
    <div class="ranking-controls__inner">
        <div class="ranking-controls__primary">
            @if (Model.Searchable)
            {
                <label class="ranking-search" for="tableSearch">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input id="tableSearch"
                           type="text"
                           placeholder="Search..."
                           aria-label="Search table"
                           autocomplete="off" />
                </label>
            }

            <div class="ranking-controls__actions">
                @if (sortColumns.Count > 1)
                {
                    <label class="ranking-sort-select">
                        <span>Sort by</span>
                        <select id="sortBySelect">
                            @foreach (var col in sortColumns)
                            {
                                <option value="@col.Key" selected="@(col.Key == defaultSortKey ? "selected" : null)">@col.Label</option>
                            }
                        </select>
                    </label>
                }

                @if (Model.ShowMetricToggle)
                {
                    var defaultKey = Model.DefaultColumnKey;
                    var toggleColumns = Model.ToggleableColumnsList;

                    <div class="ranking-metric-toggle" aria-label="Choose metric">
                        @foreach (var col in toggleColumns)
                        {
                            var isDefault = col.Key == defaultKey;
                            <button class="metricBtn @(isDefault ? "is-active" : "")"
                                    data-metric="@col.Key"
                                    type="button"
                                    aria-pressed="@(isDefault ? "true" : "false")">
                                @col.Label
                            </button>
                        }
                    </div>
                }

                <div class="ranking-view-toggle" aria-label="Choose view">
                    <button id="viewCards"
                            class="viewBtn"
                            data-view="cards"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span>Cards</span>
                    </button>

                    <button id="viewTable"
                            class="viewBtn"
                            data-view="table"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-table" aria-hidden="true"></i>
                        <span>Table</span>
                    </button>
                </div>
            </div>
        </div>

        @if (quickFilter != null)
        {
            <div id="quickFilterChips" class="ranking-filter-chips" data-chip-key="@quickFilter.Key">
                <span class="ranking-filter-chips__label">@quickFilter.Label</span>
                <button type="button"
                        class="filterChip is-active"
                        data-chip-value=""
                        aria-pressed="true">
                    All
                </button>
                @foreach (var value in quickFilter.Values)
                {
                    <button type="button"
                            class="filterChip"
                            data-chip-value="@value"
                            aria-pressed="false">
                        @value
                    </button>
                }
            </div>
        }
    </div>
</div>
