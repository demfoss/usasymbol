@model USASymbol.Models.ViewModels.TableSectionViewModel
@using Usasymbol.Helpers

@{
    var firstTable = Model.Tables.FirstOrDefault();
    var sortColumns = firstTable != null && firstTable.Sortable
        ? firstTable.Columns.Where(c => c.Sortable && !string.IsNullOrWhiteSpace(c.Key) && c.Key != "state_slug").ToList()
        : new List<USASymbol.Models.Content.TableColumn>();
    var defaultSortKey = firstTable?.DefaultColumn ?? sortColumns.FirstOrDefault()?.Key;

    var quickFilter = TableFilterHelper.GetQuickFilterColumn(firstTable);
    var isFlagListing = string.Equals(Model.DetailType, "flag", StringComparison.OrdinalIgnoreCase);
}

<div class="ranking-controls" aria-label="Table controls">
    <div class="ranking-controls__inner">
        <div class="ranking-controls__primary">
            @if (Model.Searchable)
            {
                <label class="ranking-search" for="tableSearch">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input id="tableSearch"
                           type="text"
                           placeholder="Search..."
                           aria-label="Search table"
                           autocomplete="off" />
                </label>
            }

            <div class="ranking-controls__actions">
                @if (sortColumns.Count > 1)
                {
                    <label class="ranking-sort-select">
                        <span>Sort by</span>
                        <select id="sortBySelect">
                            @foreach (var col in sortColumns)
                            {
                                <option value="@col.Key" selected="@(col.Key == defaultSortKey ? "selected" : null)">@col.Label</option>
                            }
                        </select>
                    </label>
                }

                @if (Model.ShowMetricToggle)
                {
                    var defaultKey = Model.DefaultColumnKey;
                    var toggleColumns = Model.ToggleableColumnsList;

                    <div class="ranking-metric-toggle" aria-label="Choose metric">
                        @foreach (var col in toggleColumns)
                        {
                            var isDefault = col.Key == defaultKey;
                            <button class="metricBtn @(isDefault ? "is-active" : "")"
                                    data-metric="@col.Key"
                                    type="button"
                                    aria-pressed="@(isDefault ? "true" : "false")">
                                @col.Label
                            </button>
                        }
                    </div>
                }

                <div class="ranking-view-toggle" aria-label="Choose view">
                    <button id="viewCards"
                            class="viewBtn"
                            data-view="cards"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span>Cards</span>
                    </button>

                    <button id="viewTable"
                            class="viewBtn"
                            data-view="table"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-table" aria-hidden="true"></i>
                        <span>Table</span>
                    </button>
                </div>
            </div>
        </div>

        @if (quickFilter != null)
        {
            <div id="quickFilterChips" class="ranking-filter-chips" data-chip-key="@quickFilter.Key">
                <span class="ranking-filter-chips__label">@quickFilter.Label</span>
                <button type="button"
                        class="filterChip is-active"
                        data-chip-value=""
                        aria-pressed="true">
                    All
                </button>
                @foreach (var value in quickFilter.Values)
                {
                    <button type="button"
                            class="filterChip"
                            data-chip-value="@value"
                            aria-pressed="false">
                        @value
                    </button>
                }
            </div>
        }

        @if (isFlagListing)
        {
            <fieldset id="flagListingFilters" class="border-0 p-0" aria-label="Filter state flags by design">
                <legend class="sr-only">State flag design filters</legend>
                <div class="flex flex-wrap items-end gap-3 border-t border-slate-200 px-3 py-3 sm:px-4">
                    <label class="min-w-[150px] flex-1 text-xs font-semibold text-slate-600 sm:flex-none">
                        <span class="mb-1 block">Design family</span>
                        <select data-flag-filter="designFamily" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                            <option value="">All designs</option>
                            <option value="Seal or arms">Seal or arms</option>
                            <option value="Bold geometry">Bold geometry</option>
                            <option value="Single emblem">Single emblem</option>
                            <option value="Stripes and canton">Stripes and canton</option>
                            <option value="Heraldry">Heraldry</option>
                            <option value="Constellation">Constellation</option>
                            <option value="Two-sided">Two-sided</option>
                        </select>
                    </label>
                    <label class="min-w-[125px] flex-1 text-xs font-semibold text-slate-600 sm:flex-none">
                        <span class="mb-1 block">Seal or arms</span>
                        <select data-flag-filter="seal" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                            <option value="">Either</option>
                            <option value="Yes">Has seal/arms</option>
                            <option value="No">No seal/arms</option>
                        </select>
                    </label>
                    <label class="min-w-[120px] flex-1 text-xs font-semibold text-slate-600 sm:flex-none">
                        <span class="mb-1 block">Visible text</span>
                        <select data-flag-filter="text" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                            <option value="">Either</option>
                            <option value="Yes">Has text</option>
                            <option value="No">No text</option>
                        </select>
                    </label>
                    <label class="min-w-[135px] flex-1 text-xs font-semibold text-slate-600 sm:flex-none">
                        <span class="mb-1 block">Dominant field</span>
                        <select data-flag-filter="dominantColor" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                            <option value="">All colors</option>
                            <option value="Blue">Blue</option>
                            <option value="Red">Red</option>
                            <option value="White">White</option>
                            <option value="Yellow/Gold">Yellow/Gold</option>
                            <option value="Green">Green</option>
                            <option value="Multicolor">Multicolor</option>
                        </select>
                    </label>
                    <button id="clearFlagFilters" type="button" class="hidden rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-200">
                        Clear filters
                    </button>
                </div>
            </fieldset>
        }
    </div>
</div>
