@model USASymbol.Models.ViewModels.TableSectionViewModel
@using Usasymbol.Helpers

@{
    var firstTable = Model.Tables.FirstOrDefault();
    var sortColumns = firstTable != null && firstTable.Sortable
        ? firstTable.Columns.Where(c => c.Sortable && !string.IsNullOrWhiteSpace(c.Key) && c.Key != "state_slug").ToList()
        : new List<USASymbol.Models.Content.TableColumn>();
    var defaultSortKey = firstTable?.DefaultColumn ?? sortColumns.FirstOrDefault()?.Key;

    var quickFilter = TableFilterHelper.GetQuickFilterColumn(firstTable);
}

<section aria-label="Table controls">
    <div class="border-b border-slate-200/80 px-4 py-4 md:px-5 md:py-5">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
            @if (Model.Searchable)
            {
                <div class="relative w-full lg:max-w-md">
                    <input id="tableSearch"
                           type="text"
                           placeholder="Search..."
                           class="w-full border border-slate-200 bg-white px-4 py-3 pr-12 text-sm text-slate-900 placeholder:text-slate-400 transition focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-100"
                           autocomplete="off" />
                    <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </span>
                </div>
            }

            <div class="flex min-w-0 flex-wrap items-center gap-3">
                @if (sortColumns.Count > 1)
                {
                    <label class="hidden lg:flex items-center gap-2 text-sm text-slate-600">
                        <span class="font-semibold text-slate-700">Sort by</span>
                        <select id="sortBySelect"
                                class="min-h-[42px] border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-100">
                            @foreach (var col in sortColumns)
                            {
                                <option value="@col.Key" selected="@(col.Key == defaultSortKey ? "selected" : null)">@col.Label</option>
                            }
                        </select>
                    </label>
                }

                @if (Model.ShowMetricToggle)
                {
                    var defaultKey = Model.DefaultColumnKey;
                    var toggleColumns = Model.ToggleableColumnsList;

                    <div class="ranking-metric-toggle flex max-w-full overflow-x-auto border border-slate-200 bg-white p-1">
                        @foreach (var col in toggleColumns)
                        {
                            var isDefault = col.Key == defaultKey;
                            <button class="metricBtn inline-flex min-h-[42px] shrink-0 items-center justify-center px-4 py-2 text-sm font-semibold transition @(isDefault ? "bg-slate-900 text-white" : "text-slate-700 hover:bg-slate-50")"
                                    data-metric="@col.Key"
                                    type="button">
                                @col.Label
                            </button>
                        }
                    </div>
                }

                <div class="inline-flex border border-slate-200 bg-white p-1">
                    <button id="viewCards"
                            class="viewBtn inline-flex min-h-[42px] min-w-[42px] items-center justify-center gap-2 px-3 py-2 text-sm font-semibold transition text-slate-700 hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100 sm:px-4"
                            data-view="cards"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span class="hidden sm:inline leading-none">Cards</span>
                    </button>

                    <button id="viewTable"
                            class="viewBtn inline-flex min-h-[42px] min-w-[42px] items-center justify-center gap-2 px-3 py-2 text-sm font-semibold transition text-slate-700 hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100 sm:px-4"
                            data-view="table"
                            type="button"
                            aria-pressed="false">
                        <i class="fas fa-table" aria-hidden="true"></i>
                        <span class="hidden sm:inline leading-none">Table</span>
                    </button>
                </div>
            </div>
        </div>

        @if (quickFilter != null)
        {
            <div id="quickFilterChips" class="mt-3 flex flex-wrap items-center gap-2" data-chip-key="@quickFilter.Key">
                <span class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-400">@quickFilter.Label</span>
                <button type="button"
                        class="filterChip inline-flex items-center rounded-full border border-slate-900 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition"
                        data-chip-value=""
                        aria-pressed="true">
                    All
                </button>
                @foreach (var value in quickFilter.Values)
                {
                    <button type="button"
                            class="filterChip inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:bg-slate-50"
                            data-chip-value="@value"
                            aria-pressed="false">
                        @value
                    </button>
                }
            </div>
        }
    </div>
</section>
