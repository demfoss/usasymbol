@model USASymbol.Models.ViewModels.TableSectionViewModel
@inject IImageUrlService Images
@using Usasymbol.Helpers

@{
    var firstTable = Model.Tables.FirstOrDefault();
    var quickFilter = TableFilterHelper.GetQuickFilterColumn(firstTable);
    var isFlagListing = string.Equals(Model.DetailType, "flag", StringComparison.OrdinalIgnoreCase);
}

@if (Model.Tables.Any())
{
    <div id="tableView" class="hidden">

        @foreach (var table in Model.Tables)
        {
            if (!table.Rows.Any() || !table.Columns.Any()) { continue; }

            var hiddenColumns = new HashSet<string>(table.HiddenColumns ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
            var columns   = table.Columns.Where(col => !hiddenColumns.Contains(col.Key)).ToList();
            var toggleable = table.ToggleableColumns;
            var defaultCol = table.DefaultColumn ?? toggleable.FirstOrDefault();
            var tableQuickFilter = table == firstTable ? quickFilter : null;
            var ranking = RankingPresentation.Create(table);
            var orderedRows = (ranking?.Rows(table) ?? table.Rows).ToList();
            var national = table == firstTable ? NationalReferenceResolver.Resolve(table, ranking?.Insights) : null;
            var nationalKey = ranking?.Insights.MetricColumn.Key;

            if (!columns.Any()) { continue; }

            @* Title — only for multi-table layouts *@
            @if (Model.Tables.Count > 1 && !string.IsNullOrWhiteSpace(table.Title))
            {
                <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-slate-900 mt-8 mb-4 first:mt-0">
                    @table.Title
                </h3>
            }

            @if (national != null)
            {
                <p class="ranking-national-note"><strong>U.S.: @national.Display</strong> <span>@national.Caption</span></p>
            }
            <div class="ranking-table-frame">
            <div class="ranking-table-scroll @(Model.Tables.Count > 1 ? "ranking-table-scroll--spaced" : "")">
                <table class="rankingTable">
                    @if (!string.IsNullOrWhiteSpace(table.Caption ?? table.Title))
                    {
                        <caption class="sr-only">@(table.Caption ?? table.Title)</caption>
                    }

                    <!-- HEADER -->
                    <thead>
                        <tr>
                            @foreach (var col in columns)
                            {
                                if (col.Key == "state_slug") { continue; }

                                var isToggleable = toggleable.Contains(col.Key);
                                var isHidden     = isToggleable && col.Key != defaultCol && toggleable.Count > 1;
                                var hiddenClass  = isHidden ? "hidden" : "";
                                var sortable     = col.Sortable && table.Sortable;

                                <th class="rankingTh @(sortable ? "rankingTh--sortable" : "") @hiddenClass"
                                    data-column="@col.Key"
                                    data-coltype="@col.Type"
                                    scope="col"
                                    @if (sortable) { <text>tabindex="0" role="button" aria-sort="none"</text> }
                                    @if (isToggleable) { <text>data-toggleable="true"</text> }
                                    @if (sortable)     { <text>data-sort="@col.Key"</text> }>
                                    <div class="rankingTh__content">
                                        <span>@col.Label</span>
                                        @if (sortable)
                                        {
                                            <i class="ranking-sort-icon fas fa-sort" aria-hidden="true"></i>
                                        }
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <!-- BODY -->
                    <tbody class="rankingTbody">
                        @for (int i = 0; i < orderedRows.Count; i++)
                        {
                            var row        = orderedRows[i];
                            var placement  = ranking?.For(row);
                            var stateSlug  = row.GetString("state_slug");
                            var stateName  = row.GetString("state");
                            var postalCode = row.GetString("postal_code") ?? row.GetString("state_code") ?? row.GetString("abbr") ?? row.GetString("abbreviation");
                            // Empty when the row has no real state page (e.g. Washington D.C., Canadian
                            // provinces) so it doesn't fall back to a bare "/states/" link -- rows without
                            // a resolvable state/symbol URL should not be clickable at all (see below).
                            var stateUrl   = !string.IsNullOrWhiteSpace(stateSlug) ? $"/states/{stateSlug}" : "";

                            // ── URL priority: custom_url > auto-built ──────────────────
                            var customRowUrl = row.GetString("custom_url");
                            string symbolUrl;
                            if (!string.IsNullOrEmpty(customRowUrl))
                            {
                                symbolUrl = customRowUrl;
                            }
                            else
                            {
                                var symbolSlug = row.GetString("symbol_slug");
                                if (string.IsNullOrWhiteSpace(symbolSlug) && !string.IsNullOrEmpty(Model.DetailType))
                                    symbolSlug = row.GetString($"{Model.DetailType}_slug");
                                if (string.IsNullOrWhiteSpace(symbolSlug) && Model.DetailType == "flag")
                                    symbolSlug = $"{stateSlug}-state-flag";
                                symbolUrl = (!string.IsNullOrWhiteSpace(symbolSlug) && !string.IsNullOrWhiteSpace(Model.DetailType) && !string.IsNullOrWhiteSpace(stateSlug))
                                    ? $"/states/{stateSlug}/{Model.DetailType}/{symbolSlug}"
                                    : "";
                            }

                            var effectiveSymbolUrl = row.GetString("symbol_url") is { Length: > 0 } explicitSymbolUrl ? explicitSymbolUrl : symbolUrl;
                            var rowIsClickable = !string.IsNullOrWhiteSpace(stateUrl) || !string.IsNullOrWhiteSpace(effectiveSymbolUrl);

                            // ── Search text: include all non-slug text columns ─────────
                            var searchParts = new System.Collections.Generic.List<string?> { stateName };
                            foreach (var c in columns.Where(c => c.Type != "image" && !c.Key.EndsWith("_slug") && c.Key != "state" && c.Key != "custom_url"))
                            {
                                if (hiddenColumns.Contains(c.Key)) { continue; }
                                if (row.Data.TryGetValue(c.Key, out var sv)) searchParts.Add(sv?.ToString());
                            }
                            var rowSearchText = string.Join(" ", searchParts.Where(s => !string.IsNullOrEmpty(s))).ToLowerInvariant();
                            var rowRankRaw = row.GetString("rank");
                            var rowRank = placement?.Rank ?? (int.TryParse((rowRankRaw ?? string.Empty).Replace(",", ""), out var parsedRank) ? parsedRank : 0);
                            var flagDesignFamily = row.GetString("design_family") ?? "";
                            var flagHasSeal = row.GetString("has_seal") ?? "";
                            var flagHasText = row.GetString("has_text") ?? "";
                            var flagDominantColor = row.GetString("dominant_color") ?? "";
                            <tr class="tableRow group @(rowIsClickable ? "tableRow--clickable" : "")"
                                data-state="@(stateName?.ToLower())"
                                data-search="@rowSearchText"
                                data-state-slug="@stateSlug"
                                data-state-code="@postalCode"
                                data-rank="@rowRank"
                                data-state-url="@stateUrl"
                                data-symbol-url="@effectiveSymbolUrl"
                                @if (isFlagListing) { <text>data-design-family="@flagDesignFamily" data-seal="@flagHasSeal" data-text="@flagHasText" data-dominant-color="@flagDominantColor"</text> }
                                @if (tableQuickFilter != null) { <text>data-chip-value="@TableFilterHelper.GetQuickFilterValue(tableQuickFilter, row)"</text> }>

                                @foreach (var col in columns)
                                {
                                    if (col.Key == "state_slug") { continue; }

                                    var isToggleable = !string.IsNullOrWhiteSpace(col.Key) && toggleable.Contains(col.Key);
                                    var isHidden     = isToggleable && col.Key != defaultCol && toggleable.Count > 1;
                                    var hiddenClass  = isHidden ? "hidden" : "";
                                    var cellValue    = !string.IsNullOrWhiteSpace(col.Key) && row.Data.TryGetValue(col.Key, out var val) ? val : null;
                                    <td class="ranking-cell @hiddenClass"
                                        data-column="@col.Key"
                                        data-coltype="@col.Type"
                                        @if (isToggleable) { <text>data-toggleable="true"</text> }>

                                        @switch (col.Type)
                                        {
                                            case "rank":
                                            {
                                                var rankStr = placement?.Label ?? FormatValue(cellValue, col);
                                                <span class="ranking-rank" title="@placement?.Tooltip">
                                                    @rankStr
                                                </span>
                                                break;
                                            }

                                            case "state-link":
                                            {
                                                var flagPath = !string.IsNullOrEmpty(stateSlug) ? $"/images/flags/{stateSlug}/flag.webp" : "";
                                                <span class="ranking-state">
                                                    @if (!string.IsNullOrEmpty(flagPath))
                                                    {
                                                        <img src="@Images.Thumb(flagPath)" alt="@(stateName ?? "State") flag"
                                                             class="h-5 w-auto object-contain rounded-sm flex-shrink-0"
                                                             loading="lazy" decoding="async" />
                                                    }
                                                    @if (!string.IsNullOrEmpty(stateSlug) && string.IsNullOrWhiteSpace(effectiveSymbolUrl))
                                                    {
                                                        <a href="/states/@stateSlug">@(cellValue?.ToString() ?? stateName ?? "—")</a>
                                                    }
                                                    else
                                                    {
                                                        <span>@(cellValue?.ToString() ?? stateName ?? "—")</span>
                                                    }
                                                </span>
                                                break;
                                            }

                                            case "image":
                                                var imgSrc = cellValue?.ToString() ?? "";
                                                if (!string.IsNullOrEmpty(imgSrc))
                                                {
                                                    var isSymbolImage = string.Equals(col.Key, "symbol_image", StringComparison.OrdinalIgnoreCase);
                                                    var tableImageSrc = isSymbolImage ? Images.Thumb(imgSrc) : Images.Thumb(imgSrc);
                                                    var imageClass = isSymbolImage
                                                        ? "h-14 md:h-16 w-auto rounded-md object-contain"
                                                        : "h-14 md:h-16 w-auto object-contain";
                                                    <img src="@tableImageSrc" alt="@GetTableImageAlt(imgSrc, stateName, col.Label)" class="@imageClass" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <span class="text-slate-300">—</span>
                                                }
                                                break;

                                            case "color-swatches":
                                            {
                                                var hexText = cellValue?.ToString() ?? "";
                                                var hexCodes = hexText
                                                    .Split(new[] { " / ", "/" }, StringSplitOptions.RemoveEmptyEntries)
                                                    .Select(h => h.Trim())
                                                    .Where(h => h.StartsWith("#") && h.Length >= 4)
                                                    .ToList();
                                                if (hexCodes.Any())
                                                {
                                                    <div class="flex items-center gap-1">
                                                        @foreach (var hex in hexCodes)
                                                        {
                                                            <span title="@hex"
                                                                  style="background-color: @hex;"
                                                                  class="inline-block h-6 w-8 flex-shrink-0 border border-slate-200/80"
                                                                  aria-label="@hex"></span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400 text-xs">—</span>
                                                }
                                                break;
                                            }

                                            case "link":
                                                var linkUrl = cellValue?.ToString() ?? "";
                                                if (!string.IsNullOrEmpty(linkUrl))
                                                {
                                                    <a href="@linkUrl" target="_blank" rel="nofollow noopener noreferrer"
                                                       class="row-link inline-flex items-center gap-2 text-slate-700 hover:text-slate-900 no-underline hover:no-underline">
                                                        <span class="text-xs font-semibold">Open</span>
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-400"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-300">—</span>
                                                }
                                                break;

                                            case "number":
                                                <span class="ranking-number">
                                                    @FormatValue(cellValue, col)
                                                </span>
                                                @if (national != null && string.Equals(col.Key, nationalKey, StringComparison.OrdinalIgnoreCase)
                                                     && double.TryParse(cellValue?.ToString()?.Replace(",", "").Replace("%", ""), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var nationalCellValue)
                                                     && national.Delta(nationalCellValue) is { } nationalDelta)
                                                {
                                                    <span class="ranking-vs-us" title="Difference from the U.S. figure (@national.Display)">@nationalDelta vs U.S.</span>
                                                }
                                                break;

                                            case "date":
                                                <span class="ranking-date">@FormatValue(cellValue, col)</span>
                                                break;

                                            default:
                                            {
                                                var isDetailCol = string.Equals(col.Key, Model.DetailType, StringComparison.OrdinalIgnoreCase);
                                                var text = cellValue?.ToString() ?? "—";
                                                var key  = (col.Key ?? "").ToLowerInvariant();

                                                if (isFlagListing && key == "meaning")
                                                {
                                                    var flagDesign = row.GetString("design") ?? "Not specified";
                                                    <details class="group min-w-[12rem]">
                                                        <summary class="cursor-pointer list-none rounded-md text-sm font-semibold text-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-200">
                                                            <span class="inline-flex items-center gap-1.5">
                                                                <span>Show meaning</span>
                                                                <i class="fa-solid fa-chevron-down text-[10px] transition-transform group-open:rotate-180" aria-hidden="true"></i>
                                                            </span>
                                                        </summary>
                                                        <div class="mt-2 max-w-md rounded-lg bg-slate-50 p-3 text-sm leading-5 text-slate-600">
                                                            <p><strong class="text-slate-800">Design:</strong> @flagDesign</p>
                                                            <p class="mt-1"><strong class="text-slate-800">Meaning:</strong> @text</p>
                                                            <p class="mt-2 text-xs text-slate-500">@flagDesignFamily · @(flagHasSeal == "Yes" ? "Seal or arms" : "No seal or arms") · @(flagHasText == "Yes" ? "Visible text" : "No visible text") · @flagDominantColor field</p>
                                                        </div>
                                                    </details>
                                                }
                                                else if (key == "scientific_name" || key.Contains("scientific"))
                                                {
                                                    <span class="ranking-scientific">@text</span>
                                                }
                                                else if (isDetailCol)
                                                {
                                                    <span class="ranking-primary-value">@text</span>
                                                }
                                                else if (key == "notes" || key == "note")
                                                {
                                                    if (text == "—")
                                                    {
                                                        <span class="text-slate-300">—</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="noteTrigger inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500 transition hover:border-slate-300 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
                                                                data-note="@text"
                                                                aria-haspopup="dialog">
                                                            <i class="fa-regular fa-note-sticky text-[11px]" aria-hidden="true"></i>
                                                            <span>Note</span>
                                                        </button>
                                                    }
                                                }
                                                else if (key == "status" && row.GetString("status_url") is { Length: > 0 } statusUrl)
                                                {
                                                    <a href="@statusUrl"
                                                       target="_blank"
                                                       rel="nofollow noopener noreferrer"
                                                       class="row-link inline-flex items-center gap-1.5 font-semibold text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-blue-900">
                                                        @text
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="ranking-text-value">@text</span>
                                                }
                                                break;
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    @{ var totals = table == firstTable ? TableTotals.Resolve(table) : null; }
                    @if (totals != null)
                    {
                        var en = System.Globalization.CultureInfo.GetCultureInfo("en-US");
                        var metricFormat = columns.FirstOrDefault(c => c.Key == totals.MetricKey)?.Format ?? "N0";
                        var labelKey = columns.FirstOrDefault(c => c.Key == "state" || c.Type == "state-link" || c.Type == "text")?.Key;
                        <tfoot class="ranking-totals">
                            @foreach (var line in new[] { (Label: totals.OtherLabel, Value: totals.Other, Show: totals.ShowOther, IsTotal: false), (Label: totals.TotalLabel, Value: totals.Total, Show: true, IsTotal: true) })
                            {
                                if (!line.Show) { continue; }
                                <tr class="@(line.IsTotal ? "ranking-totals__total" : "ranking-totals__other")">
                                    @foreach (var col in columns)
                                    {
                                        if (col.Key == "state_slug") { continue; }
                                        var tdHidden = toggleable.Contains(col.Key) && col.Key != defaultCol && toggleable.Count > 1 ? "hidden" : "";
                                        string cell = col.Key == labelKey ? line.Label
                                            : col.Key == totals.MetricKey ? line.Value.ToString(metricFormat, en)
                                            : col.Key == "share_of_us" ? (line.Value / totals.Total * 100).ToString("0.0", en) + "%"
                                            : col.Key == "rank" ? ""
                                            : "\u2014";
                                        <td class="ranking-cell @tdHidden @(col.Key == labelKey ? "ranking-totals__label" : null)" style="@(col.Type == "number" || col.Type == "rank" ? "text-align:right" : null)">@cell</td>
                                    }
                                </tr>
                            }
                        </tfoot>
                    }
                </table>
            </div>
            </div>
        }

        <div id="tableEmptyState" class="hidden px-4 py-12 text-center" aria-live="polite">
            <div class="text-6xl mb-4">🔍</div>
            <h3 class="text-xl font-black text-slate-900 mb-2">No matching entries</h3>
            <p class="text-slate-600">Adjust the filter to show more entries.</p>
        </div>
    </div>
}

@functions {
    string GetTableImageAlt(string imagePath, string? stateName, string? columnLabel)
    {
        if (!string.IsNullOrWhiteSpace(stateName) && !string.IsNullOrWhiteSpace(columnLabel))
        {
            return $"{stateName} {columnLabel}".Trim();
        }

        var fileName = System.IO.Path.GetFileNameWithoutExtension(imagePath ?? string.Empty)
            .Replace('-', ' ')
            .Replace('_', ' ')
            .Trim();

        return string.IsNullOrWhiteSpace(fileName)
            ? "Table image"
            : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(fileName.ToLowerInvariant());
    }
}

@functions {
    // "Change"/"growth" columns read better as +5.9% and \u22129.9% (a true minus, same width as the plus).
    static string SignedChange(TableColumn col, double value, string text)
    {
        var name = (col.Key + " " + col.Label).ToLowerInvariant();
        if (!(name.Contains("change") || name.Contains("growth"))) return text;
        if (value > 0 && !text.StartsWith("+")) return "+" + text;
        if (text.StartsWith("-")) return "\u2212" + text.Substring(1);
        return text;
    }

    string FormatValue(object? value, TableColumn col)
    {
        if (value == null) return "—";
        var s = value.ToString() ?? "";
        if (string.IsNullOrEmpty(s)) return "—";

        switch (col.Type)
        {
            case "number":
            case "rank":
                var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
                if (long.TryParse(s.Replace(",", "").Replace(" ", ""), out var n))
                    return SignedChange(col, n, n.ToString(col.Format ?? "N0", usCulture));
                if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dbl))
                    return SignedChange(col, dbl, dbl.ToString(col.Format ?? "N2", usCulture));
                return s;

            case "date":
                if (DateTime.TryParse(s, out var d))
                    return d.ToString(col.Format ?? "MMM d, yyyy");
                return s;

            default:
                return s;
        }
    }

}
