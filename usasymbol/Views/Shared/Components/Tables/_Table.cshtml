@model USASymbol.Models.ViewModels.TableSectionViewModel
@inject IImageUrlService Images
@using Usasymbol.Helpers

@{
    var firstTable = Model.Tables.FirstOrDefault();
    var quickFilter = TableFilterHelper.GetQuickFilterColumn(firstTable);
}

@if (Model.Tables.Any())
{
    <div id="tableView" class="hidden">

        @foreach (var table in Model.Tables)
        {
            if (!table.Rows.Any() || !table.Columns.Any()) { continue; }

            var hiddenColumns = new HashSet<string>(table.HiddenColumns ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
            var columns   = table.Columns.Where(col => !hiddenColumns.Contains(col.Key)).ToList();
            var toggleable = table.ToggleableColumns;
            var defaultCol = table.DefaultColumn ?? toggleable.FirstOrDefault();
            var tableQuickFilter = table == firstTable ? quickFilter : null;

            if (!columns.Any()) { continue; }

            @* Title — only for multi-table layouts *@
            @if (Model.Tables.Count > 1 && !string.IsNullOrWhiteSpace(table.Title))
            {
                <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-slate-900 mt-8 mb-4 first:mt-0">
                    @table.Title
                </h3>
            }

            <div class="ranking-table-scroll overflow-x-auto @(Model.Tables.Count > 1 ? "mb-6" : "")">
                <table class="rankingTable min-w-full text-left text-sm">

                    <!-- HEADER -->
                    <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur-sm">
                        <tr class="border-b border-slate-200/80">
                            @foreach (var col in columns)
                            {
                                if (col.Key == "state_slug") { continue; }

                                var isToggleable = toggleable.Contains(col.Key);
                                var isHidden     = isToggleable && col.Key != defaultCol && toggleable.Count > 1;
                                var hiddenClass  = isHidden ? "hidden" : "";
                                var sortable     = col.Sortable && table.Sortable;

                                <th class="px-4 py-3 text-[11px] font-extrabold uppercase tracking-[0.12em] text-slate-600
                                           @(sortable ? "cursor-pointer hover:bg-slate-100/80" : "")
                                           transition select-none @hiddenClass"
                                    data-column="@col.Key"
                                    data-coltype="@col.Type"
                                    @if (isToggleable) { <text>data-toggleable="true"</text> }
                                    @if (sortable)     { <text>data-sort="@col.Key"</text> }>
                                    <div class="flex items-center gap-2">
                                        <span>@col.Label</span>
                                        @if (sortable)
                                        {
                                            <i class="fas fa-sort text-slate-300 text-xs"></i>
                                        }
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <!-- BODY -->
                    <tbody class="rankingTbody divide-y divide-slate-100">
                        @for (int i = 0; i < table.Rows.Count; i++)
                        {
                            var row        = table.Rows[i];
                            var rowBg      = i % 2 == 0 ? "bg-white" : "bg-slate-50/35";
                            var stateSlug  = row.GetString("state_slug");
                            var stateName  = row.GetString("state");
                            var postalCode = row.GetString("postal_code") ?? row.GetString("state_code") ?? row.GetString("abbr") ?? row.GetString("abbreviation");
                            var stateUrl   = $"/states/{stateSlug}";

                            // ── URL priority: custom_url > auto-built ──────────────────
                            var customRowUrl = row.GetString("custom_url");
                            string symbolUrl;
                            if (!string.IsNullOrEmpty(customRowUrl))
                            {
                                symbolUrl = customRowUrl;
                            }
                            else
                            {
                                var symbolSlug = row.GetString("symbol_slug");
                                if (string.IsNullOrWhiteSpace(symbolSlug) && !string.IsNullOrEmpty(Model.DetailType))
                                    symbolSlug = row.GetString($"{Model.DetailType}_slug");
                                if (string.IsNullOrWhiteSpace(symbolSlug) && Model.DetailType == "flag")
                                    symbolSlug = $"{stateSlug}-state-flag";
                                symbolUrl = (!string.IsNullOrWhiteSpace(symbolSlug) && !string.IsNullOrWhiteSpace(Model.DetailType) && !string.IsNullOrWhiteSpace(stateSlug))
                                    ? $"/states/{stateSlug}/{Model.DetailType}/{symbolSlug}"
                                    : "";
                            }

                            // ── Search text: include all non-slug text columns ─────────
                            var searchParts = new System.Collections.Generic.List<string?> { stateName };
                            foreach (var c in columns.Where(c => c.Type != "image" && !c.Key.EndsWith("_slug") && c.Key != "state" && c.Key != "custom_url"))
                            {
                                if (hiddenColumns.Contains(c.Key)) { continue; }
                                if (row.Data.TryGetValue(c.Key, out var sv)) searchParts.Add(sv?.ToString());
                            }
                            var rowSearchText = string.Join(" ", searchParts.Where(s => !string.IsNullOrEmpty(s))).ToLowerInvariant();
                            var rowRankRaw = row.GetString("rank");
                            var rowRank = int.TryParse((rowRankRaw ?? string.Empty).Replace(",", ""), out var parsedRank) ? parsedRank : 0;
                            var topRankRowClass = rowRank == 1
                                ? "bg-amber-50/50"
                                : rowRank == 2
                                    ? "bg-slate-50/70"
                                    : rowRank == 3
                                        ? "bg-orange-50/50"
                                        : "";

                            <tr class="tableRow group @rowBg @topRankRowClass cursor-pointer transition-colors hover:bg-slate-50/90"
                                data-state="@(stateName?.ToLower())"
                                data-search="@rowSearchText"
                                data-state-slug="@stateSlug"
                                data-state-code="@postalCode"
                                data-rank="@rowRank"
                                data-state-url="@stateUrl"
                                data-symbol-url="@(row.GetString("symbol_url") is { Length: > 0 } explicitSymbolUrl ? explicitSymbolUrl : symbolUrl)"
                                @if (tableQuickFilter != null) { <text>data-chip-value="@TableFilterHelper.GetQuickFilterValue(tableQuickFilter, row)"</text> }>

                                @foreach (var col in columns)
                                {
                                    if (col.Key == "state_slug") { continue; }

                                    var isToggleable = !string.IsNullOrWhiteSpace(col.Key) && toggleable.Contains(col.Key);
                                    var isHidden     = isToggleable && col.Key != defaultCol && toggleable.Count > 1;
                                    var hiddenClass  = isHidden ? "hidden" : "";
                                    var cellValue    = !string.IsNullOrWhiteSpace(col.Key) && row.Data.TryGetValue(col.Key, out var val) ? val : null;

                                    <td class="px-4 py-3.5 align-middle @hiddenClass"
                                        data-column="@col.Key"
                                        @if (isToggleable) { <text>data-toggleable="true"</text> }>

                                        @switch (col.Type)
                                        {
                                            case "rank":
                                            {
                                                var rankStr = FormatValue(cellValue, col);
                                                var rankNum = int.TryParse(rankStr.Replace(",", ""), out var rn) ? rn : 0;
                                                var medalCls = rankNum == 1 ? "border-amber-300 bg-amber-50 text-amber-700"
                                                             : rankNum == 2 ? "border-slate-300 bg-slate-100 text-slate-600"
                                                             : rankNum == 3 ? "border-orange-300 bg-orange-50 text-orange-700"
                                                             : "border-slate-200 bg-white text-slate-800";
                                                <span class="inline-flex h-7 min-w-[2.25rem] items-center justify-center rounded-full
                                                             border @medalCls text-xs font-extrabold tabular-nums">
                                                    @rankStr
                                                </span>
                                                break;
                                            }

                                            case "state-link":
                                            {
                                                var flagPath = !string.IsNullOrEmpty(stateSlug) ? $"/images/flags/{stateSlug}/flag.webp" : "";
                                                <span class="inline-flex items-center gap-2 font-semibold text-slate-900">
                                                    @if (!string.IsNullOrEmpty(flagPath))
                                                    {
                                                        <img src="@Images.Thumb(flagPath)" alt="@(stateName ?? "State") flag"
                                                             class="h-5 w-auto object-contain rounded-sm flex-shrink-0"
                                                             loading="lazy" decoding="async" />
                                                    }
                                                    <span class="leading-6 group-hover:underline underline-offset-2">@(cellValue?.ToString() ?? stateName ?? "—")</span>
                                                </span>
                                                break;
                                            }

                                            case "image":
                                                var imgSrc = cellValue?.ToString() ?? "";
                                                if (!string.IsNullOrEmpty(imgSrc))
                                                {
                                                    var isSymbolImage = string.Equals(col.Key, "symbol_image", StringComparison.OrdinalIgnoreCase);
                                                    var tableImageSrc = isSymbolImage ? Images.Thumb(imgSrc) : Images.Thumb(imgSrc);
                                                    var imageClass = isSymbolImage
                                                        ? "h-14 md:h-16 w-auto rounded-md object-contain"
                                                        : "h-14 md:h-16 w-auto object-contain";
                                                    <img src="@tableImageSrc" alt="@GetTableImageAlt(imgSrc, stateName, col.Label)" class="@imageClass" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <span class="text-slate-300">—</span>
                                                }
                                                break;

                                            case "color-swatches":
                                            {
                                                var hexText = cellValue?.ToString() ?? "";
                                                var hexCodes = hexText
                                                    .Split(new[] { " / ", "/" }, StringSplitOptions.RemoveEmptyEntries)
                                                    .Select(h => h.Trim())
                                                    .Where(h => h.StartsWith("#") && h.Length >= 4)
                                                    .ToList();
                                                if (hexCodes.Any())
                                                {
                                                    <div class="flex items-center gap-1">
                                                        @foreach (var hex in hexCodes)
                                                        {
                                                            <span title="@hex"
                                                                  style="background-color: @hex;"
                                                                  class="inline-block h-6 w-8 flex-shrink-0 border border-slate-200/80"
                                                                  aria-label="@hex"></span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400 text-xs">—</span>
                                                }
                                                break;
                                            }

                                            case "link":
                                                var linkUrl = cellValue?.ToString() ?? "";
                                                if (!string.IsNullOrEmpty(linkUrl))
                                                {
                                                    <a href="@linkUrl" target="_blank" rel="nofollow noopener noreferrer"
                                                       class="row-link inline-flex items-center gap-2 text-slate-700 hover:text-slate-900 no-underline hover:no-underline">
                                                        <span class="text-xs font-semibold">Open</span>
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-400"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-300">—</span>
                                                }
                                                break;

                                            case "number":
                                                <span class="tabular-nums text-slate-900 font-semibold">
                                                    @FormatValue(cellValue, col)
                                                </span>
                                                break;

                                            case "date":
                                                <span class="text-slate-700">@FormatValue(cellValue, col)</span>
                                                break;

                                            default:
                                            {
                                                var isDetailCol = string.Equals(col.Key, Model.DetailType, StringComparison.OrdinalIgnoreCase);
                                                var text = cellValue?.ToString() ?? "—";
                                                var key  = (col.Key ?? "").ToLowerInvariant();

                                                if (key == "scientific_name" || key.Contains("scientific"))
                                                {
                                                    <span class="italic text-slate-600">@text</span>
                                                }
                                                else if (isDetailCol)
                                                {
                                                    <span class="font-semibold text-slate-900">@text</span>
                                                }
                                                else if (key == "notes" || key == "note")
                                                {
                                                    if (text == "—")
                                                    {
                                                        <span class="text-slate-300">—</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="noteTrigger inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500 transition hover:border-slate-300 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
                                                                data-note="@text"
                                                                aria-haspopup="dialog">
                                                            <i class="fa-regular fa-note-sticky text-[11px]" aria-hidden="true"></i>
                                                            <span>Note</span>
                                                        </button>
                                                    }
                                                }
                                                else if (key == "status" && row.GetString("status_url") is { Length: > 0 } statusUrl)
                                                {
                                                    <a href="@statusUrl"
                                                       target="_blank"
                                                       rel="nofollow noopener noreferrer"
                                                       class="row-link inline-flex items-center gap-1.5 font-semibold text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-blue-900">
                                                        @text
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-700">@text</span>
                                                }
                                                break;
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div id="tableEmptyState" class="hidden px-4 py-12 text-center" aria-live="polite">
            <div class="text-6xl mb-4">🔍</div>
            <h3 class="text-xl font-black text-slate-900 mb-2">No matching entries</h3>
            <p class="text-slate-600">Adjust the filter to show more entries.</p>
        </div>
    </div>
}

@functions {
    string GetTableImageAlt(string imagePath, string? stateName, string? columnLabel)
    {
        if (!string.IsNullOrWhiteSpace(stateName) && !string.IsNullOrWhiteSpace(columnLabel))
        {
            return $"{stateName} {columnLabel}".Trim();
        }

        var fileName = System.IO.Path.GetFileNameWithoutExtension(imagePath ?? string.Empty)
            .Replace('-', ' ')
            .Replace('_', ' ')
            .Trim();

        return string.IsNullOrWhiteSpace(fileName)
            ? "Table image"
            : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(fileName.ToLowerInvariant());
    }
}

@functions {
    string FormatValue(object? value, TableColumn col)
    {
        if (value == null) return "—";
        var s = value.ToString() ?? "";
        if (string.IsNullOrEmpty(s)) return "—";

        switch (col.Type)
        {
            case "number":
            case "rank":
                var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
                if (long.TryParse(s.Replace(",", "").Replace(" ", ""), out var n))
                    return n.ToString(col.Format ?? "N0", usCulture);
                if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dbl))
                    return dbl.ToString(col.Format ?? "N2", usCulture);
                return s;

            case "date":
                if (DateTime.TryParse(s, out var d))
                    return d.ToString(col.Format ?? "MMM d, yyyy");
                return s;

            default:
                return s;
        }
    }

}
