@using System.Linq
@using USASymbol.Extensions
@model USASymbol.Models.Content.PageSectionTable
@inject IImageUrlService Images

@{
    if (Model?.Rows?.Any() != true)
    {
        return;
    }

    var maxColumns = Model.Rows.Max(r => r.Cells?.Count ?? 0);
    var headers = Model.Headers?.Any() == true
        ? Model.Headers.ToList()
        : Enumerable.Range(1, maxColumns).Select(i => $"Column {i}").ToList();

    if (headers.Count < maxColumns)
    {
        headers.AddRange(Enumerable.Range(headers.Count + 1, maxColumns - headers.Count)
            .Select(i => $"Column {i}"));
    }

    var firstColumnIsState = Model.FirstColumnIsHeader &&
        headers.Count > 0 &&
        headers[0].Contains("state", StringComparison.OrdinalIgnoreCase);
}

@functions {
    private static string GetCell(USASymbol.Models.Content.PageSectionTableRow row, int index)
    {
        if (row.Cells == null || index < 0 || index >= row.Cells.Count)
        {
            return string.Empty;
        }

        return row.Cells[index] ?? string.Empty;
    }

    private static string SlugifyStateName(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;

        var normalized = value.Trim().ToLowerInvariant();
        var builder = new System.Text.StringBuilder(normalized.Length);
        var previousWasHyphen = false;

        foreach (var ch in normalized)
        {
            if (char.IsLetterOrDigit(ch))
            {
                builder.Append(ch);
                previousWasHyphen = false;
            }
            else if (!previousWasHyphen)
            {
                builder.Append('-');
                previousWasHyphen = true;
            }
        }

        return builder.ToString().Trim('-');
    }
}

<div class="overflow-hidden border border-slate-200 bg-white">
    @if (!string.IsNullOrWhiteSpace(Model.Caption))
    {
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-3 sm:px-5">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Comparison Table</p>
            <p class="mt-1 text-sm leading-6 text-slate-700">@Model.Caption.RenderMarkdown()</p>
        </div>
    }

    <div class="hidden md:block ranking-table-scroll">
        <table class="rankingTable">
            <thead>
                <tr>
                    @if (Model.ShowRowNumbers)
                    {
                        <th scope="col" class="rankingTh" data-coltype="rank">#</th>
                    }
                    @for (var i = 0; i < headers.Count; i++)
                    {
                        <th scope="col" class="rankingTh" data-coltype="@(i == 0 && firstColumnIsState ? "state-link" : "text")">
                            @headers[i]
                        </th>
                    }
                </tr>
            </thead>

            <tbody class="rankingTbody">
                @for (var rowIndex = 0; rowIndex < Model.Rows.Count; rowIndex++)
                {
                    var row = Model.Rows[rowIndex];
                    var rank = rowIndex + 1;

                    <tr class="tableRow" data-rank="@rank">
                        @if (Model.ShowRowNumbers)
                        {
                            <td class="ranking-cell" data-coltype="rank">
                                <span class="ranking-rank">@rank</span>
                            </td>
                        }
                        @for (var cellIndex = 0; cellIndex < headers.Count; cellIndex++)
                        {
                            var cell = GetCell(row, cellIndex);
                            var isFirst = cellIndex == 0;

                            if (isFirst && firstColumnIsState)
                            {
                                var stateSlug = SlugifyStateName(cell);
                                <td class="ranking-cell" data-coltype="state-link">
                                    <span class="ranking-state">
                                        @if (!string.IsNullOrWhiteSpace(stateSlug))
                                        {
                                            <img src="@Images.Thumb($"/images/flags/{stateSlug}/flag.webp")" alt=""
                                                 loading="lazy" decoding="async"
                                                 onerror="this.style.display='none'" />
                                        }
                                        <span>@cell.RenderMarkdown()</span>
                                    </span>
                                </td>
                            }
                            else if (isFirst && Model.FirstColumnIsHeader)
                            {
                                <td class="ranking-cell">
                                    <span class="ranking-primary-value">@cell.RenderMarkdown()</span>
                                </td>
                            }
                            else
                            {
                                <td class="ranking-cell">
                                    <span class="ranking-text-value">@cell.RenderMarkdown()</span>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="space-y-3 p-3 md:hidden">
        @for (var rowIndex = 0; rowIndex < Model.Rows.Count; rowIndex++)
        {
            var row = Model.Rows[rowIndex];
            var rowTitle = Model.FirstColumnIsHeader ? GetCell(row, 0) : string.Empty;
            var startIndex = Model.FirstColumnIsHeader ? 1 : 0;
            var stateSlug = firstColumnIsState ? SlugifyStateName(rowTitle) : string.Empty;

            <article class="border border-slate-200 bg-slate-50/40 p-4">
                @if (!string.IsNullOrWhiteSpace(rowTitle))
                {
                    <div class="mb-3 flex items-start gap-3 border-b border-slate-200 pb-3">
                        @if (Model.ShowRowNumbers)
                        {
                            <span class="ranking-rank mt-0.5 shrink-0">@(rowIndex + 1)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(stateSlug))
                        {
                            <img src="@Images.Thumb($"/images/flags/{stateSlug}/flag.webp")" alt=""
                                 class="mt-0.5 h-4 w-auto shrink-0 object-contain"
                                 loading="lazy" decoding="async"
                                 onerror="this.style.display='none'" />
                        }
                        <div class="min-w-0">
                            <div class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                                @(headers.Count > 0 ? headers[0] : "Row")
                            </div>
                            <div class="mt-1 text-sm font-bold leading-6 text-slate-900">
                                @rowTitle.RenderMarkdown()
                            </div>
                        </div>
                    </div>
                }

                <div class="space-y-3">
                    @for (var cellIndex = startIndex; cellIndex < headers.Count; cellIndex++)
                    {
                        var cell = GetCell(row, cellIndex);
                        <div>
                            <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">
                                @headers[cellIndex]
                            </div>
                            <div class="mt-1 text-sm font-medium leading-6 text-slate-800">
                                @cell.RenderMarkdown()
                            </div>
                        </div>
                    }
                </div>
            </article>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="border-t border-slate-200 bg-white px-4 py-3 sm:px-5">
            <p class="text-sm leading-6 text-slate-600">@Model.Note.RenderMarkdown()</p>
        </div>
    }
</div>
