@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@* Model: (IReadOnlyList<VersionDisplayItem> Items, string ImageBasePath) *@
@model (IReadOnlyList<VersionDisplayItem> Items, string ImageBasePath)
@inject IImageUrlService Images

@{
    var items    = Model.Items;
    var basePath = Model.ImageBasePath.TrimEnd('/');
    var uid      = Guid.NewGuid().ToString("N")[..8];

    string? ResolveUrl(string? img) =>
        string.IsNullOrWhiteSpace(img) ? null
        : img.StartsWith("/", StringComparison.Ordinal) ? img
        : $"{basePath}/{img.TrimStart('/')}";
}

@if (items?.Any() != true || items.Count < 2) { return; }

@{
    var count    = items.Count;
    var resolved = items.Select((v, i) => (Item: v, Index: i, IsLast: i == count - 1, Url: ResolveUrl(v.Image))).ToList();
    var current  = resolved[count - 1];
    var initial  = resolved[count - 2];
    var first    = resolved[0];
}

<div class="mt-6" id="vt-@uid">

    @* ── Mode tabs ───────────────────────────────────────── *@
    <div class="mb-4 flex gap-1">
        <button id="vt-tab-cmp-@uid" type="button"
                class="inline-flex items-center gap-1.5 border px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] transition">
            <i class="fa-solid fa-left-right text-[9px]"></i> Compare
        </button>
        <button id="vt-tab-brw-@uid" type="button"
                class="inline-flex items-center gap-1.5 border px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] transition">
            <i class="fa-solid fa-images text-[9px]"></i> Browse
        </button>
    </div>

    @* ── Compare panel ───────────────────────────────────── *@
    <div id="vt-compare-@uid">

        <div class="mb-3 grid grid-cols-2">
            <div>
                <div id="vt-before-years-@uid" class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">@initial.Item.Years</div>
                <div id="vt-before-name-@uid"  class="text-[0.8125rem] font-semibold text-slate-700">@initial.Item.Name</div>
            </div>
            <div class="text-right">
                <div class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">@current.Item.Years</div>
                <div class="text-[0.8125rem] font-semibold text-slate-700">@current.Item.Name</div>
            </div>
        </div>

        <div id="vt-cmp-@uid"
             class="relative overflow-hidden cursor-ew-resize touch-pan-y select-none"
             style="aspect-ratio:3/2;background:#1e293b">

            <img id="vt-before-img-@uid"
                 src="@(initial.Url != null ? Images.Card(initial.Url) : "")"
                 alt="@initial.Item.Name"
                 class="absolute inset-0 h-full w-full object-contain"
                 style="opacity:0.65"
                 loading="eager">

            @if (!string.IsNullOrWhiteSpace(current.Url))
            {
                <img id="vt-after-img-@uid"
                     src="@Images.Card(current.Url!)"
                     alt="@current.Item.Name"
                     class="absolute inset-0 h-full w-full object-contain"
                     style="clip-path:inset(0 0 0 50%)"
                     loading="eager">
            }

            <div id="vt-line-@uid"
                 class="pointer-events-none absolute top-0 bottom-0"
                 style="left:50%;width:2px;transform:translateX(-50%);background:rgba(255,255,255,0.9);box-shadow:0 0 0 1px rgba(0,0,0,0.15),0 2px 20px rgba(0,0,0,0.4)">
                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white shadow-md">
                    <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 20 20" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l-3 2 3 2M14 8l3 2-3 2"/>
                    </svg>
                </div>
            </div>

            <div id="vt-before-badge-@uid" class="pointer-events-none absolute bottom-2 left-2 bg-black/60 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.15em] text-white">@initial.Item.Years</div>
            <div class="pointer-events-none absolute bottom-2 right-2 bg-black/60 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.15em] text-white">@current.Item.Years</div>
        </div>

        <p class="mt-2 text-center text-[10px] text-slate-400 select-none">← Drag or tap to compare →</p>

        @if (!string.IsNullOrWhiteSpace(initial.Item.Description) || !string.IsNullOrWhiteSpace(current.Item.Description))
        {
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div id="vt-before-desc-wrap-@uid" class="border border-slate-200 p-3">
                    <div id="vt-before-desc-label-@uid" class="mb-1.5 text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">@initial.Item.Years — @initial.Item.Name</div>
                    <p id="vt-before-desc-@uid" class="text-xs leading-[1.7] text-slate-600">@(initial.Item.Description ?? "")</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(current.Item.Description))
                {
                    <div class="border border-[#d4a0a8]/60 bg-[rgba(255,246,247,0.7)] p-3">
                        <div class="mb-1.5 flex items-center gap-2">
                            <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">@current.Item.Years — @current.Item.Name</span>
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[8px] font-bold uppercase tracking-[0.1em] text-emerald-700">
                                <span class="h-1 w-1 rounded-full bg-emerald-500"></span> Current
                            </span>
                        </div>
                        <p class="text-xs leading-[1.7] text-slate-600">@current.Item.Description.RenderAutoLinks()</p>
                    </div>
                }
            </div>
        }
    </div>

    @* ── Browse panel ────────────────────────────────────── *@
    <div id="vt-browse-@uid" style="display:none">

        <div class="relative select-none" style="aspect-ratio:3/2;background:#1e293b">
            <img id="vt-brw-img-@uid"
                 src="@(first.Url != null ? Images.Card(first.Url) : "")"
                 alt="@first.Item.Name"
                 class="absolute inset-0 h-full w-full object-contain transition-opacity duration-200"
                 loading="eager">

            <button id="vt-brw-prev-@uid" type="button" disabled
                    class="absolute left-0 top-0 bottom-0 flex w-14 items-center justify-center text-white transition hover:bg-black/40 disabled:pointer-events-none disabled:opacity-0"
                    aria-label="Previous version">
                <i class="fa-solid fa-chevron-left text-lg drop-shadow-md"></i>
            </button>
            <button id="vt-brw-next-@uid" type="button"
                    class="absolute right-0 top-0 bottom-0 flex w-14 items-center justify-center text-white transition hover:bg-black/40 disabled:pointer-events-none disabled:opacity-0"
                    aria-label="Next version">
                <i class="fa-solid fa-chevron-right text-lg drop-shadow-md"></i>
            </button>

            <div id="vt-brw-badge-@uid" class="pointer-events-none absolute bottom-2 left-2 bg-black/60 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.15em] text-white">@first.Item.Years</div>
        </div>

        <div class="mt-3 flex items-baseline justify-between">
            <div>
                <div id="vt-brw-years-@uid" class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">@first.Item.Years</div>
                <div id="vt-brw-name-@uid"  class="text-[0.8125rem] font-semibold text-slate-700">@first.Item.Name</div>
            </div>
            <div id="vt-brw-counter-@uid" class="text-[9px] font-bold tabular-nums text-slate-400">1 / @count</div>
        </div>

        <div id="vt-brw-desc-wrap-@uid" class="mt-2 border border-slate-200 p-3" style="@(string.IsNullOrWhiteSpace(first.Item.Description) ? "display:none" : "")">
            <p id="vt-brw-desc-@uid" class="text-xs leading-[1.7] text-slate-600">@(first.Item.Description ?? "")</p>
        </div>
    </div>

    @* ── Thumbnail strip (shared) ─────────────────────── *@
    <div class="relative mt-5">
        <p class="mb-2 text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">All versions</p>
        <div class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:thin" id="vt-strip-@uid">
            @foreach (var entry in resolved)
            {
                var thumbSrc   = entry.Url != null ? Images.Card(entry.Url) : "";
                var isSelected = entry.Index == initial.Index;
                var isCurrent  = entry.IsLast;

                <button type="button"
                        class="vt-thumb shrink-0 overflow-hidden border-2 transition-all duration-150 @(isSelected ? "border-slate-900" : "border-slate-200 opacity-60 hover:opacity-90 hover:border-slate-400") @(isCurrent ? "ring-1 ring-emerald-400 ring-offset-1" : "")"
                        style="width:88px"
                        data-src="@thumbSrc"
                        data-name="@entry.Item.Name"
                        data-years="@entry.Item.Years"
                        data-desc="@(entry.Item.Description ?? "")"
                        data-index="@entry.Index"
                        data-is-current="@entry.IsLast.ToString().ToLowerInvariant()">
                    <div style="aspect-ratio:3/2;background:#1e293b">
                        @if (!string.IsNullOrWhiteSpace(thumbSrc))
                        {
                            <img src="@thumbSrc" alt="@entry.Item.Name"
                                 class="h-full w-full object-contain"
                                 style="@(isCurrent ? "" : "opacity:0.8")"
                                 loading="lazy">
                        }
                    </div>
                    <div class="bg-white px-1.5 py-1 text-center">
                        <span class="block truncate text-[8px] font-bold uppercase tracking-[0.08em] @(isCurrent ? "text-emerald-700" : "text-slate-500")">
                            @(isCurrent ? "Current" : entry.Item.Years)
                        </span>
                    </div>
                </button>
            }
        </div>
        <div class="pointer-events-none absolute right-0 top-0 bottom-1 w-10 bg-gradient-to-l from-white to-transparent" aria-hidden="true"></div>
    </div>

</div>

<script>
(function () {
    var uid   = '@uid';
    var COUNT = @count;
    var INIT_CMP_IDX = @(count - 2);

    var mode       = 'browse';
    var browseIdx  = 0;
    var cmpBefIdx  = INIT_CMP_IDX;

    // Panels
    var tabCmp   = document.getElementById('vt-tab-cmp-' + uid);
    var tabBrw   = document.getElementById('vt-tab-brw-' + uid);
    var panelCmp = document.getElementById('vt-compare-' + uid);
    var panelBrw = document.getElementById('vt-browse-' + uid);

    // Compare elements
    var wrap     = document.getElementById('vt-cmp-' + uid);
    var afterImg = document.getElementById('vt-after-img-' + uid);
    var befImg   = document.getElementById('vt-before-img-' + uid);
    var line     = document.getElementById('vt-line-' + uid);
    var befYears = document.getElementById('vt-before-years-' + uid);
    var befName  = document.getElementById('vt-before-name-' + uid);
    var befBadge = document.getElementById('vt-before-badge-' + uid);
    var befDescL = document.getElementById('vt-before-desc-label-' + uid);
    var befDesc  = document.getElementById('vt-before-desc-' + uid);

    // Browse elements
    var brwImg     = document.getElementById('vt-brw-img-' + uid);
    var brwPrev    = document.getElementById('vt-brw-prev-' + uid);
    var brwNext    = document.getElementById('vt-brw-next-' + uid);
    var brwYears   = document.getElementById('vt-brw-years-' + uid);
    var brwName    = document.getElementById('vt-brw-name-' + uid);
    var brwDesc    = document.getElementById('vt-brw-desc-' + uid);
    var brwDescW   = document.getElementById('vt-brw-desc-wrap-' + uid);
    var brwBadge   = document.getElementById('vt-brw-badge-' + uid);
    var brwCounter = document.getElementById('vt-brw-counter-' + uid);

    var thumbs = Array.from(document.querySelectorAll('#vt-strip-' + uid + ' .vt-thumb'));
    var strip  = document.getElementById('vt-strip-' + uid);

    // ── Tab switching ─────────────────────────────────────
    var S_ACTIVE   = 'background:#0f172a;color:#fff;border-color:#0f172a';
    var S_INACTIVE = 'background:#fff;color:#475569;border-color:#e2e8f0';

    function setMode(m) {
        mode = m;
        var isCmp = m === 'compare';
        panelCmp.style.display = isCmp ? '' : 'none';
        panelBrw.style.display = isCmp ? 'none' : '';
        tabCmp.style.cssText   = isCmp ? S_ACTIVE : S_INACTIVE;
        tabBrw.style.cssText   = isCmp ? S_INACTIVE : S_ACTIVE;
        highlightThumbs();
    }

    tabCmp.addEventListener('click', function () { setMode('compare'); });
    tabBrw.addEventListener('click', function () { setMode('browse'); });

    // ── Compare: drag slider ──────────────────────────────
    if (wrap && afterImg && line) {
        var active = false;
        function move(x) {
            var r = wrap.getBoundingClientRect();
            var p = Math.max(0, Math.min(100, (x - r.left) / r.width * 100));
            afterImg.style.clipPath = 'inset(0 0 0 ' + p + '%)';
            line.style.left = p + '%';
        }
        wrap.addEventListener('mousedown', function (e) { active = true; move(e.clientX); });
        document.addEventListener('mouseup', function () { active = false; });
        document.addEventListener('mousemove', function (e) { if (active) move(e.clientX); });
        wrap.addEventListener('touchstart', function (e) { active = true; move(e.touches[0].clientX); }, { passive: true });
        document.addEventListener('touchend', function () { active = false; });
        document.addEventListener('touchmove', function (e) { if (active) move(e.touches[0].clientX); }, { passive: true });
    }

    // ── Browse: navigate ──────────────────────────────────
    function setBrowse(idx) {
        browseIdx = Math.max(0, Math.min(COUNT - 1, idx));
        var t = thumbs[browseIdx];
        if (!t) return;
        var src   = t.dataset.src   || '';
        var name  = t.dataset.name  || '';
        var years = t.dataset.years || '';
        var desc  = t.dataset.desc  || '';

        if (brwImg) {
            brwImg.style.opacity = '0';
            var _s = src, _n = name;
            setTimeout(function () { brwImg.src = _s; brwImg.alt = _n; brwImg.style.opacity = '1'; }, 120);
        }
        if (brwYears)   brwYears.textContent   = years;
        if (brwName)    brwName.textContent    = name;
        if (brwDesc)    brwDesc.textContent    = desc;
        if (brwBadge)   brwBadge.textContent   = years;
        if (brwCounter) brwCounter.textContent = (browseIdx + 1) + ' / ' + COUNT;
        if (brwDescW)   brwDescW.style.display = desc ? '' : 'none';
        if (brwPrev)    brwPrev.disabled        = browseIdx === 0;
        if (brwNext)    brwNext.disabled        = browseIdx === COUNT - 1;
        highlightThumbs();
    }

    if (brwPrev) brwPrev.addEventListener('click', function () { setBrowse(browseIdx - 1); });
    if (brwNext) brwNext.addEventListener('click', function () { setBrowse(browseIdx + 1); });

    // ── Thumbnail highlight ───────────────────────────────
    function highlightThumbs() {
        var activeIdx = mode === 'compare' ? cmpBefIdx : browseIdx;
        thumbs.forEach(function (t, i) {
            var isCur    = t.dataset.isCurrent === 'true';
            var isActive = i === activeIdx;
            t.style.borderColor = isActive ? '#0f172a' : '#e2e8f0';
            t.style.opacity     = (isActive || isCur) ? '1' : '0.6';
        });
    }

    // ── Thumbnail clicks ──────────────────────────────────
    thumbs.forEach(function (t, i) {
        t.addEventListener('click', function () {
            if (mode === 'compare') {
                if (t.dataset.isCurrent === 'true') return;
                cmpBefIdx = i;
                if (befImg) {
                    befImg.style.opacity = '0';
                    var _s = t.dataset.src || '', _n = t.dataset.name || '';
                    setTimeout(function () { befImg.src = _s; befImg.alt = _n; befImg.style.opacity = '0.65'; }, 120);
                }
                if (befYears) befYears.textContent = t.dataset.years || '';
                if (befName)  befName.textContent  = t.dataset.name  || '';
                if (befBadge) befBadge.textContent = t.dataset.years || '';
                if (befDescL) befDescL.textContent = (t.dataset.years || '') + ' — ' + (t.dataset.name || '');
                if (befDesc)  befDesc.textContent  = t.dataset.desc  || '';
                if (afterImg) afterImg.style.clipPath = 'inset(0 0 0 50%)';
                if (line)     line.style.left = '50%';
                highlightThumbs();
            } else {
                setBrowse(i);
            }
        });
    });

    // ── Fade right ────────────────────────────────────────
    var fade = strip && strip.parentElement ? strip.parentElement.querySelector('[aria-hidden="true"]') : null;
    if (strip && fade) {
        function updateFade() { fade.style.opacity = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4 ? '0' : '1'; }
        strip.addEventListener('scroll', updateFade, { passive: true });
        updateFade();
    }

    // Init
    setMode('browse');
    setBrowse(0);
})();
</script>
