@using USASymbol.Extensions
@model IEnumerable<string>

@{
    var factsHtml = Model
        .Select(f => (f ?? "").RenderListItem().Value ?? "")
        .Where(f => !string.IsNullOrWhiteSpace(f))
        .ToList();
    var factsId = "facts-" + Guid.NewGuid().ToString("N");
    var factsTitle = ViewData["FactsTitle"] as string;
    var factsEyebrow = ViewData["FactsEyebrow"] as string;
    var factsAccent = ViewData["FactsAccent"] as string;
    var accentClass = string.Equals(factsAccent, "amber", StringComparison.OrdinalIgnoreCase)
        ? "from-amber-500 to-orange-500"
        : "from-slate-700 to-slate-900";
    var showControls = factsHtml.Count > 1;
}

@if (factsHtml.Any())
{
    <aside class="mt-8 clear-both border border-slate-200 bg-white text-slate-900">
        <div class="border-b border-slate-200 px-4 py-3 sm:px-5">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                    @if (!string.IsNullOrWhiteSpace(factsEyebrow))
                    {
                        <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">
                            @factsEyebrow
                        </div>
                    }
                    <h3 class="@(string.IsNullOrWhiteSpace(factsEyebrow) ? "text-sm" : "mt-1 text-base") font-semibold leading-6 text-slate-900">
                        @(string.IsNullOrWhiteSpace(factsTitle) ? "Key Facts" : factsTitle)
                    </h3>
                </div>

                @if (showControls)
                {
                    <div id="factCounter-@factsId" class="shrink-0 text-[11px] font-semibold tabular-nums text-slate-500">
                        1 / @factsHtml.Count
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-4 sm:px-5">
            <div class="border-l-4 border-amber-600 pl-4">
                <div class="min-h-[64px] text-[1rem] leading-7 text-slate-800 transition-opacity duration-200" id="factText-@factsId">
                    @Html.Raw(factsHtml.First())
                </div>
            </div>

            @if (showControls)
            {
                <div class="mt-4 flex justify-end">
                    <button id="nextFactBtn-@factsId"
                            type="button"
                            class="inline-flex min-h-[38px] items-center gap-2 border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-900 hover:text-slate-900">
                        <span>Next fact</span>
                        <i class="fa-solid fa-arrow-right text-[11px]" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
    </aside>
}

<script>
    (function () {
        const facts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(factsHtml));
        let idx = 0;
        const textEl = document.getElementById('factText-@factsId');
        const counterEl = document.getElementById('factCounter-@factsId');
        const nextBtn = document.getElementById('nextFactBtn-@factsId');

        if (!textEl || !nextBtn || facts.length < 2) return;

        nextBtn.addEventListener('click', () => {
            idx = (idx + 1) % facts.length;
            textEl.style.opacity = 0;
            setTimeout(() => {
                textEl.innerHTML = facts[idx];
                textEl.style.opacity = 1;
                if (counterEl) counterEl.textContent = (idx + 1) + " / " + facts.length;
            }, 150);
        });
    })();
</script>
