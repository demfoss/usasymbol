@using USASymbol.Extensions
@model IEnumerable<string>

@{
    var factsHtml = Model.Select(f => (f ?? "").RenderListItem().Value ?? "").ToList();
    var factsId = "facts-" + Guid.NewGuid().ToString("N");
}

<aside class="mt-10 bg-slate-900 rounded-3xl p-6 lg:p-8 text-white relative overflow-hidden clear-both">
    <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-3xl"></div>
    <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold uppercase text-white/50 tracking-widest">Fact Check</span>
            <span class="text-[10px] font-mono text-white/30" id="factCounter-@factsId">1 / @factsHtml.Count</span>
        </div>

        <div class="min-h-[50px] flex items-center text-lg font-medium italic text-slate-100" id="factText-@factsId">@Html.Raw(factsHtml.First())</div>

        <div class="mt-6 flex justify-end">
            <button id="nextFactBtn-@factsId" class="px-4 py-2 bg-white text-slate-900 rounded-full font-bold text-xs hover:bg-slate-100 transition-all active:scale-95">Next</button>
        </div>
    </div>
</aside>

<script>
    (function () {
        const facts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(factsHtml));
        let idx = 0;
        const t = document.getElementById('factText-@factsId');
        const c = document.getElementById('factCounter-@factsId');

        document.getElementById('nextFactBtn-@factsId').addEventListener('click', () => {
            idx = (idx + 1) % facts.length;
            t.style.opacity = 0;
            setTimeout(() => {
                t.innerHTML = facts[idx];
                t.style.opacity = 1;
                c.textContent = (idx + 1) + " / " + facts.length;
            }, 150);
        });
    })();
</script>