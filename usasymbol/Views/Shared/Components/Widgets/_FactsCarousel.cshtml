@using USASymbol.Extensions
@model IEnumerable<string>

@{
    var factsHtml = Model
        .Select(f => (f ?? "").RenderListItem().Value ?? "")
        .Where(f => !string.IsNullOrWhiteSpace(f))
        .ToList();

    if (!factsHtml.Any()) { return; }

    var factsId     = "fc-" + Guid.NewGuid().ToString("N")[..8];
    var factsTitle  = ViewData["FactsTitle"]   as string;
    var factsEyebrow = ViewData["FactsEyebrow"] as string;
}

<aside class="mt-8 clear-both">
    <div class="mb-4 flex items-center gap-2 border-b border-slate-200 pb-3">
        <i class="fa-solid fa-lightbulb text-amber-500 text-sm" aria-hidden="true"></i>
        @if (!string.IsNullOrWhiteSpace(factsEyebrow))
        {
            <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">@factsEyebrow</span>
        }
        <h3 class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(factsTitle) ? "Key Facts" : factsTitle)</h3>
    </div>

    <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2" id="@factsId">
        @for (var i = 0; i < factsHtml.Count; i++)
        {
            <li class="m-0 flex items-start gap-3 rounded-lg border border-slate-200 border-l-4 border-l-amber-400 bg-white p-4">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-50 text-[11px] font-bold text-amber-600" aria-hidden="true">@(i + 1)</span>
                <div class="min-w-0 text-sm leading-[1.65] text-slate-700">@Html.Raw(factsHtml[i])</div>
            </li>
        }
    </ul>
</aside>
