@using USASymbol.Extensions
@model IEnumerable<string>

@{
    var factsHtml = Model
        .Select(f => (f ?? "").RenderListItem().Value ?? "")
        .Where(f => !string.IsNullOrWhiteSpace(f))
        .ToList();

    if (!factsHtml.Any()) { return; }

    var factsId     = "fc-" + Guid.NewGuid().ToString("N")[..8];
    var factsTitle  = ViewData["FactsTitle"]   as string;
    var factsEyebrow = ViewData["FactsEyebrow"] as string;
}

<aside class="mt-8 clear-both">
    <div class="mb-4 flex items-center gap-2 border-b border-slate-200 pb-3">
        <i class="fa-solid fa-lightbulb text-amber-500 text-sm" aria-hidden="true"></i>
        @if (!string.IsNullOrWhiteSpace(factsEyebrow))
        {
            <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">@factsEyebrow</span>
        }
        <h3 class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(factsTitle) ? "Key Facts" : factsTitle)</h3>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2" id="@factsId">
        @for (var i = 0; i < factsHtml.Count; i++)
        {
            var cardId   = $"{factsId}-c{i}";
            var fullText = factsHtml[i];

            @* Front: first sentence or first 90 chars *@
            var dotIdx      = fullText.IndexOf(". ");
            var previewHtml = dotIdx > 15 && dotIdx < fullText.Length - 4
                ? fullText[..dotIdx] + "."
                : fullText.Length > 90 ? fullText[..87] + "…" : fullText;

            @* CSS-Grid stacking: both faces share grid-area 1/1 so the card grows
               to fit the taller face — no JS height measurement needed. *@
            <div class="fc-card cursor-pointer" style="perspective:1000px">
                <div id="@cardId"
                     class="fc-inner"
                     style="display:grid;transform-style:preserve-3d;transition:transform 0.45s cubic-bezier(.4,0,.2,1)">

                    @* Front face *@
                    <div class="flex flex-col gap-2 border border-slate-200 bg-white p-4"
                         style="grid-area:1/1;backface-visibility:hidden;-webkit-backface-visibility:hidden">
                        <div class="flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">
                            <i class="fa-solid fa-lightbulb text-amber-400" aria-hidden="true"></i>
                            Did you know?
                        </div>
                        <div class="flex-1 text-sm leading-[1.65] text-slate-700">@Html.Raw(previewHtml)</div>
                        <div class="flex items-center gap-1 text-[9px] font-semibold text-slate-400">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
                            Tap to reveal
                        </div>
                    </div>

                    @* Back face — rotated 180 °, hidden until card flips *@
                    <div class="flex flex-col gap-2 border border-amber-200 bg-amber-50/70 p-4"
                         style="grid-area:1/1;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)">
                        <div class="flex-1 text-sm leading-[1.7] text-slate-800">@Html.Raw(fullText)</div>
                        <div class="flex items-center gap-1 text-[9px] font-semibold text-slate-400">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
                            Tap to flip back
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</aside>

<script>
(function () {
    var container = document.getElementById('@factsId');
    if (!container) return;

    container.addEventListener('click', function (e) {
        var card = e.target.closest('.fc-card');
        if (!card) return;
        var inner = card.querySelector('.fc-inner');
        if (!inner) return;
        var flipped = inner.dataset.flipped === '1';
        inner.style.transform = flipped ? '' : 'rotateY(180deg)';
        inner.dataset.flipped  = flipped ? '0' : '1';
    });
})();
</script>
