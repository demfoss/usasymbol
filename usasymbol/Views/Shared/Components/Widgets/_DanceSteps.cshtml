@using USASymbol.Models.Content
@using USASymbol.Extensions
@model List<DanceStep>

@{
    var steps = (Model ?? new List<DanceStep>())
        .Where(s => !string.IsNullOrWhiteSpace(s.Title) || !string.IsNullOrWhiteSpace(s.Description))
        .ToList();

    if (!steps.Any()) { return; }
}

<ol class="dance-steps my-8 clear-both">
    @for (var i = 0; i < steps.Count; i++)
    {
        var step = steps[i];
        var isLast = i == steps.Count - 1;
        <li class="dance-step relative flex gap-5 @(isLast ? "" : "pb-8")">
            @if (!isLast)
            {
                <span class="absolute left-[19px] top-10 bottom-0 w-px bg-gradient-to-b from-pink-300 to-pink-100" aria-hidden="true"></span>
            }
            <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-pink-600 text-base font-bold text-white shadow-[0_2px_8px_-2px_rgba(219,39,119,0.5)]">
                @(i + 1)
            </span>
            <div class="min-w-0 flex-1 border border-pink-100 bg-pink-50/40 p-4 sm:p-5">
                @if (!string.IsNullOrWhiteSpace(step.Title))
                {
                    <p class="text-base font-semibold text-slate-900 sm:text-lg">@step.Title</p>
                }
                @if (!string.IsNullOrWhiteSpace(step.Description))
                {
                    <p class="mt-1.5 text-sm leading-6 text-slate-700 sm:text-[15px]">@step.Description.RenderAutoLinks()</p>
                }
            </div>
        </li>
    }
</ol>
