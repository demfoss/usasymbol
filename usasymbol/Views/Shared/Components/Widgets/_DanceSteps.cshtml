@using USASymbol.Models.Content
@using USASymbol.Extensions
@model List<DanceStep>

@{
    var steps = (Model ?? new List<DanceStep>())
        .Where(s => !string.IsNullOrWhiteSpace(s.Title) || !string.IsNullOrWhiteSpace(s.Description))
        .ToList();

    if (!steps.Any()) { return; }
}

<ol class="my-6 space-y-4 clear-both">
    @for (var i = 0; i < steps.Count; i++)
    {
        var step = steps[i];
        <li class="flex gap-4 border border-slate-200 bg-white p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
                @(i + 1)
            </span>
            <div class="min-w-0">
                @if (!string.IsNullOrWhiteSpace(step.Title))
                {
                    <p class="font-semibold text-slate-900">@step.Title</p>
                }
                @if (!string.IsNullOrWhiteSpace(step.Description))
                {
                    <p class="mt-1 text-sm leading-6 text-slate-700">@step.Description.RenderAutoLinks()</p>
                }
            </div>
        </li>
    }
</ol>
