@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@* Model: (IReadOnlyList<SymbolDisplayItem> Items, string ImageBasePath) *@
@model (IReadOnlyList<SymbolDisplayItem> Items, string ImageBasePath)
@inject IImageUrlService Images

@{
    var items    = Model.Items;
    var basePath = Model.ImageBasePath.TrimEnd('/');
}

@if (items?.Any() == true)
{
    <div class="law-cards mt-6">

        @foreach (var symbol in items)
        {
            var imageUrl = string.IsNullOrWhiteSpace(symbol.Image)
                ? null
                : symbol.Image.StartsWith("/", StringComparison.Ordinal)
                    ? symbol.Image
                    : $"{basePath}/{symbol.Image.TrimStart('/')}";
            var hasImage  = !string.IsNullOrWhiteSpace(imageUrl);
            var firstPara = symbol.Paragraphs?.FirstOrDefault() ?? "";

            <article class="law-card">
                <div class="law-card__layout">

                    @* ── Media panel ─────────────────────────── *@
                    @if (hasImage)
                    {
                        <div class="law-card__media" style="background:#0f172a">
                            <img src="@Images.Card(imageUrl!)"
                                 alt="@symbol.Name"
                                 class="law-card__image"
                                 style="object-fit:contain;padding:1.25rem"
                                 loading="lazy">
                        </div>
                    }
                    else
                    {
                        <div class="law-card__media law-card__media--fallback" style="background:#0f172a">
                            <div class="law-card__fallback">
                                <span class="law-card__fallback-icon">
                                    <i class="fa-solid fa-shapes text-lg" aria-hidden="true"></i>
                                </span>
                            </div>
                        </div>
                    }

                    @* ── Content panel ────────────────────────── *@
                    <div class="law-card__content">
                        <h3 class="law-card__title">@symbol.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(firstPara))
                        {
                            <div class="law-card__body">
                                <p style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden">
                                    @firstPara.RenderAutoLinks()
                                </p>
                            </div>
                        }
                    </div>

                </div>
            </article>
        }

    </div>
}
