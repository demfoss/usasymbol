@using USASymbol.Models.Content
@model List<SecondarySong>

@{
    var songs = (Model ?? new List<SecondarySong>())
        .Where(s => !string.IsNullOrWhiteSpace(s.Name))
        .ToList();

    if (!songs.Any()) { return; }
}

<div class="my-6 overflow-x-auto border border-slate-200 clear-both">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
            <tr>
                <th scope="col" class="px-4 py-2.5 text-left font-semibold text-slate-700">Song</th>
                <th scope="col" class="px-4 py-2.5 text-left font-semibold text-slate-700">Designation</th>
                <th scope="col" class="px-4 py-2.5 text-left font-semibold text-slate-700">Writer</th>
                <th scope="col" class="px-4 py-2.5 text-left font-semibold text-slate-700">Year</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var song in songs)
            {
                var writer = string.Join(" / ", new[] { song.Composer, song.Lyricist }
                    .Where(w => !string.IsNullOrWhiteSpace(w)));

                <tr>
                    <td class="px-4 py-2.5 font-medium text-slate-900">@song.Name</td>
                    <td class="px-4 py-2.5 text-slate-600">@song.Designation</td>
                    <td class="px-4 py-2.5 text-slate-600">@(string.IsNullOrWhiteSpace(writer) ? "N/A" : writer)</td>
                    <td class="px-4 py-2.5 text-slate-600">@song.Year</td>
                </tr>
            }
        </tbody>
    </table>
</div>
