@using USASymbol.Extensions
@model (string Title, string Text)

<div class="relative overflow-hidden rounded-[18px] border border-amber-200/70 bg-[linear-gradient(180deg,rgba(255,251,243,0.96),rgba(255,255,255,0.98))] px-6 py-7 text-center shadow-[0_18px_48px_-36px_rgba(148,86,33,0.28)] sm:px-8 lg:px-10 lg:py-8">
    <div class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,rgba(217,119,6,0),rgba(217,119,6,0.48),rgba(217,119,6,0))]"></div>
    <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-amber-700/70 block mb-3">Meaning</span>
    <h2 class="text-[1.7rem] font-semibold leading-[1.15] text-slate-900 mx-auto max-w-2xl sm:text-[1.95rem] lg:text-[2.1rem]">@Model.Title</h2>
    <p class="mt-4 text-[1.05rem] leading-8 text-slate-700 mx-auto max-w-3xl">@Model.Text.RenderAutoLinks()</p>
</div>
