@using USASymbol.Models.Content
@model ExpertQuoteData

<section class="py-10">
    <figure class="rounded-[1.95rem] bg-[linear-gradient(180deg,rgba(248,250,252,0.84),rgba(255,255,255,0.98))] p-8 text-center shadow-[0_28px_54px_-38px_rgba(15,23,42,0.28)] lg:p-12">
        <blockquote class="text-xl lg:text-2xl text-slate-900 font-medium italic leading-relaxed mb-6">"@Model.Text"</blockquote>
        <figcaption class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">— @Model.Source</figcaption>
    </figure>
</section>
