@using System.Text.Json
@using System.Text.Json.Serialization
@model Usasymbol.ViewModels.MapBlockViewModel
@inject IImageUrlService Images

@{
    const string baseUrl = "https://usasymbol.com";
    var title   = string.IsNullOrWhiteSpace(Model?.Title) ? "Map" : Model.Title;
    var alt     = string.IsNullOrWhiteSpace(Model?.ImageAlt) ? title : Model.ImageAlt;
    var hasSvg      = Model?.HasChoropleth == true;
    var hasImg      = !string.IsNullOrWhiteSpace(Model?.Image);
    var hasGenImg   = !string.IsNullOrWhiteSpace(Model?.GeneratedImagePath);
    var generatedImageUrl = hasGenImg
        ? (Model!.GeneratedImagePath!.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.GeneratedImagePath
            : $"{baseUrl}{Model.GeneratedImagePath}")
        : null;
    var seoImageUrl = hasImg      ? Images.Full(Model!.Image)
                    : hasGenImg   ? generatedImageUrl
                    : null;

    string choroplethJson = "{}";
    string filterGroupsJson = "[]";
    var smallStateRight = new[] { "VT", "NH", "MA", "RI", "CT", "NJ", "DE", "MD", "DC" };
    var smallStateLeft = new[] { "HI" };
    if (hasSvg && Model?.Entries?.Count > 0)
    {
        var opts = new JsonSerializerOptions
        {
            PropertyNamingPolicy        = JsonNamingPolicy.CamelCase,
            DefaultIgnoreCondition      = JsonIgnoreCondition.WhenWritingNull,
        };
        var dict = Model.Entries.ToDictionary(
            e => e.PostalCode,
            e => (object)new
            {
                n = e.StateName,
                s = e.StateSlug,
                v = e.DisplayValue,
                r = e.Rank,
                f = e.FillColor,
                nv = e.NumericValue,
                summary = e.Summary,
                details = e.Details.Select(d => new { l = d.Label, v = d.Value, g = d.Group }),
                filters = e.Filters,
                img = string.IsNullOrWhiteSpace(e.ImageUrl) ? null : Images.Card(e.ImageUrl, 160),
                flag = string.IsNullOrWhiteSpace(e.FlagImageUrl) ? null : Images.Thumb(e.FlagImageUrl),
                items = e.Items?.Select(item => new
                {
                    v = item.DisplayValue,
                    details = item.Details.Select(d => new { l = d.Label, v = d.Value }),
                    img = string.IsNullOrWhiteSpace(item.ImageUrl) ? null : Images.Card(item.ImageUrl, 160)
                })
            }
        );
        choroplethJson = JsonSerializer.Serialize(dict, opts);
        filterGroupsJson = JsonSerializer.Serialize(Model.FilterGroups, opts);
    }
}

<section id="choropleth-map"
         class="map-block map-block--fullbleed scroll-mt-24"
         aria-labelledby="map-block-title">

    <header class="mb-5 sm:mb-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Map</p>
        <h2 id="map-block-title" class="mt-1 text-2xl md:text-3xl font-semibold tracking-tight text-slate-900">
            @title
        </h2>
    </header>

    @if (hasSvg)
    {
        @if (!string.IsNullOrEmpty(Model!.ColorCss))
        {
            <style>@Html.Raw(Model.ColorCss)</style>
        }
        <div class="map-block__shell">
            <div id="map-filter-groups" class="map-filters" aria-label="Map filters"></div>

            <div class="relative min-w-0 max-w-full" id="usmap-wrapper">
                <div class="map-small-states map-small-states--left" id="map-small-states-left">
                    @foreach (var code in smallStateLeft.Where(code => Model.Entries.Any(entry => entry.PostalCode == code)))
                    {
                        var entry = Model.Entries.First(e => e.PostalCode == code);
                        <button type="button"
                                class="map-small-state"
                                data-state-key="@entry.PostalCode"
                                style="--state-fill:@entry.FillColor">
                            @entry.PostalCode
                        </button>
                    }
                </div>

                <div id="usmap-container"
                     class="relative min-w-0 max-w-full overflow-hidden select-none bg-slate-100 shadow-none [&_svg]:block [&_svg]:h-full [&_svg]:w-full [&_svg]:max-w-full"
                     style="aspect-ratio:959/593;min-height:320px"
                     data-svg-src="/maps/us-states.svg"
                     role="img"
                     aria-label="@alt">
                </div>

                <div class="map-small-states map-small-states--right" id="map-small-states-right">
                    @foreach (var code in smallStateRight.Where(code => Model.Entries.Any(entry => entry.PostalCode == code)))
                    {
                        var entry = Model.Entries.First(e => e.PostalCode == code);
                        <button type="button"
                                class="map-small-state"
                                data-state-key="@entry.PostalCode"
                                style="--state-fill:@entry.FillColor">
                            @entry.PostalCode
                        </button>
                    }
                </div>

                <div id="map-tooltip" class="pointer-events-none absolute z-20 hidden" role="tooltip" aria-live="polite">
                    <div class="map-tooltip-card">
                        <p id="tt-state" class="map-tooltip__state"></p>
                        <div class="map-tooltip__status-row">
                            <span id="tt-status-dot" class="map-tooltip__dot" aria-hidden="true"></span>
                            <span id="tt-value" class="map-tooltip__status"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="map-search" id="map-search">
                <div class="map-search__field">
                    <i class="fa-solid fa-magnifying-glass map-search__icon" aria-hidden="true"></i>
                    <input id="map-search-input"
                           class="map-search__input"
                           type="text"
                           placeholder="Search State or Territory"
                           autocomplete="off"
                           aria-label="Search state or territory"
                           aria-expanded="false"
                           aria-controls="map-search-results" />
                </div>
                <div id="map-search-results" class="map-search__results hidden" role="listbox" aria-label="States"></div>
            </div>

            <button type="button" id="map-clear-filters" class="map-clear-btn hidden" aria-label="Clear all map filters">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                Clear Filters
            </button>

            <div id="map-drawer-backdrop" class="map-drawer-backdrop hidden"></div>
            <aside id="map-drawer" class="map-drawer" aria-hidden="true" aria-labelledby="map-drawer-state">
                <div class="map-drawer__inner">
                    <button type="button" id="map-drawer-close" class="map-drawer__close" aria-label="Close state details">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                    <div class="map-drawer__body">
                        <div class="map-drawer__hero">
                            <div id="drawer-rank" class="map-drawer__rank hidden"></div>
                            <img id="drawer-flag" class="map-drawer__flag hidden" alt="" loading="lazy" decoding="async" />
                            <h3 id="map-drawer-state" class="map-drawer__title"></h3>
                            <div class="map-drawer__status-row">
                                <span id="drawer-status-dot" class="map-tooltip__dot" aria-hidden="true"></span>
                                <span id="drawer-value" class="map-drawer__status"></span>
                            </div>
                        </div>
                        <p id="drawer-summary" class="map-drawer__summary hidden"></p>
                        <div id="drawer-details" class="map-drawer__details hidden"></div>
                        <div id="drawer-items" class="map-drawer__items hidden"></div>
                        <div id="drawer-state-info" class="map-drawer__state-info hidden"></div>
                    </div>
                    <div class="map-drawer__footer">
                        <a id="drawer-view-link" href="#" class="map-drawer__link">View State</a>
                    </div>
                </div>
            </aside>
        </div>

        @* ── LEGEND ── *@
        @if (Model.IsNumeric && Model.LegendSteps.Count > 0)
        {
            <div class="mt-4 flex flex-wrap items-center gap-x-1 gap-y-2"
                 id="map-legend"
                 aria-label="Map legend">
                @if (!string.IsNullOrEmpty(Model.MetricLabel))
                {
                    <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-400 mr-2 self-end pb-0.5">@Model.MetricLabel</span>
                }
                @for (int si = 0; si < Model.LegendSteps.Count; si++)
                {
                    var step = Model.LegendSteps[si];
                    <button type="button"
                            class="map-legend-step"
                            data-step-index="@si"
                            aria-pressed="false">
                        <span class="map-legend-step__swatch" style="background:@step.Color"></span>
                        <span class="map-legend-step__label tabular-nums">@step.Label</span>
                    </button>
                }
                <div class="flex flex-col items-center gap-0.5 ml-2">
                    <span class="inline-block h-3 w-8 border border-slate-300 bg-[#e2e8f0] flex-shrink-0" aria-hidden="true"></span>
                    <span class="text-[10px] text-slate-400">No data</span>
                </div>
            </div>
        }
        else if (!Model.IsNumeric && Model.LegendSteps.Count > 0)
        {
            @* Categorical legend: only rendered when colors mark real groups
               shared by more than one state, so it stays a handful of items
               instead of a 50-line wall of text. *@
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Map legend">
                @if (!string.IsNullOrEmpty(Model.MetricLabel))
                {
                    <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-400">@Model.MetricLabel</span>
                }
                @foreach (var step in Model.LegendSteps)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="inline-block h-2.5 w-2.5 rounded-full flex-shrink-0"
                              style="background:@step.Color" aria-hidden="true"></span>
                        <span class="text-[12px] font-medium text-slate-600">@step.Label</span>
                    </div>
                }
            </div>
        }
        @* ── JSON for tooltip JS (embedded in HTML, server-rendered) ── *@
        <script type="application/json"
                id="choropleth-data"
                data-metric-label="@Model.MetricLabel"
                data-text-overlay="@Model.ShowTextOverlay.ToString().ToLowerInvariant()">@Html.Raw(choroplethJson)</script>
        <script type="application/json" id="map-filter-groups-data">@Html.Raw(filterGroupsJson)</script>

        @* ── SEO layer: visually hidden table + static image for Google crawler ── *@
        <div class="sr-only">
            @if (seoImageUrl != null)
            {
                <figure itemscope itemtype="https://schema.org/ImageObject">
                    <img src="@seoImageUrl"
                         alt="@alt"
                         loading="eager"
                         decoding="async"
                         itemprop="url" />
                    <meta itemprop="contentUrl" content="@seoImageUrl" />
                    @if (!string.IsNullOrWhiteSpace(Model!.Caption))
                    {
                        <figcaption itemprop="caption">@Model.Caption</figcaption>
                    }
                </figure>
            }
            <table>
                <caption>@title</caption>
                <thead>
                    <tr>
                        @if (Model.Entries.Any(e => e.Rank.HasValue)) { <th scope="col">Rank</th> }
                        <th scope="col">State</th>
                        <th scope="col">@(string.IsNullOrEmpty(Model.MetricLabel) ? "Value" : Model.MetricLabel)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries.OrderBy(e => e.Rank ?? 999))
                    {
                        <tr>
                            @if (Model.Entries.Any(e => e.Rank.HasValue)) { <td>@entry.Rank</td> }
                            <td>@entry.StateName</td>
                            <td>@entry.DisplayValue</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Caption *@
        @if (!string.IsNullOrWhiteSpace(Model.Caption))
        {
            <p class="map-block__caption">@Model.Caption</p>
        }
    }
    else if (hasImg)
    {
        @* ── FALLBACK: static image ── *@
        <figure class="space-y-3" itemscope itemtype="https://schema.org/ImageObject">
            <a href="@Images.Full(Model!.Image)"
               target="_blank"
               rel="nofollow noopener noreferrer"
               class="block overflow-hidden border border-slate-300 bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
               itemprop="contentUrl"
               aria-label="Open full size map: @title">
                <img src="@Images.Hero(Model.Image)"
                     srcset="@Images.HeroSrcSet(Model.Image, 480, 768, 1200)"
                     sizes="(max-width: 1023px) 100vw, 960px"
                     alt="@alt"
                     class="w-full h-auto object-contain"
                     loading="lazy"
                     decoding="async"
                     itemprop="url" />
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.Caption))
            {
                <figcaption class="map-block__caption" itemprop="caption">
                    @Model.Caption
                </figcaption>
            }
        </figure>
    }

</section>

@if (hasSvg)
{
    <script src="~/js/map-svg-loader.js" asp-append-version="true" defer></script>
    <script src="~/js/map-choropleth.js" asp-append-version="true" defer></script>
    <script src="~/js/map-icon-overlay.js" asp-append-version="true" defer></script>
    @if (Model.ShowTextOverlay)
    {
        <script src="~/js/map-text-overlay.js" asp-append-version="true" defer></script>
    }
}
