@using System.Text.Json
@using System.Text.Json.Serialization
@model Usasymbol.ViewModels.MapBlockViewModel
@inject IImageUrlService Images

@{
    var title   = string.IsNullOrWhiteSpace(Model?.Title) ? "Map" : Model.Title;
    var alt     = string.IsNullOrWhiteSpace(Model?.ImageAlt) ? title : Model.ImageAlt;
    var hasSvg  = Model?.HasChoropleth == true && !string.IsNullOrEmpty(Model.SvgContent);
    var hasImg  = !string.IsNullOrWhiteSpace(Model?.Image);

    string choroplethJson = "{}";
    if (hasSvg && Model?.Entries?.Count > 0)
    {
        var opts = new JsonSerializerOptions
        {
            PropertyNamingPolicy        = JsonNamingPolicy.CamelCase,
            DefaultIgnoreCondition      = JsonIgnoreCondition.WhenWritingNull,
        };
        var dict = Model.Entries.ToDictionary(
            e => e.PostalCode,
            e => (object)new { n = e.StateName, s = e.StateSlug, v = e.DisplayValue, r = e.Rank, f = e.FillColor, sub = e.SubLabel }
        );
        choroplethJson = JsonSerializer.Serialize(dict, opts);
    }
}

<section id="choropleth-map"
         class="my-12 md:my-14 border-t border-slate-200 pt-8 sm:pt-10 scroll-mt-24"
         aria-labelledby="map-block-title">

    <header class="mb-5 sm:mb-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">Map</p>
        <h2 id="map-block-title" class="mt-1 text-2xl md:text-3xl font-semibold tracking-tight text-slate-900">
            @title
        </h2>
    </header>

    @if (hasSvg)
    {
        @* ── SVG CHOROPLETH ── *@
        <div class="relative" id="usmap-wrapper">

            <div id="usmap-container"
                 class="relative overflow-hidden rounded border border-slate-200 bg-white select-none"
                 role="img"
                 aria-label="@alt">
                @Html.Raw(Model!.SvgContent)
            </div>

            <div id="map-tooltip"
                 class="pointer-events-none absolute z-20 hidden overflow-hidden rounded-[1rem] border shadow-2xl"
                 style="min-width:212px;max-width:272px;border-color:rgba(15,23,42,.58);background:rgba(15,23,42,.96);font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"
                 role="tooltip"
                 aria-live="polite">
                <div class="px-[16px] py-[14px]">
                    <p class="text-[12px] font-semibold leading-tight tracking-[0.01em] text-white"
                       style="margin:0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:12px;line-height:1.25;font-weight:800;letter-spacing:.01em;color:#fff"
                       id="tt-state"></p>
                    <p id="tt-sub"
                       class="hidden text-[10px] font-medium leading-tight text-slate-300"
                       style="margin:3px 0 0 0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:10px;line-height:1.3;font-weight:500;color:#cbd5e1"></p>
                    <div class="mt-[8px] grid gap-[6px]">
                        <div id="tt-rank-row" class="hidden">
                            <p class="text-[10px] font-extrabold uppercase tracking-[0.12em] text-slate-400"
                               style="margin:0 0 1px 0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:10px;line-height:1.15;font-weight:800;letter-spacing:.12em;color:#94a3b8">
                                Rank
                            </p>
                            <p id="tt-rank"
                               class="text-[11px] font-semibold text-slate-50"
                               style="margin:0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:11px;line-height:1.3;font-weight:700;letter-spacing:0;color:#f8fafc"></p>
                        </div>
                        <div>
                            <p id="tt-value-label"
                               class="text-[10px] font-extrabold uppercase tracking-[0.12em] text-slate-400"
                               style="margin:0 0 1px 0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:10px;line-height:1.15;font-weight:800;letter-spacing:.12em;color:#94a3b8">
                                Value
                            </p>
                            <p id="tt-value"
                               class="text-[11px] font-medium leading-5 text-slate-100 break-words"
                               style="margin:0;font-family:Manrope,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:11px;line-height:1.4;font-weight:600;letter-spacing:0;color:#f8fafc"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── LEGEND ── *@
        @if (Model.IsNumeric && Model.LegendSteps.Count > 0)
        {
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2" aria-label="Map legend">
                @if (!string.IsNullOrEmpty(Model.MetricLabel))
                {
                    <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-400 mr-1">@Model.MetricLabel</span>
                }
                @foreach (var step in Model.LegendSteps)
                {
                    <div class="flex flex-col items-center gap-0.5">
                        <span class="inline-block h-3 w-8 rounded-sm border border-slate-200/80 flex-shrink-0"
                              style="background:@step.Color" aria-hidden="true"></span>
                        <span class="text-[10px] font-medium tabular-nums text-slate-500">@step.Label</span>
                    </div>
                }
                <div class="flex flex-col items-center gap-0.5 ml-2">
                    <span class="inline-block h-3 w-8 rounded-sm border border-slate-300 bg-[#e2e8f0] flex-shrink-0" aria-hidden="true"></span>
                    <span class="text-[10px] text-slate-400">No data</span>
                </div>
            </div>
        }

        @* ── JSON for tooltip JS (embedded in HTML, server-rendered) ── *@
        <script type="application/json"
                id="choropleth-data"
                data-metric-label="@Model.MetricLabel">@Html.Raw(choroplethJson)</script>

        @* ── SEO layer: visually hidden table (Google + screen readers) ── *@
        <div class="sr-only">
            @if (hasImg)
            {
                <figure itemscope itemtype="https://schema.org/ImageObject">
                    <img src="@Images.Full(Model!.Image)"
                         alt="@alt"
                         loading="eager"
                         decoding="async"
                         itemprop="url" />
                    <meta itemprop="contentUrl" content="@Images.Full(Model.Image)" />
                    @if (!string.IsNullOrWhiteSpace(Model.Caption))
                    {
                        <figcaption itemprop="caption">@Model.Caption</figcaption>
                    }
                </figure>
            }
            <table>
                <caption>@title</caption>
                <thead>
                    <tr>
                        @if (Model.Entries.Any(e => e.Rank.HasValue)) { <th scope="col">Rank</th> }
                        <th scope="col">State</th>
                        <th scope="col">@(string.IsNullOrEmpty(Model.MetricLabel) ? "Value" : Model.MetricLabel)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries.OrderBy(e => e.Rank ?? 999))
                    {
                        <tr>
                            @if (Model.Entries.Any(e => e.Rank.HasValue)) { <td>@entry.Rank</td> }
                            <td>@entry.StateName</td>
                            <td>@entry.DisplayValue</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Caption *@
        @if (!string.IsNullOrWhiteSpace(Model.Caption))
        {
            <p class="mt-3 border-l-2 border-slate-300 pl-4 text-sm leading-6 text-slate-700">@Model.Caption</p>
        }
    }
    else if (hasImg)
    {
        @* ── FALLBACK: static image ── *@
        <figure class="space-y-3" itemscope itemtype="https://schema.org/ImageObject">
            <a href="@Images.Full(Model!.Image)"
               target="_blank"
               rel="noopener"
               class="block overflow-hidden border border-slate-300 bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-100"
               itemprop="contentUrl"
               aria-label="Open full size map: @title">
                <img src="@Images.Hero(Model.Image)"
                     srcset="@(Images.Hero(Model.Image, 480)) 480w,
                             @(Images.Hero(Model.Image, 768)) 768w,
                             @(Images.Hero(Model.Image, 1200)) 1200w"
                     sizes="(max-width: 1023px) 100vw, 960px"
                     alt="@alt"
                     class="w-full h-auto object-contain"
                     loading="lazy"
                     decoding="async"
                     itemprop="url" />
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.Caption))
            {
                <figcaption class="border-l-2 border-slate-300 pl-4 py-1" itemprop="caption">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-500">Interpretation</p>
                    <p class="mt-1 text-sm leading-6 text-slate-700">@Model.Caption</p>
                </figcaption>
            }
        </figure>
    }

</section>

@if (hasSvg)
{
    <script src="~/js/map-choropleth.js" asp-append-version="true"></script>
}
