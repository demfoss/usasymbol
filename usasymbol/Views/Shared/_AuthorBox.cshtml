@using System.Globalization
@model USASymbol.Models.ViewModels.AuthorBox
@inject IImageUrlService Images

@{
    var updated = (Model?.DateModified ?? DateTime.UtcNow).ToString("MMMM d, yyyy", CultureInfo.InvariantCulture);
}

<aside class="border border-slate-200 bg-white"
       itemscope itemtype="https://schema.org/CreativeWork">

    <div class="flex items-start gap-4 px-4 py-4 sm:gap-5 sm:px-5">
        <a href="/about/artsiom-dusau" class="mt-0.5 shrink-0">
            <div class="flex h-14 w-14 items-center justify-center overflow-hidden border border-slate-200 bg-slate-50">
                <img src="@Images.Full("/images/profile/artsiom-dusau.png")"
                     alt="Artsiom Dusau"
                     class="h-full w-full object-cover"
                     onerror="this.style.display='none'">
            </div>
        </a>

        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Reviewed by</span>
                <a href="/about/artsiom-dusau" class="text-sm font-semibold text-slate-900 hover:text-blue-700 transition-colors">
                    Artsiom Dusau
                </a>
                <span class="text-slate-300 text-xs">·</span>
                <span class="text-xs text-slate-500">Founder &amp; Editor, USA Symbol</span>
            </div>

            <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
                Official designations, adoption dates, and key symbol details are checked against official state sources, statutes, archives, and governor's proclamations when available.
            </p>

            <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs">
                <span class="text-slate-400">Updated <span class="font-medium text-slate-600">@updated</span></span>
                <a href="/about" class="font-medium text-blue-700 hover:text-blue-900 transition-colors">About our process</a>
                <a href="#sources" class="font-medium text-slate-500 hover:text-slate-700 transition-colors">Sources</a>
            </div>
        </div>
    </div>
</aside>
