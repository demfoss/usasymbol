@model USASymbol.Models.ViewModels.ISymbolDetailViewModel
@inject IImageUrlService Images
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    var allItems = Model.RelatedSymbols?.ToList() ?? new List<USASymbol.Models.Symbol>();
    var stateName = Model.State?.Name?.Trim();
    var stateSlug = Model.State?.Slug?.Trim();
    var fallbackHeading = string.IsNullOrWhiteSpace(stateName) ? "State Symbols" : $"{stateName} State Symbols";
    var heading = (ViewData["HeadingOverride"] as string)?.Trim();
    if (string.IsNullOrWhiteSpace(heading))
    {
        heading = fallbackHeading;
    }
    var allSymbolsUrl = string.IsNullOrWhiteSpace(stateSlug) ? "/states" : $"/states/{stateSlug}";
    var allSymbolsLabel = string.IsNullOrWhiteSpace(stateName) ? "View all state symbols" : $"View all {stateName} state symbols";

    var desktopItems = allItems.Take(5).ToList();
}

@if (allItems.Any())
{
    <section>
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.22em] text-[#13231D]">
            @heading
        </h2>

        <div class="mt-3 h-px bg-slate-300/80"></div>

        <div class="mt-6 space-y-4">
            @foreach (var symbol in desktopItems)
            {
                var imageUrl = ResolveRelatedImageUrl(symbol);
                var imageClass = string.Equals(symbol.Type, "state-seal", StringComparison.OrdinalIgnoreCase) || string.Equals(symbol.Type, "coat-of-arms", StringComparison.OrdinalIgnoreCase)
                    ? "h-full w-full object-contain p-1"
                    : "h-full w-full object-cover";

                <a href="@symbol.ToSymbolUrl(Model.State.Slug)"
                   class="group flex items-start gap-4 text-slate-900 transition-opacity hover:opacity-85">
                    <div class="h-[4.4rem] w-[4.4rem] shrink-0 overflow-hidden bg-slate-100">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@Images.Card(imageUrl)"
                                 alt="@symbol.Name"
                                 class="@imageClass"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="flex h-full w-full items-center justify-center bg-slate-200 text-slate-600">
                                <span class="text-lg font-semibold">@GetSymbolInitial(symbol.Name)</span>
                            </div>
                        }
                    </div>

                    <div class="min-w-0 pt-0.5">
                        <div class="text-[0.98rem] font-semibold leading-6 text-slate-900 line-clamp-3">
                            @symbol.Name
                        </div>
                    </div>
                </a>
            }
        </div>

        <div class="mt-6">
            <a href="@allSymbolsUrl"
               class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition hover:text-slate-700">
                <span>@allSymbolsLabel</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>
    </section>
}

@functions {
    string GetSymbolInitial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpper();

    string ResolveRelatedImageUrl(USASymbol.Models.Symbol symbol)
    {
        var imageUrl = symbol.ImageUrl?.Trim();
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out var absoluteUri)
            && (absoluteUri.Scheme == Uri.UriSchemeHttp || absoluteUri.Scheme == Uri.UriSchemeHttps))
        {
            return imageUrl;
        }

        if (LocalImageExists(imageUrl))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("/images/mottos/", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var stateSlug = Model.State?.Slug;
        if (string.IsNullOrWhiteSpace(stateSlug))
        {
            return string.Empty;
        }

        var fileName = System.IO.Path.GetFileNameWithoutExtension(imageUrl);
        if (!string.IsNullOrWhiteSpace(fileName)
            && imageUrl.StartsWith("/images/mammals/", StringComparison.OrdinalIgnoreCase))
        {
            var stateMammalImage = $"/images/mammals/{stateSlug}/{fileName}.jpg";
            if (LocalImageExists(stateMammalImage))
            {
                return stateMammalImage;
            }
        }

        if (imageUrl.StartsWith("/images/flags/", StringComparison.OrdinalIgnoreCase))
        {
            var stateFlagImage = $"/images/flags/{stateSlug}/flag.webp";
            if (LocalImageExists(stateFlagImage))
            {
                return stateFlagImage;
            }
        }

        if (imageUrl.StartsWith("/images/nicknames/", StringComparison.OrdinalIgnoreCase))
        {
            var stateNicknameImage = $"/images/nicknames/{stateSlug}.webp";
            if (LocalImageExists(stateNicknameImage))
            {
                return stateNicknameImage;
            }
        }

        if (string.Equals(symbol.Type, "state-seal", StringComparison.OrdinalIgnoreCase))
        {
            var stateSealImage = $"/images/seals/{stateSlug}/seal.webp";
            if (LocalImageExists(stateSealImage))
            {
                return stateSealImage;
            }
        }

        if (string.Equals(symbol.Type, "coat-of-arms", StringComparison.OrdinalIgnoreCase))
        {
            var coatOfArmsImage = $"/images/coats-of-arms/{stateSlug}/coat-of-arms.webp";
            if (LocalImageExists(coatOfArmsImage))
            {
                return coatOfArmsImage;
            }
        }

        return string.Empty;
    }

    bool LocalImageExists(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return false;
        }

        var relativePath = imageUrl.Split('?', '#')[0].Trim().TrimStart('/', '\\').Replace('/', System.IO.Path.DirectorySeparatorChar);
        var webRootPath = string.IsNullOrWhiteSpace(WebHostEnvironment.WebRootPath)
            ? System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot")
            : WebHostEnvironment.WebRootPath;

        var fullPath = System.IO.Path.GetFullPath(System.IO.Path.Combine(webRootPath, relativePath));
        var rootPath = System.IO.Path.GetFullPath(webRootPath);

        return fullPath.StartsWith(rootPath, StringComparison.OrdinalIgnoreCase)
            && System.IO.File.Exists(fullPath);
    }
}
