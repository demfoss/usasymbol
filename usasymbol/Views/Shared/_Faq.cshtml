@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@model object

@{
    IEnumerable<(string Question, string Answer)> faqs = Enumerable.Empty<(string Question, string Answer)>();
    var hasFaq = false;
    var sectionId = (ViewData["FaqSectionId"] as string ?? "faq").Trim();

    if (ViewData["FaqItems"] is IEnumerable<(string Question, string Answer)> providedFaqs)
    {
        hasFaq = providedFaqs.Any();
        faqs = providedFaqs;
    }
    else if (Model is ISymbolDetailViewModel symbolModel && symbolModel.HasFaq && symbolModel.Faq != null)
    {
        hasFaq = true;
        faqs = symbolModel.Faq.Select(f => (f.Question, f.Answer));
    }
    else if (Model is PageDetailViewModel pageModel && pageModel.HasFaq && pageModel.Content?.Faq != null)
    {
        hasFaq = true;
        faqs = pageModel.Content.Faq.Select(f => (f.Question, f.Answer));
    }
}

@if (hasFaq)
{
    <section id="@sectionId" class="scroll-mt-32">
        <div class="border border-slate-200/80 bg-white/55">
            <div class="px-5 py-4 sm:px-6">
                <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Quick Answers</h2>
            </div>

            <div class="divide-y divide-slate-200/80">
                @foreach (var faq in faqs)
                {
                    <details class="group">
                        <summary class="list-none cursor-pointer px-5 py-4 sm:px-6 flex items-start justify-between gap-4 hover:bg-white/50 transition">
                            <span class="text-[15px] font-semibold text-slate-900 leading-7">
                                @faq.Question
                            </span>

                            <span class="shrink-0 mt-0.5 flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 group-hover:text-slate-800 transition">
                                <i class="fas fa-chevron-down text-xs group-open:rotate-180 transition-transform"></i>
                            </span>
                        </summary>

                        <div class="px-5 pb-5 sm:px-6 -mt-1">
                            <div class="text-[14px] leading-6 text-slate-600">
                                @faq.Answer.RenderMarkdown()
                            </div>
                        </div>
                    </details>
                }
            </div>
        </div>
    </section>
}
