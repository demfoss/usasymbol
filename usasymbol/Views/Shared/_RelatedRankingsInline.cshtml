@model USASymbol.Models.ViewModels.LatestContentRailViewModel

@* Phones/tablets have no sidebar, so the closest matches sit right after the table,
   where a reader who got the answer decides whether to keep going. Hidden on desktop,
   where _RelatedRankingsSidebar shows the same links. *@

@if (Model.Items.Any())
{
    <nav class="lg:hidden mt-8" aria-label="@Model.Title" data-nosnippet>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.22em] text-slate-400 mb-3">@Model.Title</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            @foreach (var item in Model.Items.Take(3))
            {
                <a href="@item.Url"
                   class="group flex items-center justify-between gap-3 border border-slate-200 bg-white/70 px-4 py-3 text-sm font-semibold text-slate-800 transition-all hover:border-slate-400 hover:bg-white">
                    <span class="line-clamp-2 leading-5">@item.Title</span>
                    <span class="shrink-0 text-slate-400 transition-colors group-hover:text-slate-700">
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </span>
                </a>
            }
        </div>
    </nav>
}
