@using System.Text.Json
@using System.Text.Json.Serialization
@using USASymbol.Models.Content
@using USASymbol.Models.ViewModels
@model object
@inject IImageUrlService Images

@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentPath = Context.Request.Path.Value ?? "/";
    var currentUrl = $"{baseUrl}{currentPath}";
    var imageRightsUrl = $"{baseUrl}/terms#image-rights";
    var imageLicensePageUrl = $"{baseUrl}/contact";
    var contentLicenseUrl = $"{baseUrl}/terms";
    var schemas = new List<Dictionary<string, object?>>();
    var jsonOptions = new JsonSerializerOptions
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        PropertyNamingPolicy = null,
        WriteIndented = false
    };

    Dictionary<string, object?> Organization() => new()
    {
        ["@type"] = "Organization",
        ["name"] = "USA Symbol",
        ["url"] = baseUrl,
        ["logo"] = new Dictionary<string, object?>
        {
            ["@type"] = "ImageObject",
            ["url"] = $"{baseUrl}/images/logo.png",
            ["contentUrl"] = $"{baseUrl}/images/logo.png",
            ["creator"] = ImageRightsHolder("USA Symbol"),
            ["creditText"] = "USA Symbol",
            ["copyrightNotice"] = "Copyright USA Symbol unless otherwise noted.",
            ["license"] = imageRightsUrl,
            ["acquireLicensePage"] = imageLicensePageUrl
        }
    };

    string FullUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return currentUrl;
        }

        return url.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? url
            : $"{baseUrl}{(url.StartsWith("/") ? url : $"/{url}")}";
    }

    string FullImageUrl(string? image)
    {
        var resolved = Images.Full(string.IsNullOrWhiteSpace(image) ? "/images/default-symbol.jpg" : image);
        return resolved.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? resolved : FullUrl(resolved);
    }

    Dictionary<string, object?> Person(string? name) => new()
    {
        ["@type"] = "Person",
        ["name"] = string.IsNullOrWhiteSpace(name) ? "USA Symbol Team" : name,
        ["url"] = $"{baseUrl}/about"
    };

    Dictionary<string, object?> ImageRightsHolder(string? name = null) => new()
    {
        ["@type"] = "Organization",
        ["name"] = string.IsNullOrWhiteSpace(name) ? "USA Symbol and credited image licensors" : name,
        ["url"] = baseUrl
    };

    Dictionary<string, object?> ImageObject(string? image, string? name = null, string? caption = null, int? width = null, int? height = null)
    {
        var imageUrl = FullImageUrl(image);
        return new Dictionary<string, object?>
        {
            ["@type"] = "ImageObject",
            ["url"] = imageUrl,
            ["contentUrl"] = imageUrl,
            ["name"] = string.IsNullOrWhiteSpace(name) ? null : name,
            ["caption"] = string.IsNullOrWhiteSpace(caption) ? null : caption,
            ["width"] = width,
            ["height"] = height,
            ["creator"] = ImageRightsHolder(),
            ["creditText"] = "Image credits and license details belong to USA Symbol, Wikimedia Commons contributors, Creative Commons licensors, public-domain sources, or cited image providers as applicable.",
            ["copyrightNotice"] = "Copyright belongs to the credited creator or licensor unless the image is in the public domain.",
            ["license"] = imageRightsUrl,
            ["acquireLicensePage"] = imageLicensePageUrl
        };
    }

    if (Model is StateViewModel stateModel)
    {
        var pageTitle = ViewData["Title"]?.ToString() ?? $"{stateModel.State.Name} State Symbols";
        var pageDescription = System.Net.WebUtility.HtmlDecode(ViewData["Description"]?.ToString() ?? "");
        var pageUrl = FullUrl($"/states/{stateModel.State.Slug}");
        var imageUrl = FullImageUrl(stateModel.State.FlagImageUrl ?? ViewData["OgImage"]?.ToString());
        var faqItems = ViewData["FaqItems"] as IEnumerable<(string Question, string Answer)> ?? Enumerable.Empty<(string Question, string Answer)>();
        var sortedSymbols = stateModel.Symbols
            .OrderBy(s => s.Type)
            .ThenBy(s => s.Designation)
            .ThenBy(s => s.Name)
            .ToList();

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["@id"] = $"{pageUrl}#webpage",
            ["name"] = pageTitle,
            ["description"] = pageDescription,
            ["url"] = pageUrl,
            ["image"] = ImageObject(stateModel.State.FlagImageUrl ?? ViewData["OgImage"]?.ToString(), pageTitle),
            ["license"] = contentLicenseUrl,
            ["creator"] = Organization(),
            ["publisher"] = Organization(),
            ["speakable"] = new Dictionary<string, object?>
            {
                ["@type"] = "SpeakableSpecification",
                ["cssSelector"] = new[] { "h1" }
            },
            ["mainEntity"] = new Dictionary<string, object?>
            {
                ["@id"] = $"{pageUrl}#symbols"
            }
        });

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["@id"] = $"{pageUrl}#breadcrumb",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "States", ["item"] = $"{baseUrl}/states" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = $"{stateModel.State.Name} State Symbols", ["item"] = pageUrl }
            }
        });

        if (sortedSymbols.Any())
        {
            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "ItemList",
                ["@id"] = $"{pageUrl}#symbols",
                ["name"] = $"Complete {stateModel.State.Name} State Symbols List",
                ["numberOfItems"] = sortedSymbols.Count,
                ["itemListElement"] = sortedSymbols.Select((symbol, index) => new Dictionary<string, object?>
                {
                    ["@type"] = "ListItem",
                    ["position"] = index + 1,
                    ["url"] = FullUrl(symbol.ToSymbolUrl(stateModel.State.Slug)),
                    ["item"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Thing",
                        ["name"] = symbol.Name,
                        ["url"] = FullUrl(symbol.ToSymbolUrl(stateModel.State.Slug)),
                        ["image"] = string.IsNullOrWhiteSpace(symbol.ImageUrl) ? null : FullImageUrl(symbol.ImageUrl),
                        ["alternateName"] = symbol.ScientificName,
                        ["additionalProperty"] = new object?[]
                        {
                            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Category", ["value"] = symbol.Designation ?? symbol.Type },
                            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Adopted", ["value"] = symbol.AdoptedYear },
                            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "State", ["value"] = stateModel.State.Name }
                        }
                    }
                }).ToArray()
            });

            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Dataset",
                ["@id"] = $"{pageUrl}#dataset",
                ["name"] = $"Complete {stateModel.State.Name} State Symbols List",
                ["description"] = pageDescription,
                ["url"] = pageUrl,
                ["creator"] = Organization(),
                ["publisher"] = Organization(),
                ["license"] = contentLicenseUrl,
                ["isAccessibleForFree"] = true,
                ["variableMeasured"] = new object[]
                {
                    new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Symbol Name", ["propertyID"] = "name" },
                    new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Category", ["propertyID"] = "type" },
                    new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Designation", ["propertyID"] = "designation" },
                    new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Year Adopted", ["propertyID"] = "adoptedYear" }
                }
            });
        }

        if (faqItems.Any())
        {
            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["@id"] = $"{pageUrl}#faq",
                ["name"] = $"FAQ about {stateModel.State.Name} state symbols",
                ["mainEntity"] = faqItems.Select(f => new Dictionary<string, object?>
                {
                    ["@type"] = "Question",
                    ["name"] = f.Question,
                    ["acceptedAnswer"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Answer",
                        ["text"] = f.Answer
                    }
                }).ToArray()
            });
        }
    }
    else if (Model is PageDetailViewModel pageModel)
    {
        var content = pageModel.Content;
        var pageUrl = FullUrl(!string.IsNullOrWhiteSpace(content?.Url) ? content.Url : currentPath);
        var pageTitle = content?.Page?.H1 ?? content?.Seo?.Title ?? "USA Symbol";
        var pageDescription = System.Net.WebUtility.HtmlDecode(content?.Seo?.Description ?? "");
        var datePublished = content?.DatePublished?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
        var dateModified = content?.DateModified?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
        var topLevelName = pageModel.IsRanking ? "Rankings" : pageModel.IsCollection ? "Collections" : "Symbols";
        var topLevelUrl = pageModel.IsRanking ? "/rankings" : pageModel.IsCollection ? "/collections" : "/symbols";
        var categoryUrl = topLevelUrl;

        if (!string.IsNullOrWhiteSpace(content?.Url))
        {
            var parts = content.Url.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
            {
                categoryUrl = $"/{parts[0]}/{parts[1]}";
            }
        }

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Article",
            ["@id"] = $"{pageUrl}#article",
            ["headline"] = pageTitle,
            ["description"] = pageDescription,
            ["datePublished"] = datePublished,
            ["dateModified"] = dateModified,
            ["image"] = ImageObject(content?.HeroImage ?? content?.Map?.Image ?? ViewData["OgImage"]?.ToString(), pageTitle, content?.HeroImageCaption ?? content?.Map?.Caption),
            ["license"] = contentLicenseUrl,
            ["creator"] = Person(content?.Author),
            ["author"] = Person(content?.Author),
            ["publisher"] = Organization(),
            ["speakable"] = new Dictionary<string, object?>
            {
                ["@type"] = "SpeakableSpecification",
                ["cssSelector"] = pageModel.HasQuickAnswer
                    ? new[] { "h1", "#quick-answer" }
                    : new[] { "h1" }
            },
            ["mainEntityOfPage"] = new Dictionary<string, object?>
            {
                ["@type"] = "WebPage",
                ["@id"] = pageUrl
            }
        });

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["@id"] = $"{pageUrl}#breadcrumb",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = topLevelName, ["item"] = $"{baseUrl}{topLevelUrl}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = pageModel.CategoryTitle, ["item"] = $"{baseUrl}{categoryUrl}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = pageTitle, ["item"] = pageUrl }
            }
        });

        if (content?.Faq?.Any() == true)
        {
            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["@id"] = $"{pageUrl}#faq",
                ["name"] = $"FAQ about {pageTitle}",
                ["mainEntity"] = content.Faq.Select(f => new Dictionary<string, object?>
                {
                    ["@type"] = "Question",
                    ["name"] = f.Question,
                    ["acceptedAnswer"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Answer",
                        ["text"] = f.Answer
                    }
                }).ToArray()
            });
        }

        var citations = content?.Page?.Sources?
            .Where(s => !string.IsNullOrWhiteSpace(s.Url))
            .Select(s => s.Url)
            .Cast<object>()
            .ToArray();

        for (var tableIndex = 0; tableIndex < pageModel.Tables.Count; tableIndex++)
        {
            var table = pageModel.Tables[tableIndex];
            if (table.Rows.Count == 0 || table.Columns.Count == 0)
            {
                continue;
            }

            var suffix = tableIndex == 0 ? "primary" : (tableIndex + 1).ToString();
            var tableName = string.IsNullOrWhiteSpace(table.Title) ? pageTitle : table.Title!;
            var visibleColumns = table.Columns.Where(c => !c.Key.EndsWith("_slug", StringComparison.OrdinalIgnoreCase)).ToList();

            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Dataset",
                ["@id"] = $"{pageUrl}#dataset-{suffix}",
                ["name"] = tableName,
                ["description"] = pageDescription,
                ["url"] = pageUrl,
                ["datePublished"] = datePublished,
                ["dateModified"] = dateModified,
                ["creator"] = Organization(),
                ["publisher"] = Organization(),
                ["license"] = contentLicenseUrl,
                ["isAccessibleForFree"] = true,
                ["citation"] = citations,
                ["variableMeasured"] = visibleColumns.Select(c => new Dictionary<string, object?>
                {
                    ["@type"] = "PropertyValue",
                    ["name"] = c.Label,
                    ["propertyID"] = c.Key,
                    ["description"] = c.Type == "text" ? null : c.Type
                }).ToArray()
            });

            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Table",
                ["@id"] = $"{pageUrl}#table-{suffix}",
                ["name"] = tableName,
                ["description"] = pageDescription,
                ["about"] = new Dictionary<string, object?>
                {
                    ["@id"] = $"{pageUrl}#dataset-{suffix}"
                }
            });

            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "ItemList",
                ["@id"] = $"{pageUrl}#list-{suffix}",
                ["name"] = tableName,
                ["numberOfItems"] = table.Rows.Count,
                ["itemListElement"] = table.Rows.Select((row, index) => BuildRowListItem(row, visibleColumns, pageModel, baseUrl, index + 1)).ToArray()
            });
        }

        var sectionTables = content?.Sections?
            .Where(s => s.Table?.Rows?.Any() == true && s.Table.Headers.Any())
            .ToList();

        if (sectionTables?.Any() == true)
        {
            foreach (var section in sectionTables)
            {
                schemas.Add(new Dictionary<string, object?>
                {
                    ["@context"] = "https://schema.org",
                    ["@type"] = "Table",
                    ["@id"] = $"{pageUrl}#section-table-{section.Id}",
                    ["name"] = string.IsNullOrWhiteSpace(section.Table?.Caption) ? section.Title : section.Table!.Caption,
                    ["description"] = section.Table?.Note,
                    ["about"] = pageTitle
                });
            }
        }
    }
    else if (Model is ISymbolDetailViewModel symbolModel)
    {
        string? meaning = null;
        string? legislation = null;

        if (symbolModel is SymbolDetailViewModel baseModel)
        {
            meaning = baseModel.Meaning;
            legislation = baseModel.Legislation;
        }

        var dateModifiedStr = (symbolModel.DateModified ?? DateTime.UtcNow).ToString("yyyy-MM-ddTHH:mm:sszzz");
        var pubDate = symbolModel.DateModified?.AddDays(-10) ?? new DateTime(Math.Max(2025, symbolModel.AdoptedYear ?? 2025), 1, 1);
        var datePublishedStr = pubDate.ToString("yyyy-MM-ddTHH:mm:sszzz");
        var citations = new List<string>();

        if (!string.IsNullOrEmpty(legislation))
        {
            citations.Add($"Official Legislation: {legislation}");
        }

        if (symbolModel.HasSources && symbolModel.Sources != null)
        {
            citations.AddRange(symbolModel.Sources.Where(s => !string.IsNullOrEmpty(s.Url)).Select(s => s.Url!));
        }

        var aboutObj = new Dictionary<string, object?>
        {
            ["@type"] = "Thing",
            ["name"] = symbolModel.Symbol?.Name ?? ""
        };

        if (!string.IsNullOrEmpty(meaning))
        {
            aboutObj["description"] = meaning;
        }

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Article",
            ["@id"] = $"{currentUrl}#article",
            ["headline"] = $"{symbolModel.State.Name} {symbolModel.SymbolTypeName}: {symbolModel.ContentTitle ?? symbolModel.Symbol?.Name}",
            ["description"] = System.Net.WebUtility.HtmlDecode(ViewData["Description"]?.ToString() ?? ""),
            ["image"] = ImageObject(!string.IsNullOrEmpty(symbolModel.Symbol?.ImageUrl) ? symbolModel.Symbol.ImageUrl : "/images/default-symbol.jpg", symbolModel.ContentTitle ?? symbolModel.Symbol?.Name),
            ["license"] = contentLicenseUrl,
            ["creator"] = Person(symbolModel.Author),
            ["datePublished"] = datePublishedStr,
            ["dateModified"] = dateModifiedStr,
            ["author"] = Person(symbolModel.Author),
            ["publisher"] = Organization(),
            ["mainEntityOfPage"] = new Dictionary<string, object?>
            {
                ["@type"] = "WebPage",
                ["@id"] = currentUrl
            },
            ["about"] = aboutObj,
            ["citation"] = citations.Any() ? citations : null,
            ["speakable"] = new Dictionary<string, object?>
            {
                ["@type"] = "SpeakableSpecification",
                ["cssSelector"] = new[] { "h1" }
            }
        });

        if (!string.IsNullOrEmpty(legislation))
        {
            var claimText = $"{symbolModel.Symbol?.Name} is the official {symbolModel.SymbolTypeName} of {symbolModel.State.Name}";
            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "ClaimReview",
                ["@id"] = $"{currentUrl}#claim-review",
                ["url"] = currentUrl,
                ["claimReviewed"] = claimText,
                ["author"] = Organization(),
                ["reviewRating"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Rating",
                    ["ratingValue"] = "5",
                    ["bestRating"] = "5",
                    ["worstRating"] = "1",
                    ["alternateName"] = "True"
                },
                ["itemReviewed"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Claim",
                    ["name"] = claimText,
                    ["author"] = Organization(),
                    ["appearance"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "CreativeWork",
                        ["url"] = currentUrl
                    }
                }
            });
        }

        var pluralName = string.IsNullOrEmpty(symbolModel.SymbolTypePlural)
            ? ""
            : char.ToUpper(symbolModel.SymbolTypePlural[0]) + symbolModel.SymbolTypePlural.Substring(1).Replace("-", " ");

        schemas.Add(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["@id"] = $"{currentUrl}#breadcrumb",
            ["itemListElement"] = new List<Dictionary<string, object?>>
            {
                new() { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = $"{baseUrl}/" },
                new() { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "State Symbols", ["item"] = $"{baseUrl}/symbols" },
                new() { ["@type"] = "ListItem", ["position"] = 3, ["name"] = pluralName, ["item"] = $"{baseUrl}/symbols/{symbolModel.SymbolTypePlural}" },
                new() { ["@type"] = "ListItem", ["position"] = 4, ["name"] = $"{symbolModel.State.Name} {symbolModel.SymbolTypeName}", ["item"] = currentUrl }
            }
        });

        if (symbolModel.HasFaq && symbolModel.Faq != null && symbolModel.Faq.Any())
        {
            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["@id"] = $"{currentUrl}#faq",
                ["name"] = $"FAQ about {symbolModel.Symbol?.Name} in {symbolModel.State.Name}",
                ["mainEntity"] = symbolModel.Faq.Select(f => new Dictionary<string, object?>
                {
                    ["@type"] = "Question",
                    ["name"] = f.Question,
                    ["acceptedAnswer"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Answer",
                        ["text"] = f.Answer
                    }
                }).ToArray()
            });
        }

        if (symbolModel.QuickFacts?.Any(f => !string.IsNullOrWhiteSpace(f.Value)) == true)
        {
            var quickFactProperties = symbolModel.QuickFacts
                .Where(f => !string.IsNullOrWhiteSpace(f.Value))
                .Select(f => new Dictionary<string, object?>
                {
                    ["@type"] = "PropertyValue",
                    ["name"] = string.IsNullOrWhiteSpace(f.Label) ? "Fact" : f.Label,
                    ["value"] = f.Value,
                    ["url"] = string.IsNullOrWhiteSpace(f.Url) ? null : f.Url
                })
                .ToArray();

            schemas.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Table",
                ["@id"] = $"{currentUrl}#quick-facts-table",
                ["name"] = $"{symbolModel.State.Name} {symbolModel.SymbolTypeName} quick facts",
                ["description"] = $"Quick facts about {symbolModel.Symbol?.Name} as the {symbolModel.State.Name} {symbolModel.SymbolTypeName}.",
                ["about"] = aboutObj,
                ["additionalProperty"] = quickFactProperties
            });
        }
    }
}

@foreach (var schema in schemas)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(schema, jsonOptions))</script>
}

@functions {
    private static Dictionary<string, object?> BuildRowListItem(
        TableRow row,
        IReadOnlyList<TableColumn> columns,
        PageDetailViewModel pageModel,
        string baseUrl,
        int position)
    {
        var rowName = FirstNonEmpty(row, "state", pageModel.Content?.DetailType ?? "", "name", "symbol", "title")
            ?? FirstColumnValue(row, columns)
            ?? $"Item {position}";
        var rowUrl = GetRowUrl(row, pageModel, baseUrl);

        var item = new Dictionary<string, object?>
        {
            ["@type"] = "Thing",
            ["name"] = rowName,
            ["additionalProperty"] = columns
                .Where(c => !string.IsNullOrWhiteSpace(c.Key) && row.Has(c.Key) && !c.Key.EndsWith("_slug", StringComparison.OrdinalIgnoreCase))
                .Select(c => new Dictionary<string, object?>
                {
                    ["@type"] = "PropertyValue",
                    ["name"] = c.Label,
                    ["propertyID"] = c.Key,
                    ["value"] = row.GetString(c.Key)
                })
                .ToArray()
        };

        if (!string.IsNullOrWhiteSpace(rowUrl))
        {
            item["url"] = rowUrl;
        }

        return new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = position,
            ["item"] = item
        };
    }

    private static string? FirstNonEmpty(TableRow row, params string[] keys)
    {
        foreach (var key in keys.Where(k => !string.IsNullOrWhiteSpace(k)))
        {
            var value = row.GetString(key);
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private static string? FirstColumnValue(TableRow row, IReadOnlyList<TableColumn> columns)
    {
        foreach (var column in columns.Where(c => c.Type != "image" && !c.Key.EndsWith("_slug", StringComparison.OrdinalIgnoreCase)))
        {
            var value = row.GetString(column.Key);
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private static string? GetRowUrl(TableRow row, PageDetailViewModel pageModel, string baseUrl)
    {
        var customRowUrl = row.GetString("custom_url");
        if (!string.IsNullOrWhiteSpace(customRowUrl))
        {
            return ToAbsoluteUrl(customRowUrl, baseUrl);
        }

        var stateSlug = row.GetString("state_slug");
        var detailType = (pageModel.Content?.DetailType ?? "").ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(stateSlug))
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(detailType))
        {
            var symbolSlug = row.GetString("symbol_slug");
            if (string.IsNullOrWhiteSpace(symbolSlug))
            {
                symbolSlug = row.GetString($"{detailType}_slug");
            }

            if (string.IsNullOrWhiteSpace(symbolSlug) && detailType == "flag")
            {
                symbolSlug = $"{stateSlug}-state-flag";
            }

            if (!string.IsNullOrWhiteSpace(symbolSlug))
            {
                return $"{baseUrl}/states/{stateSlug}/{detailType}/{symbolSlug}";
            }
        }

        return $"{baseUrl}/states/{stateSlug}";
    }

    private static string ToAbsoluteUrl(string url, string baseUrl)
    {
        return url.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? url
            : $"{baseUrl}{(url.StartsWith("/") ? url : $"/{url}")}";
    }
}
