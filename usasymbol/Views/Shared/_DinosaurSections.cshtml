@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using USASymbol.Extensions
@model USASymbol.Models.ViewModels.DinosaurDetailViewModel

@{
    var sections = Model.DinosaurContent?.Sections;
    var secIdx = 0;
    var quoteDone = false;
    var timelineDone = false;
    var statDone = false;
    var quoteAfterSectionId = Model.DinosaurContent?.ExpertQuoteAfterSectionId ?? string.Empty;
    var timelineAfterSectionId = Model.DinosaurContent?.TimelineAfterSectionId ?? string.Empty;
    var statAfterSectionId = Model.DinosaurContent?.BigStatAfterSectionId ?? string.Empty;
}

@if (sections?.Any() == true)
{
    var visualAssets = Model.DinosaurContent?.VisualAssets?.ToList() ?? new List<VisualAsset>();
    var orphanVisualAssets = visualAssets
        .Where(asset => asset != null &&
                        !string.IsNullOrWhiteSpace(asset.Src) &&
                        !string.Equals(asset.Layout, "full-width", StringComparison.OrdinalIgnoreCase) &&
                        string.IsNullOrWhiteSpace(asset.Section))
        .ToList();
    var fullWidthVisualAsset = visualAssets
        .FirstOrDefault(asset => asset != null &&
                                 !string.IsNullOrWhiteSpace(asset.Src) &&
                                 string.Equals(asset.Layout, "full-width", StringComparison.OrdinalIgnoreCase));

    foreach (var item in sections)
    {
        <section id="section-@item.Id" class="scroll-mt-28 py-4 lg:py-5 border-t border-slate-100 first:border-t-0">
            @await Html.PartialAsync("Components/Content/_SectionHeader", item)

            @{
                var sectionAssets = visualAssets
                    .Where(asset => asset != null &&
                                    !string.IsNullOrWhiteSpace(asset.Src) &&
                                    string.Equals(asset.Section, item.Id, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            @foreach (var asset in sectionAssets)
            {
                @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
            }

            @if (item.Paragraphs?.Any() == true)
            {
                <div class="prose prose-slate prose-base lg:prose-lg max-w-none text-slate-800 mb-6">
                    @foreach (var p in item.Paragraphs)
                    {
                        <p class="first:text-xl first:font-medium first:text-slate-900 first:leading-snug">@p.RenderAutoLinks()</p>
                    }
                </div>
            }

            @if (item.Subsections?.Any() == true)
            {
                <div class="mt-8 space-y-8">
                    @foreach (var sub in item.Subsections)
                    {
                        <article class="pt-8 border-t border-slate-100 first:pt-0 first:border-t-0">
                            <h3 class="text-lg lg:text-xl font-semibold text-slate-900 mb-3">@sub.Subtitle</h3>

                            @if (!string.IsNullOrEmpty(sub.Text))
                            {
                                <div class="prose prose-slate prose-base lg:prose-lg max-w-none text-slate-700">
                                    <p>@sub.Text.RenderAutoLinks()</p>
                                </div>
                            }

                            @if (sub.ListItems?.Any() == true)
                            {
                                <ul class="mt-4 space-y-2 text-sm text-slate-700 max-w-prose">
                                    @foreach (var li in sub.ListItems)
                                    {
                                        <li class="pl-5 relative before:content-['-'] before:absolute before:left-0 before:text-slate-400">
                                            @li.RenderListItem()
                                        </li>
                                    }
                                </ul>
                            }

                            @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                            {
                                <div class="mt-4">
                                    <a href="@sub.Link.Url" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:text-slate-700 transition">
                                        <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                        <i class="fas fa-arrow-right text-xs"></i>
                                    </a>
                                </div>
                            }
                        </article>
                    }
                </div>
            }

            @if (item.Facts?.Any() == true)
            {
                @await Html.PartialAsync("Components/Widgets/_FactsCarousel", (IEnumerable<string>)item.Facts)
            }

            <div class="clear-both"></div>
        </section>

        @if (!quoteDone &&
            !string.IsNullOrWhiteSpace(quoteAfterSectionId) &&
            string.Equals(item.Id, quoteAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.DinosaurContent?.ExpertQuote != null)
        {
            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.DinosaurContent.ExpertQuote)
            quoteDone = true;
        }
        else if (secIdx == 0 && !quoteDone && Model.DinosaurContent?.ExpertQuote != null)
        {
            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.DinosaurContent.ExpertQuote)
            quoteDone = true;
        }

        @if (!timelineDone &&
            !string.IsNullOrWhiteSpace(timelineAfterSectionId) &&
            string.Equals(item.Id, timelineAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.DinosaurContent?.Timeline?.Any() == true)
        {
            @await Html.PartialAsync("Components/Story/_Timeline", Model.DinosaurContent.Timeline)
            timelineDone = true;
        }
        else if (secIdx == 1 && !timelineDone && Model.DinosaurContent?.Timeline?.Any() == true)
        {
            @await Html.PartialAsync("Components/Story/_Timeline", Model.DinosaurContent.Timeline)
            timelineDone = true;
        }

        @if (!statDone &&
            !string.IsNullOrWhiteSpace(statAfterSectionId) &&
            string.Equals(item.Id, statAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.DinosaurContent?.BigStat != null)
        {
            @await Html.PartialAsync("Components/Story/_BigStat", Model.DinosaurContent.BigStat)
            statDone = true;
        }
        else if (secIdx == 2 && !statDone && Model.DinosaurContent?.BigStat != null)
        {
            @await Html.PartialAsync("Components/Story/_BigStat", Model.DinosaurContent.BigStat)
            statDone = true;
        }

        secIdx++;
    }

    if (orphanVisualAssets.Any())
    {
        foreach (var asset in orphanVisualAssets)
        {
            @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
        }
    }

    if (fullWidthVisualAsset != null)
    {
        @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", fullWidthVisualAsset)
    }
}
else
{
    <div class="text-sm text-slate-500">
        No sections rendered yet for this dinosaur.
    </div>
}
