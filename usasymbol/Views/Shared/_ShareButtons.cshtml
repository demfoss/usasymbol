@model object

<div class="js-share-buttons flex items-center gap-3 flex-wrap" data-nosnippet>
    <button type="button"
            class="js-share-btn inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold rounded-lg shadow active:scale-95 transition">
        <i class="fas fa-share-nodes shrink-0"></i>
        <span>Share</span>
    </button>

</div>

<script>
    (function () {
        var container = document.currentScript.previousElementSibling;
        var shareBtn = container.querySelector('.js-share-btn');
        var label = shareBtn.querySelector('span');

        function copyToClipboard() {
            navigator.clipboard.writeText(window.location.href).then(function () {
                label.textContent = 'Link copied';
                setTimeout(function () { label.textContent = 'Share'; }, 2000);
            });
        }

        shareBtn.addEventListener('click', async function () {
            // Phones and tablets get the system share sheet; desktops just copy the link.
            if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
                try {
                    await navigator.share({ title: document.title, url: window.location.href });
                } catch (err) { }
            } else {
                copyToClipboard();
            }
        });

    })();
</script>
