@using USASymbol.Models.ViewModels
@model object

@{
    var isBird = false;
    var hasSharedStates = false;
    var items = new List<(string Id, string Title)>();

    void Add(string id, string title)
    {
        if (items.Count >= 6) return;
        if (string.IsNullOrWhiteSpace(id) || string.IsNullOrWhiteSpace(title)) return;
        if (items.Any(x => x.Id == id)) return;
        items.Add((id, title));
    }

    string LabelFromSectionId(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return string.Empty;
        }

        var parts = id
            .Split(new[] { '-', '_', ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..].ToLowerInvariant());

        return string.Join(" ", parts);
    }

    if (Model is ISymbolDetailViewModel symbolModel)
    {
        isBird = symbolModel.SymbolTypeSlug == "bird";

        if (isBird && symbolModel is BirdDetailViewModel birdModel)
        {
            hasSharedStates = birdModel.HasSharedStates;
        }

        if (!string.IsNullOrWhiteSpace(symbolModel.ContentIntroText))
        {
            Add("overview", "Overview");
        }

        var topSections = (symbolModel.Sections ?? new List<IContentSection>()).Take(4).ToList();
        foreach (var sec in topSections)
        {
            Add($"section-{sec.Id}", LabelFromSectionId(sec.Id));
        }

        if (symbolModel.HasFaq) Add("faq", "Quick Answers");
        if (symbolModel.HasSources) Add("sources", "Sources");
    }
    else if (Model is PageDetailViewModel pageModel)
    {
        if (pageModel.HasQuickAnswer) Add("quick-answer", "Quick Answer");
        if (pageModel.HasRows) Add(pageModel.IsCollection ? "collection-table" : pageModel.IsRanking ? "ranking-table" : "listing-table", "Browse The List");
        if (pageModel.HasInsights) Add("insights", "Key Insights");
        if (pageModel.HasSections) Add("sections", "Details");
        if (pageModel.HasFaq) Add("faq", "Quick Answers");
        Add("sources", "Sources");
    }
    else if (Model is SurnamesViewModel surnamesModel)
    {
        if (surnamesModel.Top1 != null) Add("top-3", "Top 3");
        if (surnamesModel.Content?.Surnames?.Any() == true) Add("all-surnames", "Top Surnames");
        if (!string.IsNullOrWhiteSpace(surnamesModel.Content?.HeritageBody)) Add("heritage", "Heritage");
        if (surnamesModel.Content?.UniqueSurnames?.Any() == true) Add("unique", "Local Insight");
        if (surnamesModel.Content?.EtymologyGroups?.Any() == true) Add("etymology", "Etymology");
        if (surnamesModel.Content?.Faq?.Any() == true) Add("faq", "Quick Answers");
        if (surnamesModel.Content?.Sources?.Any() == true) Add("sources", "Sources");
    }

    var hasMobileToc = items.Any() || isBird || hasSharedStates;
    const string mobileLinkClass = "toc-mobile-link group flex min-h-[56px] w-full items-center justify-between gap-3 py-3.5 text-left transition-colors duration-200 hover:text-slate-900";
    const string mobileLinkLabelClass = "text-[0.875rem] font-semibold leading-6 text-slate-900";
    const string mobileLinkArrowClass = "fa-solid fa-arrow-right text-[10px] text-slate-400 transition group-hover:translate-x-0.5";
}

@if (hasMobileToc)
{
    <button id="floatingTocBtn"
            type="button"
            aria-label="Open table of contents"
            aria-controls="tocOverlay"
            aria-expanded="false"
            class="fixed bottom-5 right-5 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200/80 bg-white/90 text-slate-700 shadow-[0_18px_40px_-28px_rgba(15,23,42,0.38)] backdrop-blur-sm transition-colors hover:border-slate-300 hover:text-slate-900 active:scale-[0.98] lg:hidden">
        <i class="fas fa-list text-sm"></i>
    </button>

    <div id="tocOverlay"
         class="fixed inset-0 z-50 hidden lg:hidden"
         aria-hidden="true">
        <div id="tocBackdrop" class="absolute inset-0 bg-slate-950/30 backdrop-blur-[1px]"></div>

        <div id="tocDrawer"
             role="dialog"
             aria-modal="true"
             aria-label="Table of contents"
             class="absolute bottom-0 left-0 right-0 max-h-[82vh] overflow-y-auto rounded-t-[1.75rem] border-t border-slate-200/80 bg-[linear-gradient(180deg,rgba(255,255,255,0.98),rgba(248,250,252,0.96))] shadow-[0_-22px_60px_-32px_rgba(15,23,42,0.32)] transform translate-y-full transition-transform duration-300">

            <div class="sticky top-0 z-10 rounded-t-[1.75rem] border-b border-slate-200/70 bg-white/95 backdrop-blur-sm">
                <div class="flex items-center justify-between px-5 py-4">
                    <div class="min-w-0">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                            On this page
                        </div>
                        <div class="mt-1 text-base font-semibold text-slate-900">
                            Jump to a section
                        </div>
                    </div>

                    <button id="closeTocDrawer"
                            type="button"
                            aria-label="Close table of contents"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200/80 bg-white text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">
                        <i class="fas fa-times text-base"></i>
                    </button>
                </div>
            </div>

            <nav class="px-4 py-2 pb-8" aria-label="Page sections">
                <div class="divide-y divide-slate-200/70">
                    @foreach (var it in items)
                    {
                        <a href="#@it.Id"
                           class="@mobileLinkClass">
                            <span class="@mobileLinkLabelClass">@it.Title</span>
                            <i class="@mobileLinkArrowClass"></i>
                        </a>
                    }

                    @if (isBird)
                    {
                        <a href="#bird-songs"
                           class="@mobileLinkClass">
                            <span class="@mobileLinkLabelClass">Bird Songs & Calls</span>
                            <i class="@mobileLinkArrowClass"></i>
                        </a>
                    }

                    @if (hasSharedStates)
                    {
                        <a href="#shared-states"
                           class="@mobileLinkClass">
                            <span class="@mobileLinkLabelClass">Also the State Bird of</span>
                            <i class="@mobileLinkArrowClass"></i>
                        </a>
                    }

                    <button type="button"
                            id="tocBackToTopMobile"
                            class="@mobileLinkClass">
                        <span class="@mobileLinkLabelClass">Back to top</span>
                        <i class="fa-solid fa-arrow-up text-[10px] text-slate-400 transition group-hover:-translate-y-0.5"></i>
                    </button>
                </div>
            </nav>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fabBtn = document.getElementById('floatingTocBtn');
        const overlay = document.getElementById('tocOverlay');
        const backdrop = document.getElementById('tocBackdrop');
        const drawer = document.getElementById('tocDrawer');
        const closeBtn = document.getElementById('closeTocDrawer');
        const backTopBtn = document.getElementById('tocBackToTopMobile');

        if (!fabBtn || !overlay || !drawer) return;

        const body = document.body;

        function openDrawer() {
            overlay.classList.remove('hidden');
            overlay.setAttribute('aria-hidden', 'false');
            fabBtn.setAttribute('aria-expanded', 'true');
            body.style.overflow = 'hidden';

            requestAnimationFrame(() => {
                drawer.classList.remove('translate-y-full');
            });
        }

        function closeDrawer() {
            drawer.classList.add('translate-y-full');
            fabBtn.setAttribute('aria-expanded', 'false');

            setTimeout(() => {
                overlay.classList.add('hidden');
                overlay.setAttribute('aria-hidden', 'true');
                body.style.overflow = '';
            }, 300);
        }

        fabBtn.addEventListener('click', openDrawer);
        closeBtn?.addEventListener('click', closeDrawer);
        backdrop?.addEventListener('click', closeDrawer);

        overlay.querySelectorAll('a.toc-mobile-link[href^="#"]').forEach(link => {
            link.addEventListener('click', function (e) {
                const href = link.getAttribute('href');
                if (!href) return;

                const id = href.slice(1);
                const el = document.getElementById(id);

                e.preventDefault();
                closeDrawer();

                if (!el) return;

                setTimeout(() => {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 60);
            });
        });

        backTopBtn?.addEventListener('click', function () {
            closeDrawer();
            setTimeout(() => {
                const top = document.getElementById('top');
                if (top) top.scrollIntoView({ behavior: 'smooth', block: 'start' });
                else window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 60);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
                closeDrawer();
            }
        });
    });
</script>
