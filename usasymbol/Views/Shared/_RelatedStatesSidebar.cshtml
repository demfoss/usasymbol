@model USASymbol.Models.ViewModels.IStateScopedViewModel
@inject IImageUrlService Images

@inject USASymbol.Services.Interface.IBorderService BorderService

@{
    var allStates = ViewData["AllStates"] as IEnumerable<dynamic>;
    var currentSlug = Model.State.Slug;
    var region = Model.State.Region;

    // Bordering states first (real neighbors), then same-region states in a stable order.
    // string.GetHashCode is randomized per process, so a seeded Random changed on every restart.
    List<dynamic> pick = new();
    if (allStates != null)
    {
        var borderContent = await BorderService.GetBorderContentAsync(currentSlug ?? string.Empty);
        var neighborNames = (borderContent?.BorderSummary?.BorderingStatesList ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        foreach (var name in neighborNames)
        {
            var match = allStates.FirstOrDefault(s => string.Equals((string)s.Name, name, StringComparison.OrdinalIgnoreCase) && (string)s.Slug != currentSlug);
            if (match != null && pick.Count < 5) pick.Add(match);
        }

        var offset = Math.Abs((currentSlug ?? string.Empty).Sum(ch => (int)ch));
        var sameRegion = allStates
            .Where(s => string.Equals((string?)s.Region, region, StringComparison.OrdinalIgnoreCase) && (string)s.Slug != currentSlug)
            .OrderBy(s => (string)s.Slug)
            .ToList();
        for (var i = 0; i < sameRegion.Count && pick.Count < 5; i++)
        {
            var candidate = sameRegion[(offset + i) % sameRegion.Count];
            if (!pick.Any(p => (string)p.Slug == (string)candidate.Slug)) pick.Add(candidate);
        }

        if (pick.Count == 0)
        {
            pick = allStates.Where(s => (string)s.Slug != currentSlug).OrderBy(s => (string)s.Slug).Take(5).ToList();
        }
    }
}

@if (Model is USASymbol.Models.ViewModels.ISymbolDetailViewModel symbolModel)
{
    if (!(ViewData["HideRelatedStates"] as bool? ?? false))
    {
        @await Component.InvokeAsync("SymbolContext", new { model = symbolModel, part = "sidebar" })
    }
}
else if (!(ViewData["HideRelatedStates"] as bool? ?? false) && pick.Any())
{
    <section class="related-states-minimal">
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.22em] text-[#13231D]">
            Related States
        </h2>

        <div class="mt-3 h-px bg-slate-300/80"></div>

        <div class="mt-6 space-y-4">
            @foreach (var st in pick)
            {
                var abbr = ((string)st.Abbreviation).ToLowerInvariant();
                var flagUrl = $"/images/states/flags/small/{abbr}.webp";

                <a href="/states/@st.Slug"
                   class="group flex items-start gap-4 text-slate-900 transition-opacity hover:opacity-85">
                    <img src="@Images.Thumb(flagUrl)"
                         alt="@st.Name state flag"
                         class="h-[4.4rem] w-[4.4rem] shrink-0 object-cover"
                         loading="lazy" />

                    <div class="min-w-0 pt-0.5">
                        <div class="text-[0.98rem] font-semibold leading-6 text-slate-900">
                            @st.Name
                        </div>
                    </div>
                </a>
            }
        </div>

        <div class="mt-6">
            <a href="/states"
               class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition hover:text-slate-700">
                <span>View all states</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>
    </section>
}
