@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using USASymbol.Models.Content
@using USASymbol.Models.ViewModels
@using USASymbol.Extensions
@model LicensePlateDetailViewModel

@{
    var sections = Model.LicensePlateContent?.Sections;
    var displaySections = sections?
        .Where(section => !string.Equals(section.Style, "meaning-banner", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var quoteDone = false;
    var timelineDone = true; // Timeline hidden for license plate pages for now
    var statDone = false;
    var stateSlug = Model.State?.Slug ?? "";
    var quoteAfterSectionId = (Model.ExpertQuoteAfterSectionId ?? string.Empty).Trim();
    var timelineAfterSectionId = (Model.TimelineAfterSectionId ?? string.Empty).Trim();
    var statAfterSectionId = (Model.BigStatAfterSectionId ?? string.Empty).Trim();
    var meaningAfterSectionId = (Model.MeaningAfterSectionId ?? string.Empty).Trim();
    var meaningDone = false;
    var meaningTitle = Model.MeaningTitle ?? ("Meaning of " + (Model.LicensePlateContent?.Title ?? Model.Symbol?.Name ?? ""));
    var meaningText = !string.IsNullOrEmpty(Model.LicensePlateContent?.Meaning) ? Model.LicensePlateContent.Meaning : (Model.Meaning ?? "");
    var visualAssets = Model.LicensePlateContent?.VisualAssets?.ToList() ?? new List<VisualAsset>();
    var orphanVisualAssets = visualAssets
        .Where(asset => asset != null &&
                        !string.IsNullOrWhiteSpace(asset.Src) &&
                        !string.Equals(asset.Layout, "full-width", StringComparison.OrdinalIgnoreCase) &&
                        string.IsNullOrWhiteSpace(asset.Section))
        .ToList();
    var fullWidthVisualAsset = visualAssets
        .FirstOrDefault(asset => asset != null &&
                                 !string.IsNullOrWhiteSpace(asset.Src) &&
                                 string.Equals(asset.Layout, "full-width", StringComparison.OrdinalIgnoreCase) &&
                                 string.IsNullOrWhiteSpace(asset.Section));
}

@if (displaySections?.Any() == true)
{
    var fallbackMeaningSectionId = displaySections.LastOrDefault()?.Id ?? string.Empty;

    foreach (var item in displaySections)
    {
        <section id="section-@item.Id" class="scroll-mt-24 py-10 lg:py-12 flow-root border-t border-slate-200/70 first:border-t-0 first:pt-0">
            <header class="mb-5 lg:mb-6">
                <div class="flex items-center gap-3 mb-2">
                    <span class="text-[11px] font-semibold tracking-widest uppercase text-gray-500">
                        Section
                    </span>
                    <span class="h-px flex-1 bg-gray-200/70"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <div class="flex items-center gap-4">
                        <span class="inline-flex h-11 w-11 shrink-0 min-h-[2.75rem] min-w-[2.75rem] items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                            <i class="@item.Icon text-sm"></i>
                        </span>
                        <h2 class="content-h2">
                            @item.Title
                        </h2>
                    </div>
                }
                else
                {
                    <h2 class="content-h2">
                        @item.Title
                    </h2>
                }
            </header>

            @{
                var sectionAssets = visualAssets
                    .Where(asset => asset != null &&
                                    !string.IsNullOrWhiteSpace(asset.Src) &&
                                    string.Equals(asset.Section, item.Id, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            @foreach (var asset in sectionAssets)
            {
                @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
            }

            @if (item.Paragraphs?.Any() == true)
            {
                <div class="prose prose-lg prose-headings:scroll-mt-24 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-p:leading-relaxed text-gray-800">
                    @for (var i = 0; i < item.Paragraphs.Count; i++)
                    {
                        <p class="content-p @(i == 0 ? "text-gray-900" : "")">
                            @item.Paragraphs[i].RenderAutoLinks()
                        </p>
                    }
                </div>
            }

            @if (item.Subsections?.Any() == true)
            {
                <div class="mt-8 space-y-8">
                    @foreach (var sub in item.Subsections)
                    {
                        <article class="pt-8 border-t border-slate-100 first:border-t-0 first:pt-0">
                            <h3 class="content-h3 text-slate-900 mb-3">@sub.Subtitle</h3>

                            @if (!string.IsNullOrWhiteSpace(sub.Text))
                            {
                <div class="prose prose-lg text-gray-800">
                                    <p class="content-p">@sub.Text.RenderAutoLinks()</p>
                                </div>
                            }

                            @if (sub.ListItems?.Any() == true)
                            {
                        <ul class="mt-4 space-y-2 text-base text-gray-700">
                                    @foreach (var listItem in sub.ListItems)
                                    {
                                        <li class="pl-6 relative before:content-['-'] before:absolute before:left-0 before:text-gray-400">
                                            @listItem.RenderListItem()
                                        </li>
                                    }
                                </ul>
                            }

                            @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                            {
                                <div class="mt-4">
                                    <a href="@sub.Link.Url"
                                       target="@(sub.Link.Url.IsExternalUrl() ? "_blank" : null)"
                                       rel="@(sub.Link.Url.IsExternalUrl() ? "nofollow noopener noreferrer" : null)"
                                       class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-gray-700 transition">
                                        <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                        <i class="fas fa-arrow-right text-xs"></i>
                                    </a>
                                </div>
                            }
                        </article>
                    }
                </div>
            }

            @if (item.Versions?.Any() == true)
            {
                var versionItems = item.Versions
                    .Select(v => new VersionDisplayItem { Name = v.Name, Years = v.Years, Image = v.Image, Description = v.Description })
                    .ToList();
                @await Html.PartialAsync(
                    "Components/Widgets/_VersionsTimeline",
                    ((IReadOnlyList<VersionDisplayItem>)versionItems, $"/images/license-plates/{stateSlug}"))
            }

            @if (item.Facts?.Any() == true)
            {
                @await Html.PartialAsync("Components/Widgets/_FactsCarousel", (IEnumerable<string>)item.Facts)
            }

            <div class="clear-both"></div>
        </section>

        @if (!statDone &&
            !string.IsNullOrWhiteSpace(statAfterSectionId) &&
            string.Equals(item.Id, statAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.LicensePlateContent?.BigStat != null)
        {
            @await Html.PartialAsync("Components/Story/_BigStat", Model.LicensePlateContent.BigStat)
            statDone = true;
        }

        @if (!timelineDone &&
            !string.IsNullOrWhiteSpace(timelineAfterSectionId) &&
            string.Equals(item.Id, timelineAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.LicensePlateContent?.Timeline?.Any() == true)
        {
            @await Html.PartialAsync("Components/Story/_Timeline", Model.LicensePlateContent.Timeline)
            timelineDone = true;
        }

        @if (!quoteDone &&
            !string.IsNullOrWhiteSpace(quoteAfterSectionId) &&
            string.Equals(item.Id, quoteAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            Model.LicensePlateContent?.ExpertQuote != null)
        {
            @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.LicensePlateContent.ExpertQuote)
            quoteDone = true;
        }

        @if (!meaningDone &&
            string.Equals(item.Id, string.IsNullOrWhiteSpace(meaningAfterSectionId) ? fallbackMeaningSectionId : meaningAfterSectionId, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(meaningText))
        {
            @await Html.PartialAsync("Components/Story/_MeaningBanner", (meaningTitle, meaningText))
            meaningDone = true;
        }
    }

    if (!statDone && Model.LicensePlateContent?.BigStat != null)
    {
        @await Html.PartialAsync("Components/Story/_BigStat", Model.LicensePlateContent.BigStat)
    }

    if (!timelineDone && Model.LicensePlateContent?.Timeline?.Any() == true)
    {
        @await Html.PartialAsync("Components/Story/_Timeline", Model.LicensePlateContent.Timeline)
    }

    if (!quoteDone && Model.LicensePlateContent?.ExpertQuote != null)
    {
        @await Html.PartialAsync("Components/Story/_ExpertQuote", Model.LicensePlateContent.ExpertQuote)
    }

    if (!meaningDone && !string.IsNullOrWhiteSpace(meaningText))
    {
        @await Html.PartialAsync("Components/Story/_MeaningBanner", (meaningTitle, meaningText))
    }

    if (orphanVisualAssets.Any())
    {
        foreach (var asset in orphanVisualAssets)
        {
            @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", asset)
        }
    }

    if (fullWidthVisualAsset != null)
    {
        @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", fullWidthVisualAsset)
    }
}
else
{
    <div class="text-sm text-slate-500">
        @if (!string.IsNullOrWhiteSpace(meaningText))
        {
            @await Html.PartialAsync("Components/Story/_MeaningBanner", (meaningTitle, meaningText))
        }
        else
        {
            <text>No sections rendered yet for this license plate page.</text>
        }
    </div>
}
