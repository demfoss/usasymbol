@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var sectionId = (ViewData["MethodologySectionId"] as string ?? "methodology").Trim();
    var sources = Model.Content?.Page?.Sources;
}

<section id="@sectionId" class="my-12 scroll-mt-24" aria-label="Sources and methodology">
    <div class="flex items-center gap-4">
        <span class="h-3 w-3 rounded-sm bg-amber-400"></span>
        <div class="h-px flex-1 bg-slate-200"></div>
    </div>

    <div class="mt-5 space-y-10">
        @if (!string.IsNullOrEmpty(Model.Content?.Page?.Methodology))
        {
            <div>
                <div class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-800">
                        <i class="fa-solid fa-flask text-sm" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Methodology</p>
                        <h2 class="mt-1 content-h2">How we researched this list</h2>
                    </div>
                </div>

                <p class="content-p mt-4 max-w-3xl text-slate-700">
                    @Model.Content.Page.Methodology.RenderAutoLinks()
                </p>
            </div>
        }

        @if (sources?.Any() == true)
        {
            <div class="border-t border-slate-200 pt-8">
                <div class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-800">
                        <i class="fa-solid fa-book text-sm" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Sources</p>
                        <h2 class="mt-1 content-h2">Sources &amp; references</h2>
                    </div>
                </div>

                <ol class="mt-6 space-y-6">
                    @{ var i = 1; }
                    @foreach (var source in sources)
                    {
                        <li class="flex items-start gap-4 border-t border-slate-200 pt-5 first:border-t-0 first:pt-0">
                            <span class="mt-0.5 inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-slate-200 text-xs font-semibold text-slate-700">
                                @i
                            </span>

                            <div class="min-w-0">
                                <div class="font-semibold text-slate-900">@source.Name</div>

                                @if (!string.IsNullOrEmpty(source.Description))
                                {
                                    <p class="mt-1 text-sm leading-7 text-slate-600">@source.Description</p>
                                }

                                @if (!string.IsNullOrEmpty(source.Url))
                                {
                                    <a href="@source.Url"
                                       target="_blank" rel="nofollow noopener noreferrer"
                                       class="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:underline break-all">
                                        <span>@source.Url</span>
                                        <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-500" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                        </li>

                        i++;
                    }
                </ol>
            </div>
        }
    </div>
</section>
