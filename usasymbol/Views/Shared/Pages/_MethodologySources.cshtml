@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var sources = Model.Content?.Page?.Sources;
}

<div class="my-12 scroll-mt-24" aria-label="Sources and methodology">
    <div class="space-y-10">
        @if (!string.IsNullOrEmpty(Model.Content?.Page?.Methodology))
        {
            <div>
                <div class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-800">
                        <i class="fa-solid fa-flask text-sm" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <h2 class="mt-1 content-h2">Methodology</h2>
                    </div>
                </div>

                <p class="content-p mt-4 max-w-3xl text-slate-700">
                    @Model.Content.Page.Methodology.RenderAutoLinks()
                </p>
            </div>
        }

        @if (sources?.Any() == true)
        {
            <div class="border-t border-slate-200 pt-8">
                <div class="border-b border-slate-200/80 pb-4">
                    <h2 class="text-[1.8rem] font-semibold leading-none text-slate-900 sm:text-[2rem]">
                        Sources
                    </h2>
                </div>

                <div class="pt-5">
                    @await Html.PartialAsync("_SourceLinksList", sources)

                    <div class="mt-6 border-t border-slate-200/70 pt-4">
                        <div class="flex flex-col gap-2 text-[12px] text-slate-400 sm:flex-row sm:items-center sm:justify-between">
                            <div>Information is cross-referenced with official state archives.</div>
                            <div>
                                Found an error?
                                <a href="/contact" class="text-slate-900 hover:underline font-semibold">Report it here</a>.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
