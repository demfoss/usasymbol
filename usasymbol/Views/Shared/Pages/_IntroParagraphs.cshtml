@model USASymbol.Models.ViewModels.PageDetailViewModel
@using USASymbol.Extensions

@if (Model.HasIntroParagraphs)
{
    <section id="intro" class="scroll-mt-24" aria-label="Introduction">
        <div class="relative px-5 py-6 sm:px-6 lg:px-8 lg:py-7">
            <div class="absolute left-0 top-7 bottom-7 w-[3px] bg-[linear-gradient(180deg,#d8b36a_0%,#c46243_100%)]"></div>
            <div class="flex items-start gap-4 lg:gap-5">
                <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/75 text-slate-600">
                    <i class="fa-solid fa-compass text-sm" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Overview</p>
                    <div class="mt-3 max-w-3xl space-y-4">
                        @for (int i = 0; i < Model.Content.Page.IntroParagraphs.Count; i++)
                        {
                            var p = Model.Content.Page.IntroParagraphs[i];
                            var isLead = i == 0;
                            <p class="content-p @(isLead ? "text-slate-900" : "text-slate-700")">
                                @p.RenderAutoLinks()
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}
