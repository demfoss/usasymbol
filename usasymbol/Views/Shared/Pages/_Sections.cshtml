@model USASymbol.Models.ViewModels.PageDetailViewModel
@using USASymbol.Models.ViewModels
@using USASymbol.Models.Content
@using USASymbol.Extensions
@inject IImageUrlService Images

@functions {
    private static bool IsLawCardsSection(PageSection section)
    {
        if (string.Equals(section.Style, "law-cards", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (section.Highlights?.Any() == true)
        {
            return true;
        }

        if (section.Subsections?.Any() == true && section.Subsections.Any(sub => !string.IsNullOrWhiteSpace(sub.Status)))
        {
            return true;
        }

        return false;
    }
}

@{
    var visuals = Model as IHasVisualAssets;

    var fullWidthImg = visuals?.VisualAssets?.FirstOrDefault(v =>
        (v.Layout == "full-width" || v.Layout == "full-width-tall") &&
        string.IsNullOrWhiteSpace(v.Section));

    var pageContent = Model.Content;
    var quoteDone = false;
    var timelineDone = false;
    var statDone = false;
}

@if (Model.Content?.Sections != null && Model.Content.Sections.Any())
{
    var sections = Model.Content.Sections
        .Where(s => s.Id != "table-intro")
        .ToList();

    for (int i = 0; i < sections.Count; i++)
    {
        var sect = sections[i];
        var isFirst = i == 0;
        var style = sect.Style ?? string.Empty;

        var sectionAssets = visuals?.VisualAssets?
            .Where(v => !string.IsNullOrWhiteSpace(v.Section) &&
                        string.Equals(v.Section, sect.Id, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<VisualAsset>();

        var compareLeftAsset = sectionAssets.FirstOrDefault();
        var compareRightAsset = sectionAssets.Skip(1).FirstOrDefault();

        <div id="@sect.Id"
             class="scroll-mt-24 @(isFirst ? "pt-2 pb-8 md:pb-10" : "py-8 md:py-10")"
             aria-label="@sect.Title">

            @if (!string.IsNullOrWhiteSpace(sect.Icon))
            {
                <div class="mb-5 lg:mb-6 flex items-center gap-3 md:gap-4">
                    <span class="inline-flex h-9 w-9 shrink-0 min-h-[2.25rem] min-w-[2.25rem] items-center justify-center rounded-xl bg-slate-900 text-white">
                        <i class="@sect.Icon text-sm" aria-hidden="true"></i>
                    </span>
                    <h2 class="content-h2 !leading-[1.12]">
                        @sect.Title
                    </h2>
                </div>
            }
            else
            {
                <h2 class="content-h2 mb-5 lg:mb-6">
                    @sect.Title
                </h2>
            }

            @if (sectionAssets.Any() && style != "compare-cards")
            {
                var forceFullWidthAssets = sect.Table?.Rows?.Any() == true;
                foreach (var asset in sectionAssets)
                {
                    var renderedAsset = forceFullWidthAssets
                        ? new VisualAsset
                        {
                            Id = asset.Id,
                            Src = asset.Src,
                            Alt = asset.Alt,
                            Caption = asset.Caption,
                            Layout = "full-width-tall",
                            Section = asset.Section
                        }
                        : asset;

                    @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", renderedAsset)
                }
            }

            @if (sect.Paragraphs?.Any() == true)
            {
                <div class="mt-6 prose prose-lg prose-headings:scroll-mt-24 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-p:leading-relaxed text-gray-800">
                    @for (int p = 0; p < sect.Paragraphs.Count; p++)
                    {
                        var isLead = p == 0;
                        <p class="content-p @(isLead ? "text-gray-900" : "text-gray-800")">
                            @sect.Paragraphs[p].RenderAutoLinks()
                        </p>
                    }
                </div>
            }

            @if (sect.Table?.Rows?.Any() == true)
            {
                <div class="mt-6">
                    @await Html.PartialAsync("Components/Widgets/_SectionTable", sect.Table)
                </div>
            }

            @if (sect.Subsections?.Any() == true)
            {
                if (style == "compare-cards")
                {
                    @if (compareLeftAsset != null && compareRightAsset != null)
                    {
                        <div class="mt-6 overflow-hidden border border-slate-200 bg-white shadow-sm">
                            <div class="grid grid-cols-[1fr_auto_1fr]">
                                <figure class="relative aspect-[4/3] overflow-hidden bg-slate-50">
                                    <img src="@Images.Card(compareLeftAsset.Src)"
                                         alt="@compareLeftAsset.Alt"
                                         class="absolute inset-0 h-full w-full object-contain p-4"
                                         loading="lazy" />
                                    <button type="button"
                                            class="js-visual-lightbox absolute right-2 top-2 inline-flex h-9 w-9 items-center justify-center rounded-md bg-slate-900/80 text-white transition hover:bg-slate-900 focus:outline-none"
                                            data-lightbox-src="@Images.Full(compareLeftAsset.Src)"
                                            data-lightbox-alt="@compareLeftAsset.Alt"
                                            data-lightbox-caption="@(string.IsNullOrWhiteSpace(compareLeftAsset.Caption) ? compareLeftAsset.Alt : compareLeftAsset.Caption)"
                                            aria-label="Open image in popup">
                                        <i class="fa-solid fa-expand text-xs"></i>
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(compareLeftAsset.Caption))
                                    {
                                        <figcaption class="absolute inset-x-0 bottom-0 bg-white/90 px-3 py-1.5 text-center text-[10px] font-bold uppercase tracking-widest text-slate-500">
                                            @compareLeftAsset.Caption
                                        </figcaption>
                                    }
                                </figure>

                                <div class="flex w-12 items-center justify-center border-x border-slate-200 bg-white lg:w-16">
                                    <span class="select-none text-[11px] font-black tracking-widest text-slate-400 [writing-mode:vertical-rl]">VS</span>
                                </div>

                                <figure class="relative aspect-[4/3] overflow-hidden bg-slate-50">
                                    <img src="@Images.Card(compareRightAsset.Src)"
                                         alt="@compareRightAsset.Alt"
                                         class="absolute inset-0 h-full w-full object-contain p-4"
                                         loading="lazy" />
                                    <button type="button"
                                            class="js-visual-lightbox absolute right-2 top-2 inline-flex h-9 w-9 items-center justify-center rounded-md bg-slate-900/80 text-white transition hover:bg-slate-900 focus:outline-none"
                                            data-lightbox-src="@Images.Full(compareRightAsset.Src)"
                                            data-lightbox-alt="@compareRightAsset.Alt"
                                            data-lightbox-caption="@(string.IsNullOrWhiteSpace(compareRightAsset.Caption) ? compareRightAsset.Alt : compareRightAsset.Caption)"
                                            aria-label="Open image in popup">
                                        <i class="fa-solid fa-expand text-xs"></i>
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(compareRightAsset.Caption))
                                    {
                                        <figcaption class="absolute inset-x-0 bottom-0 bg-white/90 px-3 py-1.5 text-center text-[10px] font-bold uppercase tracking-widest text-slate-500">
                                            @compareRightAsset.Caption
                                        </figcaption>
                                    }
                                </figure>
                            </div>
                        </div>
                    }

                    <div class="mt-6 space-y-4">
                        @foreach (var sub in sect.Subsections)
                        {
                            <article class="border border-slate-200 bg-white p-5 lg:p-6 shadow-sm transition-all hover:border-slate-300 hover:shadow-md">
                                <div class="mb-3 flex items-center gap-3">
                                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white text-[10px]">
                                        <i class="fa-solid fa-scale-balanced text-[9px]"></i>
                                    </span>
                                    <h3 class="text-base lg:text-lg font-semibold tracking-tight text-slate-900">@sub.Subtitle</h3>
                                </div>

                                @if (!string.IsNullOrEmpty(sub.Text))
                                {
                                    <div class="prose prose-slate prose-sm max-w-none pl-11 text-slate-600 leading-relaxed">
                                        <p>@sub.Text.RenderAutoLinks()</p>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
                else if (IsLawCardsSection(sect))
                {
                    @await Html.PartialAsync("Components/Cards/_LawCardsSection", (sect, (IReadOnlyList<VisualAsset>)(visuals?.VisualAssets ?? Array.Empty<VisualAsset>())))
                }
                else if (style == "gradient")
                {
                }
                else
                {
                    <div class="mt-6 space-y-6">
                        @foreach (var sub in sect.Subsections)
                        {
                            <article>
                                <h3 class="content-h3 text-slate-900">@sub.Subtitle</h3>

                                @if (!string.IsNullOrEmpty(sub.Text))
                                {
                                    <div class="mt-4 prose prose-lg text-gray-800">
                                        <p>@sub.Text.RenderAutoLinks()</p>
                                    </div>
                                }

                                @if (sub.Link != null && !string.IsNullOrWhiteSpace(sub.Link.Url))
                                {
                                    <div class="mt-4">
                                        <a href="@sub.Link.Url"
                                           target="@(sub.Link.Url.IsExternalUrl() ? "_blank" : null)"
                                           rel="@(sub.Link.Url.IsExternalUrl() ? "nofollow noopener noreferrer" : null)"
                                           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition hover:text-slate-700">
                                            <span>@(string.IsNullOrWhiteSpace(sub.Link.Label) ? "Learn more" : sub.Link.Label)</span>
                                            <i class="fas fa-arrow-right text-xs"></i>
                                        </a>
                                    </div>
                                }

                                <div class="clear-both"></div>
                            </article>
                        }
                    </div>
                }
            }

            @if (sect.Highlights?.Any() == true)
            {
                @if (sect.Subsections?.Any() != true)
                {
                    @await Html.PartialAsync("Components/Cards/_LawCardsSection", (sect, (IReadOnlyList<VisualAsset>)(visuals?.VisualAssets ?? Array.Empty<VisualAsset>())))
                }
                else if (!IsLawCardsSection(sect))
                {
                    <div class="mt-6 space-y-4">
                        @foreach (var h in sect.Highlights)
                        {
                            <article class="overflow-hidden border border-slate-200 bg-white">
                                <div class="grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] lg:grid-cols-[220px_minmax(0,1fr)]">
                                    @if (!string.IsNullOrEmpty(h.Image))
                                    {
                                        <div class="relative aspect-square sm:aspect-auto bg-slate-100 sm:min-h-[180px] lg:min-h-[220px]">
                                            <img src="@Images.Card(h.Image)"
                                                 alt="@h.Name"
                                                 class="absolute inset-0 h-full w-full object-cover"
                                                 loading="lazy" decoding="async" />
                                        </div>
                                    }
                                    <div class="flex min-w-0 flex-col justify-center px-5 py-5 lg:px-6 lg:py-6">
                                        <h3 class="text-[18px] font-bold leading-snug text-black">@h.Name</h3>
                                        <div class="mt-2 text-[16px] leading-7 text-slate-700 [&_p]:m-0 [&_p]:text-[16px] [&_p]:leading-7 [&_p]:text-slate-700">
                                            @h.Description.RenderMarkdown()
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            }

            @if (sect.Facts?.Any() == true)
            {
                if (style == "gradient")
                {
                    <div class="mt-6 grid gap-3 sm:grid-cols-2">
                        @{
                            var factIndex = 1;
                        }
                        @foreach (var fact in sect.Facts)
                        {
                            <div class="border border-slate-200 bg-[linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)] p-4 shadow-sm">
                                <div class="flex items-start gap-3">
                                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-[11px] font-semibold text-white">@factIndex</span>
                                    <span class="text-[14px] leading-6 text-slate-700">@fact.RenderMarkdown()</span>
                                </div>
                            </div>
                            factIndex++;
                        }
                    </div>
                }
                else
                {
                    <div class="mt-4 grid gap-3">
                        @foreach (var fact in sect.Facts)
                        {
                            <div class="border border-slate-200 bg-white px-4 py-3 shadow-sm">
                                <div class="flex items-start gap-2.5 text-[15px] md:text-[16px] leading-7 text-slate-700">
                                    <i class="fa-solid fa-circle-check text-slate-400 text-xs mt-[5px] shrink-0"></i>
                                    <span>@fact.RenderMarkdown()</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <div class="clear-both"></div>
        </div>

        @if (i == 0 && !quoteDone && pageContent?.ExpertQuote != null)
        {
            @await Html.PartialAsync("Components/Story/_ExpertQuote", pageContent.ExpertQuote)
            quoteDone = true;
        }

        @if (i == 1 && !timelineDone && pageContent?.Timeline?.Any() == true)
        {
            @await Html.PartialAsync("Components/Story/_Timeline", (IReadOnlyList<TimelineEvent>)pageContent.Timeline)
            timelineDone = true;
        }

        @if (i == 1 && !statDone && pageContent?.BigStat != null)
        {
            @await Html.PartialAsync("Components/Story/_BigStat", pageContent.BigStat)
            statDone = true;
        }

        if (i != sections.Count - 1)
        {
            <div class="my-6 md:my-7 h-px bg-slate-200"></div>
        }
    }
}

@if (fullWidthImg != null && !string.IsNullOrEmpty(fullWidthImg.Src))
{
    <div class="mt-10">
        @await Html.PartialAsync("Components/VisualAsset/_VisualAssetRenderer", fullWidthImg)
    </div>
}
