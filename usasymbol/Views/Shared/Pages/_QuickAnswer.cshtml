@model USASymbol.Models.ViewModels.PageDetailViewModel

@{
    var sectionId = (ViewData["QuickAnswerSectionId"] as string ?? "quick-answer").Trim();
}

@if (Model.HasQuickAnswer)
{
    <section id="@sectionId" class="scroll-mt-24" aria-label="Quick answer">
        <div class="overflow-hidden rounded-[1.55rem] border border-slate-200/80 bg-white/50">
            <div class="border-b border-slate-200/80 px-5 py-4">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-50 text-slate-700">
                            <i class="fa-solid fa-bolt text-sm" aria-hidden="true"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Quick Answer</p>
                            <h2 class="mt-1 content-h2">What matters most</h2>
                        </div>
                    </div>

                    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200/80 bg-white/80 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                        <i class="fa-solid fa-shield-check text-[10px]"></i>
                        Editorial Summary
                    </span>
                </div>
            </div>

            <div class="p-5 sm:p-6">
            <ol class="space-y-5">
                @for (int i = 0; i < Model.Content.Page.QuickAnswer.Count; i++)
                {
                    var answer = Model.Content.Page.QuickAnswer[i];
                    var isLead = i == 0;

                    <li class="flex gap-4 border-t border-slate-200 pt-5 first:border-t-0 first:pt-0">
                        <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-900 tabular-nums">
                            @(i + 1)
                        </span>

                        <p class="content-p @(isLead ? "font-semibold text-slate-900" : "text-slate-700")">
                            @answer
                        </p>
                    </li>
                }
            </ol>

            <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-5">
                <button id="shareButton"
                        class="inline-flex min-h-[44px] items-center gap-2 text-sm font-semibold text-slate-900 transition hover:text-slate-700">
                    <i class="fa-solid fa-share-nodes text-xs" aria-hidden="true"></i>
                    Share
                </button>

                <button id="copyLinkBtn"
                        class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-slate-50">
                    <i class="fa-regular fa-copy text-xs" aria-hidden="true"></i>
                    Copy link
                </button>
            </div>
            </div>
        </div>
    </section>
}
