@model USASymbol.Models.ViewModels.PageDetailViewModel

@if (Model.HasFaq)
{
    <section id="faq" class="py-10 md:py-12 scroll-mt-24" aria-label="FAQ">
        <div class="flex items-center gap-4">
            <span class="h-3 w-3 rounded-sm bg-amber-400"></span>
            <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <h2 class="mt-4 content-h2 flex items-center gap-3">
            <i class="fa-regular fa-circle-question text-slate-900/80" aria-hidden="true"></i>
            Frequently Asked Questions
        </h2>

        <div class="mt-6">
            <div class="divide-y divide-slate-200 border-t border-slate-200">
                @foreach (var faq in Model.Content.Faq)
                {
                    <details class="group py-5">
                        <summary class="list-none cursor-pointer select-none">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex items-start gap-3">
                                    <span class="mt-1 h-2 w-2 rounded-sm bg-amber-400 flex-shrink-0"></span>
                                    <span class="content-p font-semibold text-slate-900">
                                        @faq.Question
                                    </span>
                                </div>

                                <span class="mt-1 inline-flex h-8 w-8 items-center justify-center text-slate-700 group-open:rotate-180 transition-transform">
                                    <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
                                </span>
                            </div>
                        </summary>

                        <div class="mt-3 pl-5 md:pl-6">
                            <div class="content-p max-w-3xl text-slate-700">
                                @faq.Answer.RenderAutoLinks()
                            </div>
                        </div>
                    </details>
                }
            </div>
        </div>
    </section>
}
