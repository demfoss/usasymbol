@model USASymbol.Models.ViewModels.PageDetailViewModel

@if (Model.HasRows)
{
    var slug = Model.Content?.Slug ?? "list";
    var pageTitle = Model.Content?.Page?.H1 ?? Model.Content?.Slug ?? "List";
    var isRanking = Model.IsRanking;
    var isCollection = Model.IsCollection;
    var category = (Model.Content?.Category ?? "").Trim().ToLowerInvariant();

    var sourceValue = isRanking ? "rankings" : isCollection ? "collections" : "";

    <section class="mb-4">
        <div class="w-full max-w-4xl border border-slate-200 bg-slate-50">
            <div class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex min-w-0 items-center gap-4">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center border border-slate-300 bg-white">
                        <i class="fa-regular fa-file-pdf text-xl text-slate-600" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="font-sans text-sm font-semibold leading-snug text-slate-900">
                            Download as PDF
                        </p>
                        <p class="mt-0.5 font-sans text-sm leading-snug text-slate-500">
                            Print-ready table — @pageTitle
                        </p>
                    </div>
                </div>

                <form asp-controller="Print" asp-action="Download" method="post" class="shrink-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="slug" value="@slug" />
                    @if (!string.IsNullOrWhiteSpace(sourceValue))
                    {
                        <input type="hidden" name="source" value="@sourceValue" />
                    }
                    @if (!string.IsNullOrWhiteSpace(category))
                    {
                        <input type="hidden" name="category" value="@category" />
                    }
                    <button type="submit"
                            class="inline-flex h-9 w-full items-center justify-center gap-2 border border-black bg-black px-4 font-sans text-xs font-semibold tracking-wide text-white transition hover:bg-neutral-800 sm:w-auto"
                            aria-label="Download PDF for @pageTitle"
                            title="Download PDF for @pageTitle">
                        <i class="fa-solid fa-arrow-down-to-line text-xs" aria-hidden="true"></i>
                        <span>Download PDF</span>
                    </button>
                </form>
            </div>
        </div>
    </section>
}
