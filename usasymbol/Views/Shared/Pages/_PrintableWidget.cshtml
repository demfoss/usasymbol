@model USASymbol.Models.ViewModels.PageDetailViewModel

@if (Model.HasRows)
{
    var slug = Model.Content?.Slug ?? "list";
    var pageTitle = Model.Content?.Page?.H1 ?? Model.Content?.Slug ?? "List";
    var isRanking = Model.IsRanking;
    var isCollection = Model.IsCollection;
    var category = (Model.Content?.Category ?? "").Trim().ToLowerInvariant();

    var sourceValue = isRanking ? "rankings" : isCollection ? "collections" : "";

    <section class="mb-3 mt-4">
        <div class="w-full max-w-4xl border border-slate-200 bg-white">
            <div class="flex flex-col gap-1.5 px-3 py-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex min-w-0 items-start gap-1.5">
                    <i class="fa-regular fa-file-pdf mt-0.5 shrink-0 text-[12px] leading-none text-black" aria-hidden="true"></i>
                    <div class="min-w-0">
                        <p class="font-sans text-[11px] font-semibold leading-[1.2] text-black">
                            Download this table as a PDF
                        </p>
                        <p class="mt-0.5 font-sans text-[10px] leading-[1.3] text-black">
                            Clean, print-ready version of @pageTitle.
                        </p>
                    </div>
                </div>

                <form asp-controller="Print" asp-action="Download" method="post" class="shrink-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="slug" value="@slug" />
                    @if (!string.IsNullOrWhiteSpace(sourceValue))
                    {
                        <input type="hidden" name="source" value="@sourceValue" />
                    }
                    @if (!string.IsNullOrWhiteSpace(category))
                    {
                        <input type="hidden" name="category" value="@category" />
                    }
                    <button type="submit"
                            class="inline-flex min-h-[32px] w-full items-center justify-center gap-1.5 border border-black bg-black px-2.5 py-1.5 font-sans text-[11px] font-semibold text-white transition hover:bg-neutral-800 sm:w-auto"
                            aria-label="Download PDF for @pageTitle"
                            title="Download PDF for @pageTitle">
                        <i class="fa-solid fa-download text-xs" aria-hidden="true"></i>
                        <span>Download PDF</span>
                    </button>
                </form>
            </div>
        </div>
    </section>
}
