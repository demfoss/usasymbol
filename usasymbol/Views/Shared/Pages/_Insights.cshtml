@model USASymbol.Models.ViewModels.PageDetailViewModel
@using USASymbol.Extensions

@if (Model.HasInsights)
{
    <section id="insights" class="scroll-mt-24" aria-label="Key facts">
        <div class="rounded-[1.7rem] border border-slate-200/80 bg-white p-6 sm:p-7">
            <div class="flex items-start gap-4">
                <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-slate-50 text-slate-700">
                    <i class="fa-regular fa-lightbulb text-sm" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Key Insights</p>
                    <h2 class="mt-1 content-h2">What stands out</h2>
                </div>
            </div>

            <ul class="mt-6 space-y-2.5">
                @foreach (var insight in Model.Content.Page.Insights)
                {
                    <li class="content-p flex items-start gap-3 text-slate-700">
                        <i class="fa-solid fa-circle-check text-slate-400 text-xs mt-[5px] shrink-0" aria-hidden="true"></i>
                        <span>@insight.RenderMarkdown()</span>
                    </li>
                }
            </ul>
        </div>
    </section>
}
