@model USASymbol.Models.ViewModels.PageDetailViewModel
@using Usasymbol.Helpers
@using USASymbol.Extensions
@using USASymbol.Services
@using System.Globalization

@{
    var sectionId = (ViewData["QuickAnswerSectionId"] as string ?? "quick-answer").Trim();
    var tableSectionId = (ViewData["RankingTableSectionId"] as string ?? "ranking-table").Trim();
    var rank = RankingTakeawaysBuilder.Build(Model);
    var stories = rank == null && Model.HasQuickAnswer
        ? KeyTakeawaysBuilder.BuildBigNumberStories(Model.Content.Page.QuickAnswer)
        : new List<BigNumberStory>();
    var req = Context.Request;
    var pagePath = !string.IsNullOrWhiteSpace(Model.Content.Url) ? Model.Content.Url : req.Path.Value;
    var absUrl = $"{req.Scheme}://{req.Host}{pagePath}";
    var firstSource = Model.Content.Page.Sources?.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.Name))?.Name;
    var citeText = $"USA Symbol. “{Model.Content.Page.H1}.” {absUrl}"
        + (string.IsNullOrWhiteSpace(firstSource) ? "" : $" Data: {firstSource}.");
}

@if (rank != null)
{
    <section id="@sectionId" class="kt-rank scroll-mt-24" aria-labelledby="kt-rank-title" data-kt-table="@tableSectionId">
        <h2 id="kt-rank-title" class="kt-rank__title">Key takeaways</h2>
        <p class="kt-rank__summary">@rank.Summary</p>

        <div class="kt-rank__personal" data-kt-personal>
            <div class="kt-rank__head">
                <label for="kt-you-select" class="kt-rank__you-label">How does your state compare?</label>
            </div>
            <label class="kt-rank__you">
                <select id="kt-you-select" data-kt-you aria-controls="kt-state-result">
                    <option value="">Choose your state</option>
                    @foreach (var o in rank.Options)
                    {
                        var target = o.Slug == rank.Leader.Slug ? rank.Alternative : rank.Leader;
                        var compareUrl = rank.HasSpread ? "/compare/" + ComparisonService.CanonicalPairSlug(o.Slug, target.Slug) : "";
                        <option value="@o.Slug" data-statement="@o.Statement" data-context="@o.Context" data-typical="@(o.IsTypical ? "true" : "false")" data-postal="@o.Postal"
                                data-position="@o.Position.ToString("0.###", CultureInfo.InvariantCulture)"
                                data-compare-url="@compareUrl" data-compare-name="@target.Name">@o.Name</option>
                    }
                </select>
            </label>

            <p class="kt-rank__geo" data-kt-geo hidden>Selected from your location. Change it any time.</p>
            <div id="kt-state-result" class="kt-rank__result" data-kt-result hidden>
                <div aria-live="polite" aria-atomic="true">
                    <p class="kt-rank__statement" data-kt-statement></p>
                    <p class="kt-rank__context" data-kt-context></p>
                    <p class="kt-rank__typical" data-kt-typical>@rank.TypicalStatement</p>
                </div>

                @if (rank.HasSpread)
                {
                    <div class="kt-rank__scale" role="img" data-kt-scale data-kt-scale-leader="@rank.Leader.Statement">
                        <div class="kt-rank__median-label" aria-hidden="true" style="left:@rank.TypicalPosition.ToString("0.###", CultureInfo.InvariantCulture)%">Typical</div>
                        <div class="kt-rank__track" aria-hidden="true">
                            @foreach (var dot in rank.DotPositions)
                            {
                                <span class="kt-rank__dot" style="left:@dot.ToString("0.###", CultureInfo.InvariantCulture)%"></span>
                            }
                            <span class="kt-rank__marker kt-rank__marker--typical" style="left:@rank.TypicalPosition.ToString("0.###", CultureInfo.InvariantCulture)%"></span>
                            <span class="kt-rank__marker kt-rank__marker--leader" style="left:@rank.Leader.Position.ToString("0.###", CultureInfo.InvariantCulture)%"></span>
                            <span class="kt-rank__marker kt-rank__marker--you" data-kt-marker></span>
                        </div>
                        <div class="kt-rank__ends" aria-hidden="true"><span>@rank.MinLabel</span>@if (rank.LogScale) { <span class="kt-rank__log">log scale</span> }<span>@rank.MaxLabel</span></div>
                        <div class="kt-rank__legend" aria-hidden="true">
                            <span><i class="kt-rank__key kt-rank__key--you"></i><span data-kt-scale-name></span></span>
                            <span><i class="kt-rank__key kt-rank__key--dot"></i>Other states</span>
                            <span><i class="kt-rank__key kt-rank__key--typical"></i>Typical state</span>
                            <span><i class="kt-rank__key kt-rank__key--leader"></i>@rank.Leader.Name</span>
                        </div>
                    </div>
                }

                <div class="kt-rank__actions">
                    <a class="kt-rank__compare-button" data-kt-compare hidden></a>
                    <label class="kt-rank__compare-any" data-kt-compare-any-wrap hidden>
                        <select data-kt-compare-any aria-label="Compare with another state"></select>
                    </label>
                    <a href="#@tableSectionId" class="kt-rank__table-link" data-kt-row><span class="kt-rank__table-text">See in table</span> <span aria-hidden="true">→</span></a>
                    <button type="button" class="kt-rank__share" data-kt-share><i class="fa-solid fa-share-nodes" aria-hidden="true"></i> <span>Share</span></button>
                </div>
            </div>
            <noscript><p><a href="#@tableSectionId">Find your state in the full table.</a></p></noscript>
        </div>

        @if (rank.Facts.Count > 0)
        {
            <ul class="kt-rank__facts">
                @foreach (var fact in rank.Facts)
                {
                    <li>
                        @if (fact.States.Count > 0)
                        {
                            <details class="kt-rank__disclosure">
                                <summary>@fact.Text <span class="kt-rank__list-hint">View states</span></summary>
                                <ul class="kt-rank__state-list">
                                    @foreach (var state in fact.States)
                                    {
                                        <li><a href="#@tableSectionId" data-kt-row="@state.Slug">@state.Name</a></li>
                                    }
                                </ul>
                            </details>
                        }
                        else
                        {
                            @fact.Text
                        }
                    </li>
                }
            </ul>
        }

    </section>
    <script src="~/js/rankings/takeaways.js" asp-append-version="true" defer></script>
}
else if (stories.Count >= 2)
{
    <section id="@sectionId" class="kt-story scroll-mt-24" aria-labelledby="kt-story-title">
        <h2 id="kt-story-title" class="kt-story__title">Key takeaways</h2>
        <div class="kt-story__grid @(stories.Count == 2 ? "kt-story__grid--2" : "")">
            @foreach (var story in stories)
            {
                <article class="kt-story__card">
                    @if (!string.IsNullOrWhiteSpace(story.Subject))
                    {
                        <p class="kt-story__subject">
                            @if (!string.IsNullOrWhiteSpace(story.SubjectSlug))
                            {
                                <a href="/states/@story.SubjectSlug">@story.Subject</a>
                            }
                            else
                            {
                                @story.Subject
                            }
                        </p>
                    }
                    <div class="kt-story__number">@story.Number</div>
                    <p class="kt-story__copy">@story.Copy.RenderAutoLinks()</p>
                </article>
            }
        </div>
    </section>
}
else if (Model.HasQuickAnswer)
{
    @await Html.PartialAsync("Pages/_QuickAnswer", Model, ViewData)
}
