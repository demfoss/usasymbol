@{
    var heading = ViewData["Heading"] as string ?? "";
    var body = ViewData["Body"] as IHtmlContent;
    var extra = ViewData["Extra"] as IHtmlContent;
}
<div id="overview" class="mt-10">
    <div class="bg-stone-50 px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
        <h2 class="content-h2 mb-5">@heading</h2>
        @if (body != null)
        {
            <div class="prose prose-slate prose-lg max-w-none text-slate-700 overview-dropcap">
                @body
            </div>
        }
        @if (extra != null)
        {
            @extra
        }
    </div>
</div>
