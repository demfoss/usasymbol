@if (Model.SymbolOfTheDayPool.Any() && first != null)
{
    <section class="hs hs-white">
        <div class="max-w-4xl mx-auto px-4">
            <div class="hs-eyebrow">
                <i class="fa-solid fa-star"></i>
                Symbol of the Day
            </div>
            <div class="sotd-card" id="sotd-card">
                <div class="sotd-toolbar">
                    <span class="hero-pill">
                        <i class="fa-solid fa-star"></i>
                        Featured Symbol
                    </span>
                    <button id="sotd-next" class="sotd-next-btn">
                        <i class="fa-solid fa-shuffle"></i>
                        Next Symbol
                    </button>
                </div>
                <div class="sotd-inner">
                    <div class="sotd-media">
                        <img id="sotd-img"
                             src="@Images.Hero(first.Symbol.ImageUrl)"
                             alt="@(first.Symbol.Name)"
                             loading="eager" />
                        <span id="sotd-type-badge" class="sotd-type-badge">@firstTypeLabel</span>
                    </div>
                    <div class="sotd-info">
                        <div class="sotd-state-row">
                            <img id="sotd-flag"
                                 src="@Images.Thumb($"/images/states/flags/small/{first.State.Abbreviation.ToLowerInvariant()}.webp")"
                                 alt="@(first.State.Name) flag"
                                 class="sotd-flag"
                                 onerror="this.style.display='none'" />
                            <span id="sotd-state" class="sotd-state-text">@first.State.Name</span>
                        </div>
                        <h2 id="sotd-name" class="sotd-name">@first.Symbol.Name</h2>
                        <p id="sotd-meaning" class="sotd-meaning">
                            @if (!string.IsNullOrWhiteSpace(first.Symbol.Meaning))
                            {
                                @(first.Symbol.Meaning.Length > 200 ? first.Symbol.Meaning[..200] + "..." : first.Symbol.Meaning)
                            }
                            else
                            {
                                <text>The official @firstTypeLabel of @first.State.Name.</text>
                            }
                        </p>
                        <div class="sotd-actions">
                            <a id="sotd-link"
                               href="@first.Symbol.ToSymbolUrl(first.State.Slug)"
                               class="sotd-btn-primary">
                                View Symbol <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                            <a id="sotd-state-link"
                               href="/states/@(first.State.Slug)"
                               class="sotd-btn-secondary">
                                @first.State.Name
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script type="application/json" id="sotd-pool">@Html.Raw(poolJson)</script>
}

