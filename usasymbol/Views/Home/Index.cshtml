        <div class="hero-pill inline-flex mb-5">
            <i class="fa-solid fa-feather-pointed"></i>
            Complete 50-State Encyclopedia
        </div>
        <h1 class="hero-title">
            Official State Symbols<br>of All 50 U.S. States
        </h1>
        <p class="hero-subtitle">
            Explore every official U.S. state symbol — flags, birds, flowers, trees, mottos, seals, nicknames, and 20+ more categories across all 50 states.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/states" class="hero-cta-btn hero-cta-btn--light">
                <i class="fa-solid fa-map-location-dot"></i>
                Browse by State
            </a>
            <a href="/symbols" class="hero-cta-btn hero-cta-btn--ghost">
                <i class="fa-solid fa-layer-group"></i>
                Explore Categories
            </a>
        </div>
    </div>
</section>

@if (initialMapState != null && stateMapLookup.Any())
{
    <section class="home-map-section">
        <div class="home-map-shell">
            <div class="home-map-card">
                <div class="home-map-layout">
                    <div class="home-map-copy">
                        <div class="hs-eyebrow">
                            <i class="fa-solid fa-map"></i>
                            State Map
                        </div>
                        <h2 class="content-h2">Browse State Symbols by Map</h2>
                        <p>Choose any tile to explore its state's flags, birds, flowers, trees, mottos, seals, and other official symbols.</p>

                        <div class="home-map-detail" id="home-map-detail" aria-live="polite">
                            <div class="home-map-detail__eyebrow">Selected state</div>
                            <h3 class="home-map-detail__state" id="home-map-state">@initialMapState.Name</h3>
                            <div class="home-map-detail__meta">
                                <div class="home-map-detail__fact">
                                    <span>Capital</span>
                                    <strong id="home-map-capital">@initialMapState.Capital</strong>
                                </div>
                                <div class="home-map-detail__fact">
                                    <span>Population</span>
                                    <strong id="home-map-population">@initialMapPopulation</strong>
                                </div>
                            </div>
                            <a class="home-map-detail__link"
                               id="home-map-state-link"
                               href="/states/@initialMapState.Slug">
                                <span id="home-map-state-link-label">Explore @initialMapState.Name symbols</span>
                                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>

                    <div class="home-map-visual">
                        <div class="home-map-visual__top">
                            <span>50-state tile map</span>
                            <span class="home-map-hint">
                                <i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i>
                                Hover to preview · click to open
                            </span>
                        </div>

                        <nav class="home-map-tiles" id="home-state-map" aria-label="Browse symbols by state">
                            @foreach (var row in stateTileRows)
                            {
                                @foreach (var abbreviation in row)
                                {
                                    if (string.IsNullOrEmpty(abbreviation))
                                    {
                                        <span class="home-map-tile home-map-tile--empty" aria-hidden="true"></span>
                                    }
                                    else if (stateMapLookup.TryGetValue(abbreviation, out var state))
                                    {
                                        var statePopulation = state.Population is int tilePopulation
                                            ? tilePopulation.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                            : "Not available";
                                        var isInitialState = string.Equals(state.Abbreviation, initialMapState.Abbreviation, StringComparison.OrdinalIgnoreCase);
                                        <a class="home-map-tile@(isInitialState ? " is-selected" : "")"
                                           href="/states/@state.Slug"
                                           data-state-name="@state.Name"
                                           data-state-capital="@state.Capital"
                                           data-state-population="@statePopulation"
                                           aria-label="Explore @state.Name state symbols"
                                           aria-current="@(isInitialState ? "true" : null)">
                                            @state.Abbreviation
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="home-map-tile home-map-tile--unavailable" aria-hidden="true">@abbreviation</span>
                                    }
                                }
                            }
                        </nav>

                        <div class="home-map-legend" aria-hidden="true">
                            <span><i></i>State symbols available</span>
                            <strong>50 of 50 states</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="hs hs-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-end justify-between gap-4 flex-wrap mb-6">
            <div>
                <div class="hs-eyebrow">
                    <i class="fa-solid fa-bookmark"></i>
                    Symbol Types
                </div>
                <h2 class="content-h2 home-category-heading">Browse State Symbols by Category</h2>
            </div>
            <a href="/symbols" class="cta-btn cta-btn-outline cta-btn--compact">
                View All Symbols <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>
        <div class="category-grid">
            @foreach (var category in Model.SymbolCategories.Take(8))
            {
                var stateLabel = category.StateCount == 1 ? "1 state" : $"{category.StateCount} states";
                var shortDescription = string.IsNullOrWhiteSpace(category.Description)
                    ? "Browse official state symbol listings and guides."
                    : category.Description;
                <a href="@category.Url" class="category-card category-card--home">
                    <div class="category-card__media">
                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                        {
                            <img src="@Images.Card(category.ImageUrl)"
                                 srcset="@Images.CardSrcSet(category.ImageUrl, 240, 360, 480)"
                                 sizes="(max-width: 639px) 44vw, (max-width: 1023px) 30vw, 23vw"
                                 alt="@category.Name"
                                 loading="lazy">
                        }
                        else
                        {
                            <div class="category-card__icon" aria-hidden="true">
                                <i class="@category.Icon"></i>
                            </div>
                        }
                        <span class="category-card__pill">@stateLabel</span>
                    </div>
                    <div class="category-card__body">
                        <div class="category-card__eyebrow">Symbol Category</div>
                        <div class="category-card__title">@category.Name</div>
                        <p class="category-card__desc">@shortDescription</p>
                        <div class="category-card__footer">
                            <span class="category-card__count">@stateLabel</span>
                            <span class="category-card__link">Explore <i class="fa-solid fa-arrow-right"></i></span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

