                        </div>
                        <h2 id="sotd-name" class="sotd-name">@first.Symbol.Name</h2>
                        <p id="sotd-meaning" class="sotd-meaning">
                            @if (!string.IsNullOrWhiteSpace(first.Symbol.Meaning))
                            {
                                @(first.Symbol.Meaning.Length > 200 ? first.Symbol.Meaning[..200] + "..." : first.Symbol.Meaning)
                            }
                            else
                            {
                                <text>The official @firstTypeLabel of @first.State.Name.</text>
                            }
                        </p>
                        <div class="sotd-actions">
                            <a id="sotd-link"
                               href="@first.Symbol.ToSymbolUrl(first.State.Slug)"
                               class="sotd-btn-primary">
                                View Symbol <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
