@model USASymbol.Models.ViewModels.HomeViewModel
@inject IImageUrlService Images
@{
    ViewData["Title"] = "Explore the United States — States, Symbols & Guides";
    ViewData["Description"] = "Explore all 50 U.S. states with state symbols, living guides, rankings, national parks, maps, and practical lookup tools.";
    ViewData["Canonical"] = "/";
    ViewData["OgImage"] = "/images/usasymbol.png?v=20260429";
    ViewData["BodyClass"] = "home-page";
    var heroImage = Images.Hero("/images/parks/national/yosemite-national-park/01-overview-yosemite-valley-taft-point-sentinel-dome.jpg");

    var states = Model.StateMapItems.ToDictionary(state => state.Abbreviation, StringComparer.OrdinalIgnoreCase);
    var selectedState = states.GetValueOrDefault("CA") ?? Model.StateMapItems.FirstOrDefault();
    var featuredStates = new[] { "CA", "TX", "FL", "NY", "PA" };
    var tiles = new[]
    {
        new[] { "AK", "", "", "", "", "", "", "", "", "", "ME" },
        new[] { "", "", "", "", "", "", "", "", "", "VT", "NH" },
        new[] { "WA", "ID", "MT", "ND", "MN", "WI", "IL", "MI", "NY", "RI", "MA" },
        new[] { "OR", "NV", "WY", "SD", "IA", "IN", "OH", "PA", "NJ", "CT", "" },
        new[] { "CA", "UT", "CO", "NE", "MO", "KY", "WV", "VA", "MD", "DE", "" },
        new[] { "", "AZ", "NM", "KS", "AR", "TN", "NC", "SC", "", "", "" },
        new[] { "", "", "OK", "LA", "MS", "AL", "GA", "", "", "", "" },
        new[] { "HI", "", "TX", "", "", "", "", "", "FL", "", "" }
    };
    var symbols = new[]
    {
        (Slug: "birds", Name: "State Birds", Image: "/images/birds/eastern-bluebird.webp", Alt: "Eastern bluebird", Copy: "Meet the birds that represent each state's wildlife and character."),
        (Slug: "flowers", Name: "State Flowers", Image: "/images/flowers/sunflower.webp", Alt: "Sunflower, the state flower of Kansas", Copy: "Discover the blooms chosen as official floral emblems."),
        (Slug: "trees", Name: "State Trees", Image: "/images/trees/california-redwood.webp", Alt: "California redwoods viewed from the forest floor", Copy: "Explore the trees rooted in each state's landscape and heritage."),
        (Slug: "flags", Name: "State Flags", Image: "/images/states/flags/large/ca.webp", Alt: "California state flag", Copy: "Uncover the history, colors, and meaning behind every state flag.")
    };
    var compactSymbols = new[]
    {
        (Slug: "mottos", Name: "State Mottos", Icon: "fa-scroll", Copy: "Official phrases and their meanings"),
        (Slug: "state-seals", Name: "State Seals", Icon: "fa-stamp", Copy: "Great seals and official emblems"),
        (Slug: "coats-of-arms", Name: "Coats of Arms", Icon: "fa-shield-halved", Copy: "Historic heraldry and official arms"),
        (Slug: "sports", Name: "State Sports", Icon: "fa-medal", Copy: "Sports and heritage activities")
    };
    var references = new[]
    {
        (Url: "/guides/state-abbreviations", Name: "State Abbreviations", Icon: "fa-font", Copy: "Postal codes, traditional abbreviations, and common mix-ups."),
        (Url: "/tools/state-capital-flashcards", Name: "State Capitals", Icon: "fa-landmark", Copy: "Learn all 50 capital cities with interactive flashcards."),
        (Url: "/guides/surnames", Name: "Last Names by State", Icon: "fa-users", Copy: "Discover common surnames and the stories behind them."),
        (Url: "/guides/state-borders", Name: "State Borders", Icon: "fa-map", Copy: "Neighboring states, coastlines, rivers, and waterways."),
        (Url: "/tools/timezone-finder", Name: "Time Zones", Icon: "fa-clock", Copy: "Find local time zones by state, city, or ZIP code."),
        (Url: "/tools/zip-code-lookup", Name: "ZIP Code Lookup", Icon: "fa-location-dot", Copy: "Look up cities, counties, and states by ZIP code.")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-hub.css" asp-append-version="true" />
}
@section LcpPreload {
    <link rel="preload" as="image" href="@heroImage" />
}

<div class="home-hub">
    <section class="hub-intro" aria-labelledby="home-title" style="--hub-hero-image: url('@heroImage')">
        <div class="hub-wrap">
            <nav class="hub-breadcrumbs" aria-label="Breadcrumb"><span aria-current="page"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</span></nav>
            <p class="hub-eyebrow">States / People / Places / Data</p>
            <h1 id="home-title">Explore the United States</h1>
            <p class="hub-intro-copy">Fifty states. Countless stories. Discover the places, symbols, and facts that make America unique — and find your next place to explore.</p>
            <div class="hub-featured">
                <a class="hub-feature hub-feature--photo" href="/states/living">
                    <img src="@Images.Card("/images/state-living/new-york/pexels-975399.jpg")" alt="" width="940" height="627" />
                    <span class="hub-icon"><i class="fa-solid fa-house-chimney" aria-hidden="true"></i></span>
                    <span class="hub-kicker">Live well</span><h2>State Living Guides</h2>
                    <p>Compare costs, housing, safety, schools, and quality of life.</p>
                    <span class="hub-cta">Browse living guides <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
                <a class="hub-feature hub-feature--photo hub-feature--blue" href="/rankings">
                    <img src="@Images.Card("/images/rankings/demographics/states-by-population-map.webp")" alt="" width="940" height="627" />
                    <span class="hub-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                    <span class="hub-kicker">Data insights</span><h2>State Rankings</h2>
                    <p>See how states compare on affordability, health, education, and more.</p>
                    <span class="hub-cta">Browse rankings <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
                <a class="hub-feature hub-feature--photo hub-feature--light" href="/state-match">
                    <img src="@Images.Card("/images/state-living/new-york/pexels-17231430.jpg")" alt="" width="940" height="627" />
                    <span class="hub-icon"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></span>
                    <span class="hub-kicker">Find your fit</span><h2>State Match</h2>
                    <p>Find states that fit your lifestyle, budget, and priorities.</p>
                    <span class="hub-cta">Find your state <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
                <a class="hub-feature hub-feature--photo" href="/national-symbols">
                    <img src="@Images.Card("/images/national-symbols/united-states-flag.jpg")" alt="" width="1880" height="1253" />
                    <span class="hub-icon"><i class="fa-solid fa-flag-usa" aria-hidden="true"></i></span>
                    <span class="hub-kicker">Our heritage</span><h2>National Symbols</h2>
                    <p>The flag, Great Seal, anthem, and the stories that connect us.</p>
                    <span class="hub-cta">Explore symbols <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>
        </div>
    </section>

    <section class="hub-core hub-wrap" aria-label="Explore states, comparisons, and data">
        <section class="hub-core-column" aria-labelledby="explore-heading">
            <div class="hub-core-heading"><span class="hub-icon"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span><div><h2 id="explore-heading">Explore States</h2><p>Get to know every corner of the country.</p></div></div>
            <a class="hub-primary" href="/states">
                <img src="@Images.Card("/images/parks/national/yosemite-national-park/13-best-tunnel-view.jpg")" alt="Yosemite Valley in California" loading="lazy" width="480" height="600" />
                <div><h3>State Guides</h3><p>History, geography, cities, and the symbols that make each of the 50 states unique.</p><span class="hub-cta">Explore states <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div>
            </a>
            <div class="hub-small-row">
                <a class="hub-small" href="/guides/state-borders"><span class="hub-small-title"><i class="fa-solid fa-map" aria-hidden="true"></i><h3>State Borders</h3></span><p>Neighbors, coastlines, and waterways.</p><span class="hub-cta">Explore <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
                <a class="hub-small" href="/tools/county-finder"><span class="hub-small-title"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><h3>Counties</h3></span><p>Find the county for a city or ZIP code.</p><span class="hub-cta">Find a county <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
            </div>
        </section>
        <section class="hub-core-column" aria-labelledby="compare-heading">
            <div class="hub-core-heading"><span class="hub-icon"><i class="fa-solid fa-compass" aria-hidden="true"></i></span><div><h2 id="compare-heading">Compare &amp; Find</h2><p>A little guidance for your next big move.</p></div></div>
            <a class="hub-primary" href="/county-match">
                <img src="@Images.Card("/images/state-living/new-york/pexels-975399.jpg")" alt="City neighborhoods along the waterfront at dusk" loading="lazy" width="940" height="627" />
                <div><h3>County Match</h3><p>Weigh housing, income, jobs, education, and health to find a county that fits.</p><span class="hub-cta">Find a county <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div>
            </a>
            <div class="hub-small-row">
                <a class="hub-small" href="/compare-states"><span class="hub-small-title"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i><h3>Compare States</h3></span><p>Put population, costs, and quality of life side by side.</p><span class="hub-cta">Compare <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
                <a class="hub-small" href="/state-match"><span class="hub-small-title"><i class="fa-solid fa-sliders" aria-hidden="true"></i><h3>Your State Match</h3></span><p>Set your priorities and discover your best fit.</p><span class="hub-cta">Get started <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
            </div>
        </section>
        <section class="hub-core-column" aria-labelledby="data-heading">
            <div class="hub-core-heading"><span class="hub-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span><div><h2 id="data-heading">Rankings &amp; Data</h2><p>See the bigger picture, state by state.</p></div></div>
            <a class="hub-primary hub-primary--green" href="/county-rankings">
                <img src="@Images.Card("/images/state-living/new-york/pexels-28273489.jpg")" alt="Suburban neighborhood street" loading="lazy" width="480" height="600" />
                <div><h3>County Rankings</h3><p>Explore affordability, household income, employment, education, and health.</p><span class="hub-cta">Browse rankings <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div>
            </a>
            <div class="hub-small-row">
                <a class="hub-small" href="/rankings"><span class="hub-small-title"><i class="fa-solid fa-database" aria-hidden="true"></i><h3>State Data</h3></span><p>Population, economy, housing, and more.</p><span class="hub-cta">Explore data <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
                <a class="hub-small" href="/compare-states"><span class="hub-small-title"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i><h3>Visual Comparisons</h3></span><p>Explore differences with interactive charts.</p><span class="hub-cta">View charts <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
            </div>
        </section>
    </section>

    <section class="hub-section hub-soft" aria-labelledby="outdoors-heading">
        <div class="hub-wrap">
            <div class="hub-section-head"><div><p class="hub-eyebrow">Places &amp; nature</p><h2 id="outdoors-heading">Explore the Outdoors</h2><p>Extraordinary landscapes. Room to wander. Find your next adventure.</p></div><a class="hub-view-all" href="/national-parks">View all parks <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
            <div class="hub-places">
                <a class="hub-place-main" href="/national-parks"><img src="@Images.Card("/images/parks/national/yosemite-national-park/01-overview-yosemite-valley-taft-point-sentinel-dome.jpg")" alt="Granite cliffs and forest in Yosemite National Park" loading="lazy" width="960" height="383" /><div><span class="hub-kicker">America's wild places</span><h3>National Parks</h3><p>Best hikes, entrance fees, maps, and the right time to visit.</p><span class="hub-cta">Explore parks <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div></a>
                <a class="hub-place-side hub-place-side--photo" href="/collections/nature">
                    <img src="@Images.Card("/images/collections/nature/best-states-for-fall-foliage/best-states-for-fall-foliage-hero.jpg")" alt="" loading="lazy" width="480" height="600" />
                    <span class="hub-icon"><i class="fa-solid fa-mountain-sun" aria-hidden="true"></i></span>
                    <h3>Nature &amp; Travel</h3><p>Scenic destinations, natural wonders, and outdoor inspiration.</p><span class="hub-cta">Explore nature <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
                <a class="hub-place-side hub-place-side--photo" href="/tools/nearest-national-parks">
                    <img src="@Images.Card("/images/parks/national/acadia-national-park/01-hero-image.jpg")" alt="" loading="lazy" width="480" height="600" />
                    <span class="hub-icon"><i class="fa-solid fa-tree" aria-hidden="true"></i></span>
                    <h3>Parks Near You</h3><p>Find nearby national parks and plan where to go next.</p><span class="hub-cta">Find a park <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>
        </div>
    </section>

    <section class="hub-section" aria-labelledby="symbols-heading">
        <div class="hub-wrap">
            <div class="hub-section-head"><div><p class="hub-eyebrow">Symbol types</p><h2 id="symbols-heading">Browse State Symbols by Category</h2><p>Discover the wildlife, traditions, and emblems that tell each state's story.</p></div><a class="hub-view-all" href="/symbols">View all symbols <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
            <div class="hub-symbols">
                @foreach (var symbol in symbols)
                {
                    <a class="hub-symbol" href="/symbols/@symbol.Slug"><div class="hub-symbol-image"><img src="@Images.Card(symbol.Image)" alt="@symbol.Alt" loading="lazy" width="480" height="320" /></div><div class="hub-symbol-copy"><span class="hub-kicker">Symbol category</span><h3>@symbol.Name</h3><p>@symbol.Copy</p><span class="hub-cta">Explore @symbol.Name.ToLowerInvariant() <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div></a>
                }
            </div>
            <div class="hub-compact-grid">
                @foreach (var symbol in compactSymbols)
                {
                    <a class="hub-compact" href="/symbols/@symbol.Slug"><span class="hub-icon"><i class="fa-solid @symbol.Icon" aria-hidden="true"></i></span><div><h3>@symbol.Name</h3><p>@symbol.Copy</p></div></a>
                }
            </div>
        </div>
    </section>

    <section class="hub-section hub-cream" aria-labelledby="states-heading">
        <div class="hub-wrap">
            <div class="hub-section-head"><div><p class="hub-eyebrow">All 50 states</p><h2 id="states-heading">Browse State Symbols by State</h2></div><a class="hub-view-all" href="/states">View all states <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
            <div class="hub-states">
                @foreach (var abbreviation in featuredStates)
                {
                    if (states.TryGetValue(abbreviation, out var state))
                    {
                        <a class="hub-state" href="/states/@state.Slug"><img src="@Images.Thumb($"/images/states/flags/small/{abbreviation.ToLowerInvariant()}.webp")" alt="@state.Name flag" loading="lazy" width="96" height="64" /><div><h3>@state.Name</h3><p>@state.Capital</p></div></a>
                    }
                }
            </div>
        </div>
    </section>

    @if (selectedState != null)
    {
        <section class="hub-section" aria-labelledby="map-heading">
            <div class="hub-wrap">
                <div class="hub-map-panel">
                    <div class="hub-map-copy"><p class="hub-eyebrow">State map</p><h2 id="map-heading">A State for Every Story</h2><p>Hover or focus on a state to preview its facts. Select a tile to explore its symbols.</p>
                        <div class="hub-map-detail" aria-live="polite" aria-atomic="true"><p class="hub-eyebrow">Selected state</p><h3 id="hub-state-name">@selectedState.Name</h3><dl><div><dt>Capital</dt><dd id="hub-state-capital">@selectedState.Capital</dd></div><div><dt>Population</dt><dd id="hub-state-population">@(selectedState.Population?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US")) ?? "Not available")</dd></div></dl><a class="hub-cta" id="hub-state-link" href="/states/@selectedState.Slug"><span>Explore @selectedState.Name</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
                    </div>
                    <div class="hub-map-visual"><p class="hub-map-caption">50 states, one place to explore</p><nav class="hub-tile-map" aria-label="Browse state symbols by map">
                        @foreach (var row in tiles)
                        {
                            @foreach (var abbreviation in row)
                            {
                                if (states.TryGetValue(abbreviation, out var state))
                                {
                                    <a class="hub-tile@(state.Abbreviation == selectedState.Abbreviation ? " is-selected" : "")" href="/states/@state.Slug" aria-label="Explore @state.Name" data-name="@state.Name" data-capital="@state.Capital" data-population="@(state.Population?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US")) ?? "Not available")">@state.Abbreviation</a>
                                }
                                else
                                {
                                    <span aria-hidden="true"></span>
                                }
                            }
                        }
                    </nav><p class="hub-map-note"><i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i> Every tile opens a state guide</p></div>
                </div>
            </div>
        </section>
    }

    <section class="hub-section hub-soft" aria-labelledby="reference-heading">
        <div class="hub-wrap">
            <div class="hub-section-head"><div><p class="hub-eyebrow">Quick reference</p><h2 id="reference-heading">Fast Facts &amp; Lookup Tools</h2><p>The everyday details, all in one place.</p></div><a class="hub-view-all" href="/tools">View all tools <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
            <div class="hub-reference-grid">
                @foreach (var reference in references)
                {
                    <a class="hub-reference" href="@reference.Url"><span class="hub-icon"><i class="fa-solid @reference.Icon" aria-hidden="true"></i></span><h3>@reference.Name</h3><p>@reference.Copy</p><span class="hub-cta">Explore <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@graph": [
            {
                "@@type": "Organization",
                "@@id": "https://usasymbol.com/#organization",
                "name": "USA Symbol",
                "url": "https://usasymbol.com/",
                "logo": "https://usasymbol.com/images/profile/logo.png",
                "founder": { "@@type": "Person", "name": "Artsiom Dusau", "@@id": "https://usasymbol.com/about/artsiom-dusau" },
                "sameAs": [
                    "https://www.linkedin.com/in/artsiom-dusau/",
                    "https://www.pinterest.com/usasymbol/",
                    "https://www.facebook.com/profile.php?id=61586291576329",
                    "https://www.linkedin.com/company/usasymbol/"
                ],
                "contactPoint": { "@@type": "ContactPoint", "email": "contact@usasymbol.com", "contactType": "Customer Service" }
            },
            {
                "@@type": "WebSite",
                "@@id": "https://usasymbol.com/#website",
                "name": "USA Symbol",
                "url": "https://usasymbol.com/",
                "publisher": { "@@id": "https://usasymbol.com/#organization" }
            },
            {
                "@@type": "CollectionPage",
                "@@id": "https://usasymbol.com/#webpage",
                "name": "Explore the United States",
                "description": "Explore all 50 U.S. states with state symbols, living guides, rankings, national parks, maps, and practical lookup tools.",
                "url": "https://usasymbol.com/",
                "isPartOf": { "@@id": "https://usasymbol.com/#website" },
                "publisher": { "@@id": "https://usasymbol.com/#organization" },
                "inLanguage": "en-US"
            }
        ]
    }
    </script>
    <script defer src="~/js/home-hub.js" asp-append-version="true"></script>
}
