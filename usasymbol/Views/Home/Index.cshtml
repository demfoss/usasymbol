@using System.Text.Json
@model USASymbol.Models.ViewModels.HomeViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"] = "Official State Symbols of All 50 U.S. States";
    ViewData["Description"] = "Find official state symbols for all 50 states, from birds and flowers to trees and flags. A clear guide to every symbol in the United States.";
    ViewData["Keywords"] = "state symbols, state birds, state flowers, state flags, state trees, US states, American symbols, state emblems, official state symbols";
    ViewData["BodyClass"] = "home-page";

    var typeLabels = Model.SymbolCategories
        .Where(c => !string.IsNullOrEmpty(c.Type))
        .ToDictionary(
            c => c.Type,
            c => c.Name.EndsWith("s", StringComparison.OrdinalIgnoreCase) ? c.Name[..^1] : c.Name
        );

    var poolJson = JsonSerializer.Serialize(
        Model.SymbolOfTheDayPool.Select(item => new
        {
            name      = item.Symbol.Name,
            type      = item.Symbol.Type,
            typeLabel = typeLabels.TryGetValue(item.Symbol.Type, out var lbl) ? lbl : "State Symbol",
            stateName = item.State.Name,
            stateAbbr = item.State.Abbreviation,
            stateSlug = item.State.Slug,
            imageUrl  = Images.Hero(item.Symbol.ImageUrl),
            flagUrl   = Images.Thumb($"/images/states/flags/small/{item.State.Abbreviation.ToLowerInvariant()}.webp"),
            meaning   = item.Symbol.Meaning ?? "",
            url       = item.Symbol.ToSymbolUrl(item.State.Slug),
        })
    );

    var first = Model.SymbolOfTheDayPool.FirstOrDefault();
    var firstTypeLabel = first != null && typeLabels.TryGetValue(first.Symbol.Type, out var fl) ? fl : "State Symbol";
    var stateMapJson = JsonSerializer.Serialize(
        Model.StateMapItems.Select(item => new
        {
            name = item.Name,
            slug = item.Slug,
            abbr = item.Abbreviation,
            capital = item.Capital,
            population = item.Population
        })
    );
}

@section Styles {
<style>
    /* === HOME PAGE — Editorial Redesign ======================== */

    .home-hero {
        padding: clamp(3.75rem, 7vw, 5.75rem) 0 clamp(2.5rem, 5vw, 3.5rem);
        text-align: center;
    }
    .home-hero .hero-title {
        font-size: clamp(2.5rem, 5vw, 3.95rem);
        max-width: 34rem;
        margin: 1rem auto 1rem;
    }
    .home-hero .hero-subtitle {
        max-width: 40rem;
        margin: 0 auto 2rem;
        font-size: 1rem;
        line-height: 1.65;
    }
    .hero-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .9rem 1.75rem;
        border-radius: 9999px;
        font-family: 'Manrope', sans-serif;
        font-weight: 700;
        font-size: .9rem;
        text-decoration: none;
        transition: transform .2s, background .2s, box-shadow .2s;
    }
    .hero-cta-btn:hover { transform: translateY(-2px); }
    .hero-cta-btn--light {
        background: var(--cream);
        color: var(--navy);
        box-shadow: 0 8px 24px rgba(0,0,0,.18);
    }
    .hero-cta-btn--light:hover { background: white; }
    .hero-cta-btn--ghost {
        background: rgba(255,255,255,.1);
        color: var(--cream);
        border: 1px solid rgba(255,255,255,.24);
    }
    .hero-cta-btn--ghost:hover { background: rgba(255,255,255,.18); }

    .home-map-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1rem;
    }
    .home-map-card {
        background: linear-gradient(180deg, rgba(255,249,240,.96), rgba(255,255,255,.92));
        border: 1px solid rgba(216, 196, 171, .95);
        border-radius: 1.75rem;
        box-shadow: 0 20px 48px rgba(27,42,74,.08);
        padding: 1.1rem;
    }
    .home-map-top {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .home-map-copy h2 {
        margin: .2rem 0 0;
        color: var(--navy);
    }
    .home-map-copy p {
        margin: .55rem 0 0;
        max-width: 38rem;
        color: var(--slate-ed);
        font-size: .95rem;
        line-height: 1.65;
    }
    .home-map-hint {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .55rem .85rem;
        border-radius: 9999px;
        border: 1px solid var(--cream-dark);
        background: rgba(255,255,255,.72);
        color: var(--navy);
        font-size: .78rem;
        font-weight: 700;
    }
    .home-map-frame {
        position: relative;
        overflow: hidden;
        border-radius: 1.25rem;
        border: 1px solid rgba(216, 196, 171, .9);
        background: linear-gradient(180deg, #fbf6ee 0%, #fffdf8 100%);
    }
    .home-map-frame svg {
        display: block;
        width: 100%;
        height: auto;
    }
    .home-map-tooltip {
        position: absolute;
        z-index: 20;
        min-width: 180px;
        max-width: 240px;
        padding: .85rem .95rem;
        border-radius: 1rem;
        border: 1px solid rgba(15,23,42,.58);
        background: rgba(15,23,42,.96);
        box-shadow: 0 18px 40px rgba(15,23,42,.3);
        color: white;
        pointer-events: none;
    }
    .home-map-tooltip[hidden] { display: none; }
    .home-map-tooltip__state {
        font-size: .8rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: .01em;
        color: #fff;
    }
    .home-map-tooltip__meta {
        margin-top: .45rem;
        display: grid;
        gap: .28rem;
    }
    .home-map-tooltip__row {
        display: grid;
        gap: .1rem;
    }
    .home-map-tooltip__label {
        font-size: .62rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #94a3b8;
    }
    .home-map-tooltip__value {
        font-size: .75rem;
        font-weight: 600;
        line-height: 1.35;
        color: #f8fafc;
    }

    /* Section chrome */
    .hs { padding: clamp(3.5rem, 7vw, 5.5rem) 0; }
    .hs-cream { background: var(--cream); }
    .hs-white { background: #fff; }
    .hs-navy  { background: var(--navy); color: var(--cream); }

    .hs-eyebrow {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-family: 'Manrope', sans-serif;
        font-size: .62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: var(--gold);
        margin-bottom: .6rem;
    }
    .hs-eyebrow i { font-size: .7em; }

    /* ── SOTD ───────────────────────────────────────────────── */
    .sotd-card {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 2px 20px rgba(27,42,74,.06);
    }
    .sotd-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .875rem 1.25rem;
        border-bottom: 1px solid var(--cream-dark);
        background: var(--cream);
    }
    .sotd-next-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .5rem 1rem;
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 9999px;
        font-size: .8rem;
        font-weight: 600;
        color: var(--navy);
        cursor: pointer;
        transition: border-color .2s, background .2s;
    }
    .sotd-next-btn:hover { border-color: var(--gold); background: var(--cream); }
    .sotd-inner { display: flex; flex-direction: column; }
    @@media (min-width: 768px) {
        .sotd-inner { display: grid; grid-template-columns: 300px 1fr; }
    }
    .sotd-media {
        background: var(--cream);
        min-height: 240px;
        position: relative;
        overflow: hidden;
    }
    .sotd-media img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    }
    .sotd-type-badge {
        position: absolute;
        top: .75rem; left: .75rem;
        background: rgba(27,42,74,.72);
        backdrop-filter: blur(12px);
        color: var(--cream);
        font-size: .62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        padding: .3rem .75rem;
        border-radius: 9999px;
    }
    .sotd-info {
        padding: clamp(1.5rem, 3vw, 2.25rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .sotd-state-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
    .sotd-flag {
        height: 1.2rem; width: 1.65rem;
        object-fit: cover; border-radius: 2px;
        border: 1px solid var(--cream-dark);
    }
    .sotd-state-text {
        font-size: .7rem; font-weight: 700;
        letter-spacing: .12em; text-transform: uppercase;
        color: var(--slate-ed);
    }
    .sotd-name {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: var(--navy);
        line-height: 1.15;
        letter-spacing: -.025em;
        margin: 0 0 .75rem;
    }
    .sotd-meaning {
        font-size: .9rem; color: var(--slate-ed);
        line-height: 1.7; max-width: 30rem;
    }
    .sotd-actions { margin-top: 1.25rem; display: flex; gap: .75rem; flex-wrap: wrap; }
    .sotd-btn-primary {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .7rem 1.4rem; background: var(--navy); color: var(--cream);
        border-radius: 9999px; font-weight: 700; font-size: .85rem;
        text-decoration: none; transition: background .2s, transform .2s;
    }
    .sotd-btn-primary:hover { background: var(--navy-light); transform: translateY(-1px); }
    .sotd-btn-secondary {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .7rem 1.2rem; background: var(--cream); color: var(--navy);
        border: 1px solid var(--cream-dark); border-radius: 9999px;
        font-weight: 700; font-size: .85rem;
        text-decoration: none; transition: border-color .2s, transform .2s;
    }
    .sotd-btn-secondary:hover { border-color: var(--gold); transform: translateY(-1px); }

    /* ── Category cards ────────────────────────────────────── */
    .cat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .85rem;
    }
    @@media (min-width: 640px)  { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (min-width: 1024px) { .cat-grid { grid-template-columns: repeat(4, 1fr); } }
    .cat-card {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: .875rem;
        overflow: hidden;
        text-decoration: none;
        display: flex; flex-direction: column;
        transition: box-shadow .25s, transform .25s, border-color .25s;
    }
    .cat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(27,42,74,.1);
        border-color: var(--gold-border);
    }
    .cat-card:hover .cat-card__thumb {
        background: var(--cream-dark);
    }
    .cat-card__thumb {
        aspect-ratio: 1 / .9;
        background: var(--cream);
        display: flex; align-items: center; justify-content: center;
        padding: 1rem;
    }
    .cat-card__thumb img {
        width: 100%; height: 100%; object-fit: contain;
        transition: transform .35s ease;
    }
    .cat-card:hover .cat-card__thumb img { transform: scale(1.1); }
    .cat-card__thumb .cat-icon { font-size: 2.5rem; color: var(--navy); opacity: .35; }
    .cat-card__body { padding: .65rem .7rem .75rem; text-align: center; }
    .cat-card__title {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: .84rem; font-weight: 700; color: var(--navy); line-height: 1.25;
    }

    /* ── State cards ──────────────────────────────────────── */
    .state-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    @@media (min-width: 640px)  { .state-grid { grid-template-columns: repeat(3, 1fr); } }
    @@media (min-width: 1024px) { .state-grid { grid-template-columns: repeat(5, 1fr); } }
    .st-card {
        background: var(--cream);
        border: 1px solid var(--cream-dark);
        border-radius: .875rem;
        overflow: hidden;
        text-decoration: none;
        transition: box-shadow .25s, transform .25s, border-color .25s, background .25s;
    }
    .st-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(27,42,74,.1);
        border-color: var(--gold-border);
        background: white;
    }
    .st-card__flag {
        aspect-ratio: 3/2; overflow: hidden;
        background: linear-gradient(135deg, rgba(27,42,74,.08), rgba(27,42,74,.04));
    }
    .st-card__flag img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform .4s ease;
    }
    .st-card:hover .st-card__flag img { transform: scale(1.05); }
    .st-card__body { padding: .75rem; }
    .st-card__name {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: .9rem; font-weight: 700; color: var(--navy);
    }
    .st-card__capital { font-size: .7rem; color: var(--slate-ed); margin-top: .15rem; }

    /* ── Discovery cards ──────────────────────────────────── */
    .disc-grid {
        display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    }
    @@media (min-width: 640px)  { .disc-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (min-width: 1024px) { .disc-grid { grid-template-columns: repeat(4, 1fr); } }
    .disc-card {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 1rem;
        overflow: hidden;
        text-decoration: none;
        display: flex; flex-direction: column;
        transition: box-shadow .25s, transform .25s, border-color .25s;
    }
    .disc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 40px rgba(27,42,74,.1);
        border-color: var(--gold-border);
    }
    .disc-card__banner {
        aspect-ratio: 16/8;
        display: flex; align-items: center; justify-content: center;
        position: relative; overflow: hidden;
    }
    .disc-card__body { padding: 1.15rem; flex: 1; display: flex; flex-direction: column; }
    .disc-card__eyebrow {
        font-size: .6rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .14em; color: var(--gold); margin-bottom: .4rem;
    }
    .disc-card__title {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.05rem; font-weight: 700; color: var(--navy);
        line-height: 1.3; margin-bottom: .5rem;
    }
    .disc-card__desc {
        font-size: .82rem; color: var(--slate-ed); line-height: 1.65; flex: 1;
    }
    .disc-card__cta {
        margin-top: .75rem; font-size: .8rem; font-weight: 700;
        color: var(--navy); display: inline-flex; align-items: center; gap: .375rem;
    }

    /* ── Fact section ─────────────────────────────────────── */
    .fact-quote-mark {
        font-size: 5rem; line-height: .8;
        color: var(--gold); font-family: Georgia, serif;
        margin-bottom: .5rem; display: block;
    }
    .fact-quote-text {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-style: italic;
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        color: var(--cream);
        line-height: 1.7;
        max-width: 44rem;
        margin: 0 auto 2rem;
    }

    /* ── CTA buttons ──────────────────────────────────────── */
    .cta-btn {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .875rem 1.75rem; border-radius: 9999px;
        font-family: 'Manrope', sans-serif; font-weight: 700;
        font-size: .9rem; text-decoration: none;
        transition: transform .2s, background .2s;
    }
    .cta-btn:hover { transform: translateY(-2px); }
    .cta-btn-navy {
        background: var(--navy); color: var(--cream);
        box-shadow: 0 8px 24px rgba(27,42,74,.2);
    }
    .cta-btn-navy:hover { background: var(--navy-light); }
    .cta-btn-outline {
        background: transparent; color: var(--navy);
        border: 1.5px solid var(--navy);
    }
    .cta-btn-outline:hover { background: rgba(27,42,74,.06); }
    .cta-btn-ghost {
        background: transparent; color: var(--navy);
        border: 1.5px solid var(--cream-dark);
    }
    .cta-btn-ghost:hover { border-color: var(--navy); }
    .cta-btn-gold {
        background: var(--gold); color: var(--navy);
        box-shadow: 0 8px 24px rgba(192,155,79,.25);
    }
    .cta-btn-gold:hover { background: #b08a42; color: white; }
</style>
}

<!-- ════════════════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════════════════ -->
<section class="editorial-hero home-hero">
    <div class="max-w-5xl mx-auto px-4" style="position:relative;z-index:1">
        <div class="hero-pill inline-flex mb-5">
            <i class="fa-solid fa-feather-pointed"></i>
            Official State Encyclopedia
        </div>
        <h1 class="hero-title">
            Discover America's<br>Official State Symbols
        </h1>
        <p class="hero-subtitle">
            The complete reference for all 50 states — birds, flowers, trees, flags, mottos, and hundreds more official emblems.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/states" class="hero-cta-btn hero-cta-btn--light">
                <i class="fa-solid fa-map-location-dot"></i>
                Explore by State
            </a>
            <a href="/symbols" class="hero-cta-btn hero-cta-btn--ghost">
                <i class="fa-solid fa-layer-group"></i>
                Browse Symbols
            </a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.HomeMapSvg) && Model.StateMapItems.Any())
{
    <section class="pt-6 lg:pt-8 pb-10 lg:pb-12">
        <div class="home-map-shell">
            <div class="home-map-card">
                <div class="home-map-top">
                    <div class="home-map-copy">
                        <div class="hs-eyebrow">
                            <i class="fa-solid fa-map"></i>
                            State Map
                        </div>
                        <h2 class="content-h2">Browse the United States by map</h2>
                        <p>Hover any state to see its capital and population. Click any state to open its page right away.</p>
                    </div>
                    <div class="home-map-hint">
                        <i class="fa-solid fa-arrow-pointer"></i>
                        Hover for details, click to open
                    </div>
                </div>

                <div class="home-map-frame" id="home-state-map">
                    @Html.Raw(Model.HomeMapSvg)
                    <div class="home-map-tooltip" id="home-map-tooltip" hidden>
                        <div class="home-map-tooltip__state" id="home-map-state"></div>
                        <div class="home-map-tooltip__meta">
                            <div class="home-map-tooltip__row">
                                <span class="home-map-tooltip__label">Capital</span>
                                <span class="home-map-tooltip__value" id="home-map-capital"></span>
                            </div>
                            <div class="home-map-tooltip__row">
                                <span class="home-map-tooltip__label">Population</span>
                                <span class="home-map-tooltip__value" id="home-map-population"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <script type="application/json" id="home-map-data">@Html.Raw(stateMapJson)</script>
            </div>
        </div>
    </section>
}

<!-- ════════════════════════════════════════════════════════
     SYMBOL OF THE DAY
     ════════════════════════════════════════════════════════ -->

<!-- ════════════════════════════════════════════════════════
     BROWSE BY SYMBOL TYPE
     ════════════════════════════════════════════════════════ -->
<section class="hs hs-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="hs-eyebrow">
            <i class="fa-solid fa-bookmark"></i>
            Symbol Types
        </div>
        <h2 class="content-h2 mb-6" style="font-size:clamp(2rem,3.6vw,2.75rem)">Explore by Symbol</h2>
        <div class="cat-grid">
            @foreach (var category in Model.SymbolCategories)
            {
                <a href="@category.Url" class="cat-card">
                    <div class="cat-card__thumb">
                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                        {
                            <img src="@Images.Card(category.ImageUrl)"
                                 srcset="@(Images.Card(category.ImageUrl, 240)) 240w,
                                         @(Images.Card(category.ImageUrl, 360)) 360w,
                                         @(Images.Card(category.ImageUrl, 480)) 480w"
                                 sizes="(max-width: 639px) 44vw, (max-width: 1023px) 30vw, 22vw"
                                 alt="@category.Name"
                                 loading="lazy">
                        }
                        else
                        {
                            <i class="fa-solid fa-leaf cat-icon"></i>
                        }
                    </div>
                    <div class="cat-card__body">
                        <div class="cat-card__title">@category.Name</div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     FEATURED STATES
     ════════════════════════════════════════════════════════ -->
@if (Model.FeaturedStates.Any())
{
    <section class="hs hs-cream">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
                <div>
                    <div class="hs-eyebrow">
                        <i class="fa-solid fa-flag-usa"></i>
                        All 50 States
                    </div>
                    <h2 class="content-h2">Browse by State</h2>
                </div>
                <a href="/states" class="cta-btn cta-btn-outline" style="font-size:.85rem;padding:.7rem 1.4rem">
                    View All States <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
            <div class="state-grid">
                @foreach (var state in Model.FeaturedStates)
                {
                    var flagPath = $"/images/states/flags/small/{state.Abbreviation.ToLowerInvariant()}.webp";
                    <a href="/states/@state.Slug" class="st-card">
                        <div class="st-card__flag">
                            <img src="@Images.Card(flagPath)"
                                 srcset="@(Images.Card(flagPath, 320)) 320w,
                                         @(Images.Card(flagPath, 480)) 480w,
                                         @(Images.Card(flagPath, 640)) 640w"
                                 sizes="(max-width: 639px) 48vw, (max-width: 1023px) 31vw, (max-width: 1279px) 18vw, 220px"
                                 alt="@state.Name flag"
                                 loading="lazy"
                                 onerror="this.style.display='none'" />
                        </div>
                        <div class="st-card__body">
                            <div class="st-card__name">@state.Name</div>
                            <div class="st-card__capital">@state.Capital</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

