                <div class="sotd-toolbar">
                    <span class="hero-pill">
                        <i class="fa-solid fa-star"></i>
                        Featured Symbol
                    </span>
                    <button id="sotd-next" class="sotd-next-btn">
                        <i class="fa-solid fa-shuffle"></i>
                        Next Symbol
                    </button>
                </div>
                <div class="sotd-inner">
                    <div class="sotd-media">
                        <img id="sotd-img"
                             src="@Images.Hero(first.Symbol.ImageUrl)"
                             alt="@(first.Symbol.Name)"
                             loading="eager" />
                        <span id="sotd-type-badge" class="sotd-type-badge">@firstTypeLabel</span>
                    </div>
                    <div class="sotd-info">
                        <div class="sotd-state-row">
                            <img id="sotd-flag"
                                 src="@Images.Thumb($"/images/states/flags/small/{first.State.Abbreviation.ToLowerInvariant()}.webp")"
                                 alt="@(first.State.Name) flag"
                                 class="sotd-flag"
                                 onerror="this.style.display='none'" />
