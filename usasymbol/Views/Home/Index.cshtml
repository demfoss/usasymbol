@using System.Text.Json
@model USASymbol.Models.ViewModels.HomeViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"] = "Official State Symbols Encyclopedia";
    ViewData["Description"] = "A guide to official state symbols of the USA, celebrating the natural, historic, and cultural emblems of all 50 states.";
    ViewData["Keywords"] = "state symbols, US state symbols, official state symbols, state flags, state birds, state flowers, state trees, state mottos, state seals, state nicknames, american state symbols, state symbols list";
    ViewData["OgImage"] = "/images/usasymbol.png?v=20260429";
    ViewData["BodyClass"] = "home-page";

    var typeLabels = Model.SymbolCategories
        .Where(c => !string.IsNullOrEmpty(c.Type))
        .ToDictionary(
            c => c.Type,
            c => c.Name.EndsWith("s", StringComparison.OrdinalIgnoreCase) ? c.Name[..^1] : c.Name
        );

    var poolJson = JsonSerializer.Serialize(
        Model.SymbolOfTheDayPool.Select(item => new
        {
            name      = item.Symbol.Name,
            type      = item.Symbol.Type,
            typeLabel = typeLabels.TryGetValue(item.Symbol.Type, out var lbl) ? lbl : "State Symbol",
            stateName = item.State.Name,
            stateAbbr = item.State.Abbreviation,
            stateSlug = item.State.Slug,
            imageUrl  = Images.Hero(item.Symbol.ImageUrl),
            flagUrl   = Images.Thumb($"/images/states/flags/small/{item.State.Abbreviation.ToLowerInvariant()}.webp"),
            meaning   = item.Symbol.Meaning ?? "",
            url       = item.Symbol.ToSymbolUrl(item.State.Slug),
        })
    );

    var first = Model.SymbolOfTheDayPool.FirstOrDefault();
    var firstTypeLabel = first != null && typeLabels.TryGetValue(first.Symbol.Type, out var fl) ? fl : "State Symbol";
    var stateMapLookup = Model.StateMapItems
        .Where(item => !string.Equals(item.Abbreviation, "DC", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(item => item.Abbreviation, StringComparer.OrdinalIgnoreCase);
    var initialMapState = stateMapLookup.TryGetValue("CA", out var california)
        ? california
        : stateMapLookup.Values.FirstOrDefault();
    var initialMapPopulation = initialMapState?.Population is int population
        ? population.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
        : "Not available";
    var stateTileRows = new[]
    {
        new[] { "AK", "",   "",   "",   "",   "",   "",   "",   "",   "",   "ME" },
        new[] { "",   "",   "",   "",   "",   "",   "",   "",   "",   "VT", "NH" },
        new[] { "WA", "ID", "MT", "ND", "MN", "WI", "IL", "MI", "NY", "RI", "MA" },
        new[] { "OR", "NV", "WY", "SD", "IA", "IN", "OH", "PA", "NJ", "CT", ""   },
        new[] { "CA", "UT", "CO", "NE", "MO", "KY", "WV", "VA", "MD", "DE", ""   },
        new[] { "",   "AZ", "NM", "KS", "AR", "TN", "NC", "SC", "",   "",   ""   },
        new[] { "",   "",   "OK", "LA", "MS", "AL", "GA", "",   "",   "",   ""   },
        new[] { "HI", "",   "TX", "",   "",   "",   "",   "",   "FL", "",   ""   }
    };
}

