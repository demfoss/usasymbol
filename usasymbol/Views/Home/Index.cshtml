@using System.Text.Json
@model USASymbol.Models.ViewModels.HomeViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"] = "U.S. State Symbols — Official 50-State Encyclopedia";
    ViewData["Description"] = "Official symbols of all 50 U.S. states — flags, birds, flowers, trees, mottos, seals, and 20+ categories. The most complete state symbols reference online.";
    ViewData["Keywords"] = "state symbols, US state symbols, official state symbols, state flags, state birds, state flowers, state trees, state mottos, state seals, state nicknames, american state symbols, state symbols list";
    ViewData["OgImage"] = "/images/usasymbol.png?v=20260429";
    ViewData["BodyClass"] = "home-page";

    var typeLabels = Model.SymbolCategories
        .Where(c => !string.IsNullOrEmpty(c.Type))
        .ToDictionary(
            c => c.Type,
            c => c.Name.EndsWith("s", StringComparison.OrdinalIgnoreCase) ? c.Name[..^1] : c.Name
        );

    var poolJson = JsonSerializer.Serialize(
        Model.SymbolOfTheDayPool.Select(item => new
        {
            name      = item.Symbol.Name,
            type      = item.Symbol.Type,
            typeLabel = typeLabels.TryGetValue(item.Symbol.Type, out var lbl) ? lbl : "State Symbol",
            stateName = item.State.Name,
            stateAbbr = item.State.Abbreviation,
            stateSlug = item.State.Slug,
            imageUrl  = Images.Hero(item.Symbol.ImageUrl),
            flagUrl   = Images.Thumb($"/images/states/flags/small/{item.State.Abbreviation.ToLowerInvariant()}.webp"),
            meaning   = item.Symbol.Meaning ?? "",
            url       = item.Symbol.ToSymbolUrl(item.State.Slug),
        })
    );

    var first = Model.SymbolOfTheDayPool.FirstOrDefault();
    var firstTypeLabel = first != null && typeLabels.TryGetValue(first.Symbol.Type, out var fl) ? fl : "State Symbol";
    var stateMapJson = JsonSerializer.Serialize(
        Model.StateMapItems.Select(item => new
        {
            name = item.Name,
            slug = item.Slug,
            abbr = item.Abbreviation,
            capital = item.Capital,
            population = item.Population
        })
    );
}

<section class="editorial-hero home-hero">
    <div class="max-w-5xl mx-auto px-4 home-hero-content">
        <div class="hero-pill inline-flex mb-5">
            <i class="fa-solid fa-feather-pointed"></i>
            Complete 50-State Encyclopedia
        </div>
        <h1 class="hero-title">
            Official State Symbols<br>of All 50 U.S. States
        </h1>
        <p class="hero-subtitle">
            Every official U.S. state symbol in one place — flags, birds, flowers, trees, mottos, seals, nicknames, mammals, fossils, minerals, and 20+ more categories across all 50 states.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/states" class="hero-cta-btn hero-cta-btn--light">
                <i class="fa-solid fa-map-location-dot"></i>
                Browse by State
            </a>
            <a href="/symbols" class="hero-cta-btn hero-cta-btn--ghost">
                <i class="fa-solid fa-layer-group"></i>
                Explore Categories
            </a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.HomeMapSvg) && Model.StateMapItems.Any())
{
    <section class="pt-6 lg:pt-8 pb-10 lg:pb-12">
        <div class="home-map-shell">
            <div class="home-map-card">
                <div class="home-map-top">
                    <div class="home-map-copy">
                        <div class="hs-eyebrow">
                            <i class="fa-solid fa-map"></i>
                            State Map
                        </div>
                        <h2 class="content-h2">Browse State Symbols by Map</h2>
                        <p>Choose any state to explore its official symbols, from flags and birds to flowers, trees, mottos, seals, and more.</p>
                    </div>
                    <div class="home-map-hint">
                        <i class="fa-solid fa-arrow-pointer"></i>
                        Hover for details, click to open
                    </div>
                </div>

                <div class="home-map-frame" id="home-state-map">
                    @Html.Raw(Model.HomeMapSvg)
                    <div class="home-map-tooltip" id="home-map-tooltip" hidden>
                        <div class="home-map-tooltip__state" id="home-map-state"></div>
                        <div class="home-map-tooltip__meta">
                            <div class="home-map-tooltip__row">
                                <span class="home-map-tooltip__label">Capital</span>
                                <span class="home-map-tooltip__value" id="home-map-capital"></span>
                            </div>
                            <div class="home-map-tooltip__row">
                                <span class="home-map-tooltip__label">Population</span>
                                <span class="home-map-tooltip__value" id="home-map-population"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <script type="application/json" id="home-map-data">@Html.Raw(stateMapJson)</script>
            </div>
        </div>
    </section>
}

<section class="hs hs-white">
    <div class="max-w-6xl mx-auto px-4">
        <div class="hs-eyebrow">
            <i class="fa-solid fa-bookmark"></i>
            Symbol Types
        </div>
        <h2 class="content-h2 mb-6 home-category-heading">Browse State Symbols by Category</h2>
        <div class="cat-grid">
            @foreach (var category in Model.SymbolCategories)
            {
                <a href="@category.Url" class="cat-card">
                    <div class="cat-card__thumb">
                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                        {
                            <img src="@Images.Card(category.ImageUrl)"
                                 srcset="@(Images.Card(category.ImageUrl, 240)) 240w,
                                         @(Images.Card(category.ImageUrl, 360)) 360w,
                                         @(Images.Card(category.ImageUrl, 480)) 480w"
                                 sizes="(max-width: 639px) 44vw, (max-width: 1023px) 30vw, 22vw"
                                 alt="@category.Name"
                                 loading="lazy">
                        }
                        else
                        {
                            <i class="fa-solid fa-leaf cat-icon"></i>
                        }
                    </div>
                    <div class="cat-card__body">
                        <div class="cat-card__title">@category.Name</div>
                        <div class="cat-card__count">50 states</div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@if (Model.FeaturedStates.Any())
{
    <section class="hs hs-cream">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
                <div>
                    <div class="hs-eyebrow">
                        <i class="fa-solid fa-flag-usa"></i>
                        All 50 States
                    </div>
                    <h2 class="content-h2">Browse State Symbols by State</h2>
                </div>
                <a href="/states" class="cta-btn cta-btn-outline cta-btn--compact">
                    View All States <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
            <div class="state-grid">
                @foreach (var state in Model.FeaturedStates)
                {
                    var flagPath = $"/images/states/flags/small/{state.Abbreviation.ToLowerInvariant()}.webp";
                    <a href="/states/@state.Slug" class="st-card">
                        <div class="st-card__flag">
                            <img src="@Images.Card(flagPath)"
                                 srcset="@(Images.Card(flagPath, 320)) 320w,
                                         @(Images.Card(flagPath, 480)) 480w,
                                         @(Images.Card(flagPath, 640)) 640w"
                                 sizes="(max-width: 639px) 48vw, (max-width: 1023px) 31vw, (max-width: 1279px) 18vw, 220px"
                                 alt="@state.Name flag"
                                 loading="lazy"
                                 onerror="this.style.display='none'" />
                        </div>
                        <div class="st-card__body">
                            <div class="st-card__name">@state.Name</div>
                            <div class="st-card__capital">@state.Capital</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

