<!-- Organization Schema -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Organization",
  "@@id": "https://usasymbol.com/",
  "name": "USA Symbol",
  "url": "https://usasymbol.com",
  "logo": "https://usasymbol.com/images/profile/logo.png",
  "description": "Comprehensive educational resource about official state symbols across the United States.",
  "founder": { "@@type": "Person", "name": "Artsiom Dusau", "@@id": "https://usasymbol.com/about" },
  "sameAs": [
    "https://www.linkedin.com/in/artsiom-dusau/",
    "https://www.pinterest.com/usasymbol/",
    "https://www.facebook.com/profile.php?id=61586291576329",
    "https://www.linkedin.com/company/usasymbol/"
  ],
  "contactPoint": { "@@type": "ContactPoint", "email": "contact@usasymbol.com", "contactType": "Customer Service" }
}
</script>

<script>
(() => {
    const mapEl = document.getElementById('home-state-map');
    const mapDataEl = document.getElementById('home-map-data');
    const tooltipEl = document.getElementById('home-map-tooltip');
    const tooltipStateEl = document.getElementById('home-map-state');
    const tooltipCapitalEl = document.getElementById('home-map-capital');
    const tooltipPopulationEl = document.getElementById('home-map-population');

    if (mapEl && mapDataEl && tooltipEl && tooltipStateEl && tooltipCapitalEl && tooltipPopulationEl) {
        let states = [];
        try { states = JSON.parse(mapDataEl.textContent || '[]'); } catch { states = []; }

        const lookup = Object.fromEntries(states.map(item => [String(item.abbr || '').toLowerCase(), item]));
        const numberFmt = new Intl.NumberFormat('en-US');

        function getPathKey(target) {
            if (!target || target.tagName !== 'path') return null;
            return Array.from(target.classList).find(cls => /^[a-z]{2}$/.test(cls)) || null;
        }

        function showTooltip(target, item, clientX, clientY) {
            tooltipStateEl.textContent = item.name || '';
            tooltipCapitalEl.textContent = item.capital || 'Unknown';
            tooltipPopulationEl.textContent = item.population ? numberFmt.format(item.population) : 'Unknown';

            const rect = mapEl.getBoundingClientRect();
            const ttW = tooltipEl.offsetWidth || 210;
            const ttH = tooltipEl.offsetHeight || 120;
            let left = clientX - rect.left + 18;
            let top = clientY - rect.top - ttH - 14;

            if (left + ttW > rect.width - 10) left = clientX - rect.left - ttW - 18;
            if (top < 10) top = clientY - rect.top + 18;

            tooltipEl.style.left = left + 'px';
            tooltipEl.style.top = top + 'px';
            tooltipEl.hidden = false;
            target.style.fill = '#c38e63';
        }

        function hideTooltip(target) {
            tooltipEl.hidden = true;
            if (target) target.style.fill = '';
        }

        mapEl.querySelectorAll('g.state path').forEach(path => {
            const key = getPathKey(path);
            const item = key ? lookup[key] : null;
            if (!item) return;

            path.setAttribute('tabindex', '0');
            path.setAttribute('role', 'link');
            path.setAttribute('aria-label', item.name);

            path.addEventListener('mouseenter', e => showTooltip(path, item, e.clientX, e.clientY));
            path.addEventListener('mousemove', e => showTooltip(path, item, e.clientX, e.clientY));
            path.addEventListener('mouseleave', () => hideTooltip(path));
            path.addEventListener('focus', () => {
                const rect = path.getBoundingClientRect();
                showTooltip(path, item, rect.left + rect.width / 2, rect.top + rect.height / 2);
            });
            path.addEventListener('blur', () => hideTooltip(path));
            path.addEventListener('click', () => {
                window.location.href = '/states/' + item.slug;
            });
            path.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    window.location.href = '/states/' + item.slug;
                }
            });
        });
    }

    const poolEl = document.getElementById('sotd-pool');
    if (!poolEl) return;
    let pool;
    try { pool = JSON.parse(poolEl.textContent); } catch { return; }
    if (!pool || pool.length === 0) return;

    let idx = Math.floor(Math.random() * pool.length);

    const elImg       = document.getElementById('sotd-img');
    const elBadge     = document.getElementById('sotd-type-badge');
    const elFlag      = document.getElementById('sotd-flag');
    const elState     = document.getElementById('sotd-state');
    const elName      = document.getElementById('sotd-name');
    const elMeaning   = document.getElementById('sotd-meaning');
    const elLink      = document.getElementById('sotd-link');
    const elStateLink = document.getElementById('sotd-state-link');
    const elCard      = document.getElementById('sotd-card');

    function render(s) {
        elCard.style.opacity = '0';
        setTimeout(() => {
            elImg.src             = s.imageUrl;
            elImg.alt             = s.name;
            elBadge.textContent   = s.typeLabel;
            elFlag.src            = s.flagUrl;
            elFlag.alt            = s.stateName + ' flag';
            elState.textContent   = s.stateName;
            elName.textContent    = s.name;
            elMeaning.textContent = s.meaning
                ? (s.meaning.length > 200 ? s.meaning.slice(0, 200) + '\u2026' : s.meaning)
                : 'The official ' + s.typeLabel + ' of ' + s.stateName + '.';
            elLink.href           = s.url;
            elStateLink.href      = '/states/' + s.stateSlug;
            elStateLink.textContent = s.stateName;
            elCard.style.opacity  = '1';
        }, 180);
    }

    elCard.style.transition = 'opacity 0.18s ease';
    render(pool[idx]);

    document.getElementById('sotd-next')?.addEventListener('click', () => {
        idx = (idx + 1) % pool.length;
        render(pool[idx]);
    });
})();
</script>
