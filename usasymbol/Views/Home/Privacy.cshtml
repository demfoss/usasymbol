@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "Learn how USA Symbol collects, uses, and protects your data when you visit usasymbol.com.";
}

<main class="max-w-4xl mx-auto px-4 py-12">

    <!-- PRIVACY POLICY CARD -->
    <article class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 md:p-12 mb-8">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Privacy Policy</h1>
            <p class="text-gray-600">Effective Date: January 15, 2025 | Last Updated: January 15, 2025</p>
        </div>

        <div class="prose prose-lg max-w-none">

            <!-- INTRO -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Introduction</h2>
                <p class="text-gray-700 leading-relaxed">
                    Welcome to USA Symbol ("we," "us," or "our"). We are committed to protecting your privacy and
                    being transparent about how we collect, use, and share information. This Privacy Policy explains
                    our practices regarding data collection and use when you visit usasymbol.com (the "Site").
                </p>
                <p class="text-gray-700 leading-relaxed mt-4">
                    USA Symbol is operated by Artsiom Dusau, based in Chicago, Illinois, USA. You can contact us at
                    <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="text-purple-600 hover:text-purple-800 underline">
                        contact@usasymbol.com
                    </a>.
                </p>
            </section>

            <!-- INFORMATION WE COLLECT -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Information We Collect</h2>

                <h3 class="text-xl font-bold text-gray-900 mb-3 mt-6">Information You Provide</h3>
                <p class="text-gray-700 leading-relaxed">
                    We collect information that you voluntarily provide, for example when you:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mt-3">
                    <li>Use our contact form (name and email address)</li>
                    <li>Send us an email with questions, suggestions, or feedback</li>
                </ul>

                <h3 class="text-xl font-bold text-gray-900 mb-3 mt-6">Information Automatically Collected</h3>
                <p class="text-gray-700 leading-relaxed">
                    When you visit our Site, we automatically collect certain technical and usage information, such as:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mt-3">
                    <li><strong>Log Data:</strong> IP address, browser type, operating system, pages visited, time spent on pages, referring URL</li>
                    <li><strong>Device Information:</strong> Device type, screen resolution, and approximate location (city / country level)</li>
                    <li><strong>Usage Data:</strong> How you interact with our pages, including clicks, scrolls, and search queries on the Site</li>
                </ul>
            </section>

            <!-- COOKIES -->
            <section class="mb-8 bg-blue-50 border-l-4 border-blue-500 p-6 rounded">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Cookies and Tracking Technologies</h2>

                <p class="text-gray-700 leading-relaxed mb-4">
                    We use cookies and similar technologies to improve your experience, analyze traffic, and support advertising.
                </p>

                <h3 class="text-xl font-bold text-gray-900 mb-3">What Are Cookies?</h3>
                <p class="text-gray-700 leading-relaxed mb-4">
                    Cookies are small text files that websites store on your device. They help remember your preferences and
                    understand how you use the Site.
                </p>

                <h3 class="text-xl font-bold text-gray-900 mb-3">Types of Cookies We Use</h3>

                <div class="space-y-4">
                    <div>
                        <h4 class="font-bold text-gray-900">1. Essential Cookies</h4>
                        <p class="text-gray-700 text-sm">
                            Required for the basic functionality of the Site, such as navigation and access to secure areas.
                        </p>
                    </div>

                    <div>
                        <h4 class="font-bold text-gray-900">2. Analytics Cookies (Google Analytics)</h4>
                        <p class="text-gray-700 text-sm">
                            We use Google Analytics to understand how visitors use the Site and to improve content and usability.
                            Google Analytics collects information such as which pages are visited, how often, and for how long.
                        </p>
                        <p class="text-gray-700 text-sm mt-2">
                            Learn more:
                            <a href="https://policies.google.com/privacy" target="_blank" rel="nofollow noopener noreferrer"
                               class="text-blue-600 hover:underline">Google Privacy Policy</a>
                        </p>
                    </div>

                    <div>
                        <h4 class="font-bold text-gray-900">3. Advertising Cookies (Google Adsense &amp; Ezoic)</h4>
                        <p class="text-gray-700 text-sm">
                            We may use Google Adsense and/or Ezoic to serve ads on the Site. These partners use cookies
                            to show ads based on your visits to our Site and other websites (“personalized advertising”).
                        </p>
                        <p class="text-gray-700 text-sm mt-2">They may collect, for example:</p>
                        <ul class="list-disc list-inside text-gray-700 text-sm mt-2 ml-4">
                            <li>Pages and content you view on our Site</li>
                            <li>Ads you see or click</li>
                            <li>Approximate location based on IP</li>
                            <li>Device and browser information</li>
                        </ul>
                        <p class="text-gray-700 text-sm mt-2">Learn more:</p>
                        <ul class="text-sm mt-1 ml-4">
                            <li>
                                <a href="https://policies.google.com/technologies/ads" target="_blank" rel="nofollow noopener noreferrer"
                                   class="text-blue-600 hover:underline">Google Advertising</a>
                            </li>
                            <li>
                                <a href="https://www.ezoic.com/privacy-policy/" target="_blank" rel="nofollow noopener noreferrer"
                                   class="text-blue-600 hover:underline">Ezoic Privacy Policy</a>
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="font-bold text-gray-900">4. Social Media Cookies</h4>
                        <p class="text-gray-700 text-sm">
                            If you use sharing buttons (for example, to share content on social networks),
                            those platforms may set their own cookies.
                        </p>
                    </div>
                </div>

                <h3 class="text-xl font-bold text-gray-900 mb-3 mt-6">Managing Cookies</h3>
                <p class="text-gray-700 leading-relaxed mb-3">
                    You can manage cookies in several ways:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-2">
                    <li><strong>Browser Settings:</strong> Block or delete cookies in your browser preferences.</li>
                    <li>
                        <strong>Opt-out of Personalized Ads:</strong>
                        <a href="https://www.aboutads.info/choices/" target="_blank" rel="nofollow noopener noreferrer"
                           class="text-blue-600 hover:underline">aboutads.info/choices</a> or
                        <a href="https://www.youronlinechoices.eu/" target="_blank" rel="nofollow noopener noreferrer"
                           class="text-blue-600 hover:underline">youronlinechoices.eu</a>
                    </li>
                    <li>
                        <strong>Google Ads Settings:</strong>
                        <a href="https://adssettings.google.com/" target="_blank" rel="nofollow noopener noreferrer"
                           class="text-blue-600 hover:underline">adssettings.google.com</a>
                    </li>
                </ul>
                <p class="text-gray-700 text-sm mt-3 italic">
                    If you disable cookies, some parts of the Site may not function properly. Ads may still appear, but they
                    may be less relevant.
                </p>
            </section>

            <!-- HOW WE USE INFO -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">How We Use Your Information</h2>
                <p class="text-gray-700 leading-relaxed mb-3">
                    We use collected information to:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-2">
                    <li>Operate, maintain, and improve the Site and its content</li>
                    <li>Respond to your questions and support requests</li>
                    <li>Analyze traffic and usage patterns</li>
                    <li>Serve and optimize advertising (through partners like Google Adsense and Ezoic)</li>
                    <li>Comply with legal obligations and enforce our Terms of Use</li>
                </ul>
            </section>

            <!-- SHARING -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Information Sharing and Disclosure</h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    We do not sell, trade, or rent your personal information. We may share information in the
                    following situations:
                </p>

                <h3 class="text-lg font-bold text-gray-900 mb-3">Third-Party Service Providers</h3>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mb-4">
                    <li>Google Analytics – traffic and usage analytics</li>
                    <li>Google Adsense – advertising</li>
                    <li>Ezoic – ad optimization and site performance</li>
                    <li>YouTube – for embedded video content</li>
                </ul>
                <p class="text-gray-700 text-sm italic mb-4">
                    These providers have their own privacy policies and may use data according to their terms.
                </p>

                <h3 class="text-lg font-bold text-gray-900 mb-3">Legal Requirements</h3>
                <p class="text-gray-700 leading-relaxed">
                    We may disclose information when required by law or when we believe it is necessary to protect our
                    rights, your safety or the safety of others, investigate fraud, or respond to lawful government requests.
                </p>
            </section>

            <!-- THIRD-PARTY LINKS -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Third-Party Links and Content</h2>
                <p class="text-gray-700 leading-relaxed">
                    Our Site may include links to external websites or embedded content (for example, YouTube videos).
                    We are not responsible for the privacy practices or content of third-party websites. We recommend
                    reviewing their privacy policies before providing any information.
                </p>
            </section>

            <!-- CHILDREN -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Children's Privacy</h2>
                <p class="text-gray-700 leading-relaxed">
                    The Site is intended for a general audience and is not directed to children under 13. We do not knowingly
                    collect personal information from children under 13. If you believe that your child has provided us with
                    personal information, please contact us at
                    <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="text-purple-600 hover:text-purple-800 underline">
                        contact@usasymbol.com
                    </a>
                    and we will remove it.
                </p>
            </section>

            <!-- SECURITY -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Data Security</h2>
                <p class="text-gray-700 leading-relaxed">
                    We use reasonable technical and organizational measures to protect your data from unauthorized access,
                    alteration, disclosure, or destruction. However, no method of transmission or storage is completely secure,
                    so we cannot guarantee absolute protection.
                </p>
            </section>

            <!-- RIGHTS -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Your Privacy Rights</h2>

                <h3 class="text-lg font-bold text-gray-900 mb-3">For All Users</h3>
                <p class="text-gray-700 leading-relaxed mb-3">You may have the right to:</p>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mb-4">
                    <li>Request access to information we hold about you</li>
                    <li>Ask to correct inaccurate data</li>
                    <li>Request deletion of your information (where legally possible)</li>
                    <li>Opt-out of personalized advertising</li>
                </ul>

                <h3 class="text-lg font-bold text-gray-900 mb-3">California Residents (CCPA)</h3>
                <p class="text-gray-700 leading-relaxed mb-3">
                    If you live in California, you may have additional rights under the California Consumer Privacy Act (CCPA),
                    including the right to know what data we collect, the right to delete personal information, the right
                    to opt-out of certain data sharing, and the right not to be discriminated against for exercising your rights.
                </p>

                <h3 class="text-lg font-bold text-gray-900 mb-3">European Union Residents (GDPR)</h3>
                <p class="text-gray-700 leading-relaxed mb-3">
                    If you are located in the European Union, your rights under the GDPR may include:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-2 mb-4">
                    <li>Access to your personal data</li>
                    <li>Rectification of inaccurate data</li>
                    <li>Erasure (“right to be forgotten”)</li>
                    <li>Restriction of processing</li>
                    <li>Data portability</li>
                    <li>Objection to certain processing</li>
                    <li>Withdrawal of consent at any time</li>
                </ul>

                <p class="text-gray-700 leading-relaxed mt-4">
                    To exercise any of these rights, please contact us at
                    <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com"
                       class="text-purple-600 hover:text-purple-800 underline font-semibold">
                        contact@usasymbol.com
                    </a>.
                </p>
            </section>

            <!-- INTERNATIONAL TRANSFERS -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">International Data Transfers</h2>
                <p class="text-gray-700 leading-relaxed">
                    Our servers are located in the United States. If you access the Site from outside the U.S., your data may
                    be transferred to and processed in the United States. By using the Site, you consent to this transfer.
                </p>
            </section>

            <!-- CHANGES -->
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Changes to This Privacy Policy</h2>
                <p class="text-gray-700 leading-relaxed">
                    We may update this Privacy Policy from time to time. When we make changes, we will update the “Last Updated”
                    date at the top of this page. Your continued use of the Site after any changes means that you accept the
                    revised Policy.
                </p>
            </section>

            <!-- CONTACT US -->
            <section class="mb-8 bg-purple-50 border-l-4 border-purple-600 p-6 rounded">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact Us</h2>
                <p class="text-gray-700 leading-relaxed mb-3">
                    If you have any questions or requests regarding this Privacy Policy or our data practices, please contact us:
                </p>
                <div class="text-gray-700">
                    <p><strong>USA Symbol</strong></p>
                    <p>Artsiom Dusau</p>
                    <p>Chicago, Illinois, USA</p>
                    <p class="mt-2">
                        Email:
                        <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com"
                           class="text-purple-600 hover:text-purple-800 underline font-semibold">
                            contact@usasymbol.com
                        </a>
                    </p>
                </div>
            </section>

            <section class="border-t pt-6 mt-8">
                <p class="text-sm text-gray-500">
                    By using USA Symbol, you acknowledge that you have read and understood this Privacy Policy and agree to its terms.
                </p>
            </section>

        </div>
    </article>

    <!-- NAVIGATION LINKS -->
    <div class="flex flex-wrap gap-4 justify-center">
        <a href="/terms" class="text-purple-600 hover:text-purple-800 font-semibold">Terms of Use</a>
        <span class="text-gray-400">|</span>
        <a href="/editorial-policy" class="text-purple-600 hover:text-purple-800 font-semibold">Editorial Policy</a>
        <span class="text-gray-400">|</span>
        <a href="/contact" class="text-purple-600 hover:text-purple-800 font-semibold">Contact Us</a>
    </div>

</main>
