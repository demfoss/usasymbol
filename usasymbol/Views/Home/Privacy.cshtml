@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "Learn how USA Symbol collects, uses, and protects your data when you visit usasymbol.com.";
}

@section Styles {
<style>
    .privacy-section { padding: 2rem 2.5rem; }
    .privacy-section + .privacy-section { border-top: 1px solid #f3f4f6; }
    .privacy-icon { flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-top: 0.125rem; }
    .privacy-h2 { font-size: 1.125rem; font-weight: 700; color: #111827; margin-bottom: 0.75rem; }
    .privacy-h3 { font-size: 0.9375rem; font-weight: 600; color: #1f2937; margin: 1rem 0 0.375rem; }
    .privacy-p { color: #4b5563; line-height: 1.75; margin-bottom: 0.625rem; }
    .privacy-ul { list-style: disc; padding-left: 1.375rem; color: #4b5563; line-height: 1.75; }
    .privacy-ul li { margin-bottom: 0.25rem; }
    .privacy-a { color: #7c3aed; text-decoration: underline; }
    .privacy-a:hover { color: #6d28d9; }
    .privacy-a-button { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }

    /* Mediavine injected notice */
    #mv-notice-wrapper { font-size: 0.85rem; line-height: 1.75; color: #4b5563; }
    #mv-notice-wrapper h2 { font-size: 1rem; font-weight: 700; color: #111827; margin: 1.25rem 0 0.5rem; }
    #mv-notice-wrapper h3 { font-size: 0.9rem; font-weight: 700; color: #374151; margin: 1rem 0 0.375rem; }
    #mv-notice-wrapper h4 { font-size: 0.85rem; font-weight: 600; color: #374151; margin: 0.75rem 0 0.25rem; }
    #mv-notice-wrapper p { margin: 0.4rem 0; }
    #mv-notice-wrapper ul { list-style: disc; padding-left: 1.5rem; margin: 0.4rem 0; }
    #mv-notice-wrapper a { color: #7c3aed; text-decoration: underline; word-break: break-all; }
    #mv-notice-wrapper sup { font-size: 0.7em; }

    @@media (max-width: 640px) {
        .privacy-section { padding: 1.5rem; }
    }
</style>
}

<div class="max-w-4xl mx-auto px-4 py-12">

    <!-- HERO -->
    <div class="text-center mb-10">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-2xl mb-4">
            <i class="fa-solid fa-shield-halved text-purple-600 text-2xl"></i>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Privacy Policy</h1>
        <p class="text-gray-500 text-sm">Effective: January 15, 2025 &nbsp;·&nbsp; Last updated: May 9, 2026</p>
    </div>

    <!-- QUICK BADGES -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10">
        <div class="bg-green-50 border border-green-100 rounded-xl p-4 flex items-center gap-3">
            <i class="fa-solid fa-ban text-green-600 text-lg flex-shrink-0"></i>
            <p class="text-sm font-semibold text-green-800 leading-tight">We don't sell or rent your personal data</p>
        </div>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-center gap-3">
            <i class="fa-solid fa-cookie-bite text-blue-600 text-lg flex-shrink-0"></i>
            <p class="text-sm font-semibold text-blue-800 leading-tight">Cookies used for ads &amp; analytics</p>
        </div>
        <div class="bg-purple-50 border border-purple-100 rounded-xl p-4 flex items-center gap-3">
            <i class="fa-solid fa-user-shield text-purple-600 text-lg flex-shrink-0"></i>
            <p class="text-sm font-semibold text-purple-800 leading-tight">GDPR &amp; CCPA rights supported</p>
        </div>
    </div>

    <!-- MAIN ARTICLE -->
    <article class="bg-white rounded-2xl shadow-sm border border-gray-200 mb-4">

        <!-- Introduction -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-purple-100">
                    <i class="fa-solid fa-circle-info text-purple-600 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Introduction</h2>
                    <p class="privacy-p">
                        Welcome to USA Symbol ("we," "us," or "our"). We are committed to protecting your privacy and
                        being transparent about how we collect, use, and share information. This Privacy Policy explains
                        our practices when you visit usasymbol.com (the "Site").
                    </p>
                    <p class="privacy-p">
                        USA Symbol is operated by Artsiom Dusau, based in Chicago, Illinois, USA.
                        Contact us at <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="privacy-a">contact@usasymbol.com</a>.
                    </p>
                </div>
            </div>
        </div>

        <!-- Information We Collect -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-blue-100">
                    <i class="fa-solid fa-database text-blue-600 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Information We Collect</h2>

                    <h3 class="privacy-h3">Information You Provide</h3>
                    <p class="privacy-p">We collect information that you voluntarily provide, for example when you:</p>
                    <ul class="privacy-ul">
                        <li>Use our contact form (name and email address)</li>
                        <li>Send us an email with questions, suggestions, or feedback</li>
                    </ul>

                    <h3 class="privacy-h3">Information Automatically Collected</h3>
                    <p class="privacy-p">When you visit our Site, we automatically collect:</p>
                    <ul class="privacy-ul">
                        <li><strong>Log Data:</strong> IP address, browser type, OS, pages visited, time on page, referring URL</li>
                        <li><strong>Device Information:</strong> Device type, screen resolution, approximate location (city/country)</li>
                        <li><strong>Usage Data:</strong> Clicks, scrolls, and search queries on the Site</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cookies -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-amber-100">
                    <i class="fa-solid fa-cookie text-amber-600 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Cookies and Tracking Technologies</h2>
                    <p class="privacy-p">We use cookies and similar technologies to improve your experience, analyze traffic, and support advertising.</p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 mb-4">
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Essential</p>
                            <p class="text-sm text-gray-700">Required for basic site functionality and navigation.</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Analytics (Google)</p>
                            <p class="text-sm text-gray-700">Track page visits and usage patterns to improve the site.</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Advertising</p>
                            <p class="text-sm text-gray-700">Served by partners including Mediavine for personalized ads.</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">Social Media</p>
                            <p class="text-sm text-gray-700">Set by social platforms when you use sharing buttons.</p>
                        </div>
                    </div>

                    <h3 class="privacy-h3">Managing Cookies</h3>
                    <ul class="privacy-ul">
                        <li><strong>Browser Settings:</strong> Block or delete cookies in your browser preferences.</li>
                        <li><strong>Opt-out of Personalized Ads:</strong>
                            <a href="https://www.aboutads.info/choices/" target="_blank" rel="nofollow noopener noreferrer" class="privacy-a">aboutads.info/choices</a> or
                            <a href="https://www.youronlinechoices.eu/" target="_blank" rel="nofollow noopener noreferrer" class="privacy-a">youronlinechoices.eu</a>
                        </li>
                        <li><strong>Google Ads Settings:</strong>
                            <a href="https://adssettings.google.com/" target="_blank" rel="nofollow noopener noreferrer" class="privacy-a">adssettings.google.com</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- How We Use Info -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-green-100">
                    <i class="fa-solid fa-gears text-green-600 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">How We Use Your Information</h2>
                    <ul class="privacy-ul">
                        <li>Operate, maintain, and improve the Site and its content</li>
                        <li>Respond to your questions and support requests</li>
                        <li>Analyze traffic and usage patterns</li>
                        <li>Serve and optimize advertising through advertising partners</li>
                        <li>Comply with legal obligations and enforce our Terms of Use</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Sharing -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-red-100">
                    <i class="fa-solid fa-share-nodes text-red-500 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Information Sharing and Disclosure</h2>
                    <p class="privacy-p">We <strong>do not sell, trade, or rent</strong> your personal information. We may share data with:</p>
                    <ul class="privacy-ul mb-3">
                        <li>Google Analytics – traffic and usage analytics</li>
                        <li>Mediavine and other advertising partners – ad delivery and optimization</li>
                        <li>YouTube – embedded video content</li>
                    </ul>
                    <p class="privacy-p">We may also disclose information when required by law or to protect our rights or safety.</p>
                </div>
            </div>
        </div>

        <!-- Privacy Rights -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-indigo-100">
                    <i class="fa-solid fa-scale-balanced text-indigo-600 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Your Privacy Rights</h2>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-4">
                        <div class="border border-gray-200 rounded-xl p-3 text-center">
                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1">All Users</p>
                            <p class="text-sm text-gray-700">Access, correct, or delete your information</p>
                        </div>
                        <div class="border border-blue-200 bg-blue-50 rounded-xl p-3 text-center">
                            <p class="text-xs font-bold text-blue-500 uppercase tracking-wide mb-1">CCPA (California)</p>
                            <p class="text-sm text-gray-700">Know, delete, opt-out &amp; non-discrimination</p>
                        </div>
                        <div class="border border-purple-200 bg-purple-50 rounded-xl p-3 text-center">
                            <p class="text-xs font-bold text-purple-500 uppercase tracking-wide mb-1">GDPR (EU/UK)</p>
                            <p class="text-sm text-gray-700">Access, erasure, portability &amp; objection</p>
                        </div>
                    </div>

                    <p class="privacy-p">
                        To exercise any of these rights, contact us at
                        <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="privacy-a font-semibold">contact@usasymbol.com</a>.
                    </p>
                </div>
            </div>
        </div>

        <!-- Additional sections -->
        <div class="privacy-section">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-gray-100">
                    <i class="fa-solid fa-ellipsis text-gray-500 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Additional Information</h2>

                    <h3 class="privacy-h3">Children's Privacy</h3>
                    <p class="privacy-p">The Site is not directed to children under 13. We do not knowingly collect personal information from children under 13. If you believe your child has provided us with personal information, please <a href="/contact" class="privacy-a">contact us</a> and we will remove it.</p>

                    <h3 class="privacy-h3">Third-Party Links and Content</h3>
                    <p class="privacy-p">Our Site may include links to external websites or embedded content. We are not responsible for third-party privacy practices and recommend reviewing their policies.</p>

                    <h3 class="privacy-h3">Data Security</h3>
                    <p class="privacy-p">We use reasonable technical and organizational measures to protect your data. However, no internet transmission is 100% secure.</p>

                    <h3 class="privacy-h3">International Data Transfers</h3>
                    <p class="privacy-p">Our servers are in the United States. By using the Site from outside the U.S., you consent to your data being processed in the United States.</p>

                    <h3 class="privacy-h3">Changes to This Policy</h3>
                    <p class="privacy-p">We may update this Privacy Policy from time to time and will update the "Last Updated" date at the top. Continued use of the Site means you accept the revised Policy.</p>
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="privacy-section rounded-b-2xl bg-purple-50">
            <div class="flex items-start gap-4">
                <div class="privacy-icon bg-purple-200">
                    <i class="fa-solid fa-envelope text-purple-700 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 class="privacy-h2">Contact Us</h2>
                    <p class="privacy-p">If you have questions about this Privacy Policy or our data practices:</p>
                    <p class="text-gray-700 font-semibold">USA Symbol &mdash; Artsiom Dusau</p>
                    <p class="text-gray-600 text-sm">Chicago, Illinois, USA</p>
                    <p class="mt-2">
                        <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com"
                           class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors">
                            <i class="fa-solid fa-envelope"></i>
                            contact@usasymbol.com
                        </a>
                    </p>
                </div>
            </div>
        </div>

    </article>

    <p class="text-center text-xs text-gray-400 mb-8">By using USA Symbol, you acknowledge that you have read and understood this Privacy Policy and agree to its terms.</p>

    <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8 mb-8">
        <h2 class="privacy-h2 mb-3">Privacy Controls</h2>
        <p class="privacy-p">You can review or update your privacy choices at any time using the links below.</p>
        <div class="flex flex-wrap gap-4">
            <button type="button" class="privacy-a privacy-a-button font-semibold" data-cmp-action="screen">Update Privacy Settings</button>
            <button type="button" class="privacy-a privacy-a-button font-semibold" data-cmp-action="custom">Do Not Sell or Share My Personal Information</button>
        </div>
    </div>

    <!-- MEDIAVINE PARTNER NOTICE -->
    <div id="mv-section" style="display:none">
        <div class="flex items-center gap-3 mb-4">
            <div class="h-px bg-gray-200 flex-1"></div>
            <div class="flex items-center gap-2 px-3 py-1 bg-gray-100 rounded-full">
                <i class="fa-solid fa-rectangle-ad text-gray-400 text-xs"></i>
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Advertising Partner Notice</span>
            </div>
            <div class="h-px bg-gray-200 flex-1"></div>
        </div>
        <div id="mv-notice-wrapper" class="bg-white rounded-2xl border border-gray-200 p-8 md:p-10 mb-8"></div>
    </div>

    <!-- NAV LINKS -->
    <div class="flex flex-wrap gap-4 justify-center pb-4">
        <a href="/terms" class="text-purple-600 hover:text-purple-800 font-semibold text-sm">Terms of Use</a>
        <span class="text-gray-300">|</span>
        <a href="/editorial-policy" class="text-purple-600 hover:text-purple-800 font-semibold text-sm">Editorial Policy</a>
        <span class="text-gray-300">|</span>
        <a href="/contact" class="text-purple-600 hover:text-purple-800 font-semibold text-sm">Contact Us</a>
    </div>

</div>

@section Scripts {
<script>
(function () {
    function wrapMvContent() {
        var outerMain = document.querySelector('main.site-main');
        var wrapper = document.getElementById('mv-notice-wrapper');
        var section = document.getElementById('mv-section');
        if (!outerMain || !wrapper || !section) return;

        var injected = Array.from(outerMain.children).filter(function (el) {
            return !el.classList.contains('max-w-4xl') && el.tagName !== 'SCRIPT';
        });
        if (injected.length === 0) return;

        injected.forEach(function (el) { wrapper.appendChild(el); });
        section.style.display = '';
    }

    var outerMain = document.querySelector('main.site-main');
    if (!outerMain) return;
    var observer = new MutationObserver(wrapMvContent);
    observer.observe(outerMain, { childList: true });
    wrapMvContent();
})();
</script>
}
