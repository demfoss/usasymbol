@{
    ViewData["Title"] = ViewData["Title"] ?? "Contact";
    ViewData["Description"] ??= "Have a question, suggestion, or found an error on USA Symbol? Contact the team using this form or by email.";
}

<div class="max-w-5xl mx-auto px-4 py-12">

    <!-- HERO -->
    <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Get in Touch</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Have a question, suggestion, or found an error? We'd love to hear from you!
        </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">

        <!-- CONTACT FORM -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Send Us a Message</h2>

            <form id="contactForm" class="space-y-5">

                <!-- Name -->
                <div>
                    <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                        Your Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           id="name"
                           name="name"
                           required
                           class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-600 focus:border-transparent transition"
                           placeholder="John Doe">
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                        Email Address <span class="text-red-500">*</span>
                    </label>
                    <input type="email"
                           id="email"
                           name="email"
                           required
                           class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-600 focus:border-transparent transition"
                           placeholder="john@example.com">
                </div>

                <!-- Subject -->
                <div>
                    <label for="subject" class="block text-sm font-semibold text-gray-700 mb-2">
                        Subject <span class="text-red-500">*</span>
                    </label>
                    <select id="subject"
                            name="subject"
                            required
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-600 focus:border-transparent transition">
                        <option value="">Select a subject...</option>
                        <option value="Report an Error/Correction">Report an Error/Correction</option>
                        <option value="Content Suggestion">Content Suggestion</option>
                        <option value="General Question">General Question</option>
                        <option value="Feedback">Feedback</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <!-- Message -->
                <div>
                    <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
                        Message <span class="text-red-500">*</span>
                    </label>
                    <textarea id="message"
                              name="message"
                              rows="6"
                              required
                              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-600 focus:border-transparent transition resize-none"
                              placeholder="Tell us what's on your mind..."></textarea>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-lg shadow-sm hover:shadow-md transition">
                    Send Message
                </button>

                <p class="text-xs text-gray-500 text-center mt-2">
                    We typically respond within 48 hours
                </p>
            </form>
        </div>

        <!-- CONTACT INFO & CARDS -->
        <div class="space-y-6">

            <!-- Email Card -->
            <div class="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-2xl p-6 border border-purple-200">
                <div class="flex items-start gap-4">
                    <div class="bg-purple-600 rounded-lg p-3 flex-shrink-0 flex items-center justify-center">
                        <i class="fa-solid fa-envelope text-white text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-gray-900 mb-1">Email Us</h3>
                        <p class="text-gray-600 text-sm mb-3">Send us an email anytime</p>
                        <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="text-purple-600 hover:text-purple-800 font-semibold text-lg">
                            contact@usasymbol.com
                        </a>
                    </div>
                </div>
            </div>

            <!-- Location Card -->
            <div class="bg-gradient-to-br from-blue-50 to-cyan-50 rounded-2xl p-6 border border-blue-200">
                <div class="flex items-start gap-4">
                    <div class="bg-blue-600 rounded-lg p-3 flex-shrink-0 flex items-center justify-center">
                        <i class="fa-solid fa-location-dot text-white text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-gray-900 mb-1">Our Location</h3>
                        <p class="text-gray-600 text-sm mb-2">Based in</p>
                        <p class="text-gray-800 font-semibold">
                            Chicago, Illinois<br />
                            United States
                        </p>
                    </div>
                </div>
            </div>

            <!-- Response Time Card -->
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-6 border border-green-200">
                <div class="flex items-start gap-4">
                    <div class="bg-green-600 rounded-lg p-3 flex-shrink-0 flex items-center justify-center">
                        <i class="fa-solid fa-clock text-white text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-gray-900 mb-1">Response Time</h3>
                        <p class="text-gray-600 text-sm mb-2">We aim to respond within</p>
                        <p class="text-gray-800 font-semibold text-lg">48 Hours</p>
                        <p class="text-gray-600 text-xs mt-2">Monday - Friday</p>
                    </div>
                </div>
            </div>

            <!-- Social/Links Card -->
            <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg text-gray-900 mb-4">Connect With Us</h3>
                <div class="space-y-3">
                    <a href="https://www.linkedin.com/in/artsiom-dusau/" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition group">
                        <i class="fa-brands fa-linkedin text-blue-600 text-2xl"></i>
                        <span class="text-gray-700 group-hover:text-purple-600 font-semibold">LinkedIn Profile</span>
                    </a>
                    <a href="/about" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition group">
                        <i class="fa-solid fa-circle-info text-purple-600 text-2xl"></i>
                        <span class="text-gray-700 group-hover:text-purple-600 font-semibold">About Us</span>
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- FAQ SECTION -->
    <section class="mt-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Frequently Asked Questions</h2>

        <div class="grid md:grid-cols-2 gap-6">

            <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg text-gray-900 mb-2">How do I report an error?</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    If you find an error or outdated information, please email us at
                    <a href="/contact" data-email-user="contact" data-email-domain="usasymbol.com" class="text-purple-600 hover:underline font-semibold">
                        contact@usasymbol.com
                    </a>
                    with the page URL and the correction. We investigate all reports within 48 hours and update content promptly.
                </p>
            </div>

            <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg text-gray-900 mb-2">Can I suggest new content?</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    Absolutely! We welcome suggestions for new content, additional information, or topics you'd like us to cover.
                    Use the contact form above or email us directly with your ideas.
                </p>
            </div>

            <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg text-gray-900 mb-2">Can I use your content?</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    You may quote brief excerpts with proper attribution for educational purposes. For commercial use or republishing content,
                    please contact us for permission. See our
                    <a href="/terms" class="text-purple-600 hover:underline">Terms of Use</a> for details.
                </p>
            </div>

            <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg text-gray-900 mb-2">How can I support your work?</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    USA Symbol is free to use. You can support us by sharing our content, providing feedback to help us improve,
                    and reporting any errors you find. Thank you for being part of our community!
                </p>
            </div>

        </div>
    </section>

    <!-- QUICK LINKS -->
    <section class="mt-16 bg-gradient-to-r from-purple-50 to-indigo-50 rounded-2xl p-8 border border-purple-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Looking for Something Else?</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4">
            <a href="/about" class="bg-white p-4 rounded-lg hover:shadow-md transition text-center">
                <div class="mb-2 flex justify-center">
                    <i class="fa-solid fa-book-open text-purple-600 text-2xl"></i>
                </div>
                <div class="font-semibold text-gray-900">About Us</div>
                <div class="text-xs text-gray-600 mt-1">Learn our mission</div>
            </a>
            <a href="/editorial-policy" class="bg-white p-4 rounded-lg hover:shadow-md transition text-center">
                <div class="mb-2 flex justify-center">
                    <i class="fa-solid fa-check-circle text-green-600 text-2xl"></i>
                </div>
                <div class="font-semibold text-gray-900">Editorial Policy</div>
                <div class="text-xs text-gray-600 mt-1">Our standards</div>
            </a>
            <a href="/privacy" class="bg-white p-4 rounded-lg hover:shadow-md transition text-center">
                <div class="mb-2 flex justify-center">
                    <i class="fa-solid fa-lock text-blue-600 text-2xl"></i>
                </div>
                <div class="font-semibold text-gray-900">Privacy Policy</div>
                <div class="text-xs text-gray-600 mt-1">Your data protection</div>
            </a>
            <a href="/terms" class="bg-white p-4 rounded-lg hover:shadow-md transition text-center">
                <div class="mb-2 flex justify-center">
                    <i class="fa-solid fa-file-contract text-orange-500 text-2xl"></i>
                </div>
                <div class="font-semibold text-gray-900">Terms of Use</div>
                <div class="text-xs text-gray-600 mt-1">Usage guidelines</div>
            </a>
        </div>
    </section>

</div>

<!-- SIMPLE MAILTO SCRIPT -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('contactForm');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const name = document.getElementById('name').value || '';
            const email = document.getElementById('email').value || '';
            const subject = document.getElementById('subject').value || '';
            const message = document.getElementById('message').value || '';

            const mailSubject = `[USA Symbol] ${subject || 'New message from contact form'}`;
            const body =
                `Name: ${name}\n` +
                `Email: ${email}\n` +
                `Subject: ${subject}\n\n` +
                `Message:\n${message}`;

            const mailto =
                "mailto:contact@usasymbol.com?subject=" +
                encodeURIComponent(mailSubject) +
                "&body=" +
                encodeURIComponent(body);

            window.location.href = mailto;
        });
    });
</script>
