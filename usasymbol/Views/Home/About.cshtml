@{
    ViewData["Title"] = "About USA Symbol - Educational Resource on American Heritage";
    ViewData["Description"] = "Learn about USA Symbol, a comprehensive educational resource dedicated to preserving and sharing knowledge about official state symbols across America.";
    ViewData["OgType"] = "website";
    ViewData["Canonical"] = "/about";
}

<!-- HERO SECTION -->
<section class="gradient-bg text-white py-20 px-4">
    <div class="max-w-5xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 fade-in">
            About USA Symbol
        </h1>
        <p class="text-lg md:text-xl text-blue-100 fade-in delay-1 max-w-2xl mx-auto">
            Preserving American heritage through accurate, accessible information about official state symbols.
        </p>
    </div>
</section>

<!-- MISSION SECTION -->
<section class="py-16 px-4 bg-gray-50">
    <div class="max-w-4xl mx-auto">
        <div class="fade-in">
            <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center gradient-text">
                Our Mission
            </h2>
            <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
                <p class="text-lg mb-6">
                    USA Symbol is dedicated to creating one of the most comprehensive, accurate, and accessible digital resources
                    for information about official state symbols across the United States of America.
                </p>
                <p class="mb-6">
                    Our platform serves students, educators, researchers, and anyone curious about American state heritage.
                    We believe that understanding state symbols helps people connect with local history, appreciate regional
                    diversity, and develop a deeper sense of civic pride.
                </p>
                <p class="mb-6">
                    Every piece of information on our site is carefully researched and verified against official state government
                    sources and reliable references. We maintain a rigorous fact-checking process and regularly update our content
                    to reflect any changes in official designations.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- FOUNDER SECTION -->
<section class="py-16 bg-gradient-to-r from-blue-50 via-slate-50 to-red-50 px-4">
    <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-10 text-center">
            Meet Our Founder
        </h2>

