                                    <span style="display:inline-flex;width:36px;height:36px;align-items:center;justify-content:center;border-radius:12px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);color:#fff;font-weight:900;font-size:.9rem;letter-spacing:.04em">TX</span>
