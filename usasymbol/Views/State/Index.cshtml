                                <i class="fa-solid fa-users"></i>
                                <div style="position:absolute;bottom:10px;left:12px;display:flex;gap:5px">
                                    <span style="width:8px;height:8px;border-radius:50%;background:#3b82f6;opacity:.85"></span>
                                    <span style="width:8px;height:8px;border-radius:50%;background:#22c55e;opacity:.85"></span>
                                    <span style="width:8px;height:8px;border-radius:50%;background:#f59e0b;opacity:.85"></span>
                                    <span style="width:8px;height:8px;border-radius:50%;background:#ef4444;opacity:.85"></span>
