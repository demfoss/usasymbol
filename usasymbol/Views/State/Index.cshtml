@model USASymbol.Models.ViewModels.StateViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"] = $"{Model.State.Name} State Symbols | Bird, Flower, Flag & More";
    ViewData["Description"] = $"Explore the official symbols of {Model.State.Name}, including the state bird, flower, tree, flag, beverage, dinosaur, motto, and other recognized state symbols.";
}

@section Styles {
<style>
    /* === STATE DETAIL ========================================= */

    /* Breadcrumbs */
    .state-breadcrumb {
        background: var(--cream);
        border-bottom: 1px solid var(--cream-dark);
        padding: .75rem 0;
        font-size: .8rem;
    }
    .state-breadcrumb a { color: #2C5F9E; text-decoration: none; }
    .state-breadcrumb a:hover { text-decoration: underline; }
    .state-breadcrumb span { color: var(--slate-ed); margin: 0 .4rem; }

    /* Hero */
    .state-hero { padding: clamp(3rem,7vw,5rem) 0 clamp(2rem,5vw,3.5rem); }

    /* Symbol grid */
    .symbol-card {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .75rem;
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: .875rem;
        text-decoration: none;
        transition: box-shadow .2s, border-color .2s, transform .2s;
    }
    .symbol-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(27,42,74,.08);
        border-color: var(--gold-border);
    }
    .sym-thumb {
        flex-shrink: 0;
        width: 4rem;
        height: 4rem;
        border-radius: .625rem;
        overflow: hidden;
        background: var(--cream);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .sym-thumb img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform .3s ease;
    }
    .symbol-card:hover .sym-thumb img { transform: scale(1.07); }
    .sym-thumb .sym-icon { font-size: 1.5rem; color: var(--navy); opacity: .4; }
    .sym-info { flex: 1; min-width: 0; }
    .sym-type {
        font-size: .6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .14em;
        color: var(--gold);
        margin-bottom: .15rem;
    }
    .sym-name {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: .9rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .sym-sub { font-size: .72rem; color: var(--slate-ed); margin-top: .15rem; font-style: italic; }

    /* Sidebar widgets */
    .sidebar-widget {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 1rem;
        padding: 1.25rem;
    }
    .widget-title {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .widget-title i { color: var(--gold); }
    .fact-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .1rem;
        padding: .5rem 0;
        border-bottom: 1px solid var(--cream-dark);
        font-size: .82rem;
    }
    .fact-row:last-child { border-bottom: none; }
    .fact-label { color: var(--slate-ed); }
    .fact-value { font-weight: 700; color: var(--navy); text-align: right; }

    /* Related state */
    .related-state {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .625rem;
        border-radius: .625rem;
        text-decoration: none;
        transition: background .2s;
    }
    .related-state:hover { background: var(--cream); }
    .rs-flag {
        width: 3rem; height: 2rem;
        object-fit: cover; border-radius: .25rem;
        border: 1px solid var(--cream-dark);
        flex-shrink: 0;
    }
    .rs-name { font-size: .85rem; font-weight: 700; color: var(--navy); }
    .rs-capital { font-size: .72rem; color: var(--slate-ed); }

    /* Compare CTA */
    .compare-cta {
        background: var(--cream);
        border-top: 1px solid var(--cream-dark);
        border-bottom: 1px solid var(--cream-dark);
        padding: 2.5rem 0;
    }
    .compare-pill {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .55rem 1.1rem;
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 9999px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--navy);
        text-decoration: none;
        transition: border-color .2s, box-shadow .2s;
    }
    .compare-pill:hover {
        border-color: var(--gold-border);
        box-shadow: 0 4px 14px rgba(27,42,74,.08);
    }
    .compare-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.4rem;
        background: var(--navy);
        color: var(--cream);
        border-radius: .625rem;
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background .2s;
        white-space: nowrap;
    }
    .compare-btn:hover { background: var(--navy-light); }

    /* Guide cards */
    .guide-card {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 1rem;
        padding: 1.5rem;
        border-left: 4px solid var(--gold);
        text-decoration: none;
        display: block;
        transition: box-shadow .2s, transform .2s;
    }
    .guide-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(27,42,74,.08);
    }
    .guide-card-icon {
        width: 2.75rem; height: 2.75rem;
        background: var(--cream);
        border-radius: .625rem;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 1rem;
    }
    .guide-card-icon i { color: var(--navy); font-size: 1.1rem; }
    .guide-card h3 {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .5rem;
    }
    .guide-card p { font-size: .85rem; color: var(--slate-ed); line-height: 1.6; }
    .guide-card-cta {
        margin-top: .875rem;
        font-size: .82rem;
        font-weight: 700;
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        gap: .375rem;
    }
</style>
}

<!-- Breadcrumbs -->
<nav class="state-breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center flex-wrap gap-1">
            <li><a href="/">Home</a></li>
            <li><span>/</span><a href="/states">States</a></li>
            <li><span>/</span><strong style="color:var(--navy)">@Model.State.Name</strong></li>
        </ol>
    </div>
</nav>

<!-- ════════════════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════════════════ -->
<section class="editorial-hero state-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="position:relative;z-index:1">
        <div class="grid md:grid-cols-3 gap-10 items-center">

            <!-- Left: text + facts bar -->
            <div class="md:col-span-2 order-2 md:order-1">
                <div class="hero-pill inline-flex mb-4">
                    <i class="fa-solid fa-star"></i>
                    State Symbols Guide
                </div>
                <h1 class="hero-title" style="font-size:clamp(2rem,5vw,3.25rem);margin:.5rem 0 .75rem">
                    @Model.State.Name
                </h1>
                <p class="hero-subtitle mb-6">
                    @(Model.State.Region ?? "U.S.") State &mdash; Official symbols, history, and cultural heritage.
                </p>

                <div class="facts-bar" style="max-width:520px">
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value">@Model.State.Abbreviation</div>
                        <div class="facts-bar__label">Abbreviation</div>
                    </div>
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value" style="font-size:.95rem">@Model.State.Capital</div>
                        <div class="facts-bar__label">Capital</div>
                    </div>
                    @if (Model.State.StateHoodDate.HasValue)
                    {
                        <div class="facts-bar__cell">
                            <div class="facts-bar__value">@Model.State.StateHoodDate.Value.Year</div>
                            <div class="facts-bar__label">Statehood</div>
                        </div>
                    }
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value">@Model.Symbols.Count</div>
                        <div class="facts-bar__label">Symbols</div>
                    </div>
                </div>
            </div>

            <!-- Right: flag -->
            <div class="md:col-span-1 order-1 md:order-2 flex justify-center">
                @if (!string.IsNullOrEmpty(Model.State.FlagImageUrl))
                {
                    <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:1.25rem;padding:.875rem;box-shadow:0 24px 60px rgba(0,0,0,.3)">
                        <img src="@Images.Hero(Model.State.FlagImageUrl)"
                             alt="@Model.State.Name flag"
                             class="rounded-xl shadow-lg"
                             style="width:100%;max-width:280px;display:block;object-fit:fill">
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     MAIN CONTENT
     ════════════════════════════════════════════════════════ -->
<section style="padding:3.5rem 0 4rem;background:var(--cream)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-10 items-start">

            <!-- Symbols grid -->
            <div class="lg:col-span-2">
                <h2 class="content-h2 mb-6">Official State Symbols</h2>

                @if (Model.Symbols.Any())
                {
                    var regionKey = (Model.State.Region ?? "default").ToLower().Replace(" ", "-");
                    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-3">
                        @foreach (var symbol in Model.Symbols)
                        {
                            var symbolUrl = symbol.ToSymbolUrl(Model.State.Slug);
                            <a href="@symbolUrl" class="symbol-card">
                                <div class="sym-thumb">
                                    @if (!string.IsNullOrEmpty(symbol.ImageUrl))
                                    {
                                        <img src="@Images.Card(symbol.ImageUrl)"
                                             alt="@symbol.Name"
                                             onerror="this.onerror=null;this.src='/images/regions/@(regionKey).webp'"
                                             loading="lazy">
                                    }
                                    else
                                    {
                                        <i class="fa-solid @GetSymbolFaIcon(symbol.Type) sym-icon"></i>
                                    }
                                </div>
                                <div class="sym-info">
                                    <div class="sym-type">@GetSymbolTypeName(symbol)</div>
                                    <div class="sym-name">@symbol.Name</div>
                                    @if (!string.IsNullOrEmpty(symbol.ScientificName))
                                    {
                                        <div class="sym-sub">@symbol.ScientificName</div>
                                    }
                                    else if (symbol.AdoptedYear.HasValue)
                                    {
                                        <div class="sym-sub">Since @symbol.AdoptedYear</div>
                                    }
                                </div>
                                <i class="fa-solid fa-chevron-right" style="color:var(--cream-dark);font-size:.7rem;flex-shrink:0"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div style="background:white;border:1.5px dashed var(--cream-dark);border-radius:1rem;padding:3rem;text-align:center">
                        <i class="fa-solid fa-leaf text-4xl mb-3" style="color:var(--cream-dark);display:block"></i>
                        <p style="color:var(--slate-ed)">No symbols available yet. New content coming soon.</p>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div style="display:flex;flex-direction:column;gap:1.25rem" class="lg:sticky lg:top-24">

                    <!-- Quick Facts -->
                    <div class="sidebar-widget">
                        <div class="widget-title">
                            <i class="fa-solid fa-chart-bar"></i>
                            Quick Facts
                        </div>
                        <dl>
                            <div class="fact-row">
                                <dt class="fact-label">Official Name</dt>
                                <dd class="fact-value">@Model.State.Name</dd>
                            </div>
                            <div class="fact-row">
                                <dt class="fact-label">Abbreviation</dt>
                                <dd class="fact-value">@Model.State.Abbreviation</dd>
                            </div>
                            <div class="fact-row">
                                <dt class="fact-label">Capital City</dt>
                                <dd class="fact-value">@Model.State.Capital</dd>
                            </div>
                            @if (Model.State.Population.HasValue)
                            {
                                <div class="fact-row">
                                    <dt class="fact-label">Population</dt>
                                    <dd class="fact-value">@Model.State.Population.Value.ToString("N0")</dd>
                                </div>
                            }
                            @if (Model.State.StateHoodDate.HasValue)
                            {
                                <div class="fact-row">
                                    <dt class="fact-label">Statehood</dt>
                                    <dd class="fact-value">@Model.State.StateHoodDate.Value.ToString("MMMM d, yyyy")</dd>
                                </div>
                            }
                            <div class="fact-row">
                                <dt class="fact-label">Region</dt>
                                <dd class="fact-value">@(Model.State.Region ?? "N/A")</dd>
                            </div>
                            <div class="fact-row">
                                <dt class="fact-label">Symbols</dt>
                                <dd class="fact-value">@Model.Symbols.Count</dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Related States -->
                    @if (Model.RelatedStates.Any())
                    {
                        <div class="sidebar-widget">
                            <div class="widget-title">
                                <i class="fa-solid fa-map"></i>
                                Other @(Model.State.Region ?? "Related") States
                            </div>
                            <div style="display:flex;flex-direction:column;gap:.25rem">
                                @foreach (var rs in Model.RelatedStates)
                                {
                                    <a href="/states/@rs.Slug" class="related-state">
                                        @if (!string.IsNullOrEmpty(rs.FlagImageUrl))
                                        {
                                            <img src="@Images.Thumb(rs.FlagImageUrl)" alt="@rs.Name flag" class="rs-flag">
                                        }
                                        <div>
                                            <div class="rs-name">@rs.Name</div>
                                            <div class="rs-capital">@rs.Capital</div>
                                        </div>
                                    </a>
                                }
                            </div>
                            <a href="/states"
                               style="display:block;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--cream-dark);font-size:.8rem;font-weight:700;color:#2C5F9E;text-align:center;text-decoration:none">
                                View All States <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     COMPARE CTA
     ════════════════════════════════════════════════════════ -->
<section class="compare-cta">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-start gap-4 mb-5">
            <div style="flex-shrink:0;width:2.75rem;height:2.75rem;background:var(--navy);border-radius:.625rem;display:flex;align-items:center;justify-content:center">
                <i class="fa-solid fa-scale-balanced" style="color:var(--cream);font-size:1rem"></i>
            </div>
            <div>
                <h2 style="font-family:'Libre Baskerville',Georgia,serif;font-size:1.2rem;font-weight:700;color:var(--navy);margin-bottom:.25rem">
                    Compare @Model.State.Name with Another State
                </h2>
                <p style="font-size:.85rem;color:var(--slate-ed)">
                    See how @Model.State.Name ranks by population, land area, cost of living, taxes, income, and more.
                </p>
            </div>
        </div>

        @if (Model.RelatedStates.Any())
        {
            <div class="flex flex-wrap gap-2 mb-5">
                @foreach (var rs in Model.RelatedStates)
                {
                    var pairSlug = string.Compare(Model.State.Slug, rs.Slug, StringComparison.Ordinal) < 0
                        ? $"{Model.State.Slug}-vs-{rs.Slug}"
                        : $"{rs.Slug}-vs-{Model.State.Slug}";
                    <a href="/compare/@pairSlug" class="compare-pill">
                        @if (!string.IsNullOrWhiteSpace(rs.FlagImageUrl))
                        {
                            <img src="@Images.Thumb(rs.FlagImageUrl)" alt="@rs.Name flag"
                                 style="width:1.75rem;height:1.15rem;object-fit:cover;border-radius:2px;flex-shrink:0"
                                 onerror="this.style.display='none'" />
                        }
                        <span>vs @rs.Name</span>
                        <i class="fa-solid fa-arrow-right" style="font-size:.6rem;opacity:.5"></i>
                    </a>
                }
            </div>
        }

        <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
            <span style="font-size:.82rem;color:var(--slate-ed);font-weight:600;white-space:nowrap">Or compare with any state:</span>
            <div class="flex gap-3 flex-1">
                <select id="compare-state-select"
                        style="display:block;flex:1;max-width:13rem;border:1px solid var(--cream-dark);background:white;border-radius:.625rem;padding:.6rem 1rem;font-size:.85rem;color:var(--navy)">
                    <option value="">Choose a state&hellip;</option>
                    @foreach (var rs in Model.RelatedStates)
                    {
                        <option value="@rs.Slug">@rs.Name</option>
                    }
                </select>
                <a id="compare-go-btn" href="/compare-states" class="compare-btn">
                    <i class="fa-solid fa-scale-balanced"></i> Compare
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     GUIDES
     ════════════════════════════════════════════════════════ -->
<section style="padding:3.5rem 0 4.5rem;background:white">
    <div class="max-w-6xl mx-auto px-4">
        <h2 class="content-h2 mb-8 text-center">@Model.State.Name Guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <a href="/states/@Model.State.Slug/borders" class="guide-card">
                <div class="guide-card-icon">
                    <i class="fa-solid fa-map"></i>
                </div>
                <h3>Borders</h3>
                <p>See what states, countries, and waters border @Model.State.Name. Complete breakdown with facts.</p>
                <span class="guide-card-cta">View Borders <i class="fa-solid fa-arrow-right text-xs"></i></span>
            </a>
        </div>
    </div>
</section>

<script>
    (function () {
        var slug = '@Model.State.Slug';
        var sel = document.getElementById('compare-state-select');
        var btn = document.getElementById('compare-go-btn');
        sel.addEventListener('change', function () {
            if (!sel.value) { btn.href = '/compare-states'; return; }
            var pair = [slug, sel.value].sort().join('-vs-');
            btn.href = '/compare/' + pair;
        });
    })();
</script>

@functions {
    string GetSymbolTypeName(USASymbol.Models.Symbol symbol)
    {
        if (!string.IsNullOrWhiteSpace(symbol.Designation))
        {
            return System.Globalization.CultureInfo.InvariantCulture.TextInfo
                .ToTitleCase(symbol.Designation.Trim().ToLowerInvariant());
        }

        return symbol.Type switch
        {
            "bird"      => "State Bird",
            "flower"    => "State Flower",
            "tree"      => "State Tree",
            "motto"     => "State Motto",
            "mammal"    => "State Mammal",
            "beverage"  => "State Beverage",
            "dinosaur"  => "State Dinosaur",
            "flag"      => "State Flag",
            _ => $"State {char.ToUpper(symbol.Type[0]) + symbol.Type.Substring(1)}"
        };
    }

    string GetSymbolFaIcon(string type)
    {
        return type switch
        {
            "bird"      => "fa-dove",
            "flower"    => "fa-seedling",
            "tree"      => "fa-tree",
            "motto"     => "fa-scroll",
            "mammal"    => "fa-paw",
            "beverage"  => "fa-mug-hot",
            "dinosaur"  => "fa-dragon",
            "flag"      => "fa-flag",
            "color"     => "fa-palette",
            "fish"      => "fa-fish",
            "insect"    => "fa-bug",
            "mineral"   => "fa-gem",
            "rock"      => "fa-mountain",
            "song"      => "fa-music",
            "sport"     => "fa-trophy",
            _           => "fa-star"
        };
    }
}
