@model USASymbol.Models.ViewModels.StateViewModel
@inject IImageUrlService Images
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using USASymbol.Extensions

@{
    var isFederalDistrict = string.Equals(Model.State.Abbreviation, "DC", StringComparison.OrdinalIgnoreCase);
    var symbolsHeading = isFederalDistrict
        ? $"{Model.State.Name} Symbols"
        : $"{Model.State.Name} State Symbols";
    ViewData["Title"] = isFederalDistrict
        ? $"{Model.State.Name} Symbols | Flag, Facts & More"
        : $"{Model.State.Name} State Symbols | Bird, Flower, Flag & More";
    ViewData["Description"] = !string.IsNullOrWhiteSpace(Model.HubContent?.SeoDescription)
        ? Model.HubContent.SeoDescription
        : $"{Model.State.Name} state symbols list: official state symbols including the flag, bird, flower, tree, motto, nickname, animals, and other state emblems and symbols.";
    var stateFaqItems = GetStateFaq(Model).ToList();
    ViewData["FaqItems"] = stateFaqItems;
    var faqViewData = new ViewDataDictionary(ViewData) { ["FaqItems"] = stateFaqItems, ["FaqSectionId"] = "state-faq" };
    var regionKey = (Model.State.Region ?? "default").ToLower().Replace(" ", "-");
    var oldestSymbol = Model.Symbols.Where(s => s.AdoptedYear.HasValue).OrderBy(s => s.AdoptedYear).FirstOrDefault();
    var newestSymbols = Model.Symbols.Where(s => s.AdoptedYear.HasValue).OrderByDescending(s => s.AdoptedYear).Take(2).ToList();
    var recognizedSymbols = GetRecognizedSymbols(Model).ToList();
}

@section Styles {
<style>
/* ── Layout ──────────────────────────────────────────── */
.state-main { background: var(--cream); padding: 2.5rem 0 4rem; }
.editorial-hero.state-hero { padding-top: 3rem; padding-bottom: 4.25rem; }
.state-hero .facts-bar { margin-bottom: .5rem; }

@@media (min-width: 1024px) {
    .state-layout-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 288px;
        gap: 2.5rem;
        align-items: start;
    }
}
.state-sidebar-sticky { position: sticky; top: 5.5rem; }

/* ── Overview card ──────────────────────────────────── */
.state-overview {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, rgba(255,255,255,.7) 0%, rgba(255,249,240,.1) 100%);
    padding: 1.5rem 1.5rem 1.5rem 2.25rem;
    margin-bottom: 2rem;
}
.state-overview::before {
    content: '';
    position: absolute;
    left: 0; top: 1.75rem; bottom: 1.75rem;
    width: 3px;
    background: linear-gradient(180deg, #d8b36a 0%, #c46243 100%);
    border-radius: 9999px;
}
.state-overview-icon {
    flex-shrink: 0;
    width: 2.75rem; height: 2.75rem;
    background: white; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--slate-ed);
    border: 1px solid var(--cream-dark);
}

/* ── Typography — used across all content sections ── */

/* Section eyebrow label */
.state-label {
    font-family: var(--font-ui);
    font-size: .65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--slate-ed);
    margin-bottom: .5rem;
}

/* Main content paragraphs — article font, readable ink */
.state-body {
    font-family: var(--font-article);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--ink);
    margin: 0 0 .875rem;
}
.state-body strong { color: var(--navy); font-weight: 700; }
.state-body a { color: var(--link-color); }

/* Secondary / helper text — UI font, muted */
.state-meta {
    font-family: var(--font-ui);
    font-size: .82rem;
    line-height: 1.6;
    color: var(--slate-ed);
}

/* ── Mini facts ─────────────────────────────────────── */
.state-mini-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
}
.state-mini-fact {
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: .625rem;
    padding: .75rem .875rem;
}
.state-mini-fact span {
    display: block;
    font-family: var(--font-ui);
    color: var(--gold);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: .25rem;
}
.state-mini-fact strong {
    font-family: var(--font-ui);
    color: var(--navy);
    font-size: .9rem;
    font-weight: 700;
    line-height: 1.25;
}

/* ── Section separators ─────────────────────────────── */
.state-section {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--cream-dark);
}

/* ── Symbol table ───────────────────────────────────── */
.state-table-wrap { background: white; border: 1px solid var(--cream-dark); border-radius: .5rem; overflow: hidden; }
.state-symbol-table { width: 100%; border-collapse: collapse; }
.state-symbol-table th {
    font-family: var(--font-ui);
    background: #fbfaf7;
    color: var(--navy);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-align: left;
    text-transform: uppercase;
    padding: .75rem .9rem;
    border-bottom: 1px solid var(--cream-dark);
}
.state-symbol-table td {
    font-family: var(--font-ui);
    color: var(--slate-ed);
    font-size: .875rem;
    padding: .75rem .9rem;
    border-bottom: 1px solid var(--cream-dark);
    vertical-align: middle;
}
.state-symbol-table tbody tr { cursor: pointer; transition: background .18s; }
.state-symbol-table tbody tr:hover { background: #fbfaf7; }
.state-symbol-table tbody tr:focus-visible { outline: 2px solid var(--gold-border); outline-offset: -2px; }
.state-symbol-table tr:last-child td { border-bottom: none; }
.state-symbol-table strong { color: var(--navy); font-weight: 700; }
.table-symbol-thumb { width: 2.75rem; height: 2.75rem; border-radius: .375rem; overflow: hidden; background: var(--cream); border: 1px solid var(--cream-dark); display: flex; align-items: center; justify-content: center; }
.table-symbol-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.table-symbol-thumb img.is-seal-thumb { object-fit: contain; padding: .18rem; }
.table-symbol-thumb i { color: var(--navy); opacity: .4; font-size: .85rem; }
.table-page-link { display: inline-flex; width: 1.75rem; height: 1.75rem; align-items: center; justify-content: center; border-radius: 999px; background: var(--cream); color: var(--navy) !important; text-decoration: none !important; font-size: .65rem; }

/* ── Meaning groups ─────────────────────────────────── */
.meaning-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .875rem; margin-top: 1.25rem; }
.meaning-group {
    background: white;
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    border-radius: .5rem;
    padding: 1.1rem 1.1rem 1rem;
    box-shadow: 0 2px 8px rgba(27,42,74,.04);
}
.meaning-group h3 {
    font-family: var(--font-article);
    color: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: .875rem;
    padding-bottom: .625rem;
    border-bottom: 1px solid var(--cream-dark);
}
.meaning-item { display: grid; gap: .2rem; padding: .5rem 0; border-top: 1px solid var(--cream-dark); }
.meaning-item:first-of-type { border-top: none; padding-top: 0; }
.meaning-item dt {
    font-family: var(--font-ui);
    color: var(--gold);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}
.meaning-item dd {
    font-family: var(--font-ui);
    color: var(--ink);
    font-size: .875rem;
    line-height: 1.6;
    margin: 0;
}
.meaning-item dd a { color: var(--link-color); }

/* ── Timeline ───────────────────────────────────────── */
.timeline-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1rem; }
.timeline-card { background: white; border: 1px solid var(--cream-dark); border-radius: .625rem; padding: 1rem 1.1rem; }
.timeline-card span {
    display: block;
    font-family: var(--font-ui);
    color: var(--gold);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: .35rem;
}
.timeline-card strong {
    font-family: var(--font-article);
    color: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    display: block;
    line-height: 1.3;
}
.timeline-card p {
    font-family: var(--font-ui);
    color: var(--slate-ed);
    font-size: .82rem;
    line-height: 1.6;
    margin: .4rem 0 0;
}

/* ── Sidebar widgets ────────────────────────────────── */
.sidebar-widget { background: white; border: 1px solid var(--cream-dark); border-radius: .875rem; padding: 1.25rem; }
.widget-title {
    font-family: var(--font-article);
    font-size: .97rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: .875rem;
    display: flex; align-items: center; gap: .5rem;
}
.widget-title i { color: var(--gold); font-size: .85rem; }
.fact-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .5rem;
    padding: .45rem 0;
    border-bottom: 1px solid var(--cream-dark);
    font-family: var(--font-ui);
    font-size: .82rem;
}
.fact-row:last-child { border-bottom: none; }
.fact-label { color: var(--slate-ed); }
.fact-value { font-weight: 700; color: var(--navy); text-align: right; }

/* ── Recognized list ────────────────────────────────── */
.recognized-list { display: flex; flex-direction: column; border-top: 1px solid var(--cream-dark); }
.recognized-list__item { display: flex; align-items: center; gap: .65rem; border-bottom: 1px solid var(--cream-dark); padding: .65rem 0; text-decoration: none; }
.recognized-list__item:last-child { border-bottom: none; }
.recognized-list__icon { width: 1.875rem; height: 1.875rem; border-radius: .35rem; background: #fbfaf7; display: flex; align-items: center; justify-content: center; color: var(--gold); flex-shrink: 0; font-size: .75rem; }
.recognized-list__type {
    font-family: var(--font-ui);
    color: var(--gold);
    display: block;
    font-size: .55rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.2;
}
.recognized-list__name {
    font-family: var(--font-ui);
    color: var(--navy);
    display: block;
    font-size: .85rem;
    font-weight: 700;
    line-height: 1.2;
    margin-top: .1rem;
}

/* ── Related state ──────────────────────────────────── */
.related-state { display: flex; align-items: center; gap: .65rem; padding: .45rem .35rem; border-radius: .5rem; text-decoration: none; transition: background .2s; }
.related-state:hover { background: var(--cream); }
.rs-flag { width: 2.75rem; height: 1.8rem; object-fit: cover; border-radius: .25rem; border: 1px solid var(--cream-dark); flex-shrink: 0; }
.rs-name { font-family: var(--font-ui); font-size: .85rem; font-weight: 700; color: var(--navy); }
.rs-capital { font-family: var(--font-ui); font-size: .72rem; color: var(--slate-ed); }
.rs-abbr-link { font-family: var(--font-ui); font-size: .68rem; color: #2C5F9E; font-weight: 700; display: inline-flex; align-items: center; gap: .25rem; margin-top: .12rem; }


/* ── Guide cards ────────────────────────────────────── */
.guide-carousel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
}
.guide-card {
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: .5rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: box-shadow .2s, transform .2s, border-color .2s;
}
.guide-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(27,42,74,.07); border-color: var(--gold-border); }
.guide-card-banner { height: 4.75rem; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.guide-card-banner i { color: rgba(255,255,255,.75); font-size: 1.6rem; }
.guide-card-body { padding: .75rem; display: flex; flex-direction: column; flex: 1; }
.guide-card-eyebrow { font-family: var(--font-ui); font-size: .52rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--gold); margin-bottom: .25rem; }
.guide-card h3 { font-family: var(--font-article); font-size: .9rem; font-weight: 700; color: var(--navy); line-height: 1.2; margin-bottom: .35rem; }
.guide-card p { font-family: var(--font-ui); font-size: .72rem; color: var(--slate-ed); line-height: 1.45; flex: 1; }
.guide-card-cta { font-family: var(--font-ui); margin-top: .55rem; font-size: .7rem; font-weight: 700; color: var(--navy); display: inline-flex; align-items: center; gap: .3rem; }
@@media (max-width: 900px) {
    .guide-carousel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@@media (max-width: 560px) {
    .guide-carousel { grid-template-columns: 1fr; }
}

/* ── Compare ────────────────────────────────────────── */
.compare-pill { font-family: var(--font-ui); display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; background: white; border: 1px solid var(--cream-dark); border-radius: 9999px; font-size: .82rem; font-weight: 600; color: var(--navy); text-decoration: none; transition: border-color .2s, box-shadow .2s; }
.compare-pill:hover { border-color: var(--gold-border); box-shadow: 0 4px 14px rgba(27,42,74,.08); }
.compare-btn { font-family: var(--font-ui); display: inline-flex; align-items: center; gap: .5rem; padding: .6rem 1.3rem; background: var(--navy); color: var(--cream); border-radius: .5rem; font-weight: 700; font-size: .84rem; text-decoration: none; border: none; cursor: pointer; transition: background .2s; white-space: nowrap; }
.compare-btn:hover { background: var(--navy-light); }

/* ── Mobile overrides ───────────────────────────────── */
@@media (max-width: 640px) {
    .state-mini-facts, .meaning-groups, .timeline-grid { grid-template-columns: 1fr; }
    .state-table-wrap { border: none; background: transparent; overflow: visible; }
    .state-symbol-table, .state-symbol-table thead, .state-symbol-table tbody, .state-symbol-table tr, .state-symbol-table td { display: block; width: 100%; }
    .state-symbol-table thead { display: none; }
    .state-symbol-table tr { position: relative; background: white; border: 1px solid var(--cream-dark); border-radius: .5rem; margin-bottom: .65rem; padding: .75rem 2.75rem .75rem 4.25rem; min-height: 4rem; }
    .state-symbol-table td { border: 0; padding: 0; }
    .state-symbol-table td:first-child { position: absolute; left: .65rem; top: .65rem; width: 2.75rem; }
    .state-symbol-table td:nth-child(2) { color: var(--gold); font-size: .58rem; font-weight: 800; letter-spacing: .1em; line-height: 1.25; text-transform: uppercase; margin-bottom: .15rem; }
    .state-symbol-table td:nth-child(3) { color: var(--navy); font-size: .9rem; line-height: 1.3; }
    .state-symbol-table td:nth-child(4) { color: var(--slate-ed); font-size: .76rem; margin-top: .2rem; }
    .state-symbol-table td:nth-child(4)::before { content: "Adopted: "; font-weight: 700; color: var(--navy); }
    .state-symbol-table td:nth-child(5) { position: absolute; right: .65rem; top: 50%; transform: translateY(-50%); }
}
</style>
}

<!-- Breadcrumb -->
<nav class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center flex-wrap gap-1 text-sm" style="color:var(--slate-ed)">
            <li><a href="/" style="color:var(--slate-ed);text-decoration:none" class="hover:text-slate-800">Home</a></li>
            <li style="display:flex;align-items:center;gap:.35rem"><i class="fa-solid fa-chevron-right" style="font-size:.6rem;opacity:.5"></i><a href="/states" style="color:var(--slate-ed);text-decoration:none" class="hover:text-slate-800">States</a></li>
            <li style="display:flex;align-items:center;gap:.35rem"><i class="fa-solid fa-chevron-right" style="font-size:.6rem;opacity:.5"></i><span style="font-weight:700;color:var(--navy)">@Model.State.Name</span></li>
        </ol>
    </div>
</nav>

<div id="top"></div>

<!-- Hero -->
<section class="editorial-hero state-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="position:relative;z-index:1">
        <div class="grid md:grid-cols-3 gap-8 items-center">

            <div class="md:col-span-2 order-2 md:order-1">
                <h1 class="hero-title" style="font-size:clamp(2rem,5vw,3.25rem);margin:.5rem 0 .75rem">
                    @symbolsHeading
                </h1>
                <p class="hero-subtitle mb-6">@GetHeroSubtitle(Model)</p>

                <div class="facts-bar" style="max-width:500px">
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value">
                            @if (isFederalDistrict)
                            {
                                @Model.State.Abbreviation
                            }
                            else
                            {
                                <a href="/states/@Model.State.Slug/abbreviation" style="color:inherit;text-decoration:none;border-bottom:1px dashed rgba(27,42,74,.25)">@Model.State.Abbreviation</a>
                            }
                        </div>
                        <div class="facts-bar__label">Abbreviation Guide</div>
                    </div>
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value" style="font-size:.95rem">@Model.State.Capital</div>
                        <div class="facts-bar__label">@(isFederalDistrict ? "Federal Capital" : "Capital")</div>
                    </div>
                    @if (Model.State.StateHoodDate.HasValue)
                    {
                        <div class="facts-bar__cell">
                            <div class="facts-bar__value">@Model.State.StateHoodDate.Value.Year</div>
                            <div class="facts-bar__label">Statehood</div>
                        </div>
                    }
                    <div class="facts-bar__cell">
                        <div class="facts-bar__value">@Model.Symbols.Count</div>
                        <div class="facts-bar__label">Symbols</div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-1 order-1 md:order-2 flex justify-center">
                @if (!string.IsNullOrEmpty(Model.State.FlagImageUrl))
                {
                    <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:1.25rem;padding:.875rem;box-shadow:0 24px 60px rgba(0,0,0,.3)">
                        <img src="@Images.Hero(Model.State.FlagImageUrl)"
                             alt="@Model.State.Name flag"
                             class="rounded-xl shadow-lg"
                             style="width:100%;max-width:280px;display:block;object-fit:fill">
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<!-- Main -->
<div class="state-main">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="state-layout-grid">

            <!-- ── Content ─────────────────────────────── -->
            <div style="min-width:0">

                <!-- Overview -->
                <div class="state-overview">
                    <div style="display:flex;align-items:flex-start;gap:1rem">
                        <div class="state-overview-icon">
                            <i class="fa-solid fa-map" style="font-size:.875rem"></i>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div class="state-label">Overview</div>
                            <p class="state-body">@GetSnippetAnswer(Model)</p>
                            <div class="state-mini-facts">
                                @foreach (var fact in GetMiniFacts(Model))
                                {
                                    <div class="state-mini-fact">
                                        <span>@fact.Label</span>
                                        @if (!string.IsNullOrWhiteSpace(fact.Url))
                                        {
                                            <a href="@fact.Url"
                                               target="@(fact.Url.IsExternalUrl() ? "_blank" : null)"
                                               rel="@(fact.Url.IsExternalUrl() ? "nofollow noopener noreferrer" : null)"
                                               style="text-decoration:none"><strong>@fact.Value</strong></a>
                                        }
                                        else
                                        {
                                            <strong>@fact.Value</strong>
                                        }
                                    </div>
                                }
                            </div>
                            <a href="/states/@Model.State.Slug/living"
                               style="display:inline-flex;align-items:center;gap:.5rem;margin-top:1rem;padding:.62rem .85rem;border:1px solid var(--cream-dark);border-radius:.55rem;background:white;color:var(--navy);font-size:.78rem;font-weight:800;text-decoration:none">
                                <i class="fa-solid fa-chart-simple" style="color:var(--gold)"></i>
                                Cost, quality of life & moving guide
                                <i class="fa-solid fa-arrow-right" style="font-size:.6rem;opacity:.55"></i>
                            </a>
                            @if (!string.Equals(Model.State.Abbreviation, "DC", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="/states/@Model.State.Slug/counties"
                                   style="display:inline-flex;align-items:center;gap:.5rem;margin-top:.55rem;margin-left:.35rem;padding:.62rem .85rem;border:1px solid var(--cream-dark);border-radius:.55rem;background:white;color:var(--navy);font-size:.78rem;font-weight:800;text-decoration:none">
                                    <i class="fa-solid fa-map-location-dot" style="color:var(--gold)"></i>
                                    Counties &amp; population
                                    <i class="fa-solid fa-arrow-right" style="font-size:.6rem;opacity:.55"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Mobile: Quick Facts -->
                <div class="state-section" style="display:block" id="mobile-qf">
                    <style>@@media (min-width:1024px){#mobile-qf{display:none!important}}</style>
                    <div class="sidebar-widget">
                        <div class="widget-title"><i class="fa-solid fa-chart-bar"></i>Quick Facts</div>
                        <dl>
                            <div class="fact-row"><dt class="fact-label">Official Name</dt><dd class="fact-value">@Model.State.Name</dd></div>
                            <div class="fact-row"><dt class="fact-label">Abbreviation</dt><dd class="fact-value">@if (isFederalDistrict) { @Model.State.Abbreviation } else { <a href="/states/@Model.State.Slug/abbreviation" style="color:inherit;text-decoration:none">@Model.State.Abbreviation</a> }</dd></div>
                            <div class="fact-row"><dt class="fact-label">@(isFederalDistrict ? "Federal Capital" : "Capital City")</dt><dd class="fact-value">@Model.State.Capital</dd></div>
                            @if (Model.State.Population.HasValue) { <div class="fact-row"><dt class="fact-label">Population</dt><dd class="fact-value">@Model.State.Population.Value.ToString("N0")</dd></div> }
                            @if (Model.State.StateHoodDate.HasValue) { <div class="fact-row"><dt class="fact-label">Statehood</dt><dd class="fact-value">@Model.State.StateHoodDate.Value.ToString("MMMM d, yyyy")</dd></div> }
                            <div class="fact-row"><dt class="fact-label">Region</dt><dd class="fact-value">@(Model.State.Region ?? "N/A")</dd></div>
                            <div class="fact-row"><dt class="fact-label">Symbols</dt><dd class="fact-value">@Model.Symbols.Count</dd></div>
                        </dl>
                    </div>
                </div>

                <!-- Symbol table -->
                @if (Model.Symbols.Any())
                {
                    <div class="state-section">
                        <h2 class="content-h2 mb-5">@symbolsHeading — Complete List</h2>
                        <div class="state-table-wrap">
                            <table class="state-symbol-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Category</th>
                                        <th>Official Symbol</th>
                                        <th>Adopted</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var symbol in Model.Symbols.OrderBy(s => GetSymbolSortRank(s)).ThenBy(s => GetSymbolTypeName(s)).ThenBy(s => s.Name))
                                    {
                                        var symbolUrl = symbol.ToSymbolUrl(Model.State.Slug);
                                        var symbolThumb = ResolveStateSymbolThumb(symbol, Model.State.Slug);
                                        var fallbackThumb = string.Equals(symbol.Type, "state-seal", StringComparison.OrdinalIgnoreCase)
                                            ? $"/images/seals/{Model.State.Slug}/seal.webp"
                                            : string.Equals(symbol.Type, "coat-of-arms", StringComparison.OrdinalIgnoreCase)
                                                ? $"/images/coats-of-arms/{Model.State.Slug}/coat-of-arms.webp"
                                            : $"/images/regions/{regionKey}.webp";
                                        <tr tabindex="0"
                                            onclick="window.location.href='@symbolUrl'"
                                            onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location.href='@symbolUrl';}">
                                            <td>
                                                <div class="table-symbol-thumb">
                                                    @if (!string.IsNullOrEmpty(symbolThumb))
                                                    {
                                                        <img src="@Images.Thumb(symbolThumb)" alt="@symbol.Name"
                                                             class="@((string.Equals(symbol.Type, "state-seal", StringComparison.OrdinalIgnoreCase) || string.Equals(symbol.Type, "coat-of-arms", StringComparison.OrdinalIgnoreCase)) ? "is-seal-thumb" : "")"
                                                             onerror="this.onerror=null;this.src='@fallbackThumb'" loading="lazy">
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid @GetSymbolFaIcon(symbol.Type)"></i>
                                                    }
                                                </div>
                                            </td>
                                            <td><strong>@GetSymbolTypeName(symbol)</strong></td>
                                            <td>
                                                <strong>@symbol.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(symbol.ScientificName))
                                                {
                                                    <span style="display:block;font-style:italic;font-size:.77rem;margin-top:.1rem;color:var(--slate-ed)">@symbol.ScientificName</span>
                                                }
                                            </td>
                                            <td>@(symbol.AdoptedYear.HasValue ? symbol.AdoptedYear.Value.ToString() : "—")</td>
                                            <td>
                                                <a href="@symbolUrl" class="table-page-link" aria-label="Open @symbol.Name page" onclick="event.stopPropagation()">
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Map of [State] -->
                    @if (!string.IsNullOrWhiteSpace(Model.State.Abbreviation))
                    {
                        @await Component.InvokeAsync("StateHubMap", new {
                            abbreviation = Model.State.Abbreviation,
                            stateName    = Model.State.Name,
                            capital      = Model.State.Capital,
                            region       = Model.State.Region,
                            slug         = Model.State.Slug
                        })
                    }

                    <!-- Name meaning -->
                    @if (Model.HubContent?.NameMeaning?.Paragraphs.Any() == true)
                    {
                        <div class="state-section">
                            <h2 class="content-h2 mb-4" style="font-size:1.45rem">
                                @(string.IsNullOrWhiteSpace(Model.HubContent.NameMeaning.Heading) ? $"What Does {Model.State.Name} Mean?" : Model.HubContent.NameMeaning.Heading)
                            </h2>
                            @foreach (var paragraph in Model.HubContent.NameMeaning.Paragraphs)
                            {
                                <p class="state-body">@Html.Raw(paragraph.RenderAutoLinks())</p>
                            }
                            @if (Model.HubContent.NameMeaning.InfoGroups.Any())
                            {
                                <div class="meaning-groups">
                                    @foreach (var group in Model.HubContent.NameMeaning.InfoGroups)
                                    {
                                        <div class="meaning-group">
                                            <h3>@group.Heading</h3>
                                            <dl>
                                                @foreach (var item in group.Items)
                                                {
                                                    <div class="meaning-item">
                                                        <dt>@item.Label</dt>
                                                        <dd>@Html.Raw(item.Text.RenderAutoLinks())</dd>
                                                    </div>
                                                }
                                            </dl>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Oldest / Newest -->
                    <div class="state-section">
                        <h2 class="content-h2 mb-4" style="font-size:1.45rem">Newest and Oldest Symbols</h2>
                        <div class="timeline-grid">
                            <div class="timeline-card">
                                <span>Oldest listed</span>
                                <strong>@(oldestSymbol != null ? $"{oldestSymbol.Name}, {oldestSymbol.AdoptedYear}" : "No adoption year listed")</strong>
                                <p>Older symbols tend to anchor the state's public identity: flag, bird, flower, motto, or nickname.</p>
                            </div>
                            <div class="timeline-card">
                                <span>Newest listed</span>
                                <strong>@(newestSymbols.Any() ? string.Join(", ", newestSymbols.Select(s => $"{s.Name} ({s.AdoptedYear})")) : "No recent year listed")</strong>
                                <p>Recent designations often show how states keep adding wildlife, foods, breeds, and cultural traditions.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Editorial -->
                    <div class="state-section">
                        <h2 class="content-h2 mb-4" style="font-size:1.45rem">@GetEditorialHeading(Model)</h2>
                        @foreach (var paragraph in GetEditorialParagraphs(Model))
                        {
                            <p class="state-body">@Html.Raw(paragraph.RenderAutoLinks())</p>
                        }
                    </div>

                    <!-- FAQ -->
                    <div class="state-section">
                        @await Html.PartialAsync("_Faq", Model, faqViewData)
                    </div>

                    <!-- Sources -->
                    @if (Model.HubContent?.Sources.Any() == true)
