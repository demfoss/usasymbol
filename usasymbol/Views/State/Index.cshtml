                        </div>
                    }

                </div>
            </aside>

        </div>
    </div>
</div>

<!-- Compare CTA -->
@if (Model.CompareStates.Any())
{
    <section style="background:white;border-top:1px solid var(--cream-dark);padding:2.5rem 0">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:1.25rem">
                <div style="flex-shrink:0;width:2.5rem;height:2.5rem;background:var(--navy);border-radius:.5rem;display:flex;align-items:center;justify-content:center">
                    <i class="fa-solid fa-scale-balanced" style="color:var(--cream);font-size:.9rem"></i>
                </div>
                <div>
                    <h2 style="font-family:'Libre Baskerville',Georgia,serif;font-size:1.15rem;font-weight:700;color:var(--navy);margin-bottom:.2rem">Compare @Model.State.Name with Another State</h2>
                    <p style="font-size:.84rem;color:var(--slate-ed)">See how @Model.State.Name ranks by population, area, cost of living, taxes, and more.</p>
                </div>
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.25rem">
                @foreach (var rs in Model.CompareStates)
                {
                    var pairSlug = string.Compare(Model.State.Slug, rs.Slug, StringComparison.Ordinal) < 0
                        ? $"{Model.State.Slug}-vs-{rs.Slug}" : $"{rs.Slug}-vs-{Model.State.Slug}";
                    <a href="/compare/@pairSlug" class="compare-pill">
                        @if (!string.IsNullOrWhiteSpace(rs.FlagImageUrl))
                        {
                            <img src="@Images.Thumb(rs.FlagImageUrl)" alt="@rs.Name" style="width:1.6rem;height:1.05rem;object-fit:cover;border-radius:2px;flex-shrink:0" onerror="this.style.display='none'" />
                        }
                        <span>vs @rs.Name</span>
                        <i class="fa-solid fa-arrow-right" style="font-size:.58rem;opacity:.5"></i>
                    </a>
                }
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
                <span style="font-size:.82rem;color:var(--slate-ed);font-weight:600;white-space:nowrap">Or compare with any state:</span>
                <div style="display:flex;gap:.75rem;flex:1;min-width:0">
                    <select id="compare-state-select" style="flex:1;max-width:12rem;border:1px solid var(--cream-dark);background:white;border-radius:.5rem;padding:.55rem .875rem;font-size:.84rem;color:var(--navy)">
                        <option value="">Choose a state&hellip;</option>
                        @foreach (var rs in Model.CompareStates)
                        {
                            <option value="@rs.Slug">@rs.Name</option>
                        }
                    </select>
                    <a id="compare-go-btn" href="/compare-states" class="compare-btn">
                        <i class="fa-solid fa-scale-balanced"></i> Compare
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<script>
    (function () {
        var slug = '@Model.State.Slug';
        var sel = document.getElementById('compare-state-select');
        var btn = document.getElementById('compare-go-btn');
        if (sel && btn) {
            sel.addEventListener('change', function () {
                if (!sel.value) { btn.href = '/compare-states'; return; }
                btn.href = '/compare/' + [slug, sel.value].sort().join('-vs-');
            });
        }
    })();
</script>

@await Html.PartialAsync("_StructuredData", Model)

@functions {
    string GetHeroSubtitle(StateViewModel model)
    {
        if (!string.IsNullOrWhiteSpace(model.HubContent?.SeoDescription))
            return model.HubContent.SeoDescription;

        return $"{model.State.Name} state symbols list: official state symbols including the flag, bird, flower, tree, motto, nickname, animals, and other state emblems and symbols.";
    }

    string JoinReadable(List<string> items)
    {
        if (items.Count == 0) return string.Empty;
        if (items.Count == 1) return items[0];
        if (items.Count == 2) return $"{items[0]} and {items[1]}";
        return $"{string.Join(", ", items.Take(items.Count - 1))}, and {items.Last()}";
    }

    string GetSnippetAnswer(StateViewModel model)
    {
        if (!string.IsNullOrWhiteSpace(model.HubContent?.SnippetAnswer))
            return model.HubContent.SnippetAnswer;

        return $"Explore the official emblems and state symbols that represent {model.State.Name}, including the flag, bird, flower, tree, motto, nickname, animals, and other symbols listed in this guide.";
    }

    IEnumerable<StateHubFact> GetMiniFacts(StateViewModel model)
    {
        if (model.HubContent?.MiniFacts.Any() == true)
        {
            foreach (var fact in model.HubContent.MiniFacts) yield return fact;
            yield break;
        }
        var bestKnown = GetBestKnownSymbol(model.Symbols);
        var oldestSym = model.Symbols.Where(s => s.AdoptedYear.HasValue).OrderBy(s => s.AdoptedYear).FirstOrDefault();
        var regionalSymbol = model.Symbols.FirstOrDefault(s =>
            s.Name.Contains("manatee", StringComparison.OrdinalIgnoreCase) ||
            s.Designation?.Contains("marine", StringComparison.OrdinalIgnoreCase) == true);
        yield return new StateHubFact { Label = "Best-known symbol", Value = bestKnown != null ? bestKnown.Name : $"{model.State.Name} flag", Url = bestKnown?.ToSymbolUrl(model.State.Slug) };
        yield return new StateHubFact { Label = "Oldest in this guide", Value = oldestSym != null ? $"{oldestSym.Name} ({oldestSym.AdoptedYear})" : "Adoption dates vary", Url = oldestSym?.ToSymbolUrl(model.State.Slug) };
        yield return new StateHubFact { Label = "Regional clue", Value = regionalSymbol != null ? regionalSymbol.Name : $"{model.State.Region ?? "U.S."} heritage", Url = regionalSymbol?.ToSymbolUrl(model.State.Slug) };
    }

    IEnumerable<USASymbol.Models.Symbol> GetRecognizedSymbols(StateViewModel model)
    {
        var yieldedIds = new HashSet<int>();
        if (model.HubContent?.MostRecognized.Any() == true)
        {
            foreach (var key in model.HubContent.MostRecognized)
            {
                var symbol = FindSymbolByKey(model.Symbols, key);
                if (symbol != null && yieldedIds.Add(symbol.Id)) yield return symbol;
            }
        }
        foreach (var type in new[] { "flag", "bird", "flower", "tree", "motto", "nickname", "mammal", "beverage", "color", "dinosaur" })
        {
            foreach (var match in model.Symbols.Where(s => s.Type.Equals(type, StringComparison.OrdinalIgnoreCase)).OrderBy(s => s.Name))
                if (yieldedIds.Add(match.Id)) yield return match;
        }
    }

    USASymbol.Models.Symbol? FindSymbolByKey(List<USASymbol.Models.Symbol> symbols, string key)
    {
        var normalized = (key ?? string.Empty).Trim().Trim('/').ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(normalized)) return null;
        var parts = normalized.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 1)
            return symbols.FirstOrDefault(s => s.Type.Equals(parts[0], StringComparison.OrdinalIgnoreCase) || s.Slug.Equals(parts[0], StringComparison.OrdinalIgnoreCase));
        return symbols.FirstOrDefault(s => s.Type.Equals(parts[0], StringComparison.OrdinalIgnoreCase) && s.Slug.Equals(parts[1], StringComparison.OrdinalIgnoreCase));
    }

    USASymbol.Models.Symbol? GetBestKnownSymbol(List<USASymbol.Models.Symbol> symbols)
    {
        return symbols.FirstOrDefault(s => s.Type.Equals("bird", StringComparison.OrdinalIgnoreCase))
            ?? symbols.FirstOrDefault(s => s.Type.Equals("flag", StringComparison.OrdinalIgnoreCase))
            ?? symbols.FirstOrDefault();
    }

    int GetSymbolSortRank(USASymbol.Models.Symbol symbol)
    {
        return symbol.Type switch
        {
            "flag" => 1, "bird" => 2, "flower" => 3, "tree" => 4, "motto" => 5,
            "nickname" => 6, "state-seal" => 7, "coat-of-arms" => 8, "mammal" => 9, "beverage" => 10, "color" => 11, "dinosaur" => 12,
            "fossil" => 13,
            _ => 50
        };
    }

    string GetEditorialHeading(StateViewModel model)
    {
        if (!string.IsNullOrWhiteSpace(model.HubContent?.Editorial?.Heading)) return model.HubContent.Editorial.Heading;
        return $"What {model.State.Name}'s Symbols Say About the State";
    }

    IEnumerable<string> GetEditorialParagraphs(StateViewModel model)
    {
        if (model.HubContent?.Editorial?.Paragraphs.Any() == true)
        {
            foreach (var p in model.HubContent.Editorial.Paragraphs) yield return p;
            yield break;
        }
        var bird = model.Symbols.FirstOrDefault(s => s.Type == "bird");
        var flower = model.Symbols.FirstOrDefault(s => s.Type == "flower");
        var flag = model.Symbols.FirstOrDefault(s => s.Type == "flag");
        var animal = model.Symbols.FirstOrDefault(s => s.Type == "mammal");
        var firstLine = new List<string>();
        if (flag != null) firstLine.Add($"the flag centers the public image of {model.State.Name}");
        if (bird != null) firstLine.Add($"the {bird.Name} gives the state a recognizable wildlife symbol");
        if (flower != null) firstLine.Add($"the {flower.Name} connects the list to local plant and garden culture");
        if (firstLine.Any())
            yield return char.ToUpper(firstLine[0][0]) + firstLine[0].Substring(1) + (firstLine.Count > 1 ? ", while " + string.Join(" and ", firstLine.Skip(1)) : ".") + ".";
        if (animal != null)
            yield return $"Animal and nature symbols such as the {animal.Name} help show how {model.State.Name}'s official list moves beyond civics into landscape, habitat, and everyday regional identity.";
        else
            yield return $"Taken together, these symbols make the {model.State.Name} hub more than a list: they show which places, species, colors, mottoes, and traditions the state has chosen to make official.";
    }

    IEnumerable<(string Question, string Answer)> GetStateFaq(StateViewModel model)
    {
        if (model.HubContent?.Faq.Any() == true)
        {
            foreach (var faq in model.HubContent.Faq) yield return (faq.Question, faq.Answer);
            yield break;
        }
        var bird = model.Symbols.FirstOrDefault(s => s.Type.Equals("bird", StringComparison.OrdinalIgnoreCase));
        var flower = model.Symbols.FirstOrDefault(s => s.Type.Equals("flower", StringComparison.OrdinalIgnoreCase));
        var flag = model.Symbols.FirstOrDefault(s => s.Type.Equals("flag", StringComparison.OrdinalIgnoreCase));
        var colors = model.Symbols.FirstOrDefault(s => s.Type.Equals("color", StringComparison.OrdinalIgnoreCase));
        var known = GetBestKnownSymbol(model.Symbols);
        yield return ($"What is {model.State.Name}'s most famous state symbol?",
            known != null ? $"{model.State.Name}'s most recognizable state symbol is often the {known.Name}, listed here as {GetSymbolTypeName(known).ToLowerInvariant()}."
                : $"{model.State.Name}'s flag is usually one of its most recognizable official symbols.");
        if (bird != null)
            yield return ($"What is {model.State.Name}'s state bird?",
                $"{model.State.Name}'s state bird is the <a href=\"{bird.ToSymbolUrl(model.State.Slug)}\">{bird.Name}</a>{(bird.AdoptedYear.HasValue ? $", adopted in {bird.AdoptedYear}" : "")}.");
        if (flower != null)
            yield return ($"What is {model.State.Name}'s state flower?",
                $"{model.State.Name}'s state flower is the <a href=\"{flower.ToSymbolUrl(model.State.Slug)}\">{flower.Name}</a>{(flower.AdoptedYear.HasValue ? $", adopted in {flower.AdoptedYear}" : "")}.");
        if (colors != null)
            yield return ($"Does {model.State.Name} have official state colors?",
                $"Yes. This guide includes a <a href=\"{colors.ToSymbolUrl(model.State.Slug)}\">{model.State.Name} state colors</a> page.");
        else if (flag != null)
            yield return ($"Does {model.State.Name} have official state colors?",
                $"This guide does not list a separate state-colors symbol for {model.State.Name}; color questions usually connect back to the <a href=\"{flag.ToSymbolUrl(model.State.Slug)}\">state flag</a>.");
        yield return ($"How many official state symbols does {model.State.Name} have?",
            $"This hub currently lists {model.Symbols.Count} {model.State.Name} state symbol{(model.Symbols.Count == 1 ? "" : "s")}, with individual pages for the major symbols above.");
    }

    string GetSymbolTypeName(USASymbol.Models.Symbol symbol)
    {
        if (!string.IsNullOrWhiteSpace(symbol.Designation))
            return System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(symbol.Designation.Trim().ToLowerInvariant());
        return symbol.Type switch
        {
            "bird" => "State Bird", "flower" => "State Flower", "tree" => "State Tree",
            "motto" => "State Motto", "mammal" => "State Mammal", "beverage" => "State Beverage",
            "dinosaur" => "State Dinosaur", "flag" => "State Flag", "state-seal" => "State Seal",
            "coat-of-arms" => "Coat of Arms",
            _ => $"State {char.ToUpper(symbol.Type[0]) + symbol.Type.Substring(1)}"
        };
    }

    string GetSymbolFaIcon(string type)
    {
        return type switch
        {
            "bird" => "fa-dove", "flower" => "fa-seedling", "tree" => "fa-tree",
            "motto" => "fa-scroll", "mammal" => "fa-paw", "beverage" => "fa-mug-hot",
            "dinosaur" => "fa-dragon", "flag" => "fa-flag", "color" => "fa-palette",
            "state-seal" => "fa-stamp", "coat-of-arms" => "fa-shield-halved",
            "fossil" => "fa-bone",
            "fish" => "fa-fish", "insect" => "fa-bug", "mineral" => "fa-gem",
            "rock" => "fa-mountain", "song" => "fa-music", "sport" => "fa-trophy",
            _ => "fa-star"
        };
    }

    string ResolveStateSymbolThumb(USASymbol.Models.Symbol symbol, string stateSlug)
    {
        if (!string.IsNullOrWhiteSpace(symbol.ImageUrl))
        {
            return symbol.ImageUrl;
        }

        if (string.Equals(symbol.Type, "state-seal", StringComparison.OrdinalIgnoreCase))
        {
            return $"/images/seals/{stateSlug}/seal.webp";
        }

        if (string.Equals(symbol.Type, "coat-of-arms", StringComparison.OrdinalIgnoreCase))
        {
            return $"/images/coats-of-arms/{stateSlug}/coat-of-arms.webp";
        }

        return string.Empty;
    }
}
