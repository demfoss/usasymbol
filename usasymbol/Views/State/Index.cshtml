                            <div style="margin-top:1.5rem;border-top:1px solid rgb(226 232 240 / .7);padding-top:1rem;display:flex;flex-wrap:wrap;gap:.5rem;justify-content:space-between;font-size:.75rem;color:#94a3b8">
