@model USASymbol.Models.ViewModels.StateMapPageViewModel

@{
    ViewData["Title"]       ??= $"Map of {Model.State.Name} | Counties & Location";
    ViewData["Description"] ??= $"Interactive map of {Model.State.Name} — explore counties, location in the United States, and state capital {Model.State.Capital}.";
    var stateSlug = Model.State.Slug;
}

@section Styles {
<style>
.map-page-wrap  { background: var(--cream, #faf7f2); min-height: 100vh; padding: 2rem 0 4rem; }
.map-page-inner { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
.map-breadcrumb { font: 500 .8rem/1 system-ui, sans-serif; color: #64748b; margin-bottom: 1.25rem; display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
.map-breadcrumb a { color: #64748b; text-decoration: none; }
.map-breadcrumb a:hover { color: #0f172a; text-decoration: underline; }
.map-page-title { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 700; color: #0f172a; line-height: 1.15; margin: 0 0 .35rem; }
.map-page-sub   { font-size: .95rem; color: #64748b; margin: 0 0 1.5rem; }
#state-map-full {
    position: relative;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: .5rem;
    overflow: hidden;
    aspect-ratio: 960 / 580;
}доб
#state-map-full svg { display: block; width: 100%; height: 100%; }
.map-back-btn {
    position: absolute; top: 10px; left: 10px; z-index: 10;
    padding: 6px 13px;
    background: rgba(255,255,255,.94);
    border: 1px solid #cbd5e1; border-radius: 6px;
    font: 600 12px/1 system-ui, sans-serif; color: #1e3a8a;
    cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.10);
    display: none;
    transition: background .15s;
}
.map-back-btn:hover { background: #fff; }
.map-hint {
    position: absolute; bottom: 8px; right: 10px;
    font: 500 11px system-ui, sans-serif; color: #94a3b8;
    pointer-events: none; transition: opacity .3s;
}
/* Tooltip */
#map-tt {
    position: absolute; z-index: 20; pointer-events: none;
    display: none;
    min-width: 180px; max-width: 260px;
    background: rgba(15,23,42,.95); border-radius: 10px;
    border: 1px solid rgba(255,255,255,.08);
    padding: 11px 14px;
    box-shadow: 0 4px 20px rgba(0,0,0,.3);
    font-family: Manrope, system-ui, sans-serif;
}
#map-tt-name     { font-size: 12px; font-weight: 800; color: #f8fafc; margin: 0 0 5px; }
#map-tt-rows     { display: grid; gap: 3px; }
.tt-row-lbl      { font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: #64748b; margin: 0; }
.tt-row-val      { font-size: 11px; font-weight: 600; color: #cbd5e1; margin: 0 0 3px; }
.map-info-bar    { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .75rem; }
.map-info-chip   { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: .5rem .9rem; font: 500 .82rem/1.4 system-ui, sans-serif; color: #475569; }
.map-info-chip strong { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; font-weight: 700; margin-bottom: 2px; }
.county-section { margin-top: 2rem; }
.county-section-title { font-size: clamp(1.35rem, 3vw, 1.9rem); font-weight: 700; color: #0f172a; line-height: 1.2; margin: 0 0 .35rem; }
.county-section-copy { font-size: .95rem; color: #64748b; margin: 0; }
.county-summary { margin-top: 1rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.county-summary-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1rem 1.05rem; }
.county-summary-card strong { display: block; margin-bottom: .4rem; font-size: .73rem; line-height: 1.2; text-transform: uppercase; letter-spacing: .08em; color: #94a3b8; }
.county-summary-card span { display: block; color: #0f172a; font-size: 1rem; font-weight: 700; line-height: 1.35; }
.county-summary-card small { display: block; margin-top: .25rem; color: #64748b; font-size: .85rem; line-height: 1.4; }
.county-fixed-table-wrap { margin-top: 1rem; overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 18px; background: rgba(255,255,255,.95); }
.county-fixed-table { width: 100%; border-collapse: collapse; min-width: 720px; }
.county-fixed-table thead th { position: sticky; top: 0; background: #f8fafc; z-index: 1; text-align: left; padding: .9rem 1rem; font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #475569; border-bottom: 1px solid #e2e8f0; }
.county-fixed-table tbody td { padding: .95rem 1rem; border-bottom: 1px solid #eef2f7; font-size: .94rem; color: #334155; vertical-align: top; }
.county-fixed-table tbody tr:nth-child(even) { background: rgba(248,250,252,.7); }
.county-fixed-table tbody tr:last-child td { border-bottom: 0; }
.county-fixed-table .county-name { font-weight: 700; color: #0f172a; }
.county-fixed-table .county-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
}

<div class="map-page-wrap">
<div class="map-page-inner">

    <!-- Breadcrumb -->
    <nav class="map-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/states">States</a>
        <span aria-hidden="true">›</span>
        <a href="/states/@stateSlug">@Model.State.Name</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Map</span>
    </nav>

    <h1 class="map-page-title">Map of @Model.State.Name</h1>
    <p class="map-page-sub">
        Click @Model.State.Name to zoom in and explore counties.
        Click any other state to visit its page.
    </p>

    <!-- Map container -->
    <div id="state-map-full" role="img" aria-label="Interactive map of @Model.State.Name showing location in the United States and county boundaries.">
        <button class="map-back-btn" id="map-back-btn" aria-label="Zoom out to full US map">← Back to US</button>
        <div class="map-hint" id="map-hint">Click @Model.State.Name to explore counties</div>
        <div id="map-tt" role="tooltip" aria-live="polite">
            <p id="map-tt-name"></p>
            <div id="map-tt-rows"></div>
        </div>
    </div>

    <!-- Info chips -->
    <div class="map-info-bar">
        <div class="map-info-chip"><strong>Capital</strong>@Model.State.Capital</div>
        @if (Model.State.Population.HasValue)
        {
            <div class="map-info-chip"><strong>Population</strong>@Model.State.Population.Value.ToString("N0")</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.State.Region))
        {
            <div class="map-info-chip"><strong>Region</strong>@Model.State.Region</div>
        }
        @if (Model.State.StateHoodDate.HasValue)
        {
            <div class="map-info-chip"><strong>Statehood</strong>@Model.State.StateHoodDate.Value.ToString("MMMM d, yyyy")</div>
        }
        <div class="map-info-chip"><strong>Abbreviation</strong>@Model.State.Abbreviation</div>
    </div>

    @if (Model.CountySummary != null)
    {
        <section class="county-section" aria-labelledby="county-summary-title">
            <div>
                <h2 id="county-summary-title" class="county-section-title">How many counties are in @Model.State.Name?</h2>
                <p class="county-section-copy">
                    @Model.State.Name has @Model.CountySummary.CountyCount counties. The list below includes each county, its FIPS code, and population.
                </p>
            </div>

            <div class="county-summary">
                <article class="county-summary-card">
                    <strong>Total counties</strong>
                    <span>@Model.CountySummary.CountyCount</span>
                    <small>Current county count for @Model.State.Name.</small>
                </article>

                @if (Model.CountySummary.LargestByPopulation != null)
                {
                    <article class="county-summary-card">
                        <strong>Largest by population</strong>
                        <span>@Model.CountySummary.LargestByPopulation.DisplayName</span>
                        <small>@Model.CountySummary.LargestByPopulation.Population?.ToString("N0") residents</small>
                    </article>
                }

                @if (Model.CountySummary.SmallestByPopulation != null)
                {
                    <article class="county-summary-card">
                        <strong>Smallest by population</strong>
                        <span>@Model.CountySummary.SmallestByPopulation.DisplayName</span>
                        <small>@Model.CountySummary.SmallestByPopulation.Population?.ToString("N0") residents</small>
                    </article>
                }
            </div>
        </section>

        @if (Model.Counties.Any())
        {
            <section id="county-table" class="county-section" aria-labelledby="county-table-title">
                <div>
                    <h2 id="county-table-title" class="county-section-title">@Model.State.Name county table</h2>
                    <p class="county-section-copy">
                        County list for @Model.State.Name with county FIPS codes and population totals.
                    </p>
                </div>

                <div class="county-fixed-table-wrap">
                    <table class="county-fixed-table">
                        <thead>
                            <tr>
                                <th>County</th>
                                <th>State</th>
                                <th>County FIPS</th>
                                <th>Population</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var county in Model.Counties)
                            {
                                <tr>
                                    <td class="county-name">@county.DisplayName</td>
                                    <td>@county.StateCode</td>
                                    <td class="county-num">@county.FipsCode</td>
                                    <td class="county-num">@(county.Population?.ToString("N0") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }

    <!-- Back link -->
    <p style="margin-top:1.5rem;font-size:.875rem">
        <a href="/states/@stateSlug" style="color:#1e3a8a;text-decoration:none;font-weight:600">
            ← Back to @Model.State.Name state symbols
        </a>
    </p>

</div>
</div>

<!-- Schema.org -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "BreadcrumbList",
    "@@id": "https://usasymbol.com/states/@stateSlug/map#breadcrumb",
    "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Home",   "item": "https://usasymbol.com/" },
        { "@@type": "ListItem", "position": 2, "name": "States", "item": "https://usasymbol.com/states" },
        { "@@type": "ListItem", "position": 3, "name": "@Model.State.Name", "item": "https://usasymbol.com/states/@stateSlug" },
        { "@@type": "ListItem", "position": 4, "name": "Map of @Model.State.Name", "item": "https://usasymbol.com/states/@stateSlug/map" }
    ]
}
</script>
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "AdministrativeArea",
    "@@id": "https://usasymbol.com/states/@stateSlug#place",
    "name": "@Model.State.Name",
    "url": "https://usasymbol.com/states/@stateSlug",
    "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Description"]?.ToString() ?? "")),
    "hasMap": "https://usasymbol.com/states/@stateSlug/map",
    "containedInPlace": {
        "@@type": "Country",
        "name": "United States",
        "sameAs": "https://www.wikidata.org/wiki/Q30"
    }
}
</script>

<!-- Data -->
<script type="application/json" id="map-page-data">
{
    "fips":        @{
                       var abbr = Model.State.Abbreviation?.ToUpperInvariant() ?? "";
                       var fipsMap = new Dictionary<string,int>{
                           ["AL"]=1,["AK"]=2,["AZ"]=4,["AR"]=5,["CA"]=6,["CO"]=8,["CT"]=9,["DE"]=10,
                           ["FL"]=12,["GA"]=13,["HI"]=15,["ID"]=16,["IL"]=17,["IN"]=18,["IA"]=19,["KS"]=20,
                           ["KY"]=21,["LA"]=22,["ME"]=23,["MD"]=24,["MA"]=25,["MI"]=26,["MN"]=27,["MS"]=28,
                           ["MO"]=29,["MT"]=30,["NE"]=31,["NV"]=32,["NH"]=33,["NJ"]=34,["NM"]=35,["NY"]=36,
                           ["NC"]=37,["ND"]=38,["OH"]=39,["OK"]=40,["OR"]=41,["PA"]=42,["RI"]=44,["SC"]=45,
                           ["SD"]=46,["TN"]=47,["TX"]=48,["UT"]=49,["VT"]=50,["VA"]=51,["WA"]=53,["WV"]=54,
                           ["WI"]=55,["WY"]=56};
                       fipsMap.TryGetValue(abbr, out var currentFips);
                   }
                   @currentFips,
    "states":      @Html.Raw(Model.AllStatesJson),
    "slugs":       @Html.Raw(Model.StateSlugsJson),
    "abbrs":       @{
                       var fipsToAbbr = new Dictionary<int,string>{
                           [1]="AL",[2]="AK",[4]="AZ",[5]="AR",[6]="CA",[8]="CO",[9]="CT",[10]="DE",
                           [12]="FL",[13]="GA",[15]="HI",[16]="ID",[17]="IL",[18]="IN",[19]="IA",[20]="KS",
                           [21]="KY",[22]="LA",[23]="ME",[24]="MD",[25]="MA",[26]="MI",[27]="MN",[28]="MS",
                           [29]="MO",[30]="MT",[31]="NE",[32]="NV",[33]="NH",[34]="NJ",[35]="NM",[36]="NY",
                           [37]="NC",[38]="ND",[39]="OH",[40]="OK",[41]="OR",[42]="PA",[44]="RI",[45]="SC",
                           [46]="SD",[47]="TN",[48]="TX",[49]="UT",[50]="VT",[51]="VA",[53]="WA",[54]="WV",
                           [55]="WI",[56]="WY"};
                   }
                   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fipsToAbbr))
}
</script>

<script>
(function () {
    'use strict';

    var W = 960, H = 580;
    var CONTAINER = document.getElementById('state-map-full');
    var BACK_BTN  = document.getElementById('map-back-btn');
    var HINT      = document.getElementById('map-hint');
    var TT        = document.getElementById('map-tt');
    var TT_NAME   = document.getElementById('map-tt-name');
    var TT_ROWS   = document.getElementById('map-tt-rows');

    var raw  = document.getElementById('map-page-data');
    var cfg  = JSON.parse(raw.textContent);

    // Capital coordinates by FIPS
    var CAPITALS = {
        1:[32.361,-86.279],2:[58.301,-134.420],4:[33.448,-112.074],5:[34.736,-92.331],
        6:[38.556,-121.469],8:[39.714,-104.984],9:[41.763,-72.685],10:[39.158,-75.524],
        12:[30.455,-84.253],13:[33.755,-84.390],15:[21.305,-157.858],16:[43.614,-116.202],
        17:[39.798,-89.655],18:[39.768,-86.158],19:[41.591,-93.604],20:[39.056,-95.689],
        21:[38.197,-84.861],22:[30.458,-91.140],23:[44.325,-69.731],24:[38.978,-76.490],
        25:[42.358,-71.064],26:[42.732,-84.556],27:[44.950,-93.094],28:[32.322,-90.207],
        29:[38.572,-92.189],30:[46.596,-112.027],31:[40.809,-96.680],32:[39.160,-119.754],
        33:[43.206,-71.538],34:[40.221,-74.756],35:[35.667,-105.964],36:[42.659,-73.781],
        37:[35.771,-78.638],38:[46.813,-100.779],39:[39.962,-83.000],40:[35.482,-97.534],
        41:[44.923,-123.046],42:[40.269,-76.875],44:[41.823,-71.423],45:[34.000,-81.035],
        46:[44.367,-100.336],47:[36.165,-86.784],48:[30.267,-97.743],49:[40.778,-111.891],
        50:[44.260,-72.576],51:[37.543,-77.434],53:[47.042,-122.893],54:[38.348,-81.633],
        55:[43.073,-89.384],56:[41.145,-104.802]
    };

    function fmt(n) {
        if (n == null) return null;
        return Number(n).toLocaleString();
    }

    function countyLabel(name) {
        if (!name) return 'County';
        return /County|Parish|Borough|Census Area|Municipality|District|City and|Planning Region/i.test(name)
            ? name
            : name + ' County';
    }

    function render(d3, topojson, usData) {
        var features = topojson.feature(usData, usData.objects.states).features;

        var svg = d3.select(CONTAINER)
            .append('svg')
            .attr('viewBox', '0 0 ' + W + ' ' + H)
            .attr('width', '100%')
            .attr('preserveAspectRatio', 'xMidYMid meet')
            .attr('aria-hidden', 'true');

        var g         = svg.append('g');
        var gStates   = g.append('g').attr('class', 'g-states');
        var gLabels   = g.append('g').attr('class', 'g-labels').style('pointer-events', 'none');
        var gCounties = g.append('g').attr('class', 'g-counties');
        var gCapitals = g.append('g').attr('class', 'g-capitals');

        var proj = d3.geoAlbersUsa().scale(1280).translate([W / 2, H / 2]);
        var path = d3.geoPath().projection(proj);
        var LABEL_OVERRIDES = {
            6:  [-119.5, 37.1],   // CA
            12: [-82.4, 28.3],    // FL
            15: [-157.9, 20.8],   // HI
            22: [-92.3, 31.0],    // LA
            24: [-76.7, 39.0],    // MD
            25: [-71.8, 42.25],   // MA
            26: [-84.7, 44.6],    // MI
            28: [-89.7, 32.8],    // MS
            29: [-92.6, 38.4],    // MO
            33: [-71.6, 43.8],    // NH
            34: [-74.5, 40.1],    // NJ
            36: [-75.5, 42.9],    // NY
            41: [-120.6, 43.9],   // OR
            44: [-71.55, 41.7],   // RI
            45: [-80.9, 33.9],    // SC
            47: [-86.4, 35.8],    // TN
            51: [-78.7, 37.7],    // VA
            54: [-80.6, 38.7]     // WV
        };

        // ── Draw all states ──────────────────────────────────────────────────
        var statePaths = gStates.selectAll('path')
            .data(features)
            .join('path')
            .attr('d', path)
            .style('fill',         function (d) { return +d.id === cfg.fips ? '#1e3a8a' : '#e2e8f0'; })
            .style('stroke',       '#fff')
            .style('stroke-width', '0.8')
            .style('cursor',       function (d) {
                if (+d.id === cfg.fips) return 'zoom-in';
                return cfg.states[d.id] ? 'pointer' : 'default';
            });

        // ── State abbreviation labels ───────────────────────────────────────
        features.forEach(function (f) {
            var abbr = cfg.abbrs && cfg.abbrs[f.id];
            if (!abbr) return;

            var point = LABEL_OVERRIDES[+f.id]
                ? proj(LABEL_OVERRIDES[+f.id])
                : path.centroid(f);

            if (!point || isNaN(point[0]) || isNaN(point[1])) return;

            var isCurrent = +f.id === cfg.fips;
            gLabels.append('text')
                .attr('x', point[0])
                .attr('y', point[1])
                .attr('text-anchor', 'middle')
                .attr('dominant-baseline', 'central')
                .style('font', '800 9px system-ui, sans-serif')
                .style('fill', isCurrent ? 'rgba(255,255,255,.95)' : '#475569')
                .style('stroke', isCurrent ? 'rgba(30,58,138,.45)' : 'rgba(255,255,255,.92)')
                .style('stroke-width', '2.4px')
                .style('paint-order', 'stroke')
                .style('user-select', 'none')
                .text(abbr);
        });

        // ── Capital dot for current state ────────────────────────────────────
        var capCoords = CAPITALS[cfg.fips];
        var capPt     = capCoords ? proj([capCoords[1], capCoords[0]]) : null;

        if (capPt) {
            gCapitals.append('circle').attr('class', 'cap-ring')
                .attr('cx', capPt[0]).attr('cy', capPt[1]).attr('r', 5.5)
                .style('fill', '#fff').style('stroke', '#1e3a8a').style('stroke-width', '2.5')
                .style('pointer-events', 'none');
            gCapitals.append('circle').attr('class', 'cap-dot')
                .attr('cx', capPt[0]).attr('cy', capPt[1]).attr('r', 2.5)
                .style('fill', '#1e3a8a').style('pointer-events', 'none');
            gCapitals.append('text').attr('class', 'cap-label')
                .attr('x', capPt[0]).attr('y', capPt[1] - 10)
                .attr('text-anchor', 'middle')
                .style('font', '700 10px system-ui, sans-serif')
                .style('fill', '#1e3a8a')
                .style('stroke', '#f8fafc').style('stroke-width', '3px')
                .style('paint-order', 'stroke').style('pointer-events', 'none')
                .text(cfg.states[cfg.fips] ? cfg.states[cfg.fips].capital : '');
        }

        // ── Tooltip helpers ──────────────────────────────────────────────────
        function showStateTip(d, mx, my) {
            var info = cfg.states[d.id];
            if (!info) return;
            TT_NAME.textContent = info.name;
            TT_ROWS.innerHTML   = '';

            var rows = [
                ['Capital',    info.capital],
                ['Population', fmt(info.population)],
                ['Region',     info.region],
                ['Statehood',  info.statehood],
            ];
            rows.forEach(function (r) {
                if (!r[1]) return;
                TT_ROWS.insertAdjacentHTML('beforeend',
                    '<p class="tt-row-lbl">' + r[0] + '</p><p class="tt-row-val">' + r[1] + '</p>');
            });

            positionTip(mx, my);
            TT.style.display = 'block';
        }

        function showCountyTip(name, population, mx, my) {
            TT_NAME.textContent = name || 'County';
            TT_ROWS.innerHTML   = '';
            if (population != null) {
                TT_ROWS.insertAdjacentHTML('beforeend',
                    '<p class="tt-row-lbl">Population</p><p class="tt-row-val">' + fmt(population) + '</p>');
            }
            positionTip(mx, my);
            TT.style.display = 'block';
        }

        function hideTip() { TT.style.display = 'none'; }

        function positionTip(mx, my) {
            var rect = CONTAINER.getBoundingClientRect();
            var x = mx - rect.left;
            var y = my - rect.top;
            var tw = TT.offsetWidth || 200;
            var th = TT.offsetHeight || 80;
            var left = x + 14;
            var top  = y - th - 10;
            if (left + tw > rect.width - 4) left = x - tw - 14;
            if (top < 4) top = y + 14;
            TT.style.left = Math.max(4, left) + 'px';
            TT.style.top  = Math.max(4, top)  + 'px';
        }

        // ── Zoom ─────────────────────────────────────────────────────────────
        var isZoomed       = false;
        var countiesLoaded = false;
        var countyPaths;

        var zoom = d3.zoom()
            .scaleExtent([1, 14])
            .on('zoom', function (event) {
                var k = event.transform.k;
                g.attr('transform', event.transform);
                gStates.selectAll('path').style('stroke-width', 0.8 / k);
                if (countyPaths) countyPaths.style('stroke-width', 0.5 / k);
                gLabels.selectAll('text')
                    .style('font-size', Math.max(6.5, 9 / k) + 'px')
                    .style('stroke-width', (2.4 / k) + 'px');
                if (capPt) {
                    gCapitals.select('.cap-ring').attr('r', 5.5 / k);
                    gCapitals.select('.cap-dot').attr('r', 2.5 / k);
                    gCapitals.select('.cap-label')
                        .attr('y', capPt[1] - 10 / k)
                        .style('font-size', (10 / k) + 'px')
                        .style('stroke-width', (3 / k) + 'px');
                }
            });

        svg.call(zoom).on('dblclick.zoom', null);

        function zoomTo(feature) {
            var b  = path.bounds(feature);
            var dx = b[1][0] - b[0][0];
            var dy = b[1][1] - b[0][1];
            var cx = (b[0][0] + b[1][0]) / 2;
            var cy = (b[0][1] + b[1][1]) / 2;
            var k  = Math.max(1, Math.min(10, 0.85 / Math.max(dx / W, dy / H)));

            isZoomed = true;
            BACK_BTN.style.display = 'block';
            HINT.style.opacity     = '0';
            gLabels.style('opacity', '.22');
            hideTip();

            statePaths.style('cursor', function (d) {
                return +d.id === cfg.fips ? 'zoom-out' : 'default';
            });

            svg.transition().duration(750)
                .call(zoom.transform,
                    d3.zoomIdentity.translate(W / 2 - k * cx, H / 2 - k * cy).scale(k));

            if (+feature.id === cfg.fips) loadCounties(cfg.fips);
        }

        function zoomReset() {
            isZoomed = false;
            BACK_BTN.style.display = 'none';
            HINT.style.opacity     = '1';
            gLabels.style('opacity', '1');
            hideTip();
            statePaths.style('cursor', function (d) {
                if (+d.id === cfg.fips) return 'zoom-in';
                return cfg.states[d.id] ? 'pointer' : 'default';
            });
            svg.transition().duration(600)
                .call(zoom.transform, d3.zoomIdentity);
        }

        // ── County load (lazy) ───────────────────────────────────────────────
        var countyInfo = {};

        function loadCounties(stateFips) {
            if (countiesLoaded) return;
            countiesLoaded = true;

            Promise.all([
                d3.json('/maps/us-counties-topo.json'),
                d3.json('/maps/county-data.json')
            ]).then(function (results) {
                var topoData   = results[0];
                countyInfo     = results[1] || {};

                var counties = topojson.feature(topoData, topoData.objects.counties).features
                    .filter(function (d) { return Math.floor(+d.id / 1000) === stateFips; });

                countyPaths = gCounties.selectAll('path')
                    .data(counties)
                    .join('path')
                    .attr('d', path)
                    .style('fill',         'rgba(255,255,255,0)')
                    .style('stroke',       'rgba(255,255,255,.55)')
                    .style('stroke-width', '0.5')
                    .style('cursor',       'default')
                    .on('mouseenter', function (event, d) {
                        d3.select(this).style('fill', 'rgba(255,255,255,.18)');
                        var fipsKey = String(d.id).padStart(5, '0');
                        var info    = countyInfo[fipsKey];
                        var name    = info ? countyLabel(info.n) : 'County';
                        var pop     = info && info.p ? info.p : null;
                        showCountyTip(name, pop, event.clientX, event.clientY);
                    })
                    .on('mousemove', function (event) {
                        positionTip(event.clientX, event.clientY);
                    })
                    .on('mouseleave', function () {
                        d3.select(this).style('fill', 'rgba(255,255,255,0)');
                        hideTip();
                    });
            });
        }

        // ── Mouse events on states ───────────────────────────────────────────
        statePaths
            .on('mousemove', function (event, d) {
                if (isZoomed && +d.id !== cfg.fips) return;
                showStateTip(d, event.clientX, event.clientY);
            })
            .on('mouseleave', hideTip)
            .on('click', function (event, d) {
                event.stopPropagation();
                hideTip();
                if (isZoomed) { zoomReset(); return; }
                if (+d.id === cfg.fips) {
                    zoomTo(d);
                } else if (cfg.slugs[d.id]) {
                    window.location.href = '/states/' + cfg.slugs[d.id];
                }
            });

        BACK_BTN.addEventListener('click', zoomReset);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && isZoomed) zoomReset();
        });
    }

    // ── Script loader ─────────────────────────────────────────────────────────
    function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src; s.onload = cb;
        document.head.appendChild(s);
    }

    function init() {
        d3.json('/maps/us-states-topo.json').then(function (us) { render(d3, topojson, us); });
    }

    if (typeof d3 !== 'undefined' && typeof topojson !== 'undefined') {
        init();
    } else if (typeof d3 !== 'undefined') {
        loadScript('/js/topojson-client.min.js', init);
    } else {
        loadScript('/js/d3.min.js', function () {
            loadScript('/js/topojson-client.min.js', init);
        });
    }
})();
</script>
