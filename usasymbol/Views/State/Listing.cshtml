@model USASymbol.Models.ViewModels.StatesListingViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"] = "All 50 U.S. States and Their Official Symbols";
    ViewData["Description"] = "Discover all 50 U.S. states and their official symbols. Learn about state birds, flowers, trees, flags, mottos, and unique state facts in one complete directory.";
}

@section Styles {
<style>
    /* === STATES LISTING ======================================= */
    .states-listing-page .site-main { background: var(--cream); }

    /* Filter bar */
    .states-filter-bar {
        position: sticky;
        top: 73px;
        z-index: 40;
        background: rgba(248,244,237,.95);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--cream-dark);
        padding: .75rem 0;
    }
    .filter-pill {
        display: inline-flex;
        align-items: center;
        padding: .45rem 1rem;
        border-radius: 9999px;
        font-size: .8rem;
        font-weight: 600;
        white-space: nowrap;
        text-decoration: none;
        transition: background .2s, color .2s;
        border: 1px solid transparent;
    }
    .filter-pill--active {
        background: var(--navy);
        color: var(--cream);
    }
    .filter-pill--inactive {
        background: white;
        color: var(--slate-ed);
        border-color: var(--cream-dark);
    }
    .filter-pill--inactive:hover {
        background: var(--cream-dark);
        color: var(--navy);
    }

    /* State card */
    .state-listing-card {
        background: white;
        border: 1px solid var(--cream-dark);
        border-radius: 1rem;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        transition: box-shadow .25s, transform .25s, border-color .25s;
    }
    .state-listing-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 36px rgba(27,42,74,.1);
        border-color: var(--gold-border);
    }
    .slc-flag {
        aspect-ratio: 16/9;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(27,42,74,.06), rgba(27,42,74,.03));
        position: relative;
    }
    .slc-flag img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform .4s ease;
        display: block;
    }
    .state-listing-card:hover .slc-flag img { transform: scale(1.06); }
    .slc-region-badge {
        position: absolute;
        top: .5rem; right: .5rem;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(8px);
        padding: .2rem .6rem;
        border-radius: 9999px;
        font-size: .65rem;
        font-weight: 700;
        color: var(--navy);
        border: 1px solid var(--cream-dark);
    }
    .slc-body {
        padding: .875rem 1rem 1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .slc-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .35rem;
    }
    .slc-name {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: .95rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1.25;
    }
    .state-listing-card:hover .slc-name { color: #2C5F9E; }
    .slc-abbr {
        font-size: .7rem;
        font-weight: 700;
        color: var(--slate-ed);
        background: var(--cream);
        border: 1px solid var(--cream-dark);
        border-radius: .4rem;
        padding: .15rem .45rem;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .slc-meta {
        font-size: .75rem;
        color: var(--slate-ed);
        display: flex;
        flex-direction: column;
        gap: .25rem;
        flex: 1;
        margin-bottom: .75rem;
    }
    .slc-meta-row {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .slc-meta-row i { width: .875rem; text-align: center; opacity: .6; }
    .slc-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: .75rem;
        border-top: 1px solid var(--cream-dark);
        font-size: .8rem;
        font-weight: 700;
        color: #2C5F9E;
    }
</style>
}

<!-- ════════════════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════════════════ -->
<section class="editorial-hero" style="padding:clamp(3.5rem,7vw,5.5rem) 0 clamp(2.5rem,5vw,4rem)">
    <div class="max-w-5xl mx-auto px-4 text-center" style="position:relative;z-index:1">
        <div class="hero-pill inline-flex mb-5">
            <i class="fa-solid fa-flag-usa"></i>
            U.S. States Directory
        </div>
        <h1 class="hero-title" style="font-size:clamp(2.4rem,5vw,3.75rem);max-width:28rem;margin:.75rem auto 1rem">
            All 50 U.S. States
        </h1>
        <p class="hero-subtitle">
            Explore each state's official symbols, history, and heritage.
        </p>
        <div class="facts-bar" style="max-width:28rem;margin:2rem auto 0">
            <div class="facts-bar__cell">
                <div class="facts-bar__value">@Model.States.Count</div>
                <div class="facts-bar__label">States</div>
            </div>
            <div class="facts-bar__cell">
                <div class="facts-bar__value">@Model.Regions.Count()</div>
                <div class="facts-bar__label">Regions</div>
            </div>
            <div class="facts-bar__cell">
                <div class="facts-bar__value">50</div>
                <div class="facts-bar__label">Full Coverage</div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     FILTER BAR
     ════════════════════════════════════════════════════════ -->
<div class="states-filter-bar">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between gap-4 flex-wrap">
            <div class="flex gap-2 flex-wrap">
                <a href="/states"
                   class="filter-pill @(string.IsNullOrEmpty(Model.SelectedRegion) ? "filter-pill--active" : "filter-pill--inactive")">
                    All States
                </a>
                @foreach (var region in Model.Regions)
                {
                    <a href="/states?region=@region"
                       class="filter-pill @(Model.SelectedRegion == region ? "filter-pill--active" : "filter-pill--inactive")">
                        @region
                    </a>
                }
            </div>
            <span style="font-size:.8rem;color:var(--slate-ed);white-space:nowrap">
                <strong style="color:var(--navy)">@Model.States.Count</strong> state@(Model.States.Count == 1 ? "" : "s")
                @if (!string.IsNullOrEmpty(Model.SelectedRegion))
                {
                    <text> in <strong style="color:var(--navy)">@Model.SelectedRegion</strong></text>
                }
            </span>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     STATES GRID
     ════════════════════════════════════════════════════════ -->
<section style="padding:2.5rem 0 4rem;background:var(--cream)">
    <div class="max-w-7xl mx-auto px-4">
        @if (Model.States.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
                @foreach (var state in Model.States)
                {
                    var flagPath = $"/images/states/flags/medium/{state.Abbreviation.ToLower()}.webp";
                    var flagSrc = Images.Card(flagPath);
                    var flagSrcSet = string.Join(", ", new[]
                    {
                        $"{Images.Card(flagPath, 320)} 320w",
                        $"{Images.Card(flagPath, 480)} 480w",
                        $"{Images.Card(flagPath, 640)} 640w"
                    });
                    var flagSizes = "(max-width: 639px) 100vw, (max-width: 1023px) 50vw, (max-width: 1279px) 33vw, 20vw";
                    <a href="/states/@state.Slug" class="state-listing-card">
                        <div class="slc-flag">
                            <img src="@flagSrc"
                                 srcset="@flagSrcSet"
                                 sizes="@flagSizes"
                                 alt="@state.Name flag"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="w-full h-full items-center justify-center" style="display:none;background:linear-gradient(135deg,#1B2A4A,#2C5F9E)">
                                <span style="font-size:1.75rem;font-weight:800;color:white">@state.Abbreviation</span>
                            </div>
                            @if (!string.IsNullOrEmpty(state.Region))
                            {
                                <div class="slc-region-badge">@state.Region</div>
                            }
                        </div>
                        <div class="slc-body">
                            <div class="slc-header">
                                <div class="slc-name">@state.Name</div>
                                <span class="slc-abbr">@state.Abbreviation</span>
                            </div>
                            <div class="slc-meta">
                                <div class="slc-meta-row">
                                    <i class="fa-solid fa-location-dot" style="color:var(--gold)"></i>
                                    <span>@state.Capital</span>
                                </div>
                                @if (state.Population.HasValue)
                                {
                                    <div class="slc-meta-row">
                                        <i class="fa-solid fa-users"></i>
                                        <span>@state.Population.Value.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                            <div class="slc-footer">
                                <span>View Symbols</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <i class="fa-solid fa-map text-5xl mb-4" style="color:var(--cream-dark)"></i>
                <p style="color:var(--slate-ed);font-size:1.1rem">No states found for this region.</p>
            </div>
        }
    </div>
</section>

<!-- ════════════════════════════════════════════════════════
     INFO STRIP
     ════════════════════════════════════════════════════════ -->
<section style="padding:4rem 0 5rem;background:white">
    <div class="max-w-3xl mx-auto px-4 text-center">
        <div style="display:inline-flex;align-items:center;justify-content:center;width:3rem;height:3rem;border-radius:.875rem;background:var(--cream);margin-bottom:1rem">
            <i class="fa-solid fa-book-open" style="color:var(--navy);font-size:1.1rem"></i>
        </div>
        <h2 class="content-h2 mb-4">Explore State Symbols</h2>
        <p style="color:var(--slate-ed);line-height:1.8;font-size:.975rem;max-width:42rem;margin:0 auto 2rem">
            Each U.S. state has chosen unique symbols that represent its culture, history, and natural heritage.
            Click any state above to discover its official bird, flower, tree, flag, and many more symbols.
        </p>
        <a href="/symbols"
           style="display:inline-flex;align-items:center;gap:.5rem;padding:.875rem 1.75rem;background:var(--navy);color:var(--cream);border-radius:9999px;font-weight:700;font-size:.9rem;text-decoration:none;transition:background .2s"
           onmouseover="this.style.background='#2C3E6B'" onmouseout="this.style.background='#1B2A4A'">
            <i class="fa-solid fa-layer-group"></i>
            Browse All Symbol Types
        </a>
    </div>
</section>
