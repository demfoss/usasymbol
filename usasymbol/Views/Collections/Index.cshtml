@model USASymbol.Models.ViewModels.PageHubViewModel
@inject IImageUrlService Images

@{
    ViewData["Title"]       = "U.S. State Collections — Curated Lists & Comparisons";
    ViewData["Description"] = "Discover curated collections of U.S. state facts, symbols, records, and curiosities — beautifully organized and easy to explore.";

    const string baseUrl = "https://usasymbol.com";
    ViewData["Canonical"] = "/collections";
}

<div id="top"></div>

<!-- Sticky breadcrumb bar -->
<div class="sticky top-16 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-3">
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                <li><a href="/" class="hover:text-slate-900 transition">Home</a></li>
                <li class="text-slate-300">/</li>
                <li class="text-slate-900 font-semibold">Collections</li>
            </ol>
        </nav>
    </div>
</div>

<div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-8 lg:py-12">

    <!-- HERO -->
    <section class="mb-8 lg:mb-10">
        <div class="relative overflow-hidden border border-slate-200 bg-white shadow-sm">
            <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-slate-50 to-transparent"></div>
            <div class="relative p-6 sm:p-8 lg:p-10">

                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-slate-900 max-w-3xl">
                    U.S. State Collections
                </h1>

                <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
                    Curated lists exploring U.S. state facts, symbols, records, and curiosities — pick a category below to start exploring.
                </p>

                <p class="mt-2 text-sm text-slate-400">
                    @Model.Categories.Sum(c => c.Items.Count) collections across @Model.Categories.Count categories
                </p>

                <!-- Search -->
                <div class="mt-6 max-w-md">
                    <div class="relative">
                        <input id="hubSearch"
                               type="text"
                               placeholder="Search categories…"
                               autocomplete="off"
                               class="w-full border border-slate-200 bg-white px-4 py-2.5 pr-10 text-sm text-slate-900 placeholder-slate-400
                                      shadow-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200 transition" />
                        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (Model.HasCategories)
    {
        <!-- CATEGORY CARDS -->
        <div id="categoryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var category in Model.Categories)
            {
                <a href="/collections/@category.Id"
                   class="category-card group flex flex-col border border-slate-200 bg-white overflow-hidden shadow-sm
                          hover:border-slate-400 hover:shadow-md transition-all duration-200"
                   data-title="@category.Title.ToLower()"
                   data-description="@(category.Description?.ToLower() ?? "")">

                    <!-- Thumbnail -->
                    <div class="relative h-28 bg-slate-100 overflow-hidden shrink-0">
                        @if (!string.IsNullOrEmpty(category.Image))
                        {
                            <img src="@Images.Card(category.Image)"
                                 srcset="@Images.CardSrcSet(category.Image, 320, 480, 640)"
                                 sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
                                 alt="@category.Title"
                                 loading="lazy"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                 onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden')" />
                            <div class="hidden w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                                <i class="@category.Icon text-3xl text-slate-400" aria-hidden="true"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
                                <i class="@category.Icon text-3xl text-slate-400" aria-hidden="true"></i>
                            </div>
                        }
                    </div>

                    <!-- Content -->
                    <div class="flex flex-col flex-1 p-5">
                        <h2 class="text-base font-bold text-slate-900 group-hover:text-slate-700 transition leading-snug mb-1.5">
                            @category.Title
                        </h2>
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 flex-1">
                                @category.Description
                            </p>
                        }
                        <div class="mt-4 flex items-center justify-between">
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                                <i class="fa-solid fa-layer-group text-[10px]"></i>
                                @category.Items.Count collections
                            </span>
                            <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-700 group-hover:text-slate-900">
                                View <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>

        <!-- No results state -->
        <div id="noResults" class="hidden text-center py-20">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center bg-slate-100">
                <i class="fa-solid fa-magnifying-glass text-2xl text-slate-400"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">No categories found</h2>
            <p class="text-sm text-slate-500">Try a different search term</p>
        </div>
    }
    else
    {
        <div class="text-center py-20">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center bg-slate-100">
                <i class="fa-solid fa-layer-group text-2xl text-slate-400"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">Collections Coming Soon</h2>
            <p class="text-sm text-slate-500">We're preparing curated collections for you.</p>
        </div>
    }

</div>

<!-- SCHEMA.ORG -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "CollectionPage",
  "name": "U.S. State Collections",
  "description": "@ViewData["Description"]",
  "url": "@($"{baseUrl}{ViewData["Canonical"]}")",
  "license": "@($"{baseUrl}/terms")",
  "creator": { "@@type": "Organization", "name": "USA Symbol", "url": "@baseUrl" },
  "publisher": {
    "@@type": "Organization",
    "name": "USA Symbol",
    "url": "@baseUrl"
  }
}
</script>

<script>
    (() => {
        const input = document.getElementById('hubSearch');
        const cards = document.querySelectorAll('.category-card');
        const noResults = document.getElementById('noResults');

        if (!input) return;

        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            let visible = 0;

            cards.forEach(card => {
                const match = !q ||
                              (card.dataset.title || '').includes(q) ||
                              (card.dataset.description || '').includes(q);
                card.classList.toggle('hidden', !match);
                if (match) visible++;
            });

            noResults?.classList.toggle('hidden', visible > 0);
        });
    })();
</script>
