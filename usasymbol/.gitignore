# Build output
bin/
obj/
bin-verify/
bin-verify-*/
obj-verify/
obj-verify-*/
tmp/
artifacts/

# Images/assets served from Bunny CDN storage (not part of the deploy package)
wwwroot/images/

# Sensitive config
appsettings.Production.json
Content/content-pipeline/prompts/indexing/service_account.json
*service_account*.json

# Local SQLite dev database - fully regenerated by DbSeeder on startup,
# never used in production (Azure SQL). Committing it caused git checkouts
# to swap the file out from under a stale local WAL, corrupting the seeder's
# view of the data (DbUpdateConcurrencyException on startup).
usasymbol.db
*.db-shm
*.db-wal

# User-specific VS files
.vs/
*.user

# Rider
.idea/

# OS
.DS_Store
Thumbs.db
